{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "chelis_deep",
      "camelcase": "ChelisDeep",
      "scope": "source.chelis.deep",
      "file-types": ["dp"],
      "injection-regex": "^(chelis-deep|deep)$"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Tree-sitter grammar for Chelis Deep source files",
    "links": {
      "repository": "https://github.com/Chelis-Lang/chelis"
    }
  },
  "bindings": {
    "c": true,
    "node": true,
    "rust": false
  }
}
