/target
# `uv pip install bindings/python` (the chelis#914/#930 manual interrupt gate)
# runs cargo from `bindings/python`, so a relative CARGO_TARGET_DIR resolves
# there and drops a full build tree the anchored `/target` above does not cover.
bindings/python/target/
# WI-13 Option B: the no-sudo local prefix where the dep-setup script builds
# Sollya + fplll from source. A build artifact, never committed (the committed
# proof bundle under crates/chelis-prove/data is the source of truth).
/.local
.env
.claude/scheduled_tasks.lock
*.swp
*.swo
.DS_Store
data/
*.c
*.h
!crates/
!crates/**/*.c
!crates/**/*.h
# WI-13 committed, certified erf envelope + its Sollya/Gappa proof bundle: all
# source-of-truth data (the envelope is embedded via include_str!; the .gappa
# proof + .sollya generator are the committed machine-checkable proof term), so
# they must be tracked despite the broad `data/` ignore above (mirrors the
# !crates/**/*.c re-inclusion idiom).
!crates/chelis-prove/data/
!crates/chelis-prove/data/*.json
!crates/chelis-prove/data/**/*.json
!crates/chelis-prove/data/**/*.gappa
!crates/chelis-prove/data/**/*.sollya
!crates/chelis-prove/data/**/*.sha256
!crates/chelis-prove/data/**/*.md
!grammars/**/*.c
!grammars/**/*.h
bindings/python/chelis/_native.abi3.so
bindings/python/chelis/__pycache__/
__pycache__/
*.py[cod]
docs/book/book/

# chelis build artifacts left in crates/chelis-cli/ by integration tests
crates/chelis-cli/libchelis_runtime.a
crates/chelis-cli/chelis_runtime.h
crates/chelis-cli/chelis_hip_runtime.h
crates/chelis-cli/pad_hip.cpp
crates/chelis-cli/pad_hip.h

# Agent worktrees (ephemeral, per-session)
.claude/worktrees/

# Lean proof work-in-progress (tracked separately)
proof/
.venv
HANDOVER.md
libchelis_runtime.a
bs_vec.c
bs_vec.h
const_vec.c
const_vec.h
chelis_runtime.h
chelis_blas.h
.pi/
