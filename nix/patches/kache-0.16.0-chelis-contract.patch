+/// Turn the displayed issue count into the command's process status.
+fn doctor_status(issues: usize) -> Result<()> {
+    if issues == 0 {
+        Ok(())
+    } else {
+        anyhow::bail!("kache doctor found {issues} issue(s)")
+    }
+}
+
 /// Labels of the daemon-related checks that become informational when the
 /// daemon is optional. Kept in sync with the check constructions in
 /// [`doctor`]; module-level so the disposition logic below is unit-testable.
-const DAEMON_CHECK_LABELS: [&str; 5] = [
+const DAEMON_CHECK_LABELS: [&str; 4] = [
     "Daemon version",
     "Daemon service",
     "Daemon processes",
-    "Stale locks",
     "Service exe",
 ];

@@ -4039,7 +4047,7 @@ pub fn doctor(
         }
     }

-    Ok(())
+    doctor_status(issues)
 }

 /// Migrate from sccache to kache (called by `doctor --fix`).
@@ -5560,6 +5568,17 @@ mod tests {
         assert!(!doctor_check_is_optional("Compiler probe", true, false));
         // Non-daemon, non-probe labels are never optional.
         assert!(!doctor_check_is_optional("Remote", true, true));
+        assert!(
+            !doctor_check_is_optional("Stale locks", true, false),
+            "abandoned locks are a real local-only failure"
+        );
+    }
+
+    #[test]
+    fn doctor_status_is_nonzero_exactly_when_issues_were_reported() {
+        assert!(doctor_status(0).is_ok());
+        assert!(doctor_status(1).is_err());
+        assert!(doctor_status(7).is_err());
     }

