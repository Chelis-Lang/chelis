module Example.ScalarSpecialValues
import Std.Scalar (abs)
magnitude = abs(-0.0f64)
negative_infinity_magnitude = abs(neg(div(1.0f64, 0.0f64)))
first_zero_maximum = max_elem(-0.0f64, 0.0f64)
first_zero_minimum = min_elem(0.0f64, -0.0f64)
leading_nan = max_elem(div(0.0f64, 0.0f64), 1.0f64)
def minimum[r, p: Numeric](x: tensor[..r, p], y: tensor[..r, p]) -> tensor[..r, p] = min_elem(x, y)
integer_minimum = minimum(to_tensor([4i16, 1i16, 6i16]), to_tensor([2i16, 2i16, 2i16]))
floating_minimum = minimum(to_tensor([[1.0f32, div(1.0f32, 0.0f32), 3.0f32], [4.0f32, 5.0f32, 6.0f32]]), to_tensor([[2.0f32, div(1.0f32, 0.0f32), 2.0f32], [2.0f32, 2.0f32, 2.0f32]]))
finite_minimum = is_finite(floating_minimum)
