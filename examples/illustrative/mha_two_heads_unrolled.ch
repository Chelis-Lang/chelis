def block(x: tensor[seq, 256, f32], wq0: tensor[256, 128, f32], wk0: tensor[256, 128, f32], wv0: tensor[256, 128, f32], wq1: tensor[256, 128, f32], wk1: tensor[256, 128, f32], wv1: tensor[256, 128, f32], wo0: tensor[128, 256, f32], wo1: tensor[128, 256, f32]) -> tensor[seq, 256, f32] = {
  q0 = matmul(copy(x), wq0)
  k0 = matmul(copy(x), wk0)
  v0 = matmul(copy(x), wv0)
  scores0 = matmul(q0, permute(k0, 1, 0))
  probs0 = softmax(scores0, 1)
  head0 = matmul(matmul(probs0, v0), wo0)
  q1 = matmul(copy(x), wq1)
  k1 = matmul(copy(x), wk1)
  v1 = matmul(copy(x), wv1)
  scores1 = matmul(q1, permute(k1, 1, 0))
  probs1 = softmax(scores1, 1)
  head1 = matmul(matmul(probs1, v1), wo1)
  attn_out = add(head0, head1)
  add(x, attn_out)
}
