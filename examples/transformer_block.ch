def forward(x: tensor[seq, 256, f32], wq0: tensor[256, 64, f32], wk0: tensor[256, 64, f32], wv0: tensor[256, 64, f32], wo0: tensor[64, 256, f32], wq1: tensor[256, 64, f32], wk1: tensor[256, 64, f32], wv1: tensor[256, 64, f32], wo1: tensor[64, 256, f32], wq2: tensor[256, 64, f32], wk2: tensor[256, 64, f32], wv2: tensor[256, 64, f32], wo2: tensor[64, 256, f32], wq3: tensor[256, 64, f32], wk3: tensor[256, 64, f32], wv3: tensor[256, 64, f32], wo3: tensor[64, 256, f32], ff1: tensor[256, 1024, f32], ff2: tensor[1024, 256, f32], gamma1: tensor[256, f32], beta1: tensor[256, f32], gamma2: tensor[256, f32], beta2: tensor[256, f32]) -> tensor[seq, 256, f32] = {
  q0 = matmul(copy(x), wq0)
  k0 = matmul(copy(x), wk0)
  v0 = matmul(copy(x), wv0)
  scores0 = matmul(q0, permute(k0, 1, 0))
  probs0 = softmax(scores0, 1)
  head0 = matmul(matmul(probs0, v0), wo0)
  q1 = matmul(copy(x), wq1)
  k1 = matmul(copy(x), wk1)
  v1 = matmul(copy(x), wv1)
  scores1 = matmul(q1, permute(k1, 1, 0))
  probs1 = softmax(scores1, 1)
  head1 = matmul(matmul(probs1, v1), wo1)
  q2 = matmul(copy(x), wq2)
  k2 = matmul(copy(x), wk2)
  v2 = matmul(copy(x), wv2)
  scores2 = matmul(q2, permute(k2, 1, 0))
  probs2 = softmax(scores2, 1)
  head2 = matmul(matmul(probs2, v2), wo2)
  q3 = matmul(copy(x), wq3)
  k3 = matmul(copy(x), wk3)
  v3 = matmul(copy(x), wv3)
  scores3 = matmul(q3, permute(k3, 1, 0))
  probs3 = softmax(scores3, 1)
  head3 = matmul(matmul(probs3, v3), wo3)
  attn_out = add(add(head0, head1), add(head2, head3))
  norm1 = layer_norm(add(x, attn_out), gamma1, beta1)
  ff_out = matmul(copy(norm1), ff1) |> relu |> matmul(ff2)
  layer_norm(add(norm1, ff_out), gamma2, beta2)
}
