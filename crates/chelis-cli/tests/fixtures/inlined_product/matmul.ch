module Probe.InlinedProduct
def square[n](a: tensor[n, 7, f32], b: tensor[7, n, f32]) -> tensor[n, n, f32] = matmul(a, b)
def loss(w: tensor[7, 2, f32]) -> tensor[f32] = sum(sum(matmul(to_tensor([[0.5f32, -1.0f32, 2.0f32, 3.0f32, 100000000.0f32, 1.0f32, -100000000.0f32]]), w), 1i32), 0i32)
def main() -> unit ! { IO } = {
  a32: tensor[3, 7, f32] = to_tensor([[100000000.0f32, 1.0f32, -100000000.0f32, 1.0f32, 2.9802322e-8f32, 3.0f32, -0.0f32], [1e-40f32, 1e-40f32, 3.4028235e38f32, 3.4028235e38f32, -1.0f32, 0.5f32, 0.25f32], [0.1f32, 0.2f32, 0.3f32, 0.4f32, 0.5f32, 0.6f32, 0.7f32]])
  b32: tensor[7, 2, f32] = to_tensor([[1.0f32, -0.0f32], [1.0f32, 1.0f32], [1.0f32, 0.0f32], [-1.0f32, 3.0f32], [1.0f32, 1e-30f32], [0.33333334f32, -7.0f32], [1.0f32, 0.0f32]])
  _ = print(matmul(a32, b32))
  _ = print(matmul(a32, b32, accumulator=f64))
  a64: tensor[3, 7, f64] = cast(a32, f64)
  b64: tensor[7, 2, f64] = cast(b32, f64)
  _ = print(matmul(a64, b64))
  a16: tensor[3, 7, bf16] = cast(a32, bf16)
  b16: tensor[7, 2, bf16] = cast(b32, bf16)
  _ = print(matmul(a16, b16))
  _ = print(matmul(a16, b16, accumulator=f64))
  h16: tensor[3, 7, f16] = cast(a32, f16)
  g16: tensor[7, 2, f16] = cast(b32, f16)
  _ = print(matmul(h16, g16))
  batched: tensor[2, 3, 7, f32] = insert(a32, 0i32, 2i64)
  _ = print(matmul(batched, b32))
  _ = print(matmul(relu(a32), b32))
  inf_row: tensor[1, 2, f32] = to_tensor([[3.4028235e38f32, 3.4028235e38f32]])
  zero_col: tensor[2, 1, f32] = to_tensor([[3.4028235e38f32], [-3.4028235e38f32]])
  _ = print(matmul(inf_row, zero_col))
  _ = print(square(copy(a32), permute(a32, 1i32, 0i32)))
  _ = print(square(copy(shrink(a32, [[0i64, 2i64], [0i64, 7i64]])), permute(shrink(a32, [[1i64, 3i64], [0i64, 7i64]]), 1i32, 0i32)))
  _ = print(grad(loss)(b32))
  shared: tensor[3, 7, 2, f32] = (insert(a32, 2i32, 2i64) * insert(b32, 0i32, 3i64))
  _ = print(sum(shared, 1i32))
  _ = print(shared)
  ints: tensor[2, 3, i32] = sum((insert(to_tensor([[1i32, 2i32, 3i32], [4i32, 5i32, 6i32]]), 2i32, 3i64) * insert(to_tensor([[1i32, 0i32, 0i32], [0i32, 1i32, 0i32], [0i32, 0i32, 1i32]]), 0i32, 2i64)), 1i32)
  _ = print(ints)
  ()
}
out = main()
