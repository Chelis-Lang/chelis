module EinsumContractionRoute
def g32(n: i64, lo: f32) -> tensor[*, f32] = {
  l = cumsum(expand(to_tensor([lo]), 0i32, n), 0i32)
  c = cos(l)
  mul(sin(add(l, l)), exp(add(add(c, c), c)))
}
def g64(n: i64, lo: f64) -> tensor[*, f64] = {
  l = cumsum(expand(to_tensor([lo]), 0i32, n), 0i32)
  c = cos(l)
  mul(sin(add(l, l)), exp(add(add(c, c), c)))
}
def rows(x: tensor[2, 3, 37, f32], w: tensor[37, 5, f32]) -> tensor[2, 3, 5, f32] = einsum("amk,kn->amn", x, w)
def transposed(x: tensor[3, 9, f64], w: tensor[5, 9, f64]) -> tensor[3, 5, f64] = einsum("mk,nk->mn", x, w)
def swapped(w: tensor[5, 7, f32], x: tensor[3, 7, f32]) -> tensor[3, 5, f32] = einsum("nk,mk->mn", w, x)
def batched(x: tensor[2, 3, 17, f32], w: tensor[2, 17, 4, f32]) -> tensor[2, 3, 4, f32] = einsum("bmk,bkn->bmn", x, w)
def half(x: tensor[3, 37, f16], w: tensor[37, 5, f16]) -> tensor[3, 5, f16] = einsum("mk,kn->mn", x, w)
def brain(x: tensor[3, 37, bf16], w: tensor[37, 5, bf16]) -> tensor[3, 5, bf16] = einsum("mk,kn->mn", x, w)
def wide(x: tensor[3, 37, f32], w: tensor[37, 5, f32]) -> tensor[3, 5, f64] = einsum("mk,kn->mn", x, w, accumulator=f64)
def runtime_rows[m](x: tensor[m, 37, f32], w: tensor[37, 5, f32]) -> tensor[m, 5, f32] = einsum("mk,kn->mn", x, w)
def deep(x: tensor[2, 257, f32], w: tensor[257, 3, f32]) -> tensor[2, 3, f32] = einsum("mk,kn->mn", x, w)
def flattened(x: tensor[2, 2, 2, 13, f32], w: tensor[2, 13, 3, f32]) -> tensor[2, 2, 2, 3, f32] = einsum("bamk,bkn->bamn", x, w)
def interleaved(x: tensor[3, 2, 13, f32], w: tensor[13, 5, f32]) -> tensor[2, 3, 5, f32] = einsum("mak,kn->amn", x, w)
def sequence[s](x: tensor[1, s, 13, f32], w: tensor[13, 5, f32]) -> tensor[1, s, 5, f32] = einsum("amk,kn->amn", x, w)
def product_rows[a](x: tensor[a, 3, 8, f32], w: tensor[8, 5, f32]) -> tensor[a, 3, 5, f32] = einsum("amk,kn->amn", x, w)
def paired_rows[a, m](x: tensor[a, m, 13, f64], w: tensor[13, 4, f64]) -> tensor[a, m, 4, f64] = einsum("amk,kn->amn", x, w)
def narrow_rows[a](x: tensor[a, 2, 13, f16], w: tensor[13, 3, f16]) -> tensor[a, 2, 3, f16] = einsum("amk,kn->amn", x, w, accumulator=f64)
def batched_brain(x: tensor[2, 3, 17, bf16], w: tensor[2, 17, 4, bf16]) -> tensor[2, 3, 4, bf16] = einsum("bmk,bkn->bmn", x, w)
def special_half(x: tensor[3, 5, f16], w: tensor[5, 2, f16]) -> tensor[3, 2, f16] = einsum("mk,kn->mn", x, w)
def special_wide(x: tensor[3, 5, f32], w: tensor[5, 2, f32]) -> tensor[3, 2, f64] = einsum("mk,kn->mn", x, w, accumulator=f64)
def matmul_half(x: tensor[3, 37, f16], w: tensor[37, 5, f16]) -> tensor[3, 5, f16] = matmul(x, w)
def matmul_brain(x: tensor[3, 37, bf16], w: tensor[37, 5, bf16]) -> tensor[3, 5, bf16] = matmul(x, w)
def empty_pair[a, b, m](x: tensor[a, b, m, 8, f32], w: tensor[8, 5, f32]) -> tensor[a, b, m, 5, f32] = einsum("abmk,kn->abmn", x, w)
def empty_mixed[a, m](x: tensor[a, 3, m, 8, f32], w: tensor[8, 5, f32]) -> tensor[a, 3, m, 5, f32] = einsum("abmk,kn->abmn", x, w)
def reused(x: tensor[2, 3, 37, f32], w: tensor[37, 5, f32]) -> tensor[2, 3, 37, f32] = {
  e = einsum("amk,kn->amn", x, w)
  mul(x, insert(sum(e, 2i32), 2i32, 37i64))
}
def moved(x: tensor[2, 3, 37, f32], w: tensor[37, 5, f32]) -> tensor[2, 3, 37, f32] = {
  y = exp(x)
  e = einsum("amk,kn->amn", y, w)
  mul(neg(y), insert(sum(e, 2i32), 2i32, 37i64))
}
def broadcast_columns(x: tensor[3, 13, f32], w: tensor[2, 13, 5, f32]) -> tensor[2, 3, 5, f32] = einsum("mk,bkn->bmn", x, w)
def widened(x: tensor[1, 3, f16], w: tensor[3, 1, f16]) -> tensor[1, 1, f16] = einsum("mk,kn->mn", x, w, accumulator=f64)
def narrowed(x: tensor[1, 3, f16], w: tensor[3, 1, f16]) -> tensor[1, 1, f16] = einsum("mk,kn->mn", x, w)
def huge_empty(x: tensor[0, 4194304, 4194304, f32], w: tensor[0, 4194304, 4194304, f32]) -> tensor[0, 4194304, 4194304, f32] = einsum("bmk,bkn->bmn", x, w)
def zero_batch_rows[m](x: tensor[0, m, 4194304, f32], w: tensor[0, 4194304, 4194304, f32]) -> tensor[0, m, 4194304, f32] = einsum("bmk,bkn->bmn", x, w)
def special(x: tensor[3, 5, f32], w: tensor[5, 2, f32]) -> tensor[3, 2, f32] = einsum("mk,kn->mn", x, w)
def diagonal_scale(x: tensor[4, 4, f32], v: tensor[4, f32]) -> tensor[4, f32] = einsum("ii,i->i", x, v)
def frobenius(x: tensor[3, 7, f32], y: tensor[3, 7, f32]) -> tensor[f32] = einsum("ij,ij->", x, y)
def outer_product(x: tensor[3, f32], y: tensor[5, f32]) -> tensor[3, 5, f32] = einsum("i,j->ij", x, y)
def matvec(x: tensor[5, 37, f32], v: tensor[37, f32]) -> tensor[5, f32] = einsum("ij,j->i", x, v)
def runtime_depth[k](x: tensor[3, k, f32], w: tensor[k, 5, f32]) -> tensor[3, 5, f32] = einsum("mk,kn->mn", x, w)
def integer(x: tensor[2, 3, i32], w: tensor[3, 2, i32]) -> tensor[2, 2, i32] = einsum("mk,kn->mn", x, w)
r_rows = rows(reshape(g32(222i64, 2.101f32), [2i64, 3i64, 37i64]), reshape(g32(185i64, 2.1741f32), [37i64, 5i64]))
r_transposed = transposed(reshape(g64(27i64, 2.2472f64), [3i64, 9i64]), reshape(g64(45i64, 2.3203f64), [5i64, 9i64]))
r_swapped = swapped(reshape(g32(35i64, 2.3934f32), [5i64, 7i64]), reshape(g32(21i64, 2.4665f32), [3i64, 7i64]))
r_batched = batched(reshape(g32(102i64, 2.5396f32), [2i64, 3i64, 17i64]), reshape(g32(136i64, 2.6127f32), [2i64, 17i64, 4i64]))
r_half = half(reshape(cast(g32(111i64, 2.6858f32), f16), [3i64, 37i64]), reshape(cast(g32(185i64, 2.7589f32), f16), [37i64, 5i64]))
r_brain = brain(reshape(cast(g32(111i64, 2.832f32), bf16), [3i64, 37i64]), reshape(cast(g32(185i64, 2.9051f32), bf16), [37i64, 5i64]))
r_wide = wide(reshape(g32(111i64, 2.9782f32), [3i64, 37i64]), reshape(g32(185i64, 3.0513f32), [37i64, 5i64]))
r_runtime_rows = runtime_rows(reshape(g32(111i64, 3.1244f32), [3i64, 37i64]), reshape(g32(185i64, 3.1975f32), [37i64, 5i64]))
r_no_rows = runtime_rows(insert(g32(37i64, 3.2706f32), 0i32, sub(3i64, 3i64)), reshape(g32(185i64, 3.3437f32), [37i64, 5i64]))
r_deep = deep(reshape(g32(514i64, 4.0016f32), [2i64, 257i64]), reshape(g32(771i64, 4.0747f32), [257i64, 3i64]))
r_flattened = flattened(reshape(g32(104i64, 4.1478f32), [2i64, 2i64, 2i64, 13i64]), reshape(g32(78i64, 4.2209f32), [2i64, 13i64, 3i64]))
r_interleaved = interleaved(reshape(g32(78i64, 4.294f32), [3i64, 2i64, 13i64]), reshape(g32(65i64, 4.3671f32), [13i64, 5i64]))
r_sequence = sequence(reshape(g32(39i64, 4.4402f32), [1i64, 3i64, 13i64]), reshape(g32(65i64, 4.5133f32), [13i64, 5i64]))
r_no_sequence = sequence(insert(insert(g32(13i64, 4.5864f32), 0i32, sub(3i64, 3i64)), 0i32, 1i64), reshape(g32(65i64, 4.6595f32), [13i64, 5i64]))
r_product_rows = product_rows(reshape(g32(48i64, 5.1712f32), [2i64, 3i64, 8i64]), reshape(g32(40i64, 5.2443f32), [8i64, 5i64]))
r_no_product = product_rows(reshape(g32(0i64, 5.3174f32), [0i64, 3i64, 8i64]), reshape(g32(40i64, 5.3905f32), [8i64, 5i64]))
r_paired_rows = paired_rows(reshape(g64(78i64, 5.4636f64), [2i64, 3i64, 13i64]), reshape(g64(52i64, 5.5367f64), [13i64, 4i64]))
r_narrow_rows = narrow_rows(reshape(cast(g32(78i64, 5.6098f32), f16), [3i64, 2i64, 13i64]), reshape(cast(g32(39i64, 5.6829f32), f16), [13i64, 3i64]))
r_batched_brain = batched_brain(reshape(cast(g32(102i64, 5.756f32), bf16), [2i64, 3i64, 17i64]), reshape(cast(g32(136i64, 5.8291f32), bf16), [2i64, 17i64, 4i64]))
r_special_half = special_half(cast(div(to_tensor([[1.0f32, 0.0f32, -0.0f32, 2.0f32, 1.0f32], [-0.0f32, -0.0f32, 0.0f32, -0.0f32, -0.0f32], [1.0f32, 1.0f32, 1.0f32, 300.0f32, 1.0f32]]), to_tensor([[0.0f32, 0.0f32, 1.0f32, 1.0f32, 1.0f32], [1.0f32, 1.0f32, 1.0f32, 1.0f32, 1.0f32], [1.0f32, 1.0f32, 1.0f32, 1.0f32, 1.0f32]])), f16), cast(to_tensor([[1.0f32, -1.0f32], [0.0f32, 2.0f32], [-0.0f32, 1.0f32], [300.0f32, -0.0f32], [-1.0f32, 0.5f32]]), f16))
r_special_wide = special_wide(div(to_tensor([[1.0f32, 0.0f32, -0.0f32, 2.0f32, 1.0f32], [-0.0f32, -0.0f32, 0.0f32, -0.0f32, -0.0f32], [1.0f32, 1.0f32, 1.0f32, 300.0f32, 1.0f32]]), to_tensor([[0.0f32, 0.0f32, 1.0f32, 1.0f32, 1.0f32], [1.0f32, 1.0f32, 1.0f32, 1.0f32, 1.0f32], [1.0f32, 1.0f32, 1.0f32, 1.0f32, 1.0f32]])), to_tensor([[1.0f32, -1.0f32], [0.0f32, 2.0f32], [-0.0f32, 1.0f32], [300.0f32, -0.0f32], [-1.0f32, 0.5f32]]))
r_matmul_half = matmul_half(reshape(cast(g32(111i64, 5.9022f32), f16), [3i64, 37i64]), reshape(cast(g32(185i64, 5.9753f32), f16), [37i64, 5i64]))
r_matmul_brain = matmul_brain(reshape(cast(g32(111i64, 6.0484f32), bf16), [3i64, 37i64]), reshape(cast(g32(185i64, 6.1215f32), bf16), [37i64, 5i64]))
r_empty_pair = empty_pair(reshape(g32(0i64, 6.1946f32), [4294967296i64, 4294967296i64, 0i64, 8i64]), reshape(g32(40i64, 6.2677f32), [8i64, 5i64]))
r_empty_mixed = empty_mixed(reshape(g32(0i64, 6.3408f32), [4611686018427387904i64, 3i64, 0i64, 8i64]), reshape(g32(40i64, 6.4139f32), [8i64, 5i64]))
r_reused = reused(reshape(g32(222i64, 6.487f32), [2i64, 3i64, 37i64]), reshape(g32(185i64, 6.5601f32), [37i64, 5i64]))
r_moved = moved(reshape(g32(222i64, 6.6332f32), [2i64, 3i64, 37i64]), reshape(g32(185i64, 6.7063f32), [37i64, 5i64]))
r_broadcast_columns = broadcast_columns(reshape(g32(39i64, 4.7326f32), [3i64, 13i64]), reshape(g32(130i64, 4.8057f32), [2i64, 13i64, 5i64]))
r_widened = widened(cast(to_tensor([[1.0f32, 0.015625f32, 9.5367431640625e-7f32]]), f16), cast(to_tensor([[1.0f32], [0.03125f32], [9.5367431640625e-7f32]]), f16))
r_narrowed = narrowed(cast(to_tensor([[1.0f32, 0.015625f32, 9.5367431640625e-7f32]]), f16), cast(to_tensor([[1.0f32], [0.03125f32], [9.5367431640625e-7f32]]), f16))
r_huge_empty = huge_empty(reshape(g32(0i64, 4.8788f32), [0i64, 4194304i64, 4194304i64]), reshape(g32(0i64, 4.9519f32), [0i64, 4194304i64, 4194304i64]))
r_zero_batch_rows = zero_batch_rows(reshape(g32(0i64, 5.025f32), [0i64, 4194304i64, 4194304i64]), reshape(g32(0i64, 5.0981f32), [0i64, 4194304i64, 4194304i64]))
r_special = special(div(to_tensor([[1.0f32, 0.0f32, -0.0f32, 2.0f32, 1.0f32], [-0.0f32, -0.0f32, 0.0f32, -0.0f32, -0.0f32], [1.0f32, 1.0f32, 1.0f32, 1.0f32, 1.0f32]]), to_tensor([[0.0f32, 0.0f32, 1.0f32, 1.0f32, 1.0f32], [1.0f32, 1.0f32, 1.0f32, 1.0f32, 1.0f32], [1.0f32, 1.0f32, -0.0f32, 1.0f32, 1.0f32]])), to_tensor([[1.0f32, -1.0f32], [0.0f32, 2.0f32], [-0.0f32, 1.0f32], [1.0f32, -0.0f32], [-1.0f32, 0.5f32]]))
