r_frobenius = frobenius(reshape(g32(21i64, 3.563f32), [3i64, 7i64]), reshape(g32(21i64, 3.6361f32), [3i64, 7i64]))
r_outer = outer_product(g32(3i64, 3.7092f32), g32(5i64, 3.7823f32))
r_matvec = matvec(reshape(g32(185i64, 3.8554f32), [5i64, 37i64]), g32(37i64, 3.9285f32))
r_runtime_depth = runtime_depth(reshape(g32(33i64, 4.0016f32), [3i64, 11i64]), reshape(g32(55i64, 2.3203f32), [11i64, 5i64]))
r_integer = integer(to_tensor([[3i32, -7i32, 11i32], [2i32, 5i32, -13i32]]), to_tensor([[17i32, -19i32], [23i32, 29i32], [-31i32, 13i32]]))
