; Wrapped Black-Scholes call-price function: typecheckable scalar-f32
; fixture for the chelis span-survival full-pipeline tests (S5+, S6).
;
; Construction. The bodies of d_1, d_2, and c are taken from Octant's
; translation of `references/black_scholes_call_function.tex` (multi-
; equation .tex; sequence of three `(def {span} name body)` nodes).
; Span IDs `eq:d1_*`, `eq:d2_*`, `eq:c_*` come straight from Octant.
; The OUTER wrapper — `def call_price(...)`, `let (bind ...)` binding
; `d_1`/`d_2`, and the local `normal_cdf` stub — is hand-authored because
; Octant currently emits each LaTeX equation as a top-level value
; binding and does not factor free vars into function parameters or
; wrap multi-equation programs into a single function def.
;
; Type-shape choice (S6, post-step-6 rewrite): natural scalar
; `(t-prim {} f32)` throughout (parameters, locals, literals). This
; routes the program through the host-side codegen path
; (`chelis-backend-c::host_emit`), which now emits `// span:` comments
; per S6 step 5. This is the canonical customer-shape program — Black-
; Scholes is naturally scalar — and the audit chain test exercises it
; on the host_emit path end-to-end.
;
; Pre-S6 history: this fixture used rank-0 tensors `(t-tensor {} (t-prim
; {} f32))` to force routing through the DAG codegen path (which
; emitted span comments before host_emit did). With S6 step 5 landing
; host-path span emission, the rank-0-tensor workaround is obsolete and
; the fixture was rewritten to its natural scalar shape.
;
; Linearity wrinkle: scalars are non-linear (consume rules in
; spec/04-type-system.md §8.1 only apply to tensor values), so the
; reuse of `s`, `k`, `r`, `t`, `sigma`, and `d_1` in multiple places
; no longer requires the `(copy {} (var {} x))` helper bindings the
; rank-0-tensor form needed.
;
; The local `normal_cdf` stub is identity over f32 scalars. The fixture
; exists to drive the chelis Deep ingestion path; the numerical body of
; `Phi` is irrelevant to span survival. The Surf reference
; `references/black_scholes_call.ch` imports the real
; `Nautilus.Special.normal_cdf`; this fixture inlines a stub so the
; .dp is self-contained.

(def {span: "__synthesized_wrap__"}
  normal_cdf
  (fn {}
    (params {} (x {type: (t-prim {} f32)}))
    (var {} x)))

(def {span: "__synthesized_wrap__"}
  call_price
  (fn {}
    (params {}
      (s     {type: (t-prim {} f32)})
      (k     {type: (t-prim {} f32)})
      (r     {type: (t-prim {} f32)})
      (t     {type: (t-prim {} f32)})
      (sigma {type: (t-prim {} f32)})
      (e     {type: (t-prim {} f32)}))
    (let {}
      (bind {}
        d_1
        (app {span: "eq:d1_002"}
          (var {} div)
          (app {span: "eq:d1_003"}
            (var {} add)
            (app {span: "eq:d1_004"}
              (var {} log)
              (app {span: "eq:d1_005"}
                (var {} div)
                (var {span: "eq:d1_006"} s)
                (var {span: "eq:d1_007"} k)))
            (app {span: "eq:d1_008"}
              (var {} mul)
              (app {span: "eq:d1_009"}
                (var {} add)
                (var {span: "eq:d1_010"} r)
                (app {span: "eq:d1_011"}
                  (var {} div)
                  (app {span: "eq:d1_012"}
                    (var {} mul)
                    (var {span: "eq:d1_013"} sigma)
                    (var {span: "eq:d1_014"} sigma))
                  (lit {span: "eq:d1_015" type: (t-prim {} f32)} 2.0)))
              (var {span: "eq:d1_016"} t)))
          (app {span: "eq:d1_017"}
            (var {} mul)
            (var {span: "eq:d1_018"} sigma)
            (app {span: "eq:d1_019"}
              (var {} sqrt)
              (var {span: "eq:d1_020"} t))))
        d_2
        (app {span: "eq:d2_002"}
          (var {} sub)
          (var {span: "eq:d2_003"} d_1)
          (app {span: "eq:d2_004"}
            (var {} mul)
            (var {span: "eq:d2_005"} sigma)
            (app {span: "eq:d2_006"}
              (var {} sqrt)
              (var {span: "eq:d2_007"} t)))))
      ; Body of `c`. Free vars used here:
      ;   s (1x), k (1x), e (1x), r (1x), t (1x), d_1, d_2.
      (app {span: "eq:c_002"}
        (var {} sub)
        (app {span: "eq:c_003"}
          (var {} mul)
          (var {span: "eq:c_004"} s)
          (app {span: "eq:c_005"}
            (var {} normal_cdf)
            (var {span: "eq:c_006"} d_1)))
        (app {span: "eq:c_007"}
          (var {} mul)
          (app {span: "eq:c_008"}
            (var {} mul)
            (var {span: "eq:c_009"} k)
            (app {span: "eq:c_010"}
              (var {} exp)
              (app {span: "eq:c_011"}
                (var {} mul)
                (app {span: "eq:c_012"}
                  (var {} log)
                  (var {span: "eq:c_013"} e))
                (app {span: "eq:c_014"}
                  (var {} mul)
                  (app {span: "eq:c_015"}
                    (var {} sub)
                    (lit {span: "eq:c_016" type: (t-prim {} f32)} 0.0)
                    (var {span: "eq:c_017"} r))
                  (var {span: "eq:c_018"} t)))))
          (app {span: "eq:c_019"}
            (var {} normal_cdf)
            (var {span: "eq:c_020"} d_2)))))))
