program = { SOI ~ spacing ~ node+ ~ EOI }

node = { "(" ~ spacing ~ tag ~ spacing ~ meta ~ spacing ~ (child ~ spacing)* ~ ")" ~ spacing }
typed_helper = { "(" ~ spacing ~ bare_name ~ spacing ~ typed_meta ~ spacing ~ ")" ~ spacing }
unit_list = { "(" ~ spacing ~ ")" ~ spacing }

meta = { "{" ~ spacing ~ (meta_pair ~ ("," ~ spacing ~ meta_pair)*)? ~ spacing ~ "}" }
typed_meta = { "{" ~ spacing ~ "type" ~ spacing ~ ":" ~ spacing ~ meta_value ~ ("," ~ spacing ~ meta_pair)* ~ spacing ~ "}" }
meta_pair = { meta_key ~ spacing ~ ":" ~ spacing ~ meta_value }
meta_key = @{ ident_segment }
meta_value = { bare_list | typed_helper | node | unit_list | literal | bare_name }
bare_list = { "(" ~ spacing ~ (bare_list_item ~ spacing)* ~ ")" ~ spacing }
bare_list_item = { typed_helper | node | unit_list | literal | bare_name }

child = { typed_helper | node | unit_list | literal | bare_name }
bare_name = { identifier | type_name }
tag = @{ ASCII_ALPHA_LOWER ~ (ASCII_ALPHA_LOWER | ASCII_DIGIT | "-")* }
identifier = @{ ident_segment ~ ("." ~ ident_segment)* }
ident_segment = @{ (ASCII_ALPHA_LOWER | "_") ~ (ASCII_ALPHANUMERIC | "_")* }
type_name = @{ ASCII_ALPHA_UPPER ~ ASCII_ALPHANUMERIC* }

literal = { float_lit | int_lit | bool_lit | string_lit }
float_lit = @{ "-"? ~ digits ~ "." ~ digits ~ exponent?
             | "-"? ~ digits ~ exponent }
exponent = @{ ("e" | "E") ~ ("+" | "-")? ~ digits }
int_lit = @{ "-"? ~ digits }
digits = @{ ASCII_DIGIT ~ (ASCII_DIGIT | "_")* }
bool_lit = { "true" | "false" }
string_lit = @{ "\"" ~ string_char* ~ "\"" }
string_char = { "\\\\" ~ ("n" | "r" | "t" | "0" | "\"" | "\\")
              | !("\"") ~ ANY }

spacing = _{ (WHITESPACE | comment)* }
WHITESPACE = _{ " " | "\t" | "\r" | "\n" }
// `comment` must be atomic (`@{...}`), not silent (`_{...}`). A silent
// rule is non-atomic, so pest auto-inserts implicit WHITESPACE between
// its subrules. With WHITESPACE including "\n", that swallows the
// newline that should terminate the comment, stranding the parser on
// the next node (issue #167). Atomic rules opt out of implicit-
// whitespace insertion, so `(!"\n" ~ ANY)*` stays the sole consumer up
// to the newline, which the surrounding `spacing` then handles as
// WHITESPACE.
//
// Making `comment` atomic also makes it visible in the parse tree
// (only `_{...}` rules are suppressed). The Rust child-collection in
// `validate_deep_node` therefore skips `comment` pairs the same way it
// skips `EOI`, so an inline or trailing comment is never mistaken for a
// node child.
comment = @{ ";" ~ (!"\n" ~ ANY)* }
