{
  "name": "Chelis Surf",
  "scopeName": "source.chelis",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#block-comment"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#functions"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-dash.chelis",
          "match": "--.*$"
        }
      ]
    },
    "block-comment": {
      "name": "comment.block.chelis",
      "begin": "\\{\\-",
      "end": "\\-\\}",
      "patterns": [
        {
          "include": "#block-comment"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.chelis",
          "match": "\\b(def|sig|type|dim|macro|match|with|fn|module|import|export|if|then|else|grad|vmap|jit|realize|copy|tensor|cast|cast_trunc|par|do|quote|unquote|splice|effect|handler|perform|resume|borrow|property|forall|where)\\b"
        },
        {
          "name": "constant.language.boolean.chelis",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.chelis",
          "match": "\\b(f32|f64|f16|bf16|i8|i16|i32|i64|bool|string|unit)\\b"
        },
        {
          "name": "storage.type.chelis",
          "match": "\\bkey\\b"
        },
        {
          "name": "support.type.chelis",
          "match": "\\b[A-Z][A-Za-z0-9_]*(\\.[A-Z][A-Za-z0-9_]*)*\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.chelis",
          "match": "(?<![A-Za-z0-9_])(?:(?:[0-9](?:_?[0-9])*\\.[0-9](?:_?[0-9])*(?:[eE][+-]?[0-9](?:_?[0-9])*)?|[0-9](?:_?[0-9])*[eE][+-]?[0-9](?:_?[0-9])*)(?:bf16|f32|f64|f16)?|[0-9](?:_?[0-9])*(?:bf16|f32|f64|f16))(?![A-Za-z0-9_])"
        },
        {
          "name": "constant.numeric.integer.chelis",
          "match": "(?<![A-Za-z0-9_])(?:0[xX][0-9A-Fa-f](?:_?[0-9A-Fa-f])*|0[bB][01](?:_?[01])*|[0-9](?:_?[0-9])*)(?:i8|i16|i32|i64)?(?![A-Za-z0-9_])"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.chelis",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.chelis",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.chelis",
          "match": "->|=>|\\|>|==|!=|<=|>=|&&|\\|\\||\\.\\.|[!<>=+*/%|&-]|[.:@;]"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.chelis",
          "match": "\\b[a-z][A-Za-z0-9_]*\\b(?=\\s*\\()"
        },
        {
          "name": "variable.other.chelis",
          "match": "\\b[a-z][A-Za-z0-9_]*\\b"
        }
      ]
    }
  }
}
