{
  "name": "Chelis Surf",
  "scopeName": "source.chelis",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#functions"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-dash.chelis",
          "match": "--.*$"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.chelis",
          "match": "\\b(module|import|export|def|sig|type|dim|let|in|if|then|else|match|with|fn|grad|vmap|jit|realize|copy|par|property|forall|where)\\b"
        },
        {
          "name": "constant.language.boolean.chelis",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.chelis",
          "match": "\\b(tensor|f32|f64|f16|bf16|f8e4m3|int8|int32|int64|bool|string|unit)\\b"
        },
        {
          "name": "support.type.chelis",
          "match": "\\b[A-Z][A-Za-z0-9_]*(\\.[A-Z][A-Za-z0-9_]*)*\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.chelis",
          "match": "\\b\\d+\\.\\d+(?:[eE][+-]?\\d+)?\\b"
        },
        {
          "name": "constant.numeric.integer.chelis",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.chelis",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.chelis",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.chelis",
          "match": "->|=>|\\|>|==|!=|<=|>=|[:=+\\-*/%<>|]"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.chelis",
          "match": "\\b[a-z][A-Za-z0-9_]*\\b(?=\\s*\\()"
        },
        {
          "name": "variable.other.chelis",
          "match": "\\b[a-z][A-Za-z0-9_]*\\b"
        }
      ]
    }
  }
}
