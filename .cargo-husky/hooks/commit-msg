#!/usr/bin/env bash
#
# commit-msg hook: reject commits with AI-tool authorship markers.
#
# Installed automatically by cargo-husky on `cargo test`.
# In git worktrees, run: git config core.hooksPath .cargo-husky/hooks

set -euo pipefail

MSG_FILE="$1"

PATTERNS=(
    # Claude / Anthropic
    '[Cc]o-[Aa]uthored-[Bb]y:.*(claude|anthropic)'
    '[Cc]o-[Aa]uthored-[Bb]y:.*noreply@anthropic\.com'
    '[Aa]uthored-[Bb]y:.*(claude|anthropic)'
    '[Gg]enerated with.*[Cc]laude'
    # OpenAI / Codex / ChatGPT / Copilot
    '[Cc]o-[Aa]uthored-[Bb]y:.*(openai|codex|chatgpt|copilot)'
    '[Cc]o-[Aa]uthored-[Bb]y:.*noreply@openai\.com'
    '[Aa]uthored-[Bb]y:.*(openai|codex|chatgpt|copilot)'
    '[Gg]enerated (with|by).*(openai|codex|chatgpt|copilot|gpt-[0-9])'
    # Generic AI attribution
    '[Cc]o-[Aa]uthored-[Bb]y:.*\b(ai|llm|assistant)\b'
    '[Gg]enerated (with|by).*\b(ai|llm)\b'
)

for pattern in "${PATTERNS[@]}"; do
    if grep -qiE "$pattern" "$MSG_FILE"; then
        echo "ERROR: commit message contains a prohibited AI authorship marker."
        echo "Matched pattern: $pattern"
        echo "Remove any Co-Authored-By or Generated-with lines referencing AI tools."
        exit 1
    fi
done

exit 0
