+// The owned argument's shared cleanup is outside the loop. The early Err must
+// reach that cleanup and return, not fall through the loop or overwrite it with Ok.
+pub fn check(values: Vec<u32>, enabled: bool) -> Result<u32, u32> {
+    if !enabled {
+        return Err(9);
+    }
+    let mut index = 0;
+    while index < values.len() {
+        if values[index] == 0 {
+            return Err(0);
+        }
+        index += 1;
+    }
+    Ok(1)
