# charon integration step 23 after 546078ea5d: commit ece64982bc0b300466e3462adb4ea14a5f15aa40
# first parent c90cda2427297e24ab0d13fcc44da52a1bb82a8b
# series charon: patch -p1 in charon/ of the upstream source
#
# charon: reconstruct Box initializations with early exits in the element expression
#
# An early return, `?` or break inside an element of vec![..] exits while the
# exchange_malloc/ShallowInitBox allocation is still uninitialized. On that path
# MIR drops the box (only freeing the allocation, no pointee exists) and then
# ends the box local's storage. reconstruct_boxes already accepted the
# conditional drop on exit-only paths but rejected the StorageDead that follows,
# so e.g. vec![match x { A(n) => n, _ => return None }] failed with 'branching
# during Box initialization is not supported' (fatal under --error-on-warnings).
#
# Accept StorageDead of the box local on exit-only paths too (rejected on any
# path that can still reach the initialization, and before the assignment in
# the same block). After the rewrite the box is never allocated on the exit
# path: the local is uninitialized there and its conditional drop does nothing,
# matching the builtin Box abstraction of allocation storage. The new
# box-init-early-exit ui test covers return, ? and break; Aeneas translates its
# LLBC (early exit -> none, no Box value). The upstream known-failure test
# issue-393-shallowinitbox (vec![if b { 42 } else { return None }]) now
# translates.

diff --git a/src/transform/resugar/reconstruct_boxes.rs b/src/transform/resugar/reconstruct_boxes.rs
index 92562c8..7025fba 100644
--- a/src/transform/resugar/reconstruct_boxes.rs
+++ b/src/transform/resugar/reconstruct_boxes.rs
@@ -21,8 +21,11 @@ fn mentions_local(value: &impl AstVisitable, local: LocalId) -> bool {
 /// We accept acyclic control flow ending at one whole-pointee assignment (possibly
 /// reached through several branches), or at an exit. Partial writes, aliases,
 /// moves and precise drops of the shallow box are rejected. A conditional drop
-/// is permitted only on an exit-only path: no pointee has been initialized, so
-/// it can only release allocation storage, which builtin Box abstracts away.
+/// and the end of the box's storage are permitted only on an exit-only path, such
+/// as an early `return`, `?` or `break` in an element expression or an unwind: no
+/// pointee has been initialized, so the drop can only release allocation storage,
+/// which builtin Box abstracts away. After the rewrite the box local is simply
+/// uninitialized there, and the conditional drop does nothing.
 struct Initialization<'a> {
     body: &'a BodyContents,
     box_place: &'a Place,
@@ -44,11 +47,19 @@ impl Initialization<'_> {
         let block = self.body.get(id)?;
         let local = self.box_place.as_local()?;
         let start = if id == self.entry { 2 } else { 0 };
+        let mut storage_dead = false;
         for (index, statement) in block.statements.iter().enumerate().skip(start) {
+            if matches!(statement.kind, StatementKind::StorageDead(dead) if dead == local) {
+                storage_dead = true;
+                continue;
+            }
             if let StatementKind::Assign(place, value) = &statement.kind
                 && let Some((base, ProjectionElem::Deref)) = place.as_projection()
                 && base == self.box_place
             {
+                if storage_dead {
+                    return None;
+                }
                 if mentions_local(value, local) {
                     return None;
                 }
@@ -77,7 +88,7 @@ impl Initialization<'_> {
         for target in block.targets() {
             reaches_init |= self.visit(target)?;
         }
-        if shallow_cleanup && reaches_init {
+        if (shallow_cleanup || storage_dead) && reaches_init {
             return None;
         }
         self.active.remove(&id);
