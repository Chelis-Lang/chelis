diff --git a/tests/ui/box-init-early-exit.rs b/tests/ui/box-init-early-exit.rs
new file mode 100644
index 0000000..ebc5e74
--- /dev/null
+++ b/tests/ui/box-init-early-exit.rs
@@ -0,0 +1,34 @@
+// An early exit (`return`, `?`, `break`) inside an element of `vec![..]` leaves
+// the `exchange_malloc`/`ShallowInitBox` allocation uninitialized on the exit
+// path, where MIR frees it without dropping any contents.
+pub enum Shape {
+    Scalar(u32),
+    Other,
+}
+
+pub fn early_return(shape: Shape) -> Option<Vec<u32>> {
+    Some(vec![match shape {
+        Shape::Scalar(n) => n,
+        _ => return None,
+    }])
+}
+
+pub fn question_mark(first: Option<u32>, second: Option<u32>) -> Option<Vec<u32>> {
+    Some(vec![first?, second?])
+}
+
+pub fn break_out(items: &[u32]) -> Vec<Vec<u32>> {
+    let mut out = Vec::new();
+    for item in items {
+        out.push(vec![if *item == 0 { break } else { *item }]);
+    }
+    out
+}
+
+fn main() {
+    assert_eq!(early_return(Shape::Scalar(3)), Some(vec![3]));
+    assert_eq!(early_return(Shape::Other), None);
+    assert_eq!(question_mark(Some(1), Some(2)), Some(vec![1, 2]));
+    assert_eq!(question_mark(Some(1), None), None);
+    assert_eq!(break_out(&[1, 2, 0, 3]), vec![vec![1], vec![2]]);
+}
