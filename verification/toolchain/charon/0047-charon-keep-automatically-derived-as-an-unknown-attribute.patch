# series charon: patch -p1 in charon/ of the upstream source
#
# charon: keep #[automatically_derived] as an unknown attribute
#
# rustc parses #[automatically_derived] (AttributeKind::AutomaticallyDerived),
# and translate_attribute dropped every parsed attribute but doc comments, so
# consumers could not tell a derived impl from a hand-written one. Keep it as
# Attribute::Unknown { path: "automatically_derived", args: None }: Aeneas
# admits sort models over #[derive(Ord)] types by it.
#
# Test: crate_data automatically_derived (a derived and a hand-written
# PartialEq impl; only the derived impls carry the attribute).

