+#[test]
+fn automatically_derived() -> anyhow::Result<()> {
+    // rustc marks the impls that `#[derive(..)]` generates with the (parsed) attribute
+    // `#[automatically_derived]`: only those impls carry it, as an unknown attribute.
+    let crate_data = translate(
+        r#"
+        #[derive(PartialEq)]
+        struct Derived(u32);
+
+        struct Manual(u32);
+
+        impl PartialEq for Manual {
+            fn eq(&self, other: &Self) -> bool {
+                self.0 == other.0
+            }
+        }
+        "#,
+    )?;
+    // (trait, implementing type, attributes) of each impl of the crate.
+    let impls = crate_data
+        .trait_impls
+        .iter()
+        .filter(|timpl| timpl.item_meta.is_local)
+        .map(|timpl| {
+            let trait_name = trait_name(&crate_data, timpl.impl_trait.id);
+            let self_ty = match timpl.impl_trait.generics.types[0].kind() {
+                TyKind::Adt(TypeDeclRef {
+                    id: TypeId::Adt(id),
+                    ..
+                }) => repr_name(&crate_data, &crate_data.type_decls[*id].item_meta.name),
+                ty => panic!("unexpected implementing type: {ty:?}"),
+            };
+            let attrs = timpl
+                .item_meta
+                .attr_info
+                .attributes
+                .iter()
+                .map(|a| a.as_unknown().map(|a| a.to_string()))
+                .collect_vec();
+            (trait_name.to_owned(), self_ty, attrs)
+        })
+        .sorted()
+        .collect_vec();
+    let derived = vec![Some("automatically_derived".to_owned())];
+    assert_eq!(
+        impls,
+        vec![
+            (
+                "PartialEq".to_owned(),
+                "test_crate::Derived".to_owned(),
+                derived.clone()
+            ),
+            (
+                "PartialEq".to_owned(),
+                "test_crate::Manual".to_owned(),
+                vec![]
+            ),
+            (
+                "StructuralPartialEq".to_owned(),
+                "test_crate::Derived".to_owned(),
+                derived
+            ),
+        ]
+    );
+    Ok(())
+}
