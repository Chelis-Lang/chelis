+/// Pattern files can hold more patterns than fit in the arguments and environment of a process
+/// (`ARG_MAX`: 1 MiB in total on macOS; 128 KiB per string on Linux). Charon still passes them all
+/// to charon-driver, directly or through cargo, and records them in the options of the llbc.
+#[test]
+fn charon_large_pattern_files() -> Result<()> {
+    use charon_lib::{ast::Body, export::CrateData};
+    let dir = tempfile::TempDir::new()?;
+    let path = |name: &str| dir.path().join(name).to_str().unwrap().to_owned();
+    // 2 * 30k patterns of 48 bytes that select nothing, and one per crate that selects its function.
+    let absent =
+        |kind| (0..30_000).map(move |i| format!("crate2::absent_{kind}_{i:08}_{:_<16}", ""));
+    let opaque = absent("opaque")
+        .chain(["crate1::random_number", "crate2::extra_random_number"].map(str::to_owned))
+        .collect_vec();
+    let opaque_hard = absent("hard").collect_vec();
+    let (opaque_file, hard_file) = (path("opaque.txt"), path("hard.txt"));
+    std::fs::write(&opaque_file, opaque.join("\n"))?;
+    std::fs::write(&hard_file, opaque_hard.join("\n"))?;
+    let patterns = [
+        "--opaque-file",
+        &opaque_file,
+        "--opaque-hard-file",
+        &hard_file,
+    ];
+
+    let check = |llbc: &str, fun: &str| -> Result<()> {
+        let krate = CrateData::deserialize_from_file(llbc.as_ref())?.translated;
+        let recorded = &krate.options.opaque;
+        ensure!(
+            recorded.iter().eq(opaque.iter().chain(&opaque_hard)),
+            "{llbc} records {} opaque patterns instead of the {} of the files",
+            recorded.len(),
+            opaque.len() + opaque_hard.len()
+        );
+        let decl = krate
+            .fun_decls
+            .iter()
+            .find(|decl| repr_name(&krate, &decl.item_meta.name) == fun)
+            .with_context(|| format!("{llbc} has no {fun}"))?;
+        ensure!(matches!(decl.body, Body::Opaque), "{fun} is not opaque");
+        Ok(())
+    };
+
+    let input = std::fs::canonicalize("tests/cargo/workspace/crate1/src/lib.rs")?;
+    let input = input.to_str().unwrap();
+    let llbc = path("crate1.llbc");
+    let rustc = ["--", "--crate-type=lib", "--crate-name=crate1", input];
+    let args = [&["rustc", "--dest-file", &llbc][..], &patterns, &rustc].concat();
+    charon(&args, ".", |_, _| Ok(()))?;
+    check(&llbc, "crate1::random_number")?;
+
+    let llbc = path("crate2.llbc");
+    let cargo = ["--", "-p", "crate2", "--quiet"];
+    let args = [&["cargo", "--dest-file", &llbc][..], &patterns, &cargo].concat();
+    charon(&args, "tests/cargo/workspace", |_, _| Ok(()))?;
+    check(&llbc, "crate2::extra_random_number")
+}
