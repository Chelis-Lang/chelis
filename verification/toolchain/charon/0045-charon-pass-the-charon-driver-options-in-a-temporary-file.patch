+/// Pass the options to charon-driver, in a fresh temporary file whose path `cmd` passes in
+/// `CHARON_ARGS_FILE`. The file must outlive `cmd`: dropping the returned handle removes it.
+fn set_driver_options(
+    cmd: &mut std::process::Command,
+    options: &CliOpts,
+) -> anyhow::Result<tempfile::NamedTempFile> {
+    let mut file = tempfile::Builder::new()
+        .prefix("charon-args-")
+        .suffix(".json")
+        .tempfile()
+        .context("failed to create the charon-driver options file")?;
+    let bytes = options.to_driver_args()?;
+    file.write_all(&bytes)
+        .with_context(|| format!("failed to write {}", file.path().display()))?;
+    cmd.env(CHARON_ARGS_FILE, std::path::absolute(file.path())?);
+    Ok(file)
 }
 
