+
+    /// Replace in `x` the associated types of impls (`<{impl Trait for T}<args> as Trait>::Name`)
+    /// by the values the impls give them, instantiated with the impl arguments; at most `depth`
+    /// nested replacements. Other associated types are kept.
+    fn normalize<T: AstVisitable>(&self, x: &mut T, depth: usize) {
+        if depth == 0 {
+            return;
+        }
+        let _ = NormalizeImplTypes {
+            pristine: self,
+            depth,
+        }
+        .visit(x);
+    }
+}
+
+/// See `PristineClauses::normalize`.
+#[derive(Visitor)]
+struct NormalizeImplTypes<'a> {
+    pristine: &'a PristineClauses,
+    depth: usize,
+}
+
+impl VisitAstMut for NormalizeImplTypes<'_> {
+    // On exit, so that the arguments of the impl are already normalized.
+    fn exit_ty(&mut self, ty: &mut Ty) {
+        if let TyKind::TraitType(tref, name) = ty.kind()
+            && let TraitRefKind::TraitImpl(impl_ref) = &tref.kind
+            && let Some(value) = self.pristine.impl_types.get(&(impl_ref.id, *name))
+            && let Ok(mut value) = value
+                .clone()
+                .try_substitute_with_self(&impl_ref.generics, &tref.kind)
+        {
+            self.pristine.normalize(&mut value, self.depth - 1);
+            *ty = value;
+        }
+    }
 }
 
