+++ b/tests/ui/lift-assoc-types-projection-clause-regions.rs
@@ -0,0 +1,64 @@
+//@ charon-arg=--lift-associated-types=*
+// A clause about an associated type of an earlier clause keeps the lifetimes of the ADT arguments
+// in a signature. `Flatten<I>` requires `I: Seq` and `I::Item: IntoSeq`; for
+// `Flatten<Once<&'a List<u32>>>` the second clause is proven by `{impl IntoSeq for &'a List<T>}`,
+// resolved with an erased lifetime, so the associated types computed from it used to be
+// `&'_ u32` and `Iter<'_, u32>` below (the `Flatten<option::IntoIter<&'a Vec<_>>>` returned by
+// `chelis_types::env::Env::lookup_constructors`), which Aeneas rejects. The same holds for the
+// clauses of the impl `Seq for Flatten<I>` behind `Peek<Flatten<..>>`.
+pub trait Seq {
+    type Item;
+}
+pub trait IntoSeq {
+    type Item;
+    type IntoSeq: Seq<Item = Self::Item>;
+}
+
+pub struct Once<T>(pub T);
+impl<T> Seq for Once<T> {
+    type Item = T;
+}
+
+pub struct Iter<'a, T>(pub &'a T);
+impl<'a, T> Seq for Iter<'a, T> {
+    type Item = &'a T;
+}
+
+pub struct List<T>(pub T);
+impl<'a, T> IntoSeq for &'a List<T> {
+    type Item = &'a T;
+    type IntoSeq = Iter<'a, T>;
+}
+
+pub struct Flatten<I: Seq>
+where
+    I::Item: IntoSeq,
+{
+    pub iter: I,
+    pub front: Option<<I::Item as IntoSeq>::IntoSeq>,
+}
+impl<I: Seq> Seq for Flatten<I>
+where
+    I::Item: IntoSeq,
+{
+    type Item = <I::Item as IntoSeq>::Item;
+}
+
+pub struct Peek<S: Seq> {
+    pub seq: S,
+    pub next: Option<S::Item>,
+}
+
+pub fn flatten<'a>(l: &'a List<u32>) -> Flatten<Once<&'a List<u32>>> {
+    Flatten {
+        iter: Once(l),
+        front: Some(Iter(&l.0)),
+    }
+}
+
+pub fn peek<'a>(l: &'a List<u32>) -> Peek<Flatten<Once<&'a List<u32>>>> {
+    Peek {
+        next: Some(&l.0),
+        seq: flatten(l),
+    }
+}
