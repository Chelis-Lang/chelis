+/// Order the trait clauses of `params` so that each clause comes after the clauses its trait
+/// reference mentions, keeping the order of the clauses otherwise. The clause variables bound by
+/// `params` are renumbered in `params` and in `value`, and the trait refs of `args`, which
+/// instantiate `params`, are permuted accordingly.
+///
+/// `compute_shape` appends the clauses of the infected ADTs after the clauses of the original item,
+/// which mention these ADTs applied to the appended clauses (e.g. `[@TraitClause0]:
+/// Fn<closure[@TraitClause1]>` before `[@TraitClause1]: Copy<T0>`). Consumers which bind the
+/// clauses of an item in order (e.g. the Lean output of Aeneas) need the clauses a clause mentions
+/// to be bound before it.
+fn order_clauses_by_dependencies(
+    params: &mut GenericParams,
+    value: &mut GenericArgs,
+    args: &mut GenericArgs,
+) {
+    let num_clauses = params.trait_clauses.len();
+    if args.trait_refs.len() != num_clauses {
+        return;
+    }
+    struct ClauseDeps(HashSet<TraitClauseId>);
+    impl VarsVisitor for ClauseDeps {
+        fn visit_clause_var(&mut self, v: ClauseDbVar) -> Option<TraitRefKind> {
+            if let DeBruijnVar::Bound(DeBruijnId::ZERO, id) = v {
+                self.0.insert(id);
+            }
+            None
+        }
+    }
+    let deps: Vec<HashSet<TraitClauseId>> = params
+        .trait_clauses
+        .iter()
+        .map(|clause| {
+            let mut deps = ClauseDeps(HashSet::new());
+            clause.clone().visit_vars(&mut deps);
+            deps.0
+        })
+        .collect();
+    // Place the first clause whose dependencies are placed. With a cycle (which Rust rejects),
+    // we keep the remaining clauses in their order.
+    let mut placed = vec![false; num_clauses];
+    let mut order: Vec<usize> = Vec::with_capacity(num_clauses);
+    while order.len() < num_clauses {
+        let ready = |i: usize| {
+            !placed[i]
+                && deps[i]
+                    .iter()
+                    .all(|d| d.index() == i || placed.get(d.index()).copied().unwrap_or(true))
+        };
+        let next = (0..num_clauses)
+            .find(|&i| ready(i))
+            .or_else(|| (0..num_clauses).find(|&i| !placed[i]))
+            .unwrap();
+        placed[next] = true;
+        order.push(next);
+    }
+    if order.iter().enumerate().all(|(new, &old)| new == old) {
+        return;
+    }
+
+    let mut new_ids = vec![TraitClauseId::ZERO; num_clauses];
+    for (new, &old) in order.iter().enumerate() {
+        new_ids[old] = TraitClauseId::new(new);
+    }
+    struct RenumberClauses(Vec<TraitClauseId>);
+    impl VarsVisitor for RenumberClauses {
+        fn visit_clause_var(&mut self, v: ClauseDbVar) -> Option<TraitRefKind> {
+            if let DeBruijnVar::Bound(DeBruijnId::ZERO, id) = v
+                && let Some(&new_id) = self.0.get(id.index())
+            {
+                Some(TraitRefKind::Clause(DeBruijnVar::Bound(
+                    DeBruijnId::ZERO,
+                    new_id,
+                )))
+            } else {
+                None
+            }
+        }
+    }
+    let mut renumber = RenumberClauses(new_ids);
+    params.visit_vars(&mut renumber);
+    value.visit_vars(&mut renumber);
+
+    let mut clauses: Vec<Option<TraitParam>> = mem::take(&mut params.trait_clauses)
+        .into_iter()
+        .map(Some)
+        .collect();
+    params.trait_clauses = order
+        .iter()
+        .enumerate()
+        .map(|(new, &old)| {
+            let mut clause = clauses[old].take().unwrap();
+            clause.clause_id = TraitClauseId::new(new);
+            clause
+        })
+        .collect();
+    let mut trait_refs: Vec<Option<TraitRef>> = mem::take(&mut args.trait_refs)
+        .into_iter()
+        .map(Some)
+        .collect();
+    args.trait_refs = order
+        .iter()
+        .map(|&old| trait_refs[old].take().unwrap())
+        .collect();
+}
