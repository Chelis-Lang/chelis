@@ -0,0 +1,22 @@
+//@ no-default-options
+//@ charon-args=--preset=aeneas --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=*
+// The trait clauses of a partially monomorphized item come after the clauses
+// they mention. Specializing `apply` for the closure of `with_state` (which
+// captures `&mut S` and keeps the clauses `S: Copy` and `F: Fn(&mut u32, S)`)
+// merges the clauses of the closure type into the generics of the specialized
+// `apply`; its own clause `Fn<closure[..]>` mentions them, so it must follow
+// them.
+pub fn apply<R>(x: &mut u32, f: impl Fn(&mut u32) -> R) -> R {
+    f(x)
+}
+
+pub fn with_state<S: Copy, R>(x: &mut u32, state: &mut S, f: impl Fn(&mut u32, S) -> R) -> R {
+    apply(x, move |y| f(y, *state))
+}
+
+pub fn scaled(x: &mut u32, k: &mut u32) -> u32 {
+    with_state(x, k, |x, k| {
+        *x = x.wrapping_mul(k);
+        *x
+    })
+}
