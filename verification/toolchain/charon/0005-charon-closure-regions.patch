+/// Only runtime fields contribute captured state. In particular, closure types
+/// can retain enclosing lifetime/type parameters without storing any of them.
+#[derive(Clone, Default, PartialEq, Eq)]
+struct RuntimeTypeShape {
+    contains_mut: bool,
+    type_params: HashSet<TypeVarId>,
+}
+
+impl RuntimeTypeShape {
+    fn collect(&mut self, ty: &Ty, known: &HashMap<TypeDeclId, Self>) {
+        match ty.kind() {
+            TyKind::Ref(_, inner, kind) => {
+                self.contains_mut |= *kind == RefKind::Mut;
+                self.collect(inner, known);
+            }
+            TyKind::RawPtr(inner, _) | TyKind::Array(inner, _) | TyKind::Slice(inner) => {
+                self.collect(inner, known);
+            }
+            TyKind::TypeVar(DeBruijnVar::Bound(depth, id)) if *depth == DeBruijnId::zero() => {
+                self.type_params.insert(*id);
+            }
+            TyKind::TypeVar(DeBruijnVar::Free(id)) => {
+                self.type_params.insert(*id);
+            }
+            TyKind::Adt(tref) => {
+                let shape = match tref.id {
+                    TypeId::Adt(id) => known.get(&id),
+                    _ => None,
+                };
+                if let Some(shape) = shape {
+                    self.contains_mut |= shape.contains_mut;
+                    for id in &shape.type_params {
+                        if let Some(ty) = tref.generics.types.get(*id) {
+                            self.collect(ty, known);
+                        }
+                    }
+                } else {
+                    for ty in &tref.generics.types {
+                        self.collect(ty, known);
+                    }
+                }
+            }
+            // Function signatures and trait evidence are not stored captures.
+            TyKind::FnDef(..)
+            | TyKind::FnPtr(..)
+            | TyKind::DynTrait(_)
+            | TyKind::TypeVar(_)
+            | TyKind::Literal(_)
+            | TyKind::Never
+            | TyKind::TraitType(..)
+            | TyKind::PtrMetadata(..)
+            | TyKind::Error(_) => {}
+        }
+    }
+
+    fn compute(ctx: &TransformCtx) -> HashMap<TypeDeclId, Self> {
+        let mut shapes: HashMap<_, _> = ctx
+            .translated
+            .type_decls
+            .iter()
+            .map(|decl| {
+                let shape = match decl.kind {
+                    TypeDeclKind::Opaque | TypeDeclKind::Error(_) => Self {
+                        // Unknown opaque storage still requires conservative ownership.
+                        contains_mut: decl
+                            .generics
+                            .regions
+                            .iter()
+                            .any(|r| !r.mutability.is_shared()),
+                        type_params: decl.generics.types.indices().collect(),
+                    },
