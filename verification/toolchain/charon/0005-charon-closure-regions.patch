@@ -0,0 +1,150 @@
+//! Preserve closure lifetime requirements before rustc steals the MIR.
+//!
+//! Closure signatures erase free lifetimes independently at each occurrence.
+//! Freshening these occurrences is necessary, but their borrowck constraints
+//! must accompany them: they are not independent lifetime parameters.
+use rustc_borrowck::consumers::{ConsumerOptions, get_bodies_with_borrowck_facts};
+use rustc_data_structures::fx::{FxHashMap, FxHashSet, FxIndexMap};
+use rustc_hir::def::DefKind;
+use rustc_hir::def_id::LocalDefId;
+use rustc_middle::ty::{self, TyCtxt};
+use std::sync::{LazyLock, Mutex};
+
+#[derive(Clone, Debug)]
+pub struct ClosureRegionRelations {
+    pub signature_regions: usize,
+    pub capture_regions: usize,
+    /// Indices into the free regions of the signature followed by the captures.
+    pub outlives: Vec<(usize, usize)>,
+}
+
+static RELATIONS: LazyLock<Mutex<FxHashMap<LocalDefId, ClosureRegionRelations>>> =
+    LazyLock::new(|| Mutex::new(FxHashMap::default()));
+static CLOSURE_ROOTS: Mutex<Option<FxHashSet<LocalDefId>>> = Mutex::new(None);
+
+pub fn clear() {
+    RELATIONS.lock().expect("closure-region cache poisoned").clear();
+    *CLOSURE_ROOTS.lock().expect("closure-region cache poisoned") = None;
+}
+
+pub fn lookup(def_id: LocalDefId) -> Option<ClosureRegionRelations> {
+    RELATIONS.lock().expect("closure-region cache poisoned").get(&def_id).cloned()
+}
+
+type BorrowckProvider = for<'tcx> fn(
+    TyCtxt<'tcx>,
+    LocalDefId,
+) -> Result<
+    &'tcx FxIndexMap<LocalDefId, ty::DefinitionSiteHiddenType<'tcx>>,
+    rustc_errors::ErrorGuaranteed,
+>;
+static ORIGINAL_BORROWCK: Mutex<Option<BorrowckProvider>> = Mutex::new(None);
+
+pub fn install(providers: &mut rustc_middle::util::Providers) {
+    *ORIGINAL_BORROWCK.lock().expect("closure-region cache poisoned") = Some(providers.queries.mir_borrowck);
+    providers.queries.mir_borrowck = |tcx, root| {
+        // Preserve the provider's diagnostics and opaque-type inference result.
+        // It borrows MIR; subsequent compiler passes steal it only after this
+        // query returns. Do not try to infer a contract for rejected code.
+        let original = ORIGINAL_BORROWCK.lock().expect("closure-region cache poisoned").expect("missing borrowck provider");
+        let result = original(tcx, root)?;
+        capture(tcx, root);
+        Ok(result)
+    };
+}
+
+pub fn capture<'tcx>(tcx: TyCtxt<'tcx>, root: LocalDefId) {
+    // Most roots have no closure, and do not need the consumer's second MIR
+    // type-check. The ordinary mir_borrowck provider still runs for every root.
+    let has_closures = {
+        let mut roots = CLOSURE_ROOTS.lock().expect("closure-region cache poisoned");
+        roots.get_or_insert_with(|| {
+            tcx.hir_body_owners()
+                .filter(|&id| matches!(tcx.def_kind(id), DefKind::Closure))
+                .map(|id| tcx.typeck_root_def_id(id.to_def_id()).expect_local())
+                .collect()
+        }).contains(&root)
+    };
+    if !has_closures {
+        return;
+    }
+    let bodies = get_bodies_with_borrowck_facts(
+        tcx,
+        root,
+        ConsumerOptions::PoloniusInputFacts,
+    );
+    for (id, facts) in bodies {
+        if !matches!(tcx.def_kind(id), DefKind::Closure) {
+            continue;
+        }
+        let mut self_ty = facts.body.local_decls[rustc_middle::mir::Local::from_usize(1)].ty;
+        while let ty::Ref(_, inner, _) = self_ty.kind() {
+            self_ty = *inner;
+        }
+        let ty::Closure(_, args) = self_ty.kind() else {
+            // Coroutine closures have a different environment/signature layout.
+            continue;
+        };
+        let args = args.as_closure();
+        let mut regions = Vec::new();
+        let mut collect = |r: ty::Region<'tcx>, _| {
+            let vid = match r.kind() {
+                ty::ReVar(vid) => vid,
+                ty::ReStatic => ty::RegionVid::from_usize(0),
+                _ => panic!("unexpected free closure borrowck region: {r:?}"),
+            };
+            regions.push(vid);
+            r
+        };
+        ty::fold_regions(tcx, args.sig(), &mut collect);
+        let signature_regions = regions.len();
+        ty::fold_regions(tcx, args.upvar_tys(), |r, _| {
+            let vid = match r.kind() {
+                ty::ReVar(vid) => vid,
+                ty::ReStatic => ty::RegionVid::from_usize(0),
+                _ => panic!("unexpected free capture borrowck region: {r:?}"),
+            };
+            regions.push(vid);
+            r
+        });
+        let capture_regions = regions.len() - signature_regions;
+        let sccs = facts.region_inference_context.constraint_sccs();
+        // The SCC graph contains MIR constraints, but rustc stores assumed
+        // universal-region relations (including implied well-formedness bounds
+        // on captured references) separately. The Polonius input exporter
+        // exposes their exact outlives base edges; requesting these facts does
+        // not run Polonius. Include them before taking transitive closure.
+        let input_facts = facts.input_facts.as_ref()
+            .expect("missing requested closure borrowck input facts");
+        let mut universal_successors = FxHashMap::<_, Vec<_>>::default();
+        for &(longer, shorter) in &input_facts.known_placeholder_subset {
+            let longer = sccs.scc(ty::RegionVid::from(longer));
+            let shorter = sccs.scc(ty::RegionVid::from(shorter));
+            universal_successors.entry(longer).or_default().push(shorter);
+        }
+        let mut outlives = Vec::new();
+        for (i, &region) in regions.iter().enumerate() {
+            // Use actual constraint paths, not inclusion of inferred local
+            // liveness sets (unrelated locals can have equal liveness sets).
+            let mut seen = FxHashSet::default();
+            let mut pending = vec![sccs.scc(region)];
+            while let Some(scc) = pending.pop() {
+                if seen.insert(scc) {
+                    pending.extend_from_slice(sccs.successors(scc));
+                    if let Some(successors) = universal_successors.get(&scc) {
+                        pending.extend_from_slice(successors);
+                    }
+                }
+            }
+            for (j, &other) in regions.iter().enumerate() {
+                if i != j && seen.contains(&sccs.scc(other)) {
+                    outlives.push((i, j));
+                }
+            }
+        }
+        RELATIONS.lock().expect("closure-region cache poisoned").insert(
+            id,
+            ClosureRegionRelations { signature_regions, capture_regions, outlives },
+        );
+    }
+}
