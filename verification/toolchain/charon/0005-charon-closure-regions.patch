+    pub fn translate_closure_region_outlives(
+        &mut self,
+        span: Span,
+        args: &hax::ClosureArgs,
+        include_signature: bool,
+    ) -> Result<(), Error> {
+        assert_eq!(
+            args.erased_capture_regions,
+            self.the_only_binder().closure_upvar_regions.len(),
+            "closure capture lifetime traversal changed during type translation",
+        );
+        let mut translate = |region: &hax::ClosureRegion| -> Result<Option<Region>, Error> {
+            Ok(Some(match region {
+                hax::ClosureRegion::Signature(_) if !include_signature => return Ok(None),
+                hax::ClosureRegion::Signature(r) | hax::ClosureRegion::Capture(r) => {
+                    self.translate_region(span, r)?
+                }
+                hax::ClosureRegion::ErasedCapture(index) => {
+                    let id = self.the_only_binder().closure_upvar_regions[*index];
+                    Region::Var(DeBruijnVar::new_at_zero(id))
+                }
+            }))
+        };
+        let mut predicates = Vec::new();
+        for (longer, shorter) in &args.region_outlives {
+            if let (Some(longer), Some(shorter)) = (translate(longer)?, translate(shorter)?) {
+                if longer != shorter {
+                    let pred = RegionBinder::empty(OutlivesPred(longer, shorter));
+                    if !predicates.contains(&pred) {
+                        predicates.push(pred);
+                    }
+                }
+            }
+        }
+        self.innermost_generics_mut().regions_outlive.extend(predicates);
+        Ok(())
+    }
