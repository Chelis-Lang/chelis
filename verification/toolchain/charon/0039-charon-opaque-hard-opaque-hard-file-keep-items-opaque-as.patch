+//@ no-default-options
+//@ charon-args=--preset=aeneas --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=*
+//@ charon-arg=--opaque-hard=test_crate::native
+//@ charon-arg=--opaque-hard-file=tests/ui/monomorphize-mut-opaque-hard.patterns
+//@ charon-arg=--opaque=test_crate::external
+//@ charon-arg=--start-from=test_crate::user
+// `--opaque-hard` (and `--opaque-hard-file`) items are opaque as if annotated with
+// `#[charon::opaque]`: under `--monomorphize-mut`, a generic one keeps no body, neither does the one
+// instance partial monomorphization creates for the `&mut` arguments used here (called twice), and
+// its closures are not translated. The `--opaque` generic item (`external`) still keeps its
+// contents for its instance.
+pub fn native<T>(x: T, mut f: impl FnMut(T)) {
+    let mut g = |y: T| f(y);
+    g(x)
+}
+
+pub fn external<T>(x: T, mut f: impl FnMut(T)) {
+    let mut g = |y: T| f(y);
+    g(x)
+}
+
+pub struct Runtime;
+
+impl Runtime {
+    pub fn observe<P>(&mut self, payload: P) -> P {
+        let echo = |p: P| p;
+        echo(payload)
+    }
+}
+
+fn bump(r: &mut u32) {
+    *r += 1;
+}
+
+pub fn user(runtime: &mut Runtime, v: &mut u32) -> u32 {
+    native(&mut *v, bump);
+    native(&mut *v, bump);
+    external(&mut *v, bump);
+    let r = runtime.observe(v);
+    *r
+}
