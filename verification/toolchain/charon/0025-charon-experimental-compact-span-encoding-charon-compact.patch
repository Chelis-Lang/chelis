+#[test]
+fn compact_spans_round_trip() {
+    let data = |file, line| SpanData {
+        file_id: FileId::new(file),
+        beg: Loc { line, col: 4 },
+        end: Loc {
+            line: line + 1,
+            col: 0,
+        },
+    };
+    for span in [
+        Span {
+            data: data(3, 10),
+            generated_from_span: None,
+        },
+        Span {
+            data: data(3, 10),
+            generated_from_span: Some(data(7, 2)),
+        },
+    ] {
+        let full = serde_json::to_string(&span).unwrap();
+        let compact = with_compact_spans(|| serde_json::to_string(&span).unwrap());
+        assert!(full.starts_with("{\"data\":"), "{full}");
+        assert!(compact.starts_with("[3,10,4,11,0"), "{compact}");
+        for json in [full, compact] {
+            assert_eq!(serde_json::from_str::<Span>(&json).unwrap(), span, "{json}");
+        }
+    }
+    // The flag is scoped to the closure.
+    let span = Span {
+        data: data(1, 1),
+        generated_from_span: None,
+    };
+    assert!(serde_json::to_string(&span).unwrap().starts_with('{'));
+}
