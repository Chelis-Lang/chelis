+// Stateless, like `#[serde_state(stateless)]`, whose derive does not support `serde(into/from)`.
+impl<State: ?Sized> SerializeState<State> for Span {
+    fn serialize_state<S: serde::Serializer>(&self, _: &State, s: S) -> Result<S::Ok, S::Error> {
+        self.serialize(s)
+    }
+}
+impl<'de, State: ?Sized> DeserializeState<'de, State> for Span {
+    fn deserialize_state<D: serde::Deserializer<'de>>(_: &State, d: D) -> Result<Self, D::Error> {
+        Self::deserialize(d)
+    }
+}
+
+thread_local! {
+    static COMPACT_SPANS: std::cell::Cell<bool> = const { std::cell::Cell::new(false) };
+}
+
+/// Run `f` (a serialization) with the experimental compact span encoding: a span is the array
+/// `[file, beg_line, beg_col, end_line, end_col]`, followed by the same five numbers for
+/// `generated_from_span` when present. Only charon's own deserializer reads it; charon-ml does not.
+pub fn with_compact_spans<R>(f: impl FnOnce() -> R) -> R {
+    struct Reset(bool);
+    impl Drop for Reset {
+        fn drop(&mut self) {
+            COMPACT_SPANS.set(self.0);
+        }
+    }
+    let _reset = Reset(COMPACT_SPANS.replace(true));
+    f()
+}
+
+/// The serialized form of a [Span]; deserialization accepts both encodings.
+#[derive(Serialize, Deserialize)]
+#[serde(untagged)]
+enum SpanRepr {
+    Compact([usize; 5]),
+    CompactGenerated([usize; 10]),
+    Full {
+        data: SpanData,
+        generated_from_span: Option<SpanData>,
+    },
+}
+
+impl SpanData {
+    fn to_array(self) -> [usize; 5] {
+        [
+            self.file_id.index(),
+            self.beg.line,
+            self.beg.col,
+            self.end.line,
+            self.end.col,
+        ]
+    }
+
+    fn from_array([file, beg_line, beg_col, end_line, end_col]: [usize; 5]) -> Self {
+        SpanData {
+            file_id: FileId::new(file),
+            beg: Loc {
+                line: beg_line,
+                col: beg_col,
+            },
+            end: Loc {
+                line: end_line,
+                col: end_col,
+            },
+        }
+    }
+}
+
+impl From<Span> for SpanRepr {
+    fn from(span: Span) -> Self {
+        if !COMPACT_SPANS.get() {
+            return SpanRepr::Full {
+                data: span.data,
+                generated_from_span: span.generated_from_span,
+            };
+        }
+        let data = span.data.to_array();
+        match span.generated_from_span {
+            None => SpanRepr::Compact(data),
+            Some(generated) => {
+                let mut both = [0; 10];
+                both[..5].copy_from_slice(&data);
+                both[5..].copy_from_slice(&generated.to_array());
+                SpanRepr::CompactGenerated(both)
+            }
+        }
+    }
+}
+
+impl From<SpanRepr> for Span {
+    fn from(repr: SpanRepr) -> Self {
+        match repr {
+            SpanRepr::Compact(data) => Span {
+                data: SpanData::from_array(data),
+                generated_from_span: None,
+            },
+            SpanRepr::CompactGenerated(both) => Span {
+                data: SpanData::from_array(both[..5].try_into().unwrap()),
+                generated_from_span: Some(SpanData::from_array(both[5..].try_into().unwrap())),
+            },
+            SpanRepr::Full {
+                data,
+                generated_from_span,
+            } => Span {
+                data,
+                generated_from_span,
+            },
+        }
+    }
+}
