# charon integration step 50 after 546078ea5d: commit c3b42d30b55077287274c1ffee41db558c0aa37a
# first parent 5d639e32bef8a61ea3dacd578be70df94269bb6c
# series charon: patch -p1 in charon/ of the upstream source
#
# charon: a loop inside another loop exits to the code after it in the outer loop
#
# compute_loop_exits takes the exit reached by the most exit paths. In a loop with several early
# returns (`?`), that is the cleanup they share, outside every loop, and the code that follows the
# loop, where it normally exits to, is copied into the loop. When the loop is inside another loop
# and inside an `if` (`if let Some(sites) = sites { for s in sites { g(*s)?; .. } }` in a loop
# body), that code is also the exit of the `if`, so it gets a copy after the `if` and one in the
# loop: the rest of the outer loop body is copied once more for every such loop.
#
# For a loop inside another loop, the exit is now first chosen among the exits inside the outer
# loop (same ranking), and kept if it is the only best one that does not only lead to errors and
# if it reaches a block of the outer loop that is not dominated by the loop header and is not an
# exit cleanup, i.e. the code after the loop is also reached around it. Otherwise all the exits are
# considered as before. The other exits leave the outer loop too: early returns and `break`s of an
# outer loop are translated in place, as before for every exit but the chosen one.
# CfgInfo::dominator_tree is now used.
#
# Test: control-flow/switch-exits-after-early-return guard_loop (one call of `tail`; before: 2, and 8
# before the previous commit).

diff --git a/src/transform/control_flow/ullbc_to_llbc.rs b/src/transform/control_flow/ullbc_to_llbc.rs
index 0f167ba..68c87d2 100644
--- a/src/transform/control_flow/ullbc_to_llbc.rs
+++ b/src/transform/control_flow/ullbc_to_llbc.rs
@@ -111,7 +111,6 @@ struct CfgInfo {
     /// The blocks whose terminators are a switch are stored here.
     pub switch_blocks: HashSet<src::BlockId>,
     /// Tree of which nodes dominates which other nodes.
-    #[expect(unused)]
     pub dominator_tree: Dominators<BlockId>,
     /// Computed data about each block.
     pub block_data: IndexVec<BlockId, Box<BlockData>>,
@@ -679,6 +678,44 @@ impl ExitInfo {
             // Compute the candidates.
             let loop_exits: SeqHashMap<BlockId, LoopExitRank> =
                 Self::compute_loop_exit_ranks(cfg, loop_id);
+            // For a loop inside another loop, the exits that leave the outer loop too (early
+            // returns, `break`s of an outer loop) may get the most occurrences: when the loop has
+            // several early returns (`?`), they share a cleanup. The code that follows the loop in
+            // the outer loop, where the loop normally exits to, is then copied into the loop. If
+            // that code is also reached around the loop (the loop is often in an `if`), it is
+            // where the `if` joins, and it gets a copy there too.
+            // In that case, i.e. if the best exit inside the outer loop reaches a block of the
+            // outer loop that is not dominated by the loop header and is not an exit cleanup, and
+            // if it is the only best one that does not only lead to errors, we use it. Otherwise
+            // we choose among all the exits as below.
+            let outer_loop = cfg.block_data[loop_id]
+                .within_loops
+                .iter()
+                .rev()
+                .nth(1)
+                .copied();
+            let exit_in_outer_loop = outer_loop.and_then(|outer_loop| {
+                loop_exits
+                    .iter()
+                    .filter(|&(&bid, _)| cfg.is_within_loop(outer_loop, bid))
+                    .max_set_by_key(|&(_, rank)| *rank)
+                    .into_iter()
+                    .map(|(&bid, _)| bid)
+                    .filter(|&bid| !cfg.block_data[bid].only_reach_error)
+                    .exactly_one()
+                    .ok()
+                    .filter(|&bid| {
+                        cfg.block_data[bid].reachable_including_self().any(|b| {
+                            cfg.is_within_loop(outer_loop, b)
+                                && cfg.block_data[b].exit_cleanup_size.is_none()
+                                && !cfg.dominator_tree.dominators(b).unwrap().contains(&loop_id)
+                        })
+                    })
+            });
+            if exit_in_outer_loop.is_some() {
+                cfg.block_data[loop_id].exit_info.loop_exit = exit_in_outer_loop;
+                continue;
+            }
             // We choose the exit with:
             // - the most occurrences
             // - the least total distance (if there are several possibilities)
