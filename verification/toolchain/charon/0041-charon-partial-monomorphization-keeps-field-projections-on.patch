+    /// Check that a field projection names the ADT of the place it projects out of.
+    fn check_field_projection(&self, place: &Place) {
+        if let PlaceKind::Projection(sub, ProjectionElem::Field(FieldProjKind::Adt(id, _), _)) =
+            &place.kind
+            && let TyKind::Adt(TypeDeclRef {
+                id: TypeId::Adt(sub_id),
+                ..
+            }) = sub.ty.kind()
+            && id != sub_id
+        {
+            let fmt = &self.val_fmt_ctx();
+            self.error(format!(
+                "Field projection out of \"{}\" names another type: {}",
+                sub.ty.with_ctx(fmt),
+                id.with_ctx(fmt)
+            ));
+        }
+    }
+
     /// For pretty error printing. This can print values that we encounter because we track binders
     /// properly. This doesn't have the right binders to print values we get from somewhere else
     /// (namely the `GenericParam`s we get from elsewhere in the crate).
@@ -474,6 +493,9 @@ impl VisitAstMut for TypeCheckVisitor<'_> {
             TypeId::Builtin(_) => {}
         }
     }
+    fn enter_place(&mut self, x: &mut Place) {
+        self.check_field_projection(x);
+    }
     fn enter_fun_decl_ref(&mut self, x: &mut FunDeclRef) {
         self.assert_matches_item(x.id, &mut x.generics);
     }
@@ -491,6 +513,8 @@ impl VisitAstMut for TypeCheckVisitor<'_> {
         if let Rvalue::UnaryOp(UnOp::Cast(CastKind::Concretize(src, tar)), _) = x {
             self.check_concretization_ty_match(src, tar);
         }
+        // The rest of an rvalue is not visited, but the places it reads are checked.
+        x.dyn_visit(|place: &Place| self.check_field_projection(place));
         Continue(())
     }
     fn visit_body(&mut self, body: &mut Body) -> ControlFlow<Self::Break> {
diff --git a/tests/ui/monomorphize-mut-closure-field-projection.rs b/tests/ui/monomorphize-mut-closure-field-projection.rs
new file mode 100644
index 0000000..205b6d3
--- /dev/null
+++ b/tests/ui/monomorphize-mut-closure-field-projection.rs
@@ -0,0 +1,26 @@
+//@ no-default-options
+//@ charon-args=--preset=aeneas --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=*
+//@ no-check-output
+
+// A closure keeps the trait clauses of its generic parent, so an instance of the parent
+// specializes the closure type too. The instance of the closure's body reads its capture out of
+// that specialized type: the field projection must name it, not the generic closure type
+// (checked after the transformations).
+pub fn apply<R>(x: &mut u32, f: impl FnOnce(&mut u32) -> R) -> R {
+    f(x)
+}
+
+pub fn catching<R>(x: &mut u32, f: impl FnOnce(&mut u32) -> R) -> R {
+    apply(x, move |y| f(y))
+}
+
+pub fn with_state<S, R>(x: &mut u32, state: &mut S, f: impl FnOnce(&mut u32, &mut S) -> R) -> R {
+    catching(x, move |y| f(y, state))
+}
+
+pub fn caller(x: &mut u32, count: &mut u64) -> u32 {
+    with_state(x, count, |x, count| {
+        *count += 1;
+        *x
+    })
+}
