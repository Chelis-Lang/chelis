@@ -660,6 +660,20 @@ impl VisitAstMut for PartialMonomorphizer<'_> {
             *x = new_decl_ref.try_into().unwrap()
         }
     }
+    /// A field projection names the ADT it projects out of. When the type of the projected
+    /// place was just rewritten to a specialized ADT (e.g. the closure of a generic function
+    /// inside one of its instances), the projection must name that specialized ADT too.
+    fn exit_place(&mut self, place: &mut Place) {
+        if let PlaceKind::Projection(sub, ProjectionElem::Field(FieldProjKind::Adt(id, _), _)) =
+            &mut place.kind
+            && let TyKind::Adt(TypeDeclRef {
+                id: TypeId::Adt(sub_id),
+                ..
+            }) = sub.ty.kind()
+        {
+            *id = *sub_id;
+        }
+    }
     fn exit_fn_ptr(&mut self, x: &mut FnPtr) {
         // TODO: methods. any `Trait::method<&mut A>` requires monomorphizing all the instances of
         // that method just in case :>>>
diff --git a/src/transform/typecheck_and_unify.rs b/src/transform/typecheck_and_unify.rs
index 2969fe5..0424fde 100644
--- a/src/transform/typecheck_and_unify.rs
