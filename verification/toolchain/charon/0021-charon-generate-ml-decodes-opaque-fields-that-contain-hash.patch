+//@ no-default-options
+//@ charon-args=--preset=aeneas --lift-associated-types=*
+//! The implied trait refs of generic associated types stay on the associated type (they cannot be
+//! lifted to the trait), in a field that charon-ml omits from its types. Hash-consed values that
+//! first occur there are referred to by key afterwards, so charon-ml must still decode that field;
+//! the charon-ml deserialization test loads this file's llbc, which (unlike with the tests preset)
+//! is deduplicated.
+
+/// `impl Pattern for &str` has `type Searcher<'a> = StrSearcher<'a, 'b>`, whose implied
+/// `Searcher<'a>` bound is a trait ref also used by later impls.
+pub fn is_gpu(device: &str) -> bool {
+    device.starts_with("gpu")
+}
+
+#[derive(Clone)]
+pub struct Item;
+
+pub trait Lend {
+    type Borrowed<'a>: Clone
+    where
+        Self: 'a;
+    fn lend(&self) -> Self::Borrowed<'_>;
+}
+
+/// The implied `Item: Clone` ref of `Borrowed` is the first occurrence of that trait ref.
+impl Lend for Item {
+    type Borrowed<'a> = Item;
+    fn lend(&self) -> Item {
+        Item
+    }
+}
+
+pub trait Dup: Clone {}
+
+/// The parent clause `Item: Clone` refers to the trait ref above by its hash-consing key.
+impl Dup for Item {}
