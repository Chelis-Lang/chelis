+    /// Whether values of this type may contain hash-consed values (`Ty`, `TraitRef`). The Rust
+    /// serializer deduplicates those across the whole file: the first occurrence carries the value
+    /// and its key, later occurrences only the key. The decoder must therefore visit every such
+    /// value in serialization order, including values of fields that OCaml does not keep.
+    fn may_contain_hash_consed(&self, ty: &Ty) -> bool {
+        let hash_consed = self.name_to_type["HashConsed"].def_id;
+        let mut stack = vec![];
+        ty.dyn_visit(|id: &TypeDeclId| stack.push(*id));
+        let mut seen = HashSet::new();
+        while let Some(id) = stack.pop() {
+            if id == hash_consed {
+                return true;
+            }
+            if seen.insert(id)
+                && let Some(contained) = self.type_tree.get(&id)
+            {
+                stack.extend(contained.iter().copied());
+            }
+        }
+        false
+    }
+
+    /// Opaque fields are absent from the OCaml types. Their JSON is still decoded (and the result
+    /// discarded) when it may register hash-consing keys that later parts of the file refer to;
+    /// only the other opaque fields are skipped without decoding.
+    fn skip_field(&self, f: &Field) -> bool {
+        f.is_opaque() && !self.may_contain_hash_consed(&f.ty)
+    }
