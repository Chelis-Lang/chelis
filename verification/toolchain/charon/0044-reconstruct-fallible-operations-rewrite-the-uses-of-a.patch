+/// Occurrences of a local in the places of a whole body: as a place node (the local itself,
+/// including as the base of a projection or as an assigned place), and as the base of the
+/// tuple fields `r.0` (the integer result of a checked operation) and `r.1` (its overflow flag).
+#[derive(Default, Clone, Copy)]
+struct TupleUses {
+    whole: usize,
+    integer: usize,
+    overflow: usize,
+}
+
+/// The [TupleUses] of every local of a body, over all its blocks (statements and terminators).
+/// A checked operation's result tuple can be used after a call terminator, e.g. in
+/// `v[i] = a + b`, whose place `*IndexMut::index_mut(&mut v, i)` is computed after the sum.
+fn compute_tuple_uses(body: &ExprBody) -> HashMap<LocalId, TupleUses> {
+    let mut uses: HashMap<LocalId, TupleUses> = HashMap::new();
+    body.body.dyn_visit_in_body(|p: &Place| {
+        if let Some(local) = p.as_local() {
+            uses.entry(local).or_default().whole += 1;
+        }
+        if let Some((sub, ProjectionElem::Field(FieldProjKind::Tuple(..), fid))) = p.as_projection()
+            && let Some(local) = sub.as_local()
+        {
+            let entry = uses.entry(local).or_default();
+            match fid.index() {
+                0 => entry.integer += 1,
+                1 => entry.overflow += 1,
+                _ => (),
+            }
+        }
+    });
+    uses
+}
