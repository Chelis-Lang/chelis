+//@ no-default-options
+//@ charon-args=--preset=aeneas
+//! The result of a checked operation used in a later block. An assignment evaluates its value
+//! before its place, so in `*slot(v, i) = a + b` and `c[i] = a + b` (an overloaded `IndexMut`)
+//! the sum `r := a checked.+ b; assert(!r.1)` is computed before the call that computes the
+//! place, and its use `r.0` lives in the block after that call. Rewriting the sum into
+//! `r := a panic.+ b` changes the type of `r` to `u32`, so that use must become `r` too.
+use std::ops::{Index, IndexMut};
+
+fn slot(v: &mut [u32; 4], i: usize) -> &mut u32 {
+    &mut v[i]
+}
+
+pub fn write_sum(v: &mut [u32; 4], i: usize, a: u32, b: u32) {
+    *slot(v, i) = a + b;
+}
+
+pub struct Cells([u32; 4]);
+
+impl Index<usize> for Cells {
+    type Output = u32;
+    fn index(&self, i: usize) -> &u32 {
+        &self.0[i]
+    }
+}
+
+impl IndexMut<usize> for Cells {
+    fn index_mut(&mut self, i: usize) -> &mut u32 {
+        &mut self.0[i]
+    }
+}
+
+pub fn add_into(c: &mut Cells, i: usize, a: u32, b: u32) {
+    c[i] = a * b + a;
+}
+
+/// The same block: `r.0` is used right after the assert.
+pub fn same_block(a: u32, b: u32) -> u32 {
+    let s = a - b;
+    s
+}
