+/// Options that read name patterns from files. They are handled by this binary, which appends the
+/// patterns to `--start-from`/`--opaque`, so that they don't change the serialized options.
+#[derive(clap::Args, Debug)]
+pub struct PatternFiles {
+    /// Same as `--start-from` for each line of the file (one pattern per line; blank lines and
+    /// lines starting with `#` are ignored). Every pattern must select an item, e.g. the
+    /// `pattern`s of a `CHARON_CALLGRAPH` dump.
+    #[clap(long, value_name("FILE"))]
+    pub start_from_file: Vec<PathBuf>,
+    /// Same as `--opaque` for each line of the file (one pattern per line; blank lines and lines
+    /// starting with `#` are ignored).
+    #[clap(long, value_name("FILE"))]
+    pub opaque_file: Vec<PathBuf>,
+}
+
+impl PatternFiles {
+    /// Append the patterns of the files to `options`.
+    pub fn apply(&self, options: &mut CliOpts) -> anyhow::Result<()> {
+        use anyhow::Context;
+        let read = |path: &PathBuf, dest: &mut Vec<String>| -> anyhow::Result<()> {
+            let text = std::fs::read_to_string(path)
+                .with_context(|| format!("cannot read pattern file {}", path.display()))?;
+            dest.extend(
+                text.lines()
+                    .map(str::trim)
+                    .filter(|line| !line.is_empty() && !line.starts_with('#'))
+                    .map(str::to_owned),
+            );
+            Ok(())
+        };
+        for path in &self.start_from_file {
+            read(path, &mut options.start_from)?;
+        }
+        for path in &self.opaque_file {
+            read(path, &mut options.opaque)?;
+        }
+        Ok(())
+    }
+}
