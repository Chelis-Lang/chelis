diff --git a/src/bin/charon-driver/translate/resolve_exact.rs b/src/bin/charon-driver/translate/resolve_exact.rs
new file mode 100644
index 0000000..ddc5b14
--- /dev/null
+++ b/src/bin/charon-driver/translate/resolve_exact.rs
@@ -0,0 +1,510 @@
+//! Resolve a name pattern to the items whose Charon name it spells out, e.g. the canonical
+//! patterns of `CHARON_CALLGRAPH`. This complements `resolve_path`, which follows rustc paths
+//! (including re-exports) but cannot express impl blocks inside a path, closures, disambiguators
+//! or the items Charon derives from a definition (closure impls and methods, defaulted methods).
+//!
+//! Charon names follow the definition paths of rustc (see `path_elem_for_def`), so we index the
+//! definitions of a crate by their parent and walk the pattern down that tree. Impl blocks are
+//! compared with the pattern using the rustc types of their self type and implemented trait. No
+//! item is registered while resolving.
+use std::collections::HashMap;
+use std::rc::Rc;
+
+use anyhow::{Result, bail};
+use charon_lib::ast::ClosureKind;
+use charon_lib::ast::RefKind;
+use charon_lib::name_matcher::{NamePattern, PatElem, PatTy};
+use rustc_hir::def::DefKind;
+use rustc_hir::def_id::{CrateNum, DefId, LOCAL_CRATE};
+use rustc_hir::definitions::DefPathData;
+use rustc_middle::ty::{self, GenericArgKind, Ty, TyCtxt};
+
+/// What a pattern resolved to: a rustc definition, or an item Charon derives from one.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
+pub enum Resolved {
+    Def(DefId),
+    /// The `Fn*` impl of a closure.
+    ClosureImpl(DefId, ClosureKind),
+    /// The `call*` method of the `Fn*` impl of a closure.
+    ClosureMethod(DefId, ClosureKind),
+    /// The cast of a state-less closure to a function pointer.
+    ClosureAsFn(DefId),
+    /// A method a trait impl takes from the trait's default.
+    DefaultedMethod(DefId, rustc_span::Symbol),
+    /// The vtable struct of a trait.
+    VTable(DefId),
+    /// The vtable of a trait impl, or of the `Fn*` impl of a closure.
+    VTableInstance(DefId, Option<ClosureKind>),
+    /// The `n`th promoted constant of a body.
+    Promoted(DefId, u32),
+    /// The `Destruct` impl Charon generates for an ADT or closure (drop glue).
+    ImplicitDestruct(DefId),
+    /// The `drop_in_place` method of that impl.
+    DropInPlace(DefId),
+}
+
+/// How a definition shows up in a Charon name (mirrors `path_elem_for_def`).
+enum Elem {
+    Ident(String, u32),
+    Impl,
+    /// Not part of the name: the children appear under the parent.
+    Skipped,
+    /// Never part of an item name.
+    None,
+}
+
+fn elem_of(tcx: TyCtxt<'_>, def_id: DefId) -> Elem {
+    let key = tcx.def_key(def_id);
+    let d = key.disambiguated_data.disambiguator;
+    match key.disambiguated_data.data {
+        DefPathData::TypeNs(s) | DefPathData::ValueNs(s) | DefPathData::MacroNs(s) => {
+            Elem::Ident(s.to_string(), d)
+        }
+        DefPathData::Closure => Elem::Ident("closure".to_owned(), d),
+        DefPathData::Use => Elem::Ident("{use}".to_owned(), d),
+        DefPathData::AnonConst => Elem::Ident("{const}".to_owned(), d),
+        DefPathData::Impl => Elem::Impl,
+        DefPathData::ForeignMod | DefPathData::Ctor | DefPathData::OpaqueTy => Elem::Skipped,
+        _ => Elem::None,
+    }
+}
+
+#[derive(Default)]
+struct Children {
+    idents: HashMap<String, Vec<(u32, DefId)>>,
+    impls: Vec<DefId>,
+}
+
+/// The definitions of a crate, by the parent under which they appear in Charon names.
+#[derive(Default)]
+struct CrateIndex {
+    children: HashMap<DefId, Children>,
+}
+
+pub struct ExactResolver<'tcx> {
+    tcx: TyCtxt<'tcx>,
+    crates: HashMap<CrateNum, CrateIndex>,
+    /// The definitions each type or trait path (a pattern without generics) resolves to.
+    paths: HashMap<String, Rc<Vec<DefId>>>,
+}
+
+impl<'tcx> ExactResolver<'tcx> {
+    pub fn new(tcx: TyCtxt<'tcx>) -> Self {
+        Self {
+            tcx,
+            crates: HashMap::new(),
+            paths: HashMap::new(),
+        }
+    }
+
+    fn index(&mut self, krate: CrateNum) -> &CrateIndex {
+        let tcx = self.tcx;
+        self.crates.entry(krate).or_insert_with(|| {
+            let defs: Vec<DefId> = if krate == LOCAL_CRATE {
+                // Not `iter_local_def_id`: it freezes the definitions table, which later
+                // translation still extends. `definitions` lacks closures, which own bodies.
+                let defs: std::collections::HashSet<DefId> = tcx
+                    .hir_crate_items(())
+                    .definitions()
+                    .chain(tcx.hir_body_owners())
+                    .map(|id| id.to_def_id())
+                    .collect();
+                defs.into_iter().collect()
+            } else {
+                (0..tcx.num_extern_def_ids(krate))
+                    .map(|index| DefId {
+                        krate,
+                        index: rustc_hir::def_id::DefIndex::from_usize(index),
+                    })
+                    .collect()
+            };
+            let mut index = CrateIndex::default();
+            for def_id in defs {
+                if def_id.is_crate_root() {
+                    continue;
+                }
+                let elem = elem_of(tcx, def_id);
+                if matches!(elem, Elem::Skipped | Elem::None) {
+                    continue;
+                }
+                // The parent under which this definition is named.
+                let Some(mut parent) = tcx.opt_parent(def_id) else {
+                    continue;
+                };
+                while !parent.is_crate_root() && matches!(elem_of(tcx, parent), Elem::Skipped) {
+                    parent = tcx.parent(parent);
+                }
+                let children = index.children.entry(parent).or_default();
+                match elem {
+                    Elem::Ident(name, d) => children.idents.entry(name).or_default().push((d, def_id)),
+                    Elem::Impl => children.impls.push(def_id),
+                    Elem::Skipped | Elem::None => unreachable!(),
+                }
+            }
+            index
+        })
+    }
+
+    fn children(&mut self, parent: DefId) -> Option<&Children> {
+        self.index(parent.krate).children.get(&parent)
+    }
+
+    /// The items whose Charon name the pattern spells out exactly (the pattern is not a prefix).
+    /// Generic arguments of the path elements are ignored, except in impl blocks. Errors if the
+    /// pattern uses syntax the resolver does not support (globs in the path).
+    pub fn resolve(&mut self, pat: &NamePattern) -> Result<Vec<Resolved>> {
+        let tcx = self.tcx;
+        let [first, rest @ ..] = pat.elems.as_slice() else {
+            bail!("empty pattern")
+        };
+        let PatElem::Ident {
+            name,
+            disambiguator,
+            ..
+        } = first
+        else {
+            bail!("the pattern must start with a crate name")
+        };
+        if disambiguator.is_some_and(|d| d.index() != 0) {
+            return Ok(Vec::new());
+        }
+        let mut cursors: Vec<Resolved> = tcx
+            .crates(())
+            .iter()
+            .copied()
+            .chain([LOCAL_CRATE])
+            .filter(|&krate| {
+                tcx.crate_name(krate).as_str() == name || (krate == LOCAL_CRATE && name == "crate")
+            })
+            .map(|krate| Resolved::Def(krate.as_def_id()))
+            .collect();
+        for elem in rest {
+            let mut next = Vec::new();
+            for cursor in cursors {
+                self.step(cursor, elem, &mut next)?;
+            }
+            let mut seen = std::collections::HashSet::new();
+            next.retain(|r| seen.insert(*r));
+            cursors = next;
+            if cursors.is_empty() {
+                break;
+            }
+        }
+        Ok(cursors)
+    }
+
+    fn step(&mut self, cursor: Resolved, elem: &PatElem, next: &mut Vec<Resolved>) -> Result<()> {
+        let tcx = self.tcx;
+        match (cursor, elem) {
+            (
+                Resolved::Def(parent),
+                PatElem::Ident {
+                    name,
+                    disambiguator,
+                    ..
+                },
+            ) => {
+                let matching = self
+                    .children(parent)
+                    .and_then(|children| children.idents.get(name))
+                    .map(|defs| {
+                        defs.iter()
+                            .filter(|(d, _)| disambiguator.is_none_or(|p| p.index() == *d as usize))
+                            .map(|(_, def_id)| *def_id)
+                            .collect::<Vec<_>>()
+                    })
+                    .unwrap_or_default();
+                let found = !matching.is_empty();
+                next.extend(
+                    matching
+                        .into_iter()
+                        .map(|def_id| Resolved::Def(def_id)),
+                );
+                let kind = tcx.def_kind(parent);
+                if found || (disambiguator.is_some_and(|d| d.index() != 0) && name != "{promoted_const}") {
+                    return Ok(());
+                }
+                match kind {
+                    _ if name == "{promoted_const}" => {
+                        if let Some(d) = disambiguator {
+                            next.push(Resolved::Promoted(parent, d.index() as u32))
+                        }
+                    }
+                    DefKind::Closure if name == "as_fn" => {
+                        next.push(Resolved::ClosureAsFn(parent))
+                    }
+                    DefKind::Trait if name == "{vtable}" => {
+                        next.push(Resolved::VTable(parent))
+                    }
+                    DefKind::Impl { of_trait: true } if name == "{vtable}" => {
+                        next.push(Resolved::VTableInstance(parent, None))
+                    }
+                    // A method the impl does not define: the trait's default.
+                    DefKind::Impl { of_trait: true } => {
+                        let trait_id = tcx.impl_trait_id(parent);
+                        let provided = tcx.associated_items(trait_id).in_definition_order().any(
+                            |assoc| {
+                                matches!(assoc.kind, ty::AssocKind::Fn { .. })
+                                    && assoc.name().as_str() == name
+                                    && assoc.defaultness(tcx).has_value()
+                            },
+                        );
+                        if provided {
+                            next.push(Resolved::DefaultedMethod(
+                                parent,
+                                rustc_span::Symbol::intern(name),
+                            ));
+                        }
+                    }
+                    _ => {}
+                }
+            }
+            (Resolved::ClosureImpl(closure, kind), PatElem::Ident { name, .. })
+                if name == kind.method_name() =>
+            {
+                next.push(Resolved::ClosureMethod(closure, kind))
+            }
+            (Resolved::ClosureImpl(closure, kind), PatElem::Ident { name, .. })
+                if name == "{vtable}" =>
+            {
+                next.push(Resolved::VTableInstance(closure, Some(kind)))
+            }
+            (Resolved::ImplicitDestruct(def_id), PatElem::Ident { name, .. })
+                if name == "drop_in_place" =>
+            {
+                next.push(Resolved::DropInPlace(def_id))
+            }
+            (Resolved::Def(parent), PatElem::Impl(impl_pat)) => {
+                let (impls, closures) = match self.children(parent) {
+                    Some(children) => (
+                        children.impls.clone(),
+                        children.idents.get("closure").cloned().unwrap_or_default(),
+                    ),
+                    None => (Vec::new(), Vec::new()),
+                };
+                for impl_id in impls {
+                    if self.impl_matches(impl_pat, impl_id)? {
+                        next.push(Resolved::Def(impl_id));
+                    }
+                }
+                for (_, closure) in closures {
+                    if let Some(kind) = self.closure_impl_matches(impl_pat, closure)? {
+                        next.push(Resolved::ClosureImpl(closure, kind));
+                    }
+                }
+                if matches!(
+                    tcx.def_kind(parent),
+                    DefKind::Struct | DefKind::Enum | DefKind::Union | DefKind::Closure
+                ) && self.implicit_destruct_matches(impl_pat, parent)?
+                {
+                    next.push(Resolved::ImplicitDestruct(parent));
+                }
+            }
+            (_, PatElem::Glob) => bail!("globs are not supported in exact patterns"),
+            _ => {}
+        }
+        Ok(())
+    }
+
+    /// The definitions a path pattern (e.g. the trait or type of an impl block) designates.
+    fn path_defs(&mut self, pat: &NamePattern) -> Result<Rc<Vec<DefId>>> {
+        let mut path = pat.clone();
+        if let Some(PatElem::Ident {
+            generics, is_trait, ..
+        }) = path.elems.last_mut()
+        {
+            generics.clear();
+            *is_trait = false;
+        }
+        let key = path.to_string();
+        if let Some(defs) = self.paths.get(&key) {
+            return Ok(defs.clone());
+        }
+        let defs: Vec<DefId> = self
+            .resolve(&path)?
+            .into_iter()
+            .filter_map(|r| match r {
+                Resolved::Def(def_id) => Some(def_id),
+                _ => None,
+            })
+            .collect();
+        let defs = Rc::new(defs);
+        self.paths.insert(key, defs.clone());
+        Ok(defs)
+    }
+
+    fn last_generics(pat: &NamePattern) -> &[PatTy] {
+        match pat.elems.last() {
+            Some(PatElem::Ident { generics, .. }) => generics,
+            _ => &[],
+        }
+    }
+
+    /// Whether a pattern `{P}` (as in `Pattern::matches`) designates this impl block: the self
+    /// type of an inherent impl, or the implemented trait (with its arguments, `Self` first) of a
+    /// trait impl.
+    fn impl_matches(&mut self, pat: &NamePattern, impl_id: DefId) -> Result<bool> {
+        let tcx = self.tcx;
+        match tcx.def_kind(impl_id) {
+            DefKind::Impl { of_trait: false } => {
+                let self_ty = tcx.type_of(impl_id).instantiate_identity();
+                self.pattern_matches_ty(pat, self_ty)
+            }
+            DefKind::Impl { of_trait: true } => {
+                let trait_ref = tcx.impl_trait_ref(impl_id).instantiate_identity();
+                self.path_with_args_matches(pat, trait_ref.def_id, trait_ref.args)
+            }
+            _ => Ok(false),
+        }
+    }
+
+    /// Whether `{impl Fn*<..> for path::to::closure#N}` designates an `Fn*` impl of this closure.
+    fn closure_impl_matches(
+        &mut self,
+        pat: &NamePattern,
+        closure: DefId,
+    ) -> Result<Option<ClosureKind>> {
+        let tcx = self.tcx;
+        let [PatTy::Pat(self_pat), ..] = Self::last_generics(pat) else {
+            return Ok(None);
+        };
+        if !self.path_defs(self_pat)?.contains(&closure) {
+            return Ok(None);
+        }
+        let traits = self.path_defs(pat)?;
+        let kind = traits
+            .iter()
+            .find_map(|&trait_id| tcx.fn_trait_kind_from_def_id(trait_id));
+        Ok(kind.map(|kind| match kind {
+            ty::ClosureKind::Fn => ClosureKind::Fn,
+            ty::ClosureKind::FnMut => ClosureKind::FnMut,
+            ty::ClosureKind::FnOnce => ClosureKind::FnOnce,
+        }))
+    }
+
+    /// Whether `{impl core::marker::Destruct for path::to::Type<..>}` designates the drop glue
+    /// impl Charon generates for this ADT or closure.
+    fn implicit_destruct_matches(&mut self, pat: &NamePattern, def_id: DefId) -> Result<bool> {
+        let tcx = self.tcx;
+        let [PatTy::Pat(self_pat), ..] = Self::last_generics(pat) else {
+            return Ok(false);
+        };
+        let Some(destruct) = tcx.lang_items().destruct_trait() else {
+            return Ok(false);
+        };
+        Ok(self.path_defs(pat)?.contains(&destruct) && self.path_defs(self_pat)?.contains(&def_id))
+    }
+
+    /// Whether `pat` designates the definition `def_id` (its path) applied to `args` (the
+    /// generics of its last element, if any, compared with the non-lifetime arguments).
+    fn path_with_args_matches(
+        &mut self,
+        pat: &NamePattern,
+        def_id: DefId,
+        args: ty::GenericArgsRef<'tcx>,
+    ) -> Result<bool> {
+        if !self.path_defs(pat)?.contains(&def_id) {
+            return Ok(false);
+        }
+        let pats = Self::last_generics(pat).to_vec();
+        self.generics_match(&pats, args)
+    }
+
+    fn generics_match(&mut self, pats: &[PatTy], args: ty::GenericArgsRef<'tcx>) -> Result<bool> {
+        if pats.is_empty() {
+            return Ok(true);
+        }
+        let args: Vec<_> = args
+            .iter()
+            .filter(|arg| !matches!(arg.kind(), GenericArgKind::Lifetime(_)))
+            .collect();
+        if args.len() != pats.len() {
+            return Ok(false);
+        }
+        for (pat, arg) in pats.iter().zip(args) {
+            let ok = match arg.kind() {
+                GenericArgKind::Type(ty) => self.pat_ty_matches(pat, ty)?,
+                GenericArgKind::Const(_) => is_glob_ty(pat),
+                GenericArgKind::Lifetime(_) => unreachable!(),
+            };
+            if !ok {
+                return Ok(false);
+            }
+        }
+        Ok(true)
+    }
+
+    fn pat_ty_matches(&mut self, pat: &PatTy, ty: Ty<'tcx>) -> Result<bool> {
+        match (pat, ty.kind()) {
+            (PatTy::Pat(p), _) => self.pattern_matches_ty(p, ty),
+            (PatTy::Var, ty::Param(_)) => Ok(true),
+            (PatTy::Ref(kind, inner), ty::Ref(_, ty, mutbl)) => {
+                if matches!(kind, RefKind::Mut) != mutbl.is_mut() {
+                    return Ok(false);
+                }
+                self.pat_ty_matches(inner, *ty)
+            }
+            _ => Ok(false),
+        }
+    }
+
+    /// Mirrors `Pattern::matches_ty`: builtin types are spelled `u8`, `Str`, `Slice<T>`,
+    /// `Array<T, N>` and `Tuple<..>`; ADTs, closures and foreign types by their path.
+    fn pattern_matches_ty(&mut self, pat: &NamePattern, ty: Ty<'tcx>) -> Result<bool> {
+        if let [PatElem::Glob] = pat.elems.as_slice() {
+            return Ok(true);
+        }
+        if let [
+            PatElem::Ident {
+                name,
+                generics,
+                disambiguator: None,
+                ..
+            },
+        ] = pat.elems.as_slice()
+        {
+            let primitive = match ty.kind() {
+                ty::Bool | ty::Char | ty::Int(_) | ty::Uint(_) | ty::Float(_) => {
+                    Some(generics.is_empty() && ty.to_string() == *name)
+                }
+                ty::Str if name == "Str" => Some(generics.is_empty()),
+                ty::Slice(elem) if name == "Slice" => Some(match generics.as_slice() {
+                    [] => true,
+                    [g] => self.pat_ty_matches(g, *elem)?,
+                    _ => false,
+                }),
+                ty::Array(elem, _) if name == "Array" => Some(match generics.as_slice() {
+                    [] => true,
+                    [g, len] => self.pat_ty_matches(g, *elem)? && is_glob_ty(len),
+                    _ => false,
+                }),
+                // The arguments of a tuple are spelled out (`Tuple` is the unit type).
+                ty::Tuple(tys) if name == "Tuple" => Some(if generics.len() != tys.len() {
+                    false
+                } else {
+                    let mut ok = true;
+                    for (g, t) in generics.iter().zip(tys.iter()) {
+                        ok = ok && self.pat_ty_matches(g, t)?;
+                    }
+                    ok
+                }),
+                _ => None,
+            };
+            if let Some(result) = primitive {
+                return Ok(result);
+            }
+        }
+        match ty.kind() {
+            ty::Adt(adt, args) => self.path_with_args_matches(pat, adt.did(), args),
+            // Closure types are designated by their path alone (see `Pattern::canonical`).
+            ty::Closure(def_id, _) | ty::Foreign(def_id) => {
+                Ok(self.path_defs(pat)?.contains(def_id))
+            }
+            _ => Ok(false),
+        }
+    }
+}
+
+fn is_glob_ty(pat: &PatTy) -> bool {
+    matches!(pat, PatTy::Pat(p) if matches!(p.elems.as_slice(), [PatElem::Glob]))
+}
