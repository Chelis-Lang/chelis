new file mode 100644
index 0000000..f96d57b
--- /dev/null
+++ b/tests/callgraph.rs
@@ -0,0 +1,144 @@
+//! `CHARON_CALLGRAPH`: the canonical pattern of every dumped item selects exactly that item when
+//! fed back to `--start-from-file`.
+use anyhow::{Context, Result, ensure};
+use assert_cmd::prelude::{CommandCargoExt, OutputAssertExt};
+use serde_json::Value;
+use std::collections::HashMap;
+use std::path::Path;
+use std::process::Command;
+
+const CODE: &str = r#"
+pub trait Shape {
+    fn area(&self) -> u32;
+    fn double(&self) -> u32 { self.area() * 2 }
+}
+pub struct Sq(pub u32);
+pub struct Pair<T>(pub T, pub T);
+impl Shape for Sq { fn area(&self) -> u32 { self.0 * self.0 } }
+impl Shape for (u8, u16) { fn area(&self) -> u32 { self.0 as u32 + self.1 as u32 } }
+impl<T: Shape> Shape for Pair<T> { fn area(&self) -> u32 { self.0.area() + self.1.area() } }
+impl Shape for Pair<u8> { fn area(&self) -> u32 { 0 } }
+impl Sq { pub fn new(x: u32) -> Self { Sq(x) } }
+impl Sq { pub fn side(&self) -> u32 { self.0 } }
+impl<T> Pair<T> { pub fn first(&self) -> &T { &self.0 } }
+pub const LIMIT: u32 = 10;
+pub static COUNT: u32 = 3;
+const _: () = { impl Sq { pub fn hidden(&self) -> u32 { 1 } } };
+pub fn apply<F: Fn(u32) -> u32>(f: F, x: u32) -> u32 { f(x) }
+pub fn user(v: &[u32]) -> u32 {
+    fn helper(x: u32) -> u32 { x + LIMIT }
+    let a = apply(|x| x + 1, 2);
+    let k = 5;
+    let b = apply(move |x| x * k, 3);
+    let s = Sq::new(helper(a + b));
+    let p = Pair(Sq(1), Sq(2));
+    let t: (u8, u16) = (1, 2);
+    let mut m = 0;
+    let mut inc = |y: u32| m += y;
+    inc(1);
+    v.iter().map(|x| x + 1).sum::<u32>() + s.double() + s.side() + s.hidden() + p.double()
+        + p.first().area() + t.area() + COUNT + m + Pair(0u8, 1u8).area()
+}
+"#;
+
+fn charon(dir: &Path, envs: &[(&str, &Path)], extra: &[&str]) -> Result<()> {
+    Command::cargo_bin("charon")?
+        .envs(envs.iter().copied())
+        .args(["rustc", "--preset=aeneas", "--no-serialize"])
+        .args(extra)
+        .arg("--")
+        .arg(dir.join("test_crate.rs"))
+        .args(["--crate-type=rlib", "--edition=2021"])
+        .assert()
+        .try_success()?;
+    Ok(())
+}
+
+#[test]
+fn callgraph_patterns_round_trip() -> Result<()> {
+    let dir = tempfile::TempDir::new()?;
+    let dir = dir.path();
+    std::fs::write(dir.join("test_crate.rs"), CODE)?;
+
+    let graph_path = dir.join("graph.json");
+    charon(dir, &[("CHARON_CALLGRAPH", &graph_path)], &[])?;
+    let graph: Value = serde_json::from_str(&std::fs::read_to_string(&graph_path)?)?;
+    ensure!(graph["format"] == "charon-callgraph" && graph["version"] == 1);
+    let items = graph["items"].as_array().context("items")?;
+    let by_name: HashMap<&str, &Value> = items
+        .iter()
+        .map(|item| (item["name"].as_str().unwrap(), item))
+        .collect();
+    let index_of = |name: &str| by_name[name]["index"].as_u64().unwrap();
+    let contains = |item: &Value, field: &str, index: u64| {
+        item[field]
+            .as_array()
+            .unwrap()
+            .iter()
+            .any(|i| i.as_u64() == Some(index))
+    };
+
+    // Edges come from bodies and signatures; globals include their initializer.
+    let user = by_name["test_crate::user"];
+    ensure!(contains(user, "deps", index_of("test_crate::user::helper")));
+    ensure!(contains(user, "deps", index_of("test_crate::COUNT")));
+    ensure!(contains(
+        by_name["test_crate::user::helper"],
+        "deps",
+        index_of("test_crate::LIMIT")
+    ));
+    // Name patterns match prefixes: the pattern of `user` also matches its closures.
+    ensure!(contains(user, "pattern_also_matches", index_of("test_crate::user::closure")));
+    // `@` keeps the generic impl from matching the `Pair<u8>` one.
+    let generic_impl = by_name["test_crate::{impl test_crate::Shape for test_crate::Pair<T>}"];
+    ensure!(generic_impl["pattern"] == "test_crate::{impl test_crate::Shape for test_crate::Pair<@>}");
+    ensure!(!contains(
+        generic_impl,
+        "pattern_also_matches",
+        index_of("test_crate::{impl test_crate::Shape for test_crate::Pair<u8>}")
+    ));
+
+    // Feed every pattern back as a start-from selection.
+    let mut expected = Vec::new();
+    for item in items {
+        if item["source"] == "synthetic" || item["removed_by_passes"] == true {
+            continue;
+        }
+        let pattern = item["pattern"]
+            .as_str()
+            .with_context(|| format!("no pattern for {}: {}", item["name"], item["pattern_error"]))?;
+        expected.push(pattern.to_owned());
+    }
+    let patterns_path = dir.join("patterns.txt");
+    std::fs::write(&patterns_path, expected.join("\n"))?;
+    let coverage_path = dir.join("coverage.json");
+    charon(
+        dir,
+        &[("CHARON_COVERAGE_REPORT", &coverage_path)],
+        &["--start-from-file", patterns_path.to_str().unwrap()],
+    )?;
+    let coverage: Value = serde_json::from_str(&std::fs::read_to_string(&coverage_path)?)?;
+    let declared: HashMap<&str, bool> = coverage["start_from"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .flat_map(|sel| sel["items"].as_array().unwrap())
+        .map(|item| (item["id"].as_str().unwrap(), item["declared"] == true))
+        .collect();
+    let selected = coverage["start_from_selected"].as_array().unwrap();
+    ensure!(selected.len() == expected.len());
+    for (pattern, selection) in expected.iter().zip(selected) {
+        ensure!(selection["pattern"] == pattern.as_str());
+        let items = selection["items"].as_array().unwrap();
+        ensure!(
+            items.len() == 1 && items[0]["pattern_spells_name"] == true,
+            "`{pattern}` selected {items:?}"
+        );
+        ensure!(
+            declared[items[0]["id"].as_str().unwrap()],
+            "`{pattern}` selected an undeclared item"
+        );
+    }
+    ensure!(expected.len() > 60, "only {} patterns", expected.len());
+    Ok(())
+}
