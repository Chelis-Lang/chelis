@@ -0,0 +1,312 @@
+//! `CHARON_CALLGRAPH=<file>`: after translation, before the transformation passes, write the
+//! translated items with their canonical name patterns and their dependency edges as JSON, so
+//! that a crate can be split into chunks translated separately (`--start-from-file` for the items
+//! of a chunk, `--opaque-file` for the items of earlier chunks). With `CHARON_CALLGRAPH_ONLY=1`,
+//! charon stops there (no transformation passes, no output file).
+//!
+//! Format (`"format": "charon-callgraph", "version": 1`): `crate` is the crate being compiled and
+//! `items` lists the translated items. Items that are part of another item's body are folded into
+//! it: global initializers into their global, promoted constants into the body they come from.
+//! Their bodies count as the owner's and their dependencies as the owner's. Each item has:
+//! - `index`: its position in `items`; edges refer to items by index;
+//! - `id`: the Charon id (`@Fun3`, ...), `kind` (`type`, `fun`, `global`, `trait_decl`,
+//!   `trait_impl`) and `source` (what it was translated from: `item`, `closure_impl(FnMut)`,
+//!   `closure_method(FnMut)`, `closure_as_fn`, `defaulted_method(name)`, `implicit_destruct_impl`,
+//!   `drop_in_place`, `synthetic` for items with no definition such as `UNIT_METADATA`, ...);
+//! - `name`: the pretty-printed Charon name;
+//! - `pattern`: the canonical name pattern (`Pattern::canonical`), accepted by `--start-from`,
+//!   `--start-from-file`, `--opaque` and `--opaque-file`; `null` with a `pattern_error` if the
+//!   name has none, or if the pattern does not parse back to itself or does not match the name;
+//! - `pattern_also_matches`: the other items whose names the pattern matches. Name patterns match
+//!   prefixes, so this lists the items nested in this one (closures and nested items of a
+//!   function, provided methods of a trait, drop glue of a type); where such a pattern should not
+//!   apply to a nested item, give the nested item its own pattern (the longer pattern is more
+//!   precise and wins). As a start-from selection, the pattern selects exactly its item;
+//! - `crate`, `module` (the enclosing rustc module, `crate::path`; `null` for items without a
+//!   rustc definition);
+//! - `generic` (has type parameters), `type_params`, `const_params`;
+//! - `opacity`, `has_body`, `statements` (statements and terminators) and `blocks` of the
+//!   unstructured body;
+//! - `deps`: the items the declaration refers to in its signature and body (the edges of the
+//!   declaration graph Charon orders declarations with), `reaches`: the items it additionally
+//!   makes reachable without depending on them (provided methods and default constants of a
+//!   trait declaration);
+//! - `initializer` (globals), `folded` (the ids folded into this item), and
+//!   `removed_by_passes: true` for the impls of hidden marker traits, which the transformation
+//!   passes remove.
+use std::collections::HashMap;
+
+use super::translate_crate::{TraitImplSource, TransItemSource, TransItemSourceKind};
+use super::translate_ctx::TranslateCtx;
+use crate::hax;
+use crate::hax::SInto;
+use charon_lib::ast::*;
+use charon_lib::formatter::IntoFormatter;
+use charon_lib::name_matcher::{Disambiguation, NamePattern, PatternIndex};
+use charon_lib::pretty::FmtWithCtx;
+use charon_lib::transform::add_missing_info::reorder_decls::item_dependencies;
+use itertools::Itertools;
+use serde_json::json;
+
+fn source_kind(src: Option<&TransItemSource>) -> String {
+    use TransItemSourceKind::*;
+    let Some(src) = src else {
+        return "synthetic".to_owned();
+    };
+    match &src.kind {
+        Global | TraitDecl | Fun | Type | TraitImpl(TraitImplSource::Normal) => "item".to_owned(),
+        TraitImpl(TraitImplSource::Closure(kind)) => format!("closure_impl({kind:?})"),
+        TraitImpl(TraitImplSource::TraitAlias) => "trait_alias_impl".to_owned(),
+        TraitImpl(TraitImplSource::ImplicitDestruct) => "implicit_destruct_impl".to_owned(),
+        DefaultedMethod(_, name) => format!("defaulted_method({name})"),
+        ClosureMethod(kind) => format!("closure_method({kind:?})"),
+        ClosureAsFnCast => "closure_as_fn".to_owned(),
+        DropInPlaceMethod(_) => "drop_in_place".to_owned(),
+        kind => format!("{kind:?}"),
+    }
+}
+
+impl TranslateCtx<'_> {
+    /// The enclosing module of a definition, as `crate::module::path`.
+    fn module_path(&self, src: Option<&TransItemSource>) -> Option<String> {
+        use rustc_hir::def::DefKind;
+        let tcx = self.tcx;
+        let mut def_id = src?.def_id().as_rust_def_id()?;
+        while !matches!(tcx.def_kind(def_id), DefKind::Mod) {
+            def_id = tcx.opt_parent(def_id)?;
+        }
+        let mut path = vec![tcx.crate_name(def_id.krate).to_string()];
+        path.extend(
+            tcx.def_path(def_id)
+                .data
+                .iter()
+                .map(|elem| elem.data.get_opt_name().map_or_else(|| "_".to_owned(), |s| s.to_string())),
+        );
+        Some(path.join("::"))
+    }
+
+    pub fn write_callgraph(&self) {
+        let Some(path) = std::env::var_os("CHARON_CALLGRAPH").filter(|path| !path.is_empty())
+        else {
+            return;
+        };
+        let krate = &self.translated;
+        let fmt = krate.into_fmt();
+
+        // Items that are part of another item are folded into it: global initializers into their
+        // global, promoted constants into the body they were promoted from, and constructors
+        // (which have the name of their type) into their type.
+        let mut folded_into: HashMap<ItemId, ItemId> = krate
+            .global_decls
+            .iter()
+            .map(|global| (ItemId::Fun(global.init), ItemId::Global(global.def_id)))
+            .collect();
+        for (id, src) in &self.reverse_id_map {
+            if krate.get_item(*id).is_none() {
+                continue;
+            }
+            let owner = match src.def_id().base {
+                hax::DefIdBase::Promoted(owner, _) => Some((owner, TransItemSourceKind::Fun)),
+                hax::DefIdBase::Real(def_id)
+                    if matches!(src.kind, TransItemSourceKind::Fun)
+                        && let rustc_hir::def::DefKind::Ctor(of, _) = self.tcx.def_kind(def_id) =>
+                {
+                    let parent = self.tcx.parent(def_id);
+                    let adt = match of {
+                        rustc_hir::def::CtorOf::Struct => parent,
+                        rustc_hir::def::CtorOf::Variant => self.tcx.parent(parent),
+                    };
+                    Some((adt, TransItemSourceKind::Type))
+                }
+                _ => None,
+            };
+            if let Some((owner, kind)) = owner {
+                let owner: hax::DefId = owner.sinto(&self.hax_state);
+                // The body of a closure is that of its `call*` methods.
+                let owner_id = [
+                    kind,
+                    TransItemSourceKind::ClosureMethod(ClosureKind::FnOnce),
+                    TransItemSourceKind::ClosureMethod(ClosureKind::FnMut),
+                    TransItemSourceKind::ClosureMethod(ClosureKind::Fn),
+                ]
+                .into_iter()
+                .find_map(|kind| {
+                    self.id_map
+                        .get(&TransItemSource::polymorphic(&owner, kind))
+                        .filter(|id| krate.get_item(**id).is_some())
+                });
+                if let Some(owner_id) = owner_id {
+                    folded_into.insert(*id, *owner_id);
+                }
+            }
+        }
+        let root_of = |mut id: ItemId| {
+            while let Some(owner) = folded_into.get(&id) {
+                id = *owner;
+            }
+            id
+        };
+        let items = krate
+            .all_items()
+            .filter(|item| !folded_into.contains_key(&item.id()))
+            .collect_vec();
+        let mut index_of: HashMap<ItemId, usize> = items
+            .iter()
+            .enumerate()
+            .map(|(i, item)| (item.id(), i))
+            .collect();
+        let mut folded: Vec<Vec<ItemId>> = vec![Vec::new(); items.len()];
+        for id in folded_into.keys().copied().sorted() {
+            if let Some(&i) = index_of.get(&root_of(id)) {
+                index_of.insert(id, i);
+                folded[i].push(id);
+            }
+        }
+
+        // Canonical patterns, checked to parse back to themselves and to match their item.
+        let disambiguation =
+            Disambiguation::new(krate.all_items().map(|item| &item.item_meta().name));
+        let patterns: Vec<Result<NamePattern, String>> = items
+            .iter()
+            .map(|item| {
+                let name = &item.item_meta().name;
+                let pat = NamePattern::canonical_with(krate, &disambiguation, name)
+                    .ok_or_else(|| "the name cannot be expressed as a pattern".to_owned())?;
+                let text = pat.to_string();
+                match NamePattern::parse(&text) {
+                    Ok(parsed) if parsed == pat => {}
+                    _ => return Err(format!("`{text}` does not parse back to itself")),
+                }
+                if !pat.matches(krate, name) {
+                    return Err(format!("`{text}` does not match the name"));
+                }
+                Ok(pat)
+            })
+            .collect();
+        let index: PatternIndex<usize> = patterns
+            .iter()
+            .enumerate()
+            .filter_map(|(i, pat)| Some((pat.as_ref().ok()?.clone(), i)))
+            .collect();
+        let mut also_matches: Vec<Vec<usize>> = vec![Vec::new(); items.len()];
+        for (j, item) in items.iter().enumerate() {
+            for (_, i) in index.matches(krate, &item.item_meta().name) {
+                if *i != j {
+                    also_matches[*i].push(j);
+                }
+            }
+        }
+
+        let body_size = |id: FunDeclId| match krate.fun_decls.get(id).map(|f| &f.body) {
+            Some(Body::Unstructured(body)) => (
+                body.body
+                    .iter()
+                    .map(|block| block.statements.len() + 1)
+                    .sum::<usize>(),
+                body.body.len(),
+                true,
+            ),
+            Some(Body::Structured(_)) => (0, 0, true),
+            _ => (0, 0, false),
+        };
+
+        let entries = items
+            .iter()
+            .enumerate()
+            .map(|(i, item)| {
+                let id = item.id();
+                let src = self.reverse_id_map.get(&id);
+                let item_meta = item.item_meta();
+                let generics = item.generic_params();
+                let (mut edges, mut reachable) = item_dependencies(krate, *item);
+                for folded_id in &folded[i] {
+                    if let Some(folded_item) = krate.get_item(*folded_id) {
+                        let (e, r) = item_dependencies(krate, folded_item);
+                        edges.extend(e);
+                        reachable.extend(r);
+                    }
+                }
+                let (kind, initializer, (statements, blocks, has_body)) = match item {
+                    ItemRef::Type(_) => ("type", None, (0, 0, false)),
+                    ItemRef::Fun(f) => ("fun", None, body_size(f.def_id)),
+                    ItemRef::Global(g) => ("global", Some(g.init), body_size(g.init)),
+                    ItemRef::TraitDecl(_) => ("trait_decl", None, (0, 0, false)),
+                    ItemRef::TraitImpl(_) => ("trait_impl", None, (0, 0, false)),
+                };
+                // Edges between an item and the items folded into it are not self-dependencies.
+                let self_ids: Vec<ItemId> = std::iter::once(id).chain(folded[i].iter().copied()).collect();
+                let to_indices = |ids: Vec<ItemId>| {
+                    ids.into_iter()
+                        .filter(|id| folded[i].is_empty() || !self_ids.contains(id))
+                        .filter_map(|id| index_of.get(&id).copied())
+                        .sorted()
+                        .dedup()
+                        .collect_vec()
+                };
+                let deps = to_indices(edges);
+                let reaches = to_indices(reachable)
+                    .into_iter()
+                    .filter(|j| deps.binary_search(j).is_err() && *j != i)
+                    .collect_vec();
+                let (pattern, pattern_error) = match &patterns[i] {
+                    Ok(pat) => (Some(pat.to_string()), None),
+                    Err(err) => (None, Some(err.clone())),
+                };
+                let crate_name = src.map(|src| src.def_id().crate_name(&self.hax_state).to_string());
+                let mut entry = json!({
+                    "index": i,
+                    "id": id.to_string(),
+                    "kind": kind,
+                    "source": source_kind(src),
+                    "name": item_meta.name.with_ctx(&fmt).to_string(),
+                    "pattern": pattern,
+                    "pattern_also_matches": also_matches[i],
+                    "crate": crate_name,
+                    "module": self.module_path(src),
+                    "generic": !generics.types.is_empty(),
+                    "type_params": generics.types.len(),
+                    "const_params": generics.const_generics.len(),
+                    "opacity": format!("{:?}", item_meta.opacity),
+                    "has_body": has_body,
+                    "statements": statements,
+                    "blocks": blocks,
+                    "deps": deps,
+                    "reaches": reaches,
+                });
+                if let Some(err) = pattern_error {
+                    entry["pattern_error"] = err.into();
+                }
+                if let Some(init) = initializer {
+                    entry["initializer"] = ItemId::Fun(init).to_string().into();
+                }
+                if !folded[i].is_empty() {
+                    entry["folded"] = folded[i].iter().map(|id| id.to_string()).collect_vec().into();
+                }
+                // Hidden traits (`--hide-marker-traits`) make these impls invisible once their
+                // implemented trait is known; the transformation passes remove them.
+                if self.options.opacity_for_name(krate, &item_meta.name).is_invisible() {
+                    entry["removed_by_passes"] = true.into();
+                }
+                entry
+            })
+            .collect_vec();
+        let report = json!({
+            "format": "charon-callgraph",
+            "version": 1,
+            "crate": krate.crate_name,
+            "items": entries,
+        });
+        let file = std::fs::File::create(&path).unwrap_or_else(|error| {
+            panic!(
+                "cannot write call graph {}: {error}",
+                path.to_string_lossy()
+            )
+        });
+        serde_json::to_writer(std::io::BufWriter::new(file), &report).unwrap_or_else(|error| {
+            panic!(
+                "cannot write call graph {}: {error}",
+                path.to_string_lossy()
+            )
+        });
+    }
+}
