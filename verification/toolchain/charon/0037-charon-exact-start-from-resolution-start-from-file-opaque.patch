+//@ charon-arg=--start-from-file=tests/ui/filtering/start-from-canonical.patterns
+//@ charon-arg=--start-from=test_crate::{impl test_crate::Shape for Tuple<u8, u16>}::area,test_crate::_#0::{impl test_crate::Sq}::hidden
+// Canonical name patterns (as `CHARON_CALLGRAPH` dumps them) select exactly the item they name:
+// the nested items and closures of a selected function are not selected with it, and `@`
+// (a type parameter) and `#N` (a disambiguator) tell apart impl blocks and closures that `_` and
+// plain names would confuse. A list of patterns may contain commas inside brackets.
+pub trait Shape {
+    fn area(&self) -> u32;
+    fn double(&self) -> u32 {
+        self.area() * 2
+    }
+}
+pub struct Sq(pub u32);
+pub struct Pair<T>(pub T, pub T);
+
+impl Shape for Sq {
+    fn area(&self) -> u32 {
+        self.0 * self.0
+    }
+}
+impl Shape for (u8, u16) {
+    fn area(&self) -> u32 {
+        self.0 as u32 + self.1 as u32
+    }
+}
+impl<T: Shape> Shape for Pair<T> {
+    fn area(&self) -> u32 {
+        self.0.area() + self.1.area()
+    }
+}
+impl Shape for Pair<u8> {
+    fn area(&self) -> u32 {
+        0
+    }
+}
+impl<T> Pair<T> {
+    pub fn first(&self) -> &T {
+        &self.0
+    }
+}
+impl Pair<u16> {
+    pub fn sum(&self) -> u16 {
+        self.0 + self.1
+    }
+}
+const _: () = {
+    impl Sq {
+        pub fn hidden(&self) -> u32 {
+            1
+        }
+    }
+};
+
+pub fn apply<F: Fn(u32) -> u32>(f: F, x: u32) -> u32 {
+    f(x)
+}
+
+pub fn user() -> u32 {
+    fn helper(x: u32) -> u32 {
+        x + 1
+    }
+    let a = apply(|x| x + 1, 2);
+    let k = 5;
+    let b = apply(move |x| x * k, 3);
+    helper(a + b)
+}
