@@ -0,0 +1,21 @@
+//@ no-default-options
+//@ charon-args=--preset=aeneas --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=*
+// A lifted associated type is determined by the other arguments, so its regions are the regions of
+// these arguments: `as_deref_mut` on `Option<&'a mut Frame<'b>>` takes the lifted
+// `<&'a mut Frame<'b> as Deref>::Target = Frame<'b>`. Partial monomorphization reuses the parameter
+// of `'b` for the region of the lifted `Frame<'b>` instead of giving it a region of its own: the
+// specializations of `as_deref_mut` and of `DerefMut` have one region parameter for `'b`, as
+// the call site and the specialized `DerefMut` implementation (whose `Target` is `Frame<'b>`).
+pub struct Frame<'a> {
+    ctx: &'a mut u32,
+}
+
+pub fn advance(mut execution: Option<&mut Frame<'_>>) -> u32 {
+    match execution.as_deref_mut() {
+        Some(f) => {
+            *f.ctx += 1;
+            *f.ctx
+        }
+        None => 0,
+    }
+}
