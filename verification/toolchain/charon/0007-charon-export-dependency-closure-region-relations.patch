+/// Extension of the relation table written beside a dependency artifact.
+const TABLE_EXTENSION: &str = "charon-closures";
+
+type ExternalTable = FxHashMap<String, ClosureRegionRelations>;
+static EXTERNAL: LazyLock<Mutex<FxHashMap<CrateNum, ExternalTable>>> =
+    LazyLock::new(|| Mutex::new(FxHashMap::default()));
+
+fn relation_key(tcx: TyCtxt<'_>, def_id: DefId) -> String {
+    format!("{:?}", tcx.def_path_hash(def_id))
+}
+
+fn artifact_table_path(artifact: &Path) -> PathBuf {
+    artifact.with_extension(TABLE_EXTENSION)
+}
+
+/// Write this crate's closure relations beside the artifact dependents load.
+/// Call after analysis, before metadata is emitted to pipelined dependents.
+pub fn export_dependency_table(tcx: TyCtxt<'_>) {
+    // Same stem as the `.rlib`/`.rmeta` a dependent crate loads.
+    let artifact = match tcx.output_filenames(()).path(rustc_session::config::OutputType::Metadata) {
+        rustc_session::config::OutFileName::Real(path) => path,
+        rustc_session::config::OutFileName::Stdout => {
+            panic!("cannot export closure-region relations for metadata written to stdout")
+        }
+    };
+    let mut lines = Vec::new();
+    for (id, relation) in RELATIONS.lock().expect("closure-region cache poisoned").iter() {
+        let edges = relation.outlives.iter()
+            .map(|(longer, shorter)| format!("{longer}:{shorter}"))
+            .collect::<Vec<_>>()
+            .join(",");
+        lines.push(format!(
+            "{}\t{}\t{}\t{}",
+            relation_key(tcx, id.to_def_id()),
+            relation.signature_regions,
+            relation.capture_regions,
+            edges,
+        ));
+    }
+    lines.sort();
+    let path = artifact_table_path(&artifact);
+    std::fs::write(&path, lines.join("\n")).unwrap_or_else(|error| {
+        panic!("cannot write closure-region table {}: {error}", path.display())
+    });
+}
+
+fn parse_table(path: &Path) -> ExternalTable {
+    let text = std::fs::read_to_string(path).unwrap_or_else(|error| {
+        panic!(
+            "missing closure-region table {}: {error}; rebuild the dependency with charon",
+            path.display()
+        )
+    });
+    let mut table = ExternalTable::default();
+    for line in text.lines().filter(|line| !line.is_empty()) {
+        let fields = line.split('\t').collect::<Vec<_>>();
+        let [key, signature, capture, edges] = fields[..] else {
+            panic!("malformed closure-region table {}: {line:?}", path.display());
+        };
+        let parse = |value: &str| -> usize {
+            value.parse().unwrap_or_else(|_| {
+                panic!("malformed closure-region table {}: {line:?}", path.display())
+            })
+        };
+        let outlives = edges.split(',')
+            .filter(|edge| !edge.is_empty())
+            .map(|edge| {
+                let (longer, shorter) = edge.split_once(':').unwrap_or_else(|| {
+                    panic!("malformed closure-region table {}: {line:?}", path.display())
+                });
+                (parse(longer), parse(shorter))
+            })
+            .collect();
+        let relation = ClosureRegionRelations {
+            signature_regions: parse(signature),
+            capture_regions: parse(capture),
+            outlives,
+        };
+        assert!(
+            table.insert(key.to_string(), relation).is_none(),
+            "duplicate closure-region entry {key} in {}",
+            path.display()
+        );
+    }
+    table
+}
+
+/// Relations exported when the external crate defining `def_id` was compiled.
+pub fn lookup_external(tcx: TyCtxt<'_>, def_id: DefId) -> ClosureRegionRelations {
+    let key = relation_key(tcx, def_id);
+    let mut tables = EXTERNAL.lock().expect("closure-region cache poisoned");
+    let table = tables.entry(def_id.krate).or_insert_with(|| {
+        let source = tcx.used_crate_source(def_id.krate);
+        let artifact = source.rlib.as_ref().or(source.rmeta.as_ref()).unwrap_or_else(|| {
+            panic!("no artifact recorded for external closure {def_id:?}")
+        });
+        parse_table(&artifact_table_path(artifact))
+    });
+    table.get(&key).cloned().unwrap_or_else(|| {
+        panic!(
+            "external closure {def_id:?} has no exported region relations; \
+             its crate must be compiled by the charon driver"
+        )
+    })
+}
