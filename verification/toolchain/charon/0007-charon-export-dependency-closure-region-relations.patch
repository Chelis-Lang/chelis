+/// Compile a target dependency normally while retaining the closure lifetime
+/// relations its borrow checker computes, so that dependents can translate its
+/// closures from optimized MIR without inventing unconstrained regions.
+pub struct DependencyCallbacks;
+
+impl Callbacks for DependencyCallbacks {
+    fn config(&mut self, config: &mut Config) {
+        setup_compiler(config, &Default::default(), false);
+        crate::closure_regions::clear();
+        config.override_queries = Some(|_sess, providers| {
+            crate::closure_regions::install(providers);
+        });
+    }
+
+    fn after_analysis<'tcx>(&mut self, _: &Compiler, tcx: TyCtxt<'tcx>) -> Compilation {
+        // Every body has been borrow-checked; metadata has not been emitted yet.
+        crate::closure_regions::export_dependency_table(tcx);
+        Compilation::Continue
+    }
+}
