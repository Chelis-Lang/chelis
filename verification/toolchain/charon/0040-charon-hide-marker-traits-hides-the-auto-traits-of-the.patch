+//@ charon-args=--hide-marker-traits
+//! Auto traits have no items: `--hide-marker-traits` hides them like the other marker traits, so
+//! that no clause, built-in impl, supertrait or explicit impl of `Send`, `Sync`, `Unpin`,
+//! `UnwindSafe` or `RefUnwindSafe` remains.
+use std::any::Any;
+use std::panic::{RefUnwindSafe, UnwindSafe};
+
+pub fn boxed<P: Any + Send>(payload: P) -> Box<dyn Any + Send> {
+    Box::new(payload)
+}
+
+pub fn call<F: FnOnce() -> u32 + UnwindSafe, T: Sync + Unpin + RefUnwindSafe>(f: F, _t: &T) -> u32 {
+    f()
+}
+
+pub trait Job: Send + Sync {
+    fn run(&self) -> u32;
+}
+
+pub fn run_job<J: Job>(job: &J) -> u32 {
+    job.run()
+}
+
+pub struct Handle<T>(pub T);
+
+unsafe impl<T: Send> Sync for Handle<T> {}
+
+impl<T: Send> Job for Handle<T> {
+    fn run(&self) -> u32 {
+        0
+    }
+}
+
+pub fn user() -> u32 {
+    let _ = boxed(1u32);
+    call(|| 3, &0u8) + run_job(&Handle(2u8))
+}
