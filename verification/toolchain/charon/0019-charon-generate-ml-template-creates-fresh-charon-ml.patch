# charon integration step 19 after 546078ea5d: commit 904f534226055d94ebf9cdf37cfff06913597d37
# first parent 2e61ecf576b077d0312517c1410f18f73b9f80e7
# series charon: patch -p1 in charon/ of the upstream source
#
# charon: generate-ml template creates fresh charon-ml decoding tables per file
#
# The OfJson template exposed one global of_json_ctx whose file table and
# hash-consing maps are mutable. Every crate_of_json call shared them, so a file
# decoded after another could resolve a {"Deduplicated": k} key (or a file id)
# that it never defined to a value of the previous file instead of failing.
# Replace it by fresh_of_json_ctx ().

diff --git a/src/bin/generate-ml/templates/OfJson.ml b/src/bin/generate-ml/templates/OfJson.ml
index 07a3873..fc54c87 100644
--- a/src/bin/generate-ml/templates/OfJson.ml
+++ b/src/bin/generate-ml/templates/OfJson.ml
@@ -37,7 +37,9 @@ type of_json_ctx = {
   tref_hashcons_map : trait_ref HashConsId.Map.t ref;
 }
 
-let empty_of_json_ctx : of_json_ctx =
+(** A fresh context for decoding one file. The file and hash-consing tables are
+    mutable: they must not be shared between files, whose ids are unrelated. *)
+let fresh_of_json_ctx () : of_json_ctx =
   {
     id_to_file_map = FileTbl.create 8;
     ty_hashcons_map = ref HashConsId.Map.empty;
