+//@ no-default-options
+//@ charon-args=--preset=aeneas
+//@ charon-args=--include core::ptr::const_ptr::_::offset
+//! Deduplicated llbc files intern spans: the first occurrence of each distinct span carries its
+//! id, later occurrences are the id alone. Macro expansions repeat spans, and the optimized MIR of
+//! `offset` has spans with a `generated_from_span` (inlined callees). The charon-ml
+//! deserialization test loads this file's llbc, which (unlike with the tests preset) is
+//! deduplicated.
+
+macro_rules! double {
+    ($x:expr) => {
+        $x + $x
+    };
+}
+
+pub fn quadruple(x: u32) -> u32 {
+    let y = double!(x);
+    double!(y)
+}
+
+pub fn sum_doubled(xs: &[u32]) -> u32 {
+    let mut total = 0;
+    let mut i = 0;
+    while i < xs.len() {
+        total += double!(xs[i]);
+        i += 1;
+    }
+    total
+}
+
+pub fn second(xs: &[u32; 2]) -> u32 {
+    let p = xs.as_ptr();
+    unsafe { *p.offset(1) }
+}
