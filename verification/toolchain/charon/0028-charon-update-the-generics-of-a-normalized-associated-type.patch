@@ -0,0 +1,32 @@
+//@ charon-arg=--lift-associated-types=*
+// Normalizing `Self::Item` to `Wrap<u32>` substitutes an ADT whose lifted associated-type
+// parameter must be added exactly once. Its children used to be updated twice, giving
+// `Wrap<u32, u64, u64>` (the `Vec<NonZeroUsize>: FromIterator<Self::Item>` pattern of
+// `collect`).
+pub trait Prim {
+    type Inner;
+}
+impl Prim for u32 {
+    type Inner = u64;
+}
+pub struct Wrap<T: Prim>(pub T::Inner);
+
+pub trait Iter {
+    type Item;
+    fn get(&self) -> Self::Item;
+    fn convert<B: From<Self::Item>>(&self) -> B {
+        B::from(self.get())
+    }
+}
+
+pub struct Src;
+impl Iter for Src {
+    type Item = Wrap<u32>;
+    fn get(&self) -> Wrap<u32> {
+        Wrap(0)
+    }
+}
+
+pub fn call(s: &Src) -> Wrap<u32> {
+    s.convert()
+}
