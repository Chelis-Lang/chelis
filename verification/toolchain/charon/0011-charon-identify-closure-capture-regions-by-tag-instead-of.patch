+/// The canonical traversal of a closure's capture region occurrences: rustc's `fold_regions` over
+/// the upvar types, which visits every free region in order. The borrowck collector (`capture`),
+/// hax's `ClosureArgs` (both local and dependency relations) and the capture tags all index
+/// occurrences by their position in this traversal, so an index names the same occurrence
+/// everywhere. `f` receives each occurrence with its index and returns its replacement.
+pub fn fold_capture_regions<'tcx>(
+    tcx: TyCtxt<'tcx>,
+    upvar_tys: &'tcx ty::List<ty::Ty<'tcx>>,
+    mut f: impl FnMut(usize, ty::Region<'tcx>) -> ty::Region<'tcx>,
+) -> &'tcx ty::List<ty::Ty<'tcx>> {
+    let mut index = 0;
+    ty::fold_regions(tcx, upvar_tys, |r, _| {
+        let r = f(index, r);
+        index += 1;
+        r
+    })
+}
+
+/// A region standing for the erased capture occurrence `index` of closure `closure`, in the
+/// captured types of the closure's definition. Charon's translation of those types can reorder,
+/// duplicate or drop occurrences (e.g. a captured closure's signature has no counterpart in its
+/// closure ADT), so it identifies each occurrence by this tag instead of by position. Upvar types
+/// only contain erased or static regions, so a late-bound parameter of the closure itself cannot
+/// be confused with a real region.
+pub fn capture_region_tag<'tcx>(tcx: TyCtxt<'tcx>, closure: DefId, index: usize) -> ty::Region<'tcx> {
+    let index = u32::try_from(index).expect("too many closure capture regions");
+    ty::Region::new_late_param(tcx, closure, ty::LateParamRegionKind::Anon(index))
+}
+
+pub fn is_capture_region_tag(r: ty::Region<'_>, closure: DefId, index: usize) -> bool {
+    matches!(
+        r.kind(),
+        ty::ReLateParam(ty::LateParamRegion { scope, kind: ty::LateParamRegionKind::Anon(i) })
+            if scope == closure && i as usize == index
+    )
+}
