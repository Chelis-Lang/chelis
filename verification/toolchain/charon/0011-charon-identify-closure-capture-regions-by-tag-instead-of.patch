+    /// of this instance to line up with those of the definition: instantiating a type parameter
+    /// with a type that has lifetimes inserts occurrences, and changes their number. Otherwise,
+    /// or for upvar regions without rustc occurrence, the argument stays erased: a fresh region
+    /// without relations (dropping relations is conservative; inventing them is not).
+    fn instantiate_captured_closure_regions(
+        &mut self,
+        span: Span,
+        closure: &hax::ClosureArgs,
+        tref: &mut TypeDeclRef,
+    ) -> Result<(), Error> {
+        let Some(params) = self.t_ctx.closure_capture_params.get(&closure.item.def_id).cloned()
