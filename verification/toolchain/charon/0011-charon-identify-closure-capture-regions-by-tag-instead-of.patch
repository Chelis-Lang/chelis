diff --git a/tests/ui/closure-captures-closure.rs b/tests/ui/closure-captures-closure.rs
new file mode 100644
index 0000000..9f491c3
--- /dev/null
+++ b/tests/ui/closure-captures-closure.rs
@@ -0,0 +1,39 @@
+//@ no-default-options
+//@ charon-args=--preset=aeneas
+
+// A closure capturing another closure. rustc's type for the captured closure
+// includes its signature, whose free lifetime (`Self` names `Ctx<'p>`) has no
+// counterpart in Charon's closure ADT; the outer closure's borrowck relations
+// must be matched to the regions Charon introduces by identity, not position.
+pub struct Ctx<'p> {
+    pub data: &'p [u32],
+}
+
+impl<'p> Ctx<'p> {
+    pub fn run(&self, ids: &[usize]) -> u32 {
+        let lookup = |ctx: &Self, id: usize| -> u32 { ctx.data[id] };
+        let total = |id: usize| lookup(self, id) + 1;
+        let mut sum = 0;
+        let mut i = 0;
+        while i < ids.len() {
+            sum += total(ids[i]);
+            i += 1;
+        }
+        sum
+    }
+
+    // The captured closure itself captures state, whose regions become
+    // arguments of its closure type in the outer closure's captures.
+    pub fn nested(&self, extra: &u32, ids: &[usize]) -> u32 {
+        let lookup = |ctx: &Self, id: usize| -> u32 { ctx.data[id] + *extra };
+        let total = |id: usize| lookup(self, id) + lookup(self, id);
+        let pick = |id: usize| total(id) * 2;
+        let mut sum = 0;
+        let mut i = 0;
+        while i < ids.len() {
+            sum += pick(ids[i]);
+            i += 1;
+        }
+        sum
+    }
+}
