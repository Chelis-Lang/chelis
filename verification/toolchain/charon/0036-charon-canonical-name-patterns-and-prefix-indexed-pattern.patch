+//! A set of patterns indexed by their path prefixes, to match a name against thousands of
+//! patterns in time proportional to the name's length (plus the patterns that match).
+use std::collections::HashMap;
+
+use super::{PatElem, Pattern};
+use crate::ast::*;
+
+/// A list of patterns with associated values. `matches` returns the same entries, in the same
+/// order, as filtering the list with `Pattern::matches`.
+///
+/// Patterns whose elements are identifiers and impl blocks and that start with an identifier are
+/// stored in a trie keyed by identifier (impl blocks share one key), and are found by walking the
+/// name along the trie. Patterns with globs or starting with an impl block (which match an impl
+/// block anywhere in a name) are few and are tried one by one. Candidates found through the trie
+/// are then matched in full, which checks disambiguators, generics and impl blocks.
+#[derive(Debug, Clone)]
+pub struct PatternIndex<T> {
+    entries: Vec<(Pattern, T)>,
+    trie: TrieNode,
+    unindexed: Vec<usize>,
+}
+
+#[derive(Debug, Clone, Default)]
+struct TrieNode {
+    /// The entries whose pattern ends here.
+    ends: Vec<usize>,
+    idents: HashMap<String, TrieNode>,
+    impls: Option<Box<TrieNode>>,
+}
+
+impl<T> Default for PatternIndex<T> {
+    fn default() -> Self {
+        Self {
+            entries: Vec::new(),
+            trie: TrieNode::default(),
+            unindexed: Vec::new(),
+        }
+    }
+}
+
+impl<T> FromIterator<(Pattern, T)> for PatternIndex<T> {
+    fn from_iter<I: IntoIterator<Item = (Pattern, T)>>(iter: I) -> Self {
+        let mut index = Self::default();
+        for (pat, value) in iter {
+            index.push(pat, value);
+        }
+        index
+    }
+}
+
+impl<T> PatternIndex<T> {
+    pub fn push(&mut self, pat: Pattern, value: T) {
+        let i = self.entries.len();
+        let indexable = matches!(pat.elems.first(), Some(PatElem::Ident { .. }))
+            && pat
+                .elems
+                .iter()
+                .all(|elem| matches!(elem, PatElem::Ident { .. } | PatElem::Impl(_)));
+        if indexable {
+            let mut node = &mut self.trie;
+            for elem in &pat.elems {
+                node = match elem {
+                    PatElem::Ident { name, .. } => node.idents.entry(name.clone()).or_default(),
+                    PatElem::Impl(_) => node.impls.get_or_insert_default(),
+                    PatElem::Glob => unreachable!(),
+                };
+            }
+            node.ends.push(i);
+        } else {
+            self.unindexed.push(i);
+        }
+        self.entries.push((pat, value));
+    }
+
+    pub fn is_empty(&self) -> bool {
+        self.entries.is_empty()
+    }
+
+    pub fn len(&self) -> usize {
+        self.entries.len()
+    }
+
+    pub fn iter(&self) -> impl Iterator<Item = &(Pattern, T)> {
+        self.entries.iter()
+    }
+
+    /// The entries whose pattern matches `name` (see `Pattern::matches`), in insertion order.
+    pub fn matches<'a>(
+        &'a self,
+        ctx: &'a TranslatedCrate,
+        name: &'a Name,
+    ) -> impl Iterator<Item = &'a (Pattern, T)> + use<'a, T> {
+        let mut candidates = self.unindexed.clone();
+        // `Pattern::matches` ignores a trailing instantiation.
+        let elems = match name.name.as_slice() {
+            [prefix @ .., PathElem::Instantiated(_)] => prefix,
+            elems => elems,
+        };
+        let mut stack = vec![(&self.trie, 0)];
+        while let Some((node, depth)) = stack.pop() {
+            // A pattern shorter than the name matches it if its elements match.
+            candidates.extend_from_slice(&node.ends);
+            let Some(elem) = elems.get(depth) else {
+                continue;
+            };
+            match elem {
+                PathElem::Ident(ident, _) => {
+                    if let Some(child) = node.idents.get(ident) {
+                        stack.push((child, depth + 1));
+                    }
+                    // `crate` designates the current crate (anywhere, as in `Pattern::matches`).
+                    if *ident == ctx.crate_name
+                        && let Some(child) = node.idents.get("crate")
+                    {
+                        stack.push((child, depth + 1));
+                    }
+                }
+                PathElem::Impl(_) => {
+                    if let Some(child) = &node.impls {
+                        stack.push((child, depth + 1));
+                    }
+                }
+                PathElem::Instantiated(_) | PathElem::Target(_) => {}
+            }
+        }
+        candidates.sort_unstable();
+        candidates.dedup();
+        candidates
+            .into_iter()
+            .map(|i| &self.entries[i])
+            .filter(|(pat, _)| pat.matches(ctx, name))
+    }
+}
