@@ -0,0 +1,207 @@
+//! Canonical patterns: the most precise pattern the syntax can express for a given item name.
+use std::collections::{HashMap, HashSet};
+
+use super::{PatElem, PatTy, Pattern};
+use crate::ast::*;
+
+/// The path elements whose canonical pattern spells out the disambiguator `#0`: plain `name`
+/// matches every disambiguator, so it would also match a sibling `name#1` (e.g. the `__Field`
+/// enums a derive macro generates in one function). Computed from a set of names.
+#[derive(Debug, Default)]
+pub struct Disambiguation {
+    ambiguous: HashSet<(Vec<PathElem>, String)>,
+}
+
+impl Disambiguation {
+    pub fn new<'a>(names: impl IntoIterator<Item = &'a Name>) -> Self {
+        let mut seen: HashMap<(&'a [PathElem], &'a str), Disambiguator> = HashMap::new();
+        let mut ambiguous = HashSet::new();
+        for name in names {
+            for (i, elem) in name.name.iter().enumerate() {
+                if let PathElem::Ident(ident, d) = elem {
+                    let key = (&name.name[..i], ident.as_str());
+                    match seen.get(&key) {
+                        Some(other) if other != d => {
+                            ambiguous.insert((key.0.to_vec(), key.1.to_owned()));
+                        }
+                        Some(_) => {}
+                        None => {
+                            seen.insert(key, *d);
+                        }
+                    }
+                }
+            }
+        }
+        Self { ambiguous }
+    }
+}
+
+impl Pattern {
+    /// The canonical pattern for this name: every path element spelled out, disambiguators where
+    /// they distinguish siblings, impl blocks with their implemented trait (and its arguments) and
+    /// self type, type parameters as `@`. Type arguments the syntax cannot express (function
+    /// pointers, `dyn`, raw pointers, ...) become `_`, so a canonical pattern may match more than one name;
+    /// callers that need exactness check it against the other names they know.
+    ///
+    /// Returns `None` for names that patterns cannot designate: monomorphized or target-specific
+    /// names, and names containing a trait impl that is not translated.
+    pub fn canonical(ctx: &TranslatedCrate, name: &Name) -> Option<Pattern> {
+        Self::canonical_with(ctx, &Disambiguation::default(), name)
+    }
+
+    /// `canonical`, spelling out `#0` where `disambiguation` says a sibling has the same
+    /// identifier.
+    pub fn canonical_with(
+        ctx: &TranslatedCrate,
+        disambiguation: &Disambiguation,
+        name: &Name,
+    ) -> Option<Pattern> {
+        let cx = Cx {
+            ctx,
+            disambiguation,
+        };
+        let elems = name
+            .name
+            .iter()
+            .enumerate()
+            .map(|(i, elem)| canonical_elem(cx, &name.name[..i], elem))
+            .collect::<Option<Vec<_>>>()?;
+        Some(Pattern { elems })
+    }
+}
+
+#[derive(Clone, Copy)]
+struct Cx<'a> {
+    ctx: &'a TranslatedCrate,
+    disambiguation: &'a Disambiguation,
+}
+
+fn canonical_elem(cx: Cx<'_>, prefix: &[PathElem], elem: &PathElem) -> Option<PatElem> {
+    let ctx = cx.ctx;
+    Some(match elem {
+        PathElem::Ident(name, disambiguator) => {
+            // Closures, anonymous constants and `_` items are numbered among their siblings;
+            // other items only get a nonzero disambiguator when a macro makes names collide.
+            let explicit = *disambiguator != Disambiguator::ZERO
+                || name == "closure"
+                || name == "_"
+                || name.starts_with('{')
+                || cx
+                    .disambiguation
+                    .ambiguous
+                    .contains(&(prefix.to_vec(), name.clone()));
+            PatElem::Ident {
+                name: name.clone(),
+                generics: Vec::new(),
+                is_trait: false,
+                disambiguator: explicit.then_some(*disambiguator),
+            }
+        }
+        PathElem::Impl(ImplElem::Ty(ty)) => {
+            let PatTy::Pat(pat) = canonical_ty(cx, &ty.skip_binder)? else {
+                // Inherent impls on references do not exist.
+                return None;
+            };
+            PatElem::Impl(Box::new(pat))
+        }
+        PathElem::Impl(ImplElem::Trait(impl_id)) => {
+            let timpl = ctx.trait_impls.get(*impl_id)?;
+            let trait_name = ctx.item_name(timpl.impl_trait.id)?;
+            let mut pat = Pattern::canonical_with(ctx, cx.disambiguation, trait_name)?;
+            let generics = canonical_args(cx, &timpl.impl_trait.generics)?;
+            // The first type argument is the self type.
+            if generics.is_empty() {
+                return None;
+            }
+            let Some(PatElem::Ident {
+                generics: last_generics,
+                is_trait,
+                ..
+            }) = pat.elems.last_mut()
+            else {
+                return None;
+            };
+            *last_generics = generics;
+            *is_trait = true;
+            PatElem::Impl(Box::new(pat))
+        }
+        PathElem::Instantiated(_) | PathElem::Target(_) => return None,
+    })
+}
+
+fn glob() -> PatTy {
+    PatTy::Pat(Pattern {
+        elems: vec![PatElem::Glob],
+    })
+}
+
+fn canonical_args(cx: Cx<'_>, args: &GenericArgs) -> Option<Vec<PatTy>> {
+    let mut pats = args
+        .types
+        .iter()
+        .map(|ty| canonical_ty(cx, ty))
+        .collect::<Option<Vec<_>>>()?;
+    // Const generic patterns other than `_` are not supported.
+    pats.extend(args.const_generics.iter().map(|_| glob()));
+    Some(pats)
+}
+
+fn with_generics(mut pat: Pattern, generics: Vec<PatTy>) -> Option<PatTy> {
+    let Some(PatElem::Ident {
+        generics: last_generics,
+        ..
+    }) = pat.elems.last_mut()
+    else {
+        return None;
+    };
+    *last_generics = generics;
+    Some(PatTy::Pat(pat))
+}
+
+fn canonical_ty(cx: Cx<'_>, ty: &Ty) -> Option<PatTy> {
+    let ctx = cx.ctx;
+    let path = |name: &Name| Pattern::canonical_with(ctx, cx.disambiguation, name);
+    Some(match ty.kind() {
+        TyKind::Adt(tref) => match tref.id {
+            TypeId::Adt(id) => {
+                let name = ctx.item_name(id)?;
+                let pat = path(name)?;
+                // A closure type is designated by its path alone: its arguments are those of the
+                // enclosing item.
+                if matches!(name.name.last(), Some(PathElem::Ident(ident, _)) if ident == "closure")
+                {
+                    PatTy::Pat(pat)
+                } else {
+                    with_generics(pat, canonical_args(cx, &tref.generics)?)?
+                }
+            }
+            TypeId::Builtin(builtin) => {
+                let pat = path(&builtin.get_name())?;
+                with_generics(pat, canonical_args(cx, &tref.generics)?)?
+            }
+            TypeId::Tuple => {
+                let pat = path(&Name::from_path(&["Tuple"]))?;
+                with_generics(pat, canonical_args(cx, &tref.generics)?)?
+            }
+        },
+        TyKind::Array(elem, _) => {
+            let pat = path(&Name::from_path(&["Array"]))?;
+            with_generics(pat, vec![canonical_ty(cx, elem)?, glob()])?
+        }
+        TyKind::Slice(elem) => {
+            let pat = path(&Name::from_path(&["Slice"]))?;
+            with_generics(pat, vec![canonical_ty(cx, elem)?])?
+        }
+        TyKind::Ref(_, inner, kind) => PatTy::Ref(*kind, Box::new(canonical_ty(cx, inner)?)),
+        TyKind::Literal(lit) => PatTy::Pat(path(&Name::from_path(&[lit.to_string().as_str()]))?),
+        TyKind::TypeVar(..) => PatTy::Var,
+        TyKind::Never
+        | TyKind::RawPtr(..)
+        | TyKind::TraitType(..)
+        | TyKind::DynTrait(..)
+        | TyKind::FnPtr(..)
+        | TyKind::FnDef(..)
+        | TyKind::PtrMetadata(..)
+        | TyKind::Error(..) => glob(),
+    })
+}
