+/// Split a comma-separated list of patterns, ignoring the commas inside brackets (as in
+/// `{impl Trait<A, B> for T}`).
+fn split_patterns(list: &str) -> impl Iterator<Item = &str> {
+    let mut depth = 0usize;
+    list.split(move |c: char| {
+        match c {
+            '<' | '{' | '(' | '[' => depth += 1,
+            '>' | '}' | ')' | ']' => depth = depth.saturating_sub(1),
+            _ => {}
+        }
+        c == ',' && depth == 0
+    })
+    .map(str::trim)
+    .filter(|pat| !pat.is_empty())
+}
