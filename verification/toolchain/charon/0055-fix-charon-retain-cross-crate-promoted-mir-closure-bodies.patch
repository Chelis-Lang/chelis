+/// Closure-hoisted fake reads encode a crate-local `LocalDefId` in their cause. These markers are
+/// borrow-check-only and are discarded by LLBC translation, so strip only the non-portable forms
+/// before cross-crate encoding; retain portable fake reads and all operational MIR.
+fn has_non_portable_fake_reads(body: &Body<'_>) -> bool {
+    body.basic_blocks.iter().any(|basic_block| {
+        basic_block
+            .statements
+            .iter()
+            .any(|statement| is_non_portable_fake_read(&statement.kind))
+    })
+}
+
+fn is_non_portable_fake_read(kind: &StatementKind<'_>) -> bool {
+    matches!(
+        kind,
+        StatementKind::FakeRead(box (
+            FakeReadCause::ForLet(Some(_)) | FakeReadCause::ForMatchedPlace(Some(_)),
+            _
+        ))
+    )
+}
+
+fn strip_non_portable_fake_reads(body: &mut Body<'_>) {
+    for basic_block in body.basic_blocks_mut() {
+        basic_block
+            .statements
+            .retain(|statement| !is_non_portable_fake_read(&statement.kind));
+    }
+}
