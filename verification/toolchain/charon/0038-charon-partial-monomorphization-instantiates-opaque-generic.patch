+//@ no-default-options
+//@ charon-args=--preset=aeneas --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=*
+//@ charon-arg=--opaque=test_crate::external
+//@ charon-arg=--start-from=test_crate::user
+// A generic function made opaque by `--opaque` (e.g. because another, separately translated part
+// of the code base defines it) stays opaque, but the instance partial monomorphization creates
+// for the `&mut` argument used here keeps its body, as do the instances of its closures.
+pub fn external<T>(x: T, mut f: impl FnMut(T)) {
+    let mut g = |y: T| f(y);
+    g(x)
+}
+
+pub fn opaque_only<T>(x: T) -> T {
+    x
+}
+
+pub fn user(v: &mut u32) {
+    external(v, |r: &mut u32| *r += 1);
+}
