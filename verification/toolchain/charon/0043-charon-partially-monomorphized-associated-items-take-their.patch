index 0000000..abee610
--- /dev/null
+++ b/tests/ui/monomorphize-mut-method-region-order.rs
@@ -0,0 +1,18 @@
+//@ no-default-options
+//@ charon-args=--preset=aeneas --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=*
+// The regions of a partially monomorphized method come in the order of the generics of methods:
+// the regions of the (specialized) trait first, then those of the method itself. Specializing
+// `FnMut<(&'a mut u32, u32)>` for `call` gives `FnMut::call_mut` the region `'a` of the trait
+// arguments besides its own region (the borrow of `self`): `'a` must come first, as in the
+// `call_mut` of the closure implementation, whose impl region `'a` comes before its own region.
+pub fn call(f: &mut impl FnMut(&mut u32, u32) -> u32, x: &mut u32) -> u32 {
+    f(x, 1)
+}
+
+pub fn add(x: &mut u32) -> u32 {
+    let mut f = |x: &mut u32, k: u32| {
+        *x += k;
+        *x
+    };
+    call(&mut f, x)
+}
