+#[test]
+fn hidden_trait_impl_on_transparent_type() -> anyhow::Result<()> {
+    let crate_data = translate_with_options(
+        r#"
+        pub fn consume<I, F>(_map: std::iter::Map<I, F>) {}
+        "#,
+        &[
+            "--preset=aeneas",
+            "--include=core::iter::adapters::map::Map",
+        ],
+    )?;
+
+    // Resolving the drop of Map creates a synthetic Destruct impl under Map's name.
+    // Including the type must not resurrect an implementation of a hidden trait.
+    for timpl in crate_data.trait_impls.iter() {
+        assert!(
+            crate_data.trait_decls.get(timpl.impl_trait.id).is_some(),
+            "implementation of an omitted trait: {}",
+            repr_name(&crate_data, &timpl.item_meta.name),
+        );
+    }
+    assert!(crate_data.trait_decls.iter().all(|tdecl| {
+        repr_name(&crate_data, &tdecl.item_meta.name) != "core::marker::Destruct"
+    }));
+
+    // Including a type still makes its structure available to the consumer.
+    let map = crate_data
+        .type_decls
+        .iter()
+        .find(|ty| repr_name(&crate_data, &ty.item_meta.name) == "core::iter::adapters::map::Map")
+        .unwrap();
+    assert!(
+        matches!(map.kind, TypeDeclKind::Struct(_)),
+        "Map must remain a transparent structure",
+    );
+    Ok(())
+}
