diff --git a/src/ast/names.rs b/src/ast/names.rs
index df956f2..b9ad4e4 100644
--- a/src/ast/names.rs
+++ b/src/ast/names.rs
@@ -86,10 +86,102 @@ pub enum ImplElem {
 /// name clashes anyway. Still, we might want to be more precise in the future.
 ///
 /// Also note that the first path element in the name is always the crate name.
+///
+/// When values are deduplicated (see [HashConsSerializerState]), names are interned like spans:
+/// the first occurrence of each distinct name is written `{"Def": [id, path]}`, later ones are the
+/// id alone. This avoids writing each item name twice, in `item_names` and in the item's
+/// `ItemMeta`.
 #[derive(
     Debug, Default, Clone, PartialEq, Eq, Hash, SerializeState, DeserializeState, Drive, DriveMut,
 )]
 #[serde(transparent)]
+#[serde_state(state_implements = HashConsSerializerState)]
 pub struct Name {
+    #[serde(with = "InternedPath")]
     pub name: Vec<PathElem>,
 }
+
+/// The (de)serialization of the path of a [Name], see there.
+struct InternedPath;
+
+impl InternedPath {
+    fn serialize_state<S: serde::Serializer, State: HashConsSerializerState>(
+        path: &Vec<PathElem>,
+        state: &State,
+        serializer: S,
+    ) -> Result<S::Ok, S::Error> {
+        match state.record_serialized_name(path) {
+            None => path.serialize_state(state, serializer),
+            Some((id, false)) => serializer.serialize_u64(id as u64),
+            Some((id, true)) => serializer.serialize_newtype_variant(
+                "Name",
+                0,
+                "Def",
+                &serde_state::WithState::new((id, path), state),
+            ),
+        }
+    }
+
+    fn deserialize_state<'de, D: serde::Deserializer<'de>, State: HashConsSerializerState>(
+        state: &State,
+        deserializer: D,
+    ) -> Result<Vec<PathElem>, D::Error> {
+        deserializer.deserialize_any(InternedPathVisitor(state))
+    }
+}
+
+struct InternedPathVisitor<'a, State>(&'a State);
+
+/// Deserializes a `T` with the state.
+struct WithStateSeed<'a, T, State>(&'a State, std::marker::PhantomData<T>);
+
+impl<'de, T: DeserializeState<'de, State>, State> serde::de::DeserializeSeed<'de>
+    for WithStateSeed<'_, T, State>
+{
+    type Value = T;
+    fn deserialize<D: serde::Deserializer<'de>>(self, deserializer: D) -> Result<T, D::Error> {
+        T::deserialize_state(self.0, deserializer)
+    }
+}
+
+impl<'de, State: HashConsSerializerState> serde::de::Visitor<'de> for InternedPathVisitor<'_, State> {
+    type Value = Vec<PathElem>;
+
+    fn expecting(&self, f: &mut std::fmt::Formatter) -> std::fmt::Result {
+        write!(f, "a name: a list of path elements, or an interned name")
+    }
+
+    fn visit_seq<A: serde::de::SeqAccess<'de>>(self, mut seq: A) -> Result<Self::Value, A::Error> {
+        let mut path = Vec::new();
+        while let Some(elem) = seq.next_element_seed(WithStateSeed(self.0, Default::default()))? {
+            path.push(elem);
+        }
+        Ok(path)
+    }
+
+    fn visit_u64<E: serde::de::Error>(self, id: u64) -> Result<Self::Value, E> {
+        self.0.get_deserialized_name(id as usize).ok_or_else(|| {
+            E::custom(format!(
+                "unknown name id {id}; there is a serialization/deserialization mismatch"
+            ))
+        })
+    }
+
+    fn visit_map<A: serde::de::MapAccess<'de>>(self, mut map: A) -> Result<Self::Value, A::Error> {
+        use serde::de::Error;
+        let Some("Def") = map.next_key::<String>()?.as_deref() else {
+            return Err(A::Error::custom("expected an interned name `{\"Def\": [id, path]}`"));
+        };
+        let (id, path): (usize, Vec<PathElem>) =
+            map.next_value_seed(WithStateSeed(self.0, Default::default()))?;
+        if map.next_key::<String>()?.is_some() {
+            return Err(A::Error::custom("unexpected key in an interned name"));
+        }
+        if !self.0.record_deserialized_name(id, &path) {
+            return Err(A::Error::custom(format!(
+                "unexpected name id {id}; there is a serialization/deserialization mismatch"
+            )));
+        }
+        Ok(path)
+    }
+}
