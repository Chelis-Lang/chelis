+(** A name is the list of its path elements. In deduplicated files, the first
+    occurrence of each name is [{"Def": [id, path]}] (ids are consecutive from
+    0) and the later occurrences are the id alone. *)
+let interned_name_of_json
+    (path_of_json : of_json_ctx -> json -> (name, string) result)
+    (ctx : of_json_ctx) (js : json) : (name, string) result =
+  combine_error_msgs js __FUNCTION__
+    (match js with
+    | `List _ -> path_of_json ctx js
+    | `Int id -> (
+        match Hashtbl.find_opt ctx.name_table id with
+        | Some name -> Ok name
+        | None ->
+            Error
+              "Name id not found; there is a serialization mismatch between \
+               Rust and OCaml")
+    | `Assoc [ ("Def", `List [ `Int id; path ]) ] ->
+        if id <> Hashtbl.length ctx.name_table then
+          Error
+            "Unexpected name id; there is a serialization mismatch between \
+             Rust and OCaml"
+        else
+          let* name = path_of_json ctx path in
+          Hashtbl.add ctx.name_table id name;
+          Ok name
+    | _ -> Error "")
+
 let path_buf_of_json = string_of_json
 
