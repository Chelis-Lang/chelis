+#[test]
+fn doc_comments() -> anyhow::Result<()> {
+    let code = r#"
+        /// This is a doc comment.
+        fn main() {}
+        "#;
+    let doc_comments = |crate_data: &TranslatedCrate| {
+        crate_data
+            .fun_decls
+            .iter()
+            .flat_map(|decl| &decl.item_meta.attr_info.attributes)
+            .filter(|attr| attr.is_doc_comment())
+            .cloned()
+            .collect_vec()
+    };
+    // Doc comments carry no semantics: they are only translated on request.
+    assert_eq!(doc_comments(&translate(code)?), vec![]);
+    assert_eq!(
+        doc_comments(&translate_with_options(code, &["--doc-comments"])?),
+        vec![Attribute::DocComment(" This is a doc comment.".to_owned())]
+    );
+    Ok(())
+}
