+//! Bodies of a dependency are translated from the same (promoted) MIR as local bodies: `*b` on a
+//! `Box` stays a builtin deref instead of the runtime MIR's pointer-field projections and null
+//! checks. The local copies below must translate exactly like the dependency's functions.
+use foreign_box_deref_aux::Node;
+
+pub fn carrier(node: &Box<Node>) -> u32 {
+    node.tag()
+}
+
+pub fn take(node: Box<Node>) -> u32 {
+    let node = *node;
+    node.tag
+}
+
+pub fn set(node: &mut Box<Node>, tag: u32) {
+    node.tag = tag;
+}
+
+pub fn promoted() -> &'static [u32] {
+    &[1, 2, 3]
+}
+
+pub static NAME: &str = "node";
+
+pub const fn double(x: u32) -> u32 {
+    x * 2
+}
+
+pub fn use_foreign(mut node: Box<Node>) -> u32 {
+    foreign_box_deref_aux::set(&mut node, foreign_box_deref_aux::double(1));
+    foreign_box_deref_aux::carrier(&node)
+        + foreign_box_deref_aux::promoted()[0]
+        + foreign_box_deref_aux::NAME.len() as u32
+        + foreign_box_deref_aux::take(node)
+}
