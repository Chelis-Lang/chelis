+//! Export the promoted MIR of dependency crates, so that their bodies are translated from the same
+//! MIR level as the bodies of the crate being translated.
+//!
+//! Crate metadata only carries the runtime MIR of a dependency (`optimized_mir`, `mir_for_ctfe`),
+//! after runtime lowering such as `ElaborateBoxDerefs` and the UB checks. `--mir=promoted` asks for
+//! the MIR the borrow checker sees, which rustc discards once it has analysed the crate.
+//!
+//! Dependencies compiled through the driver (see `DependencyCallbacks`) therefore capture the
+//! promoted MIR (body and promoted constants) of every definition that has MIR while rustc computes
+//! it, and write it beside the crate artifact, keyed by stable definition-path hash. The table
+//! records the crate hash (SVH) of the compilation that wrote it. Translating an external body at
+//! `--mir=promoted` reads the table belonging to the exact artifact rustc loaded; a missing,
+//! outdated or incomplete table is an error, never a fallback to the runtime MIR.
+//!
+//! The encoding reuses rustc's own `TyEncodable`/`TyDecodable` implementations, with a codec that
+//! maps session-local identifiers to stable ones like the incremental cache does: `DefId`s by
+//! `DefPathHash`, crates by `StableCrateId`, allocations by content, and spans by source file and
+//! offset. Spans keep their positions but not their hygiene (macro expansion) data, which MIR
+//! translation does not use. Cross-crate-cleared data (`ClearCrossCrate`) is cleared, as in the
+//! runtime MIR of crate metadata.
+use rustc_data_structures::fx::{FxHashMap, FxIndexSet};
+use rustc_data_structures::steal::Steal;
+use rustc_hir::def::DefKind;
+use rustc_hir::def_id::{CrateNum, DefId, DefIndex, LOCAL_CRATE, LocalDefId, StableCrateId};
+use rustc_index::IndexVec;
+use rustc_middle::mir::interpret::{AllocDecodingState, AllocId, specialized_encode_alloc_id};
+use rustc_middle::mir::{Body, Promoted};
+use rustc_middle::ty::codec::{TyDecoder, TyEncoder};
+use rustc_middle::ty::{self, Ty, TyCtxt};
+use rustc_serialize::opaque::{MAGIC_END_BYTES, MemDecoder};
+use rustc_serialize::{Decodable, Decoder, Encodable, Encoder, leb128};
+use rustc_span::def_id::DefPathHash;
+use rustc_span::hygiene::{ExpnId, SyntaxContext};
+use rustc_span::{
+    AttrId, BlobDecoder, BytePos, ByteSymbol, FileName, SourceFile, Span, SpanDecoder,
+    SpanEncoder, StableSourceFileId, Symbol,
+};
+use std::path::{Path, PathBuf};
+use std::sync::{Arc, LazyLock, Mutex};
+
+/// The promoted MIR of one definition: its body and its promoted constants.
+pub type PromotedMir<'tcx> = (Body<'tcx>, IndexVec<Promoted, Body<'tcx>>);
+
+/// Extension of the table written beside a dependency artifact.
+const TABLE_EXTENSION: &str = "charon-mir";
+/// First bytes of a table. Bump the version whenever the encoding or the set of exported bodies
+/// changes, so that tables written by older drivers are rejected.
+const TABLE_HEADER: &[u8] = b"charon-promoted-mir v1\n";
+
+/// Encoded promoted MIR of the crate being compiled, captured when rustc computes it.
+static CAPTURED: LazyLock<Mutex<FxHashMap<LocalDefId, Vec<u8>>>> =
+    LazyLock::new(|| Mutex::new(FxHashMap::default()));
+
+pub fn clear() {
+    CAPTURED.lock().expect("promoted-MIR cache poisoned").clear();
+}
+
+type MirPromotedProvider = for<'tcx> fn(
+    TyCtxt<'tcx>,
+    LocalDefId,
+) -> (
+    &'tcx Steal<Body<'tcx>>,
+    &'tcx Steal<IndexVec<Promoted, Body<'tcx>>>,
+);
+static ORIGINAL_MIR_PROMOTED: Mutex<Option<MirPromotedProvider>> = Mutex::new(None);
+
+/// Capture the promoted MIR of every body as rustc computes it, before later passes steal it.
+/// Incremental reuse must be disabled (see `closure_regions::disable_incremental_reuse`): the
+/// provider must run for every body.
+pub fn install(providers: &mut rustc_middle::util::Providers) {
+    *ORIGINAL_MIR_PROMOTED.lock().expect("promoted-MIR cache poisoned") =
+        Some(providers.queries.mir_promoted);
+    providers.queries.mir_promoted = |tcx, def| {
+        let original = ORIGINAL_MIR_PROMOTED
+            .lock()
+            .expect("promoted-MIR cache poisoned")
+            .expect("missing mir_promoted provider");
+        let result = original(tcx, def);
+        let encoded = encode(tcx, &result.0.borrow(), &result.1.borrow());
+        CAPTURED
+            .lock()
+            .expect("promoted-MIR cache poisoned")
+            .insert(def, encoded);
+        result
+    };
+}
+
+/// Whether `mir_promoted` exists for this MIR-carrying definition. Constructors get their MIR
+/// from a shim, and trivial constants are evaluated without building MIR past `mir_built`; the
+/// runtime MIR of both is what `--mir=promoted` translates locally too.
+fn has_promoted_mir(tcx: TyCtxt<'_>, def: LocalDefId) -> bool {
+    !matches!(tcx.def_kind(def), DefKind::Ctor(..)) && !tcx.is_trivial_const(def)
+}
+
+fn artifact_table_path(artifact: &Path) -> PathBuf {
+    artifact.with_extension(TABLE_EXTENSION)
+}
+
+/// Write the promoted MIR of every body of this crate beside the artifact dependents load.
+/// Call after analysis, before metadata is emitted to pipelined dependents.
+pub fn export_dependency_table(tcx: TyCtxt<'_>) {
+    let artifact = match tcx
+        .output_filenames(())
+        .path(rustc_session::config::OutputType::Metadata)
+    {
+        rustc_session::config::OutFileName::Real(path) => path,
+        rustc_session::config::OutFileName::Stdout => {
+            panic!("cannot export promoted MIR for metadata written to stdout")
+        }
+    };
+    let mut entries = Vec::new();
+    for &def in tcx.mir_keys(()) {
+        if !has_promoted_mir(tcx, def) {
+            continue;
+        }
+        let captured = CAPTURED
+            .lock()
+            .expect("promoted-MIR cache poisoned")
+            .contains_key(&def);
+        if !captured {
+            // Bodies no analysis needed (e.g. unused consts) still have MIR in the metadata. Build
+            // their promoted MIR now; the provider captures it. If rustc had computed it before
+            // our provider was installed, it is stolen and cannot be exported.
+            let (body, _) = tcx.mir_promoted(def);
+            assert!(
+                !body.is_stolen()
+                    || CAPTURED
+                        .lock()
+                        .expect("promoted-MIR cache poisoned")
+                        .contains_key(&def),
+                "the promoted MIR of {def:?} was computed without the charon driver's provider; \
+                 cannot export it"
+            );
+        }
+        let encoded = CAPTURED
+            .lock()
+            .expect("promoted-MIR cache poisoned")
+            .remove(&def)
+            .unwrap_or_else(|| {
+                panic!("the promoted MIR of {def:?} was not captured; cannot export it")
+            });
+        entries.push((tcx.def_path_hash(def.to_def_id()).0.to_le_bytes(), encoded));
+    }
+    entries.sort_by(|a, b| a.0.cmp(&b.0));
+
+    let mut table = Vec::new();
+    table.extend_from_slice(TABLE_HEADER);
+    table.extend_from_slice(&tcx.crate_hash(LOCAL_CRATE).as_u128().to_le_bytes());
+    table.extend_from_slice(&(entries.len() as u64).to_le_bytes());
+    let mut offset = 0u64;
+    for (key, encoded) in &entries {
+        table.extend_from_slice(key);
+        table.extend_from_slice(&offset.to_le_bytes());
+        table.extend_from_slice(&(encoded.len() as u64).to_le_bytes());
+        offset += encoded.len() as u64;
+    }
+    for (_, encoded) in &entries {
+        table.extend_from_slice(encoded);
+    }
+    let path = artifact_table_path(&artifact);
+    std::fs::write(&path, table).unwrap_or_else(|error| {
+        panic!("cannot write promoted-MIR table {}: {error}", path.display())
+    });
+}
+
+/// The table of one external crate.
+struct ExternalTable {
+    path: PathBuf,
+    data: Vec<u8>,
+    /// Definition-path hash to byte range in `data`.
+    index: FxHashMap<[u8; 16], (usize, usize)>,
+}
+
+static EXTERNAL: LazyLock<Mutex<FxHashMap<CrateNum, Arc<ExternalTable>>>> =
+    LazyLock::new(|| Mutex::new(FxHashMap::default()));
+
+fn read_table(tcx: TyCtxt<'_>, krate: CrateNum) -> Result<ExternalTable, String> {
+    let crate_name = tcx.crate_name(krate);
+    let source = tcx.used_crate_source(krate);
+    let artifact = source
+        .rlib
+        .as_ref()
+        .or(source.rmeta.as_ref())
+        .ok_or_else(|| format!("no artifact recorded for crate `{crate_name}`"))?;
+    let path = artifact_table_path(artifact);
+    let data = std::fs::read(&path).map_err(|error| {
+        format!(
+            "missing promoted-MIR table {} of crate `{crate_name}`: {error}; \
+             rebuild the dependency with charon",
+            path.display()
+        )
+    })?;
+    let stale = || {
+        format!(
+            "promoted-MIR table {} was not written for the `{crate_name}` artifact rustc \
+             loaded (or by this charon driver version); rebuild the dependency with charon \
+             (e.g. `cargo clean` its target)",
+            path.display()
+        )
+    };
+    let malformed = || format!("malformed promoted-MIR table {}", path.display());
+    let rest = data.strip_prefix(TABLE_HEADER).ok_or_else(stale)?;
+    let read_u64 = |bytes: &[u8], at: usize| -> Result<u64, String> {
+        Ok(u64::from_le_bytes(
+            bytes
+                .get(at..at + 8)
+                .ok_or_else(malformed)?
+                .try_into()
+                .unwrap(),
+        ))
+    };
+    let svh = u128::from_le_bytes(rest.get(..16).ok_or_else(malformed)?.try_into().unwrap());
+    if svh != tcx.crate_hash(krate).as_u128() {
+        return Err(stale());
+    }
+    let count = read_u64(rest, 16)? as usize;
+    let entries_start = 24;
+    let entry_size = 32;
+    let blobs_start = TABLE_HEADER.len()
+        + entries_start
+        + count.checked_mul(entry_size).ok_or_else(malformed)?;
+    let mut index = FxHashMap::default();
+    for i in 0..count {
+        let at = entries_start + i * entry_size;
+        let key: [u8; 16] = rest.get(at..at + 16).ok_or_else(malformed)?.try_into().unwrap();
+        let offset = read_u64(rest, at + 16)? as usize;
+        let len = read_u64(rest, at + 24)? as usize;
+        let start = blobs_start.checked_add(offset).ok_or_else(malformed)?;
+        let end = start.checked_add(len).ok_or_else(malformed)?;
+        if end > data.len() || index.insert(key, (start, end)).is_some() {
+            return Err(malformed());
+        }
+    }
+    Ok(ExternalTable { path, data, index })
+}
+
+fn external_table(tcx: TyCtxt<'_>, krate: CrateNum) -> Result<Arc<ExternalTable>, String> {
+    if let Some(table) = EXTERNAL.lock().expect("promoted-MIR cache poisoned").get(&krate) {
+        return Ok(table.clone());
+    }
+    let table = Arc::new(read_table(tcx, krate)?);
+    EXTERNAL
+        .lock()
+        .expect("promoted-MIR cache poisoned")
+        .insert(krate, table.clone());
+    Ok(table)
+}
+
+/// Whether the crate is part of the standard library, which is not compiled by the driver: its
+/// only encoded MIR is the runtime MIR.
+pub fn is_sysroot_crate(tcx: TyCtxt<'_>, krate: CrateNum) -> bool {
+    let source = tcx.used_crate_source(krate);
+    let artifacts = [&source.rlib, &source.rmeta, &source.dylib];
+    let sysroots = tcx.sess.opts.sysroot.all_paths().collect::<Vec<_>>();
+    artifacts.into_iter().flatten().any(|artifact| {
+        sysroots.iter().any(|sysroot| {
+            artifact.starts_with(sysroot)
+                || std::fs::canonicalize(sysroot)
+                    .is_ok_and(|sysroot| artifact.starts_with(sysroot))
+        })
+    })
+}
+
+/// The promoted MIR exported when the external crate defining `def_id` was compiled.
+pub fn lookup_external<'tcx>(tcx: TyCtxt<'tcx>, def_id: DefId) -> Result<PromotedMir<'tcx>, String> {
+    assert!(!def_id.is_local());
+    let table = external_table(tcx, def_id.krate)?;
+    let key = tcx.def_path_hash(def_id).0.to_le_bytes();
+    let &(start, end) = table.index.get(&key).ok_or_else(|| {
+        format!(
+            "external body {def_id:?} has no exported promoted MIR in {}; \
+             its crate must be compiled by the charon driver",
+            table.path.display()
+        )
+    })?;
+    decode(tcx, &table.data[start..end])
+        .map_err(|error| format!("{error} (promoted MIR of {def_id:?} in {})", table.path.display()))
+}
+
+// Encoding.
+
+const SPAN_DUMMY: u8 = 0;
+const SPAN_FILE: u8 = 1;
+
+struct MirEncoder<'tcx> {
+    tcx: TyCtxt<'tcx>,
+    buf: Vec<u8>,
+    type_shorthands: FxHashMap<Ty<'tcx>, usize>,
+    predicate_shorthands: FxHashMap<ty::PredicateKind<'tcx>, usize>,
+    allocs: FxIndexSet<AllocId>,
+    files: FxHashMap<*const SourceFile, (StableCrateId, StableSourceFileId)>,
+}
+
+fn encode<'tcx>(
+    tcx: TyCtxt<'tcx>,
+    body: &Body<'tcx>,
+    promoted: &IndexVec<Promoted, Body<'tcx>>,
+) -> Vec<u8> {
+    let mut e = MirEncoder {
+        tcx,
+        buf: Vec::new(),
+        type_shorthands: Default::default(),
+        predicate_shorthands: Default::default(),
+        allocs: Default::default(),
+        files: Default::default(),
+    };
+    body.encode(&mut e);
+    promoted.encode(&mut e);
+    // The allocations the bodies refer to, which may refer to further allocations.
+    let mut offsets: Vec<u64> = Vec::new();
+    while offsets.len() < e.allocs.len() {
+        let alloc_id = e.allocs[offsets.len()];
+        offsets.push(e.buf.len() as u64);
+        specialized_encode_alloc_id(&mut e, tcx, alloc_id);
+    }
+    let offsets_pos = e.buf.len() as u64;
+    offsets.encode(&mut e);
+    e.buf.extend_from_slice(&offsets_pos.to_le_bytes());
+    e.buf.extend_from_slice(MAGIC_END_BYTES);
+    e.buf
+}
+
+impl<'tcx> MirEncoder<'tcx> {
+    /// The identity of a source file as dependents see it: crate metadata exports local files
+    /// with an id that incorporates the exporting crate (see `encode_source_map` in
+    /// `rustc_metadata`); imported files already carry it.
+    fn file_id(&mut self, file: &Arc<SourceFile>) -> (StableCrateId, StableSourceFileId) {
+        let tcx = self.tcx;
+        *self.files.entry(Arc::as_ptr(file)).or_insert_with(|| {
+            let krate = tcx.stable_crate_id(file.cnum);
+            if file.cnum == LOCAL_CRATE {
+                let mut name = file.name.clone();
+                if let FileName::Real(real) = &mut name {
+                    real.update_for_crate_metadata();
+                }
+                (krate, StableSourceFileId::from_filename_for_export(&name, krate))
+            } else {
+                (krate, file.stable_id)
+            }
+        })
+    }
+}
+
+macro_rules! emit_leb128 {
+    ($($name:ident($ty:ty) => $write:ident;)*) => {
+        $(
+            #[inline]
+            fn $name(&mut self, value: $ty) {
+                let mut out = [0u8; leb128::max_leb128_len::<$ty>()];
+                let len = leb128::$write(&mut out, value);
+                self.buf.extend_from_slice(&out[..len]);
+            }
+        )*
+    };
+}
+
+impl Encoder for MirEncoder<'_> {
+    emit_leb128! {
+        emit_usize(usize) => write_usize_leb128;
+        emit_u128(u128) => write_u128_leb128;
+        emit_u64(u64) => write_u64_leb128;
+        emit_u32(u32) => write_u32_leb128;
+        emit_isize(isize) => write_isize_leb128;
+        emit_i128(i128) => write_i128_leb128;
+        emit_i64(i64) => write_i64_leb128;
+        emit_i32(i32) => write_i32_leb128;
+    }
+
+    fn emit_u16(&mut self, value: u16) {
+        self.buf.extend_from_slice(&value.to_le_bytes());
+    }
+
+    fn emit_u8(&mut self, value: u8) {
+        self.buf.push(value);
+    }
+
+    fn emit_i16(&mut self, value: i16) {
+        self.buf.extend_from_slice(&value.to_le_bytes());
+    }
+
+    fn emit_raw_bytes(&mut self, bytes: &[u8]) {
+        self.buf.extend_from_slice(bytes);
+    }
+}
+
+impl SpanEncoder for MirEncoder<'_> {
+    fn encode_span(&mut self, span: Span) {
+        let data = span.data_untracked();
+        if data.is_dummy() {
+            return self.emit_u8(SPAN_DUMMY);
+        }
+        let file = self.tcx.sess.source_map().lookup_source_file(data.lo);
+        let (krate, file_id) = self.file_id(&file);
+        self.emit_u8(SPAN_FILE);
+        krate.encode(self);
+        file_id.encode(self);
+        self.emit_u32(data.lo.0 - file.start_pos.0);
+        self.emit_u32(data.hi.0 - data.lo.0);
+    }
+
+    fn encode_symbol(&mut self, sym: Symbol) {
+        self.emit_str(sym.as_str());
+    }
+
+    fn encode_byte_symbol(&mut self, byte_sym: ByteSymbol) {
+        self.emit_byte_str(byte_sym.as_byte_str());
+    }
+
+    fn encode_expn_id(&mut self, _expn_id: ExpnId) {
+        panic!("promoted-MIR tables do not encode macro expansions")
+    }
+
+    fn encode_syntax_context(&mut self, _syntax_context: SyntaxContext) {
+        // Spans are encoded without their hygiene data; see the module documentation.
+    }
+
+    fn encode_crate_num(&mut self, crate_num: CrateNum) {
+        self.tcx.stable_crate_id(crate_num).encode(self);
+    }
+
+    fn encode_def_index(&mut self, _def_index: DefIndex) {
+        panic!("encoding a `DefIndex` without its crate")
+    }
+
+    fn encode_def_id(&mut self, def_id: DefId) {
+        self.tcx.def_path_hash(def_id).encode(self);
+    }
+}
+
+impl<'tcx> TyEncoder<'tcx> for MirEncoder<'tcx> {
+    const CLEAR_CROSS_CRATE: bool = true;
+
+    fn position(&self) -> usize {
+        self.buf.len()
+    }
+
+    fn type_shorthands(&mut self) -> &mut FxHashMap<Ty<'tcx>, usize> {
+        &mut self.type_shorthands
+    }
+
+    fn predicate_shorthands(&mut self) -> &mut FxHashMap<ty::PredicateKind<'tcx>, usize> {
+        &mut self.predicate_shorthands
+    }
+
+    fn encode_alloc_id(&mut self, alloc_id: &AllocId) {
+        let (index, _) = self.allocs.insert_full(*alloc_id);
+        self.emit_u32(index as u32);
+    }
+}
+
+// Decoding.
+
+struct MirDecoder<'a, 'tcx> {
+    tcx: TyCtxt<'tcx>,
+    opaque: MemDecoder<'a>,
+    allocs: &'a AllocDecodingState,
+    type_cache: FxHashMap<usize, Ty<'tcx>>,
+    files: FxHashMap<(StableCrateId, StableSourceFileId), Arc<SourceFile>>,
+}
+
+fn decode<'tcx>(tcx: TyCtxt<'tcx>, data: &[u8]) -> Result<PromotedMir<'tcx>, String> {
+    let malformed = || "malformed promoted-MIR entry".to_string();
+    let payload = data.strip_suffix(MAGIC_END_BYTES).ok_or_else(malformed)?;
+    let footer = payload.len().checked_sub(8).ok_or_else(malformed)?;
+    let offsets_pos = u64::from_le_bytes(payload[footer..].try_into().unwrap()) as usize;
+    if offsets_pos > footer {
+        return Err(malformed());
+    }
+    let mut opaque = MemDecoder::new(data, offsets_pos).map_err(|()| malformed())?;
+    let offsets = Vec::<u64>::decode(&mut opaque);
+    let allocs = AllocDecodingState::new(offsets);
+    let mut d = MirDecoder {
+        tcx,
+        opaque: MemDecoder::new(data, 0).map_err(|()| malformed())?,
+        allocs: &allocs,
+        type_cache: Default::default(),
+        files: Default::default(),
+    };
+    let body = Body::decode(&mut d);
+    let promoted = IndexVec::<Promoted, Body<'tcx>>::decode(&mut d);
+    Ok((body, promoted))
+}
+
+impl<'a, 'tcx> MirDecoder<'a, 'tcx> {
+    fn source_file(&mut self, krate: StableCrateId, file: StableSourceFileId) -> Arc<SourceFile> {
+        let tcx = self.tcx;
+        self.files
+            .entry((krate, file))
+            .or_insert_with(|| {
+                let cnum = tcx.stable_crate_id_to_crate_num(krate);
+                if cnum != LOCAL_CRATE {
+                    // Make sure the source files of that crate are in the source map.
+                    tcx.import_source_files(cnum);
+                }
+                tcx.sess
+                    .source_map()
+                    .source_file_by_stable_id(file)
+                    .unwrap_or_else(|| {
+                        panic!(
+                            "source file {file:?} of crate `{}` is not in the source map",
+                            tcx.crate_name(cnum)
+                        )
+                    })
+            })
+            .clone()
+    }
+}
+
+rustc_middle::implement_ty_decoder!(MirDecoder<'a, 'tcx>);
+
+impl<'tcx> TyDecoder<'tcx> for MirDecoder<'_, 'tcx> {
+    const CLEAR_CROSS_CRATE: bool = true;
+
+    fn interner(&self) -> TyCtxt<'tcx> {
+        self.tcx
+    }
+
+    fn cached_ty_for_shorthand<F>(&mut self, shorthand: usize, or_insert_with: F) -> Ty<'tcx>
+    where
+        F: FnOnce(&mut Self) -> Ty<'tcx>,
+    {
+        if let Some(&ty) = self.type_cache.get(&shorthand) {
+            return ty;
+        }
+        let ty = or_insert_with(self);
+        self.type_cache.insert(shorthand, ty);
+        ty
+    }
+
+    fn with_position<F, R>(&mut self, pos: usize, f: F) -> R
+    where
+        F: FnOnce(&mut Self) -> R,
+    {
+        let new_opaque = self.opaque.split_at(pos);
+        let old_opaque = std::mem::replace(&mut self.opaque, new_opaque);
+        let result = f(self);
+        self.opaque = old_opaque;
+        result
+    }
+
+    fn decode_alloc_id(&mut self) -> AllocId {
+        let session = self.allocs.new_decoding_session();
+        session.decode_alloc_id(self)
+    }
+}
+
+impl SpanDecoder for MirDecoder<'_, '_> {
+    fn decode_span(&mut self) -> Span {
+        match self.read_u8() {
+            SPAN_DUMMY => rustc_span::DUMMY_SP,
+            SPAN_FILE => {
+                let krate = StableCrateId::decode(self);
+                let file_id = StableSourceFileId::decode(self);
+                let lo = self.read_u32();
+                let len = self.read_u32();
+                let file = self.source_file(krate, file_id);
+                let lo = BytePos(file.start_pos.0 + lo);
+                Span::with_root_ctxt(lo, BytePos(lo.0 + len))
+            }
+            tag => panic!("malformed promoted-MIR span tag {tag}"),
+        }
+    }
+
+    fn decode_expn_id(&mut self) -> ExpnId {
+        panic!("promoted-MIR tables do not encode macro expansions")
+    }
+
+    fn decode_syntax_context(&mut self) -> SyntaxContext {
+        SyntaxContext::root()
+    }
+
+    fn decode_crate_num(&mut self) -> CrateNum {
+        let stable_id = StableCrateId::decode(self);
+        self.tcx.stable_crate_id_to_crate_num(stable_id)
+    }
+
+    fn decode_def_id(&mut self) -> DefId {
+        let hash = DefPathHash::decode(self);
+        self.tcx
+            .def_path_hash_to_def_id(hash)
+            .unwrap_or_else(|| panic!("unknown definition path hash {hash:?} in promoted MIR"))
+    }
+
+    fn decode_attr_id(&mut self) -> AttrId {
+        panic!("promoted-MIR tables do not encode attributes")
+    }
+}
+
+impl BlobDecoder for MirDecoder<'_, '_> {
+    fn decode_symbol(&mut self) -> Symbol {
+        Symbol::intern(self.read_str())
+    }
+
+    fn decode_byte_symbol(&mut self) -> ByteSymbol {
+        ByteSymbol::intern(self.read_byte_str())
+    }
+
+    fn decode_def_index(&mut self) -> DefIndex {
+        panic!("decoding a `DefIndex` without its crate")
+    }
+}
