--- /dev/null
+++ b/tests/ui/lift-assoc-types-signature-regions.rs
@@ -0,0 +1,46 @@
+//@ charon-arg=--lift-associated-types=*
+// The lifted associated types of an ADT in a signature keep the lifetimes of the ADT arguments.
+// The trait references of signatures are resolved with erased lifetimes, so the associated types
+// computed from the impls they name used to be `&'_ u64` and `Values<'_>` below (the
+// `FlatMap<option::Iter<'a, _>, btree_map::Values<'a, _, _>, _>` returned by
+// `chelis_deep::annotations::Metadata::values`), which Aeneas rejects.
+pub trait Seq {
+    type Item;
+}
+pub struct Values<'a>(pub &'a u64);
+impl<'a> Seq for Values<'a> {
+    type Item = &'a u64;
+}
+
+pub trait IntoSeq {
+    type Item;
+    type IntoSeq: Seq<Item = Self::Item>;
+}
+impl<I: Seq> IntoSeq for I {
+    type Item = I::Item;
+    type IntoSeq = I;
+}
+
+pub struct Flat<U: Seq> {
+    pub item: Option<U::Item>,
+}
+
+pub struct FlatMap<U: IntoSeq> {
+    pub front: Option<U::IntoSeq>,
+    pub item: Option<U::Item>,
+}
+
+pub fn flat<'a>(v: Values<'a>) -> Flat<Values<'a>> {
+    Flat { item: Some(v.0) }
+}
+
+pub fn flat_map<'a>(v: Values<'a>) -> FlatMap<Values<'a>> {
+    FlatMap {
+        item: Some(v.0),
+        front: Some(v),
+    }
+}
+
+pub struct Holder<'a> {
+    pub inner: FlatMap<Values<'a>>,
+}
