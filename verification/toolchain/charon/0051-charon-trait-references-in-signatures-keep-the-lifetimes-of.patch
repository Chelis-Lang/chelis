+/// The trait clauses of the items and the headers of the impls, as translated (before this pass
+/// adds parameters to them).
+///
+/// Trait references are resolved on predicates whose lifetimes are erased (hax's
+/// `solve_item_traits_inner`). In a body, these lifetimes are later unified with those of the
+/// surrounding types, but outside bodies a trait reference keeps erased lifetimes in the
+/// predicate it proves and in the arguments of the impl it names, even where the arguments of
+/// the item that requires the clause carry them. For example, the return type
+/// `FlatMap<Iter<'a, X>, Values<'a, K, V>, F>` of a signature proves `U: IntoIterator` with
+/// `{impl IntoIterator for I}<Values<'_, K, V>>`, so the associated types we compute from that
+/// impl (`Item = &'_ V`, `IntoIter = Values<'_, K, V>`) would lose the lifetime they borrow from;
+/// and a closure type `closure<'a, T>[@TraitClause0]` in a signature proves its clause
+/// `T: FnMut(&'a X)` with the predicate `T: FnMut(&'_ X)`. `refine_args` recovers these
+/// lifetimes from the clauses of the item, instantiated with its arguments.
+#[derive(Default)]
+struct PristineClauses {
+    /// The trait clauses of each item which has some.
+    clauses: HashMap<ItemId, IndexVec<TraitClauseId, PolyTraitDeclRef>>,
+    /// The implemented trait of each impl, in terms of the impl parameters.
+    impl_headers: HashMap<TraitImplId, TraitDeclRef>,
+}
+
+impl PristineClauses {
+    /// Bound on the depth of the impl references we refine.
+    const MAX_DEPTH: usize = 32;
+
+    fn new(krate: &TranslatedCrate) -> Self {
+        let mut this = Self::default();
+        for (id, item) in krate.all_items_with_ids() {
+            let clauses = &item.generic_params().trait_clauses;
+            if !clauses.is_empty() {
+                this.clauses
+                    .insert(id, clauses.map_ref(|clause| clause.trait_.clone()));
+            }
+            if let ItemRef::TraitImpl(timpl) = item {
+                this.impl_headers
+                    .insert(timpl.def_id, timpl.impl_trait.clone());
+            }
+        }
+        this
+    }
+
+    /// Replace the erased lifetimes of the trait references in `args`, which instantiate `item`,
+    /// by those of the clauses they prove, instantiated with `args` (see `refine_trait_ref`).
+    fn refine_args(&self, item: ItemId, args: &mut GenericArgs) {
+        // Cheap check first: in bodies, the lifetimes are already there.
+        if !args.trait_refs.iter().any(|tref| has_erased_regions(tref)) {
+            return;
+        }
+        let Some(clauses) = self.clauses.get(&item) else {
+            return;
+        };
+        for (clause_id, clause) in clauses.iter_enumerated() {
+            let Some(tref) = args.trait_refs.get(clause_id) else {
+                continue;
+            };
+            if !has_erased_regions(tref) {
+                continue;
+            }
+            let Ok(expected) = clause.clone().try_substitute(args) else {
+                continue;
+            };
+            if let Some(tref) = self.refine_trait_ref(tref, &expected, Self::MAX_DEPTH) {
+                args.trait_refs[clause_id] = tref;
+            }
+        }
+    }
+
+    /// `tref`, which proves `expected`, with the erased lifetimes of the predicate it proves
+    /// replaced by those of `expected`, and those of the arguments of the impl it names by the
+    /// lifetimes that matching the impl header against `expected` assigns to the impl parameters
+    /// (recursively for the trait references proving the clauses of that impl). Other lifetimes
+    /// are kept. `None` when nothing changes.
+    fn refine_trait_ref(
+        &self,
+        tref: &TraitRef,
+        expected: &PolyTraitDeclRef,
+        depth: usize,
+    ) -> Option<TraitRef> {
+        if depth == 0 {
+            return None;
+        }
+        let mut trait_decl_ref = tref.trait_decl_ref.clone();
+        if trait_decl_ref.skip_binder.id == expected.skip_binder.id
+            && trait_decl_ref.regions.len() == expected.regions.len()
+        {
+            trait_decl_ref.skip_binder.generics = Box::new(fill_erased_regions_in_args(
+                &trait_decl_ref.skip_binder.generics,
+                &expected.skip_binder.generics,
+            ));
+        }
+        let kind = match &tref.kind {
+            TraitRefKind::TraitImpl(impl_ref) => TraitRefKind::TraitImpl(
+                self.refine_impl_ref(impl_ref, &expected.clone().erase(), depth)
+                    .unwrap_or_else(|| impl_ref.clone()),
+            ),
+            kind => kind.clone(),
+        };
+        let refined = TraitRef::new(kind, trait_decl_ref);
+        (refined != *tref).then_some(refined)
+    }
+
+    /// `impl_ref`, which proves `expected`, with the erased lifetimes of its arguments refined
+    /// (see `refine_trait_ref`). `None` when nothing changes.
+    fn refine_impl_ref(
+        &self,
+        impl_ref: &TraitImplRef,
+        expected: &TraitDeclRef,
+        depth: usize,
+    ) -> Option<TraitImplRef> {
+        if !has_erased_regions(&*impl_ref.generics) {
+            return None;
+        }
+        let header = self.impl_headers.get(&impl_ref.id)?;
+        if header.id != expected.id {
+            return None;
+        }
+        let mut bindings = HeaderBindings::default();
+        bindings.match_args(&header.generics, &expected.generics);
+        let mut generics = (*impl_ref.generics).clone();
+        for (id, region) in generics.regions.iter_mut_enumerated() {
+            if region.is_erased()
+                && let Some(bound) = bindings.regions.get(&id)
+            {
+                *region = bound.clone();
+            }
+        }
+        for (id, ty) in generics.types.iter_mut_enumerated() {
+            if let Some(bound) = bindings.types.get(&id) {
+                *ty = fill_erased_regions(ty, bound);
+            }
+        }
+        // The clauses of the impl, instantiated with its refined arguments.
+        if let Some(clauses) = self.clauses.get(&ItemId::TraitImpl(impl_ref.id)) {
+            for (clause_id, clause) in clauses.iter_enumerated() {
+                let Some(nested) = generics.trait_refs.get(clause_id) else {
+                    continue;
+                };
+                if !has_erased_regions(nested) {
+                    continue;
+                }
+                let Ok(expected) = clause.clone().try_substitute(&generics) else {
+                    continue;
+                };
+                if let Some(nested) = self.refine_trait_ref(nested, &expected, depth - 1) {
+                    generics.trait_refs[clause_id] = nested;
+                }
+            }
+        }
+        (generics != *impl_ref.generics).then(|| TraitImplRef {
+            id: impl_ref.id,
+            generics: Box::new(generics),
+        })
+    }
+}
+
+fn has_erased_regions(x: &impl AstVisitable) -> bool {
+    let mut found = false;
+    x.dyn_visit(|region: &Region| found |= region.is_erased());
+    found
+}
+
+/// The parameters of an impl (at binder depth zero in its header) bound by matching the header
+/// against a trait predicate. We don't go under binders.
+#[derive(Default)]
+struct HeaderBindings {
+    regions: HashMap<RegionId, Region>,
+    types: HashMap<TypeVarId, Ty>,
+}
+
+impl HeaderBindings {
+    fn match_region(&mut self, pat: &Region, target: &Region) {
+        if let Region::Var(DeBruijnVar::Bound(dbid, id)) = pat
+            && *dbid == DeBruijnId::zero()
+            && !target.is_erased()
+        {
+            self.regions.entry(*id).or_insert_with(|| target.clone());
+        }
+    }
+
+    fn match_ty(&mut self, pat: &Ty, target: &Ty) {
+        match (pat.kind(), target.kind()) {
+            (TyKind::TypeVar(DeBruijnVar::Bound(dbid, id)), _) if *dbid == DeBruijnId::zero() => {
+                self.types.entry(*id).or_insert_with(|| target.clone());
+            }
+            (TyKind::Adt(pat), TyKind::Adt(target)) if pat.id == target.id => {
+                self.match_args(&pat.generics, &target.generics)
+            }
+            (TyKind::Ref(pat_region, pat, pat_kind), TyKind::Ref(region, target, kind))
+                if pat_kind == kind =>
+            {
+                self.match_region(pat_region, region);
+                self.match_ty(pat, target);
+            }
+            (TyKind::RawPtr(pat, pat_kind), TyKind::RawPtr(target, kind)) if pat_kind == kind => {
+                self.match_ty(pat, target)
+            }
+            (TyKind::Array(pat, _), TyKind::Array(target, _))
+            | (TyKind::Slice(pat), TyKind::Slice(target)) => self.match_ty(pat, target),
+            _ => {}
+        }
+    }
+
+    fn match_args(&mut self, pat: &GenericArgs, target: &GenericArgs) {
+        for (pat, target) in pat.regions.iter().zip(target.regions.iter()) {
+            self.match_region(pat, target);
+        }
+        for (pat, target) in pat.types.iter().zip(target.types.iter()) {
+            self.match_ty(pat, target);
+        }
+    }
+}
+
+/// `ty` with its erased lifetimes replaced by those at the same positions in `from`, a type equal
+/// to `ty` up to lifetimes. Other lifetimes, and the parts where the two types differ, are kept.
+fn fill_erased_regions(ty: &Ty, from: &Ty) -> Ty {
+    let kind = match (ty.kind(), from.kind()) {
+        (TyKind::Adt(tref), TyKind::Adt(from)) if tref.id == from.id => TyKind::Adt(TypeDeclRef {
+            id: tref.id,
+            generics: Box::new(fill_erased_regions_in_args(&tref.generics, &from.generics)),
+        }),
+        (TyKind::Ref(region, ty, kind), TyKind::Ref(from_region, from, from_kind))
+            if kind == from_kind =>
+        {
+            let region = if region.is_erased() {
+                from_region.clone()
+            } else {
+                region.clone()
+            };
+            TyKind::Ref(region, fill_erased_regions(ty, from), *kind)
+        }
+        (TyKind::RawPtr(ty, kind), TyKind::RawPtr(from, from_kind)) if kind == from_kind => {
+            TyKind::RawPtr(fill_erased_regions(ty, from), *kind)
+        }
+        (TyKind::Array(ty, len), TyKind::Array(from, _)) => {
+            TyKind::Array(fill_erased_regions(ty, from), len.clone())
+        }
+        (TyKind::Slice(ty), TyKind::Slice(from)) => TyKind::Slice(fill_erased_regions(ty, from)),
+        _ => return ty.clone(),
+    };
+    kind.into_ty()
+}
+
+fn fill_erased_regions_in_args(args: &GenericArgs, from: &GenericArgs) -> GenericArgs {
+    let mut args = args.clone();
+    for (region, from) in args.regions.iter_mut().zip(from.regions.iter()) {
+        if region.is_erased() {
+            *region = from.clone();
+        }
+    }
+    for (ty, from) in args.types.iter_mut().zip(from.types.iter()) {
+        *ty = fill_erased_regions(ty, from);
+    }
+    args
+}
