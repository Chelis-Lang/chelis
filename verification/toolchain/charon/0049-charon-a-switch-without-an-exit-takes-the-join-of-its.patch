+    /// Pick the exit of the switch `bid`, given the exits of the outer switches.
+    fn compute_switch_exit(
+        cfg: &CfgInfo,
+        exits_set: &HashSet<BlockId>,
+        bid: BlockId,
+    ) -> Option<BlockId> {
+        let block_data = &cfg.block_data[bid];
+        // Find the best successor: this is the node with the highest flow, and the lowest
+        // topological rank. If several nodes have the same flow, we want to take the highest
+        // one in the hierarchy: hence the use of the topological rank.
+        //
+        // Ex.:
+        // ```text
+        // A  -- we start here
+        // |
+        // |---------------------------------------
+        // |            |            |            |
+        // B:(0.25,-1)  C:(0.25,-2)  D:(0.25,-3)  E:(0.25,-4)
+        // |            |            |
+        // |--------------------------
+        // |
+        // F:(0.75,-5)
+        // |
+        // |
+        // G:(0.75,-6)
+        // ```
+        // The "best" node (with the highest (flow, rank) in the graph above is F.
+        // If the switch is inside a loop, we also only consider exists that are inside that
+        // same loop. There must be one, otherwise the switch entry would not be inside the
+        // loop.
+        let current_loop = block_data.within_loops.last().copied();
+        let candidates = || {
+            block_data.reachable_excluding_self().filter(move |&b| {
+                current_loop.is_none_or(|current_loop| cfg.is_within_loop(current_loop, b))
+            })
+        };
+        let rank = |id: BlockId| {
+            let flow = &block_data.flow[id];
+            let rank = Reverse(cfg.topo_rank(id));
+            ((flow, rank), id)
+        };
+        let best_exit: Option<BlockId> = candidates().max_by_key(|&id| rank(id));
+        // We have an exit candidate: we first check that it was not already taken by an
+        // external switch.
+        //
+        // We then check that we can't reach the exit of an external switch from one of the
+        // branches, without going through the exit candidate. We do this by simply checking
+        // that we can't reach any of the exits of outer switches.
+        //
+        // The reason is that it can lead to code like the following:
+        // ```
+        // if ... { // if #1
+        //   if ... { // if #2
+        //     ...
+        //     // here, we have a `goto b1`, where b1 is the exit
+        //     // of if #2: we thus stop translating the blocks.
+        //   }
+        //   else {
+        //     ...
+        //     // here, we have a `goto b2`, where b2 is the exit
+        //     // of if #1: we thus stop translating the blocks.
+        //   }
+        //   // We insert code for the block b1 here (which is the exit of
+        //   // the exit of if #2). However, this block should only
+        //   // be executed in the branch "then" of the if #2, not in
+        //   // the branch "else".
+        //   ...
+        // }
+        // else {
+        //   ...
+        // }
+        // ```
+        let exit = best_exit.filter(|&exit_id| {
+            !exits_set.contains(&exit_id)
+                && cfg.all_paths_go_through(bid, exit_id, None, |b| exits_set.contains(&b))
+        });
+        if exit.is_some() {
+            return exit;
+        }
+
+        // Without an exit, a block where several branches join is translated once per path
+        // reaching it, and so is everything after it. With early returns this happens a lot: after
+        // a `?`, whose switch takes the cleanup of the early returns as its exit, a later switch
+        // whose branches may return early reaches that exit without going through its own join,
+        // and fails the check above.
+        // In this case we use the best join of the branches as exit if the paths that avoid it
+        // reach no exit of an outer switch other than a cleanup before a `return` or a `continue`,
+        // and if the code after the join, of which each path reaching it gets a copy otherwise, is
+        // larger than that cleanup, of which each such path gets a copy instead.
+        // We only follow the paths that stay inside the current loop: a path that leaves it
+        // becomes a `break` or a `continue`, or the code it reaches is copied in place, with or
+        // without an exit for this switch.
+        let is_cleanup = |b: BlockId| cfg.block_data[b].exit_cleanup_size.is_some();
+        let branches = cfg.fwd_cfg.neighbors(bid).collect_vec();
+        let join = candidates()
+            .filter(|&b| {
+                let data = &cfg.block_data[b];
+                !is_cleanup(b)
+                    && !data.only_reach_error
+                    && !exits_set.contains(&b)
+                    && branches
+                        .iter()
+                        .filter(|&&branch| cfg.block_data[branch].shortest_paths.contains_key(&b))
+                        .count()
+                        >= 2
+            })
+            .max_by_key(|&id| rank(id))?;
+        let mut copied_cleanup = 0;
+        let reaches_other_exit = !cfg.all_paths_go_through(bid, join, current_loop, |b| {
+            if !exits_set.contains(&b) {
+                return false;
+            }
+            match cfg.block_data[b].exit_cleanup_size {
+                Some(size) => {
+                    copied_cleanup = copied_cleanup.max(size);
+                    false
+                }
+                None => true,
+            }
+        });
+        if reaches_other_exit {
+            return None;
+        }
+        let mut join_size = 0;
+        for b in cfg.block_data[join].reachable_including_self() {
+            if !is_cleanup(b)
+                && current_loop.is_none_or(|current_loop| cfg.is_within_loop(current_loop, b))
+            {
+                join_size += cfg.block_data[b].size;
+                if join_size > copied_cleanup {
+                    return Some(join);
+                }
+            }
+        }
+        None
+    }
 }
 
