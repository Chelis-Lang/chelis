diff --git a/tests/ui/control-flow/switch-exits-after-early-return.rs b/tests/ui/control-flow/switch-exits-after-early-return.rs
new file mode 100644
index 0000000..9ab4e3d
--- /dev/null
+++ b/tests/ui/control-flow/switch-exits-after-early-return.rs
@@ -0,0 +1,103 @@
+//! Early returns (`?`) must not keep later switches from getting an exit: without one,
+//! everything after the join of their branches is copied into every branch. Each function below
+//! calls `tail` once in the source and must call it once in the LLBC.
+pub enum Op {
+    A,
+    B,
+    C,
+    D,
+}
+
+pub enum Step {
+    Run(Op),
+    Control(u32),
+}
+
+fn g(x: u32) -> Result<u32, String> {
+    if x > 100 { Err("big".to_string()) } else { Ok(x + 1) }
+}
+
+fn tail(x: u32) -> u32 {
+    x ^ 7
+}
+
+/// The `?` before the loop takes the cleanup of the early returns as exit; the match in the loop
+/// may return early too.
+pub fn try_before_loop(ops: &[Op]) -> Result<u32, String> {
+    let mut acc = g(0)?;
+    for op in ops {
+        let v = match op {
+            Op::A => g(1)?,
+            Op::B => g(2)?,
+            Op::C => g(3)?,
+            Op::D => g(4)?,
+        };
+        acc += tail(v);
+    }
+    Ok(acc)
+}
+
+/// Nested switches that may return early inside the loop (their copies multiplied).
+pub fn try_before_loop_nested(ops: &[Op], c: bool, d: bool) -> Result<u32, String> {
+    let mut acc = g(0)?;
+    for op in ops {
+        let w = if d { g(9)? } else { 20 };
+        let v = match op {
+            Op::A => if c { g(1)? } else { 2 },
+            Op::B => if c { g(3)? } else { 4 },
+            Op::C => if c { g(5)? } else { 6 },
+            Op::D => if c { g(7)? } else { 8 },
+        };
+        acc += tail(v + w);
+    }
+    Ok(acc)
+}
+
+/// Without a loop: the match after a `?`.
+pub fn try_before_match(op: &Op) -> Result<u32, String> {
+    let a = g(0)?;
+    let v = match op {
+        Op::A => g(1)?,
+        Op::B => g(2)?,
+        Op::C => g(3)?,
+        Op::D => g(4)?,
+    };
+    Ok(tail(v + a))
+}
+
+/// A step dispatch whose other arm continues after a `?`, then an early `continue`: the cleanup
+/// before the `continue` is not the join of the branches.
+pub fn continue_after_try(steps: &[Step], live: Option<&[bool]>) -> Result<u32, String> {
+    let mut acc = g(0)?;
+    for (i, step) in steps.iter().enumerate() {
+        let op = match step {
+            Step::Run(op) => op,
+            Step::Control(c) => {
+                g(*c)?;
+                continue;
+            }
+        };
+        if let Some(mask) = live {
+            if !mask[i] {
+                continue;
+            }
+        }
+        let v = match op {
+            Op::A => g(1)?,
+            Op::B => g(2)?,
+            Op::C => g(3)?,
+            Op::D => g(4)?,
+        };
+        acc += tail(v);
+    }
+    Ok(acc)
+}
+
+/// Nothing is copied here; the `if` keeps its shape.
+pub fn early_return_in_if(x: u32, c: bool) -> Result<u32, String> {
+    let a = g(x)?;
+    if c {
+        return Err("c".to_string());
+    }
+    Ok(tail(a))
+}
