+
+/// Complete the `CHARON_COVERAGE_REPORT` written at translation time with what each start-from
+/// selection yields in the final output: `start_from` lists, per selection, the items it
+/// selected and whether each is declared (in `ordered_decls`).
+pub fn write_start_from_coverage(ctx: &TransformCtx) {
+    use charon_lib::pretty::FmtWithCtx;
+    use charon_lib::pretty::formatter::IntoFormatter;
+    let Some(path) = std::env::var_os("CHARON_COVERAGE_REPORT") else {
+        return;
+    };
+    let text = std::fs::read_to_string(&path).unwrap_or_else(|error| {
+        panic!(
+            "cannot read coverage report {}: {error}",
+            path.to_string_lossy()
+        )
+    });
+    let mut report: serde_json::Value = serde_json::from_str(&text).unwrap_or_else(|error| {
+        panic!(
+            "cannot parse coverage report {}: {error}",
+            path.to_string_lossy()
+        )
+    });
+    let declared: HashSet<ItemId> = ctx
+        .translated
+        .ordered_decls
+        .iter()
+        .flatten()
+        .flat_map(|group| group.get_ids())
+        .collect();
+    let fmt = ctx.into_fmt();
+    let selections = ctx
+        .start_from_roots
+        .iter()
+        .map(|selection| {
+            let items = selection
+                .items
+                .iter()
+                .map(|id| {
+                    serde_json::json!({
+                        "id": id.to_string(),
+                        "name": ctx
+                            .translated
+                            .item_name(*id)
+                            .map(|name| name.with_ctx(&fmt).to_string()),
+                        "declared": declared.contains(id),
+                    })
+                })
+                .collect_vec();
+            serde_json::json!({
+                "pattern": selection.label,
+                "strict": selection.strict,
+                "items": items,
+            })
+        })
+        .collect_vec();
+    report["start_from"] = selections.into();
+    let text = serde_json::to_string_pretty(&report).unwrap();
+    std::fs::write(&path, text).unwrap_or_else(|error| {
+        panic!(
+            "cannot write coverage report {}: {error}",
+            path.to_string_lossy()
+        )
+    });
+}
