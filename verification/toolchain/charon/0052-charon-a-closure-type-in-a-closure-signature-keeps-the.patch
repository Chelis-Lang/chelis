# charon integration step 52 after 546078ea5d: commit b947e944415f15a3a726b96a093e5560fb73ff0f
# first parent e0a15d7a06a89c3609e19e565de7ac3b841c0c13
# series charon: patch -p1 in charon/ of the upstream source
#
# charon: a closure type in a closure signature keeps the lifetimes of its captures
#
# A closure returning a closure it creates (`chelis_ir::adt::lookup_variant_terminal_unique`:
# `flat_map(|(adt, def)| def.variants.iter().filter_map(move |v| ..))`) has the type of the inner
# closure in its signature. hax gives the regions of that type (the regions of the inner closure's
# captured types) fresh signature regions, and the borrowck facts relate them to the other signature
# regions. But translate_closure_type_ref only put the capture regions of a closure type into its
# upvar region arguments while translating the captured types of the closure item being translated;
# elsewhere they stayed erased: `-> FilterMap<Iter<'_4, Variant>, closure<'_, '_>>`, which Aeneas
# rejects ("Expected a runtime region type").
#
# The capture regions of another closure's type are now used wherever rustc gives them a region;
# erased ones (in bodies, where lifetimes are unified later) leave the argument as before. The
# signature above is now `-> FilterMap<Iter<'_4, Variant>, closure<'_8, '_9>>` with `'_1 : '_8`
# (`ctor`, captured by the outer closure) and `'_2 : '_9` (the argument `adt`).
#
# Test: ui/closure-returns-closure (new; `closure<'_, '_>` before).
# Other UI outputs: simple/nested-closure and simple/nested-closure-lifetime, lifetimes only (19 lines):
# closure types returned by closures (and by `foo` in nested-closure-lifetime, `closure<'_, T>` becomes
# `closure<'a, T>`) get their signature lifetimes instead of `'_`; the return local of the generated
# `call_mut` shims takes that signature lifetime instead of a fresh body lifetime, which renumbers
# the other body lifetimes.

diff --git a/src/bin/charon-driver/translate/translate_closures.rs b/src/bin/charon-driver/translate/translate_closures.rs
index 4d156f6..1b7441a 100644
--- a/src/bin/charon-driver/translate/translate_closures.rs
+++ b/src/bin/charon-driver/translate/translate_closures.rs
@@ -145,23 +145,27 @@ impl ItemTransCtx<'_, '_> {
         closure: &hax::ClosureArgs,
     ) -> Result<TypeDeclRef, Error> {
         let mut tref: TypeDeclRef = self.translate_item(span, &closure.item, TransItemSourceKind::Type)?;
-        if self.outermost_binder().materialize_capture_tags
-            && &closure.item.def_id != self.item_src.def_id()
-        {
+        if &closure.item.def_id != self.item_src.def_id() {
             self.instantiate_captured_closure_regions(span, closure, &mut tref)?;
         }
         Ok(tref)
     }
 
-    /// A closure captured by the closure item being translated has a type whose upvar region
-    /// arguments `translate_item` leaves erased. Each of them corresponds to one of the captured
-    /// closure's capture occurrences, which rustc also lists in the captured type (its tupled
-    /// upvars, here carrying the capture tags of the closure being translated). Use those regions
-    /// so that the relations borrowck proved about them carry over. This requires the occurrences
-    /// of this instance to line up with those of the definition: instantiating a type parameter
-    /// with a type that has lifetimes inserts occurrences, and changes their number. Otherwise,
-    /// or for upvar regions without rustc occurrence, the argument stays erased: a fresh region
-    /// without relations (dropping relations is conservative; inventing them is not).
+    /// The type of another closure has upvar region arguments that `translate_item` leaves
+    /// erased. Each of them corresponds to one of that closure's capture occurrences, which rustc
+    /// also lists in the closure type (its tupled upvars). Where rustc gives the occurrence a
+    /// region, use it so that the relations borrowck proved about it carry over:
+    /// - in the captured types of the closure item being translated, the occurrences carry the
+    ///   capture tags of that closure;
+    /// - in a closure signature, e.g. of a closure returning a closure it creates, they are
+    ///   signature regions, like the other regions of the signature.
+    ///
+    /// In bodies they are erased (the body lifetimes are unified later). This requires the
+    /// occurrences of this instance to line up with those of the definition: instantiating a type
+    /// parameter with a type that has lifetimes inserts occurrences, and changes their number.
+    /// Otherwise, or for erased occurrences and upvar regions without rustc occurrence, the
+    /// argument stays as `translate_item` made it: a fresh region without relations (dropping
+    /// relations is conservative; inventing them is not).
     fn instantiate_captured_closure_regions(
         &mut self,
         span: Span,
@@ -185,6 +189,9 @@ impl ItemTransCtx<'_, '_> {
         for (param, occurrence) in params.occurrences.iter().enumerate() {
             if let Some(occurrence) = occurrence {
                 let region = &closure.capture_regions[*occurrence as usize];
+                if matches!(region.kind, hax::RegionKind::ReErased) {
+                    continue;
+                }
                 let region = self.translate_region(span, region)?;
                 tref.generics.regions[RegionId::new(start + param)] = region;
             }
