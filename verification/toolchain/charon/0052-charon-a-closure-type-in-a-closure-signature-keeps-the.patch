diff --git a/tests/ui/closure-returns-closure.rs b/tests/ui/closure-returns-closure.rs
new file mode 100644
index 0000000..50ff2c6
--- /dev/null
+++ b/tests/ui/closure-returns-closure.rs
@@ -0,0 +1,25 @@
+//@ no-default-options
+//@ charon-args=--preset=aeneas
+
+// A closure returning a closure it creates (as `chelis_ir::adt::lookup_variant_terminal_unique`).
+// In the signature of the outer closure's methods, the type of the returned closure keeps the
+// lifetimes of its captures (`ctor`, captured by the outer closure, and the argument `adt`),
+// related to the other signature lifetimes by outlives constraints. They used to be erased
+// (`closure<'_, '_>`), which Aeneas rejects.
+pub struct Variant {
+    name: u32,
+}
+
+pub struct Def {
+    variants: Vec<Variant>,
+}
+
+pub fn lookup_unique<'a>(defs: &'a [(u32, Def)], ctor: &u32) -> Option<(&'a u32, &'a Variant)> {
+    let mut matches = defs.iter().flat_map(|(adt, def)| {
+        def.variants
+            .iter()
+            .filter_map(move |variant| (variant.name == *ctor).then_some((adt, variant)))
+    });
+    let first = matches.next()?;
+    matches.next().is_none().then_some(first)
+}
