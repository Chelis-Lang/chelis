+use std::marker::PhantomData;
+pub trait Deserialize<'de>: Sized {
+    fn deserialize(tag: u32) -> Option<Self>;
+}
+pub trait Visitor<'de> {
+    type Value;
+    fn visit_enum(self, tag: u32) -> Option<Self::Value>;
+}
+pub enum Expr {
+    Unit,
+    Pair { left: u32, right: u32 },
+    Triple { a: u32, b: u32, c: u32 },
+}
+const _: () = {
+    impl<'de> Deserialize<'de> for Expr {
+        fn deserialize(tag: u32) -> Option<Self> {
+            enum __Field { Unit, Pair, Triple }
+            struct __Visitor<'de> { marker: PhantomData<&'de ()> }
+            impl<'de> Visitor<'de> for __Visitor<'de> {
+                type Value = Expr;
+                fn visit_enum(self, tag: u32) -> Option<Expr> {
+                    let field = match tag {
+                        0 => __Field::Unit,
+                        1 => __Field::Pair,
+                        2 => __Field::Triple,
+                        _ => return None,
+                    };
+                    match field {
+                        __Field::Unit => Some(Expr::Unit),
+                        __Field::Pair => {
+                            enum __Field { Left, Right }
+                            struct __Visitor<'de> { marker: PhantomData<&'de ()> }
+                            impl<'de> Visitor<'de> for __Visitor<'de> {
+                                type Value = Expr;
+                                fn visit_enum(self, tag: u32) -> Option<Expr> {
+                                    let _ = [__Field::Left, __Field::Right];
