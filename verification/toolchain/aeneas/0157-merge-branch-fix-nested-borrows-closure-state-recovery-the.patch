+import NestedBorrowsClosureOnceState.NestedBorrowsClosureOnceState
+
+/-! Evaluate the model of `tests/src/nested-borrows-closure-once-state.rs` on
+    the inputs of its `native` test module and compare with the native results
+    (the writes of the closure through the nested borrows of its captures). -/
+
+namespace nested_borrows_closure_once_state.checks
+open Aeneas Aeneas.Std Result
+open nested_borrows_closure_once_state
+
+def u (x : Nat) : U32 := ⟨BitVec.ofNat _ x⟩
+
+/-- `(result, depth, raised)` -/
+def runDrive (raised : Nat) (o : Option Nat) : Option (Option Nat × Nat × Nat) :=
+  match drive (u raised) (o.map u) with
+  | ok (r, d, rs) => some (r.map (·.val), d.val, rs.val)
+  | _ => none
+
+def runMap2 (n : Nat) (o : Option Nat) : Option (Option Nat × Nat) :=
+  match via_map2 (u n) (o.map u) with
+  | ok (r, c) => some (r.map (·.val), c.val)
+  | _ => none
+
+def runMap3 (n : Nat) (o : Option Nat) : Option (Option Nat × Nat) :=
+  match via_map3 (u n) (o.map u) with
+  | ok (r, c) => some (r.map (·.val), c.val)
+  | _ => none
+
+-- drive_native
+#guard runDrive 10 (some 5) == some (some 9, 4, 15)
+#guard runDrive 10 none == some (none, 3, 10)
+
+-- via_map_native
+#guard runMap2 10 (some 5) == some (some 11, 15)
+#guard runMap2 10 none == some (none, 10)
+#guard runMap3 10 (some 5) == some (some 14, 15)
+#guard runMap3 10 none == some (none, 10)
+
+end nested_borrows_closure_once_state.checks
