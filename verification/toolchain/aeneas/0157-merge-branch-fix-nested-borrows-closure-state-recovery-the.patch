+//@ [!lean] skip
+//@ [lean] subdir=NestedBorrowsClosureOnceState
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::option::{core::option::Option} --include core::ops::deref::{core::ops::deref::Deref} --include core::ops::deref::{core::ops::deref::DerefMut}
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! A closure consumed by `Option::map` (its `FnOnce` dictionary) which writes
+//! through the nested borrows of its captures (production: a context
+//! `&mut LowerCtx<'p>` holding `&'p mut` state, `o.map(|x| self.step(x))`).
+//! The `FnOnce` instance recovers the closure state from the backward functions
+//! of `call_once` (`ModelStateABI.adapt_dictionary_method`): the inputs at the
+//! levels > 0 of the backward function of the inner region are the payloads
+//! given back at the forward return, not the captures before the call (which
+//! would undo the writes of the closure through the inner borrows).
+
+pub struct Runtime {
+    pub raised: u32,
+}
+
+pub struct LowerCtx<'p> {
+    pub runtime: &'p mut Runtime,
+    pub depth: u32,
+}
+
+impl<'p> LowerCtx<'p> {
+    fn step(&mut self, x: u32) -> u32 {
+        self.runtime.raised = self.runtime.raised.wrapping_add(x);
+        self.depth = self.depth.wrapping_add(1);
+        x.wrapping_add(self.depth)
+    }
+
+    /// The closure captures `&mut LowerCtx<'p>` (two levels).
+    pub fn step_opt(&mut self, o: Option<u32>) -> Option<u32> {
+        o.map(|x| self.step(x))
+    }
+}
+
+/// `(result, depth, raised)`; the caller reads the context after the call
+pub fn drive(raised: u32, o: Option<u32>) -> (Option<u32>, u32, u32) {
+    let mut rt = Runtime { raised };
+    let (r, d) = {
+        let mut cx = LowerCtx { runtime: &mut rt, depth: 3 };
+        let r = cx.step_opt(o);
+        (r, cx.depth)
+    };
+    (r, d, rt.raised)
+}
+
+/// The closure consumed by `map` captures `&mut c`, which captures
+/// `&mut calls` (two levels).
+pub fn via_map2(n: u32, o: Option<u32>) -> (Option<u32>, u32) {
+    let mut calls = n;
+    let mut c = |x: u32| {
+        calls = calls.wrapping_add(x);
+        x.wrapping_mul(2)
+    };
+    let r = o.map(|x| c(x).wrapping_add(1));
+    (r, calls)
+}
+
+/// Three levels: the backward function of the innermost region is staged.
+pub fn via_map3(n: u32, o: Option<u32>) -> (Option<u32>, u32) {
+    let mut calls = n;
+    let mut c = |x: u32| {
+        calls = calls.wrapping_add(x);
+        x.wrapping_mul(2)
+    };
+    let mut w = |x: u32| c(x).wrapping_add(1);
+    let r = o.map(|x| w(x).wrapping_add(3));
+    (r, calls)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn drive_native() {
+        assert_eq!(drive(10, Some(5)), (Some(9), 4, 15));
+        assert_eq!(drive(10, None), (None, 3, 10));
+    }
+
+    #[test]
+    fn via_map_native() {
+        assert_eq!(via_map2(10, Some(5)), (Some(11), 15));
+        assert_eq!(via_map2(10, None), (None, 10));
+        assert_eq!(via_map3(10, Some(5)), (Some(14), 15));
+        assert_eq!(via_map3(10, None), (None, 10));
+    }
+}
