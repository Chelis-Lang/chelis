@@ -0,0 +1,164 @@
+//@ [!lean] skip
+//@ [lean] subdir=ExplicitImplParams
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Builtin trait impls passed as trait instances. Aeneas prints the type and
+//! const-generic arguments of an impl which no trait clause of the impl
+//! determines explicitly (`PureUtils.compute_explicit_info`), so the Lean
+//! definitions of the models must bind exactly those explicitly: `T` of
+//! `Deref`/`DerefMut for Vec<T>`, `N` of `Index`/`IndexMut for [T; N]`, `V`
+//! and `N` of `From<[(K, V); N]> for BTreeMap<K, V>`, `V` of
+//! `Extend<(K, V)>`/`Index<&Q> for BTreeMap<K, V>` (the shape of
+//! `Option<Vec<NonZero<usize>>>::as_deref` in `chelis_ir::eval`). The other
+//! functions exercise impls whose explicit parameters appear only in clauses
+//! the model drops (`keepTraitClauses`). `Extend` instances cannot be
+//! exercised: a generic `Extend` dictionary is rejected by the collection
+//! contracts (E_UNSUPPORTED_COLLECTION).
+
+use std::collections::{BTreeMap, BTreeSet};
+use std::ops::{Deref, DerefMut, Index, IndexMut};
+use std::rc::Rc;
+use std::sync::Arc;
+
+fn via_deref<D: Deref<Target = [u32]>>(d: &D) -> u32 {
+    let s = d.deref();
+    if s.is_empty() { 0 } else { s[0] + s.len() as u32 }
+}
+
+fn via_deref_mut<D: DerefMut<Target = [u32]>>(d: &mut D) {
+    let s = d.deref_mut();
+    if !s.is_empty() {
+        s[0] = s[0].wrapping_add(10);
+    }
+}
+
+fn via_index<C: Index<usize, Output = u32>>(c: &C, i: usize) -> u32 {
+    c[i]
+}
+
+fn via_index_mut<C: IndexMut<usize, Output = u32>>(c: &mut C, i: usize) {
+    c[i] = c[i].wrapping_mul(3);
+}
+
+fn via_from<T, U: From<T>>(t: T) -> U {
+    U::from(t)
+}
+
+fn via_index_key<'a, C: Index<&'a u32, Output = u32>>(c: &C, k: &'a u32) -> u32 {
+    c[k]
+}
+
+fn via_clone<C: Clone>(c: &C) -> C {
+    c.clone()
+}
+
+fn via_next<I: Iterator>(mut it: I) -> Option<I::Item> {
+    it.next()
+}
+
+fn via_into_iter<C: IntoIterator>(c: C) -> Option<C::Item> {
+    c.into_iter().next()
+}
+
+pub fn deref_vec(v: Vec<u32>) -> u32 {
+    via_deref(&v)
+}
+
+pub fn deref_mut_vec(mut v: Vec<u32>) -> Vec<u32> {
+    via_deref_mut(&mut v);
+    v
+}
+
+pub fn index_array(a: [u32; 4], i: usize) -> u32 {
+    via_index(&a, i)
+}
+
+pub fn index_mut_array(mut a: [u32; 3], i: usize) -> [u32; 3] {
+    via_index_mut(&mut a, i);
+    a
+}
+
+pub fn from_array(a: [(u32, u32); 3]) -> Vec<(u32, u32)> {
+    let m: BTreeMap<u32, u32> = via_from(a);
+    m.into_iter().collect()
+}
+
+pub fn index_map(m: BTreeMap<u32, u32>, k: u32) -> u32 {
+    via_index_key(&m, &k)
+}
+
+pub fn clone_arc(x: u32) -> u32 {
+    let a = Arc::new(x);
+    *via_clone(&a)
+}
+
+pub fn clone_rc(x: u32) -> u32 {
+    let a = Rc::new(x);
+    *via_clone(&a)
+}
+
+pub fn first_of_map(m: BTreeMap<u32, u32>) -> Option<(u32, u32)> {
+    via_into_iter(m)
+}
+
+pub fn next_of_map_iter(m: BTreeMap<u32, u32>) -> Option<(u32, u32)> {
+    via_next(m.into_iter())
+}
+
+pub fn next_of_values(m: BTreeMap<u32, u32>) -> Option<u32> {
+    via_next(m.into_values())
+}
+
+pub fn first_of_set(s: BTreeSet<u32>) -> Option<u32> {
+    via_into_iter(s)
+}
+
+pub fn next_of_set_iter(s: BTreeSet<u32>) -> Option<u32> {
+    via_next(s.into_iter())
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    fn map(kv: &[(u32, u32)]) -> BTreeMap<u32, u32> {
+        kv.iter().copied().collect()
+    }
+
+    #[test]
+    fn vec_deref() {
+        assert_eq!(deref_vec(vec![]), 0);
+        assert_eq!(deref_vec(vec![5, 1, 2]), 8);
+        assert_eq!(deref_mut_vec(vec![]), Vec::<u32>::new());
+        assert_eq!(deref_mut_vec(vec![5, 1]), vec![15, 1]);
+        assert_eq!(deref_mut_vec(vec![u32::MAX]), vec![9]);
+    }
+
+    #[test]
+    fn array_index() {
+        assert_eq!(index_array([4, 5, 6, 7], 0), 4);
+        assert_eq!(index_array([4, 5, 6, 7], 3), 7);
+        assert_eq!(index_mut_array([1, 2, 3], 1), [1, 6, 3]);
+        assert_eq!(index_mut_array([1, 2, 3], 2), [1, 2, 9]);
+    }
+
+    #[test]
+    fn btree_map() {
+        assert_eq!(from_array([(3, 30), (1, 10), (3, 31)]), vec![(1, 10), (3, 31)]);
+        assert_eq!(index_map(map(&[(1, 10), (2, 20)]), 2), 20);
+        assert_eq!(first_of_map(map(&[(2, 20), (1, 10)])), Some((1, 10)));
+        assert_eq!(first_of_map(map(&[])), None);
+        assert_eq!(next_of_map_iter(map(&[(5, 50), (4, 40)])), Some((4, 40)));
+        assert_eq!(next_of_values(map(&[(5, 50), (4, 40)])), Some(40));
+        assert_eq!(next_of_values(map(&[])), None);
+    }
+
+    #[test]
+    fn others() {
+        assert_eq!(clone_arc(7), 7);
+        assert_eq!(clone_rc(8), 8);
+        assert_eq!(first_of_set([3, 1, 2].into_iter().collect()), Some(1));
+        assert_eq!(first_of_set(BTreeSet::new()), None);
+        assert_eq!(next_of_set_iter([9, 4].into_iter().collect()), Some(4));
+    }
+}
