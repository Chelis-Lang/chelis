index 0000000..bf62721
--- /dev/null
+++ b/tests/lean/ExplicitImplParams/Checks.lean
@@ -0,0 +1,64 @@
+import ExplicitImplParams.ExplicitImplParams
+
+/-! Evaluate the model of `tests/src/explicit-impl-params.rs` on the inputs of
+    its `native` test module and compare with the native results. Each function
+    passes a builtin trait impl as the instance of a generic function, with the
+    explicit arguments Aeneas prints for it. -/
+
+namespace explicit_impl_params.checks
+open Aeneas Aeneas.Std Result
+
+def u (x : Nat) : U32 := ⟨BitVec.ofNat _ x⟩
+def us (x : Nat) : Usize := ⟨BitVec.ofNat _ x⟩
+
+def vec {α} (xs : List α) (h : xs.length ≤ Usize.max := by scalar_tac) : alloc.vec.Vec α := ⟨xs, h⟩
+def vals (v : alloc.vec.Vec U32) : List Nat := v.val.map (·.val)
+def pairs (v : alloc.vec.Vec (U32 × U32)) : List (Nat × Nat) := v.val.map fun (a, b) => (a.val, b.val)
+def pair (p : U32 × U32) : Nat × Nat := (p.1.val, p.2.val)
+
+def map (kv : List (Nat × Nat)) : alloc.collections.btree.map.BTreeMap U32 U32 :=
+  ⟨kv.map fun (k, v) => (u k, u v)⟩
+def set (xs : List Nat) : alloc.collections.btree.set.BTreeSet U32 :=
+  ⟨⟨xs.map fun x => (u x, ())⟩⟩
+
+def arr4 (a b c d : Nat) : Array U32 4#usize := ⟨[u a, u b, u c, u d], by simp⟩
+def arr3 (a b c : Nat) : Array U32 3#usize := ⟨[u a, u b, u c], by simp⟩
+def arrPairs (a b c : Nat × Nat) : Array (U32 × U32) 3#usize :=
+  ⟨[(u a.1, u a.2), (u b.1, u b.2), (u c.1, u c.2)], by simp⟩
+
+def ok? {α β} (f : α → β) : Result α → Option β
+  | ok x => some (f x)
+  | _ => none
+
+-- vec_deref
+#guard ok? (·.val) (deref_vec (vec [])) == some 0
+#guard ok? (·.val) (deref_vec (vec [u 5, u 1, u 2])) == some 8
+#guard ok? vals (deref_mut_vec (vec [])) == some []
+#guard ok? vals (deref_mut_vec (vec [u 5, u 1])) == some [15, 1]
+#guard ok? vals (deref_mut_vec (vec [u 4294967295])) == some [9]
+
+-- array_index
+#guard ok? (·.val) (index_array (arr4 4 5 6 7) (us 0)) == some 4
+#guard ok? (·.val) (index_array (arr4 4 5 6 7) (us 3)) == some 7
+#guard ok? (fun (a : Array U32 3#usize) => a.val.map (·.val)) (index_mut_array (arr3 1 2 3) (us 1))
+  == some [1, 6, 3]
+#guard ok? (fun (a : Array U32 3#usize) => a.val.map (·.val)) (index_mut_array (arr3 1 2 3) (us 2))
+  == some [1, 2, 9]
+
+-- btree_map
+#guard ok? pairs (from_array (arrPairs (3, 30) (1, 10) (3, 31))) == some [(1, 10), (3, 31)]
+#guard ok? (·.val) (index_map (map [(1, 10), (2, 20)]) (u 2)) == some 20
+#guard ok? (Option.map pair) (first_of_map (map [(1, 10), (2, 20)])) == some (some (1, 10))
+#guard ok? (Option.map pair) (first_of_map (map [])) == some none
+#guard ok? (Option.map pair) (next_of_map_iter (map [(4, 40), (5, 50)])) == some (some (4, 40))
+#guard ok? (Option.map (·.val)) (next_of_values (map [(4, 40), (5, 50)])) == some (some 40)
+#guard ok? (Option.map (·.val)) (next_of_values (map [])) == some none
+
+-- others
+#guard ok? (·.val) (clone_arc (u 7)) == some 7
+#guard ok? (·.val) (clone_rc (u 8)) == some 8
+#guard ok? (Option.map (·.val)) (first_of_set (set [1, 2, 3])) == some (some 1)
+#guard ok? (Option.map (·.val)) (first_of_set (set [])) == some none
+#guard ok? (Option.map (·.val)) (next_of_set_iter (set [4, 9])) == some (some 4)
+
+end explicit_impl_params.checks
