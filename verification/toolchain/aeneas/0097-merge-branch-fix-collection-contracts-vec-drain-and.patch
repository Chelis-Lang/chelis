+}
+
+@[rust_fun "core::ops::range::{core::ops::range::RangeBounds<core::ops::range::Range<@T>, @T>}::start_bound"]
+def core.ops.range.RangeBoundsRange.start_bound {T : Type} (self : core.ops.range.Range T) :
+    Result (core.ops.range.Bound T) :=
