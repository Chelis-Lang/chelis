+    (self : core.ops.range.RangeInclusive T) : Result (core.ops.range.Bound T) :=
+  ok (.Included self.start)
+
+/-- An exhausted range is empty: its end is excluded. -/
+@[rust_fun "core::ops::range::{core::ops::range::RangeBounds<core::ops::range::RangeInclusive<@T>, @T>}::end_bound"]
+def core.ops.range.RangeBoundsRangeInclusive.end_bound {T : Type}
+    (self : core.ops.range.RangeInclusive T) : Result (core.ops.range.Bound T) :=
+  ok (if self.exhausted then .Excluded self.end else .Included self.end)
+
+@[reducible, rust_trait_impl "core::ops::range::RangeBounds<core::ops::range::RangeInclusive<@T>, @T>"]
+def core.ops.range.RangeBoundsRangeInclusive (T : Type) :
+    core.ops.range.RangeBounds (core.ops.range.RangeInclusive T) T := {
+  start_bound := core.ops.range.RangeBoundsRangeInclusive.start_bound
+  end_bound := core.ops.range.RangeBoundsRangeInclusive.end_bound
+}
+
+/-- `core::slice::index::range(range, ..len)` (core/src/slice/index.rs, rustc 1.95):
+`into_slice_range(len, (range.start_bound().copied(), range.end_bound().copied()))`,
+the start bound read first. The end is resolved before the start; an end past `len`
+or a start past the end panics (`slice_index_fail`). -/
+def core.slice.index.rangeOf {R : Type} (bounds : core.ops.range.RangeBounds R Usize)
+    (range : R) (len : Nat) : Result (Nat × Nat) := do
+  let startBound ← bounds.start_bound range
+  let endBound ← bounds.end_bound range
+  let end_ ← match endBound with
+    | .Included e => if e.val ≥ len then fail .panic else ok (e.val + 1)
+    | .Excluded e => if e.val > len then fail .panic else ok e.val
+    | .Unbounded => ok len
+  let start ← match startBound with
+    | .Excluded s => if s.val ≥ end_ then fail .panic else ok (s.val + 1)
+    | .Included s => if s.val > end_ then fail .panic else ok s.val
+    | .Unbounded => ok 0
+  ok (start, end_)
+
+/-- The resolved range lies within the slice. -/
+theorem core.slice.index.rangeOf_le {R : Type} {bounds : core.ops.range.RangeBounds R Usize}
+    {range : R} {len start end_ : Nat}
+    (h : core.slice.index.rangeOf bounds range len = ok (start, end_)) :
+    start ≤ end_ ∧ end_ ≤ len := by
+  unfold core.slice.index.rangeOf at h
+  cases hs : bounds.start_bound range <;> simp only [hs, bind_tc_ok, bind_tc_fail, bind_tc_div] at h <;>
+    try contradiction
+  cases he : bounds.end_bound range <;> simp only [he, bind_tc_ok, bind_tc_fail, bind_tc_div] at h <;>
+    try contradiction
+  rename_i sb eb
+  cases eb <;> cases sb <;> simp only at h <;> (repeat' split at h) <;> simp_all <;> omega
+
+end Aeneas.Std
