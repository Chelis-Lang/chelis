+    {back : alloc.vec.drain.Drain T → alloc.vec.Vec T} {start end_ : Nat}
+    (hr : core.slice.index.rangeOf bounds range v.length = ok (start, end_))
+    (h : alloc.vec.Vec.drain bounds v range = ok (drain, back)) (final : alloc.vec.drain.Drain T)
+    (hkept : final.kept = drain.kept) :
+    (back final).val = v.val.take start ++ v.val.drop end_ := by
+  unfold alloc.vec.Vec.drain at h
+  split at h <;> simp_all
+  obtain ⟨rfl, rfl⟩ := h
