diff --git a/tests/src/btree-entry.rs b/tests/src/btree-entry.rs
new file mode 100644
index 0000000..405b768
--- /dev/null
+++ b/tests/src/btree-entry.rs
@@ -0,0 +1,223 @@
+//@ [!lean] skip
+//@ [lean] subdir=BtreeEntry
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include alloc::collections::btree::map::entry::{alloc::collections::btree::map::entry::Entry}
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! `BTreeMap` entries: the `Entry` methods translated from their Rust bodies
+//! (`or_insert`, `or_insert_with`, `or_default`, `insert_entry`) over the modeled
+//! `OccupiedEntry` and `VacantEntry` operations, the modeled `Entry::key`, and
+//! removal through an occupied entry. A map is observed through `snapshot`.
+
+use std::collections::btree_map::Entry;
+use std::collections::BTreeMap;
+
+fn populated() -> BTreeMap<u32, u32> {
+    let mut map = BTreeMap::new();
+    map.insert(2, 20);
+    map.insert(4, 40);
+    map
+}
+
+fn snapshot(map: &BTreeMap<u32, u32>) -> Vec<(u32, u32)> {
+    let mut out = Vec::new();
+    for (key, value) in map {
+        out.push((*key, *value));
+    }
+    out
+}
+
+/// `or_default` counts (chelis-ir ownership/last_use.rs successors).
+pub fn counted(keys: &[u32]) -> Vec<(u32, u32)> {
+    let mut map = BTreeMap::new();
+    for key in keys {
+        *map.entry(*key).or_default() += 1;
+    }
+    snapshot(&map)
+}
+
+/// `or_insert` on an occupied and a vacant key.
+pub fn inserted() -> Vec<(u32, u32)> {
+    let mut map = populated();
+    *map.entry(2).or_insert(900) += 7;
+    *map.entry(3).or_insert(300) += 1;
+    snapshot(&map)
+}
+
+/// `or_insert_with` runs its closure only for a vacant key, and the closure's
+/// captured mutable state is given back (chelis-ir fuse.rs ext_index).
+pub fn inserted_with(keys: &[u32]) -> (Vec<(u32, u32)>, Vec<u32>) {
+    let mut map = populated();
+    let mut fresh = Vec::new();
+    for key in keys {
+        map.entry(*key).or_insert_with(|| {
+            fresh.push(*key);
+            *key * 100
+        });
+    }
+    (snapshot(&map), fresh)
+}
+
+/// `Entry::key`: the stored key of an occupied entry, the probe of a vacant one.
+pub fn keys() -> (u32, u32) {
+    let mut map = populated();
+    let occupied = *map.entry(4).key();
+    let vacant = *map.entry(9).key();
+    (occupied, vacant)
+}
+
+/// `Entry::insert_entry` replaces an occupied value and inserts a vacant key;
+/// the returned occupied entry reads the stored pair, and removing through it
+/// takes the inserted pair out again.
+pub fn inserted_entries(key: u32) -> ((u32, u32), (u32, u32), Vec<(u32, u32)>) {
+    let mut map = populated();
+    let replaced = {
+        let entry = map.entry(2).insert_entry(21);
+        (*entry.key(), *entry.get())
+    };
+    let removed = map.entry(key).insert_entry(key * 10).remove_entry();
+    (replaced, removed, snapshot(&map))
+}
+
+/// The occupied accessors: `get`, `get_mut`, `insert` (the previous value).
+/// Borrowing the entry mutably ends the shared observation `get` left.
+pub fn occupied_updates() -> (u32, u32, Vec<(u32, u32)>) {
+    let mut map = populated();
+    let mut seen = 0;
+    let mut previous = 0;
+    if let Entry::Occupied(mut entry) = map.entry(2) {
+        seen = *entry.get();
+        *entry.get_mut() += 5;
+        previous = entry.insert(60);
+    }
+    (seen, previous, snapshot(&map))
+}
+
+/// Removal through an occupied entry.
+pub fn removed(key: u32) -> (Option<u32>, Vec<(u32, u32)>) {
+    let mut map = populated();
+    let value = match map.entry(key) {
+        Entry::Occupied(entry) => Some(entry.remove()),
+        Entry::Vacant(_) => None,
+    };
+    (value, snapshot(&map))
+}
+
+/// `remove_entry` returns the stored key.
+pub fn removed_entry(key: u32) -> (Option<(u32, u32)>, Vec<(u32, u32)>) {
+    let mut map = populated();
+    let pair = match map.entry(key) {
+        Entry::Occupied(entry) => Some(entry.remove_entry()),
+        Entry::Vacant(_) => None,
+    };
+    (pair, snapshot(&map))
+}
+
+/// Shared observations of an occupied entry (`key`, `get`), then the entry
+/// consumed by `remove_entry`: moving the entry ends the observations.
+pub fn observed_removal(key: u32) -> (Option<(u32, u32, (u32, u32))>, Vec<(u32, u32)>) {
+    let mut map = populated();
+    let observed = match map.entry(key) {
+        Entry::Occupied(entry) => {
+            let stored = *entry.key();
+            let value = *entry.get();
+            Some((stored, value, entry.remove_entry()))
+        }
+        Entry::Vacant(_) => None,
+    };
+    (observed, snapshot(&map))
+}
+
+/// A vacant entry's key, and `into_key`, which leaves the map unchanged.
+pub fn vacant_keys(key: u32) -> (Option<(u32, u32)>, Vec<(u32, u32)>) {
+    let mut map = populated();
+    let keys = match map.entry(key) {
+        Entry::Occupied(_) => None,
+        Entry::Vacant(entry) => {
+            let probe = *entry.key();
+            Some((probe, entry.into_key()))
+        }
+    };
+    (keys, snapshot(&map))
+}
+
+/// Writes through the value borrows that entries give back, after the call:
+/// `get_mut` of an occupied entry, and `get_mut` of the occupied entry that
+/// `insert_entry` returns. Both writes reach the map.
+pub fn written_back(key: u32) -> (u32, Vec<(u32, u32)>) {
+    let mut map = populated();
+    if let Entry::Occupied(mut entry) = map.entry(4) {
+        *entry.get_mut() *= 3;
+    }
+    let mut entry = map.entry(key).insert_entry(key);
+    *entry.get_mut() += 1;
+    let value = *entry.get();
+    (value, snapshot(&map))
+}
+
+/// The reference `or_insert` gives back, written twice after the call.
+pub fn or_insert_written(key: u32) -> Vec<(u32, u32)> {
+    let mut map = populated();
+    let value = map.entry(key).or_insert(1);
+    *value *= 7;
+    *value += key;
+    snapshot(&map)
+}
+
+/// A shared observation of an occupied entry, then writes through it: `get_mut`
+/// (the observation ends first), and `insert` whose argument reads the entry
+/// (a two-phase borrow of the entry).
+pub fn observed_writes() -> (u32, Vec<(u32, u32)>) {
+    let mut map = populated();
+    let mut previous = 0;
+    if let Entry::Occupied(mut entry) = map.entry(4) {
+        let seen = *entry.get();
+        *entry.get_mut() += seen;
+        previous = entry.insert(*entry.get() + 1);
+    }
+    (previous, snapshot(&map))
+}
+
+/// A vacant entry's key, then the entry consumed by `insert`, and a write
+/// through the reference `insert` gives back.
+pub fn observed_vacant_insert(key: u32) -> Vec<(u32, u32)> {
+    let mut map = populated();
+    if let Entry::Vacant(entry) = map.entry(key) {
+        let probe = *entry.key();
+        let value = entry.insert(probe * 2);
+        *value += 1;
+    }
+    snapshot(&map)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn entries() {
+        assert_eq!(counted(&[3, 1, 3, 3]), vec![(1, 1), (3, 3)]);
+        assert_eq!(counted(&[]), vec![]);
+        assert_eq!(inserted(), vec![(2, 27), (3, 301), (4, 40)]);
+        assert_eq!(
+            inserted_with(&[4, 1, 1, 6]),
+            (vec![(1, 100), (2, 20), (4, 40), (6, 600)], vec![1, 6])
+        );
+        assert_eq!(keys(), (4, 9));
+        assert_eq!(inserted_entries(3), ((2, 21), (3, 30), vec![(2, 21), (4, 40)]));
+        assert_eq!(inserted_entries(4), ((2, 21), (4, 40), vec![(2, 21)]));
+        assert_eq!(occupied_updates(), (20, 25, vec![(2, 60), (4, 40)]));
+        assert_eq!(removed(2), (Some(20), vec![(4, 40)]));
+        assert_eq!(removed(3), (None, vec![(2, 20), (4, 40)]));
+        assert_eq!(removed_entry(4), (Some((4, 40)), vec![(2, 20)]));
+        assert_eq!(observed_removal(4), (Some((4, 40, (4, 40))), vec![(2, 20)]));
+        assert_eq!(observed_removal(5), (None, vec![(2, 20), (4, 40)]));
+        assert_eq!(vacant_keys(7), (Some((7, 7)), vec![(2, 20), (4, 40)]));
+        assert_eq!(vacant_keys(2), (None, vec![(2, 20), (4, 40)]));
+        assert_eq!(written_back(3), (4, vec![(2, 20), (3, 4), (4, 120)]));
+        assert_eq!(written_back(2), (3, vec![(2, 3), (4, 120)]));
+        assert_eq!(or_insert_written(2), vec![(2, 142), (4, 40)]);
+        assert_eq!(or_insert_written(5), vec![(2, 20), (4, 40), (5, 12)]);
+        assert_eq!(observed_writes(), (80, vec![(2, 20), (4, 81)]));
+        assert_eq!(observed_vacant_insert(3), vec![(2, 20), (3, 7), (4, 40)]);
+        assert_eq!(observed_vacant_insert(4), vec![(2, 20), (4, 40)]);
+    }
+}
diff --git a/tests/src/vec-drain.rs b/tests/src/vec-drain.rs
new file mode 100644
index 0000000..de72d58
--- /dev/null
+++ b/tests/src/vec-drain.rs
@@ -0,0 +1,195 @@
+//@ [!lean] skip
+//@ [lean] subdir=VecDrain
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! `Vec::drain` over each std range kind and its `Drain` iterator: dropping the
+//! drain removes the whole range, whether or not it was exhausted (chelis-ir
+//! ownership/last_use.rs drains a vector in a loop that may leave early with
+//! `?`); `next_back`.
+
+pub fn drain_all(v: &mut Vec<u32>) -> Vec<u32> {
+    let mut out = Vec::new();
+    for x in v.drain(..) {
+        out.push(x);
+    }
+    out
+}
+
+/// Stops at the first `stop`: the rest of the range is dropped with the drain.
+pub fn drain_until(v: &mut Vec<u32>, stop: u32) -> Vec<u32> {
+    let mut out = Vec::new();
+    for x in v.drain(..) {
+        if x == stop {
+            break;
+        }
+        out.push(x);
+    }
+    out
+}
+
+/// Leaves with `?` from inside the loop (the shape of `remove_provisionals`).
+pub fn drain_checked(v: &mut Vec<u32>, limit: u32) -> Result<u32, u32> {
+    let mut total = 0;
+    for x in v.drain(1..) {
+        if x > limit {
+            return Err(x);
+        }
+        total += x;
+    }
+    Ok(total)
+}
+
+/// Drains through a mutable borrow taken from a loop over the outer vector.
+pub fn drain_nested(blocks: &mut Vec<Vec<u32>>) -> Vec<u32> {
+    let mut seen = Vec::new();
+    for block in &mut *blocks {
+        let mut kept = Vec::new();
+        for x in block.drain(..) {
+            if x % 2 == 0 {
+                seen.push(x);
+            } else {
+                kept.push(x);
+            }
+        }
+        *block = kept;
+    }
+    seen
+}
+
+/// One element from each end of a bounded range, the drain then dropped.
+pub fn drain_ends(v: &mut Vec<u32>, start: usize, end: usize) -> (Option<u32>, Option<u32>, Option<u32>) {
+    let mut drain = v.drain(start..end);
+    let first = drain.next();
+    let last = drain.next_back();
+    let second = drain.next();
+    (first, last, second)
+}
+
+/// Taken from the back until exhausted.
+pub fn drain_from(v: &mut Vec<u32>, start: usize) -> Vec<u32> {
+    let mut out = Vec::new();
+    let mut drain = v.drain(start..);
+    while let Some(x) = drain.next_back() {
+        out.push(x);
+    }
+    out
+}
+
+pub fn drain_to(v: &mut Vec<u32>, end: usize) -> Vec<u32> {
+    let mut out = Vec::new();
+    for x in v.drain(..end) {
+        out.push(x);
+    }
+    out
+}
+
+pub fn drain_inclusive(v: &mut Vec<u32>, start: usize, last: usize) -> Vec<u32> {
+    let mut out = Vec::new();
+    for x in v.drain(start..=last) {
+        if x > 1 {
+            out.push(x);
+        }
+    }
+    out
+}
+
+/// Nothing is taken from the drain: the range is still removed.
+pub fn drain_unused(v: &mut Vec<u32>, start: usize, end: usize) {
+    v.drain(start..end);
+}
+
+/// The vector is used again after the drain (left early or exhausted) is
+/// dropped: a push, and a write through an index.
+pub fn drain_then_reuse(v: &mut Vec<u32>, start: usize) -> Vec<u32> {
+    let mut out = Vec::new();
+    for x in v.drain(start..) {
+        out.push(x);
+        if x == 7 {
+            break;
+        }
+    }
+    v.push(out.len() as u32);
+    v[0] += 100;
+    out
+}
+
+fn take_front(v: &mut Vec<u32>, n: usize) -> u32 {
+    let mut sum = 0;
+    for x in v.drain(..n) {
+        sum += x;
+    }
+    sum
+}
+
+/// The vector a callee drained through a mutable borrow is given back to the
+/// caller, which pushes to it and drains it again.
+pub fn drain_helper_reuse(mut v: Vec<u32>) -> (u32, u32, Vec<u32>) {
+    let a = take_front(&mut v, 1);
+    v.push(a);
+    let b = take_front(&mut v, 2);
+    (a, b, v)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    fn panics(f: impl FnOnce() + std::panic::UnwindSafe) -> bool {
+        std::panic::catch_unwind(f).is_err()
+    }
+
+    #[test]
+    fn drains() {
+        let mut v = vec![1, 2, 3];
+        assert_eq!(drain_all(&mut v), vec![1, 2, 3]);
+        assert_eq!(v, vec![]);
+        let mut v = vec![1, 2, 7, 3];
+        assert_eq!(drain_until(&mut v, 7), vec![1, 2]);
+        assert_eq!(v, vec![]);
+        let mut v = vec![9, 1, 2, 3];
+        assert_eq!(drain_checked(&mut v, 5), Ok(6));
+        assert_eq!(v, vec![9]);
+        let mut v = vec![9, 1, 8, 3];
+        assert_eq!(drain_checked(&mut v, 5), Err(8));
+        assert_eq!(v, vec![9]);
+        let mut blocks = vec![vec![1, 2, 3], vec![], vec![4, 5]];
+        assert_eq!(drain_nested(&mut blocks), vec![2, 4]);
+        assert_eq!(blocks, vec![vec![1, 3], vec![], vec![5]]);
+        let mut v = vec![1, 2, 3, 4, 5, 6];
+        assert_eq!(drain_ends(&mut v, 1, 5), (Some(2), Some(5), Some(3)));
+        assert_eq!(v, vec![1, 6]);
+        let mut v = vec![1, 2, 3];
+        assert_eq!(drain_ends(&mut v, 1, 2), (Some(2), None, None));
+        assert_eq!(v, vec![1, 3]);
+        let mut v = vec![1, 2, 3];
+        assert_eq!(drain_ends(&mut v, 3, 3), (None, None, None));
+        assert_eq!(v, vec![1, 2, 3]);
+        let mut v = vec![1, 2, 3, 4];
+        assert_eq!(drain_from(&mut v, 1), vec![4, 3, 2]);
+        assert_eq!(v, vec![1]);
+        let mut v = vec![1, 2, 3, 4];
+        assert_eq!(drain_to(&mut v, 2), vec![1, 2]);
+        assert_eq!(v, vec![3, 4]);
+        let mut v = vec![1, 2, 3, 4];
+        assert_eq!(drain_inclusive(&mut v, 0, 2), vec![2, 3]);
+        assert_eq!(v, vec![4]);
+        let mut v = vec![1, 2, 3, 4];
+        drain_unused(&mut v, 1, 3);
+        assert_eq!(v, vec![1, 4]);
+        assert!(panics(|| drain_unused(&mut vec![1, 2, 3], 2, 1)));
+        assert!(panics(|| drain_unused(&mut vec![1, 2, 3], 1, 4)));
+        assert!(panics(|| {
+            drain_inclusive(&mut vec![1, 2, 3], 0, 3);
+        }));
+        assert!(panics(|| {
+            drain_from(&mut vec![1, 2, 3], 4);
+        }));
+        let mut v = vec![1, 2, 3, 4];
+        assert_eq!(drain_then_reuse(&mut v, 1), vec![2, 3, 4]);
+        assert_eq!(v, vec![101, 3]);
+        let mut v = vec![5, 6, 7, 8];
+        assert_eq!(drain_then_reuse(&mut v, 1), vec![6, 7]);
+        assert_eq!(v, vec![105, 2]);
+        assert_eq!(drain_helper_reuse(vec![1, 2, 3]), (1, 5, vec![1]));
+    }
+}
