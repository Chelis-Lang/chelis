+import Aeneas.Std.IteratorSources
+
+namespace Aeneas.Std
+
+open Result
+
+/-! `core::ops::range::{Bound, RangeBounds}` (core/src/ops/range.rs, rustc 1.95).
+The bounds are `Bound<&T>`: shared borrows are values in the translation. -/
+
+@[rust_type "core::ops::range::Bound"]
+inductive core.ops.range.Bound (T : Type) where
+  | Included : T → core.ops.range.Bound T
+  | Excluded : T → core.ops.range.Bound T
+  | Unbounded : core.ops.range.Bound T
+
+/-- The provided `contains` has its own generics and is not a dictionary field. -/
+@[rust_trait "core::ops::range::RangeBounds"]
+structure core.ops.range.RangeBounds (Self : Type) (T : Type) where
+  start_bound : Self → Result (core.ops.range.Bound T)
+  end_bound : Self → Result (core.ops.range.Bound T)
+
+/-- `RangeFull` is a unit struct: its translation is `Unit`. -/
+@[rust_fun "core::ops::range::{core::ops::range::RangeBounds<core::ops::range::RangeFull, @T>}::start_bound"]
+def core.ops.range.RangeBoundsRangeFull.start_bound (T : Type) (_ : Unit) :
+    Result (core.ops.range.Bound T) :=
+  ok .Unbounded
+
+@[rust_fun "core::ops::range::{core::ops::range::RangeBounds<core::ops::range::RangeFull, @T>}::end_bound"]
+def core.ops.range.RangeBoundsRangeFull.end_bound (T : Type) (_ : Unit) :
+    Result (core.ops.range.Bound T) :=
+  ok .Unbounded
+
+@[reducible, rust_trait_impl "core::ops::range::RangeBounds<core::ops::range::RangeFull, @T>"]
+def core.ops.range.RangeBoundsRangeFull (T : Type) : core.ops.range.RangeBounds Unit T := {
+  start_bound := core.ops.range.RangeBoundsRangeFull.start_bound T
+  end_bound := core.ops.range.RangeBoundsRangeFull.end_bound T
+}
+
+@[rust_fun "core::ops::range::{core::ops::range::RangeBounds<core::ops::range::RangeFrom<@T>, @T>}::start_bound"]
+def core.ops.range.RangeBoundsRangeFrom.start_bound {T : Type} (self : core.ops.range.RangeFrom T) :
+    Result (core.ops.range.Bound T) :=
+  ok (.Included self.start)
+
+@[rust_fun "core::ops::range::{core::ops::range::RangeBounds<core::ops::range::RangeFrom<@T>, @T>}::end_bound"]
+def core.ops.range.RangeBoundsRangeFrom.end_bound {T : Type} (_ : core.ops.range.RangeFrom T) :
+    Result (core.ops.range.Bound T) :=
+  ok .Unbounded
+
+@[reducible, rust_trait_impl "core::ops::range::RangeBounds<core::ops::range::RangeFrom<@T>, @T>"]
+def core.ops.range.RangeBoundsRangeFrom (T : Type) :
+    core.ops.range.RangeBounds (core.ops.range.RangeFrom T) T := {
+  start_bound := core.ops.range.RangeBoundsRangeFrom.start_bound
+  end_bound := core.ops.range.RangeBoundsRangeFrom.end_bound
+}
+
+@[rust_fun "core::ops::range::{core::ops::range::RangeBounds<core::ops::range::RangeTo<@T>, @T>}::start_bound"]
+def core.ops.range.RangeBoundsRangeTo.start_bound {T : Type} (_ : core.ops.range.RangeTo T) :
+    Result (core.ops.range.Bound T) :=
+  ok .Unbounded
+
+@[rust_fun "core::ops::range::{core::ops::range::RangeBounds<core::ops::range::RangeTo<@T>, @T>}::end_bound"]
+def core.ops.range.RangeBoundsRangeTo.end_bound {T : Type} (self : core.ops.range.RangeTo T) :
+    Result (core.ops.range.Bound T) :=
+  ok (.Excluded self.end)
+
