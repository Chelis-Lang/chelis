+    let split := s.length / N.val * N.val
+    let arrays ← (core.slice.chunkList N.val (Nat.pos_of_ne_zero hn) (s.val.take split)).mapM
+      fun chunk => if h : chunk.length = N.val then ok (⟨chunk, h⟩ : Array T N) else fail .panic
