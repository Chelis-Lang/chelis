+# `<[T]>::as_chunks`, `binary_search`, `partition_point` and `fill`
+
+Transcriptions of core/src/slice/mod.rs and core/src/slice/specialize.rs (rustc 1.95.0-nightly
+efc9e1b50 2026-02-06). `binary_search` and `partition_point` return the index std's algorithm
+finds (among equal elements it is not the first one), and call the comparison or the predicate on
+the same elements in the same order, so the calls of a stateful predicate are the native ones.
+-/
+
+namespace Aeneas.Std
+
+open Result
+
+/-- The elements of `l` in consecutive groups of `n`; the last group is shorter when `n` does not
+    divide the length. -/
+def core.slice.chunkList {T : Type} (n : Nat) (hn : 0 < n) (l : List T) : List (List T) :=
+  if h : l = [] then [] else l.take n :: core.slice.chunkList n hn (l.drop n)
+termination_by l.length
+decreasing_by
+  have : l.length ≠ 0 := by simpa [List.length_eq_zero_iff] using h
+  simp only [List.length_drop]; omega
+
+/-- A list as a slice (unreachable failure: every caller's list is no longer than a slice). -/
+def core.slice.ofList {T : Type} (l : List T) : Result (Slice T) :=
+  if h : l.length ≤ Usize.max then ok ⟨l, h⟩ else fail .panic
