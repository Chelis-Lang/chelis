+//! `&self` methods of a struct holding a mutable borrow
+//! (chelis_types::linearity::Checker<'n> { native: &'n mut NativeServices, .. }):
+//! a loop or a switch reborrows the shared payload of the input, which holds
+//! the mutable borrow `native`. The copy of that borrow is only read (through the
+//! shared loan of the reborrow): it is a fresh symbolic value backed by shared
+//! reborrows of the original borrow, bound to the original value.
+//! `SharedPayloadMutField/Checks.lean` evaluates the model on the inputs of the
+//! `native` test module below and compares with the native results.
+
+pub struct Checker<'n> {
+    pub native: &'n mut u32,
+    pub top: Vec<u32>,
+}
+
+impl<'n> Checker<'n> {
+    /// A loop which only reads the other field
+    pub fn find(&self, name: u32) -> bool {
+        let mut i = 0;
+        while i < self.top.len() {
+            if self.top[i] == name {
+                return true;
+            }
+            i += 1;
+        }
+        false
+    }
+
+    /// A loop which reads through the copied mutable borrow
+    pub fn count_above_native(&self) -> u32 {
+        let mut i = 0;
+        let mut n = 0;
+        while i < self.top.len() {
+            if self.top[i] > *self.native {
+                n += 1;
+            }
+            i += 1;
+        }
+        n
+    }
+
+    /// A switch
+    pub fn first_or_native(&self) -> u32 {
+        if self.top.len() > 0 {
+            self.top[0]
+        } else {
+            *self.native
+        }
+    }
+
+    /// A switch on another input (as the body of `Option::or_else` with a
+    /// closure capturing `&self`)
+    pub fn pick(&self, k: Option<u32>) -> u32 {
+        match k {
+            Some(x) => x,
+            None => *self.native + self.top.len() as u32,
+        }
+    }
+
+    pub fn bump(&mut self, d: u32) {
+        *self.native += d;
+    }
+}
+
+/// Calls the `&self` methods, writes through the mutable borrow (directly and
+/// through `&mut self`) between the calls, and observes the borrowed counter
+/// after the checker is gone.
+pub fn drive(which: u8) -> (u32, u32, u32, u32, u32, u32, u32, u32) {
+    let mut ctr = 10;
+    let top = match which {
+        0 => vec![3, 12, 7, 20],
+        1 => vec![],
+        _ => vec![11, 11, 30],
+    };
+    let mut c = Checker { native: &mut ctr, top };
+    let f0 = c.find(7) as u32 + 2 * c.find(11) as u32;
+    let a0 = c.count_above_native();
+    let s0 = c.first_or_native();
+    *c.native += 2;
+    c.top.push(13);
+    let a1 = c.count_above_native();
+    c.bump(3);
+    let p0 = c.pick(None);
+    let p1 = c.pick(Some(which as u32));
+    let s1 = c.first_or_native();
+    *c.native += s1;
+    (f0, a0, s0, a1, p0, p1, s1, ctr)
+}
+
