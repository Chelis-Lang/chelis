+          _root_.Aeneas.Std.Array _root_.Aeneas.Std.U32 3#usize))
+      _root_.Aeneas.Std.Result.ok (_root_.Aeneas.Std.alloc.slice.Slice.into_vec
+        s)
+  let b ←
+    _root_.shared_payload_mut_field.Checker.find { native := 10#u32, top }
+      7#u32
+  let i ← lift (UScalar.cast_fromBool .U32 b)
+  let b1 ←
+    _root_.shared_payload_mut_field.Checker.find { native := 10#u32, top }
+      11#u32
+  let i1 ← lift (UScalar.cast_fromBool .U32 b1)
+  let i2 ← 2#u32 * i1
+  let f0 ← i + i2
+  let a0 ←
+    _root_.shared_payload_mut_field.Checker.count_above_native
+      { native := 10#u32, top }
+  let s0 ←
+    _root_.shared_payload_mut_field.Checker.first_or_native
+      { native := 10#u32, top }
+  let i3 ← 10#u32 + 2#u32
+  let v ← _root_.Aeneas.Std.alloc.vec.Vec.push top 13#u32
+  let a1 ←
+    _root_.shared_payload_mut_field.Checker.count_above_native
+      { native := i3, top := v }
+  let (c, bump_back) ←
+    _root_.shared_payload_mut_field.Checker.bump { native := i3, top := v }
+      3#u32
+  let p0 ← _root_.shared_payload_mut_field.Checker.pick c none
+  let i4 ← lift (UScalar.cast .U32 which)
+  let p1 ← _root_.shared_payload_mut_field.Checker.pick c (some i4)
+  let s1 ← _root_.shared_payload_mut_field.Checker.first_or_native c
+  let i5 ← c.native + s1
+  let c1 := bump_back { c with native := i5 }
+  _root_.Aeneas.Std.Result.ok (f0, a0, s0, a1, p0, p1, s1, c1.native)
+
+end shared_payload_mut_field
