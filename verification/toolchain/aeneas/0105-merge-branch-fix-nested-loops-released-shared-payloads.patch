diff --git a/tests/src/join-distinct-shared-reborrows.rs b/tests/src/join-distinct-shared-reborrows.rs
new file mode 100644
index 0000000..2d976af
--- /dev/null
+++ b/tests/src/join-distinct-shared-reborrows.rs
@@ -0,0 +1,204 @@
+//@ [!lean] skip
+//@ [lean] subdir=JoinDistinctSharedReborrows
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Two lookups into one vector (`first()`, then `matches!` on `get(1)`)
+//! (chelis_deep::stamp_to_typed::stamp_bare_list). Each lookup is owned by the
+//! abstraction of its own region, which holds its own shared reborrow of the
+//! vector. The join of the `matches!` arms is matched against each branch: the
+//! marked reborrows of the joined context must pair each abstraction with its
+//! own dual, not with the other lookup's abstraction which reborrows the same
+//! loan.
+
+#[derive(Clone, Copy)]
+pub struct Span {
+    pub lo: u32,
+    pub hi: u32,
+}
+
+pub enum RawAtom {
+    Symbol(u32),
+    Int(u32),
+}
+
+pub enum RawExpr {
+    Atom(RawAtom, Span),
+    List(Vec<RawExpr>, Span),
+    Map(Vec<RawExpr>, Span),
+}
+
+#[derive(Clone, Copy)]
+pub enum DeepTag {
+    Params,
+    Fn,
+}
+
+impl DeepTag {
+    pub fn parse(s: &u32) -> Option<DeepTag> {
+        if *s == 6 {
+            Some(DeepTag::Params)
+        } else if *s == 2 {
+            Some(DeepTag::Fn)
+        } else {
+            None
+        }
+    }
+
+    fn code(self) -> u32 {
+        match self {
+            DeepTag::Params => 1,
+            DeepTag::Fn => 2,
+        }
+    }
+}
+
+pub enum Expr {
+    Atom(u32, Span),
+    Node(DeepTag, usize, Span),
+    BareList(Vec<Expr>, Span),
+}
+
+pub struct StampError {
+    pub span: Span,
+}
+
+fn build_node(tag: DeepTag, elements: Vec<RawExpr>, span: Span) -> Result<Expr, StampError> {
+    Ok(Expr::Node(tag, elements.len(), span))
+}
+
+fn stamp_bare(raw: RawExpr) -> Result<Expr, StampError> {
+    match raw {
+        RawExpr::Atom(RawAtom::Int(i), span) => Ok(Expr::Atom(i, span)),
+        RawExpr::Atom(RawAtom::Symbol(s), span) => Ok(Expr::Atom(100 + s, span)),
+        RawExpr::List(_, span) | RawExpr::Map(_, span) => Err(StampError { span }),
+    }
+}
+
+/// The production body (its let-chain written as nested `if`s).
+pub fn stamp_bare_list(elements: Vec<RawExpr>, span: Span) -> Result<Expr, StampError> {
+    if elements.len() >= 2 {
+        if let Some(RawExpr::Atom(RawAtom::Symbol(head), _)) = elements.first() {
+            if let Some(tag) = DeepTag::parse(head) {
+                if matches!(elements.get(1), Some(RawExpr::Map(..))) {
+                    return build_node(tag, elements, span);
+                }
+            }
+        }
+    }
+    let mut out = Vec::with_capacity(elements.len());
+    for elem in elements {
+        out.push(stamp_bare(elem)?);
+    }
+    Ok(Expr::BareList(out, span))
+}
+
+/// The same lookups through a mutable borrow, which is written after them.
+pub fn mark(elements: &mut Vec<RawExpr>) -> u32 {
+    let mut code = 0;
+    if let Some(RawExpr::Atom(RawAtom::Symbol(head), _)) = elements.first() {
+        if let Some(tag) = DeepTag::parse(head) {
+            if matches!(elements.get(1), Some(RawExpr::Map(..))) {
+                code = tag.code();
+            }
+        }
+    }
+    elements.push(RawExpr::Atom(RawAtom::Int(code), Span { lo: code, hi: 9 }));
+    code
+}
+
+fn sp(lo: u32) -> Span {
+    Span { lo, hi: lo + 1 }
+}
+
+/// 0: a tagged node; 1: a tag without a map; 2: a non-tag head with a map;
+/// 3: an integer head; 4: a single tag; 5: a list element; 6: empty.
+pub fn elements(which: u8) -> Vec<RawExpr> {
+    let mut v = Vec::new();
+    if which == 0 {
+        v.push(RawExpr::Atom(RawAtom::Symbol(6), sp(1)));
+        v.push(RawExpr::Map(Vec::new(), sp(2)));
+        v.push(RawExpr::Atom(RawAtom::Int(4), sp(3)));
+    } else if which == 1 {
+        v.push(RawExpr::Atom(RawAtom::Symbol(2), sp(4)));
+        v.push(RawExpr::Atom(RawAtom::Int(5), sp(5)));
+    } else if which == 2 {
+        v.push(RawExpr::Atom(RawAtom::Symbol(3), sp(6)));
+        v.push(RawExpr::Map(Vec::new(), sp(7)));
+    } else if which == 3 {
+        v.push(RawExpr::Atom(RawAtom::Int(8), sp(8)));
+        v.push(RawExpr::Map(Vec::new(), sp(9)));
+    } else if which == 4 {
+        v.push(RawExpr::Atom(RawAtom::Symbol(2), sp(10)));
+    } else if which == 5 {
+        v.push(RawExpr::Atom(RawAtom::Int(1), sp(11)));
+        v.push(RawExpr::List(Vec::new(), sp(12)));
+    }
+    v
+}
+
+fn expr_code(r: Result<Expr, StampError>) -> u32 {
+    match r {
+        Ok(Expr::Atom(i, span)) => i * 10 + span.lo,
+        Ok(Expr::Node(tag, n, span)) => 1000 * tag.code() + 100 * n as u32 + span.lo,
+        Ok(Expr::BareList(out, span)) => {
+            let mut w = 5000 + span.lo;
+            let mut i = 0;
+            while i < out.len() {
+                if let Expr::Atom(a, s) = &out[i] {
+                    w = w * 7 + *a + s.hi;
+                }
+                i += 1;
+            }
+            w
+        }
+        Err(e) => 90000 + e.span.lo,
+    }
+}
+
+fn weigh(v: &Vec<RawExpr>) -> u32 {
+    let mut w = v.len() as u32;
+    let mut i = 0;
+    while i < v.len() {
+        w = w * 5
+            + match &v[i] {
+                RawExpr::Atom(RawAtom::Symbol(s), span) => *s + span.lo,
+                RawExpr::Atom(RawAtom::Int(n), span) => 2 * *n + span.lo,
+                RawExpr::List(_, span) => 3 + span.lo,
+                RawExpr::Map(_, span) => 4 + span.hi,
+            };
+        i += 1;
+    }
+    w
+}
+
+/// Marks twice through mutable borrows (the second mark sees the first
+/// write), then stamps the marked vector.
+pub fn drive(which: u8) -> (u32, u32, u32, u32) {
+    let mut v = elements(which);
+    let m0 = mark(&mut v);
+    let r = &mut v;
+    if r.len() > 1 {
+        r[0] = RawExpr::Atom(RawAtom::Symbol(2), sp(15));
+    }
+    let m1 = mark(&mut v);
+    let w = weigh(&v);
+    let e = expr_code(stamp_bare_list(v, sp(20)));
+    (m0, m1, w, e)
+}
+
+/// Stamps the elements as they are.
+pub fn stamp(which: u8) -> u32 {
+    expr_code(stamp_bare_list(elements(which), sp(30)))
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn drives() {
+        for which in 0u8..7 {
+            println!("{} {:?} {}", which, drive(which), stamp(which));
+        }
+    }
+}
diff --git a/tests/src/loop-break-shared-local-loan.rs b/tests/src/loop-break-shared-local-loan.rs
new file mode 100644
index 0000000..4ffc5fc
--- /dev/null
+++ b/tests/src/loop-break-shared-local-loan.rs
@@ -0,0 +1,173 @@
+//@ [!lean] skip
+//@ [lean] subdir=LoopBreakSharedLocalLoan
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! A loop which breaks while a local is still shared-borrowed by another local
+//! (chelis_types::unify::Subst::resolve_tvar: `map.get(&current)`, the
+//! temporary `&current` lives until the end of the loop). The context at each
+//! break of the synthesized loop body holds the loan of `current` and its
+//! borrow under fresh ids: joined with the break target (same shape, other
+//! ids), they are the same loan and must not be wrapped in a reborrow
+//! abstraction which the break target does not have.
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+pub struct TypeVar(pub u32);
+
+#[derive(Clone)]
+pub enum Ty {
+    Prim(u32),
+    Var(TypeVar),
+    Pair(u32, u32),
+}
+
+pub struct Map {
+    pub entries: Vec<(TypeVar, Ty)>,
+}
+
+impl Map {
+    pub fn get(&self, k: &TypeVar) -> Option<&Ty> {
+        let mut i = 0;
+        while i < self.entries.len() {
+            if self.entries[i].0 == *k {
+                return Some(&self.entries[i].1);
+            }
+            i += 1;
+        }
+        None
+    }
+
+    pub fn insert(&mut self, k: TypeVar, v: Ty) {
+        let mut i = 0;
+        while i < self.entries.len() {
+            if self.entries[i].0 == k {
+                self.entries[i].1 = v;
+                return;
+            }
+            i += 1;
+        }
+        self.entries.push((k, v));
+    }
+}
+
+pub struct Subst {
+    pub types: Map,
+    pub steps: u32,
+}
+
+impl Subst {
+    /// The production body.
+    pub fn resolve_tvar(&mut self, start: TypeVar) -> Ty {
+        let map = &mut self.types;
+        let mut chain: Vec<TypeVar> = Vec::new();
+        let mut current = start;
+        let terminal = loop {
+            match map.get(&current) {
+                None => break Ty::Var(current),
+                Some(Ty::Var(v)) if *v == current => break Ty::Var(current),
+                Some(Ty::Var(v)) => {
+                    chain.push(current);
+                    current = *v;
+                }
+                Some(other) => {
+                    chain.push(current);
+                    break other.clone();
+                }
+            }
+        };
+        if chain.len() > 1 {
+            for v in chain {
+                if v != current {
+                    map.insert(v, Ty::Var(current));
+                }
+            }
+        }
+        terminal
+    }
+}
+
+/// The same walk over a shared map, counting the links.
+pub fn depth(map: &Map, start: TypeVar) -> u32 {
+    let mut current = start;
+    let mut n = 0;
+    let found = loop {
+        match map.get(&current) {
+            None => break 0,
+            Some(Ty::Var(v)) if *v == current => break 1,
+            Some(Ty::Var(v)) => {
+                current = *v;
+                n += 1;
+            }
+            Some(_) => break 2,
+        }
+    };
+    found * 100 + n
+}
+
+fn code(t: &Ty) -> u32 {
+    match t {
+        Ty::Prim(p) => 1000 + *p,
+        Ty::Var(v) => 2000 + v.0,
+        Ty::Pair(a, b) => 3000 + 10 * *a + *b,
+    }
+}
+
+fn weigh(m: &Map) -> u32 {
+    let mut w = m.entries.len() as u32;
+    let mut i = 0;
+    while i < m.entries.len() {
+        w = (w * 7 + m.entries[i].0 .0 + code(&m.entries[i].1)) % 1000003;
+        i += 1;
+    }
+    w
+}
+
+/// 0: a chain to a primitive; 1: a chain to an unbound variable; 2: a self
+/// loop; 3: a chain to a pair; 4: an empty map.
+pub fn subst(which: u8) -> Subst {
+    let mut e = Vec::new();
+    if which == 0 {
+        e.push((TypeVar(1), Ty::Var(TypeVar(2))));
+        e.push((TypeVar(2), Ty::Var(TypeVar(3))));
+        e.push((TypeVar(3), Ty::Prim(7)));
+    } else if which == 1 {
+        e.push((TypeVar(1), Ty::Var(TypeVar(4))));
+        e.push((TypeVar(4), Ty::Var(TypeVar(5))));
+        e.push((TypeVar(2), Ty::Var(TypeVar(1))));
+    } else if which == 2 {
+        e.push((TypeVar(1), Ty::Var(TypeVar(1))));
+        e.push((TypeVar(2), Ty::Var(TypeVar(1))));
+        e.push((TypeVar(3), Ty::Var(TypeVar(2))));
+    } else if which == 3 {
+        e.push((TypeVar(3), Ty::Var(TypeVar(2))));
+        e.push((TypeVar(2), Ty::Var(TypeVar(1))));
+        e.push((TypeVar(1), Ty::Pair(4, 5)));
+    }
+    Subst { types: Map { entries: e }, steps: 0 }
+}
+
+/// Resolves, writes through a mutable borrow of the map given back by the
+/// first resolution, resolves again, and observes the map given back.
+pub fn drive(which: u8) -> (u32, u32, u32, u32, u32, u32) {
+    let mut s = subst(which);
+    let d0 = depth(&s.types, TypeVar(3));
+    let t0 = code(&s.resolve_tvar(TypeVar(3)));
+    let w0 = weigh(&s.types);
+    let m = &mut s.types;
+    m.insert(TypeVar(9), Ty::Var(TypeVar(3)));
+    s.steps += 1;
+    let t1 = code(&s.resolve_tvar(TypeVar(9)));
+    let d1 = depth(&s.types, TypeVar(9));
+    (d0, t0, w0, t1, d1, weigh(&s.types) + s.steps)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn drives() {
+        for which in 0u8..5 {
+            println!("{} {:?}", which, drive(which));
+        }
+    }
+}
diff --git a/tests/src/loop-released-static-payload.rs b/tests/src/loop-released-static-payload.rs
new file mode 100644
index 0000000..ea3abf7
--- /dev/null
+++ b/tests/src/loop-released-static-payload.rs
@@ -0,0 +1,200 @@
+//@ [!lean] skip
+//@ [lean] subdir=LoopReleasedStaticPayload
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! A loop over the shared elements of a vector whose items hold a `&'static
+//! str` (chelis_ir::eval::eval_tensor_internal_with_result_claims, the loop
+//! over the local guard sites of a node). Ending the shared loan of an item
+//! releases its payload, which still holds the `'static` borrow: a join
+//! transfers that borrow to the abstraction of the loop's region, so the next
+//! join pairs the released payload of one branch with the transferred borrow of
+//! the other. They are the same ownership once both are normalized.
+
+pub enum Obs {
+    Carrier(u32),
+    Realized,
+    Computed(u32),
+    Same(u32),
+    Malformed(u32),
+}
+
+pub struct Claim {
+    pub claim: u32,
+    pub op: &'static str,
+    pub observed: Obs,
+    pub activation: Option<usize>,
+}
+
+fn is_active(claim: &Claim, values: &Vec<u32>) -> Result<bool, u32> {
+    match claim.activation {
+        None => Ok(true),
+        Some(i) => match values.get(i) {
+            Some(v) => Ok(*v != 0),
+            None => Err(claim.claim),
+        },
+    }
+}
+
+fn resolve(c: &u32, values: &Vec<u32>) -> Result<u32, u32> {
+    if (*c as usize) < values.len() {
+        Ok(values[*c as usize])
+    } else {
+        Err(100 + *c)
+    }
+}
+
+fn computed(c: &u32, values: &Vec<u32>) -> Result<Option<u32>, u32> {
+    if *c == 0 {
+        Ok(None)
+    } else if (*c as usize) < values.len() {
+        Ok(Some(values[*c as usize]))
+    } else {
+        Err(200 + *c)
+    }
+}
+
+fn same(a: &u32, axis: usize, values: &Vec<u32>) -> Result<u32, u32> {
+    if *a == 9 {
+        Err(300)
+    } else {
+        Ok(*a + axis as u32 + values.len() as u32)
+    }
+}
+
+fn verdict(axis: usize, claim: &Claim, observed: u32, dims: &mut Vec<u32>, values: &Vec<u32>) -> Result<(), u32> {
+    if axis < dims.len() && observed as usize > values.len() {
+        dims[axis] = observed;
+        Ok(())
+    } else if claim.op.len() > 3 {
+        Err(claim.claim)
+    } else {
+        Ok(())
+    }
+}
+
+/// The guard sites of one node.
+pub fn sites_loop(sites: &Vec<(usize, Claim)>, values: &Vec<u32>, dims: &mut Vec<u32>) -> Result<(), u32> {
+    for (axis, claim) in sites {
+        if !is_active(claim, values)? {
+            continue;
+        }
+        let observed = match &claim.observed {
+            Obs::Carrier(c) => resolve(c, values)?,
+            Obs::Computed(c) => match computed(c, values)? {
+                Some(e) => e,
+                None => continue,
+            },
+            Obs::Same(a) => same(a, *axis, values)?,
+            Obs::Malformed(r) => return Err(*r),
+            Obs::Realized => continue,
+        };
+        verdict(*axis, claim, observed, dims, values)?;
+    }
+    Ok(())
+}
+
+/// The guard sites of each node, in order.
+pub fn node_loop(map: &Vec<Vec<(usize, Claim)>>, order: &[usize], values: &Vec<u32>, dims: &mut Vec<u32>) -> Result<(), u32> {
+    for step in order {
+        if let Some(sites) = map.get(*step) {
+            for (axis, claim) in sites {
+                if !is_active(claim, values)? {
+                    continue;
+                }
+                let observed = match &claim.observed {
+                    Obs::Carrier(c) => resolve(c, values)?,
+                    Obs::Computed(c) => match computed(c, values)? {
+                        Some(e) => e,
+                        None => continue,
+                    },
+                    Obs::Same(a) => same(a, *axis, values)?,
+                    Obs::Malformed(r) => return Err(*r),
+                    Obs::Realized => continue,
+                };
+                verdict(*axis, claim, observed, dims, values)?;
+            }
+        }
+    }
+    Ok(())
+}
+
+fn claim(claim: u32, op: &'static str, observed: Obs, activation: Option<usize>) -> Claim {
+    Claim { claim, op, observed, activation }
+}
+
+/// 0: every observation kind, all passing; 1: an inactive site, then a
+/// failing strict claim; 2: a missing activation value; 3: a malformed
+/// agreement after a write; 4: an out-of-range carrier; 5: a failing
+/// agreement.
+pub fn sites(which: u8) -> Vec<(usize, Claim)> {
+    let mut s = Vec::new();
+    if which == 0 {
+        s.push((0, claim(1, "==", Obs::Carrier(3), None)));
+        s.push((1, claim(2, "==", Obs::Computed(4), Some(1))));
+        s.push((2, claim(3, "<=", Obs::Same(2), None)));
+        s.push((0, claim(4, "==", Obs::Realized, None)));
+        s.push((1, claim(5, "==", Obs::Computed(0), None)));
+    } else if which == 1 {
+        s.push((0, claim(6, "==", Obs::Carrier(3), Some(0))));
+        s.push((1, claim(7, "==", Obs::Carrier(4), None)));
+        s.push((2, claim(8, "less", Obs::Carrier(1), None)));
+        s.push((0, claim(9, "==", Obs::Carrier(3), None)));
+    } else if which == 2 {
+        s.push((1, claim(10, "==", Obs::Same(1), None)));
+        s.push((2, claim(11, "==", Obs::Carrier(3), Some(7))));
+    } else if which == 3 {
+        s.push((2, claim(12, "==", Obs::Carrier(4), None)));
+        s.push((0, claim(13, "==", Obs::Malformed(42), None)));
+    } else if which == 4 {
+        s.push((1, claim(14, "==", Obs::Computed(2), None)));
+        s.push((0, claim(15, "==", Obs::Carrier(9), None)));
+    } else {
+        s.push((1, claim(16, "==", Obs::Same(9), None)));
+    }
+    s
+}
+
+fn code(r: Result<(), u32>) -> u32 {
+    match r {
+        Ok(()) => 0,
+        Err(e) => 1000 + e,
+    }
+}
+
+fn weigh(dims: &Vec<u32>) -> u32 {
+    let mut w = 0;
+    let mut i = 0;
+    while i < dims.len() {
+        w = w * 31 + dims[i];
+        i += 1;
+    }
+    w
+}
+
+/// Checks the sites of `which`, writes through a mutable borrow of the
+/// dimensions, then checks the sites of each node of a map in order.
+pub fn drive(which: u8) -> (u32, u32, u32, u32) {
+    let values = vec![0, 5, 1, 17, 23];
+    let mut dims = vec![1, 1, 1];
+    let r0 = sites_loop(&sites(which), &values, &mut dims);
+    let w0 = weigh(&dims);
+    let d = &mut dims;
+    d[0] += 100;
+    d.push(2);
+    let map = vec![sites(which), sites(0), sites(which + 1)];
+    let order = [1, 0, 2];
+    let r1 = node_loop(&map, &order, &values, &mut dims);
+    (code(r0), w0, code(r1), weigh(&dims))
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn drives() {
+        for which in 0u8..6 {
+            println!("{} {:?}", which, drive(which));
+        }
+    }
+}
