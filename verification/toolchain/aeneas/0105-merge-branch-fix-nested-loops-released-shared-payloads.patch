+import JoinDistinctSharedReborrows.JoinDistinctSharedReborrows
+open Aeneas Aeneas.Std Result
+
+/-! Evaluate the model of `tests/src/join-distinct-shared-reborrows.rs` on the
+    inputs of its `native` test module and compare with the native results
+    (rustc 1.97.1). The driver marks the vector through a mutable borrow,
+    writes through another one, marks again (observing the first write), then
+    stamps the vector given back by both marks. -/
+
+namespace join_distinct_shared_reborrows.checks
+
+def val4 (r : Result (U32 × U32 × U32 × U32)) : Option (Nat × Nat × Nat × Nat) :=
+  match r with
+  | ok (a, b, c, d) => some (a.val, b.val, c.val, d.val)
+  | _ => none
+
+def val (r : Result U32) : Option Nat :=
+  match r with
+  | ok a => some a.val
+  | _ => none
+
+-- native::drives
+#guard val4 (drive 0#u8) == some (1, 2, 27421, 2520)
+#guard val (stamp 0#u8) == some 1330
+#guard val4 (drive 1#u8) == some (0, 0, 5000, 12094105)
+#guard val (stamp 1#u8) == some 247230
+#guard val4 (drive 2#u8) == some (0, 2, 4931, 2420)
+#guard val (stamp 2#u8) == some 90007
+#guard val4 (drive 3#u8) == some (0, 2, 4981, 2420)
+#guard val (stamp 3#u8) == some 90009
+#guard val4 (drive 4#u8) == some (0, 0, 800, 1727714)
+#guard val (stamp 4#u8) == some 35323
+#guard val4 (drive 5#u8) == some (0, 0, 5000, 90012)
+#guard val (stamp 5#u8) == some 90012
+#guard val4 (drive 6#u8) == some (0, 0, 50, 246052)
+#guard val (stamp 6#u8) == some 5030
+
+end join_distinct_shared_reborrows.checks
