diff --git a/tests/src/join-shared-borrows-one-loan.rs b/tests/src/join-shared-borrows-one-loan.rs
new file mode 100644
index 0000000..80b2bd9
--- /dev/null
+++ b/tests/src/join-shared-borrows-one-loan.rs
@@ -0,0 +1,212 @@
+//@ [!lean] skip
+//@ [lean] subdir=JoinSharedBorrowsOneLoan
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Joins of two contexts in which two region abstractions hold distinct shared
+//! borrows of the same loan: the results of `get_meta(list)` and
+//! `children(list)`, both borrowed from `list`, live across a `match` on a
+//! string (the shape of `chelis_types::infer::expr::infer_lit`). The collapse
+//! of the join pairs each abstraction of one branch with the abstraction of
+//! the other branch which holds the same elements; pairing by the loan alone
+//! merged the two owners, and the joined context did not match.
+//! `Option` combinators are local copies of the ones of `core` (same
+//! signatures), which the Lean library does not model.
+
+pub enum Atom {
+    Int(i64),
+    Sym(String),
+}
+
+pub enum Expr {
+    Atom(Atom, u32),
+    Node(u32, Vec<Expr>),
+}
+
+pub struct Meta {
+    pub ty: Option<Expr>,
+}
+
+pub struct List {
+    pub meta: Option<Meta>,
+    pub kids: Vec<Expr>,
+}
+
+fn as_ref<T>(o: &Option<T>) -> Option<&T> {
+    match o {
+        Some(x) => Some(x),
+        None => None,
+    }
+}
+
+fn and_then<T, U, F: FnOnce(T) -> Option<U>>(o: Option<T>, f: F) -> Option<U> {
+    match o {
+        Some(x) => f(x),
+        None => None,
+    }
+}
+
+fn first<T>(xs: &[T]) -> Option<&T> {
+    if xs.is_empty() { None } else { Some(&xs[0]) }
+}
+
+fn get_meta(l: &List) -> Option<&Meta> {
+    as_ref(&l.meta)
+}
+
+fn children(l: &List) -> &[Expr] {
+    &l.kids
+}
+
+fn parts(e: &Expr) -> Option<(u32, &[Expr])> {
+    match e {
+        Expr::Node(t, k) => Some((*t, k)),
+        Expr::Atom(..) => None,
+    }
+}
+
+fn symbol_name(e: &Expr) -> Option<&str> {
+    match e {
+        Expr::Atom(Atom::Sym(s), _) => Some(s),
+        _ => None,
+    }
+}
+
+/// The width of the type of an out-of-range literal, or a code for the
+/// literal and its annotation.
+pub fn lit(list: &List) -> u32 {
+    let meta = get_meta(list);
+    let kids = children(list);
+    let value_atom = first(kids);
+    let meta_prim_name = and_then(and_then(meta, |m| as_ref(&m.ty)), |ty| match parts(ty) {
+        Some((3, prim_kids)) => and_then(first(prim_kids), symbol_name),
+        _ => None,
+    });
+    if let Some(prim_name) = meta_prim_name {
+        if let Some(Expr::Atom(Atom::Int(n), _)) = value_atom {
+            let range_check = match prim_name {
+                "i8" => Some(("i8", -128i64, 127i64)),
+                "i16" => Some(("i16", -32768, 32767)),
+                "i32" => Some(("i32", -2147483648, 2147483647)),
+                _ => None,
+            };
+            if let Some((dtype, lo, hi)) = range_check {
+                if *n < lo || *n > hi {
+                    return dtype.len() as u32;
+                }
+            }
+        }
+    }
+    let has_ty = match meta {
+        Some(m) => as_ref(&m.ty).is_some(),
+        None => false,
+    };
+    let atom = match value_atom {
+        Some(Expr::Atom(Atom::Int(_), _)) => 1,
+        Some(_) => 2,
+        None => 3,
+    };
+    if has_ty { atom + 10 } else { atom }
+}
+
+/// The same, counting the diagnostics in a sink given back to the caller.
+pub fn lit_counted(list: &List, errors: &mut Vec<u32>) -> u32 {
+    let meta = get_meta(list);
+    let kids = children(list);
+    let value_atom = first(kids);
+    let meta_prim_name = and_then(and_then(meta, |m| as_ref(&m.ty)), |ty| match parts(ty) {
+        Some((3, prim_kids)) => and_then(first(prim_kids), symbol_name),
+        _ => None,
+    });
+    if let Some(prim_name) = meta_prim_name {
+        if let Some(Expr::Atom(Atom::Int(n), _)) = value_atom {
+            let range_check = match prim_name {
+                "i8" => Some(("i8", -128i64, 127i64)),
+                "i16" => Some(("i16", -32768, 32767)),
+                "i32" => Some(("i32", -2147483648, 2147483647)),
+                _ => None,
+            };
+            if let Some((dtype, lo, hi)) = range_check {
+                if *n < lo || *n > hi {
+                    errors.push(dtype.len() as u32);
+                    return 0;
+                }
+            }
+        }
+    }
+    let atom = match value_atom {
+        Some(Expr::Atom(Atom::Int(_), _)) => 1,
+        Some(_) => 2,
+        None => 3,
+    };
+    if let Some(m) = meta {
+        if as_ref(&m.ty).is_none() {
+            errors.push(100 + atom);
+        }
+    }
+    atom
+}
+
+/// The literal of code [code]: an integer (5, 200, 40000, 3000000000 or
+/// -200), or a symbol for the other codes.
+fn list_of(prim: u32, code: u32) -> List {
+    let name = match prim {
+        0 => "i8",
+        1 => "i16",
+        2 => "i32",
+        _ => "f32",
+    };
+    let mut prim_kids = Vec::new();
+    prim_kids.push(Expr::Atom(Atom::Sym(String::from(name)), 0));
+    let ty = if prim == 5 { None } else { Some(Expr::Node(3, prim_kids)) };
+    let value = match code {
+        0 => Some(5i64),
+        1 => Some(200),
+        2 => Some(40000),
+        3 => Some(3000000000),
+        4 => Some(-200),
+        _ => None,
+    };
+    let mut kids = Vec::new();
+    match value {
+        Some(v) => kids.push(Expr::Atom(Atom::Int(v), 1)),
+        None => kids.push(Expr::Atom(Atom::Sym(String::from("x")), 1)),
+    }
+    let meta = if prim == 6 { None } else { Some(Meta { ty }) };
+    List { meta, kids }
+}
+
+pub fn drive_lit(prim: u32, code: u32) -> u32 {
+    lit(&list_of(prim, code))
+}
+
+/// The result, then the diagnostics given back through the sink after the
+/// caller pushed onto it: their number and sum.
+pub fn drive_lit_counted(prim: u32, code: u32) -> (u32, usize, u32) {
+    let list = list_of(prim, code);
+    let mut errors = Vec::new();
+    errors.push(7);
+    let r = lit_counted(&list, &mut errors);
+    errors.push(1);
+    let mut sum = 0;
+    let mut i = 0;
+    while i < errors.len() {
+        sum += errors[i];
+        i += 1;
+    }
+    (r, errors.len(), sum)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn drives() {
+        for prim in [0u32, 1, 2, 3, 5, 6] {
+            for code in [0u32, 1, 2, 3, 4, 5] {
+                println!("lit {} {} {}", prim, code, drive_lit(prim, code));
+                println!("lit_counted {} {} {:?}", prim, code, drive_lit_counted(prim, code));
+            }
+        }
+    }
+}
diff --git a/tests/src/join-shared-loan-erased-regions.rs b/tests/src/join-shared-loan-erased-regions.rs
new file mode 100644
index 0000000..0f85cad
--- /dev/null
+++ b/tests/src/join-shared-loan-erased-regions.rs
@@ -0,0 +1,154 @@
+//@ [!lean] skip
+//@ [lean] subdir=JoinSharedLoanErasedRegions
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Joins of a shared loan whose payload holds no borrows while its type does:
+//! the promoted `&[]` of type `&[View<'a>; 0]` borrowed in one branch of a
+//! loop body (the shape of `chelis_deep::metadata::walk`, which calls
+//! `check_entries(&meta, None, &[], Some(context))?` in some branches), and a
+//! local `[View<'a>; 1]` holding only a number, borrowed in one or both
+//! branches of an `if`. The fresh abstraction of the join borrows a value of
+//! type `[View<'_>; N]`, whose erased regions need witnesses.
+
+#[derive(Clone, Copy)]
+pub enum View<'a> {
+    Name(&'a str),
+    Num(u32),
+}
+
+fn weight(v: View<'_>) -> usize {
+    match v {
+        View::Name(s) => s.len(),
+        View::Num(k) => k as usize,
+    }
+}
+
+fn weigh(entries: &[View<'_>], extra: usize) -> usize {
+    let mut total = extra;
+    let mut i = 0;
+    while i < entries.len() {
+        total += weight(entries[i]);
+        i += 1;
+    }
+    total
+}
+
+fn check(entries: &[View<'_>], extra: usize, limit: usize) -> Result<usize, usize> {
+    let w = weigh(entries, extra);
+    if w > limit { Err(w) } else { Ok(w) }
+}
+
+/// An owned stack: `&[]` in two branches, one of which pushes.
+pub fn walk(mut stack: Vec<View<'_>>) -> usize {
+    let mut n = 0;
+    while let Some(v) = stack.pop() {
+        match v {
+            View::Name(s) => n += weigh(&[], s.len()),
+            View::Num(k) if k > 10 => {
+                n += weigh(&[], 1);
+                stack.push(View::Num(k / 2));
+            }
+            View::Num(k) => n += k as usize,
+        }
+    }
+    n
+}
+
+/// A borrowed stack, given back to the caller: `&[]` in one branch, a local
+/// array holding a number in another.
+pub fn walk_mut(stack: &mut Vec<View<'_>>, budget: usize) -> usize {
+    let mut n = 0;
+    let mut steps = 0;
+    while steps < budget {
+        let Some(v) = stack.pop() else { break };
+        steps += 1;
+        match v {
+            View::Name(s) => n += weigh(&[], s.len()),
+            View::Num(k) if k > 10 => {
+                n += weigh(&[View::Num(k % 7)], 0);
+                stack.push(View::Num(k / 2));
+            }
+            View::Num(k) => n += k as usize,
+        }
+    }
+    n
+}
+
+/// The `?` of `check_entries(.., &[], ..)?` in `walk`.
+pub fn walk_checked(mut stack: Vec<View<'_>>, limit: usize) -> Result<usize, usize> {
+    let mut n = 0;
+    while let Some(v) = stack.pop() {
+        match v {
+            View::Name(s) => n += check(&[], s.len(), limit)?,
+            View::Num(k) => n += k as usize,
+        }
+    }
+    Ok(n)
+}
+
+/// Not a loop: the promoted `&[]` joined with a borrowed local array.
+pub fn pick<'a>(b: bool, k: u32) -> usize {
+    let e: &[View<'a>] = if b { &[] } else { &[View::Num(k)] };
+    weigh(e, 3)
+}
+
+/// Not a loop: two distinct loans of the same local array.
+pub fn both<'a>(b: bool, k: u32) -> usize {
+    let a: [View<'a>; 1];
+    let e: &[View<'a>];
+    if b {
+        a = [View::Num(k)];
+        e = &a;
+    } else {
+        a = [View::Num(k + 1)];
+        e = &a;
+    }
+    weigh(e, 0)
+}
+
+fn stack_of<'a>(name: &'a str, a: u32, b: u32) -> Vec<View<'a>> {
+    let mut stack = Vec::new();
+    stack.push(View::Num(a));
+    stack.push(View::Name(name));
+    stack.push(View::Num(b));
+    stack
+}
+
+pub fn drive_walk(name: &str, a: u32, b: u32) -> usize {
+    walk(stack_of(name, a, b))
+}
+
+/// The count, then the stack given back by `walk_mut` after the caller pushed
+/// onto it: its length and weight.
+pub fn drive_walk_mut(name: &str, a: u32, b: u32, budget: usize) -> (usize, usize, usize) {
+    let mut stack = stack_of(name, a, b);
+    let n = walk_mut(&mut stack, budget);
+    stack.push(View::Num(100));
+    (n, stack.len(), weigh(&stack, 0))
+}
+
+pub fn drive_walk_checked(name: &str, a: u32, b: u32, limit: usize) -> Result<usize, usize> {
+    walk_checked(stack_of(name, a, b), limit)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn drives() {
+        for (name, a, b) in [("abc", 3u32, 4u32), ("", 25, 11), ("xy", 0, 40)] {
+            println!("walk {:?} {} {} {}", name, a, b, drive_walk(name, a, b));
+            for budget in [0usize, 2, 9] {
+                println!("walk_mut {:?} {} {} {} {:?}", name, a, b, budget, drive_walk_mut(name, a, b, budget));
+            }
+            for limit in [1usize, 5] {
+                println!("walk_checked {:?} {} {} {} {:?}", name, a, b, limit, drive_walk_checked(name, a, b, limit));
+            }
+        }
+        for (b, k) in [(true, 5u32), (false, 5), (false, 0)] {
+            println!("pick {} {} {}", b, k, pick(b, k));
+            println!("both {} {} {}", b, k, both(b, k));
+        }
+    }
+}
