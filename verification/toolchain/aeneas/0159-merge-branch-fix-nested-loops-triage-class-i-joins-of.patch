index 0000000..9d1eaed
--- /dev/null
+++ b/tests/src/loop-nested-mut-elements-sink.rs
@@ -0,0 +1,92 @@
+//@ [!lean] skip
+//@ [lean] subdir=LoopNestedMutElementsSink
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! A loop over `xs.iter_mut()` storing the element borrows `&'a mut u32` into
+//! a slot behind `&mut Sink<'_, 'a>` (a mutable borrow of a struct holding a
+//! mutable borrow of a struct holding borrows of region `'a`): the loop
+//! abstraction of `'a` has pending loans, and its continuation applies the
+//! call to `iter_mut` before the loop, whose backward function is not staged
+//! (the shape of `chelis_deep`'s `Metadata::visit_syntax` instantiated in
+//! `chelis_types`, annotations_transform.rs:284). The caller writes through
+//! the stored borrow after the call, then through the slot it owns.
+
+pub struct Slot<'a> {
+    pub last: Option<&'a mut u32>,
+    pub count: u32,
+}
+
+pub struct Sink<'b, 'a> {
+    pub slot: &'b mut Slot<'a>,
+}
+
+pub fn push<'b, 'a>(s: &mut Sink<'b, 'a>, e: &'a mut u32) {
+    s.slot.last = Some(e);
+    s.slot.count += 1;
+}
+
+pub fn visit<'a>(xs: &'a mut [u32], s: &mut Sink<'_, 'a>) {
+    for e in xs.iter_mut() {
+        push(s, e);
+    }
+}
+
+/// Only the even elements, after adding 1 to the others.
+pub fn visit_even<'a>(xs: &'a mut [u32], s: &mut Sink<'_, 'a>) {
+    for e in xs.iter_mut() {
+        if *e % 2 == 0 {
+            push(s, e);
+        } else {
+            *e += 1;
+        }
+    }
+}
+
+pub fn bump(s: &mut Sink<'_, '_>, k: u32) {
+    if let Some(last) = &mut s.slot.last {
+        **last += k;
+    }
+}
+
+pub fn double(slot: Slot<'_>) {
+    if let Some(last) = slot.last {
+        *last *= 2;
+    }
+}
+
+/// The slice given back after the caller wrote through the stored borrow,
+/// first through the sink, then through the slot.
+pub fn drive(a: u32, b: u32, c: u32, k: u32) -> (u32, u32, u32, u32) {
+    let mut xs = [a, b, c];
+    let mut slot = Slot { last: None, count: 0 };
+    let mut s = Sink { slot: &mut slot };
+    visit(&mut xs, &mut s);
+    bump(&mut s, k);
+    let n = slot.count;
+    double(slot);
+    (xs[0], xs[1], xs[2], n)
+}
+
+pub fn drive_even(a: u32, b: u32, c: u32, k: u32) -> (u32, u32, u32, u32) {
+    let mut xs = [a, b, c];
+    let mut slot = Slot { last: None, count: 10 };
+    let mut s = Sink { slot: &mut slot };
+    visit_even(&mut xs, &mut s);
+    bump(&mut s, k);
+    let n = slot.count;
+    double(slot);
+    (xs[0], xs[1], xs[2], n)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn drives() {
+        for (a, b, c, k) in [(1u32, 2u32, 3u32, 10u32), (4, 6, 8, 0), (5, 7, 9, 3), (2, 3, 5, 1)] {
+            println!("drive {} {} {} {} {:?}", a, b, c, k, drive(a, b, c, k));
+            println!("drive_even {} {} {} {} {:?}", a, b, c, k, drive_even(a, b, c, k));
+        }
+    }
