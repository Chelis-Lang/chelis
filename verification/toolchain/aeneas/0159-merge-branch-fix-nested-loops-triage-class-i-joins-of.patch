+//@ [!lean] skip
+//@ [lean] subdir=LoopSharedProjectionRelease
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Loops after a call which reborrows, through a shared borrow of a local
+//! `Option<Vec<&'a T>>`, the borrows `&'a T` inside it (`Option::as_ref`, whose
+//! result is consumed by a closure or a function), before the vector itself is
+//! moved into the iterator of the loop (the shape of
+//! `chelis_types::infer::app_tensor::conv_parameters`). Merging the region
+//! abstractions of the two calls leaves an abstraction holding only shared
+//! reborrows of the elements, whose lender is merged into the abstraction of
+//! the iterator: the loop fixed point and the match of the loop entry with it
+//! must release it. The `Option` combinators are local copies of the ones of
+//! `core` (same signatures), which the Lean library does not model.
+
+pub struct Native {
+    pub depth: u32,
+}
+
+pub struct Record {
+    pub first: Option<u32>,
+}
+
+/// Borrowed budget over two pieces of caller state (`StackBudget`).
+pub struct Budget<'a> {
+    native: &'a mut Native,
+    record: &'a mut Record,
+}
+
+fn extract(e: &u32, budget: &mut Budget<'_>) -> Option<i64> {
+    budget.native.depth += 1;
+    if *e == 0 {
+        if budget.record.first.is_none() {
+            budget.record.first = Some(budget.native.depth);
+        }
+        None
+    } else {
+        Some(*e as i64)
+    }
+}
+
+fn as_ref<T>(o: &Option<T>) -> Option<&T> {
+    match o {
+        Some(x) => Some(x),
+        None => None,
+    }
+}
+
+fn is_some_and<T, F: FnOnce(T) -> bool>(o: Option<T>, f: F) -> bool {
+    match o {
+        Some(x) => f(x),
+        None => false,
+    }
+}
+
+fn and_then<T, U, F: FnOnce(T) -> Option<U>>(o: Option<T>, f: F) -> Option<U> {
+    match o {
+        Some(x) => f(x),
+        None => None,
+    }
+}
+
+fn elements(e: &Vec<u32>) -> Option<Vec<&u32>> {
+    if e.is_empty() {
+        None
+    } else {
+        let mut out = Vec::new();
+        let mut i = 0;
+        while i < e.len() {
+            out.push(&e[i]);
+            i += 1;
+        }
+        Some(out)
+    }
+}
+
+fn count(o: Option<&Vec<&u32>>) -> usize {
+    match o {
+        Some(xs) => xs.len(),
+        None => 0,
+    }
+}
+
+/// The vector is consumed by the loop; its length was read through
+/// `as_ref` and a function.
+pub fn sum_counted(strides: Option<Vec<&u32>>) -> u32 {
+    let n = count(as_ref(&strides));
+    let Some(strides) = strides else {
+        return 0;
+    };
+    let mut total = n as u32;
+    for stride in strides.into_iter() {
+        total += *stride;
+    }
+    total
+}
+
+/// `as_ref` consumed by `is_some_and`, and a join in the loop body.
+pub fn weigh_checked(strides: Option<Vec<&u32>>, rank: usize) -> Result<u32, u32> {
+    if is_some_and(as_ref(&strides), |xs| xs.len() != rank) {
+        return Err(1);
+    }
+    let Some(strides) = strides else {
+        return Ok(0);
+    };
+    let mut total = 0;
+    for stride in strides.into_iter() {
+        if *stride == 3 {
+            total += 10;
+        } else {
+            total += *stride;
+        }
+    }
+    Ok(total)
+}
+
+/// `conv_parameters`: the budget is given back to the caller.
+pub fn conv(
+    strides: &Vec<u32>,
+    padding: &Vec<u32>,
+    rank: usize,
+    budget: &mut Budget<'_>,
+) -> Result<Option<Vec<(i64, i64, i64)>>, u32> {
+    let strides = elements(strides);
+    let padding = elements(padding);
+    if is_some_and(as_ref(&strides), |xs| xs.len() != rank)
+        || is_some_and(as_ref(&padding), |xs| xs.len() != rank)
+    {
+        return Err(1);
+    }
+    let (Some(strides), Some(padding)) = (strides, padding) else {
+        return Ok(None);
+    };
+    let mut result = Vec::with_capacity(rank);
+    let mut concrete = true;
+    for (axis, (stride, pad)) in strides.into_iter().zip(padding).enumerate() {
+        let pair = if *pad == 7 { None } else { Some(pad) };
+        let stride = extract(stride, budget);
+        let low = match pair {
+            Some(p) => extract(p, budget),
+            None => None,
+        };
+        let high = match pair {
+            Some(p) => and_then(extract(p, budget), |v| Some(v + 1)),
+            None => None,
+        };
+        if is_some_and(stride, |s| s > 100) {
+            return Err(10 + axis as u32);
+        }
+        if let (Some(stride), Some(low), Some(high)) = (stride, low, high) {
+            result.push((stride, low, high));
+        } else {
+            concrete = false;
+        }
+    }
+    Ok(concrete.then_some(result))
+}
+
+fn vec3(a: u32, b: u32, c: u32) -> Vec<u32> {
+    let mut v = Vec::new();
+    v.push(a);
+    v.push(b);
+    v.push(c);
+    v
+}
+
+pub fn drive_sum_counted(a: u32, b: u32, c: u32, some: bool) -> u32 {
+    let v = vec3(a, b, c);
+    let xs = if some { elements(&v) } else { None };
+    sum_counted(xs)
+}
+
+pub fn drive_weigh_checked(a: u32, b: u32, c: u32, rank: usize) -> Result<u32, u32> {
+    let v = vec3(a, b, c);
+    weigh_checked(elements(&v), rank)
+}
+
+/// The result (its length and the sum of its components, or `None`, or the
+/// error), then the state given back through the budget.
+pub fn drive_conv(
+    s: (u32, u32, u32),
+    p: (u32, u32, u32),
+    rank: usize,
+) -> (Result<Option<(usize, i64)>, u32>, u32, Option<u32>) {
+    let strides = vec3(s.0, s.1, s.2);
+    let padding = vec3(p.0, p.1, p.2);
+    let mut native = Native { depth: 0 };
+    let mut record = Record { first: None };
+    let mut budget = Budget {
+        native: &mut native,
+        record: &mut record,
+    };
+    let r = conv(&strides, &padding, rank, &mut budget);
+    let r = match r {
+        Ok(Some(xs)) => {
+            let mut sum = 0;
+            let mut i = 0;
+            while i < xs.len() {
+                sum += xs[i].0 + xs[i].1 + xs[i].2;
+                i += 1;
+            }
+            Ok(Some((xs.len(), sum)))
+        }
+        Ok(None) => Ok(None),
+        Err(e) => Err(e),
+    };
+    (r, native.depth, record.first)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn drives() {
+        for (a, b, c) in [(1u32, 2u32, 3u32), (0, 5, 3), (4, 4, 4)] {
+            for some in [true, false] {
+                println!("sum_counted {} {} {} {} {}", a, b, c, some, drive_sum_counted(a, b, c, some));
+            }
+            for rank in [2usize, 3] {
+                println!("weigh_checked {} {} {} {} {:?}", a, b, c, rank, drive_weigh_checked(a, b, c, rank));
+            }
+        }
+        for (s, p, rank) in [
+            ((1u32, 2u32, 3u32), (4u32, 5u32, 6u32), 3usize),
+            ((1, 0, 3), (4, 5, 6), 3),
+            ((1, 2, 3), (4, 7, 0), 3),
+            ((1, 200, 3), (4, 5, 6), 3),
+            ((1, 2, 3), (4, 5, 6), 2),
+        ] {
+            println!("conv {:?} {:?} {} {:?}", s, p, rank, drive_conv(s, p, rank));
+        }
+    }
+}
