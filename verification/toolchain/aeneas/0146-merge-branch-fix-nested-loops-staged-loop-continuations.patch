@@ -0,0 +1,82 @@
+import LoopStagedExits.LoopStagedExits
+
+/-! Evaluate the model of `tests/src/loop-staged-exits.rs` on the inputs of
+    its `native` test module and compare with the native results
+    `(result, ctx, pos)`: `pos` is the frame given back through the `&mut`
+    (the forward output), `ctx` the value of the frame's region given back by
+    the backward function of that region when the caller gives the frame back
+    (after setting its `ctx` to `set`, if any). -/
+
+namespace loop_staged_exits.checks
+open Aeneas Aeneas.Std Result
+
+def u (x : Nat) : U32 := ⟨BitVec.ofNat _ x⟩
+def us (x : Nat) : Usize := ⟨BitVec.ofNat _ x⟩
+
+def max := 4294967295
+
+def sl (xs : List Nat) (h : xs.length ≤ Usize.max := by scalar_tac) : Slice U32 :=
+  ⟨xs.map u, by simpa using h⟩
+
+def bs (xs : List Bool) (h : xs.length ≤ Usize.max := by scalar_tac) : Slice Bool :=
+  ⟨xs, h⟩
+
+def frame (ctx pos : Nat) : Frame := { steps := sl [3, 5, 7, 11], ctx := u ctx, pos := us pos }
+
+/-- `Ok v` as `.inl v`, `Err e` as `.inr e` -/
+def res : core.result.Result U32 U32 → Sum Nat Nat
+  | .Ok v => .inl v.val
+  | .Err e => .inr e.val
+
+/-- `run (&mut frame)`; the caller then sets the frame's `ctx` to `set` (if
+    any) and gives the frame back -/
+def onFrame (run : Frame → Result (core.result.Result U32 U32 × Frame × (Frame → Frame)))
+    (ctx pos : Nat) (set : Option Nat := none) : Option (Sum Nat Nat × Nat × Nat) :=
+  match run (frame ctx pos) with
+  | ok (r, f1, back) =>
+    let f1' := match set with
+      | some c => { f1 with ctx := u c }
+      | none => f1
+    some (res r, (back f1').ctx.val, f1.pos.val)
+  | _ => none
+
+-- checked_iflet_native
+#guard onFrame (run_checked_iflet · true (sl []) (u 0)) 10 0 == some (.inl 0, 10, 0)
+#guard onFrame (run_checked_iflet · true (sl [1, 2]) (u 3)) 10 0 == some (.inl 15, 25, 3)
+#guard onFrame (run_checked_iflet · true (sl [1]) (u 3)) 10 1 == some (.inl 23, 33, 4)
+#guard onFrame (run_checked_iflet · false (sl [1]) (u 3)) 10 1 == some (.inl 0, 10, 1)
+#guard onFrame (run_checked_iflet · true (sl [1, 7]) (u 3)) 10 0 == some (.inr 1, 10, 0)
+#guard onFrame (run_checked_iflet · true (sl [1, 7]) (u 3)) 10 0 (set := some 99) == some (.inr 1, 99, 0)
+#guard onFrame (run_checked_iflet · true (sl []) (u 2)) 10 1 (set := some 99) == some (.inl 12, 99, 3)
+#guard onFrame (run_checked_iflet · true (sl [2]) (u 2)) max 0 == some (.inl 8, 7, 2)
+
+-- checked_nodes_native
+#guard onFrame (run_checked_nodes · true (sl []) (sl [])) 10 0 == some (.inl 0, 10, 0)
+#guard onFrame (run_checked_nodes · true (sl [1]) (sl [4, 5])) 10 0 == some (.inl 12, 40, 2)
+#guard onFrame (run_checked_nodes · true (sl [1]) (sl [4, 5, 6])) 10 2 == some (.inl 27, 80, 5)
+#guard onFrame (run_checked_nodes · false (sl [1]) (sl [4, 5, 6])) 10 2 == some (.inl 15, 10, 2)
+#guard onFrame (run_checked_nodes · true (sl [1]) (sl [4, 99, 5])) 10 0 == some (.inr 20, 20, 1)
+#guard onFrame (run_checked_nodes · true (sl [1]) (sl [4, 99, 5])) 10 0 (set := some 77) == some (.inr 20, 77, 1)
+#guard onFrame (run_checked_nodes · true (sl [7]) (sl [4, 5])) 10 0 == some (.inr 1, 10, 0)
+#guard onFrame (run_checked_nodes · true (sl [3, 7]) (sl [4, 5])) 10 0 (set := some 77) == some (.inr 1, 77, 0)
+#guard onFrame (run_checked_nodes · true (sl []) (sl [4])) 10 1 (set := some 99) == some (.inl 6, 99, 2)
+#guard onFrame (run_checked_nodes · true (sl []) (sl [1, 2])) max 0 == some (.inl 6, 4294967292, 2)
+
+-- checked_eval_native
+#guard onFrame (run_checked_eval · (sl []) (bs []) (sl []) (u 0)) 10 0 == some (.inl 0, 10, 0)
+#guard onFrame (run_checked_eval · (sl [1]) (bs [true, false, false]) (sl [3, 4, 5]) (u 0)) 10 0
+  == some (.inl 14, 52, 3)
+#guard onFrame (run_checked_eval · (sl [1]) (bs [false, true, false]) (sl [4, 3, 5]) (u 0)) 10 0
+  (set := some 9) == some (.inl 13, 9, 3)
+#guard onFrame (run_checked_eval · (sl [1]) (bs [true, true]) (sl [3, 0]) (u 0)) 10 0
+  == some (.inr 10, 13, 1)
+#guard onFrame (run_checked_eval · (sl [1]) (bs [false, false]) (sl [4, 99]) (u 0)) 10 0
+  == some (.inr 20, 20, 1)
+#guard onFrame (run_checked_eval · (sl [1]) (bs [true, false]) (sl [3, 4]) (u 6)) 10 0
+  == some (.inr 2, 13, 1)
+#guard onFrame (run_checked_eval · (sl [1]) (bs [true, false]) (sl [3, 4]) (u 6)) 10 0
+  (set := some 5) == some (.inr 2, 5, 1)
+#guard onFrame (run_checked_eval · (sl [7]) (bs [true, false]) (sl [3, 4]) (u 0)) 10 0
+  (set := some 5) == some (.inr 1, 5, 0)
+
+end loop_staged_exits.checks
