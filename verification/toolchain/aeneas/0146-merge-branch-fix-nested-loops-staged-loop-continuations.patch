@@ -0,0 +1,251 @@
+//@ [!lean] skip
+//@ [lean] subdir=LoopStagedExits
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::option::{core::option::Option} --include core::ops::deref::{core::ops::deref::Deref} --include core::ops::deref::{core::ops::deref::DerefMut}
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! A returning loop followed by a loop over `execution.as_deref_mut()` on
+//! `Option<&'1 mut Frame<'2>>` (the shape of
+//! `chelis_ir::eval::eval_tensor_internal_with_result_claims`). The
+//! continuation of the returning loop (the node loop) is copied onto its
+//! `break`, so the node loop is nested in the body of the first loop, which
+//! never touches the frame. The loop abstraction of the frame's region in the
+//! node loop is staged at level 1 (the first stage of `as_deref_mut` routes the
+//! inner borrows of the frame). Its exit abstraction flows, through the `break`
+//! of the first loop, into the exit of the first loop, which must then be
+//! staged at level 1 as well:
+//! - `checked_iflet`: the node loop's exit abstraction is applied directly by
+//!   the abstraction at that `break`;
+//! - `checked_nodes`: the node loop returns through `?`, so its exits and the
+//!   early return of the first loop are joined before the `break`: the
+//!   abstractions of that join apply the staged continuation of the node loop;
+//! - `checked_eval`: both, with `continue`s and a second early return in the
+//!   node loop.
+
+pub struct Frame<'a> {
+    pub steps: &'a [u32],
+    pub ctx: &'a mut u32,
+    pub pos: usize,
+}
+
+impl<'a> Frame<'a> {
+    pub fn advance(&mut self) -> u32 {
+        let s = self.steps[self.pos];
+        self.pos += 1;
+        *self.ctx = (*self.ctx).wrapping_add(s);
+        s
+    }
+
+    pub fn control(&mut self, c: u32) -> Result<(), u32> {
+        if c == 0 {
+            return Err(10);
+        }
+        *self.ctx = (*self.ctx).wrapping_add(c);
+        self.pos += 1;
+        Ok(())
+    }
+}
+
+pub fn node_value(execution: Option<&mut Frame<'_>>, id: u32) -> Result<u32, u32> {
+    match execution {
+        Some(f) => {
+            if id == 99 {
+                return Err(20);
+            }
+            *f.ctx = (*f.ctx).wrapping_mul(2);
+            f.pos += 1;
+            Ok(id.wrapping_add(f.pos as u32))
+        }
+        None => Ok(id),
+    }
+}
+
+pub fn checked_iflet(
+    checks: &[u32],
+    mut execution: Option<&mut Frame<'_>>,
+    n: u32,
+) -> Result<u32, u32> {
+    let mut i = 0;
+    while i < checks.len() {
+        if checks[i] == 7 {
+            return Err(1);
+        }
+        i += 1;
+    }
+    let mut acc = 0u32;
+    let mut j = 0;
+    while j < n {
+        if let Some(f) = execution.as_deref_mut() {
+            acc = acc.wrapping_add(f.advance());
+        }
+        j += 1;
+    }
+    Ok(acc)
+}
+
+pub fn checked_nodes(
+    checks: &[u32],
+    mut execution: Option<&mut Frame<'_>>,
+    ids: &[u32],
+) -> Result<u32, u32> {
+    let mut i = 0;
+    while i < checks.len() {
+        if checks[i] == 7 {
+            return Err(1);
+        }
+        i += 1;
+    }
+    let mut acc = 0u32;
+    let mut j = 0;
+    while j < ids.len() {
+        let id = ids[j];
+        j += 1;
+        acc = acc.wrapping_add(node_value(execution.as_deref_mut(), id)?);
+    }
+    Ok(acc)
+}
+
+pub fn checked_eval(
+    checks: &[u32],
+    mut execution: Option<&mut Frame<'_>>,
+    kinds: &[bool],
+    ids: &[u32],
+    cancel: &u32,
+) -> Result<u32, u32> {
+    let mut i = 0;
+    while i < checks.len() {
+        if checks[i] == 7 {
+            return Err(1);
+        }
+        i += 1;
+    }
+    let mut acc = 0u32;
+    let mut j = 0;
+    while j < ids.len() {
+        let id = ids[j];
+        j += 1;
+        if kinds[j - 1] {
+            execution.as_deref_mut().expect("controls").control(id)?;
+            continue;
+        }
+        if *cancel > 5 {
+            return Err(2);
+        }
+        acc = acc.wrapping_add(node_value(execution.as_deref_mut(), id)?);
+    }
+    Ok(acc)
+}
+
+pub fn run_checked_iflet(f: &mut Frame<'_>, some: bool, checks: &[u32], n: u32) -> Result<u32, u32> {
+    if some { checked_iflet(checks, Some(f), n) } else { checked_iflet(checks, None, n) }
+}
+
+pub fn run_checked_nodes(
+    f: &mut Frame<'_>,
+    some: bool,
+    checks: &[u32],
+    ids: &[u32],
+) -> Result<u32, u32> {
+    if some { checked_nodes(checks, Some(f), ids) } else { checked_nodes(checks, None, ids) }
+}
+
+pub fn run_checked_eval(
+    f: &mut Frame<'_>,
+    checks: &[u32],
+    kinds: &[bool],
+    ids: &[u32],
+    cancel: u32,
+) -> Result<u32, u32> {
+    checked_eval(checks, Some(f), kinds, ids, &cancel)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    /// `(result, ctx, pos)` after running `run` on a frame over `steps`, the
+    /// caller then setting the frame's `ctx` to `set` (if any)
+    fn on_frame<R>(
+        ctx: u32,
+        pos: usize,
+        set: Option<u32>,
+        run: impl FnOnce(&mut Frame<'_>) -> R,
+    ) -> (R, u32, usize) {
+        let steps = [3u32, 5, 7, 11];
+        let mut c = ctx;
+        let mut f = Frame { steps: &steps, ctx: &mut c, pos };
+        let r = run(&mut f);
+        if let Some(s) = set {
+            *f.ctx = s;
+        }
+        let pos = f.pos;
+        (r, c, pos)
+    }
+
+    #[test]
+    fn checked_iflet_native() {
+        let run = |some, checks: &'static [u32], n| {
+            move |f: &mut Frame<'_>| run_checked_iflet(f, some, checks, n)
+        };
+        assert_eq!(on_frame(10, 0, None, run(true, &[], 0)), (Ok(0), 10, 0));
+        assert_eq!(on_frame(10, 0, None, run(true, &[1, 2], 3)), (Ok(15), 25, 3));
+        assert_eq!(on_frame(10, 1, None, run(true, &[1], 3)), (Ok(23), 33, 4));
+        assert_eq!(on_frame(10, 1, None, run(false, &[1], 3)), (Ok(0), 10, 1));
+        assert_eq!(on_frame(10, 0, None, run(true, &[1, 7], 3)), (Err(1), 10, 0));
+        assert_eq!(on_frame(10, 0, Some(99), run(true, &[1, 7], 3)), (Err(1), 99, 0));
+        assert_eq!(on_frame(10, 1, Some(99), run(true, &[], 2)), (Ok(12), 99, 3));
+        assert_eq!(on_frame(u32::MAX, 0, None, run(true, &[2], 2)), (Ok(8), 7, 2));
+    }
+
+    #[test]
+    fn checked_nodes_native() {
+        let run = |some, checks: &'static [u32], ids: &'static [u32]| {
+            move |f: &mut Frame<'_>| run_checked_nodes(f, some, checks, ids)
+        };
+        assert_eq!(on_frame(10, 0, None, run(true, &[], &[])), (Ok(0), 10, 0));
+        assert_eq!(on_frame(10, 0, None, run(true, &[1], &[4, 5])), (Ok(12), 40, 2));
+        assert_eq!(on_frame(10, 2, None, run(true, &[1], &[4, 5, 6])), (Ok(27), 80, 5));
+        assert_eq!(on_frame(10, 2, None, run(false, &[1], &[4, 5, 6])), (Ok(15), 10, 2));
+        assert_eq!(on_frame(10, 0, None, run(true, &[1], &[4, 99, 5])), (Err(20), 20, 1));
+        assert_eq!(on_frame(10, 0, Some(77), run(true, &[1], &[4, 99, 5])), (Err(20), 77, 1));
+        assert_eq!(on_frame(10, 0, None, run(true, &[7], &[4, 5])), (Err(1), 10, 0));
+        assert_eq!(on_frame(10, 0, Some(77), run(true, &[3, 7], &[4, 5])), (Err(1), 77, 0));
+        assert_eq!(on_frame(10, 1, Some(99), run(true, &[], &[4])), (Ok(6), 99, 2));
+        assert_eq!(on_frame(u32::MAX, 0, None, run(true, &[], &[1, 2])), (Ok(6), 4294967292, 2));
+    }
+
+    #[test]
+    fn checked_eval_native() {
+        let run =
+            |checks: &'static [u32], kinds: &'static [bool], ids: &'static [u32], cancel| {
+                move |f: &mut Frame<'_>| run_checked_eval(f, checks, kinds, ids, cancel)
+            };
+        assert_eq!(on_frame(10, 0, None, run(&[], &[], &[], 0)), (Ok(0), 10, 0));
+        assert_eq!(
+            on_frame(10, 0, None, run(&[1], &[true, false, false], &[3, 4, 5], 0)),
+            (Ok(14), 52, 3)
+        );
+        assert_eq!(
+            on_frame(10, 0, Some(9), run(&[1], &[false, true, false], &[4, 3, 5], 0)),
+            (Ok(13), 9, 3)
+        );
+        assert_eq!(
+            on_frame(10, 0, None, run(&[1], &[true, true], &[3, 0], 0)),
+            (Err(10), 13, 1)
+        );
+        assert_eq!(
+            on_frame(10, 0, None, run(&[1], &[false, false], &[4, 99], 0)),
+            (Err(20), 20, 1)
+        );
+        assert_eq!(
+            on_frame(10, 0, None, run(&[1], &[true, false], &[3, 4], 6)),
+            (Err(2), 13, 1)
+        );
+        assert_eq!(
+            on_frame(10, 0, Some(5), run(&[1], &[true, false], &[3, 4], 6)),
+            (Err(2), 5, 1)
+        );
+        assert_eq!(
+            on_frame(10, 0, Some(5), run(&[7], &[true, false], &[3, 4], 0)),
+            (Err(1), 5, 0)
+        );
+    }
+}
