+pub fn view_weight(v: RawView<'_>) -> u32 {
+    match v {
+        RawView::Name(n) => n,
+        RawView::Raw(Raw::Sym(n)) => n.wrapping_mul(10),
+        RawView::Raw(Raw::Items(items)) => (items.len() as u32).wrapping_mul(100),
+        RawView::Raw(Raw::Meta { span, .. }) => span.wrapping_add(1000),
+    }
+}
+
+pub fn parts_weight(v: RawView<'_>) -> u32 {
+    match raw_parts(v) {
+        Some(p) => view_weight(p[0]).wrapping_mul(3).wrapping_add(view_weight(p[1])),
+        None => 7,
+    }
+}
