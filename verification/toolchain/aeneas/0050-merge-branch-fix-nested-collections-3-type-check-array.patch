diff --git a/src/pure/PureTypeCheck.ml b/src/pure/PureTypeCheck.ml
index cb41d40..74360a4 100644
--- a/src/pure/PureTypeCheck.ml
+++ b/src/pure/PureTypeCheck.ml
@@ -245,6 +245,26 @@ let rec check_texpr (span : Meta.span) (ctx : tc_ctx) (e : texpr) : unit =
           in
           let expected_field_ty = FieldId.nth expected_field_tys field_id in
           [%pure_type_check] span (expected_field_ty = field_ty)
+      | AdtCons { adt_id = TBuiltin TArray; variant_id } -> (
+          (* Array literal (the translation of a concrete array value, e.g.,
+             the array of [vec![...]] when its elements hold borrows): its
+             fields all have the element type, and there are as many fields as
+             the length of the array, when the length is a constant *)
+          [%pure_type_check] span (variant_id = None);
+          let field_tys, adt_ty = destruct_arrows e.ty in
+          [%pure_type_check] span
+            (adt_ty = TAdt (TBuiltin TArray, qualif.generics));
+          match qualif.generics with
+          | { types = [ elem ]; const_generics = [ len ]; trait_refs = [] } -> (
+              List.iter
+                (fun ty -> [%pure_type_check] span (ty = elem))
+                field_tys;
+              match len with
+              | CgValue (VScalar (UnsignedScalar (_, len))) ->
+                  [%pure_type_check] span
+                    (Z.equal len (Z.of_int (List.length field_tys)))
+              | _ -> ())
+          | _ -> [%craise] span "Ill-formed array type")
       | AdtCons id -> (
           let expected_field_tys =
             get_adt_field_types span ctx.type_decls id.adt_id id.variant_id
