+/// Arrays of values which hold borrows, built in a body whose patterns the
+/// pass updates (the shape of `chelis_deep::metadata::View::{list, parts}`,
+/// whose `vec![...]` builds such an array). The interpreter keeps these
+/// arrays concrete, so they are translated to array literals, i.e.,
+/// constructors applied to the elements, which the type check of the updated
+/// bodies must accept.
+pub fn raw_parts<'a>(v: RawView<'a>) -> Option<[RawView<'a>; 2]> {
+    match v {
+        RawView::Raw(Raw::Items(items)) => Some([RawView::Name(items.len() as u32), v]),
+        RawView::Raw(Raw::Meta { expr, span, .. }) => {
+            Some([RawView::Name(*span), RawView::Raw(expr)])
+        }
+        _ => None,
+    }
+}
