@@ -0,0 +1,73 @@
+import JoinFrozenInputLoan.JoinFrozenInputLoan
+
+/-! Evaluate the model of `tests/src/join-frozen-input-loan.rs` on the inputs
+    of its `native` test module and compare with the native results. For
+    `tally` and `tally_all`, the second component is the count given back
+    through the `&mut` (the caller then writes `set` through it, if any, and
+    reads it). -/
+
+namespace join_frozen_input_loan.checks
+open Aeneas Aeneas.Std Result
+
+def u (x : Nat) : U32 := ⟨BitVec.ofNat _ x⟩
+
+def max := 4294967295
+
+def unit (kind : UnitKind) (body : Option Nat) (entry : Nat) : Unit :=
+  { «name» := u 7, kind, body := body.map (fun e => { entry := u e }), entry := u entry }
+
+def a := unit .Roots none 3
+def b := unit .Roots (some 5) 4
+def c := unit .Function (some 6) 8
+def d := unit .Function none 9
+
+def res (r : Result U32) : Option Nat :=
+  match r with
+  | ok x => some x.val
+  | _ => none
+
+def resE (r : Result (core.result.Result U32 U32)) : Option (Except Nat Nat) :=
+  match r with
+  | ok (.Ok x) => some (.ok x.val)
+  | ok (.Err e) => some (.error e.val)
+  | _ => none
+
+/-- `run(&mut count)`, then the caller writes `set` (if any) through the
+    reference given back, then reads the count -/
+def onCount (run : U32 → Result (U32 × U32)) (count : Nat) (set : Option Nat := none) :
+    Option (Nat × Nat) :=
+  match run (u count) with
+  | ok (r, c1) => some (r.val, (set.getD c1.val))
+  | _ => none
+
+def sl (xs : List Unit) (h : xs.length ≤ Usize.max := by scalar_tac) : Slice Unit :=
+  ⟨xs, h⟩
+
+-- agree_or_entry_native
+#guard res (agree_or_entry a) == some 1
+#guard res (agree_or_entry b) == some 4
+#guard res (agree_or_entry c) == some 1
+#guard res (agree_or_entry d) == some 9
+
+-- check_kind_native
+#guard resE (check_kind a) == some (.ok 3)
+#guard resE (check_kind b) == some (.error 7)
+#guard resE (check_kind c) == some (.ok 8)
+#guard resE (check_kind d) == some (.error 7)
+
+-- tally_native
+#guard onCount (tally a) 10 == some (0, 11)
+#guard onCount (tally b) 10 == some (5, 14)
+#guard onCount (tally c) 10 == some (6, 11)
+#guard onCount (tally d) 10 == some (0, 19)
+#guard onCount (tally b) max == some (5, 3)
+#guard onCount (tally b) 10 (set := some 42) == some (5, 42)
+
+-- tally_all_native
+#guard onCount (tally_all (sl [a, b, c, d])) 0 == some (11, 215)
+#guard onCount (tally_all (sl [a])) 0 == some (0, 1)
+#guard onCount (tally_all (sl [b, c])) 0 == some (11, 105)
+#guard onCount (tally_all (sl [])) 0 == some (0, 0)
+#guard onCount (tally_all (sl [a, b, c, d])) 0 (set := some 5) == some (11, 5)
+
+end join_frozen_input_loan.checks
