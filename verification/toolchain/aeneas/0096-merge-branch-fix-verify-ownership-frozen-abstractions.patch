+import LoopExitBindings.LoopExitBindings
+
+/-! Evaluate the model of `tests/src/loop-exit-bindings.rs` on the inputs of
+    its `native` test module and compare with the native results. For `scan`,
+    the second component is the count given back through the `&mut` (the
+    caller then writes `set` through it, if any, and reads it). -/
+
+namespace loop_exit_bindings.checks
+open Aeneas Aeneas.Std Result
+
+def u (x : Nat) : U32 := ⟨BitVec.ofNat _ x⟩
+
+def max := 4294967295
+
+def vec {α} (xs : List α) (h : xs.length ≤ Usize.max := by simp <;> scalar_tac) : alloc.vec.Vec α := ⟨xs, h⟩
+
+def edge (n : Nat) (h : n ≤ Usize.max := by scalar_tac) : Edge :=
+  { terminals := ⟨List.replicate n (u 0), by simp; scalar_tac⟩ }
+
+/-- A unit with one block whose edges have the given numbers of terminals -/
+def unit (canonical : Bool) (provisional : Option Nat) (edges : List Edge) (owners : Nat)
+    (h0 : edges.length ≤ Usize.max := by simp <;> scalar_tac) (h1 : owners ≤ Usize.max := by scalar_tac) : Unit :=
+  { canonical
+    provisional := provisional.map u
+    blocks := vec [{ edges := ⟨edges, h0⟩ }]
+    owners := ⟨List.replicate owners (u 0), by simp; scalar_tac⟩ }
+
+def sl (xs : List Unit) (h : xs.length ≤ Usize.max := by simp <;> scalar_tac) : Slice Unit := ⟨xs, h⟩
+
+def resE (r : Result (core.result.Result U32 U32)) : Option (Except Nat Nat) :=
+  match r with
+  | ok (.Ok x) => some (.ok x.val)
+  | ok (.Err e) => some (.error e.val)
+  | _ => none
+
+/-- `run(&mut seen)`, then the caller writes `set` (if any) through the
+    reference given back, then reads the count -/
+def onSeen (run : U32 → Result (core.result.Result U32 U32 × U32)) (seen : Nat)
+    (set : Option Nat := none) : Option (Except Nat Nat × Nat) :=
+  match run (u seen) with
+  | ok (r, s1) =>
+    let r := match r with
+      | .Ok x => Except.ok x.val
+      | .Err e => Except.error e.val
+    some (r, set.getD s1.val)
+  | _ => none
+
+-- verify_native
+#guard resE (verify (sl [])) == some (.ok 0)
+#guard resE (verify (sl [unit false none [edge 1, edge 2] 2, unit false none [edge 0] 0])) == some (.ok 4)
+#guard resE (verify (sl [unit false none [edge 1] 1, unit false (some 5) [] 2])) == some (.error 8)
+#guard resE (verify (sl [unit false none [edge 1] 1, unit false none [edge 2, edge 3] 1])) == some (.error 100)
+#guard resE (verify (sl [unit false none [edge 1] 4])) == some (.error 1)
+
+-- scan_native
+#guard onSeen (scan (sl [])) 0 == some (.ok 0, 0)
+#guard onSeen (scan (sl [unit false none [edge 1, edge 2] 2, unit false none [edge 0] 0])) 10
+  == some (.ok 4, 13)
+#guard onSeen (scan (sl [unit false none [edge 1] 1, unit true none [edge 1] 2])) 10 == some (.error 3, 11)
+#guard onSeen (scan (sl [unit false none [edge 1, edge 3, edge 1] 0])) 10 == some (.error 200, 12)
+#guard onSeen (scan (sl [unit false none [edge 1] 0])) max == some (.ok 1, 0)
+#guard onSeen (scan (sl [unit false none [edge 1] 4])) 0 == some (.error 1, 0)
+#guard onSeen (scan (sl [unit false none [edge 1, edge 3, edge 1] 0])) 10 (set := some 7) == some (.error 200, 7)
+
+end loop_exit_bindings.checks
