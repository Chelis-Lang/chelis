diff --git a/tests/src/join-frozen-input-loan.rs b/tests/src/join-frozen-input-loan.rs
new file mode 100644
index 0000000..14a8810
--- /dev/null
+++ b/tests/src/join-frozen-input-loan.rs
@@ -0,0 +1,152 @@
+//@ [!lean] skip
+//@ [lean] subdir=JoinFrozenInputLoan
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::option::{core::option::Option}
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! A join after matching a copy of a field read through a shared borrow of
+//! the input (`matches!((u.kind, u.body), ..)` in chelis-ir's
+//! `ownership::verify::verify_unit`). Expanding the copied field also expands
+//! the field inside the shared loan of the input's (frozen) region
+//! abstraction, so the branches of the inner match give that loan value
+//! different values (`None` / `Some(_)`) and the join gives it a fresh symbolic
+//! value, which is an output of the join. The contexts of the branches used to
+//! be matched with the joined context without mapping that value ("Could not
+//! find symbolic value .. in src_to_joined_map"): the fixed abstractions are
+//! now matched with themselves, value by value.
+//!
+//! JoinFrozenInputLoan/Checks.lean compares the model with the native results
+//! asserted in the native test module, including the value the caller writes
+//! through the `&mut` given back after the join (`tally`) and after the loop
+//! (`tally_all`).
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+pub enum UnitKind {
+    Roots,
+    Function,
+}
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+pub struct Body {
+    pub entry: u32,
+}
+
+pub struct Unit {
+    pub name: u32,
+    pub kind: UnitKind,
+    pub body: Option<Body>,
+    pub entry: u32,
+}
+
+/// The join is followed by a read of the input.
+pub fn agree_or_entry(u: &Unit) -> u32 {
+    if matches!((u.kind, u.body), (UnitKind::Roots, None) | (UnitKind::Function, Some(_))) {
+        1
+    } else {
+        u.entry
+    }
+}
+
+/// The shape of `verify_unit`: an early error, then a read of the input.
+pub fn check_kind(u: &Unit) -> Result<u32, u32> {
+    if !matches!((u.kind, u.body), (UnitKind::Roots, None) | (UnitKind::Function, Some(_))) {
+        return Err(u.name);
+    }
+    Ok(u.entry)
+}
+
+/// The join also updates a mutable borrow the caller gives back.
+pub fn tally(u: &Unit, count: &mut u32) -> u32 {
+    let agree = matches!((u.kind, u.body), (UnitKind::Roots, None) | (UnitKind::Function, Some(_)));
+    if agree {
+        *count = count.wrapping_add(1);
+    } else {
+        *count = count.wrapping_add(u.entry);
+    }
+    match u.body {
+        Some(b) => b.entry,
+        None => 0,
+    }
+}
+
+/// The same join inside a loop over the units.
+pub fn tally_all(units: &[Unit], count: &mut u32) -> u32 {
+    let mut entries = 0u32;
+    for u in units {
+        entries = entries.wrapping_add(tally(u, count));
+        if !matches!((u.kind, u.body), (UnitKind::Roots, None) | (UnitKind::Function, Some(_))) {
+            *count = count.wrapping_add(100);
+        }
+    }
+    entries
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    fn unit(kind: UnitKind, body: Option<u32>, entry: u32) -> Unit {
+        Unit { name: 7, kind, body: body.map(|entry| Body { entry }), entry }
+    }
+
+    fn units() -> [Unit; 4] {
+        [
+            unit(UnitKind::Roots, None, 3),
+            unit(UnitKind::Roots, Some(5), 4),
+            unit(UnitKind::Function, Some(6), 8),
+            unit(UnitKind::Function, None, 9),
+        ]
+    }
+
+    #[test]
+    fn agree_or_entry_native() {
+        let [a, b, c, d] = units();
+        assert_eq!(agree_or_entry(&a), 1);
+        assert_eq!(agree_or_entry(&b), 4);
+        assert_eq!(agree_or_entry(&c), 1);
+        assert_eq!(agree_or_entry(&d), 9);
+    }
+
+    #[test]
+    fn check_kind_native() {
+        let [a, b, c, d] = units();
+        assert_eq!(check_kind(&a), Ok(3));
+        assert_eq!(check_kind(&b), Err(7));
+        assert_eq!(check_kind(&c), Ok(8));
+        assert_eq!(check_kind(&d), Err(7));
+    }
+
+    /// `run(&mut count)`, then the caller writes `set` (if any) through the
+    /// reference given back, then reads the count
+    fn on_count<R>(count: u32, set: Option<u32>, run: impl FnOnce(&mut u32) -> R) -> (R, u32) {
+        let mut c = count;
+        let r = {
+            let rc = &mut c;
+            let r = run(&mut *rc);
+            if let Some(v) = set {
+                *rc = v;
+            }
+            r
+        };
+        (r, c)
+    }
+
+    #[test]
+    fn tally_native() {
+        let [a, b, c, d] = units();
+        assert_eq!(on_count(10, None, |n| tally(&a, n)), (0, 11));
+        assert_eq!(on_count(10, None, |n| tally(&b, n)), (5, 14));
+        assert_eq!(on_count(10, None, |n| tally(&c, n)), (6, 11));
+        assert_eq!(on_count(10, None, |n| tally(&d, n)), (0, 19));
+        assert_eq!(on_count(u32::MAX, None, |n| tally(&b, n)), (5, 3));
+        assert_eq!(on_count(10, Some(42), |n| tally(&b, n)), (5, 42));
+    }
+
+    #[test]
+    fn tally_all_native() {
+        let us = units();
+        assert_eq!(on_count(0, None, |n| tally_all(&us, n)), (11, 215));
+        assert_eq!(on_count(0, None, |n| tally_all(&us[..1], n)), (0, 1));
+        assert_eq!(on_count(0, None, |n| tally_all(&us[1..3], n)), (11, 105));
+        assert_eq!(on_count(0, None, |n| tally_all(&[], n)), (0, 0));
+        assert_eq!(on_count(0, Some(5), |n| tally_all(&us, n)), (11, 5));
+    }
+}
diff --git a/tests/src/loop-exit-bindings.rs b/tests/src/loop-exit-bindings.rs
new file mode 100644
index 0000000..74540af
--- /dev/null
+++ b/tests/src/loop-exit-bindings.rs
@@ -0,0 +1,152 @@
+//@ [!lean] skip
+//@ [lean] subdir=LoopExitBindings
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::option::{core::option::Option}
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Nested loops with an early return, inside a loop which carries a value
+//! computed before them (`first`), in the shape of chelis-ir's
+//! `ownership::last_use::verify_canonical`. The inner loops have several exits:
+//! the normal end outputs `first` (a loop input) and the early return does not.
+//! The expression following each exit used to be translated with the bindings
+//! of the exits translated before it still in scope, so the meta-information
+//! of the early return named `first` with a variable bound only in the other
+//! branch ("found unexpected fvars"). Every exit now binds its outputs in the
+//! context before the exits.
+//!
+//! LoopExitBindings/Checks.lean compares the model with the native results
+//! asserted in the native test module, including the count given back through
+//! the `&mut` (`scan`), after which the caller writes through it.
+
+pub struct Edge {
+    pub terminals: Vec<u32>,
+}
+
+pub struct Block {
+    pub edges: Vec<Edge>,
+}
+
+pub struct Unit {
+    pub canonical: bool,
+    pub provisional: Option<u32>,
+    pub blocks: Vec<Block>,
+    pub owners: Vec<u32>,
+}
+
+fn provisional_in(unit: &Unit) -> Option<(u32, u32)> {
+    match unit.provisional {
+        Some(owner) => Some((owner, owner + 1)),
+        None => None,
+    }
+}
+
+fn check(unit: &Unit, owner: u32) -> Result<u32, u32> {
+    if unit.owners.len() > 3 {
+        Err(owner)
+    } else {
+        Ok(owner + unit.owners.len() as u32)
+    }
+}
+
+/// `verify_canonical`: an error of `check`, an early return using `first`,
+/// then an early return from the nested loops.
+pub fn verify(units: &[Unit]) -> Result<u32, u32> {
+    let mut total = 0u32;
+    for unit in units {
+        let first = check(unit, 1)?;
+        if let Some((owner, _)) = provisional_in(unit) {
+            return Err(owner + first);
+        }
+        for block in &unit.blocks {
+            for edge in &block.edges {
+                if edge.terminals.len() == 3 {
+                    return Err(100);
+                }
+            }
+        }
+        total = total.wrapping_add(first);
+    }
+    Ok(total)
+}
+
+/// The same loops updating a counter the caller gives back.
+pub fn scan(units: &[Unit], seen: &mut u32) -> Result<u32, u32> {
+    let mut total = 0u32;
+    for unit in units {
+        let first = check(unit, 1)?;
+        if unit.canonical {
+            return Err(first);
+        }
+        for block in &unit.blocks {
+            for edge in &block.edges {
+                *seen = seen.wrapping_add(1);
+                if edge.terminals.len() == 3 {
+                    return Err(200);
+                }
+            }
+        }
+        total = total.wrapping_add(first);
+    }
+    Ok(total)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    fn unit(canonical: bool, provisional: Option<u32>, edges: &[usize], owners: usize) -> Unit {
+        Unit {
+            canonical,
+            provisional,
+            blocks: vec![Block {
+                edges: edges.iter().map(|n| Edge { terminals: vec![0; *n] }).collect(),
+            }],
+            owners: vec![0; owners],
+        }
+    }
+
+    /// `run(&mut seen)`, then the caller writes `set` (if any) through the
+    /// reference given back, then reads the count
+    fn on_seen<R>(seen: u32, set: Option<u32>, run: impl FnOnce(&mut u32) -> R) -> (R, u32) {
+        let mut s = seen;
+        let r = {
+            let rs = &mut s;
+            let r = run(&mut *rs);
+            if let Some(v) = set {
+                *rs = v;
+            }
+            r
+        };
+        (r, s)
+    }
+
+    #[test]
+    fn verify_native() {
+        assert_eq!(verify(&[]), Ok(0));
+        assert_eq!(verify(&[unit(false, None, &[1, 2], 2), unit(false, None, &[0], 0)]), Ok(4));
+        assert_eq!(verify(&[unit(false, None, &[1], 1), unit(false, Some(5), &[], 2)]), Err(8));
+        assert_eq!(verify(&[unit(false, None, &[1], 1), unit(false, None, &[2, 3], 1)]), Err(100));
+        assert_eq!(verify(&[unit(false, None, &[1], 4)]), Err(1));
+    }
+
+    #[test]
+    fn scan_native() {
+        assert_eq!(on_seen(0, None, |s| scan(&[], s)), (Ok(0), 0));
+        assert_eq!(
+            on_seen(10, None, |s| scan(&[unit(false, None, &[1, 2], 2), unit(false, None, &[0], 0)], s)),
+            (Ok(4), 13)
+        );
+        assert_eq!(
+            on_seen(10, None, |s| scan(&[unit(false, None, &[1], 1), unit(true, None, &[1], 2)], s)),
+            (Err(3), 11)
+        );
+        assert_eq!(
+            on_seen(10, None, |s| scan(&[unit(false, None, &[1, 3, 1], 0)], s)),
+            (Err(200), 12)
+        );
+        assert_eq!(on_seen(u32::MAX, None, |s| scan(&[unit(false, None, &[1], 0)], s)), (Ok(1), 0));
+        assert_eq!(on_seen(0, None, |s| scan(&[unit(false, None, &[1], 4)], s)), (Err(1), 0));
+        assert_eq!(
+            on_seen(10, Some(7), |s| scan(&[unit(false, None, &[1, 3, 1], 0)], s)),
+            (Err(200), 7)
+        );
+    }
+}
