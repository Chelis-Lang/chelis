+@[rust_fun "core::str::traits::{core::slice::index::SliceIndex<core::ops::range::Range<usize>, str, str>}::get"]
+def core.str.traits.SliceIndexRangeUsizeStr.get (r : core.ops.range.Range Usize) (s : Str) :
