-      inherit [_] map_ty
-      method! visit_region _ _ = RErased
-    end
-  in
-  List.map (erase#visit_ty ())
+  let erase = new erase_runtime_regions_visitor in
+  List.map (erase#visit_ty 0)
     (type_decl_get_instantiated_field_types def variant_id generics)
 
