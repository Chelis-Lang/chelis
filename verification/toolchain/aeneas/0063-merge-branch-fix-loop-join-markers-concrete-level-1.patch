+(** Erase the runtime regions of a type: free, static and body regions become
+    [RErased]. A region bound by a binder of the type itself (a higher-ranked
+    trait clause, a function pointer or item signature) quantifies that binder
+    rather than denoting storage, so it is kept, as in
+    [Charon.Substitute.erase_regions]: an erased type refreshed with new regions
+    then keeps its binders closed instead of turning their variables into
+    fresh free regions. The environment is the number of enclosing binders. *)
+class ['self] erase_runtime_regions_visitor =
+  object (_self : 'self)
+    inherit [_] map_ty as super
+
+    method! visit_binder visit_value depth x =
+      super#visit_binder visit_value (depth + 1) x
+
+    method! visit_region_binder visit_value depth x =
+      super#visit_region_binder visit_value (depth + 1) x
+
+    method! visit_region depth r =
+      match r with
+      | RVar (Bound (db, _)) when db < depth -> r
+      | _ -> RErased
+  end
+
