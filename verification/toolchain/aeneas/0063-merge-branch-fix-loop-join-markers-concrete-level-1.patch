+import LoopOptionNestedBorrow.LoopOptionNestedBorrow
+
+/-! Evaluate the model of `tests/src/loop-option-nested-borrow.rs` on the
+    inputs of its `native` test module and compare with the native results. -/
+
+namespace loop_option_nested_borrow.checks
+open Aeneas Aeneas.Std Result
+
+def val (r : Result U32) : Option Nat :=
+  match r with
+  | ok v => some v.val
+  | _ => none
+
+def val2 (r : Result (U32 × U32)) : Option (Nat × Nat) :=
+  match r with
+  | ok (a, b) => some (a.val, b.val)
+  | _ => none
+
+-- native::drives
+#guard val2 (drive_count_some 3#u32) == some (31, 3)
+#guard val2 (drive_count_some 0#u32) == some (1, 0)
+#guard val (drive_count_none 3#u32) == some 3
+#guard val2 (drive_set_some 9#u32) == some (5, 9)
+#guard val2 (drive_call_some 3#u32) == some (38, 6)
+#guard val2 (drive_call_some 0#u32) == some (8, 0)
+#guard val (drive_call_none 2#u32) == some 2
+#guard val2 (drive_advance 3#u32) == some (12, 8)
+#guard val2 (drive_advance 10#u32) == some (19, 8)
+
+end loop_option_nested_borrow.checks
