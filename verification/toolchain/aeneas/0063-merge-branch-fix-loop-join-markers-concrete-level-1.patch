diff --git a/tests/src/loop-higher-ranked-clause.rs b/tests/src/loop-higher-ranked-clause.rs
new file mode 100644
index 0000000..06b1a69
--- /dev/null
+++ b/tests/src/loop-higher-ranked-clause.rs
@@ -0,0 +1,80 @@
+//@ [!lean] skip
+//@ [lean] subdir=LoopHigherRankedClause
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::iter::adapters::filter::Filter --include core::option::{core::option::Option} --include core::cmp
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Loops over a `filter` whose predicate is a closure defined in a function
+//! with a higher-ranked trait clause (`F: for<'a> FnMut(&'a str) -> ..`).
+//! The closure inherits the clauses of its parent, so the type of the loop's
+//! iterator carries a trait reference whose region is bound by the clause's
+//! own binder. That region quantifies calls: it is not a runtime region and
+//! must stay bound (not become a fresh region at every loop iteration, which
+//! made the loop fixed point compare different trait references).
+//! The shape of `eval_tensor_internal_with_result_claims` (chelis-ir eval.rs).
+//! `LoopHigherRankedClause/Checks.lean` evaluates the model on the inputs of
+//! the `native` test module below and compares with the native results.
+
+/// Adds the first element of every claim of length `rank` to `load("x")`
+/// (0 if `None`); the predicate does not use `load`.
+pub fn count_rank<F>(claims: &[Vec<u32>], rank: usize, mut load: F) -> u32
+where
+    F: FnMut(&str) -> Option<u32>,
+{
+    let mut n = load("x").unwrap_or(0);
+    for claim in claims.iter().filter(|claim| claim.len() == rank) {
+        n = n.wrapping_add(claim[0]);
+    }
+    n
+}
+
+/// `count_rank` with a loader returning the length of its key plus `offset`,
+/// or `None` if `offset` is 0.
+pub fn count_rank_offset(claims: &[Vec<u32>], rank: usize, offset: u32) -> u32 {
+    count_rank(claims, rank, |key: &str| {
+        if offset == 0 {
+            None
+        } else {
+            Some(key.len() as u32 + offset)
+        }
+    })
+}
+
+/// Sums the elements which pass the higher-ranked predicate `keep`, called
+/// through the filter closure (which captures `&keep`).
+pub fn sum_where<P>(xs: &[u32], keep: P) -> u32
+where
+    P: Fn(&u32) -> bool,
+{
+    let mut sum = 0u32;
+    for x in xs.iter().filter(|x| keep(x)) {
+        sum = sum.wrapping_add(*x);
+    }
+    sum
+}
+
+/// `sum_where` with the predicate `x > bound`.
+pub fn sum_above(xs: &[u32], bound: u32) -> u32 {
+    sum_where(xs, |x: &u32| *x > bound)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn filter_in_higher_ranked_context() {
+        let claims = vec![vec![1, 2], vec![10], vec![3, 4], vec![100, 0, 0]];
+        assert_eq!(count_rank_offset(&claims, 2, 5), 10);
+        assert_eq!(count_rank_offset(&claims, 1, 0), 10);
+        assert_eq!(count_rank_offset(&claims, 3, 1), 102);
+        assert_eq!(count_rank_offset(&claims, 4, 7), 8);
+        assert_eq!(count_rank_offset(&[], 2, 0), 0);
+    }
+
+    #[test]
+    fn higher_ranked_predicate() {
+        assert_eq!(sum_above(&[1, 5, 3, 7], 3), 12);
+        assert_eq!(sum_above(&[1, 5, 3, 7], 0), 16);
+        assert_eq!(sum_above(&[1, 5, 3, 7], 7), 0);
+        assert_eq!(sum_above(&[], 0), 0);
+    }
+}
diff --git a/tests/src/loop-option-nested-borrow.rs b/tests/src/loop-option-nested-borrow.rs
new file mode 100644
index 0000000..926afef
--- /dev/null
+++ b/tests/src/loop-option-nested-borrow.rs
@@ -0,0 +1,134 @@
+//@ [!lean] skip
+//@ [lean] subdir=LoopOptionNestedBorrow
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! An `Option<&mut Frame<'a>>` (a mutable borrow of a value holding mutable
+//! borrows, under an enum) which is live across a loop or a join.
+//!
+//! The loop entry reborrows the symbolic option in one abstraction per region
+//! (the same for the join after an `if let` without `else`). The abstraction
+//! of `'a` gets the borrows of `'a` back at level 1, in the value given back
+//! to the outer borrow:
+//! - as a concrete borrow when the option was matched (expanded) afterwards;
+//! - as a borrow projector over the value a callee gave back when the option
+//!   was passed to a function.
+//!
+//! The value given back for such a borrow is the current value at the same
+//! path, over the value given back to the outer borrow (the shape of
+//! `execution: Option<&mut ExecutionFrame<'_>>` in chelis-ir eval.rs
+//! eval_tensor_internal_with_result_claims).
+//! `LoopOptionNestedBorrow/Checks.lean` evaluates the model on the inputs of
+//! the `native` test module below and compares with the native results.
+
+pub struct Frame<'a> {
+    pub steps: &'a mut u32,
+    pub id: u32,
+}
+
+/// Matched by value after the loop
+pub fn count_into(execution: Option<&mut Frame<'_>>, n: u32) -> u32 {
+    let mut i = 0;
+    while i < n {
+        i += 1;
+    }
+    if let Some(frame) = execution {
+        *frame.steps = i;
+    }
+    i
+}
+
+/// A join after an `if let` without `else`
+pub fn set_steps(execution: Option<&mut Frame<'_>>, v: u32) {
+    if let Some(frame) = execution {
+        *frame.steps = v;
+        frame.id += 1;
+    }
+}
+
+/// Passed to a function after the loop
+pub fn call_after_loop(execution: Option<&mut Frame<'_>>, n: u32) -> u32 {
+    let mut i = 0;
+    while i < n {
+        i += 1;
+    }
+    set_steps(execution, i * 2);
+    i
+}
+
+/// Callers: the value returned, the id and the steps seen after the call
+pub fn drive_count_some(n: u32) -> (u32, u32) {
+    let mut s = 5u32;
+    let mut f = Frame { steps: &mut s, id: 1 };
+    let r = count_into(Some(&mut f), n);
+    let id = f.id;
+    (r * 10 + id, s)
+}
+
+pub fn drive_count_none(n: u32) -> u32 {
+    count_into(None, n)
+}
+
+pub fn drive_set_some(v: u32) -> (u32, u32) {
+    let mut s = 5u32;
+    let mut f = Frame { steps: &mut s, id: 4 };
+    set_steps(Some(&mut f), v);
+    let id = f.id;
+    (id, s)
+}
+
+pub fn drive_call_some(n: u32) -> (u32, u32) {
+    let mut s = 5u32;
+    let mut f = Frame { steps: &mut s, id: 7 };
+    let r = call_after_loop(Some(&mut f), n);
+    let id = f.id;
+    (r * 10 + id, s)
+}
+
+pub fn drive_call_none(n: u32) -> u32 {
+    call_after_loop(None, n)
+}
+
+/// A frame holding a shared slice next to its mutable borrow, of which only a
+/// scalar field is updated in an `if let` without `else` (the shape of
+/// `frame.pos += 1` on an `Option<&mut ExecutionFrame<'_>>`). The slice has its
+/// own lifetime: with a single one, the callers are not translated yet.
+pub struct Cursor<'a, 'b> {
+    pub steps: &'b [u32],
+    pub ctx: &'a mut u32,
+    pub pos: usize,
+}
+
+pub fn advance(execution: Option<&mut Cursor<'_, '_>>) {
+    if let Some(frame) = execution {
+        frame.pos += 1;
+    }
+}
+
+pub fn drive_advance(n: u32) -> (u32, u32) {
+    let steps = [n, n + 1, n + 2];
+    let mut c = 7u32;
+    let mut cur = Cursor { steps: &steps, ctx: &mut c, pos: 0 };
+    advance(Some(&mut cur));
+    advance(Some(&mut cur));
+    let v = cur.steps[cur.pos] + *cur.ctx;
+    *cur.ctx += 1;
+    (v, c)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn drives() {
+        assert_eq!(drive_count_some(3), (31, 3));
+        assert_eq!(drive_count_some(0), (1, 0));
+        assert_eq!(drive_count_none(3), 3);
+        assert_eq!(drive_set_some(9), (5, 9));
+        assert_eq!(drive_call_some(3), (38, 6));
+        assert_eq!(drive_call_some(0), (8, 0));
+        assert_eq!(drive_call_none(2), 2);
+        assert_eq!(drive_advance(3), (12, 8));
+        assert_eq!(drive_advance(10), (19, 8));
+    }
+}
