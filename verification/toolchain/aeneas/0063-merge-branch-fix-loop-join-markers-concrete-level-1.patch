+(** The branch of [match scrut with branches] selected by [scrut] if [scrut]
+    is a constructor of an enumeration, with the bindings of the variables of
+    its pattern. [None] if the branch cannot be determined statically or if its
+    pattern is not flat (fields which are variables or ignored). *)
+let select_branch_of_constructor (scrut : texpr) (branches : match_branch list)
+    : ((tpat * texpr) list * texpr) option =
+  let cons, args = destruct_apps scrut in
+  match cons.e with
+  | Qualif { id = AdtCons { variant_id = Some variant_id; _ }; _ } ->
+      let rec select (branches : match_branch list) =
+        match branches with
+        | [] -> None
+        | { pat; branch } :: branches -> (
+            match pat.pat with
+            | PIgnored -> Some ([], branch)
+            | POpen _ -> Some ([ (pat, scrut) ], branch)
+            | PAdt { variant_id = Some vid; fields }
+              when vid = variant_id && List.length fields = List.length args ->
+                if
+                  List.for_all
+                    (fun (p : tpat) ->
+                      match p.pat with
+                      | POpen _ | PIgnored -> true
+                      | _ -> false)
+                    fields
+                then
+                  Some
+                    ( List.filter
+                        (fun ((p : tpat), _) -> p.pat <> PIgnored)
+                        (List.combine fields args),
+                      branch )
+                else None
+            | PAdt { variant_id = Some vid; _ } when vid <> variant_id ->
+                select branches
+            | _ -> None)
+      in
+      select branches
+  | _ -> None
+
