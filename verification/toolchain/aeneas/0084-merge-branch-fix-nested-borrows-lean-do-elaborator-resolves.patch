+-- `let x := match …` postpones the `match` until its type is known; a later
+-- pattern `let` on `x` (`:=` or `←`, tuple or constructor) needs that type.
+def let_match_then_pattern (o : Option (Nat × Nat)) (w : Option Wrap) : Result Nat := do
+  let p :=
+    match o with
+    | some p1 => p1
+    | none => (1, 2)
+  let (a, b) := p
+  let q :=
+    match o with
+    | some q1 => q1
+    | none => (3, 4)
+  let (c, d) ← ok q
+  let v :=
+    match w with
+    | some v1 => v1
+    | none => Wrap.mk 5
+  let ⟨ n ⟩ := v
+  ok (n * 10000 + a * 1000 + b * 100 + c * 10 + d)
+
+#guard let_match_then_pattern (some (6, 7)) (some (Wrap.mk 8)) == ok 86767
+#guard let_match_then_pattern none none == ok 51234
+
 end Tests
 
