+//@ [!lean] skip
+//@ [lean] subdir=LetMatchPattern
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! A value bound to a `match` and destructured by a later `let`. The model
+//! binds `let p := match observed with | Ok p1 => p1` and then
+//! `let (a, b) := p`: Lean postpones the `match` until its type is known, and
+//! the `do` elaborator must resolve it before it analyzes the tuple pattern of
+//! the next `let` (flat in `sum_observed`, nested in `spread_observed`). The
+//! one-armed match on `Result<_, Infallible>` is the shape of the observers of
+//! chelis-ir's dag.rs.
+
+use std::convert::Infallible;
+
+fn observe(x: u32) -> Result<(u32, u32), Infallible> {
+    Ok((x, x.wrapping_add(1)))
+}
+
+pub fn sum_observed(x: u32) -> u32 {
+    let observed = observe(x);
+    let p = match observed {
+        Ok(p) => p,
+    };
+    let (a, b) = p;
+    a.wrapping_mul(10).wrapping_add(b)
+}
+
+fn observe_nested(x: u32) -> Result<(u32, (u32, u32)), Infallible> {
+    Ok((x, (x.wrapping_mul(2), 3)))
+}
+
+pub fn spread_observed(x: u32) -> u32 {
+    let p = match observe_nested(x) {
+        Ok(p) => p,
+    };
+    let (a, (b, c)) = p;
+    b.wrapping_sub(a).wrapping_mul(c)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn sum_observed_native() {
+        assert_eq!(sum_observed(3), 34);
+        assert_eq!(sum_observed(0), 1);
+        assert_eq!(sum_observed(u32::MAX), 4294967286);
+    }
+
+    #[test]
+    fn spread_observed_native() {
+        assert_eq!(spread_observed(5), 15);
+        assert_eq!(spread_observed(0), 0);
+        assert_eq!(spread_observed(u32::MAX), 4294967293);
+    }
+}
