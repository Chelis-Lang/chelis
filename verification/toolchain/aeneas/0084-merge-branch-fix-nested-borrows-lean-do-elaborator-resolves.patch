+//@ [!lean] skip
+//@ [lean] subdir=LetBranchingTupleValue
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! A tuple destructured from a `match` one of whose arms gives a whole tuple
+//! value (the variable bound by `Some(p)`), the other a tuple expression.
+//! `simplify_let_branching` looks for components which are the same in every
+//! arm: a whole value has no known components, so nothing is simplified
+//! (flat pattern in `flat`, nested in `nested`).
+
+pub fn flat(s: Option<(u32, u32)>, lo: u32) -> u32 {
+    let p = match s {
+        Some(p) => p,
+        None => (lo, 1),
+    };
+    let (a, b) = p;
+    a.wrapping_sub(b)
+}
+
+pub fn nested(s: Option<(u32, (u32, u32))>, lo: u32) -> u32 {
+    let p = match s {
+        Some(p) => p,
+        None => (lo, (lo, 1)),
+    };
+    let (a, (b, c)) = p;
+    a.wrapping_sub(b).wrapping_add(c)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn flat_native() {
+        assert_eq!(flat(Some((9, 2)), 0), 7);
+        assert_eq!(flat(Some((2, 9)), 0), 4294967289);
+        assert_eq!(flat(None, 5), 4);
+    }
+
+    #[test]
+    fn nested_native() {
+        assert_eq!(nested(Some((9, (2, 3))), 0), 10);
+        assert_eq!(nested(Some((2, (9, 0))), 0), 4294967289);
+        assert_eq!(nested(None, 5), 1);
+    }
+}
