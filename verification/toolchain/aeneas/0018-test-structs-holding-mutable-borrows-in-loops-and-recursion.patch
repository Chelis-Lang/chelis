@@ -0,0 +1,263 @@
+//@ [!lean] skip
+//@ [lean] subdir=AdtMutBorrowLoops
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Structures holding mutable borrows, used as loop state, across early
+//! exits, and passed by mutable reference to helpers and recursive calls.
+//! `AdtMutBorrowLoops/Checks.lean` evaluates the model on the inputs of the
+//! `native` test module below and compares with the native results.
+
+pub struct Native {
+    pub polls: u64,
+    pub cancelled: bool,
+}
+
+impl Native {
+    pub fn observe(&mut self) -> bool {
+        self.polls = self.polls.wrapping_add(1);
+        self.cancelled
+    }
+}
+
+/// A sink borrowing state mutably next to an owned field.
+pub struct Sink<'a> {
+    pub native: &'a mut Native,
+    pub errors: Vec<u32>,
+}
+
+impl<'a> Sink<'a> {
+    pub fn poll(&mut self) -> bool {
+        self.native.observe()
+    }
+    pub fn push(&mut self, e: u32) {
+        self.errors.push(e);
+    }
+    pub fn check(&mut self, x: u32) -> Result<(), u32> {
+        if x > 100 {
+            self.native.observe();
+            Err(x)
+        } else {
+            Ok(())
+        }
+    }
+}
+
+/// The sink is the loop state: its unprojected fields must be rebuilt when
+/// the backward continuations of `poll` and `push` are composed.
+pub fn sink_loop(native: &mut Native, xs: &[u32]) -> Vec<u32> {
+    let mut sink = Sink { native, errors: Vec::new() };
+    for x in xs {
+        if sink.poll() {
+            break;
+        }
+        sink.push(*x);
+    }
+    sink.errors
+}
+
+/// Early `return`, `break` and `?` exits out of the loop.
+pub fn sink_loop_early(native: &mut Native, xs: &[u32]) -> Result<Vec<u32>, u32> {
+    let mut sink = Sink { native, errors: Vec::new() };
+    for x in xs {
+        if sink.poll() {
+            return Ok(sink.errors);
+        }
+        if *x == 0 {
+            break;
+        }
+        sink.check(*x)?;
+        sink.push(*x);
+    }
+    sink.push(7);
+    Ok(sink.errors)
+}
+
+/// A local scope holding `&mut Sink<'a>` (itself holding `&'a mut`), used in
+/// a loop through direct field accesses.
+pub struct Scope<'s, 'a> {
+    pub sink: &'s mut Sink<'a>,
+    pub previous: Option<u32>,
+}
+
+pub fn scope_loop(native: &mut Native, xs: &[u32]) -> (Vec<u32>, Option<u32>) {
+    let mut sink = Sink { native, errors: Vec::new() };
+    let previous = {
+        let mut scope = Scope { sink: &mut sink, previous: None };
+        for x in xs {
+            if scope.sink.poll() {
+                break;
+            }
+            scope.sink.push(*x);
+            scope.previous = Some(*x);
+        }
+        scope.previous
+    };
+    (sink.errors, previous)
+}
+
+/// Two mutable borrows in one structure, passed to helpers.
+pub struct Sink2<'a> {
+    pub errors: &'a mut Vec<u32>,
+    pub native: &'a mut Native,
+}
+
+pub fn report(sink: &mut Sink2<'_>, e: u32) {
+    sink.errors.push(e);
+}
+
+pub fn poll2(sink: &mut Sink2<'_>) -> bool {
+    sink.native.observe()
+}
+
+pub fn sink2_loop(errors: &mut Vec<u32>, native: &mut Native, xs: &[u32]) -> u32 {
+    let mut sink = Sink2 { errors, native };
+    let mut n = 0u32;
+    for x in xs {
+        if poll2(&mut sink) {
+            break;
+        }
+        if *x % 2 == 1 {
+            report(&mut sink, *x);
+            n = n.wrapping_add(1);
+        }
+    }
+    n
+}
+
+/// A frame borrowing a context, passed recursively by mutable reference.
+pub struct Ctx {
+    pub count: u32,
+    pub trail: Vec<u32>,
+}
+
+pub struct Frame<'a> {
+    pub ctx: &'a mut Ctx,
+    pub depth: u32,
+}
+
+pub fn descend(frame: &mut Frame<'_>, n: u32) -> u32 {
+    frame.ctx.count = frame.ctx.count.wrapping_add(1);
+    frame.ctx.trail.push(n);
+    if n == 0 {
+        return frame.depth;
+    }
+    frame.depth = frame.depth.wrapping_add(1);
+    let r = descend(frame, n - 1);
+    r.wrapping_add(1)
+}
+
+pub fn run_descend(ctx: &mut Ctx, n: u32) -> u32 {
+    let mut frame = Frame { ctx, depth: 0 };
+    descend(&mut frame, n)
+}
+
+/// Recursion through the frame from inside a loop, with an early return.
+pub fn visit(frame: &mut Frame<'_>, xs: &[u32], n: u32) -> u32 {
+    frame.ctx.count = frame.ctx.count.wrapping_add(1);
+    if n == 0 {
+        return frame.depth;
+    }
+    let mut total = 0u32;
+    for x in xs {
+        frame.ctx.trail.push(*x);
+        if *x == 99 {
+            return total;
+        }
+        total = total.wrapping_add(visit(frame, xs, n - 1));
+    }
+    total
+}
+
+pub fn run_visit(ctx: &mut Ctx, xs: &[u32], n: u32) -> u32 {
+    let mut frame = Frame { ctx, depth: 3 };
+    visit(&mut frame, xs, n)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    fn nat(polls: u64, cancelled: bool) -> Native {
+        Native { polls, cancelled }
+    }
+
+    #[test]
+    fn sink_loops() {
+        let cases: [(u64, bool, &[u32]); 6] = [
+            (0, false, &[1, 2, 3]),
+            (5, true, &[1, 2, 3]),
+            (0, false, &[]),
+            (0, false, &[4, 0, 9]),
+            (2, false, &[3, 200, 5]),
+            (0, false, &[1, 2, 3, 4, 5]),
+        ];
+        let loop_out: [(&[u32], u64); 6] = [
+            (&[1, 2, 3], 3),
+            (&[], 6),
+            (&[], 0),
+            (&[4, 0, 9], 3),
+            (&[3, 200, 5], 5),
+            (&[1, 2, 3, 4, 5], 5),
+        ];
+        let early_out: [(Result<&[u32], u32>, u64); 6] = [
+            (Ok(&[1, 2, 3, 7]), 3),
+            (Ok(&[]), 6),
+            (Ok(&[7]), 0),
+            (Ok(&[4, 7]), 2),
+            (Err(200), 5),
+            (Ok(&[1, 2, 3, 4, 5, 7]), 5),
+        ];
+        let sink2_out: [(u32, &[u32], u64); 6] = [
+            (2, &[42, 1, 3], 3),
+            (0, &[42], 6),
+            (0, &[42], 0),
+            (1, &[42, 9], 3),
+            (2, &[42, 3, 5], 5),
+            (3, &[42, 1, 3, 5], 5),
+        ];
+        let scope_previous: [Option<u32>; 6] = [Some(3), None, None, Some(9), Some(5), Some(5)];
+        for (i, (p, c, xs)) in cases.iter().enumerate() {
+            let mut n = nat(*p, *c);
+            assert_eq!(sink_loop(&mut n, xs), loop_out[i].0);
+            assert_eq!((n.polls, n.cancelled), (loop_out[i].1, *c));
+            let mut n = nat(*p, *c);
+            let (errors, previous) = scope_loop(&mut n, xs);
+            assert_eq!((errors.as_slice(), previous), (loop_out[i].0, scope_previous[i]));
+            assert_eq!((n.polls, n.cancelled), (loop_out[i].1, *c));
+            let mut n = nat(*p, *c);
+            let r = sink_loop_early(&mut n, xs);
+            assert_eq!(r.as_deref().map_err(|e| *e), early_out[i].0);
+            assert_eq!((n.polls, n.cancelled), (early_out[i].1, *c));
+            let mut n = nat(*p, *c);
+            let mut errs = vec![42u32];
+            assert_eq!(sink2_loop(&mut errs, &mut n, xs), sink2_out[i].0);
+            assert_eq!(errs, sink2_out[i].1);
+            assert_eq!((n.polls, n.cancelled), (sink2_out[i].2, *c));
+        }
+    }
+
+    #[test]
+    fn frames() {
+        for (n, r, count, trail) in [
+            (0u32, 0u32, 11u32, &[0u32][..]),
+            (1, 2, 12, &[1, 0]),
+            (3, 6, 14, &[3, 2, 1, 0]),
+            (5, 10, 16, &[5, 4, 3, 2, 1, 0]),
+        ] {
+            let mut ctx = Ctx { count: 10, trail: vec![] };
+            assert_eq!(run_descend(&mut ctx, n), r);
+            assert_eq!((ctx.count, ctx.trail.as_slice()), (count, trail));
+        }
+        for (xs, n, r, count, trail) in [
+            (&[1u32, 2][..], 2u32, 12u32, 7u32, &[1u32, 1, 2, 2, 1, 2][..]),
+            (&[], 3, 0, 1, &[]),
+            (&[5, 99, 6], 2, 3, 3, &[5, 5, 99, 99]),
+            (&[7], 0, 3, 1, &[]),
+            (&[1, 2, 3], 1, 9, 4, &[1, 2, 3]),
+        ] {
+            let mut ctx = Ctx { count: 0, trail: vec![] };
+            assert_eq!(run_visit(&mut ctx, xs, n), r);
+            assert_eq!((ctx.count, ctx.trail.as_slice()), (count, trail));
+        }
+    }
+}
