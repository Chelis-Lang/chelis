+import AdtMutBorrowLoops.AdtMutBorrowLoops
+
+/-! Evaluate the model of `tests/src/adt-mut-borrow-loops.rs` on the inputs of
+    its `native` test module and compare with the native results. -/
+
+namespace adt_mut_borrow_loops.checks
+open Aeneas Aeneas.Std Result
+
+def u32s (xs : List Nat) : List U32 := xs.map (fun x => ⟨BitVec.ofNat _ x⟩)
+
+def sl (xs : List Nat) (h : xs.length ≤ Usize.max := by scalar_tac) : Slice U32 :=
+  ⟨u32s xs, by simpa [u32s] using h⟩
+
+def nats (v : alloc.vec.Vec U32) : List Nat := v.val.map (·.val)
+
+def nat (p : Nat) (c : Bool) : Native := { polls := ⟨BitVec.ofNat _ p⟩, cancelled := c }
+
+def natState (n : Native) : Nat × Bool := (n.polls.val, n.cancelled)
+
+def sinkLoop (n : Native) (s : Slice U32) : Option (List Nat × (Nat × Bool)) :=
+  match sink_loop n s with
+  | ok (v, n) => some (nats v, natState n)
+  | _ => none
+
+def sinkLoopEarly (n : Native) (s : Slice U32) :
+    Option (Sum (List Nat) Nat × (Nat × Bool)) :=
+  match sink_loop_early n s with
+  | ok (core.result.Result.Ok v, n) => some (.inl (nats v), natState n)
+  | ok (core.result.Result.Err e, n) => some (.inr e.val, natState n)
+  | _ => none
+
+def errs42 : alloc.vec.Vec U32 := ⟨[42#u32], by simp; scalar_tac⟩
+
+def sink2Loop (n : Native) (s : Slice U32) : Option (Nat × List Nat × (Nat × Bool)) :=
+  match sink2_loop errs42 n s with
+  | ok (r, v, n) => some (r.val, nats v, natState n)
+  | _ => none
+
+def scopeLoop (n : Native) (s : Slice U32) :
+    Option ((List Nat × Option Nat) × (Nat × Bool)) :=
+  match scope_loop n s with
+  | ok ((v, p), n) => some ((nats v, p.map (·.val)), natState n)
+  | _ => none
+
+-- The loop state is rebuilt when composing the backward continuations
+#guard sinkLoop (nat 0 false) (sl [1, 2, 3]) == some ([1, 2, 3], (3, false))
+#guard sinkLoop (nat 5 true) (sl [1, 2, 3]) == some ([], (6, true))
+#guard sinkLoop (nat 0 false) (sl []) == some ([], (0, false))
+#guard sinkLoop (nat 0 false) (sl [4, 0, 9]) == some ([4, 0, 9], (3, false))
+#guard sinkLoop (nat 2 false) (sl [3, 200, 5]) == some ([3, 200, 5], (5, false))
+#guard sinkLoop (nat 0 false) (sl [1, 2, 3, 4, 5]) == some ([1, 2, 3, 4, 5], (5, false))
+
+-- A local structure holding `&mut Sink<'a>`, used through its fields
+#guard scopeLoop (nat 0 false) (sl [1, 2, 3]) == some (([1, 2, 3], some 3), (3, false))
+#guard scopeLoop (nat 5 true) (sl [1, 2, 3]) == some (([], none), (6, true))
+#guard scopeLoop (nat 0 false) (sl []) == some (([], none), (0, false))
+#guard scopeLoop (nat 0 false) (sl [4, 0, 9]) == some (([4, 0, 9], some 9), (3, false))
+#guard scopeLoop (nat 2 false) (sl [3, 200, 5]) == some (([3, 200, 5], some 5), (5, false))
+#guard scopeLoop (nat 0 false) (sl [1, 2, 3, 4, 5]) ==
+  some (([1, 2, 3, 4, 5], some 5), (5, false))
+
+-- Early `return`, `break` and `?` exits
+#guard sinkLoopEarly (nat 0 false) (sl [1, 2, 3]) == some (.inl [1, 2, 3, 7], (3, false))
+#guard sinkLoopEarly (nat 5 true) (sl [1, 2, 3]) == some (.inl [], (6, true))
+#guard sinkLoopEarly (nat 0 false) (sl []) == some (.inl [7], (0, false))
+#guard sinkLoopEarly (nat 0 false) (sl [4, 0, 9]) == some (.inl [4, 7], (2, false))
+#guard sinkLoopEarly (nat 2 false) (sl [3, 200, 5]) == some (.inr 200, (5, false))
+#guard sinkLoopEarly (nat 0 false) (sl [1, 2, 3, 4, 5]) ==
+  some (.inl [1, 2, 3, 4, 5, 7], (5, false))
+
+-- Two mutable borrows in one structure
+#guard sink2Loop (nat 0 false) (sl [1, 2, 3]) == some (2, [42, 1, 3], (3, false))
+#guard sink2Loop (nat 5 true) (sl [1, 2, 3]) == some (0, [42], (6, true))
+#guard sink2Loop (nat 0 false) (sl []) == some (0, [42], (0, false))
+#guard sink2Loop (nat 0 false) (sl [4, 0, 9]) == some (1, [42, 9], (3, false))
+#guard sink2Loop (nat 2 false) (sl [3, 200, 5]) == some (2, [42, 3, 5], (5, false))
+#guard sink2Loop (nat 0 false) (sl [1, 2, 3, 4, 5]) == some (3, [42, 1, 3, 5], (5, false))
+
+def ctx (count : Nat) : Ctx := { count := ⟨BitVec.ofNat _ count⟩, trail := ⟨[], by simp⟩ }
+
+def ctxState (c : Ctx) : Nat × List Nat := (c.count.val, nats c.trail)
+
+def runDescend (n : Nat) : Option (Nat × (Nat × List Nat)) :=
+  match run_descend (ctx 10) ⟨BitVec.ofNat _ n⟩ with
+  | ok (r, c) => some (r.val, ctxState c)
+  | _ => none
+
+def runVisit (xs : Slice U32) (n : Nat) : Option (Nat × (Nat × List Nat)) :=
+  match run_visit (ctx 0) xs ⟨BitVec.ofNat _ n⟩ with
+  | ok (r, c) => some (r.val, ctxState c)
+  | _ => none
+
+-- Recursion through a frame holding a mutable borrow
+#guard runDescend 0 == some (0, (11, [0]))
+#guard runDescend 1 == some (2, (12, [1, 0]))
+#guard runDescend 3 == some (6, (14, [3, 2, 1, 0]))
+#guard runDescend 5 == some (10, (16, [5, 4, 3, 2, 1, 0]))
+
+-- Recursion from inside a loop, with an early return
+#guard runVisit (sl [1, 2]) 2 == some (12, (7, [1, 1, 2, 2, 1, 2]))
+#guard runVisit (sl []) 3 == some (0, (1, []))
+#guard runVisit (sl [5, 99, 6]) 2 == some (3, (3, [5, 5, 99, 99]))
+#guard runVisit (sl [7]) 0 == some (3, (1, []))
+#guard runVisit (sl [1, 2, 3]) 1 == some (9, (4, [1, 2, 3]))
+
+end adt_mut_borrow_loops.checks
