@@ -0,0 +1,177 @@
+//@ [!lean] skip
+//@ [lean] subdir=LoopVisitorNestedSink
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Loops calling a visitor `&mut impl FnMut(Option<&'a T>)` whose closure
+//! captures a `&mut Sink<'_>` (a mutable borrow of a struct holding a mutable
+//! borrow), passing it a value computed by a join and matching that value
+//! after the call (the shape of
+//! `chelis_deep::literal_source::visit_binder_literal_uses` instantiated by
+//! `validate_binder_literal_adoption_in_program`). The loop abstraction of the
+//! inner region of the sink, merged with the abstraction of the call, binds
+//! the loan of the vector inside the loan of the sink it does not own, while
+//! that outer loan is one whole input of its staged continuation.
+
+pub struct Sink<'s> {
+    pub errors: &'s mut Vec<u32>,
+    pub count: u32,
+}
+
+impl<'s> Sink<'s> {
+    pub fn push(&mut self, e: u32) {
+        self.errors.push(e);
+        self.count = self.count.wrapping_add(1);
+    }
+}
+
+/// A chain alternating between `root` and `alt`: the visitor receives
+/// `Some(alt)` from an odd element
+pub fn visit_chain<'a>(
+    root: &'a u32,
+    alt: &'a u32,
+    visitor: &mut impl FnMut(Option<&'a u32>),
+    n: u32,
+) -> u32 {
+    let mut cur: &'a u32 = root;
+    let mut i = 0;
+    let mut hits = 0u32;
+    while i < n {
+        let source = if *cur % 2 == 1 { Some(alt) } else { None };
+        visitor(source);
+        match source {
+            Some(s) => {
+                cur = s;
+                hits = hits.wrapping_add(1);
+            }
+            None => cur = root,
+        }
+        i += 1;
+    }
+    hits
+}
+
+pub fn collect_chain(root: &u32, alt: &u32, n: u32, errors: &mut Sink<'_>) -> u32 {
+    visit_chain(
+        root,
+        alt,
+        &mut |u| {
+            if let Some(v) = u {
+                errors.push(*v);
+            }
+        },
+        n,
+    )
+}
+
+pub struct Node {
+    pub tag: u32,
+    pub children: Vec<u32>,
+}
+
+#[derive(Clone, Copy)]
+pub struct Source<'a> {
+    pub literal: &'a u32,
+}
+
+pub enum Use<'a> {
+    Cast {
+        binder: &'a u32,
+        source: Option<Source<'a>>,
+    },
+}
+
+pub fn classify<'a>(x: &'a u32) -> Option<Source<'a>> {
+    if *x % 5 == 0 { Some(Source { literal: x }) } else { None }
+}
+
+pub fn parts<'a>(x: &'a u32, node: &'a Node) -> Option<(u32, &'a [u32])> {
+    if *x == node.tag { Some((*x % 4, node.children.as_slice())) } else { None }
+}
+
+/// A worklist over the node: the visitor receives each cast of the root, and
+/// the classified operand is pushed back onto the worklist
+pub fn visit_uses<'a>(node: &'a Node, visitor: &mut impl FnMut(Use<'a>)) {
+    let mut stack: Vec<(&'a u32, Option<&'a u32>)> = Vec::new();
+    stack.push((&node.tag, None));
+    while let Some((x, _adopting)) = stack.pop() {
+        if let Some((tag, children)) = parts(x, node) {
+            if tag == 1 && children.len() >= 2 {
+                let operand = &children[0];
+                let binder = &children[1];
+                let source = classify(operand);
+                visitor(Use::Cast { binder, source });
+                match source {
+                    Some(source) => stack.push((source.literal, Some(binder))),
+                    None => stack.push((operand, None)),
+                }
+            }
+            continue;
+        }
+    }
+}
+
+pub fn validate(node: &Node, limit: &u32, errors: &mut Sink<'_>) {
+    visit_uses(node, &mut |u| match u {
+        Use::Cast { binder, source } => {
+            if *binder > *limit {
+                errors.push(*binder);
+            }
+            if let Some(source) = source {
+                errors.push(source.literal.wrapping_add(1000));
+            }
+        }
+    });
+}
+
+/// An order-sensitive digest
+pub fn digest(v: &Vec<u32>) -> u32 {
+    let mut acc = 0u32;
+    let mut i = 0usize;
+    while i < v.len() {
+        acc = acc.wrapping_mul(31).wrapping_add(v[i]);
+        i += 1;
+    }
+    acc
+}
+
+/// The vector and the counter given back through the sink after the loop,
+/// then written through the sink by the caller
+pub fn drive_chain(root: u32, n: u32) -> (u32, usize, u32, u32) {
+    let alt = root.wrapping_add(1);
+    let mut v: Vec<u32> = Vec::new();
+    v.push(7);
+    let mut sink = Sink { errors: &mut v, count: 10 };
+    let hits = collect_chain(&root, &alt, n, &mut sink);
+    sink.push(99);
+    let count = sink.count;
+    (hits, v.len(), digest(&v), count)
+}
+
+pub fn drive_validate(tag: u32, operand: u32, binder: u32, limit: u32) -> (usize, u32, u32) {
+    let mut children: Vec<u32> = Vec::new();
+    children.push(operand);
+    children.push(binder);
+    children.push(4);
+    let node = Node { tag, children };
+    let mut v: Vec<u32> = Vec::new();
+    let mut sink = Sink { errors: &mut v, count: 0 };
+    validate(&node, &limit, &mut sink);
+    sink.push(77);
+    let count = sink.count;
+    (v.len(), digest(&v), count)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn drives() {
+        for (root, n) in [(3u32, 0u32), (3, 1), (3, 4), (2, 3)] {
+            println!("chain {} {} {:?}", root, n, drive_chain(root, n));
+        }
+        for (tag, operand, binder, limit) in [(1u32, 10u32, 8u32, 5u32), (5, 3, 8, 5), (9, 15, 2, 5), (2, 10, 8, 5)] {
+            println!("validate {} {} {} {} {:?}", tag, operand, binder, limit, drive_validate(tag, operand, binder, limit));
+        }
+    }
+}
