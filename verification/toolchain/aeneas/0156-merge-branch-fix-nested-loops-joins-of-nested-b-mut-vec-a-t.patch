+//@ [!lean] skip
+//@ [lean] subdir=LoopSharedNestedView
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Loops whose state holds values with borrows nested under shared borrows
+//! only: a sorted view `Vec<(&K, &(Vec<P>, Vec<&T>))>` of a declaration table
+//! built by a loop, then iterated by an outer loop whose body runs inner loops
+//! (the shape of `chelis_types::infer::common::precollect_type_resolution_env`,
+//! common.rs:1341). The joins of such values introduce one abstraction per
+//! region: nothing is given back through the outer shared borrows. The
+//! visitor writes through a `&mut Budget<'_>` which the caller writes through
+//! again after the loops.
+
+pub struct Budget<'a> {
+    pub depth: &'a mut u32,
+}
+
+pub fn visit(e: &u32, own: &Vec<(&u32, usize)>, ev: &mut Vec<u32>, stack: &mut Budget<'_>) {
+    *stack.depth = stack.depth.wrapping_add(1);
+    ev.push(e.wrapping_mul(10).wrapping_add(own.len() as u32));
+}
+
+pub fn pre(decls: &Vec<(u32, (Vec<u32>, Vec<&u32>))>, stack: &mut Budget<'_>) -> Vec<u32> {
+    let mut sorted: Vec<(&u32, &(Vec<u32>, Vec<&u32>))> = Vec::new();
+    for (n, d) in decls.iter() {
+        sorted.push((n, d));
+    }
+    let mut evidence: Vec<u32> = Vec::new();
+    for (name, (params, bodies)) in sorted {
+        let mut indices: Vec<(&u32, usize)> = Vec::new();
+        for p in params.iter() {
+            indices.push((p, indices.len()));
+        }
+        for body in bodies {
+            visit(body, &indices, &mut evidence, stack);
+        }
+        evidence.push(*name);
+    }
+    evidence
+}
+
+/// An order-sensitive digest
+pub fn digest(v: &Vec<u32>) -> u32 {
+    let mut acc = 0u32;
+    let mut i = 0usize;
+    while i < v.len() {
+        acc = acc.wrapping_mul(31).wrapping_add(v[i]);
+        i += 1;
+    }
+    acc
+}
+
+pub fn drive(k: u32) -> (u32, usize, u32) {
+    let a = 3u32;
+    let b = 5u32;
+    let mut decls: Vec<(u32, (Vec<u32>, Vec<&u32>))> = Vec::new();
+    let mut i = 0u32;
+    while i < k {
+        let mut params: Vec<u32> = Vec::new();
+        let mut j = 0u32;
+        while j < i {
+            params.push(j);
+            j += 1;
+        }
+        let mut bodies: Vec<&u32> = Vec::new();
+        bodies.push(&a);
+        if i % 2 == 0 {
+            bodies.push(&b);
+        }
+        decls.push((i.wrapping_add(40), (params, bodies)));
+        i += 1;
+    }
+    let mut depth = 7u32;
+    let mut budget = Budget { depth: &mut depth };
+    let ev = pre(&decls, &mut budget);
+    *budget.depth = budget.depth.wrapping_mul(3);
+    (depth, ev.len(), digest(&ev))
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn drives() {
+        for k in [0u32, 1, 2, 4] {
+            println!("drive {} {:?}", k, drive(k));
+        }
+    }
+}
