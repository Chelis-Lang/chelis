+//@ [!lean] skip
+//@ [lean] subdir=LoopNestedSharedElements
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Loops whose state holds a `&'b mut Vec<&'a T>` behind a reborrowed
+//! reference, calling a function which pushes into it at each iteration (the
+//! shape of `chelis_deep::annotations::Metadata::visit_expressions`
+//! instantiated with the closures of
+//! `chelis_deep::literal_source::visit_binder_literal_uses`, which push the
+//! visited expressions onto a captured `&mut Vec<(&Expr, Option<..>)>`). The
+//! loop entry joins two distinct borrows of the vector whose elements are
+//! borrows of the nested region `'a`: the abstraction of `'a` is a child of
+//! the abstraction of `'b` and holds the pending loans of the vector given
+//! back through the outer borrow.
+
+pub struct Sink<'b, 'a> {
+    pub stack: &'b mut Vec<&'a u32>,
+}
+
+pub fn push<'b, 'a>(s: &mut Sink<'b, 'a>, e: &'a u32) {
+    s.stack.push(e);
+}
+
+/// A counter loop pushing the same element through the reborrowed sink
+pub fn push_n<'a>(x: &'a u32, s: &mut Sink<'_, 'a>, n: u32) {
+    let mut i = 0;
+    while i < n {
+        push(s, x);
+        i += 1;
+    }
+}
+
+/// A loop over a shared iterator pushing its elements through the sink
+pub fn push_all<'a>(xs: &'a Vec<u32>, s: &mut Sink<'_, 'a>) {
+    for e in xs.iter() {
+        push(s, e);
+    }
+}
+
+/// An order-sensitive digest of the referenced values
+pub fn digest(v: &Vec<&u32>) -> u32 {
+    let mut acc = 0u32;
+    let mut i = 0usize;
+    while i < v.len() {
+        acc = acc.wrapping_mul(31).wrapping_add(*v[i]);
+        i += 1;
+    }
+    acc
+}
+
+/// The vector given back through the sink after the loop, then written
+/// through the sink by the caller
+pub fn drive_push_n(n: u32) -> (usize, u32, u32) {
+    let a = 7u32;
+    let b = 100u32;
+    let c = 3u32;
+    let mut v: Vec<&u32> = Vec::new();
+    v.push(&b);
+    let mut s = Sink { stack: &mut v };
+    push_n(&a, &mut s, n);
+    s.stack.push(&c);
+    let len = v.len();
+    (len, digest(&v), *v[0])
+}
+
+pub fn drive_push_all(k: u32) -> (usize, u32) {
+    let mut xs: Vec<u32> = Vec::new();
+    let mut i = 0u32;
+    while i < k {
+        xs.push(i.wrapping_mul(10).wrapping_add(1));
+        i += 1;
+    }
+    let b = 5u32;
+    let mut v: Vec<&u32> = Vec::new();
+    let mut s = Sink { stack: &mut v };
+    push_all(&xs, &mut s);
+    s.stack.push(&b);
+    push_all(&xs, &mut s);
+    (v.len(), digest(&v))
+}
+
+/// The loop calls `visit: &mut F` where `F` captures `&mut Vec<..>`
+pub struct Meta {
+    pub exprs: Vec<u32>,
+}
+
+impl Meta {
+    pub fn visit<'a>(&'a self, visit: &mut impl FnMut(&'a u32, bool)) {
+        for e in self.exprs.iter() {
+            visit(e, true);
+        }
+    }
+}
+
+pub fn collect(m: &Meta, extra: u32) -> (usize, u32) {
+    let mut stack: Vec<(&u32, Option<&str>)> = Vec::new();
+    m.visit(&mut |value, _| stack.push((value, None)));
+    stack.push((&extra, Some("x")));
+    let len = stack.len();
+    let mut acc = 0u32;
+    while let Some((v, tag)) = stack.pop() {
+        acc = acc.wrapping_mul(31).wrapping_add(*v);
+        if tag.is_some() {
+            acc = acc.wrapping_add(1000);
+        }
+    }
+    (len, acc)
+}
+
+pub fn drive_collect(k: u32) -> (usize, u32) {
+    let mut exprs: Vec<u32> = Vec::new();
+    let mut i = 0u32;
+    while i < k {
+        exprs.push(i.wrapping_add(2));
+        i += 1;
+    }
+    let m = Meta { exprs };
+    collect(&m, 9)
+}
+
+/// A join of two distinct mutable borrows whose borrowed values hold shared
+/// borrows, of which no abstraction holds loans (the iterators of two slices):
+/// they are matched structurally.
+pub fn selected_iterator_sum(left: &[u32], right: &[u32], choose_left: bool) -> u32 {
+    let mut left = left.iter();
+    let mut right = right.iter();
+    let selected = if choose_left { &mut left } else { &mut right };
+    let mut total = 0u32;
+    while let Some(v) = selected.next() {
+        total = total.wrapping_mul(31).wrapping_add(*v);
+    }
+    total
+}
+
+pub fn drive_selected(choose_left: bool, n: u32) -> u32 {
+    let mut a: Vec<u32> = Vec::new();
+    let mut i = 0u32;
+    while i < n {
+        a.push(i.wrapping_add(7));
+        i += 1;
+    }
+    let mut b: Vec<u32> = Vec::new();
+    b.push(3);
+    b.push(5);
+    selected_iterator_sum(a.as_slice(), b.as_slice(), choose_left)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn drives() {
+        for n in [0u32, 1, 3] {
+            println!("push_n {} {:?}", n, drive_push_n(n));
+        }
+        for k in [0u32, 1, 3] {
+            println!("push_all {} {:?}", k, drive_push_all(k));
+        }
+        for k in [0u32, 1, 4] {
+            println!("collect {} {:?}", k, drive_collect(k));
+        }
+        for (choose_left, n) in [(true, 0u32), (true, 3), (false, 3)] {
+            println!("selected {} {} {:?}", choose_left, n, drive_selected(choose_left, n));
+        }
+    }
+}
