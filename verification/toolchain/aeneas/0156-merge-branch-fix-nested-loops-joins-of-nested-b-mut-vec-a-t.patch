+import LoopNestedSharedElements.LoopNestedSharedElements
+
+/-! Evaluate the model of `tests/src/loop-nested-shared-elements.rs` on the
+    inputs of its `native` test module and compare with the native results
+    (the vector given back through the sink after the loop, then written by
+    the caller). -/
+
+namespace loop_nested_shared_elements.checks
+open Aeneas Aeneas.Std Result
+
+def val3 (r : Result (Usize × U32 × U32)) : Option (Nat × Nat × Nat) :=
+  match r with
+  | ok (a, b, c) => some (a.val, b.val, c.val)
+  | _ => none
+
+def val2 (r : Result (Usize × U32)) : Option (Nat × Nat) :=
+  match r with
+  | ok (a, b) => some (a.val, b.val)
+  | _ => none
+
+def val1 (r : Result U32) : Option Nat :=
+  match r with
+  | ok a => some a.val
+  | _ => none
+
+-- native::drives
+#guard val3 (drive_push_n 0#u32) == some (2, 3103, 100)
+#guard val3 (drive_push_n 1#u32) == some (3, 96320, 100)
+#guard val3 (drive_push_n 3#u32) == some (5, 92567584, 100)
+#guard val2 (drive_push_all 0#u32) == some (1, 5)
+#guard val2 (drive_push_all 1#u32) == some (3, 1117)
+#guard val2 (drive_push_all 3#u32) == some (7, 1221968561)
+#guard val2 (drive_collect 0#u32) == some (1, 1009)
+#guard val2 (drive_collect 1#u32) == some (2, 31281)
+#guard val2 (drive_collect 4#u32) == some (5, 931985583)
+#guard val1 (drive_selected true 0#u32) == some 0
+#guard val1 (drive_selected true 3#u32) == some 6984
+#guard val1 (drive_selected false 3#u32) == some 98
+
+end loop_nested_shared_elements.checks
