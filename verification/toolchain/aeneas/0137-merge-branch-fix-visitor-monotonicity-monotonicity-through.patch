+//@ [!lean] skip
+//@ [lean] subdir=RecursiveVisitorClosures
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::result::{core::result::Result}
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Recursion through the closure passed to a visitor (the shape of chelis_ir
+//! `analyze_tensor_helper_preflight_scoped` over chelis_deep
+//! `Metadata::visit_expressions`): `visit_children`, generic in the visiting
+//! closure, passes its own closure (capturing the visiting closure and the
+//! outcome) to the recursive visitor `visit_expressions`, and `analyze` and
+//! `depth` recurse inside the visiting closure they pass to `visit_children`.
+//!
+//! The monomorphized closure of `visit_children` has a state type
+//! parameterized by the instance of the visiting closure (the trait clause of
+//! `visit_children`), which is built from the functions being defined: the
+//! Lean monotonicity proof of the `partial_fixpoint`s unfolds that type (and
+//! the matches on its values), which never uses the instance.
+//! `RecursiveVisitorClosures/Checks.lean` evaluates the model on the inputs of
+//! the `native` test module below and compares with the native results.
+
+pub enum Expr {
+    Atom(u32),
+    Map(Box<Metadata>),
+}
+
+pub enum Member {
+    Resource(Metadata),
+    Other,
+}
+
+pub enum MetadataValue {
+    Type(Expr),
+    Eff(Metadata, Vec<Member>),
+}
+
+pub struct Metadata {
+    pub values: Vec<MetadataValue>,
+}
+
+impl Metadata {
+    pub fn visit_expressions<'a>(&'a self, visit: &mut impl FnMut(&'a Expr, u8)) {
+        for value in self.values.iter() {
+            match value {
+                MetadataValue::Type(v) => visit(v, 0),
+                MetadataValue::Eff(m, members) => {
+                    m.visit_expressions(visit);
+                    for member in members.iter() {
+                        if let Member::Resource(v) = member {
+                            v.visit_expressions(visit);
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
+
+fn visit_children<E>(expr: &Expr, mut visit: impl FnMut(&Expr) -> Result<(), E>) -> Result<(), E> {
+    match expr {
+        Expr::Atom(_) => {}
+        Expr::Map(map) => {
+            let mut outcome = Ok(());
+            map.visit_expressions(&mut |value, _| {
+                if outcome.is_ok() {
+                    outcome = visit(value);
+                }
+            });
+            outcome?;
+        }
+    }
+    Ok(())
+}
+
+pub struct Out {
+    pub facts: Vec<bool>,
+    pub nodes: u32,
+}
+
+/// Whether `expr` or one of its descendants (through `visit_children`) is an
+/// atom in `summaries`; pushes the facts of the children of `expr` (each after
+/// those of its own children), then those of `expr`, to `out.facts`, and sums
+/// the node numbers into `out.nodes` (a child is numbered by the number of its
+/// parent plus its index)
+pub fn analyze(expr: &Expr, node: usize, summaries: &Vec<u32>, out: &mut Out) -> bool {
+    let mut facts = false;
+    if let Expr::Atom(n) = expr {
+        facts = summaries.contains(n);
+    }
+    let mut index = 0;
+    let Ok(()) = visit_children(expr, |child| -> Result<(), std::convert::Infallible> {
+        facts |= analyze(child, node + index, summaries, out);
+        index += 1;
+        Ok(())
+    });
+    out.facts.push(facts);
+    out.nodes = out.nodes.wrapping_add(node as u32);
+    facts
+}
+
+/// The depth of `expr` if at most `limit`, otherwise `Err` with the atom (or 0)
+/// where the limit was reached; counts the visited nodes in `count` (up to the
+/// error: the visit stops at the first error)
+pub fn depth(expr: &Expr, limit: u32, count: &mut u32) -> Result<u32, u32> {
+    *count += 1;
+    if limit == 0 {
+        return match expr {
+            Expr::Atom(n) => Err(*n),
+            Expr::Map(_) => Err(0),
+        };
+    }
+    let mut best = 0;
+    visit_children(expr, |child| -> Result<(), u32> {
+        let d = depth(child, limit - 1, count)?;
+        if d + 1 > best {
+            best = d + 1;
+        }
+        Ok(())
+    })?;
+    Ok(best)
+}
+
+fn atom(n: u32) -> Expr {
+    Expr::Atom(n)
+}
+
+fn map(m: Metadata) -> Expr {
+    Expr::Map(Box::new(m))
+}
+
+fn one(v: MetadataValue) -> Metadata {
+    let mut values = Vec::new();
+    values.push(v);
+    Metadata { values }
+}
+
+fn two(v: MetadataValue, w: MetadataValue) -> Metadata {
+    let mut values = Vec::new();
+    values.push(v);
+    values.push(w);
+    Metadata { values }
+}
+
+fn ty(e: Expr) -> MetadataValue {
+    MetadataValue::Type(e)
+}
+
+/// A tree over the atoms `a`, `b`, `c` of the given shape:
+/// - 0: `a`
+/// - 1: `{a, b}`
+/// - 2: `{eff {a} [resource {b}, other, resource {{c}}]}`
+/// - 3: `{{a}, eff {} [other], b, c}`
+/// - otherwise: `{{{a}, eff {{b}} [resource {c}]}, c}`
+fn tree(shape: u8, a: u32, b: u32, c: u32) -> Expr {
+    match shape {
+        0 => atom(a),
+        1 => map(two(ty(atom(a)), ty(atom(b)))),
+        2 => {
+            let mut members = Vec::new();
+            members.push(Member::Resource(one(ty(atom(b)))));
+            members.push(Member::Other);
+            members.push(Member::Resource(one(ty(map(one(ty(atom(c))))))));
+            map(one(MetadataValue::Eff(one(ty(atom(a))), members)))
+        }
+        3 => {
+            let mut members = Vec::new();
+            members.push(Member::Other);
+            let mut values = Vec::new();
+            values.push(ty(map(one(ty(atom(a))))));
+            values.push(MetadataValue::Eff(Metadata { values: Vec::new() }, members));
+            values.push(ty(atom(b)));
+            values.push(ty(atom(c)));
+            map(Metadata { values })
+        }
+        _ => {
+            let mut members = Vec::new();
+            members.push(Member::Resource(one(ty(atom(c)))));
+            let inner = two(
+                ty(map(one(ty(atom(a))))),
+                MetadataValue::Eff(one(ty(map(one(ty(atom(b)))))), members),
+            );
+            map(two(ty(map(inner)), ty(atom(c))))
+        }
+    }
+}
+
+/// `(result, facts, mask, nodes)` of `analyze` on `tree(shape, a, b, c)` with
+/// the summaries `[s0, s1]`, from node `node`: `facts` is the number of facts
+/// pushed, `mask` their bits (the first one lowest), `nodes` the sum of the
+/// node numbers; the caller then pushes `true` through the borrow given back
+/// by the call (included in `facts` and `mask`)
+pub fn run_analyze(shape: u8, a: u32, b: u32, c: u32, s0: u32, s1: u32, node: usize) -> (bool, u32, u32, u32) {
+    let e = tree(shape, a, b, c);
+    let mut summaries = Vec::new();
+    summaries.push(s0);
+    summaries.push(s1);
+    let mut out = Out { facts: Vec::new(), nodes: 0 };
+    let r = {
+        let o = &mut out;
+        let r = analyze(&e, node, &summaries, o);
+        o.facts.push(true);
+        o.nodes = o.nodes.wrapping_add(1000);
+        r
+    };
+    let mut mask = 0u32;
+    let mut bit = 1u32;
+    for f in out.facts.iter() {
+        if *f {
+            mask |= bit;
+        }
+        bit = bit.wrapping_mul(2);
+    }
+    (r, out.facts.len() as u32, mask, out.nodes)
+}
+
+/// `(ok, value, count)` of `depth` on `tree(shape, a, b, c)` with the limit
+/// `limit`, the count starting at `start`: `value` is the depth if `ok`, the
+/// atom where the limit was reached otherwise; the caller then adds 100 to the
+/// count through the borrow given back by the call
+pub fn run_depth(shape: u8, a: u32, b: u32, c: u32, limit: u32, start: u32) -> (bool, u32, u32) {
+    let e = tree(shape, a, b, c);
+    let mut count = start;
+    let r = {
+        let k = &mut count;
+        let r = depth(&e, limit, k);
+        *k += 100;
+        r
+    };
+    match r {
+        Ok(d) => (true, d, count),
+        Err(n) => (false, n, count),
+    }
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn results() {
+        assert_eq!(run_analyze(0, 5, 7, 3, 5, 9, 0), (true, 2, 3, 1000));
+        assert_eq!(run_analyze(1, 5, 7, 3, 7, 9, 2), (true, 4, 14, 1007));
+        assert_eq!(run_analyze(2, 5, 7, 3, 3, 9, 1), (true, 6, 60, 1010));
+        assert_eq!(run_analyze(3, 5, 7, 3, 9, 8, 4), (false, 6, 32, 1023));
+        assert_eq!(run_analyze(4, 5, 7, 3, 7, 8, 10), (true, 9, 428, 1085));
+        assert_eq!(run_analyze(4, 5, 7, 3, 1, 2, 0), (false, 9, 256, 1005));
+        assert_eq!(run_depth(0, 5, 7, 3, 3, 0), (true, 0, 101));
+        assert_eq!(run_depth(2, 5, 7, 3, 3, 1), (true, 2, 106));
+        assert_eq!(run_depth(3, 5, 7, 3, 1, 0), (false, 0, 102));
+        assert_eq!(run_depth(4, 5, 7, 3, 5, 0), (true, 3, 108));
+        assert_eq!(run_depth(4, 5, 7, 3, 3, 10), (false, 5, 114));
+        assert_eq!(run_depth(4, 5, 7, 3, 2, 0), (false, 0, 103));
+        assert_eq!(run_depth(2, 5, 7, 3, 0, 0), (false, 0, 101));
+        assert_eq!(run_depth(2, 5, 7, 3, 1, 0), (false, 5, 102));
+        assert_eq!(run_depth(2, 5, 7, 3, 2, 0), (false, 3, 105));
+    }
+}
