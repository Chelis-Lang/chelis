+    `native` test module and compare with the native results. `analyze` and `depth` are
+    `partial_fixpoint`s which recurse inside the closure they pass to `visit_children`, which
+    passes its own closure, capturing that closure, to the recursive visitor
+    `Metadata.visit_expressions`, monomorphized to it. The values given back by the calls
+    (`out` of `analyze`, `count` of `depth`) are updated by the callers after the calls. -/
+
+namespace recursive_visitor_closures.checks
+open Aeneas Aeneas.Std Result
+
+def okAnalyze : Result (Bool × U32 × U32 × U32) → Option (Bool × Nat × Nat × Nat)
+  | ok (r, n, mask, nodes) => some (r, n.val, mask.val, nodes.val)
+  | _ => none
+
+def okDepth : Result (Bool × U32 × U32) → Option (Bool × Nat × Nat)
+  | ok (r, v, count) => some (r, v.val, count.val)
+  | _ => none
+
+#guard okAnalyze (run_analyze 0#u8 5#u32 7#u32 3#u32 5#u32 9#u32 0#usize) == some (true, 2, 3, 1000)
+#guard okAnalyze (run_analyze 1#u8 5#u32 7#u32 3#u32 7#u32 9#u32 2#usize) == some (true, 4, 14, 1007)
+#guard okAnalyze (run_analyze 2#u8 5#u32 7#u32 3#u32 3#u32 9#u32 1#usize) == some (true, 6, 60, 1010)
+#guard okAnalyze (run_analyze 3#u8 5#u32 7#u32 3#u32 9#u32 8#u32 4#usize) == some (false, 6, 32, 1023)
+#guard okAnalyze (run_analyze 4#u8 5#u32 7#u32 3#u32 7#u32 8#u32 10#usize) == some (true, 9, 428, 1085)
+#guard okAnalyze (run_analyze 4#u8 5#u32 7#u32 3#u32 1#u32 2#u32 0#usize) == some (false, 9, 256, 1005)
+
+#guard okDepth (run_depth 0#u8 5#u32 7#u32 3#u32 3#u32 0#u32) == some (true, 0, 101)
+#guard okDepth (run_depth 2#u8 5#u32 7#u32 3#u32 3#u32 1#u32) == some (true, 2, 106)
+#guard okDepth (run_depth 3#u8 5#u32 7#u32 3#u32 1#u32 0#u32) == some (false, 0, 102)
+#guard okDepth (run_depth 4#u8 5#u32 7#u32 3#u32 5#u32 0#u32) == some (true, 3, 108)
+#guard okDepth (run_depth 4#u8 5#u32 7#u32 3#u32 3#u32 10#u32) == some (false, 5, 114)
+#guard okDepth (run_depth 4#u8 5#u32 7#u32 3#u32 2#u32 0#u32) == some (false, 0, 103)
+#guard okDepth (run_depth 2#u8 5#u32 7#u32 3#u32 0#u32 0#u32) == some (false, 0, 101)
+#guard okDepth (run_depth 2#u8 5#u32 7#u32 3#u32 1#u32 0#u32) == some (false, 5, 102)
+#guard okDepth (run_depth 2#u8 5#u32 7#u32 3#u32 2#u32 0#u32) == some (false, 3, 105)
