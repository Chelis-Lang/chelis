+/// A digest, as `chelis_types::context::LibraryProofId`'s.
+pub struct Digest(pub [u8; 32]);
+
+impl Serialize for Digest {
+    fn serialize<S: Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
+        self.0.serialize(serializer)
+    }
+}
+
+/// Words, which the in-test format rejects from the first one above 100.
+pub struct Words(pub [u32; 32]);
+
+impl Serialize for Words {
+    fn serialize<S: Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
+        self.0.serialize(serializer)
+    }
+}
+
+pub fn de_digest<'de, D: Deserializer<'de>>(deserializer: D) -> Result<[u8; 32], D::Error> {
+    <[u8; 32]>::deserialize(deserializer)
+}
+
 #[cfg(test)]
 mod native {
     use super::*;
@@ -881,4 +908,57 @@ mod native {
             Err(err("invalid type: integer `1`, expected a sequence"))
         );
     }
+
+    fn u8s(ns: &[u8]) -> Vec<Value> {
+        ns.iter().map(|n| Num("u8", *n as i128)).collect()
+    }
+
+    #[test]
+    fn arrays() {
+        let digest: [u8; 32] = core::array::from_fn(|i| (i * 37 % 256) as u8);
+        assert_eq!(ser(&Digest(digest)), Ok(Tuple(32, u8s(&digest))));
+        let words: [u32; 32] = core::array::from_fn(|i| i as u32 * 3);
+        assert_eq!(ser(&Words(words)), Ok(Tuple(32, u32s(&words))));
+        let mut big = words;
+        big[5] = 101;
+        big[9] = 200;
+        assert_eq!(ser(&Words(big)), Err(err("big")));
+        let mut last = words;
+        last[31] = 101;
+        assert_eq!(ser(&Words(last)), Err(err("big")));
+
+        let seq = |xs: Vec<Value>| ValueDe(Seq(Option::None, xs));
+        assert_eq!(de_digest(ValueDe(Tuple(32, u8s(&digest)))), Ok(digest));
+        // The element kinds of `u8`'s visitor.
+        let mixed = (0..32)
+            .map(|i| if i % 2 == 0 { Num("u64", i) } else { Num("i8", i) })
+            .collect();
+        assert_eq!(de_digest(seq(mixed)), Ok(core::array::from_fn(|i| i as u8)));
+        // The elements after the 32nd are the deserializer's (`ValueDe` ignores them).
+        let mut longer = u8s(&digest);
+        longer.push(Num("u8", 9));
+        longer.push(s("x"));
+        assert_eq!(de_digest(seq(longer)), Ok(digest));
+        assert_eq!(
