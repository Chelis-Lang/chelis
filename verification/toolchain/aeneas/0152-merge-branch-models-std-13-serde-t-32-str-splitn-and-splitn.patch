+import SliceRposition.SliceRposition
+
+/-! Evaluate the model of `tests/src/slice-rposition.rs` on the inputs of its `native` test module
+    and compare with the native results (including the predicate calls counted through its captured
+    mutable borrow), and the default `Iterator::rposition` on a user iterator. -/
+namespace slice_rposition.checks
+open Aeneas Aeneas.Std Result
+
+def vec (xs : List Nat) : alloc.vec.Vec U32 :=
+  let xs := xs.map fun n => (⟨BitVec.ofNat _ n⟩ : U32)
+  if h : xs.length ≤ Usize.max then ⟨xs, h⟩ else ⟨[], by simp⟩
+def slice (xs : List Nat) : Slice U32 :=
+  let xs := xs.map fun n => (⟨BitVec.ofNat _ n⟩ : U32)
+  if h : xs.length ≤ Usize.max then ⟨xs, h⟩ else ⟨[], by simp⟩
+def usize (n : Nat) : Usize := ⟨BitVec.ofNat _ n⟩
+
+def popOf (xs : List Nat) (id : Nat) : Option (List Nat) :=
+  match pop (vec xs) ⟨BitVec.ofNat _ id⟩ with
+  | ok v => some (v.val.map (·.val))
+  | _ => none
+
+#guard popOf [1, 2, 1, 3] 1 == some [1, 2, 3]
+#guard popOf [1, 2, 3] 4 == some [1, 2, 3]
+#guard popOf [] 4 == some []
+#guard popOf [5] 5 == some []
+
+def scanOf (xs : List Nat) (front back limit : Nat) :
+    Option (Option Nat × Nat × Option Nat × Option Nat) :=
+  match scan (slice xs) (usize front) (usize back) ⟨BitVec.ofNat _ limit⟩ with
+  | ok (found, calls, first, last) =>
+    some (found.map (·.val), calls.val, first.map (·.val), last.map (·.val))
+  | _ => none
+
+#guard scanOf [9, 1, 8, 2, 3] 0 0 5 == some (some 2, 3, some 9, some 1)
+#guard scanOf [9, 1, 8, 2, 3] 1 0 5 == some (some 1, 3, some 1, none)
+#guard scanOf [9, 1, 8, 2, 3] 1 3 5 == some (none, 1, none, none)
+#guard scanOf [9, 1, 8, 2, 3] 0 0 10 == some (none, 5, none, none)
+#guard scanOf [9, 1, 8, 2, 3] 0 1 1 == some (some 3, 1, some 9, some 8)
+#guard scanOf [] 0 0 0 == some (none, 0, none, none)
+
+/-- The default `Iterator::rposition`: the position, the predicate calls (given back through the
+    captured mutable borrow) and the remaining range. -/
+def countdownOf (start stop multiple : Nat) : Option (Option Nat × Nat × Nat × Nat) :=
+  match countdown ⟨BitVec.ofNat _ start⟩ ⟨BitVec.ofNat _ stop⟩ ⟨BitVec.ofNat _ multiple⟩ with
+  | ok (found, calls, s, e) => some (found.map (·.val), calls.val, s.val, e.val)
+  | _ => none
+
+#guard countdownOf 10 20 7 == some (some 4, 6, 10, 14)
+#guard countdownOf 10 20 5 == some (some 5, 5, 10, 15)
+#guard countdownOf 11 14 10 == some (none, 3, 11, 11)
+#guard countdownOf 3 3 1 == some (none, 0, 3, 3)
+#guard countdownOf 0 4 3 == some (some 3, 1, 0, 3)
+
+end slice_rposition.checks
