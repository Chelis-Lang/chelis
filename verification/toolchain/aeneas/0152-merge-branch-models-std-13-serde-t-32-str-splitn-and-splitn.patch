+def serializeTupleElements {T ST Ok Error : Type}
+    (tupleInst : serde_core.ser.SerializeTuple ST Ok Error) (d : serde_core.ser.SerializeΩ T) :
+    List T → ST → Result (core.result.Result Unit Error × ST)
+  | [], seq => ok (.Ok (), seq)
+  | e :: rest, seq => do
+    let (r, seq) ← tupleInst.serialize_element d seq e
