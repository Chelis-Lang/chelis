+/-- The loop of `Iter::rposition` from the index `i` (the number of elements left before the
+    back): `while let Some(x) = self.next_back() { i -= 1; if predicate(x) { return Some(i) } }
+    None`. -/
+def core.slice.iter.IteratorSliceIter.rpositionFrom {T P : Type}
+    (fnInst : core.ops.function.FnMut P T Bool) :
+    Nat → core.slice.iter.Iter T → P → Result (Option Usize × core.slice.iter.Iter T × P)
+  | 0, self, predicate => ok (none, self, predicate)
+  | i + 1, self, predicate => do
+    let (x, self) ← core.slice.iter.DoubleEndedIteratorSliceIter.next_back self
+    match x with
+    | none => ok (none, self, predicate)
+    | some x =>
+      let (found, predicate) ← fnInst.call_mut predicate x
+      if found then ok (some ⟨BitVec.ofNat _ i⟩, self, predicate)
+      else core.slice.iter.IteratorSliceIter.rpositionFrom fnInst i self predicate
+
+/-- `Iter::rposition` (core/src/slice/iter/macros.rs, rustc 1.95): `let n = len!(self); let mut
+    i = n;` then the loop of `rpositionFrom`: the index, from the front of the remaining elements,
+    of the last one satisfying the predicate, the elements from the back through it consumed.
+    Without an element left, `next_back` is `None` (`i = 0`). The `ExactSizeIterator` and
+    `DoubleEndedIterator` clauses of `Self` are the slice iterator's own. -/
+@[rust_fun
+  "core::slice::iter::{core::iter::traits::iterator::Iterator<core::slice::iter::Iter<'a, @T>, &'a @T>}::rposition"
+  (keepTraitClauses := [true, false, false])]
+def core.slice.iter.IteratorSliceIter.rposition {T P : Type}
+    (fnInst : core.ops.function.FnMut P T Bool) (self : core.slice.iter.Iter T) (predicate : P) :
+    Result (Option Usize × core.slice.iter.Iter T × P) :=
+  core.slice.iter.IteratorSliceIter.rpositionFrom fnInst
+    (self.slice.length - self.back - self.i) self predicate
+
