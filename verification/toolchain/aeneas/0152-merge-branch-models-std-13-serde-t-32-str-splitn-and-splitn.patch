+/-! ### Arrays (`array_impls!`: one impl per length, 1 to 32) -/
+
+/-- `concat!("an array of length ", N)` (`ArrayVisitor<[T; N]>::expecting`, also its
+    `Expected`). -/
+def arrayExpecting (len : Nat) (_ : Unit) (formatter : core.fmt.Formatter) : core.fmt.Outcome :=
+  formatter.append s!"an array of length {len}"
+
+/-- The elements `n`, `n + 1`, ... of `ArrayVisitor::visit_seq`'s array literal, `k` of them:
+    each is `match tri!(seq.next_element()) { Some(val) => val, None => return
+    Err(Error::invalid_length(n, &self)) }`, in order (the first error or the first missing element
+    ends the visit; the elements read before are dropped). -/
+def arrayElements {A Error T : Type} (seq : serde_core.de.SeqAccess A Error)
+    (d : serde_core.de.DeserializeΩ T) (expected : serde_core.de.DynExpected) (n : Nat) :
+    (k : Nat) → A → Result (core.result.Result { l : List T // l.length = k } Error)
+  | 0, _ => ok (.Ok ⟨[], rfl⟩)
+  | k + 1, access => do
+    let (r, access) ← seq.next_element d access
+    match r with
+    | .Err e => ok (.Err e)
+    | .Ok none =>
+      ok (.Err (← seq.serde_coredeErrorInst.invalid_length ⟨BitVec.ofNat _ n⟩ expected))
+    | .Ok (some v) =>
+      match ← arrayElements seq d expected (n + 1) k access with
+      | .Err e => ok (.Err e)
+      | .Ok vs => ok (.Ok ⟨v :: vs.val, by simp [vs.property]⟩)
+
+/-- `ArrayVisitor<[T; N]>` (de/impls.rs `array_impls!`, `N` from 1 to 32): `expecting` is
+    "an array of length N"; `visit_seq` reads the `N` elements (a longer sequence is not checked
+    here: the remaining elements are the deserializer's). -/
+def ArrayVisitor {T : Type} (i : serde_core.de.Deserialize T) (N : Usize) :
+    serde_core.de.Visitor Unit (Array T N) :=
+  { expecting := arrayExpecting N.val
+    visit_seq := fun {A Error} (seq : serde_core.de.SeqAccess A Error) self access => do
+      match ← arrayElements seq (Deserialize.wrap i) (expectedOf (arrayExpecting N.val) self) 0
+          N.val access with
+      | .Err e => ok (.Err e)
+      | .Ok vs => ok (.Ok ⟨vs.val, vs.property⟩) }
+
+/-- `impl<'de, T: Deserialize<'de>> Deserialize<'de> for [T; 32]` (`array_impls!`):
+    `deserializer.deserialize_tuple(32, ArrayVisitor::<[T; 32]>::new())`. One impl per length:
+    the lengths the core uses are registered, any other one stays an unknown external. -/
+@[rust_fun "serde_core::de::impls::{serde_core::de::Deserialize<'de, [@T; 32]>}::deserialize"]
+def DeserializeArray32.deserialize {T D Error : Type} (i : serde_core.de.Deserialize T)
+    (inst : serde_core.de.Deserializer D Error) (deserializer : D) :
+    Result (core.result.Result (Array T 32#usize) Error) :=
+  inst.deserialize_tuple (Visitor.wrap (ArrayVisitor i 32#usize)) deserializer 32#usize ()
+
+@[reducible, rust_trait_impl "serde_core::de::Deserialize<'de, [@T; 32]>"]
+def DeserializeArray32 {T : Type} (i : serde_core.de.Deserialize T) :
+    serde_core.de.Deserialize (Array T 32#usize) :=
+  { deserialize := fun inst deserializer => DeserializeArray32.deserialize i inst deserializer }
+
