diff --git a/tests/lean/FmtLowerExp/Checks.lean b/tests/lean/FmtLowerExp/Checks.lean
new file mode 100644
index 0000000..cc75ff0
--- /dev/null
+++ b/tests/lean/FmtLowerExp/Checks.lean
@@ -0,0 +1,66 @@
+import FmtLowerExp.FmtLowerExp
+
+open Aeneas Aeneas.Std
+
+namespace fmt_lower_exp.checks
+
+/-! Mirrors the native tests of `tests/src/fmt-lower-exp.rs`: `{:e}` of `f64` (shortest digits, zero,
+    the sign, NaN and the infinities), with a precision (half to even, the carry into the
+    exponent, zero padding past the exact digits, a dynamic precision), width, alignment and
+    sign-aware zero padding, and an `{abs:e}` argument of a message. Floats are given by their
+    bits. -/
+
+def f (bits : Nat) : F64 := BinaryFloat.ofNat _ bits
+def us (n : Nat) : Usize := ⟨BitVec.ofNat _ n⟩
+
+def out : Result String → Option String
+  | .ok s => some s
+  | _ => none
+
+open fmt_lower_exp
+
+-- 1.5e-7, 1e21, 0.1, 123456.0, -0.0, 0.0, f64::MAX, f64::MIN_POSITIVE, 5e-324, -1.0
+#guard out (exp (f 0x3e8421f5f40d8376)) == some "1.5e-7"
+#guard out (exp (f 0x444b1ae4d6e2ef50)) == some "1e21"
+#guard out (exp (f 0x3fb999999999999a)) == some "1e-1"
+#guard out (exp (f 0x40fe240000000000)) == some "1.23456e5"
+#guard out (exp (f 0x8000000000000000)) == some "-0e0"
+#guard out (exp (f 0)) == some "0e0"
+#guard out (exp (f 0x7fefffffffffffff)) == some "1.7976931348623157e308"
+#guard out (exp (f 0x0010000000000000)) == some "2.2250738585072014e-308"
+#guard out (exp (f 1)) == some "5e-324"
+#guard out (exp (f 0xbff0000000000000)) == some "-1e0"
+-- NaN, -NaN, inf, -inf, 9007199254740993.0 (= 2^53)
+#guard out (exp (f 0x7ff8000000000000)) == some "NaN"
+#guard out (exp (f 0xfff8000000000000)) == some "NaN"
+#guard out (exp (f 0x7ff0000000000000)) == some "inf"
+#guard out (exp (f 0xfff0000000000000)) == some "-inf"
+#guard out (exp (f 0x4340000000000000)) == some "9.007199254740992e15"
+
+-- `precision`: 1234.5, 1235.5, 9999.5, 0.0, -0.0, NaN, 0.1
+#guard out (exp3 (f 0x40934a0000000000)) == some "1.234e3"
+#guard out (exp3 (f 0x40934e0000000000)) == some "1.236e3"
+#guard out (exp3 (f 0x40c387c000000000)) == some "1.000e4"
+#guard out (exp3 (f 0)) == some "0.000e0"
+#guard out (exp3 (f 0x8000000000000000)) == some "-0.000e0"
+#guard out (exp3 (f 0x7ff8000000000000)) == some "NaN"
+#guard out (exp3 (f 0x3fb999999999999a)) == some "1.000e-1"
+-- 2.5, 3.5, 9.96, 0.1, 5e-324, f64::MAX, 1.0, 0.0
+#guard out (exp_prec (f 0x4004000000000000) (us 0)) == some "2e0"
+#guard out (exp_prec (f 0x400c000000000000) (us 0)) == some "4e0"
+#guard out (exp_prec (f 0x4023eb851eb851ec) (us 1)) == some "1.0e1"
+#guard out (exp_prec (f 0x3fb999999999999a) (us 20)) == some "1.00000000000000005551e-1"
+#guard out (exp_prec (f 1) (us 2)) == some "4.94e-324"
+#guard out (exp_prec (f 0x7fefffffffffffff) (us 0)) == some "2e308"
+#guard out (exp_prec (f 0x3ff0000000000000) (us 30)) == some "1.000000000000000000000000000000e0"
+#guard out (exp_prec (f 0) (us 0)) == some "0e0"
+
+-- `padded`: 1234.5, -0.0, NaN, -inf, and the message
+#guard out (exp_padded (f 0x40934a0000000000)) == some "+000001.23e3|  1.2345e3|1e3     |"
+#guard out (exp_padded (f 0x8000000000000000)) == some "-000000.00e0|      -0e0|-0e0    |"
+#guard out (exp_padded (f 0x7ff8000000000000)) == some "000000000NaN|       NaN|NaN     |"
