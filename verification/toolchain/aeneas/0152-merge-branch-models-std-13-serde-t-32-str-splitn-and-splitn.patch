+    `native` test module and compare with the native results. -/
+namespace str_splitn.checks
+open Aeneas Aeneas.Std Result
+
+def txt (x : Str) : Option String :=
+  match Str.toString x with | ok t => some t | _ => none
+def strs (r : Result (alloc.vec.Vec Str)) : Option (List String) :=
+  match r with | ok v => v.val.mapM txt | _ => none
+def opt (x : Option Str) : Option (Option String) :=
+  match x with | some x => (txt x).map some | none => some none
+def usize (n : Nat) : Usize := ⟨BitVec.ofNat _ n⟩
+
+#guard strs (pieces (toStr "a: b: c") (usize 2) (toStr ": ")) == some ["a", "b: c"]
+#guard strs (pieces (toStr "a: b: c") (usize 3) (toStr ": ")) == some ["a", "b", "c"]
+#guard strs (pieces (toStr "a: b: c") (usize 9) (toStr ": ")) == some ["a", "b", "c"]
+#guard strs (pieces (toStr "a: b: c") (usize 1) (toStr ": ")) == some ["a: b: c"]
+#guard strs (pieces (toStr "a: b: c") (usize 0) (toStr ": ")) == some []
+#guard strs (pieces (toStr "") (usize 2) (toStr ": ")) == some [""]
+#guard strs (pieces (toStr "a: ") (usize 2) (toStr ": ")) == some ["a", ""]
+#guard strs (pieces (toStr "abc") (usize 3) (toStr "")) == some ["", "a", "bc"]
+#guard strs (pieces (toStr "héllo wörld") (usize 2) (toStr "ö")) == some ["héllo w", "rld"]
+
+def sidesOf (message : Str) : Option (Option (String × String)) :=
+  match sides message with
+  | ok (some (a, b)) => (do some (← txt a, ← txt b)).map some
+  | ok none => some none
+  | _ => none
+
+#guard sidesOf (toStr "mismatch: i32 vs f64") == some (some ("i32", "f64"))
+#guard sidesOf (toStr "mismatch: i32 vs f64 vs u8") == some (some ("i32", "f64 vs u8"))
+#guard sidesOf (toStr "mismatch: i32") == some none
+#guard sidesOf (toStr "no colon") == some none
+
+def fusedOf (text : Str) (n : Nat) (pattern : Str) :
+    Option (Nat × Option (Option String) × Option (Option String)) :=
+  match fused text (usize n) pattern with
+  | ok (count, a, b) => some (count.val, opt a, opt b)
+  | _ => none
+
+#guard fusedOf (toStr "a,b,,c") 3 (toStr ",") == some (3, some none, some none)
+#guard fusedOf (toStr "a,b") 0 (toStr ",") == some (0, some none, some none)
+#guard fusedOf (toStr "a,b") 5 (toStr ",") == some (2, some none, some none)
+
+end str_splitn.checks
