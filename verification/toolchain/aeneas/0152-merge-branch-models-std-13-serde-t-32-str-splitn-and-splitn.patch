diff --git a/tests/src/slice-rposition.rs b/tests/src/slice-rposition.rs
new file mode 100644
index 0000000..dfaa028
--- /dev/null
+++ b/tests/src/slice-rposition.rs
@@ -0,0 +1,123 @@
+//@ [!lean] skip
+//@ [lean] subdir=SliceRposition
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! `slice::Iter::rposition` (core/src/slice/iter/macros.rs): the index, from the front of the
+//! remaining elements, of the last one satisfying the predicate, the elements from the back through
+//! it consumed, with a predicate which counts its calls through a captured mutable borrow (given
+//! back); as chelis-types `linearity.rs` pops a binding from its stack. Also the default
+//! `Iterator::rposition` of an iterator which does not override it. SliceRposition/Checks.lean
+//! compares the model with the native results asserted in the native test module.
+
+/// chelis-types `linearity.rs`: remove the last occurrence of `id`.
+pub fn pop(mut stack: Vec<u32>, id: u32) -> Vec<u32> {
+    if let Some(position) = stack.iter().rposition(|entry| *entry == id) {
+        stack.remove(position);
+    }
+    stack
+}
+
+/// The position, the number of predicate calls, and what the iterator yields afterwards from
+/// the front and from the back, after skipping `front` elements and `back` elements.
+pub fn scan(
+    items: &[u32],
+    front: usize,
+    back: usize,
+    limit: u32,
+) -> (Option<usize>, u32, Option<u32>, Option<u32>) {
+    let mut iter = items.iter();
+    for _ in 0..front {
+        iter.next();
+    }
+    for _ in 0..back {
+        iter.next_back();
+    }
+    let mut calls = 0u32;
+    let counter = &mut calls;
+    let found = iter.rposition(|x| {
+        *counter += 1;
+        *x > limit
+    });
+    let first = match iter.next() {
+        Some(x) => Some(*x),
+        None => None,
+    };
+    let last = match iter.next_back() {
+        Some(x) => Some(*x),
+        None => None,
+    };
+    (found, calls, first, last)
+}
+
+/// A double-ended counter over `start..end` which keeps the default `Iterator::rposition`
+/// (`len` and `try_rfold` through `next_back`).
+pub struct Countdown {
+    pub start: u32,
+    pub end: u32,
+}
+
+impl Iterator for Countdown {
+    type Item = u32;
+    fn next(&mut self) -> Option<u32> {
+        if self.start < self.end {
+            self.start += 1;
+            Some(self.start - 1)
+        } else {
+            None
+        }
+    }
+    fn size_hint(&self) -> (usize, Option<usize>) {
+        let n = if self.start < self.end { (self.end - self.start) as usize } else { 0 };
+        (n, Some(n))
+    }
+}
+
+impl DoubleEndedIterator for Countdown {
+    fn next_back(&mut self) -> Option<u32> {
+        if self.start < self.end {
+            self.end -= 1;
+            Some(self.end)
+        } else {
+            None
+        }
+    }
+}
+
+impl ExactSizeIterator for Countdown {}
+
+/// The default `rposition` on `start..end`, with a predicate counting its calls through a
+/// captured mutable borrow; then the remaining range.
+pub fn countdown(start: u32, end: u32, multiple: u32) -> (Option<usize>, u32, u32, u32) {
+    let mut it = Countdown { start, end };
+    let mut calls = 0u32;
+    let counter = &mut calls;
+    let found = it.rposition(|x| {
+        *counter += 1;
+        x % multiple == 0
+    });
+    (found, calls, it.start, it.end)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn rposition() {
+        assert_eq!(pop(vec![1, 2, 1, 3], 1), vec![1, 2, 3]);
+        assert_eq!(pop(vec![1, 2, 3], 4), vec![1, 2, 3]);
+        assert_eq!(pop(vec![], 4), Vec::<u32>::new());
+        assert_eq!(pop(vec![5], 5), Vec::<u32>::new());
+        assert_eq!(scan(&[9, 1, 8, 2, 3], 0, 0, 5), (Some(2), 3, Some(9), Some(1)));
+        assert_eq!(scan(&[9, 1, 8, 2, 3], 1, 0, 5), (Some(1), 3, Some(1), None));
+        assert_eq!(scan(&[9, 1, 8, 2, 3], 1, 3, 5), (None, 1, None, None));
+        assert_eq!(scan(&[9, 1, 8, 2, 3], 0, 0, 10), (None, 5, None, None));
+        assert_eq!(scan(&[9, 1, 8, 2, 3], 0, 1, 1), (Some(3), 1, Some(9), Some(8)));
+        assert_eq!(scan(&[], 0, 0, 0), (None, 0, None, None));
+        assert_eq!(countdown(10, 20, 7), (Some(4), 6, 10, 14));
+        assert_eq!(countdown(10, 20, 5), (Some(5), 5, 10, 15));
+        assert_eq!(countdown(11, 14, 10), (None, 3, 11, 11));
+        assert_eq!(countdown(3, 3, 1), (None, 0, 3, 3));
+        assert_eq!(countdown(0, 4, 3), (Some(3), 1, 0, 3));
+    }
+}
diff --git a/tests/src/str-splitn.rs b/tests/src/str-splitn.rs
new file mode 100644
index 0000000..12cd795
--- /dev/null
+++ b/tests/src/str-splitn.rs
@@ -0,0 +1,57 @@
+//@ [!lean] skip
+//@ [lean] subdir=StrSplitn
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! `str::splitn` with a `&str` pattern and its `SplitN` iterator (collected by the admitted Vec
+//! collector), as chelis-types `errors.rs` uses it: at most `n` pieces, the last one the rest of
+//! the text (even when empty), none at all for `n = 0`, and the fused end. StrSplitn/Checks.lean
+//! compares the model with the native results asserted in the native test module.
+
+pub fn pieces<'a>(text: &'a str, n: usize, pattern: &str) -> Vec<&'a str> {
+    text.splitn(n, pattern).collect()
+}
+
+/// chelis-types `errors.rs`: the message after the first `": "`, then its two sides.
+pub fn sides(message: &str) -> Option<(&str, &str)> {
+    let parts: Vec<&str> = message.splitn(2, ": ").collect();
+    if parts.len() < 2 {
+        return None;
+    }
+    let sides: Vec<&str> = parts[1].splitn(2, " vs ").collect();
+    if sides.len() == 2 { Some((sides[0], sides[1])) } else { None }
+}
+
+/// The number of pieces, then two more calls after the end.
+pub fn fused<'a>(text: &'a str, n: usize, pattern: &str) -> (usize, Option<&'a str>, Option<&'a str>) {
+    let mut iter = text.splitn(n, pattern);
+    let mut count = 0;
+    while iter.next().is_some() {
+        count += 1;
+    }
+    (count, iter.next(), iter.next())
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn splitn() {
+        assert_eq!(pieces("a: b: c", 2, ": "), vec!["a", "b: c"]);
+        assert_eq!(pieces("a: b: c", 3, ": "), vec!["a", "b", "c"]);
+        assert_eq!(pieces("a: b: c", 9, ": "), vec!["a", "b", "c"]);
+        assert_eq!(pieces("a: b: c", 1, ": "), vec!["a: b: c"]);
+        assert_eq!(pieces("a: b: c", 0, ": "), Vec::<&str>::new());
+        assert_eq!(pieces("", 2, ": "), vec![""]);
+        assert_eq!(pieces("a: ", 2, ": "), vec!["a", ""]);
+        assert_eq!(pieces("abc", 3, ""), vec!["", "a", "bc"]);
+        assert_eq!(pieces("héllo wörld", 2, "ö"), vec!["héllo w", "rld"]);
+        assert_eq!(sides("mismatch: i32 vs f64"), Some(("i32", "f64")));
+        assert_eq!(sides("mismatch: i32 vs f64 vs u8"), Some(("i32", "f64 vs u8")));
+        assert_eq!(sides("mismatch: i32"), None);
+        assert_eq!(sides("no colon"), None);
+        assert_eq!(fused("a,b,,c", 3, ","), (3, None, None));
+        assert_eq!(fused("a,b", 0, ","), (0, None, None));
+        assert_eq!(fused("a,b", 5, ","), (2, None, None));
+    }
+}
