+/-- `SplitInternal::get_end` of a split built by `str::split` (`allow_trailing_empty` holds): unless
+    finished, the rest `start..end` (even when empty), finishing; `None` once finished. -/
+def core.str.iter.Split.getEnd {P : Type} (self : core.str.iter.Split P) :
+    Option Str × core.str.iter.Split P :=
+  if self.finished then (none, self)
+  else
+    (some (core.str.iter.Split.piece self.haystack self.start self.haystack.val.length),
+      { self with finished := true })
+
+/-- `core::str::SplitN<'a, P>(SplitNInternal<'a, P>)` (core/src/str/iter.rs, rustc 1.95):
+    `SplitNInternal { iter: SplitInternal<'a, P>, count }`, the split and the number of pieces
+    left. -/
+@[rust_type "core::str::iter::SplitN" (body := .opaque)]
+structure core.str.iter.SplitN (P : Type) where
+  iter : core.str.iter.Split P
+  count : Nat
+
+/-- `str::splitn` (core/src/str/mod.rs): `SplitN(SplitNInternal { iter: self.split(pat).0,
+    count: n })`. -/
+@[rust_fun "core::str::{str}::splitn"]
+def core.str.Str.splitn {P : Type} (patInst : core.str.pattern.Pattern P)
+    (s : Str) (n : Usize) (pat : P) : Result (core.str.iter.SplitN P) := do
+  let iter ← core.str.Str.split patInst s pat
+  .ok { iter, count := n.val }
+
+/-- `SplitN::next` = `SplitNInternal::next`: `None` once `count` is 0; at 1 the rest of the split
+    (`get_end`), `count` becoming 0; above, `count - 1` and the split's next piece. -/
+@[rust_fun
+  "core::str::iter::{core::iter::traits::iterator::Iterator<core::str::iter::SplitN<'a, @P>, &'a str>}::next"]
+def core.str.iter.IteratorSplitN.next {P : Type} (patInst : core.str.pattern.Pattern P)
+    (self : core.str.iter.SplitN P) : Result (Option Str × core.str.iter.SplitN P) :=
+  match self.count with
+  | 0 => .ok (none, self)
+  | 1 =>
+    let (piece, iter) := self.iter.getEnd
+    .ok (piece, { iter, count := 0 })
+  | count + 1 => do
+    let (piece, iter) ← core.str.iter.IteratorSplit.next patInst self.iter
+    .ok (piece, { iter, count })
+
+/-- The `Iterator` impl of `SplitN` (`generate_pattern_iterators!`) defines only `next`: `size_hint`
+    is the default `(0, None)`. `impl<'a, P: Pattern> FusedIterator for SplitN<'a, P>`. -/
+@[reducible, rust_trait_impl
+  "core::iter::traits::iterator::Iterator<core::str::iter::SplitN<'a, @P>, &'a str>"]
+def core.iter.traits.iterator.IteratorSplitN {P : Type} (patInst : core.str.pattern.Pattern P) :
+  core.iter.traits.iterator.Iterator (core.str.iter.SplitN P) Str := {
+  next := core.str.iter.IteratorSplitN.next patInst
+  fused := true
+}
