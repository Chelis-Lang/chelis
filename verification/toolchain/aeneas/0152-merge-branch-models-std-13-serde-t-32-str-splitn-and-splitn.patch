+/-- `impl LowerExp for f32/f64` (core/src/fmt/float.rs `float_to_exponential_common`, rustc 1.95):
+    the sign as `Display`'s (`flt2dec::determine_sign`); NaN and the infinities as `Display`'s;
+    without a precision, zero is `0e0` and any other value its shortest round-trip digits in
+    exponential form (`to_shortest_exp_str` with the bounds `(0, 0)`); with a precision `p`, zero is
+    `0e0`, or `0.`, `p` zeros and `e0`, and any other value is rounded half to even to `p + 1`
+    significant digits (`to_exact_exp_str`: a carry keeps `p + 1` digits and raises the exponent).
+    `p + 1` is a `u16` sum: the precision 65535 wraps it to 0, which `to_exact_exp_str` asserts
+    against. -/
+def lowerExpFormat {f} (x : BinaryFloat f) (fmt : Formatter) : Outcome := do
+  let sign := if x.isNaN then "" else if x.sign then "-" else if fmt.options.bit 21 then "+" else ""
+  if x.isNaN then return ← fmt.padFloat sign [.copy "NaN"]
+  if x.isInfinite then return ← fmt.padFloat sign [.copy "inf"]
+  let (n, d) := x.ratio
+  let parts ← if fmt.options.bit 28 then do
+      let ndigits := fmt.options.precision + 1
+      if ndigits == 65536 then .fail .panic
+      else if x.isZero then
+        .ok (if ndigits > 1 then [.copy "0.", .zero (ndigits - 1), .copy "e0"] else [.copy "0e0"])
+      else
+        let scale := decimalExponent n d + 1 - (ndigits : Int)
+        let c := roundDecimal n d scale
+        let (c, scale) := if (digits c).length > ndigits then (c / 10, scale + 1) else (c, scale)
+        .ok (scientificDecimalParts c scale ndigits)
+    else if x.isZero then .ok [.copy "0e0"]
+    else do
+      let (c, e) ← shortestDecimal x n d (decimalExponent n d) 17 1
+      let (c, e) := trimDecimal 17 c e
+      .ok (scientificDecimalParts c e)
+  fmt.padFloat sign parts
+
+@[rust_fun "core::fmt::float::{core::fmt::LowerExp<f64>}::fmt"]
+def LowerExpF64.fmt (x : F64) (fmt : Formatter) : Outcome := lowerExpFormat x fmt
+@[reducible, rust_trait_impl "core::fmt::LowerExp<f64>"]
+def LowerExpF64 : LowerExp F64 := ⟨LowerExpF64.fmt⟩
+
