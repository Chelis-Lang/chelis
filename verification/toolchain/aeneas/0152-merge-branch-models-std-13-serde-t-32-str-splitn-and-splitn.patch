+/-- `Iterator::rposition` (core/src/iter/traits/iterator.rs, rustc 1.95), the default of the
+    iterators which do not override it: `let n = self.len(); self.try_rfold(n, check(predicate))
+    .break_value()`, where `check(predicate)` is `move |i, x| { let i = i - 1; if predicate(x)
+    { Break(i) } else { Continue(i) } }` (core is built without overflow checks: `i - 1` wraps).
+    The item types of the `ExactSizeIterator` and `DoubleEndedIterator` clauses are `Self::Item`
+    (kept once: `keepParams`). The result holds the final state of the iterator and of the
+    predicate (the canonical state ABI of the iterator consumers, `ModelStateInputs`). -/
+@[rust_fun "core::iter::traits::iterator::Iterator::rposition"
+  (keepParams := [true, true, true, false, false])]
+def core.iter.traits.iterator.Iterator.rposition.default {Self P Item : Type}
+    (_iterInst : core.iter.traits.iterator.Iterator Self Item)
+    (fnInst : core.ops.function.FnMut P Item Bool)
+    (exactInst : core.iter.traits.exact_size.ExactSizeIterator Self Item)
+    (doubleInst : core.iter.traits.double_ended.DoubleEndedIterator Self Item)
+    (self : Self) (predicate : P) : Result (Option Usize × Self × P) := do
+  let n ← exactInst.len self
+  let call : P → (Usize × Item) →
+      Result (core.ops.control_flow.ControlFlow Usize Usize × P) :=
+    fun predicate x => do
+      let i : Usize := ⟨x.1.bv - BitVec.ofNat _ 1⟩
+      let (found, predicate) ← fnInst.call_mut predicate x.2
+      return (if found then .Break i else .Continue i, predicate)
+  let wrapped : core.ops.function.FnMut P (Usize × Item)
+      (core.ops.control_flow.ControlFlow Usize Usize) := {
+    FnOnceInst := { call_once := call }
+    call_mut := call
+  }
+  let (r, self, predicate) ← doubleInst.try_rfold wrapped
+    (core.iter.traits.iterator.controlFlowTry Usize Usize) self n predicate
+  return (match r with | .Break i => some i | .Continue _ => none, self, predicate)
+
