diff --git a/tests/src/fmt-lower-exp.rs b/tests/src/fmt-lower-exp.rs
new file mode 100644
index 0000000..1876c5f
--- /dev/null
+++ b/tests/src/fmt-lower-exp.rs
@@ -0,0 +1,89 @@
+//@ [!lean] skip
+//@ [lean] subdir=FmtLowerExp
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! `{:e}` of an `f64` (`impl LowerExp for f64`, core/src/fmt/float.rs, rustc 1.95): the shortest
+//! round-trip digits in exponential form, or, with a precision, the value rounded half to even to
+//! that many fractional digits; the sign, NaN, the infinities, zero, width and sign-aware zero
+//! padding as `Display`'s. FmtLowerExp/Checks.lean compares the model with the native results
+//! asserted in the native test module.
+
+/// `format!("{:e}", x)`
+pub fn exp(x: f64) -> String {
+    format!("{:e}", x)
+}
+
+/// `format!("{:.3e}", x)`
+pub fn exp3(x: f64) -> String {
+    format!("{:.3e}", x)
+}
+
+/// `format!("{:.*e}", p, x)`
+pub fn exp_prec(x: f64, p: usize) -> String {
+    format!("{:.*e}", p, x)
+}
+
+/// `format!("{:+012.2e}|{:>10e}|{:<8.0e}|", x, x, x)`
+pub fn exp_padded(x: f64) -> String {
+    format!("{:+012.2e}|{:>10e}|{:<8.0e}|", x, x, x)
+}
+
+/// A message with an `{abs:e}` argument, as `observation.rs` writes its panics.
+pub fn message(width: u32, abs: f64) -> String {
+    format!("no 17-digit decimal round-trips a finite {width} value ({abs:e})")
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn shortest() {
+        assert_eq!(exp(1.5e-7), "1.5e-7");
+        assert_eq!(exp(1e21), "1e21");
+        assert_eq!(exp(0.1), "1e-1");
+        assert_eq!(exp(123456.0), "1.23456e5");
+        assert_eq!(exp(-0.0), "-0e0");
+        assert_eq!(exp(0.0), "0e0");
+        assert_eq!(exp(f64::MAX), "1.7976931348623157e308");
+        assert_eq!(exp(f64::MIN_POSITIVE), "2.2250738585072014e-308");
+        assert_eq!(exp(5e-324), "5e-324");
+        assert_eq!(exp(-1.0), "-1e0");
+        assert_eq!(exp(f64::NAN), "NaN");
+        assert_eq!(exp(-f64::NAN), "NaN");
+        assert_eq!(exp(f64::INFINITY), "inf");
+        assert_eq!(exp(f64::NEG_INFINITY), "-inf");
+        assert_eq!(exp(9007199254740993.0), "9.007199254740992e15");
+    }
+
+    #[test]
+    fn precision() {
+        assert_eq!(exp3(1234.5), "1.234e3");
+        assert_eq!(exp3(1235.5), "1.236e3");
+        assert_eq!(exp3(9999.5), "1.000e4");
+        assert_eq!(exp3(0.0), "0.000e0");
+        assert_eq!(exp3(-0.0), "-0.000e0");
+        assert_eq!(exp3(f64::NAN), "NaN");
+        assert_eq!(exp3(0.1), "1.000e-1");
+        assert_eq!(exp_prec(2.5, 0), "2e0");
+        assert_eq!(exp_prec(3.5, 0), "4e0");
+        assert_eq!(exp_prec(9.96, 1), "1.0e1");
+        assert_eq!(exp_prec(0.1, 20), "1.00000000000000005551e-1");
+        assert_eq!(exp_prec(5e-324, 2), "4.94e-324");
+        assert_eq!(exp_prec(f64::MAX, 0), "2e308");
+        assert_eq!(exp_prec(1.0, 30), "1.000000000000000000000000000000e0");
+        assert_eq!(exp_prec(0.0, 0), "0e0");
+    }
+
+    #[test]
+    fn padded() {
+        assert_eq!(exp_padded(1234.5), "+000001.23e3|  1.2345e3|1e3     |");
+        assert_eq!(exp_padded(-0.0), "-000000.00e0|      -0e0|-0e0    |");
+        assert_eq!(exp_padded(f64::NAN), "000000000NaN|       NaN|NaN     |");
+        assert_eq!(exp_padded(f64::NEG_INFINITY), "-00000000inf|      -inf|-inf    |");
+        assert_eq!(
+            message(64, 1.5e-300),
+            "no 17-digit decimal round-trips a finite 64 value (1.5e-300)"
+        );
+    }
+}
