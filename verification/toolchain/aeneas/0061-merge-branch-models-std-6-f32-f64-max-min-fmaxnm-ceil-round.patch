+/-- The integer value of a discriminant, and its two's-complement encoding (which the
+    `{:x?}` debug flags print). -/
+class core.mem.DiscriminantValue (β : Type) where
+  value : β → Int
+  bits : β → Nat
+
+instance {ty} : core.mem.DiscriminantValue (IScalar ty) := ⟨(·.val), (·.bv.toNat)⟩
+instance {ty} : core.mem.DiscriminantValue (UScalar ty) := ⟨fun x => (x.val : Int), (·.bv.toNat)⟩
+
+/-- `core::mem::Discriminant<T>` (core/src/mem/mod.rs): a wrapper of
+    `<T as DiscriminantKind>::Discriminant`, here that integer's value and encoding. -/
+@[rust_type "core::mem::Discriminant"]
+structure core.mem.Discriminant (T : Type) where
+  value : Int
+  bits : Nat
+  deriving DecidableEq
+
+/-- `core::mem::discriminant(v)`: the discriminant that `v`'s enum declares for its variant,
+    read through the `@[discriminant]` instance that Aeneas generates for every enum. Rust
+    also defines it (as `0`) on non-enum types; those have no `Discriminant` instance, so such
+    a call fails to elaborate rather than being modeled. -/
+@[rust_fun "core::mem::discriminant"]
+def core.mem.discriminant {T β : Type} [_root_.Aeneas.Std.Discriminant T β] [core.mem.DiscriminantValue β]
+    (v : T) : Result (core.mem.Discriminant T) :=
+  let d := read_discriminant v
+  .ok ⟨core.mem.DiscriminantValue.value d, core.mem.DiscriminantValue.bits d⟩
+
+/-- `PartialEq for Discriminant<T>`: `self.0 == rhs.0`. -/
+@[rust_fun "core::mem::{core::cmp::PartialEq<core::mem::Discriminant<@T>, core::mem::Discriminant<@T>>}::eq"]
+def core.mem.PartialEqDiscriminant.eq {T : Type} (x y : core.mem.Discriminant T) : Result Bool :=
+  .ok (x.value == y.value)
+
+@[reducible, rust_trait_impl "core::cmp::PartialEq<core::mem::Discriminant<@T>, core::mem::Discriminant<@T>>"]
+def core.mem.PartialEqDiscriminant (T : Type) :
+  core.cmp.PartialEq (core.mem.Discriminant T) (core.mem.Discriminant T) := {
+  eq := core.mem.PartialEqDiscriminant.eq
+}
+
+/-- `Debug for Discriminant<T>`: `fmt.debug_tuple("Discriminant").field(&self.0).finish()`,
+    the field an integer (integer `Debug`, honouring the hex-debug flags). -/
+@[rust_fun "core::mem::{core::fmt::Debug<core::mem::Discriminant<@T>>}::fmt"]
+def core.mem.DebugDiscriminant.fmt {T : Type} (x : core.mem.Discriminant T)
+    (fmt : core.fmt.Formatter) : core.fmt.Outcome :=
+  fmt.debugTuple "Discriminant"
+    [⟨Unit, ⟨fun _ f => core.fmt.debugInteger f x.value x.bits⟩, ()⟩]
+
+@[reducible, rust_trait_impl "core::fmt::Debug<core::mem::Discriminant<@T>>"]
+def core.mem.DebugDiscriminant (T : Type) : core.fmt.Debug (core.mem.Discriminant T) := {
+  fmt := core.mem.DebugDiscriminant.fmt
+}
+
