+/-- Round toward positive infinity; the result keeps the sign of `x` (so
+    `ceil (-0.5) = -0.0`). IEEE `roundToIntegralTowardPositive`, exact. -/
+def ceil {f} (x : BinaryFloat f) : BinaryFloat f :=
+  if x.isNaN then nan f
+  else if x.isInfinite then x
+  else
+    let (n, d) := x.ratio
+    round f x.sign (if x.sign then n / d else (n + d - 1) / d) 1
+
+/-- Round to the nearest integer, ties to even; the result keeps the sign of `x`
+    (`roundTiesEven (-0.5) = -0.0`). IEEE `roundToIntegralTiesToEven`, exact. -/
+def roundTiesEven {f} (x : BinaryFloat f) : BinaryFloat f :=
+  if x.isNaN then nan f
+  else if x.isInfinite then x
+  else let (n, d) := x.ratio; round f x.sign (roundQuotient n d) 1
+
+/-- IEEE `squareRoot`, correctly rounded: `√-0 = -0`, `√+∞ = +∞`, and a NaN for
+    every other negative operand. For a positive finite `n / 2^k` (`k` made even)
+    the root is `√(n·4^t) / 2^(t + k/2)`. With `t = fractionBits + 3`, the integer
+    root `s = ⌊√(n·4^t)⌋` has at least `fractionBits + 4` bits, so every rounding
+    boundary is an integer multiple of the root's scale: when the root is not an
+    integer, it and `s + 1/2` lie strictly between the same two integers and round
+    identically (the usual sticky bit). -/
+def sqrt {f} (x : BinaryFloat f) : BinaryFloat f :=
+  if x.isNaN then nan f
+  else if x.isZero then x
+  else if x.sign then nan f
+  else if x.isInfinite then x
+  else
+    let (n, d) := x.ratio
+    let k := d.log2
+    let (n, k) := if k % 2 == 1 then (2 * n, k + 1) else (n, k)
+    let t := f.fractionBits + 3
+    let m := n * 4 ^ t
+    let s := m.sqrt
+    round f false (2 * s + (if s * s == m then 0 else 1)) (2 ^ (t + k / 2 + 1))
