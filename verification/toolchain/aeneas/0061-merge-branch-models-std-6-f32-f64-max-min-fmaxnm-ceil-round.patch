+/-- `f16::from_f64` on the Chelis build hosts (aarch64, where `fp16` is always
+    present): the crate dispatches to `FCVT Hd, Dd` (`binary16/arch/aarch64.rs`),
+    the IEEE conversion rounding to nearest, ties to even (default FPCR), which is
+    `BinaryFloat.cast`. A NaN keeps its sign, gets the quiet bit and keeps the top
+    9 bits of the rest of its payload (Arm `FPConvertNaN`; the crate's software
+    fallback agrees on NaNs). This is a platform assumption
+    (verification/trusted_base.json "platform_assumptions"): the crate's software
+    `f64_to_f16_fallback` (hosts without `fp16`/`f16c`) first truncates the low
+    32 bits of the `f64`, and x86 `f16c` converts through `f32`; both round twice
+    and differ from this model on some inputs. -/
+@[rust_fun "half::binary16::{half::binary16::f16}::from_f64"]
+def from_f64 (x : F64) : Result F16 :=
+  .ok (if x.isNaN then
+        BinaryFloat.ofNat _ ((if x.sign then 0x8000 else 0) + 0x7E00 + (x.fraction >>> 42) % 2 ^ 9)
+      else BinaryFloat.cast .binary16 x)
+
+/-- Off NaNs, `from_f64` is the single correctly rounded conversion `cast`. -/
+theorem from_f64_of_not_nan (x : F64) (h : x.isNaN = false) :
+    from_f64 x = .ok (BinaryFloat.cast .binary16 x) := by
+  simp [from_f64, h]
+
