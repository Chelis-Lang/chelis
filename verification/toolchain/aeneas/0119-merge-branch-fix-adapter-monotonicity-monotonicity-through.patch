+/-- In the flat order of `Result`, a pointwise property of a two-argument function which
+    holds at `div` is admissible (a chain has at most one value besides `div`). -/
+theorem admissible_result_apply₂ {A : Sort u} {B : Sort v} {γ : Type w}
+    (P : A → B → Result γ → Prop) (hdiv : ∀ a b, P a b .div) :
+    admissible (fun (f : A → B → Result γ) => ∀ a b, P a b (f a b)) :=
+  admissible_pi_apply (fun a (g : B → Result γ) => ∀ b, P a b (g b)) fun a =>
+    admissible_pi_apply (fun b (v : Result γ) => P a b v) fun b =>
+      admissible_flatOrder (P a b) (hdiv a b)
+
+/-- In the flat order of `Result`, a pointwise property of a three-argument function which
+    holds at `div` is admissible. -/
+theorem admissible_result_apply₃ {A : Sort u} {B : Sort v} {C : Sort w} {γ : Type w'}
+    (P : A → B → C → Result γ → Prop) (hdiv : ∀ a b c, P a b c .div) :
+    admissible (fun (f : A → B → C → Result γ) => ∀ a b c, P a b c (f a b c)) :=
+  admissible_pi_apply (fun a (g : B → C → Result γ) => ∀ b c, P a b c (g b c)) fun a =>
+    admissible_result_apply₂ (P a) (hdiv a)
+
