+/-- Step of `aeneas_monotonicity` for a goal `monotone (fun g => P a₁ … aₙ)` where `P` is
+    defined by `partial_fixpoint` (e.g. the model `iterToList` of `collect`, a fold, or a
+    specialized visitor's loops) and some of its fixed parameters depend on `g`: a trait
+    instance, typically a closure's, built from the function being defined. `P` unfolds to
+    a least fixpoint `fix (F a)`, which is monotone in `a` if `F` is monotone in `a` and in
+    its recursive function together (`fix_monotone_param`); that joint monotonicity is the
+    new goal. The arguments of the fixpoint itself must not depend on `g`. -/
+elab "aeneas_fix_monotone" : tactic => do
+  let goal ← getMainGoal
+  let newGoal ← goal.withContext do
+    let type ← instantiateMVars (← goal.getType)
+    let_expr Lean.Order.monotone γ instγ _ _ f := type
+      | throwError "aeneas_fix_monotone: not a monotonicity goal"
+    let f := f.headBeta
+    unless f.isLambda do throwError "aeneas_fix_monotone: not a lambda"
+    withLocalDeclD f.bindingName! γ fun g => do
+      let e ← unfoldToFix (f.bindingBody!.instantiate1 g)
+      let (_, layers) := strip e
+      let (args, rest) := layers.splitAt 4
+      let args := args.filterMap fun | .app a => some a | .proj .. => none
+      let [α, instα, F, hF] := args
+        | throwError "aeneas_fix_monotone: unexpected fixpoint{indentExpr e}"
+      if α.containsFVar g.fvarId! || instα.containsFVar g.fvarId! then
+        throwError "aeneas_fix_monotone: the fixpoint's type depends on the variable"
+      unless F.containsFVar g.fvarId! do
+        throwError "aeneas_fix_monotone: the fixpoint does not depend on the variable"
+      let lem ← mkAppOptM ``Aeneas.Std.fix_monotone_param
+        #[γ, α, instγ, instα, ← mkLambdaFVars #[g] F, ← mkLambdaFVars #[g] hF]
+      let .forallE _ jointTy _ _ ← whnfR (← inferType lem)
+        | throwError "aeneas_fix_monotone: unexpected lemma type"
+      let jointTy := projOfPProdFn (← Core.betaReduce (← instantiateMVars jointTy))
+      let joint ← mkFreshExprSyntheticOpaqueMVar jointTy
+      let mut prf := mkApp lem joint
+      for l in rest do
+        if let .app a := l then
+          if a.containsFVar g.fvarId! then
+            throwError "aeneas_fix_monotone: an argument of the fixpoint depends on the variable"
+        prf ← monotoneLayer γ instγ prf l
+      -- `P` is irreducible: the elaborator unfolds it only at transparency `all`
+      unless ← withTransparency .all <| isDefEq (← inferType prf) type do
+        throwError "aeneas_fix_monotone: the unfolded fixpoint does not match the goal"
+      goal.assign prf
+      pure joint.mvarId!
+  replaceMainGoal [newGoal]
