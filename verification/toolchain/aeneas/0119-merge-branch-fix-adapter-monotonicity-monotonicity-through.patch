+//@ [!lean] skip
+//@ [lean] subdir=StdEnumDiscriminants
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::result::{core::result::Result}
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! The discriminants of the standard enums the library models. `Result::is_ok` is
+//! translated from its body (`matches!(*self, Ok(_))`, a read of the discriminant),
+//! as in production, which includes the `core::result::{Result}` family;
+//! `core::mem::discriminant` reads the discriminant of any enum.
+//! `StdEnumDiscriminants/Checks.lean` evaluates the model on the inputs of the
+//! `native` test module below and compares with the native results.
+
+use std::borrow::Cow;
+use std::mem::discriminant;
+use std::ops::{Bound, ControlFlow};
+
+/// `Result::is_ok`/`is_err` translated from their bodies
+pub fn result_flags(n: u32) -> (bool, bool) {
+    let r: Result<u32, u32> = if n % 2 == 0 { Ok(n) } else { Err(n) };
+    (r.is_ok(), r.is_err())
+}
+
+pub fn option_discriminants(n: u32) -> String {
+    let some: Option<u32> = Some(n);
+    let none: Option<u32> = None;
+    format!("{:?} {:?} {}", discriminant(&none), discriminant(&some), discriminant(&some) == discriminant(&Some(n + 1)))
+}
+
+pub fn result_discriminants(n: u32) -> String {
+    let ok: Result<u32, bool> = Ok(n);
+    let err: Result<u32, bool> = Err(false);
+    format!("{:?} {:?} {}", discriminant(&ok), discriminant(&err), discriminant(&ok) == discriminant(&err))
+}
+
+pub fn control_flow_discriminants(n: u32) -> String {
+    let cont: ControlFlow<u32, u32> = ControlFlow::Continue(n);
+    let brk: ControlFlow<u32, u32> = ControlFlow::Break(n);
+    format!("{:?} {:?}", discriminant(&cont), discriminant(&brk))
+}
+
+pub fn bound_discriminants(n: u32) -> String {
+    let a: Bound<u32> = Bound::Included(n);
+    let b: Bound<u32> = Bound::Excluded(n);
+    let c: Bound<u32> = Bound::Unbounded;
+    format!("{:?} {:?} {:?}", discriminant(&a), discriminant(&b), discriminant(&c))
+}
+
+pub fn cow_discriminants(s: &str) -> String {
+    let b: Cow<'_, str> = Cow::Borrowed(s);
+    let o: Cow<'_, str> = Cow::Owned(s.to_string());
+    format!("{:?} {:?}", discriminant(&b), discriminant(&o))
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn discriminants() {
+        assert_eq!(result_flags(4), (true, false));
+        assert_eq!(result_flags(7), (false, true));
+        assert_eq!(option_discriminants(3), "Discriminant(0) Discriminant(1) true");
+        assert_eq!(result_discriminants(3), "Discriminant(0) Discriminant(1) false");
+        assert_eq!(control_flow_discriminants(3), "Discriminant(0) Discriminant(1)");
+        assert_eq!(bound_discriminants(3), "Discriminant(0) Discriminant(1) Discriminant(2)");
+        assert_eq!(cow_discriminants("x"), "Discriminant(0) Discriminant(1)");
+    }
+}
