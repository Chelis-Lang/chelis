+/-- A least fixpoint is monotone in a parameter of its functional, if the functional is
+    monotone in the parameter and the recursive function together (fixpoint induction). -/
+theorem fix_monotone_param {γ : Sort u} {α : Sort v} [PartialOrder γ] [CCPO α]
+    (F : γ → α → α) (hF : ∀ g, monotone (F g))
+    (hjoint : monotone (fun (p : γ ×' α) => F p.1 p.2)) :
+    monotone (fun g => fix (F g) (hF g)) := by
+  intro g₁ g₂ h
+  refine fix_induct (hF g₁) (fun x => x ⊑ fix (F g₂) (hF g₂)) ?_ ?_
+  · intro c hc hx
+    exact csup_le hc hx
+  · intro x hx
+    have hstep := hjoint ⟨g₁, x⟩ ⟨g₂, fix (F g₂) (hF g₂)⟩ ⟨h, hx⟩
+    rw [fix_eq (hF g₂)]
+    exact hstep
+
+end Aeneas.Std
