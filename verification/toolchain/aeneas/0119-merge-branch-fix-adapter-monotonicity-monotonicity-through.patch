+//@ [!lean] skip
+//@ [lean] subdir=RecursiveAdapterClosures
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::iter::adapters::map::Map --include core::option::{core::ops::try_trait::Try} --include core::option::{core::ops::try_trait::FromResidual}
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Recursion through iterator adapters: the closure of `map` calls the function
+//! being defined, either as the function item itself (`map(Tree::to_wire)`) or
+//! inside a closure (`map(|c| c.to_wire())`), consumed by `collect` into a
+//! `Vec` or an `Option<Vec<_>>`, or by `sum`; and recursion through a visitor
+//! which takes the closure by `&mut` (monomorphized per closure). The Lean
+//! definitions are `partial_fixpoint`s, whose monotonicity goes through the
+//! models of the adapters, of their consumers (themselves fixpoints, taking the
+//! closure's instance as a parameter) and of the monomorphized visitor.
+//! `RecursiveAdapterClosures/Checks.lean` evaluates the model on the inputs of
+//! the `native` test module below and compares with the native results.
+
+pub enum Tree {
+    Leaf(u32),
+    Node(Vec<Tree>),
+    Named(Vec<(u32, Tree)>),
+}
+
+pub enum Wire {
+    Leaf(u32),
+    List(Vec<Wire>),
+    Map(Vec<(u32, Wire)>),
+}
+
+impl Tree {
+    /// `map` with the function item and with a closure, collected into a `Vec`
+    /// (`WireExpr::from_raw_data`)
+    pub fn to_wire(&self) -> Wire {
+        match self {
+            Tree::Leaf(n) => Wire::Leaf(*n),
+            Tree::Node(v) => Wire::List(v.iter().map(Tree::to_wire).collect()),
+            Tree::Named(v) => Wire::Map(v.iter().map(|(k, t)| (*k, t.to_wire())).collect()),
+        }
+    }
+
+    /// The closure taken by `&mut`: monomorphized per closure type, and itself
+    /// recursive (`Metadata::visit_expressions`): below a `Named`, the children's
+    /// children are visited too
+    pub fn visit_children<F: FnMut(&Tree)>(&self, f: &mut F) {
+        match self {
+            Tree::Leaf(_) => {}
+            Tree::Node(v) => {
+                for c in v.iter() {
+                    f(c)
+                }
+            }
+            Tree::Named(v) => {
+                for (_, c) in v.iter() {
+                    f(c);
+                    c.visit_children(f)
+                }
+            }
+        }
+    }
+}
+
+impl Wire {
+    /// Recursive through plain loops
+    pub fn digest(&self) -> u64 {
+        match self {
+            Wire::Leaf(n) => *n as u64 + 1,
+            Wire::List(v) => {
+                let mut h: u64 = 3;
+                for w in v.iter() {
+                    h = h.wrapping_mul(31).wrapping_add(w.digest());
+                }
+                h
+            }
+            Wire::Map(v) => {
+                let mut h: u64 = 5;
+                for (k, w) in v.iter() {
+                    h = h
+                        .wrapping_mul(37)
+                        .wrapping_add(*k as u64)
+                        .wrapping_mul(7)
+                        .wrapping_add(w.digest());
+                }
+                h
+            }
+        }
+    }
+}
+
+/// `map` with the function item and with a closure, consumed by `sum`
+/// (`deep_expr_nodes`)
+pub fn size(t: &Tree) -> usize {
+    1 + match t {
+        Tree::Leaf(_) => 0,
+        Tree::Node(v) => v.iter().map(size).sum(),
+        Tree::Named(v) => v.iter().map(|(_, c)| size(c)).sum::<usize>(),
+    }
+}
+
+fn own_weight(t: &Tree) -> usize {
+    match t {
+        Tree::Leaf(n) => *n as usize,
+        _ => 1,
+    }
+}
+
+/// Through the visitor, with a closure capturing mutable borrows
+/// (`deep_metadata_nodes`)
+pub fn weight(t: &Tree) -> usize {
+    let mut total = own_weight(t);
+    let mut visits = 0;
+    t.visit_children(&mut |c| {
+        total += weight(c);
+        visits += 1
+    });
+    total * 10 + visits
+}
+
+/// A closure consumed by `collect` into an `Option<Vec<_>>`
+/// (`extract_cons_chain_tensor`)
+pub fn positive_leaves(t: &Tree) -> Option<usize> {
+    match t {
+        Tree::Leaf(0) => None,
+        Tree::Leaf(_) => Some(1),
+        Tree::Node(v) => {
+            let counts = v
+                .iter()
+                .map(|c| positive_leaves(c))
+                .collect::<Option<Vec<usize>>>()?;
+            Some(counts.iter().sum::<usize>())
+        }
+        Tree::Named(v) => {
+            let counts = v
+                .iter()
+                .map(|(_, c)| positive_leaves(c))
+                .collect::<Option<Vec<usize>>>()?;
+            Some(counts.len() + counts.iter().sum::<usize>())
+        }
+    }
+}
+
+pub struct Scale {
+    pub factor: u64,
+}
+
+impl Scale {
+    /// A closure capturing `&self` (`Printer::fmt_list_flat`)
+    pub fn score(&self, t: &Tree) -> u64 {
+        match t {
+            Tree::Leaf(n) => *n as u64 * self.factor,
+            Tree::Node(v) => {
+                let parts: Vec<u64> = v.iter().map(|c| self.score(c)).collect();
+                let mut s: u64 = 1;
+                for p in parts.iter() {
+                    s = s.wrapping_mul(10).wrapping_add(*p);
+                }
+                s
+            }
+            Tree::Named(v) => {
+                let parts: Vec<u64> = v.iter().map(|(k, c)| *k as u64 + self.score(c)).collect();
+                let mut s: u64 = 2;
+                for p in parts.iter() {
+                    s = s.wrapping_mul(100).wrapping_add(*p);
+                }
+                s
+            }
+        }
+    }
+}
+
+pub fn sample(a: u32, b: u32) -> Tree {
+    Tree::Node(vec![
+        Tree::Leaf(a),
+        Tree::Named(vec![
+            (7, Tree::Leaf(b)),
+            (9, Tree::Node(vec![Tree::Leaf(a + b), Tree::Node(vec![])])),
+        ]),
+        Tree::Node(vec![Tree::Named(vec![(1, Tree::Leaf(3))]), Tree::Leaf(b)]),
+    ])
+}
+
+pub fn wire_digest(a: u32, b: u32) -> u64 {
+    sample(a, b).to_wire().digest()
+}
+
+pub fn sample_size(a: u32, b: u32) -> usize {
+    size(&sample(a, b))
+}
+
+pub fn sample_weight(a: u32, b: u32) -> usize {
+    weight(&sample(a, b))
+}
+
+pub fn sample_positive(a: u32, b: u32) -> Option<usize> {
+    positive_leaves(&sample(a, b))
+}
+
+pub fn sample_score(a: u32, b: u32, factor: u64) -> u64 {
+    Scale { factor }.score(&sample(a, b))
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn results() {
+        assert_eq!(wire_digest(2, 5), 11073888);
+        assert_eq!(wire_digest(0, 1), 11034080);
+        assert_eq!(sample_size(2, 5), 11);
+        assert_eq!(sample_weight(2, 5), 130773);
+        assert_eq!(sample_weight(0, 1), 56573);
+        assert_eq!(sample_positive(2, 5), Some(8));
+        assert_eq!(sample_positive(0, 5), None);
+        assert_eq!(sample_score(2, 5, 3), 229015);
+        assert_eq!(sample_score(1, 1, 7), 220527);
+    }
+}
