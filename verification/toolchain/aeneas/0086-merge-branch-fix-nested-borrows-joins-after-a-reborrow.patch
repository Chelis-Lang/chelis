+
+/-! Evaluate the model of `tests/src/nested-borrows-reborrow-join.rs` on the
+    inputs of its `native` test module and compare with the native results
+    `(result, ctx, pos)`: `pos` is the frame given back through the `&mut`
+    (the forward output), `ctx` the value of the frame's region given back by
+    the backward function of that region when the caller gives the frame
+    back. -/
+
+namespace nested_borrows_reborrow_join.checks
+open Aeneas Aeneas.Std Result
+
+def u (x : Nat) : U32 := ⟨BitVec.ofNat _ x⟩
+def us (x : Nat) : Usize := ⟨BitVec.ofNat _ x⟩
+
+def max := 4294967295
+
+def sl (xs : List Nat) (h : xs.length ≤ Usize.max := by scalar_tac) : Slice U32 :=
+  ⟨xs.map u, by simpa using h⟩
+
+def frame (ctx pos : Nat) : Frame := { steps := sl [3, 5, 7], ctx := u ctx, pos := us pos }
+
+/-- `run(Some(&mut frame), 100)`; the caller gives the frame back -/
+def onSome (run : Option Frame → U32 → Result (U32 × Option Frame × (Option Frame → Option Frame)))
+    (ctx pos : Nat) : Option (Nat × Nat × Nat) :=
+  match run (some (frame ctx pos)) (u 100) with
+  | ok (r, some f1, back) =>
+    match back (some f1) with
+    | some f2 => some (r.val, f2.ctx.val, f1.pos.val)
+    | none => none
+  | _ => none
+
+/-- `run(&mut frame, 100)`; the caller gives the frame back -/
+def onFrame (run : Frame → U32 → Result (U32 × Frame × (Frame → Frame)))
+    (ctx pos : Nat) : Option (Nat × Nat × Nat) :=
+  match run (frame ctx pos) (u 100) with
+  | ok (r, f1, back) => some (r.val, (back f1).ctx.val, f1.pos.val)
+  | _ => none
+
+/-- `run(None, 100)`: the result, and whether `None` is given back -/
+def onNone (run : Option Frame → U32 → Result (U32 × Option Frame × (Option Frame → Option Frame))) :
+    Option (Nat × Bool) :=
+  match run none (u 100) with
+  | ok (r, o, back) => some (r.val, o.isNone && (back none).isNone)
+  | _ => none
+
+-- advance_is_some_native
+#guard onSome advance_is_some 10 0 == some (4, 13, 1)
+#guard onSome advance_is_some (max - 4) 1 == some (6, 0, 2)
+#guard onNone advance_is_some == some (100, true)
+#guard onFrame run_advance_is_some 10 2 == some (8, 17, 3)
+
+-- advance_is_some_then_native
+#guard onSome advance_is_some_then 10 0 == some (9, 18, 2)
+#guard onSome advance_is_some_then (max - 4) 1 == some (13, 7, 3)
+#guard onNone advance_is_some_then == some (100, true)
+#guard onFrame run_advance_is_some_then 10 1 == some (13, 22, 3)
+
+end nested_borrows_reborrow_join.checks
