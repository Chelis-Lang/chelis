diff --git a/tests/src/nested-borrows-as-deref-mut-arms.rs b/tests/src/nested-borrows-as-deref-mut-arms.rs
new file mode 100644
index 0000000..29786f0
--- /dev/null
+++ b/tests/src/nested-borrows-as-deref-mut-arms.rs
@@ -0,0 +1,104 @@
+//@ [!lean] skip
+//@ [lean] subdir=NestedBorrowsAsDerefMutArms
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::option::{core::option::Option} --include core::ops::deref::{core::ops::deref::Deref} --include core::ops::deref::{core::ops::deref::DerefMut}
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! `match execution.as_deref_mut() { Some(frame) => .., None => .. }` on
+//! `Option<&'1 mut Frame<'2>>`, returning a value that holds no borrow, in
+//! the tail position of the function. The returned reference is expanded:
+//! the inner borrow of its frame (`ctx`) is a borrow that no function call
+//! consumed, given back to the abstraction of the region of the frame of
+//! `as_deref_mut` inside the frame given back to the reborrow. The default
+//! value of the value given back to it (for the variants of the value given
+//! back by the backward function which do not reach it) is the value the
+//! abstraction received for it.
+
+pub struct Frame<'a> {
+    pub count: u64,
+    pub ctx: &'a mut u64,
+}
+
+/// Reads the frame through the reborrow.
+pub fn plain_read(mut execution: Option<&mut Frame<'_>>) -> u64 {
+    match execution.as_deref_mut() {
+        Some(frame) => frame.count,
+        None => 0,
+    }
+}
+
+/// Writes a field of the frame which is not a borrow.
+pub fn plain_write(mut execution: Option<&mut Frame<'_>>) -> u64 {
+    match execution.as_deref_mut() {
+        Some(frame) => {
+            frame.count = 3;
+            1
+        }
+        None => 0,
+    }
+}
+
+/// Writes through the inner borrow of the frame.
+pub fn ctx_write(mut execution: Option<&mut Frame<'_>>) -> u64 {
+    match execution.as_deref_mut() {
+        Some(frame) => {
+            *frame.ctx = 7;
+            1
+        }
+        None => 0,
+    }
+}
+
+pub fn run_plain_read(f: &mut Frame<'_>) -> u64 {
+    plain_read(Some(f))
+}
+
+pub fn run_plain_write(f: &mut Frame<'_>) -> u64 {
+    plain_write(Some(f))
+}
+
+pub fn run_ctx_write(f: &mut Frame<'_>) -> u64 {
+    ctx_write(Some(f))
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    /// `run(Some(&mut frame))`: the result, the frame's `ctx` and `count`
+    fn on_some(run: fn(Option<&mut Frame<'_>>) -> u64, count: u64, ctx: u64) -> (u64, u64, u64) {
+        let mut c = ctx;
+        let mut f = Frame { count, ctx: &mut c };
+        let r = run(Some(&mut f));
+        let count = f.count;
+        (r, c, count)
+    }
+
+    /// `run(&mut frame)`
+    fn on_frame(run: fn(&mut Frame<'_>) -> u64, count: u64, ctx: u64) -> (u64, u64, u64) {
+        let mut c = ctx;
+        let mut f = Frame { count, ctx: &mut c };
+        let r = run(&mut f);
+        let count = f.count;
+        (r, c, count)
+    }
+
+    #[test]
+    fn plain_read_native() {
+        assert_eq!(on_some(plain_read, 5, 10), (5, 10, 5));
+        assert_eq!(plain_read(None), 0);
+        assert_eq!(on_frame(run_plain_read, 9, 1), (9, 1, 9));
+    }
+
+    #[test]
+    fn plain_write_native() {
+        assert_eq!(on_some(plain_write, 5, 10), (1, 10, 3));
+        assert_eq!(plain_write(None), 0);
+        assert_eq!(on_frame(run_plain_write, 9, 1), (1, 1, 3));
+    }
+
+    #[test]
+    fn ctx_write_native() {
+        assert_eq!(on_some(ctx_write, 5, 10), (1, 7, 5));
+        assert_eq!(ctx_write(None), 0);
+        assert_eq!(on_frame(run_ctx_write, 9, 1), (1, 7, 9));
+    }
+}
diff --git a/tests/src/nested-borrows-reborrow-join.rs b/tests/src/nested-borrows-reborrow-join.rs
new file mode 100644
index 0000000..fd0b412
--- /dev/null
+++ b/tests/src/nested-borrows-reborrow-join.rs
@@ -0,0 +1,101 @@
+//@ [!lean] skip
+//@ [lean] subdir=NestedBorrowsReborrowJoin
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::option::{core::option::Option} --include core::ops::deref::{core::ops::deref::Deref} --include core::ops::deref::{core::ops::deref::DerefMut}
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! `Option::as_deref_mut` on `Option<&'1 mut Frame<'2>>`, the reborrow given
+//! to a call, then the option read again in a condition (a join). When the
+//! region of the reborrow ends, the value it gives back holds borrows of the
+//! region of the frame: their loans are projected into the borrow projector of
+//! the callee's abstraction for that region, one level deeper than its borrows.
+//! - The continuation of that abstraction gives these loans as the leading
+//!   argument group of its backward function.
+//! - The frozen abstraction of `as_deref_mut` holds a loan projector with the
+//!   borrows projected from the same value.
+
+pub struct Frame<'a> {
+    pub steps: &'a [u32],
+    pub ctx: &'a mut u32,
+    pub pos: usize,
+}
+
+impl<'a> Frame<'a> {
+    pub fn advance(&mut self) -> u32 {
+        let s = self.steps[self.pos];
+        self.pos += 1;
+        *self.ctx = (*self.ctx).wrapping_add(s);
+        s
+    }
+}
+
+pub fn advance_or(execution: Option<&mut Frame<'_>>, d: u32) -> u32 {
+    match execution {
+        Some(f) => f.advance(),
+        None => d,
+    }
+}
+
+/// The option is read (`is_some`) after the reborrow was given to a call.
+pub fn advance_is_some(mut execution: Option<&mut Frame<'_>>, d: u32) -> u32 {
+    let a = advance_or(execution.as_deref_mut(), d);
+    let b = if execution.is_some() { 1 } else { 0 };
+    a.wrapping_add(b)
+}
+
+/// Same, then the frame is used again after the join.
+pub fn advance_is_some_then(mut execution: Option<&mut Frame<'_>>, d: u32) -> u32 {
+    let a = advance_or(execution.as_deref_mut(), d);
+    let b = if execution.is_some() { 1 } else { 0 };
+    match execution {
+        Some(f) => a.wrapping_add(f.advance()).wrapping_add(b),
+        None => a.wrapping_add(b),
+    }
+}
+
+pub fn run_advance_is_some(f: &mut Frame<'_>, d: u32) -> u32 {
+    advance_is_some(Some(f), d)
+}
+
+pub fn run_advance_is_some_then(f: &mut Frame<'_>, d: u32) -> u32 {
+    advance_is_some_then(Some(f), d)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    const STEPS: [u32; 3] = [3, 5, 7];
+
+    /// `run(Some(&mut frame))`: the result, the frame's `ctx` and `pos`
+    fn on_some(run: fn(Option<&mut Frame<'_>>, u32) -> u32, ctx: u32, pos: usize) -> (u32, u32, usize) {
+        let mut c = ctx;
+        let mut f = Frame { steps: &STEPS, ctx: &mut c, pos };
+        let r = run(Some(&mut f), 100);
+        let pos = f.pos;
+        (r, c, pos)
+    }
+
+    /// `run(&mut frame)`
+    fn on_frame(run: fn(&mut Frame<'_>, u32) -> u32, ctx: u32, pos: usize) -> (u32, u32, usize) {
+        let mut c = ctx;
+        let mut f = Frame { steps: &STEPS, ctx: &mut c, pos };
+        let r = run(&mut f, 100);
+        let pos = f.pos;
+        (r, c, pos)
+    }
+
+    #[test]
+    fn advance_is_some_native() {
+        assert_eq!(on_some(advance_is_some, 10, 0), (4, 13, 1));
+        assert_eq!(on_some(advance_is_some, u32::MAX - 4, 1), (6, 0, 2));
+        assert_eq!(advance_is_some(None, 100), 100);
+        assert_eq!(on_frame(run_advance_is_some, 10, 2), (8, 17, 3));
+    }
+
+    #[test]
+    fn advance_is_some_then_native() {
+        assert_eq!(on_some(advance_is_some_then, 10, 0), (9, 18, 2));
+        assert_eq!(on_some(advance_is_some_then, u32::MAX - 4, 1), (13, 7, 3));
+        assert_eq!(advance_is_some_then(None, 100), 100);
+        assert_eq!(on_frame(run_advance_is_some_then, 10, 1), (13, 22, 3));
+    }
+}
