@@ -0,0 +1,56 @@
+import NestedBorrowsAsDerefMutArms.NestedBorrowsAsDerefMutArms
+
+/-! Evaluate the model of `tests/src/nested-borrows-as-deref-mut-arms.rs` on
+    the inputs of its `native` test module and compare with the native results
+    `(result, ctx, count)`: `count` is read from the frame given back through
+    the `&mut` (the forward output), `ctx` from the value of the frame's region
+    given back by the backward function of that region when the caller gives
+    the frame back. -/
+
+namespace nested_borrows_as_deref_mut_arms.checks
+open Aeneas Aeneas.Std Result
+
+def u (x : Nat) : U64 := ⟨BitVec.ofNat _ x⟩
+
+def frame (count ctx : Nat) : Frame := { count := u count, ctx := u ctx }
+
+/-- `run(Some(&mut frame))`; the caller gives the frame back -/
+def onSome (run : Option Frame → Result (U64 × Option Frame × (Option Frame → Option Frame)))
+    (count ctx : Nat) : Option (Nat × Nat × Nat) :=
+  match run (some (frame count ctx)) with
+  | ok (r, some f1, back) =>
+    match back (some f1) with
+    | some f2 => some (r.val, f2.ctx.val, f1.count.val)
+    | none => none
+  | _ => none
+
+/-- `run(&mut frame)`; the caller gives the frame back -/
+def onFrame (run : Frame → Result (U64 × Frame × (Frame → Frame)))
+    (count ctx : Nat) : Option (Nat × Nat × Nat) :=
+  match run (frame count ctx) with
+  | ok (r, f1, back) => some (r.val, (back f1).ctx.val, f1.count.val)
+  | _ => none
+
+/-- `run(None)`: the result, and whether `None` is given back -/
+def onNone (run : Option Frame → Result (U64 × Option Frame × (Option Frame → Option Frame))) :
+    Option (Nat × Bool) :=
+  match run none with
+  | ok (r, o, back) => some (r.val, o.isNone && (back none).isNone)
+  | _ => none
+
+-- plain_read_native
+#guard onSome plain_read 5 10 == some (5, 10, 5)
+#guard onNone plain_read == some (0, true)
+#guard onFrame run_plain_read 9 1 == some (9, 1, 9)
+
+-- plain_write_native
+#guard onSome plain_write 5 10 == some (1, 10, 3)
+#guard onNone plain_write == some (0, true)
+#guard onFrame run_plain_write 9 1 == some (1, 1, 3)
+
+-- ctx_write_native
+#guard onSome ctx_write 5 10 == some (1, 7, 5)
+#guard onNone ctx_write == some (0, true)
+#guard onFrame run_ctx_write 9 1 == some (1, 7, 9)
+
+end nested_borrows_as_deref_mut_arms.checks
