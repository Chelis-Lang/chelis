# series aeneas: patch -p1 in the root of the upstream source
#
# stdlib: f32/f64 floor and From<f32> for f64
#
# floor rounds toward negative infinity keeping the sign of zero; the
# widening From impl is the exact F32.toF64 cast.

diff --git a/backends/lean/Aeneas/Std/Float.lean b/backends/lean/Aeneas/Std/Float.lean
index 601d89c..7033a24 100644
--- a/backends/lean/Aeneas/Std/Float.lean
+++ b/backends/lean/Aeneas/Std/Float.lean
@@ -1,5 +1,6 @@
 import Aeneas.Std.Scalar.Core
 import Aeneas.Std.Core.Cmp
+import Aeneas.Std.Core.Core
 
 namespace Aeneas.Std
 
@@ -193,6 +194,15 @@ def trunc {f} (x : BinaryFloat f) : BinaryFloat f :=
 
 def fract {f} (x : BinaryFloat f) : BinaryFloat f := sub x (trunc x)
 
+/-- Round toward negative infinity; the result keeps the sign of `x` (so
+    `floor (-0.0) = -0.0` and `floor (-0.5) = -1.0`). -/
+def floor {f} (x : BinaryFloat f) : BinaryFloat f :=
+  if x.isNaN then nan f
+  else if x.isInfinite then x
+  else
+    let (n, d) := x.ratio
+    round f x.sign (if x.sign then (n + d - 1) / d else n / d) 1
+
 /-- Binary exponentiation with an IEEE rounding at each multiplication. The
     accumulator follows compiler-rt's low-bit-first evaluation order. Rust does
     not specify powi's rounding order; this fixes that implementation choice.
@@ -266,6 +276,8 @@ def abs (x : F32) : Result F32 := .ok (BinaryFloat.abs x)
 def trunc (x : F32) : Result F32 := .ok (BinaryFloat.trunc x)
 @[rust_fun "std::f32::{f32}::fract"]
 def fract (x : F32) : Result F32 := .ok (BinaryFloat.fract x)
+@[rust_fun "std::f32::{f32}::floor"]
+def floor (x : F32) : Result F32 := .ok (BinaryFloat.floor x)
 @[rust_fun "std::f32::{f32}::powi"]
 def powi (x : F32) (n : I32) : Result F32 := .ok (BinaryFloat.powi x n.val)
 
@@ -344,6 +356,8 @@ def abs (x : F64) : Result F64 := .ok (BinaryFloat.abs x)
 def trunc (x : F64) : Result F64 := .ok (BinaryFloat.trunc x)
 @[rust_fun "std::f64::{f64}::fract"]
 def fract (x : F64) : Result F64 := .ok (BinaryFloat.fract x)
+@[rust_fun "std::f64::{f64}::floor"]
+def floor (x : F64) : Result F64 := .ok (BinaryFloat.floor x)
 @[rust_fun "std::f64::{f64}::powi"]
 def powi (x : F64) (n : I32) : Result F64 := .ok (BinaryFloat.powi x n.val)
 
@@ -387,6 +401,13 @@ def core.marker.CopyF64 : core.marker.Copy F64 := { cloneInst := core.clone.Clon
 def F32.toF64 (x : F32) : F64 := BinaryFloat.cast .binary64 x
 def F64.toF32 (x : F64) : F32 := BinaryFloat.cast .binary32 x
 
+@[rust_fun "core::convert::num::{core::convert::From<f64, f32>}::from"]
+def core.convert.num.FromF64F32.from_ (x : F32) : Result F64 := .ok (F32.toF64 x)
+@[reducible, rust_trait_impl "core::convert::From<f64, f32>"]
+def core.convert.num.FromF64F32 : core.convert.From F64 F32 := {
+  from_ := core.convert.num.FromF64F32.from_
+}
+
 namespace F16
 
 def ofBits (x : U16) : F16 := ⟨x.bv⟩
