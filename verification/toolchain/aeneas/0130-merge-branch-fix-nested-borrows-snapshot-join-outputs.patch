+(** The abstractions whose continuation output depends on the output of the
+    continuations of the abstractions [ids] (see [join_snapshots]) *)
+let join_snapshots_reach (snapshots : join_snapshots) (ids : V.AbsId.Set.t) :
+    V.AbsId.Set.t =
+  let rec close ids =
+    let next =
+      List.filter_map
+        (fun (id, id') -> if V.AbsId.Set.mem id ids then Some id' else None)
+        (snapshots.renamings @ snapshots.applied_in)
+    in
+    let ids' = V.AbsId.Set.union ids (V.AbsId.Set.of_list next) in
+    if V.AbsId.Set.equal ids ids' then ids else close ids'
+  in
+  close ids
+
+(** Whether the continuation output of the abstraction [aid] may depend on the
+    output of a continuation which applies stages in the snapshot of a join
+    (see [join_snapshots.snapshots] and [join_snapshots.may_snapshot]): it must
+    then be recombined with the current values of its nested loans *)
+let join_snapshots_may_reach (snapshots : join_snapshots) (aid : V.AbsId.id) :
+    bool =
+  V.AbsId.Set.mem aid
+    (join_snapshots_reach snapshots
+       (V.AbsId.Set.union snapshots.snapshots snapshots.may_snapshot))
