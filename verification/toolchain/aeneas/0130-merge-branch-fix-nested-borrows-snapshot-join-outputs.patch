+//@ [!lean] skip
+//@ [lean] subdir=NestedBorrowsAsDerefMutLoop
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::option::{core::option::Option} --include core::ops::deref::{core::ops::deref::Deref} --include core::ops::deref::{core::ops::deref::DerefMut}
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! `Option::as_deref_mut` on `Option<&'1 mut Frame<'2>>` in a join of a loop
+//! body (the shape of the node loop of `chelis_ir::eval`). As in
+//! `nested-borrows-as-deref-mut-join`, the continuation of the join
+//! abstraction of the frame's region applies the stages of the backward
+//! function of `as_deref_mut` in the snapshot of the join. Its output flows
+//! into the continuation of the abstraction of the `continue` of the loop body,
+//! which becomes the continuation of the loop abstraction: the output of that
+//! continuation is recombined with the current values of its nested loans (the
+//! frame the caller gives back) when the loop abstraction ends. Without the
+//! recombination the value given back to the frame's region would be its value
+//! at the join of the last iteration.
+//!
+//! `loop_match` matches the reborrow in an expression, `loop_twice` holds two
+//! such joins in each iteration.
+
+pub struct Frame<'a> {
+    pub steps: &'a [u32],
+    pub ctx: &'a mut u32,
+    pub pos: usize,
+}
+
+impl<'a> Frame<'a> {
+    pub fn advance(&mut self) -> u32 {
+        let s = self.steps[self.pos];
+        self.pos += 1;
+        *self.ctx = (*self.ctx).wrapping_add(s);
+        s
+    }
+}
+
+pub fn loop_iflet(mut execution: Option<&mut Frame<'_>>, n: u32) -> u32 {
+    let mut acc = 0u32;
+    let mut i = 0;
+    while i < n {
+        if let Some(f) = execution.as_deref_mut() {
+            acc = acc.wrapping_add(f.advance());
+        }
+        i += 1;
+    }
+    acc
+}
+
+pub fn loop_match(mut execution: Option<&mut Frame<'_>>, n: u32) -> u32 {
+    let mut acc = 0u32;
+    let mut i = 0;
+    while i < n {
+        acc = acc.wrapping_add(match execution.as_deref_mut() {
+            Some(f) => f.advance(),
+            None => i,
+        });
+        i += 1;
+    }
+    acc
+}
+
+pub fn loop_twice(mut execution: Option<&mut Frame<'_>>, n: u32) -> u32 {
+    let mut acc = 0u32;
+    let mut i = 0;
+    while i < n {
+        if let Some(f) = execution.as_deref_mut() {
+            acc = acc.wrapping_add(f.advance());
+        }
+        if let Some(f) = execution.as_deref_mut() {
+            *f.ctx = (*f.ctx).wrapping_mul(2);
+        }
+        i += 1;
+    }
+    acc
+}
+
+pub fn run_loop_iflet(f: &mut Frame<'_>, some: bool, n: u32) -> u32 {
+    if some { loop_iflet(Some(f), n) } else { loop_iflet(None, n) }
+}
+
+pub fn run_loop_match(f: &mut Frame<'_>, some: bool, n: u32) -> u32 {
+    if some { loop_match(Some(f), n) } else { loop_match(None, n) }
+}
+
+pub fn run_loop_twice(f: &mut Frame<'_>, some: bool, n: u32) -> u32 {
+    if some { loop_twice(Some(f), n) } else { loop_twice(None, n) }
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    /// `(result, ctx, pos)` after running `run` on a frame over `steps`, the
+    /// caller then setting the frame's `ctx` to `set` (if any)
+    fn on_frame<R>(
+        ctx: u32,
+        pos: usize,
+        set: Option<u32>,
+        run: impl FnOnce(&mut Frame<'_>) -> R,
+    ) -> (R, u32, usize) {
+        let steps = [3u32, 5, 7, 11];
+        let mut c = ctx;
+        let mut f = Frame { steps: &steps, ctx: &mut c, pos };
+        let r = run(&mut f);
+        if let Some(s) = set {
+            *f.ctx = s;
+        }
+        let pos = f.pos;
+        (r, c, pos)
+    }
+
+    #[test]
+    fn loop_iflet_native() {
+        let run = |some, n| move |f: &mut Frame<'_>| run_loop_iflet(f, some, n);
+        assert_eq!(on_frame(10, 0, None, run(true, 0)), (0, 10, 0));
+        assert_eq!(on_frame(10, 0, None, run(true, 1)), (3, 13, 1));
+        assert_eq!(on_frame(10, 0, None, run(true, 3)), (15, 25, 3));
+        assert_eq!(on_frame(10, 1, None, run(true, 3)), (23, 33, 4));
+        assert_eq!(on_frame(10, 1, None, run(false, 3)), (0, 10, 1));
+        assert_eq!(on_frame(10, 1, Some(99), run(true, 2)), (12, 99, 3));
+        assert_eq!(on_frame(u32::MAX, 0, None, run(true, 2)), (8, 7, 2));
+    }
+
+    #[test]
+    fn loop_match_native() {
+        let run = |some, n| move |f: &mut Frame<'_>| run_loop_match(f, some, n);
+        assert_eq!(on_frame(10, 0, None, run(true, 0)), (0, 10, 0));
+        assert_eq!(on_frame(10, 0, None, run(true, 1)), (3, 13, 1));
+        assert_eq!(on_frame(10, 0, None, run(true, 3)), (15, 25, 3));
+        assert_eq!(on_frame(10, 1, None, run(true, 3)), (23, 33, 4));
+        assert_eq!(on_frame(10, 1, None, run(false, 3)), (3, 10, 1));
+        assert_eq!(on_frame(10, 1, Some(99), run(true, 2)), (12, 99, 3));
+        assert_eq!(on_frame(u32::MAX, 0, None, run(true, 2)), (8, 7, 2));
+    }
+
+    #[test]
+    fn loop_twice_native() {
+        let run = |some, n| move |f: &mut Frame<'_>| run_loop_twice(f, some, n);
+        assert_eq!(on_frame(10, 0, None, run(true, 0)), (0, 10, 0));
+        assert_eq!(on_frame(10, 0, None, run(true, 1)), (3, 26, 1));
+        assert_eq!(on_frame(10, 0, None, run(true, 3)), (15, 138, 3));
+        assert_eq!(on_frame(10, 1, None, run(true, 3)), (23, 170, 4));
+        assert_eq!(on_frame(10, 1, None, run(false, 3)), (0, 10, 1));
+        assert_eq!(on_frame(10, 1, Some(99), run(true, 2)), (12, 99, 3));
+        assert_eq!(on_frame(u32::MAX, 0, None, run(true, 2)), (8, 18, 2));
+    }
+}
