+import CollectZipNested.CollectZipNested
+
+/-! Evaluate the model of `tests/src/collect-zip-nested.rs` on the inputs of its
+    `native` test module and compare with the native results. -/
+namespace collect_zip_nested.checks
+open Aeneas Aeneas.Std Result
+
+def i (x : Int) : I64 := ⟨BitVec.ofInt _ x⟩
+def sl (xs : List Int) (h : xs.length ≤ Usize.max := by scalar_tac) : Slice I64 :=
+  ⟨xs.map i, by simpa using h⟩
+def vec {α} (xs : List α) (h : xs.length ≤ Usize.max := by scalar_tac) : alloc.vec.Vec α := ⟨xs, h⟩
+def ints (v : alloc.vec.Vec I64) : List Int := v.val.map (·.val)
+def params (xs : List (Int × Int × Int)) (h : xs.length ≤ Usize.max := by scalar_tac) :
+    alloc.vec.Vec (I64 × I64 × I64) := ⟨xs.map fun (a, b, c) => (i a, i b, i c), by simpa using h⟩
+def ivec (xs : List Int) (h : xs.length ≤ Usize.max := by scalar_tac) : alloc.vec.Vec I64 :=
+  ⟨xs.map i, by simpa using h⟩
+
+def spatialOf (a b : Slice I64) (p : alloc.vec.Vec (I64 × I64 × I64)) :
+    Option (Option (List Int) × Nat × List Int) :=
+  match spatial_state a b p with
+  | ok (extents, calls, observed) => some (extents.map ints, calls.val, ints observed)
+  | _ => none
+
+#guard spatialOf (sl [1, 3, 7, 5]) (sl [8, 3, 3, 3]) (params [(1, 0, 0), (2, 1, 1)])
+  == some (some [5, 3], 2, [7, 3, 5, 3])
+#guard spatialOf (sl [1, 3, 7, 5]) (sl [8, 3, 3, 3]) (params [(1, 0, 0)])
+  == some (some [5], 1, [7, 3])
+#guard spatialOf (sl [1, 3, 7]) (sl [8, 3, 3]) (params [(1, 0, 0), (2, 1, 1)])
+  == some (some [5], 1, [7, 3])
