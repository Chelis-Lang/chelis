diff --git a/tests/src/collect-drain-filter.rs b/tests/src/collect-drain-filter.rs
new file mode 100644
index 0000000..2cac218
--- /dev/null
+++ b/tests/src/collect-drain-filter.rs
@@ -0,0 +1,103 @@
+//@ [!lean] skip
+//@ [lean] subdir=CollectDrainFilter
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::iter::adapters::map::Map --include core::iter::adapters::filter::Filter
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Collectors over `Vec::drain` and a Filter of it (chelis-types session.rs
+//! DiagnosticSink::retain_since): the Vec collector drives the drain by next,
+//! the filter calls its predicate once per drained element, and dropping the
+//! drain removes the whole range, whether or not it was exhausted.
+//! CollectDrainFilter/Checks.lean compares the model with the native results
+//! asserted in the native test module, including the size hints, the early
+//! exits and the vectors and predicate states given back.
+
+pub struct Sink {
+    pub errors: Vec<u32>,
+}
+
+impl Sink {
+    /// chelis-types session.rs retain_since.
+    pub fn retain_since(&mut self, offset: usize, mut keep: impl FnMut(&u32) -> bool) {
+        let retained = self
+            .errors
+            .drain(offset..)
+            .filter(|error| keep(error))
+            .collect::<Vec<_>>();
+        self.errors.extend(retained);
+    }
+}
+
+/// retain_since with a predicate that counts its calls: the sink and the
+/// predicate state given back.
+pub fn retain_even(errors: Vec<u32>, offset: usize) -> (Vec<u32>, u32) {
+    let mut sink = Sink { errors };
+    let mut calls = 0;
+    sink.retain_since(offset, |error| {
+        calls += 1;
+        *error % 2 == 0
+    });
+    (sink.errors, calls)
+}
+
+/// A second instance of the generic retain_since, whose predicate reads a
+/// captured bound.
+pub fn retain_below(errors: Vec<u32>, offset: usize, bound: u32) -> Vec<u32> {
+    let mut sink = Sink { errors };
+    sink.retain_since(offset, |error| *error < bound);
+    sink.errors
+}
+
+/// The drained range collected, and the vector given back.
+pub fn drained(mut v: Vec<u32>, start: usize, end: usize) -> (Vec<u32>, Vec<u32>) {
+    let out = v.drain(start..end).collect::<Vec<_>>();
+    (out, v)
+}
+
+pub fn drain_hint(v: &mut Vec<u32>, start: usize) -> (usize, Option<usize>) {
+    v.drain(start..).size_hint()
+}
+
+pub fn filter_hint(v: &mut Vec<u32>, start: usize) -> (usize, Option<usize>) {
+    v.drain(start..).filter(|x| *x > 1).size_hint()
+}
+
+/// An Option collector over a drain stops at the first None; the rest of
+/// the range is removed all the same.
+pub fn drained_checked(mut v: Vec<u32>, limit: u32) -> (Option<Vec<u32>>, Vec<u32>) {
+    let out = v
+        .drain(1..)
+        .map(|x| if x > limit { None } else { Some(x) })
+        .collect::<Option<Vec<_>>>();
+    (out, v)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn drain_collectors() {
+        assert_eq!(retain_even(vec![1, 2, 3, 4, 5, 6], 2), (vec![1, 2, 4, 6], 4));
+        assert_eq!(retain_even(vec![1, 3], 0), (vec![], 2));
+        assert_eq!(retain_even(vec![1, 3], 2), (vec![1, 3], 0));
+        assert_eq!(retain_below(vec![9, 1, 7, 2, 8], 1, 8), vec![9, 1, 7, 2]);
+        assert_eq!(retain_below(vec![9, 1, 7, 2, 8], 5, 8), vec![9, 1, 7, 2, 8]);
+        assert_eq!(drained(vec![1, 2, 3, 4], 1, 3), (vec![2, 3], vec![1, 4]));
+        assert_eq!(drained(vec![1, 2, 3, 4], 0, 4), (vec![1, 2, 3, 4], vec![]));
+        assert_eq!(drained(vec![1, 2, 3, 4], 2, 2), (vec![], vec![1, 2, 3, 4]));
+        let mut v = vec![1, 2, 3, 4];
+        assert_eq!(drain_hint(&mut v, 1), (3, Some(3)));
+        assert_eq!(v, vec![1]);
+        let mut v = vec![1, 2, 3, 4];
+        assert_eq!(filter_hint(&mut v, 1), (0, Some(3)));
+        assert_eq!(v, vec![1]);
+        assert_eq!(drained_checked(vec![1, 2, 9, 3], 5), (None, vec![1]));
+        assert_eq!(drained_checked(vec![1, 2, 3], 5), (Some(vec![2, 3]), vec![1]));
+        assert_eq!(drained_checked(vec![1], 5), (Some(vec![]), vec![1]));
+    }
+
+    #[test]
+    #[should_panic]
+    fn retain_past_the_end() {
+        retain_even(vec![1, 2], 3);
+    }
+}
