 namespace Aeneas.Std
 
@@ -47,6 +48,24 @@ def FromVecDequeArray (T : Type) (N : Usize) : core.convert.From (VecDeque T) (A
   from_ := FromVecDequeArray.from
 }
 
+/-- `FromIterator<T> for VecDeque<T>` (alloc/src/collections/vec_deque/mod.rs:3640, rustc 1.95):
+    `SpecFromIter::spec_from_iter(iter.into_iter())`. Its default (vec_deque/spec_from_iter.rs:8-19)
+    is `Vec::from_iter(iterator).into()`, and `From<Vec<T, A>>` (mod.rs:3736-3750) keeps the
+    vector's elements in order (`head = 0`, no reallocation). Its specializations for
+    `vec::IntoIter<T>` and `vec_deque::IntoIter<T>` (spec_from_iter.rs:21-34, `into_vecdeque`)
+    keep the remaining elements in order without calling `next`, which moves them out without
+    callbacks. The deque therefore holds the items of the Vec collector
+    (`alloc.vec.FromIteratorVec.from_iter`, repeated `next`), and the collection contract
+    (`CollectionContracts`) admits it exactly where it admits the Vec collector. The value given
+    back is the Vec collector's. -/
+@[rust_fun
+  "alloc::collections::vec_deque::{core::iter::traits::collect::FromIterator<alloc::collections::vec_deque::VecDeque<@T, alloc::alloc::Global>, @T>}::from_iter"]
+def FromIteratorVecDeque.from_iter {T I IntoIter : Type}
+    (into : core.iter.traits.collect.IntoIterator I T IntoIter)
+    (input : I) : Result (VecDeque T × I) := do
+  let (items, input) ← alloc.vec.FromIteratorVec.from_iter into input
+  .ok (⟨items.val⟩, input)
+
 /-- `VecDeque::len`: the element count. A native deque never holds more than
     `usize::MAX` elements (`push_back`/`push_front` panic with "capacity
     overflow" first, see `VecDeque.push_back`), so the failing branch is
@@ -121,4 +140,11 @@ def VecDeque.back {T : Type} (self : VecDeque T) : Result (Option T) :=
 
 end alloc.collections.vec_deque
 
+@[reducible, rust_trait_impl
+  "core::iter::traits::collect::FromIterator<alloc::collections::vec_deque::VecDeque<@T, alloc::alloc::Global>, @T>"]
+def core.iter.traits.collect.FromIteratorVecDeque (T : Type) :
+    core.iter.traits.collect.FromIterator (alloc.collections.vec_deque.VecDeque T) T := {
+  from_iter := alloc.collections.vec_deque.FromIteratorVecDeque.from_iter
+}
+
 end Aeneas.Std
