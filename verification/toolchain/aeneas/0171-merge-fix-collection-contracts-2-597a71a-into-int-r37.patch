--- /dev/null
+++ b/tests/lean/CollectDrainFilter/Checks.lean
@@ -0,0 +1,61 @@
+import CollectDrainFilter.CollectDrainFilter
+
+/-! Evaluate the model of `tests/src/collect-drain-filter.rs` on the inputs of its
+    `native` test module and compare with the native results. -/
+namespace collect_drain_filter.checks
+open Aeneas Aeneas.Std Result
+
+def u (x : Nat) : U32 := ⟨BitVec.ofNat _ x⟩
+def us (x : Nat) : Usize := ⟨BitVec.ofNat _ x⟩
+def vec (xs : List Nat) (h : xs.length ≤ Usize.max := by scalar_tac) : alloc.vec.Vec U32 :=
+  ⟨xs.map u, by simpa using h⟩
+def nats (v : alloc.vec.Vec U32) : List Nat := v.val.map (·.val)
+def hintOf (h : Usize × Option Usize) : Nat × Option Nat := (h.1.val, h.2.map (·.val))
+
+def evenOf (xs : List Nat) (offset : Nat) (h : xs.length ≤ Usize.max := by scalar_tac) :
+    Option (List Nat × Nat) :=
+  match retain_even (vec xs) (us offset) with
+  | ok (v, calls) => some (nats v, calls.val)
+  | _ => none
+
+#guard evenOf [1, 2, 3, 4, 5, 6] 2 == some ([1, 2, 4, 6], 4)
+#guard evenOf [1, 3] 0 == some ([], 2)
+#guard evenOf [1, 3] 2 == some ([1, 3], 0)
+-- `retain_past_the_end`: the drain range starts past the end (native panic).
+#guard evenOf [1, 2] 3 == none
+
+def belowOf (xs : List Nat) (offset bound : Nat) (h : xs.length ≤ Usize.max := by scalar_tac) :
+    Option (List Nat) :=
+  match retain_below (vec xs) (us offset) (u bound) with
+  | ok v => some (nats v)
+  | _ => none
+
+#guard belowOf [9, 1, 7, 2, 8] 1 8 == some [9, 1, 7, 2]
+#guard belowOf [9, 1, 7, 2, 8] 5 8 == some [9, 1, 7, 2, 8]
+
+def drainedOf (xs : List Nat) (start end_ : Nat) (h : xs.length ≤ Usize.max := by scalar_tac) :
+    Option (List Nat × List Nat) :=
+  match drained (vec xs) (us start) (us end_) with
