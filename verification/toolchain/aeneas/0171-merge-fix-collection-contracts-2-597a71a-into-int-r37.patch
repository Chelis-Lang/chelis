+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::iter::adapters::map::Map --include core::iter::adapters::filter::Filter
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! `FromIterator for VecDeque` (alloc vec_deque/mod.rs: `Vec::from_iter(..).into()`,
+//! or `into_vecdeque` for a vec::IntoIter source) and the deque operations of its
+//! chelis-ir users (analysis.rs reachable_nodes: a stack seeded by collecting the
+//! roots, popped from the back). CollectVecDeque/Checks.lean compares the model
+//! with the native results asserted in the native test module, including the
+//! early exits and the closure states given back.
+use std::collections::VecDeque;
+
+/// chelis-ir analysis.rs reachable_nodes (with a visited vector for the set).
+pub fn reachable(edges: &[Vec<u32>], roots: &[u32]) -> Vec<u32> {
+    let mut seen = vec![false; edges.len()];
+    let mut stack = roots.iter().copied().collect::<VecDeque<_>>();
+    let mut out = Vec::new();
+    while let Some(id) = stack.pop_back() {
+        if seen[id as usize] {
+            continue;
+        }
+        seen[id as usize] = true;
+        out.push(id);
+        if let Some(inputs) = edges.get(id as usize) {
+            for input in inputs {
+                stack.push_back(*input);
+            }
+        }
+    }
+    out
+}
+
+/// The length and both ends of a collected deque.
+pub fn ends(xs: &[u32]) -> (usize, Option<u32>, Option<u32>) {
+    let queue = xs.iter().copied().collect::<VecDeque<_>>();
+    let front = match queue.front() {
+        Some(x) => Some(*x),
+        None => None,
+    };
+    let back = match queue.back() {
+        Some(x) => Some(*x),
+        None => None,
+    };
+    (queue.len(), front, back)
+}
+
+fn drain_front(mut queue: VecDeque<u32>) -> Vec<u32> {
+    let mut out = Vec::new();
+    while let Some(x) = queue.pop_front() {
+        out.push(x);
+    }
+    out
+}
+
+/// A vec::IntoIter source after one next (native: into_vecdeque keeps the rest).
+pub fn from_rest(v: Vec<u32>) -> (Option<u32>, Vec<u32>) {
+    let mut iter = v.into_iter();
+    let first = iter.next();
+    let queue: VecDeque<u32> = iter.collect();
+    (first, drain_front(queue))
+}
+
+/// A filtering mapper that counts its calls: the state it gives back.
+pub fn filtered(xs: &[u32]) -> (Vec<u32>, u32) {
+    let mut calls = 0;
+    let queue = xs
+        .iter()
+        .filter(|x| {
+            calls += 1;
+            **x % 2 == 1
+        })
+        .map(|x| *x * 10)
+        .collect::<VecDeque<_>>();
+    (drain_front(queue), calls)
+}
+
+/// Collected through Option: stops at the first None.
+pub fn checked(xs: &[u32]) -> Option<Vec<u32>> {
+    let queue = xs
+        .iter()
+        .map(|x| if *x == 0 { None } else { Some(*x) })
+        .collect::<Option<VecDeque<u32>>>();
+    match queue {
+        Some(queue) => Some(drain_front(queue)),
+        None => None,
+    }
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn deques() {
+        let edges = vec![vec![1, 2], vec![3], vec![3], vec![], vec![0]];
+        assert_eq!(reachable(&edges, &[0]), vec![0, 2, 3, 1]);
+        assert_eq!(reachable(&edges, &[4, 1]), vec![1, 3, 4, 0, 2]);
+        assert_eq!(reachable(&edges, &[]), Vec::<u32>::new());
+        assert_eq!(ends(&[3, 1, 2]), (3, Some(3), Some(2)));
+        assert_eq!(ends(&[]), (0, None, None));
+        assert_eq!(from_rest(vec![5, 6, 7]), (Some(5), vec![6, 7]));
+        assert_eq!(from_rest(vec![]), (None, vec![]));
+        assert_eq!(filtered(&[1, 2, 3, 4, 5]), (vec![10, 30, 50], 5));
+        assert_eq!(filtered(&[]), (vec![], 0));
+        assert_eq!(checked(&[1, 2, 3]), Some(vec![1, 2, 3]));
+        assert_eq!(checked(&[1, 0, 3]), None);
+    }
+}
diff --git a/tests/src/collect-zip-nested.rs b/tests/src/collect-zip-nested.rs
new file mode 100644
index 0000000..ffa156e
--- /dev/null
+++ b/tests/src/collect-zip-nested.rs
@@ -0,0 +1,179 @@
+//@ [!lean] skip
+//@ [lean] subdir=CollectZipNested
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::iter::adapters::map::Map
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Collectors over a Zip whose left side is itself a TrustedRandomAccess zip of
+//! two slice iterators (or another callback-free indexed source) and whose
+//! right side is a vec::IntoIter of a Copy element (chelis-types app_tensor.rs
+//! compute_concrete_conv_spatial). Native collectors fold this
+//! TrustedRandomAccessNoCoerce zip over the shorter length (Vec) or drive it
+//! by next (Option through GenericShunt); the model collects by repeated next,
+//! whose surplus left next reads one more pair of references without a
+//! callback. CollectZipNested/Checks.lean compares the model with the native
+//! results asserted in the native test module, including the size hints, the
+//! early exits and the state the mapping closures give back.
+
+pub struct Subst {
+    pub calls: u32,
+    pub observed: Vec<i64>,
+}
+
+impl Subst {
+    /// Records the extent and rejects negative ones (the shape of
+    /// `subst.observe_dim(dim).known_extent()?`).
+    fn observe(&mut self, extent: &i64) -> Option<i64> {
+        self.observed.push(*extent);
+        if *extent < 0 { None } else { Some(*extent) }
+    }
+}
+
+pub fn conv_output_extent(input: i64, kernel: i64, stride: i64, low: i64, high: i64) -> Option<i64> {
+    let span = input + low + high - kernel;
+    if stride <= 0 || span < 0 {
+        return None;
+    }
+    Some(span / stride + 1)
+}
+
+/// chelis-types app_tensor.rs compute_concrete_conv_spatial.
+pub fn spatial(
+    input_dims: &[i64],
+    kernel_dims: &[i64],
+    params: Vec<(i64, i64, i64)>,
+    subst: &mut Subst,
+) -> Option<Vec<i64>> {
+    input_dims[2..]
+        .iter()
+        .zip(&kernel_dims[2..])
+        .zip(params)
+        .map(|((input, kernel), (stride, low, high))| {
+            subst.calls += 1;
+            let Some(input) = subst.observe(input) else { return None };
+            let Some(kernel) = subst.observe(kernel) else { return None };
+            conv_output_extent(input, kernel, stride, low, high)
+        })
+        .collect()
+}
+
+/// `spatial` with the closure state it gives back.
+pub fn spatial_state(
+    input_dims: &[i64],
+    kernel_dims: &[i64],
+    params: Vec<(i64, i64, i64)>,
+) -> (Option<Vec<i64>>, u32, Vec<i64>) {
+    let mut subst = Subst { calls: 0, observed: Vec::new() };
+    let extents = spatial(input_dims, kernel_dims, params, &mut subst);
+    (extents, subst.calls, subst.observed)
+}
+
+/// The Vec collector (TrustedLen: the native fold reads min(len) indices and
+/// never takes the surplus left pair); the mapper counts its calls.
+pub fn sums(a: &[i64], b: &[i64], c: Vec<(i64, i64)>) -> (Vec<i64>, u32) {
+    let mut calls = 0;
+    let values = a
+        .iter()
+        .zip(b)
+        .zip(c)
+        .map(|((x, y), (z, w))| {
+            calls += 1;
+            *x + *y + z + w
+        })
+        .collect();
+    (values, calls)
+}
+
+/// The zipped pairs themselves.
+pub fn triples(a: &[i64], b: &[i64], c: Vec<i64>) -> Vec<(i64, i64, i64)> {
+    a.iter().zip(b).zip(c).map(|((x, y), z)| (*x, *y, z)).collect()
+}
+
+pub fn hint(a: &[i64], b: &[i64], c: Vec<i64>) -> (usize, Option<usize>) {
+    a.iter().zip(b).zip(c).size_hint()
+}
+
+/// One next, then the size hint of the rest.
+pub fn next_then_hint(a: &[i64], b: &[i64], c: Vec<i64>) -> (Option<(i64, i64, i64)>, usize, Option<usize>) {
+    let mut zip = a.iter().zip(b).zip(c);
+    let first = match zip.next() {
+        Some(((x, y), z)) => Some((*x, *y, z)),
+        None => None,
+    };
+    let (lower, upper) = zip.size_hint();
+    (first, lower, upper)
+}
+
+/// Zip::count is its fold.
+pub fn count(a: &[i64], b: &[i64], c: Vec<i64>) -> usize {
+    a.iter().zip(b).zip(c).count()
+}
+
+/// A Copied and Enumerate left side.
+pub fn enumerated(a: &[i64], c: Vec<i64>) -> Vec<(usize, i64, i64)> {
+    a.iter().copied().enumerate().zip(c).map(|((i, x), z)| (i, x, z)).collect()
+}
+
+/// A std integer range on the left.
+pub fn indexed(n: usize, c: Vec<i64>) -> Vec<(usize, i64)> {
+    (0..n).zip(c).collect()
+}
+
+/// A slice iterator on the left, collected into an Option.
+pub fn checked(a: &[i64], c: Vec<i64>) -> Option<Vec<i64>> {
+    a.iter().zip(c).map(|(x, z)| if *x < z { None } else { Some(*x - z) }).collect()
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn nested_zips() {
+        // conv: inputs [n, c, 7, 5], kernels [o, c, 3, 3], strides/padding per spatial axis.
+        assert_eq!(
+            spatial_state(&[1, 3, 7, 5], &[8, 3, 3, 3], vec![(1, 0, 0), (2, 1, 1)]),
+            (Some(vec![5, 3]), 2, vec![7, 3, 5, 3])
+        );
+        // params shorter than the dims: the surplus left pair is read, never mapped.
+        assert_eq!(
+            spatial_state(&[1, 3, 7, 5], &[8, 3, 3, 3], vec![(1, 0, 0)]),
+            (Some(vec![5]), 1, vec![7, 3])
+        );
+        // params longer than the dims.
+        assert_eq!(
+            spatial_state(&[1, 3, 7], &[8, 3, 3], vec![(1, 0, 0), (2, 1, 1)]),
+            (Some(vec![5]), 1, vec![7, 3])
+        );
+        // An early exit: the second input extent is negative.
+        assert_eq!(
+            spatial_state(&[1, 3, 7, -1, 9], &[8, 3, 3, 3, 3], vec![(1, 0, 0), (1, 0, 0), (1, 0, 0)]),
+            (None, 2, vec![7, 3, -1])
+        );
+        // An early exit in conv_output_extent (stride 0), before the kernel of axis 2 is observed.
+        assert_eq!(
+            spatial_state(&[1, 3, 7, 5, 4], &[8, 3, 3, 3, 3], vec![(0, 0, 0), (1, 0, 0), (1, 0, 0)]),
+            (None, 1, vec![7, 3])
+        );
+        assert_eq!(spatial_state(&[1, 3], &[8, 3], vec![(1, 0, 0)]), (Some(vec![]), 0, vec![]));
+        assert_eq!(sums(&[1, 2, 3], &[10, 20, 30], vec![(100, 1000)]), (vec![1111], 1));
+        assert_eq!(sums(&[1, 2], &[10, 20, 30], vec![(100, 1000), (200, 2000), (300, 3000)]), (vec![1111, 2222], 2));
+        assert_eq!(sums(&[], &[10], vec![(100, 1000)]), (vec![], 0));
+        assert_eq!(triples(&[1, 2, 3], &[4, 5], vec![7, 8, 9]), vec![(1, 4, 7), (2, 5, 8)]);
+        assert_eq!(triples(&[1, 2, 3], &[4, 5, 6], vec![7]), vec![(1, 4, 7)]);
+        assert_eq!(hint(&[1, 2, 3], &[4, 5], vec![7, 8, 9]), (2, Some(2)));
+        assert_eq!(hint(&[1, 2, 3], &[4, 5, 6], vec![7]), (1, Some(1)));
+        assert_eq!(hint(&[], &[4], vec![7]), (0, Some(0)));
+        assert_eq!(next_then_hint(&[1, 2, 3], &[4, 5, 6], vec![7, 8]), (Some((1, 4, 7)), 1, Some(1)));
+        // The surplus left pair is consumed by next: the left zip is then exhausted too.
+        assert_eq!(next_then_hint(&[1, 2], &[4, 5], vec![]), (None, 0, Some(0)));
+        assert_eq!(next_then_hint(&[1], &[4, 5], vec![7, 8]), (Some((1, 4, 7)), 0, Some(0)));
+        assert_eq!(count(&[1, 2, 3], &[4, 5, 6], vec![7, 8]), 2);
+        assert_eq!(count(&[1, 2], &[4, 5, 6], vec![7, 8, 9]), 2);
+        assert_eq!(enumerated(&[5, 6, 7], vec![1, 2]), vec![(0, 5, 1), (1, 6, 2)]);
+        assert_eq!(enumerated(&[5], vec![1, 2]), vec![(0, 5, 1)]);
+        assert_eq!(indexed(3, vec![9, 8]), vec![(0, 9), (1, 8)]);
+        assert_eq!(indexed(1, vec![9, 8]), vec![(0, 9)]);
+        assert_eq!(checked(&[5, 6, 7], vec![1, 2]), Some(vec![4, 4]));
+        assert_eq!(checked(&[0, 6], vec![1, 2]), None);
+        assert_eq!(checked(&[5], vec![1, 2]), Some(vec![4]));
+    }
+}
