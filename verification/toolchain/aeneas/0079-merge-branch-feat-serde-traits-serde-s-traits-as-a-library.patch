+namespace serde_core.ser
+
+/-- The knot: a `Serialize` dictionary at every level. At level `n + 1` it runs against the
+    level-`n` format, seen at `SerializeΩ` by projecting its nested dictionaries to level `n`. -/
+def Serialize.wrap {T : Type} (d : serde_core.ser.Serialize T) : SerializeΩ T :=
+  ⟨fun n => match n with
+    | 0 => PUnit.unit
+    | n + 1 => ⟨fun inst => d.serialize (inst.map (fun x => x.level n))⟩⟩
+
+/-- The knot is definitional: a wrapped dictionary at level `n + 1` is the dictionary run against
+    the level-`n` format. -/
+theorem Serialize.wrap_level_succ {T : Type} (d : serde_core.ser.Serialize T) (n : Nat) :
+    (Serialize.wrap d).level (n + 1) =
+      ⟨fun inst => d.serialize (inst.map (fun x => x.level n))⟩ := rfl
+
+/-! ## Every Rust format has an encoding
+
+A family of format types (indexed by `ι`: the serializers a Rust format passes to nested
+`serialize` calls, e.g. serde_json's `&mut Serializer` and `MapKeySerializer`) with their associated
+types. -/
+structure FormatTypes (ι : Type) where
+  S : ι → Type
+  Ok : ι → Type
+  Error : ι → Type
+  SerializeSeq : ι → Type
+  SerializeTuple : ι → Type
+  SerializeTupleStruct : ι → Type
+  SerializeTupleVariant : ι → Type
+  SerializeMap : ι → Type
+  SerializeStruct : ι → Type
+  SerializeStructVariant : ι → Type
+
+/-- The format-side dictionaries of the family at the knot family `X`. -/
+def FormatTypes.Dicts {ι : Type} (τ : FormatTypes ι) (X : Type → Type 1) : Type 1 :=
+  ∀ i, SerializerF X (τ.S i) (τ.Ok i) (τ.Error i) (τ.SerializeSeq i) (τ.SerializeTuple i)
+    (τ.SerializeTupleStruct i) (τ.SerializeTupleVariant i) (τ.SerializeMap i)
+    (τ.SerializeStruct i) (τ.SerializeStructVariant i)
+
+/-- A Rust format: its dictionaries, generic in the knot family, given the family's dictionaries
+    one level down. A Rust format receives `T: Serialize` at a knot position and can use it only by
+    calling `serialize` with a serializer; with `X` abstract, the received `SerializeStep X T` can
+    only be run against formats at `X`, i.e. the family one level down (or formats built from it). -/
+structure FormatProgram {ι : Type} (τ : FormatTypes ι) where
+  /-- The format when no nested data-side call is left (only the knot positions matter). -/
+  base : τ.Dicts (SerializeAt 0)
+  step : ∀ (X : Type → Type 1), τ.Dicts X → τ.Dicts (SerializeStep X)
+
+/-- The format at level `n`. -/
+def FormatProgram.level {ι : Type} {τ : FormatTypes ι} (p : FormatProgram τ) :
+    (n : Nat) → τ.Dicts (SerializeAt n)
+  | 0 => p.base
+  | n + 1 => p.step (SerializeAt n) (p.level n)
+
+/-- The encoding of a Rust format with nesting bound `n`: a `Serializer` dictionary. -/
+def FormatProgram.encode {ι : Type} {τ : FormatTypes ι} (p : FormatProgram τ) (n : Nat) (i : ι) :
+    serde_core.ser.Serializer (τ.S i) (τ.Ok i) (τ.Error i) (τ.SerializeSeq i)
+      (τ.SerializeTuple i) (τ.SerializeTupleStruct i) (τ.SerializeTupleVariant i)
+      (τ.SerializeMap i) (τ.SerializeStruct i) (τ.SerializeStructVariant i) :=
+  (p.level n i).map (fun x => x.level n)
+
+/-- The data-side dictionary a program receives at level `n + 1` for a wrapped `d`. -/
+def stepDict {T : Type} (d : serde_core.ser.Serialize T) (n : Nat) :
+    SerializeStep (SerializeAt n) T :=
+  ⟨fun inst => d.serialize (inst.map (fun x => x.level n))⟩
+
+/-- The encoded format at bound `n + 1` is the program's step over the level-`n` family, with the
+    nested dictionaries at level `n + 1`. -/
+theorem FormatProgram.encode_succ {ι : Type} {τ : FormatTypes ι} (p : FormatProgram τ) (n : Nat)
+    (i : ι) : p.encode (n + 1) i =
+      (p.step (SerializeAt n) (p.level n) i).map (fun x => x.level (n + 1)) := rfl
+
+/-- A wrapped dictionary reaches the program as `stepDict d n`. -/
+theorem FormatProgram.wrap_reaches {T : Type} (d : serde_core.ser.Serialize T) (n : Nat) :
+    (Serialize.wrap d).level (n + 1) = stepDict d n := rfl
+
+/-- Running the received dictionary against a format of the family one level down runs `d`
+    against that format's encoding: the Rust semantics of a nested `value.serialize(sub)`. -/
+theorem FormatProgram.stepDict_serialize {ι : Type} {τ : FormatTypes ι} (p : FormatProgram τ)
+    {T : Type} (d : serde_core.ser.Serialize T) (n : Nat) (j : ι) :
+    (stepDict d n).serialize (p.level n j) = d.serialize (p.encode n j) := rfl
+
+/-- Every family of format types has a program, e.g. the one whose methods diverge. Hence the
+    `Serializer` dictionaries of statements about data-side implementations are never vacuous. -/
+def bottom (X : Type → Type 1) {S Ok Error SS ST STS STV SM SSt SSV : Type} :
+    SerializerF X S Ok Error SS ST STS STV SM SSt SSV :=
+  let err : serde_core.ser.Error Error :=
+    { coreerrorErrorInst := ⟨⟨fun _ _ => .div⟩, ⟨fun _ _ => .div⟩⟩, custom := fun _ _ => .div }
+  { serde_coreserErrorInst := err
+    SerializeSeqInst := ⟨err, fun _ _ _ => .div, fun _ => .div⟩
+    SerializeTupleInst := ⟨err, fun _ _ _ => .div, fun _ => .div⟩
+    SerializeTupleStructInst := ⟨err, fun _ _ _ => .div, fun _ => .div⟩
+    SerializeTupleVariantInst := ⟨err, fun _ _ _ => .div, fun _ => .div⟩
+    SerializeMapInst := { serde_coreserErrorInst := err, serialize_key := fun _ _ _ => .div,
+                          serialize_value := fun _ _ _ => .div, «end» := fun _ => .div }
+    SerializeStructInst := { serde_coreserErrorInst := err,
+                             serialize_field := fun _ _ _ _ => .div, «end» := fun _ => .div }
+    SerializeStructVariantInst := { serde_coreserErrorInst := err,
+                                    serialize_field := fun _ _ _ _ => .div,
+                                    «end» := fun _ => .div }
+    serialize_bool := fun _ _ => .div, serialize_i8 := fun _ _ => .div,
+    serialize_i16 := fun _ _ => .div, serialize_i32 := fun _ _ => .div,
+    serialize_i64 := fun _ _ => .div, serialize_u8 := fun _ _ => .div,
+    serialize_u16 := fun _ _ => .div, serialize_u32 := fun _ _ => .div,
+    serialize_u64 := fun _ _ => .div, serialize_f32 := fun _ _ => .div,
+    serialize_f64 := fun _ _ => .div, serialize_char := fun _ _ => .div,
+    serialize_str := fun _ _ => .div, serialize_bytes := fun _ _ => .div,
+    serialize_none := fun _ => .div, serialize_some := fun _ _ _ => .div,
+    serialize_unit := fun _ => .div, serialize_unit_struct := fun _ _ => .div,
+    serialize_unit_variant := fun _ _ _ _ => .div,
+    serialize_newtype_struct := fun _ _ _ _ => .div,
+    serialize_newtype_variant := fun _ _ _ _ _ _ => .div,
+    serialize_seq := fun _ _ => .div, serialize_tuple := fun _ _ => .div,
+    serialize_tuple_struct := fun _ _ _ => .div,
+    serialize_tuple_variant := fun _ _ _ _ _ => .div, serialize_map := fun _ _ => .div,
+    serialize_struct := fun _ _ _ => .div, serialize_struct_variant := fun _ _ _ _ _ => .div }
+
+end serde_core.ser
+
+end Aeneas.Std
