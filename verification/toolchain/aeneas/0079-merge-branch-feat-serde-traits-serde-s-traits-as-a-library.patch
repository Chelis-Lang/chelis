@@ -0,0 +1,188 @@
+import Aeneas.Std.Serde.Ser
+import Aeneas.Std.Serde.De
+
+/-!
+# serde's own implementations reached by the core (serde_core 1.0.228)
+
+Transcriptions of `serde_core::ser::impls` / `serde_core::de::impls`: `tri!` is
+`match e { Ok(v) => v, Err(e) => return Err(e) }` (no conversion). The data-side dictionaries passed
+at the format side's method-level bounds are wrapped by the knot (`Serialize.wrap`,
+`Deserialize.wrap`, `Visitor.wrap`), as Aeneas does in extracted code.
+-/
+
+namespace Aeneas.Std
+
+open Result
+
+namespace serde_core.ser.impls
+
+/-- `impl<T0: Serialize, T1: Serialize> Serialize for (T0, T1)` (ser/impls.rs `tuple_impl_body!`):
+    `serialize_tuple(2)`, then `serialize_element(&self.0)`, `serialize_element(&self.1)`, `end()`. -/
+@[rust_fun "serde_core::ser::impls::{serde_core::ser::Serialize<(@T0, @T1)>}::serialize"]
+def SerializePair.serialize {T0 T1 S Ok Error SS ST STS STV SM SSt SSV : Type}
+    (i0 : serde_core.ser.Serialize T0) (i1 : serde_core.ser.Serialize T1)
+    (inst : serde_core.ser.Serializer S Ok Error SS ST STS STV SM SSt SSV)
+    (self : T0 × T1) (serializer : S) : Result (core.result.Result Ok Error) := do
+  match ← inst.serialize_tuple serializer 2#usize with
+  | .Err e => ok (.Err e)
+  | .Ok tuple =>
+    let (r, tuple) ← inst.SerializeTupleInst.serialize_element (Serialize.wrap i0) tuple self.1
+    match r with
+    | .Err e => ok (.Err e)
+    | .Ok () =>
+      let (r, tuple) ← inst.SerializeTupleInst.serialize_element (Serialize.wrap i1) tuple self.2
+      match r with
+      | .Err e => ok (.Err e)
+      | .Ok () => inst.SerializeTupleInst.«end» tuple
+
+@[reducible, rust_trait_impl "serde_core::ser::Serialize<(@T0, @T1)>"]
+def SerializePair {T0 T1 : Type} (i0 : serde_core.ser.Serialize T0)
+    (i1 : serde_core.ser.Serialize T1) : serde_core.ser.Serialize (T0 × T1) :=
+  { serialize := fun inst self serializer => SerializePair.serialize i0 i1 inst self serializer }
+
+/-- `impl<'a, T: ?Sized + Serialize> Serialize for &'a T` (`deref_impl!`): `(**self).serialize(s)`. -/
+@[rust_fun "serde_core::ser::impls::{serde_core::ser::Serialize<&'a @T>}::serialize"]
+def SerializeShared.serialize {T S Ok Error SS ST STS STV SM SSt SSV : Type}
+    (i : serde_core.ser.Serialize T)
+    (inst : serde_core.ser.Serializer S Ok Error SS ST STS STV SM SSt SSV)
+    (self : T) (serializer : S) : Result (core.result.Result Ok Error) :=
+  i.serialize inst self serializer
+
+@[reducible, rust_trait_impl "serde_core::ser::Serialize<&'a @T>"]
+def SerializeShared {T : Type} (i : serde_core.ser.Serialize T) : serde_core.ser.Serialize T :=
+  { serialize := fun inst self serializer => SerializeShared.serialize i inst self serializer }
+
+/-- `primitive_impl!(u32, serialize_u32)`: `serializer.serialize_u32(*self)`. -/
+@[rust_fun "serde_core::ser::impls::{serde_core::ser::Serialize<u32>}::serialize"]
+def SerializeU32.serialize {S Ok Error SS ST STS STV SM SSt SSV : Type}
+    (inst : serde_core.ser.Serializer S Ok Error SS ST STS STV SM SSt SSV)
+    (self : U32) (serializer : S) : Result (core.result.Result Ok Error) :=
+  inst.serialize_u32 serializer self
+
+@[reducible, rust_trait_impl "serde_core::ser::Serialize<u32>"]
+def SerializeU32 : serde_core.ser.Serialize U32 :=
+  { serialize := fun inst self serializer => SerializeU32.serialize inst self serializer }
+
+/-- `impl Serialize for String`: `serializer.serialize_str(self)`. -/
+@[rust_fun "serde_core::ser::impls::{serde_core::ser::Serialize<alloc::string::String>}::serialize"]
+def SerializeString.serialize {S Ok Error SS ST STS STV SM SSt SSV : Type}
+    (inst : serde_core.ser.Serializer S Ok Error SS ST STS STV SM SSt SSV)
+    (self : String) (serializer : S) : Result (core.result.Result Ok Error) := do
+  inst.serialize_str serializer (← Str.ofString self)
+
+@[reducible, rust_trait_impl "serde_core::ser::Serialize<alloc::string::String>"]
+def SerializeString : serde_core.ser.Serialize String :=
+  { serialize := fun inst self serializer => SerializeString.serialize inst self serializer }
+
+end serde_core.ser.impls
+
+namespace serde_core.de.impls
+
+/-- `concat!("a tuple of size ", 2)` (`TupleVisitor::expecting`, also its `Expected`). -/
+def tuple2Expecting (_ : Unit) (formatter : core.fmt.Formatter) : core.fmt.Outcome :=
+  formatter.append "a tuple of size 2"
+
+/-- `TupleVisitor<T0, T1>` of `impl Deserialize for (T0, T1)` (de/impls.rs `tuple_impl_body!`):
+    `seq.next_element()?` for each component, `Error::invalid_length(i, &self)` when missing. -/
+def TupleVisitor2 {T0 T1 : Type} (i0 : serde_core.de.Deserialize T0)
+    (i1 : serde_core.de.Deserialize T1) : serde_core.de.Visitor Unit (T0 × T1) :=
+  { expecting := tuple2Expecting
+    visit_seq := fun {A Error} (seq : serde_core.de.SeqAccess A Error) self access => do
+      let (r, access) ← seq.next_element (Deserialize.wrap i0) access
+      match r with
+      | .Err e => ok (.Err e)
+      | .Ok none =>
+        ok (.Err (← seq.serde_coredeErrorInst.invalid_length 0#usize (expectedOf tuple2Expecting self)))
+      | .Ok (some t0) =>
+        let (r, _) ← seq.next_element (Deserialize.wrap i1) access
+        match r with
+        | .Err e => ok (.Err e)
+        | .Ok none =>
+          ok (.Err (← seq.serde_coredeErrorInst.invalid_length 1#usize (expectedOf tuple2Expecting self)))
+        | .Ok (some t1) => ok (.Ok (t0, t1)) }
+
+/-- `impl<'de, T0: Deserialize, T1: Deserialize> Deserialize<'de> for (T0, T1)`:
+    `deserializer.deserialize_tuple(2, TupleVisitor { marker: PhantomData })`. -/
+@[rust_fun "serde_core::de::impls::{serde_core::de::Deserialize<'de, (@T0, @T1)>}::deserialize"]
+def DeserializePair.deserialize {T0 T1 D Error : Type} (i0 : serde_core.de.Deserialize T0)
+    (i1 : serde_core.de.Deserialize T1) (inst : serde_core.de.Deserializer D Error)
+    (deserializer : D) : Result (core.result.Result (T0 × T1) Error) :=
+  inst.deserialize_tuple (Visitor.wrap (TupleVisitor2 i0 i1)) deserializer 2#usize ()
+
+@[reducible, rust_trait_impl "serde_core::de::Deserialize<'de, (@T0, @T1)>"]
+def DeserializePair {T0 T1 : Type} (i0 : serde_core.de.Deserialize T0)
+    (i1 : serde_core.de.Deserialize T1) : serde_core.de.Deserialize (T0 × T1) :=
+  { deserialize := fun inst deserializer => DeserializePair.deserialize i0 i1 inst deserializer }
+
+/-- `Err(Error::invalid_value(unexp, &self))` of a visitor whose `expecting` is `text`. -/
+def invalidValue {Value E : Type} (errInst : serde_core.de.Error E) (text : String)
+    (unexp : serde_core.de.Unexpected) : Result (core.result.Result Value E) := do
+  .ok (.Err (← errInst.invalid_value unexp (expectedOf (fun (_ : Unit) f => f.append text) ())))
+
+def u32OfNat (n : Nat) : U32 := ⟨BitVec.ofNat _ n⟩
+
+/-- `int_to_uint!`: `if 0 <= v { if let Ok(v) = u32::try_from(v as u64) { return Ok(v) } }
+    Err(Error::invalid_value(Unexpected::Signed(v as i64), &self))`. -/
+def u32OfSigned {Value E : Type} (errInst : serde_core.de.Error E) (wrapOk : U32 → Value)
+    (v : Int) (signed : I64) : Result (core.result.Result Value E) :=
+  if 0 ≤ v ∧ v ≤ U32.max then .ok (.Ok (wrapOk (u32OfNat v.toNat)))
+  else invalidValue errInst "u32" (.Signed signed)
+
+/-- `PrimitiveVisitor` of `impl Deserialize for u32` (de/impls.rs `impl_deserialize_num!`):
+    `num_self!(u32)`, `num_as_self!(u8 u16)`, `int_to_uint!(i8 i16 i32 i64)`, `uint_to_self!(u64)`;
+    `expecting` is `stringify!(u32)`. -/
+def U32Visitor : serde_core.de.Visitor Unit U32 :=
+  { expecting := fun _ f => f.append "u32"
+    visit_u32 := fun _ _ v => .ok (.Ok v)
+    visit_u8 := fun _ _ v => .ok (.Ok (v.cast .U32))
+    visit_u16 := fun _ _ v => .ok (.Ok (v.cast .U32))
+    visit_i8 := fun e _ v => u32OfSigned e id v.val (v.cast .I64)
+    visit_i16 := fun e _ v => u32OfSigned e id v.val (v.cast .I64)
+    visit_i32 := fun e _ v => u32OfSigned e id v.val (v.cast .I64)
+    visit_i64 := fun e _ v => u32OfSigned e id v.val v
+    visit_u64 := fun e _ v =>
+      if v.val ≤ U32.max then .ok (.Ok (u32OfNat v.val))
+      else invalidValue e "u32" (.Unsigned v) }
+
+/-- `impl Deserialize for u32`: `deserializer.deserialize_u32(PrimitiveVisitor)`. -/
+@[rust_fun "serde_core::de::impls::{serde_core::de::Deserialize<'de, u32>}::deserialize"]
+def DeserializeU32.deserialize {D Error : Type} (inst : serde_core.de.Deserializer D Error)
+    (deserializer : D) : Result (core.result.Result U32 Error) :=
+  inst.deserialize_u32 (Visitor.wrap U32Visitor) deserializer ()
+
+@[reducible, rust_trait_impl "serde_core::de::Deserialize<'de, u32>"]
+def DeserializeU32 : serde_core.de.Deserialize U32 :=
+  { deserialize := fun inst deserializer => DeserializeU32.deserialize inst deserializer }
+
+/-- `str::from_utf8`. -/
+def utf8? (bytes : List U8) : Option String :=
+  String.fromUTF8? ⟨(bytes.map fun b => b.val.toUInt8).toArray⟩
+
+/-- `StringVisitor` of `impl Deserialize for String` (de/impls.rs). -/
+def StringVisitor : serde_core.de.Visitor Unit String :=
+  { expecting := fun _ f => f.append "a string"
+    visit_str := fun _ _ v => do .ok (.Ok (← Str.toString v))
+    visit_string := fun _ _ v => .ok (.Ok v)
+    visit_bytes := fun e _ v =>
+      match utf8? v.val with
+      | some s => .ok (.Ok s)
+      | none => invalidValue e "a string" (.Bytes v)
+    visit_byte_buf := fun e _ v =>
+      match utf8? v.val with
+      | some s => .ok (.Ok s)
+      | none => invalidValue e "a string" (.Bytes v) }
+
+/-- `impl Deserialize for String`: `deserializer.deserialize_string(StringVisitor)`. -/
+@[rust_fun
+  "serde_core::de::impls::{serde_core::de::Deserialize<'de, alloc::string::String>}::deserialize"]
+def DeserializeString.deserialize {D Error : Type} (inst : serde_core.de.Deserializer D Error)
+    (deserializer : D) : Result (core.result.Result String Error) :=
+  inst.deserialize_string (Visitor.wrap StringVisitor) deserializer ()
+
+@[reducible, rust_trait_impl "serde_core::de::Deserialize<'de, alloc::string::String>"]
+def DeserializeString : serde_core.de.Deserialize String :=
+  { deserialize := fun inst deserializer => DeserializeString.deserialize inst deserializer }
+
+end serde_core.de.impls
+
+end Aeneas.Std
diff --git a/backends/lean/Aeneas/Std/Serde/Ser.lean b/backends/lean/Aeneas/Std/Serde/Ser.lean
