+/-!
+# `serde_core::de` (serde 1.0.228)
+
+`Deserialize`, `DeserializeSeed`, `Visitor` (the *data side*: implemented by the deserialized types)
+and `Deserializer`, `SeqAccess`, `MapAccess`, `EnumAccess`, `VariantAccess` (the *format side*) form
+a recursive group through method-level bounds (`deserialize<D: Deserializer>`,
+`deserialize_seq<V: Visitor>`, `visit_seq<A: SeqAccess>`, `next_element_seed<T: DeserializeSeed>`,
+...), i.e. negative occurrences. As in `Serde/Ser.lean`, the format side is defined relative to a
+knot family `X : Fam` (the data-side dictionaries it receives at its method-level bounds), the data
+side over the format side at `X`, the levels are `DeAt 0 = PUnit`, `DeAt (n + 1) = Step (DeAt n)`,
+and the Rust traits are the structures at the limit `Ω`. The knots `Deserialize.wrap : Deserialize T → DeserializeΩ T`,
+`DeserializeSeed.wrap`, `Visitor.wrap` (the `knot`s of their `rust_trait` attributes: Aeneas wraps
+the dictionaries passed at the format side's method-level bounds) run a dictionary at level `n + 1`
+against the level-`n` formats (`*.map (proj n)`); they are definitional (`wrap_level_succ`). `FormatProgram.encode` encodes every Rust format (a family of deserializers and
+access types, generic in the knot family), with `rfl` unfolding lemmas.
+
+`&dyn Expected` (the `exp` argument of `Error::invalid_type`/`invalid_value`/`invalid_length`) is
+`Dyn (fun T => Expected T)`, Aeneas's translation of trait objects.
+-/
+
+namespace Aeneas.Std
+
+open Result
+
+namespace serde_core.private
+
+/-- `fmt::write(f.buf, args)`: the pieces and arguments are written to the formatter's output with
+    default options (the formatter's own options are restored). -/
+def writeArgs (f : core.fmt.Formatter) (k : core.fmt.Callback) : core.fmt.Outcome := do
+  let (status, g) ← k { f with options := {} }
+  .ok (status, { g with options := f.options })
+
+/-- A `fmt::Arguments` given to `Error::custom`, with `impl Display for Arguments`
+    (`write(fmt.buf, *self)`). `custom<T: Display>` is parametric in `T`. -/
+abbrev Msg := core.fmt.Callback
+
+def displayMsg : core.fmt.Display Msg := ⟨fun m f => writeArgs f m⟩
+
+def lit (s : String) : core.fmt.Callback := fun f => f.append s
+
+/-- The pieces of a `format_args!`, written in order, stopping at the first error. -/
+def cat : List core.fmt.Callback → core.fmt.Callback
+  | [] => fun f => .ok (.Ok (), f)
+  | k :: ks => fun f => core.fmt.thenFormat (k f) (cat ks)
+
+/-- `{}` of a `&str` (default options). -/
+def strArg (s : Str) : core.fmt.Callback := fun f => do f.append (← core.fmt.decode s.val)
+
+def utf8 (c : Char) : Result Str := Str.ofString (String.singleton c)
+
+end serde_core.private
+
+open serde_core.private
+
+/-- `serde_core::de::Unexpected` -/
+@[rust_type "serde_core::de::Unexpected"]
+inductive serde_core.de.Unexpected where
+  | Bool : Bool → serde_core.de.Unexpected
+  | Unsigned : U64 → serde_core.de.Unexpected
+  | Signed : I64 → serde_core.de.Unexpected
+  | Float : F64 → serde_core.de.Unexpected
+  | Char : Char → serde_core.de.Unexpected
+  | Str : Str → serde_core.de.Unexpected
+  | Bytes : Slice U8 → serde_core.de.Unexpected
+  | Unit : serde_core.de.Unexpected
+  | Option : serde_core.de.Unexpected
+  | NewtypeStruct : serde_core.de.Unexpected
+  | Seq : serde_core.de.Unexpected
+  | Map : serde_core.de.Unexpected
+  | Enum : serde_core.de.Unexpected
+  | UnitVariant : serde_core.de.Unexpected
+  | NewtypeVariant : serde_core.de.Unexpected
+  | TupleVariant : serde_core.de.Unexpected
+  | StructVariant : serde_core.de.Unexpected
+  | Other : Str → serde_core.de.Unexpected
+
+/-- `serde_core::de::Expected` -/
+@[rust_trait "serde_core::de::Expected"]
+structure serde_core.de.Expected (Self : Type) where
+  fmt : Self → core.fmt.Formatter → core.fmt.Outcome
+
+/-- `&dyn Expected` (as Aeneas translates trait objects). -/
+abbrev serde_core.de.DynExpected := Dyn (fun T => serde_core.de.Expected T)
+
+namespace serde_core.de
+
+/-- `impl Display for dyn Expected`: `Expected::fmt(self, formatter)`. -/
+def DynExpected.fmt (exp : DynExpected) : core.fmt.Callback := exp.inst.fmt exp.value
+
+/-- `impl Expected for &str`: `formatter.write_str(self)`. -/
+@[rust_fun "serde_core::de::{serde_core::de::Expected<&'0 str>}::fmt"]
+def ExpectedSharedStr.fmt (s : Str) (formatter : core.fmt.Formatter) : core.fmt.Outcome :=
+  core.fmt.Formatter.write_str formatter s
+
+@[reducible, rust_trait_impl "serde_core::de::Expected<&'0 str>"]
+def ExpectedSharedStr : serde_core.de.Expected Str := ⟨ExpectedSharedStr.fmt⟩
+
+/-- `impl<'de, T: Visitor<'de>> Expected for T`: `self.expecting(formatter)`. -/
+def expectedOf {Self : Type} (expecting : Self → core.fmt.Formatter → core.fmt.Outcome)
+    (self : Self) : DynExpected :=
+  ⟨Self, ⟨expecting⟩, self⟩
+
+/-- `struct WithDecimalPoint(f64)`: a finite float written without a `.` gets `.0`. -/
+def withDecimalPoint (x : F64) : core.fmt.Callback := fun f =>
+  if x.isFinite then do
+    let (status, g) ← core.fmt.DisplayF64.fmt x { f with output := "" }
+    match status with
+    | .Err e => .ok (.Err e, { f with output := f.output ++ g.output })
+    | .Ok () =>
+      let text := g.output
+      core.fmt.thenFormat (f.append text) (fun f =>
+        if text.contains '.' then .ok (.Ok (), f) else f.append ".0")
+  else core.fmt.DisplayF64.fmt x f
+
+/-- `impl Display for Unexpected` -/
+def Unexpected.fmt (u : Unexpected) (f : core.fmt.Formatter) : core.fmt.Outcome :=
+  match u with
+  | .Bool b => writeArgs f (cat [lit "boolean `", core.fmt.DisplayBool.fmt b, lit "`"])
+  | .Unsigned i => writeArgs f (cat [lit "integer `", core.fmt.num.DisplayU64.fmt i, lit "`"])
+  | .Signed i => writeArgs f (cat [lit "integer `", core.fmt.num.DisplayI64.fmt i, lit "`"])
+  | .Float x => writeArgs f (cat [lit "floating point `", withDecimalPoint x, lit "`"])
+  | .Char c => writeArgs f (cat [lit "character `", fun f => f.pad (String.singleton c), lit "`"])
+  | .Str s => writeArgs f (cat [lit "string ", core.fmt.DebugStr.fmt s])
+  | .Bytes _ => f.append "byte array"
+  | .Unit => f.append "unit value"
+  | .Option => f.append "Option value"
+  | .NewtypeStruct => f.append "newtype struct"
+  | .Seq => f.append "sequence"
+  | .Map => f.append "map"
+  | .Enum => f.append "enum"
+  | .UnitVariant => f.append "unit variant"
+  | .NewtypeVariant => f.append "newtype variant"
+  | .TupleVariant => f.append "tuple variant"
+  | .StructVariant => f.append "struct variant"
+  | .Other other => do f.append (← core.fmt.decode other.val)
+
+/-- `struct OneOf { names }` and its `Display`. -/
+def oneOf (names : List Str) : core.fmt.Callback := fun f =>
+  match names with
+  | [] => .fail .panic
+  | [a] => writeArgs f (cat [lit "`", strArg a, lit "`"])
+  | [a, b] => writeArgs f (cat [lit "`", strArg a, lit "` or `", strArg b, lit "`"])
+  | _ =>
+    core.fmt.thenFormat (f.append "one of ") (fun f =>
+      cat ((names.zipIdx.map fun (alt, i) =>
+        cat [if i > 0 then lit ", " else cat [],
+             fun f => writeArgs f (cat [lit "`", strArg alt, lit "`"])])) f)
+
+end serde_core.de
+
+/-- `serde_core::de::Error`: the provided methods build their `format_args!` messages. -/
+@[rust_trait "serde_core::de::Error" (parentClauses := ["coreerrorErrorInst"])
+  (defaultMethods := ["invalid_type", "invalid_value", "invalid_length", "unknown_variant",
+    "unknown_field", "missing_field", "duplicate_field"])]
+structure serde_core.de.Error (Self : Type) where
+  coreerrorErrorInst : core.error.Error Self
+  custom : {T : Type} → core.fmt.Display T → T → Result Self
+  invalid_type : serde_core.de.Unexpected → serde_core.de.DynExpected → Result Self :=
+    fun unexp exp => custom displayMsg
+      (cat [lit "invalid type: ", unexp.fmt, lit ", expected ", exp.inst.fmt exp.value])
+  invalid_value : serde_core.de.Unexpected → serde_core.de.DynExpected → Result Self :=
+    fun unexp exp => custom displayMsg
+      (cat [lit "invalid value: ", unexp.fmt, lit ", expected ", exp.inst.fmt exp.value])
+  invalid_length : Usize → serde_core.de.DynExpected → Result Self :=
+    fun len exp => custom displayMsg
+      (cat [lit "invalid length ", core.fmt.num.DisplayUsize.fmt len, lit ", expected ",
+        exp.inst.fmt exp.value])
+  unknown_variant : Str → Slice Str → Result Self :=
+    fun variant expected =>
+      if expected.val.isEmpty then
+        custom displayMsg (cat [lit "unknown variant `", strArg variant,
+          lit "`, there are no variants"])
+      else
+        custom displayMsg (cat [lit "unknown variant `", strArg variant, lit "`, expected ",
+          serde_core.de.oneOf expected.val])
+  unknown_field : Str → Slice Str → Result Self :=
+    fun field expected =>
+      if expected.val.isEmpty then
+        custom displayMsg (cat [lit "unknown field `", strArg field,
+          lit "`, there are no fields"])
+      else
+        custom displayMsg (cat [lit "unknown field `", strArg field, lit "`, expected ",
+          serde_core.de.oneOf expected.val])
+  missing_field : Str → Result Self :=
+    fun field => custom displayMsg (cat [lit "missing field `", strArg field, lit "`"])
+  duplicate_field : Str → Result Self :=
+    fun field => custom displayMsg (cat [lit "duplicate field `", strArg field, lit "`"])
+
+namespace serde_core.de
+
+/-! ## The knot families -/
+
+/-- The data-side dictionaries at the format side's method-level bounds. `phantom` is
+    `impl<T: Deserialize> DeserializeSeed for PhantomData<T>` (`T::deserialize(deserializer)`), used
+    by the provided `next_element` & co. -/
+structure Fam : Type 2 where
+  Deserialize : Type → Type 1
+  Seed : Type → Type → Type 1
+  Visitor : Type → Type → Type 1
+  phantom : {T : Type} → Deserialize T → Seed Unit T
+
+/-- A morphism of knot families (the format side is contravariant in it, the data side covariant). -/
+structure Fam.Hom (Y X : Fam) where
+  deserialize : {T : Type} → Y.Deserialize T → X.Deserialize T
+  seed : {T Value : Type} → Y.Seed T Value → X.Seed T Value
+  visitor : {V Value : Type} → Y.Visitor V Value → X.Visitor V Value
+
+/-! ## Format side, relative to the knot family `X` -/
+
+section
+variable (X : Fam)
+
+def i128Unsupported {Value Error : Type} (errInst : serde_core.de.Error Error) (msg : String) :
+    Result (core.result.Result Value Error) := do
+  .ok (.Err (← errInst.custom core.fmt.DisplayStr (← Str.ofString msg)))
+
+structure DeserializerF (Self Error : Type) : Type 1 where
+  serde_coredeErrorInst : serde_core.de.Error Error
+  deserialize_any : {V Value : Type} → X.Visitor V Value → Self → V →
+    Result (core.result.Result Value Error)
+  deserialize_bool : {V Value : Type} → X.Visitor V Value → Self → V →
+    Result (core.result.Result Value Error)
+  deserialize_i8 : {V Value : Type} → X.Visitor V Value → Self → V →
+    Result (core.result.Result Value Error)
+  deserialize_i16 : {V Value : Type} → X.Visitor V Value → Self → V →
+    Result (core.result.Result Value Error)
+  deserialize_i32 : {V Value : Type} → X.Visitor V Value → Self → V →
+    Result (core.result.Result Value Error)
+  deserialize_i64 : {V Value : Type} → X.Visitor V Value → Self → V →
+    Result (core.result.Result Value Error)
+  /-- Provided: `let _ = visitor; Err(Error::custom("i128 is not supported"))`. -/
+  deserialize_i128 : {V Value : Type} → X.Visitor V Value → Self → V →
+    Result (core.result.Result Value Error) :=
+    fun _ _ _ => i128Unsupported serde_coredeErrorInst "i128 is not supported"
+  deserialize_u8 : {V Value : Type} → X.Visitor V Value → Self → V →
+    Result (core.result.Result Value Error)
+  deserialize_u16 : {V Value : Type} → X.Visitor V Value → Self → V →
+    Result (core.result.Result Value Error)
+  deserialize_u32 : {V Value : Type} → X.Visitor V Value → Self → V →
+    Result (core.result.Result Value Error)
+  deserialize_u64 : {V Value : Type} → X.Visitor V Value → Self → V →
+    Result (core.result.Result Value Error)
+  /-- Provided: `let _ = visitor; Err(Error::custom("u128 is not supported"))`. -/
+  deserialize_u128 : {V Value : Type} → X.Visitor V Value → Self → V →
+    Result (core.result.Result Value Error) :=
+    fun _ _ _ => i128Unsupported serde_coredeErrorInst "u128 is not supported"
+  deserialize_f32 : {V Value : Type} → X.Visitor V Value → Self → V →
+    Result (core.result.Result Value Error)
+  deserialize_f64 : {V Value : Type} → X.Visitor V Value → Self → V →
+    Result (core.result.Result Value Error)
+  deserialize_char : {V Value : Type} → X.Visitor V Value → Self → V →
+    Result (core.result.Result Value Error)
+  deserialize_str : {V Value : Type} → X.Visitor V Value → Self → V →
+    Result (core.result.Result Value Error)
+  deserialize_string : {V Value : Type} → X.Visitor V Value → Self → V →
+    Result (core.result.Result Value Error)
+  deserialize_bytes : {V Value : Type} → X.Visitor V Value → Self → V →
+    Result (core.result.Result Value Error)
+  deserialize_byte_buf : {V Value : Type} → X.Visitor V Value → Self → V →
+    Result (core.result.Result Value Error)
+  deserialize_option : {V Value : Type} → X.Visitor V Value → Self → V →
+    Result (core.result.Result Value Error)
+  deserialize_unit : {V Value : Type} → X.Visitor V Value → Self → V →
+    Result (core.result.Result Value Error)
+  deserialize_unit_struct : {V Value : Type} → X.Visitor V Value → Self → Str → V →
+    Result (core.result.Result Value Error)
+  deserialize_newtype_struct : {V Value : Type} → X.Visitor V Value → Self → Str → V →
+    Result (core.result.Result Value Error)
+  deserialize_seq : {V Value : Type} → X.Visitor V Value → Self → V →
+    Result (core.result.Result Value Error)
+  deserialize_tuple : {V Value : Type} → X.Visitor V Value → Self → Usize → V →
+    Result (core.result.Result Value Error)
+  deserialize_tuple_struct : {V Value : Type} → X.Visitor V Value → Self → Str → Usize → V →
+    Result (core.result.Result Value Error)
+  deserialize_map : {V Value : Type} → X.Visitor V Value → Self → V →
+    Result (core.result.Result Value Error)
+  deserialize_struct : {V Value : Type} → X.Visitor V Value → Self → Str → Slice Str → V →
+    Result (core.result.Result Value Error)
+  deserialize_enum : {V Value : Type} → X.Visitor V Value → Self → Str → Slice Str → V →
+    Result (core.result.Result Value Error)
+  deserialize_identifier : {V Value : Type} → X.Visitor V Value → Self → V →
+    Result (core.result.Result Value Error)
+  deserialize_ignored_any : {V Value : Type} → X.Visitor V Value → Self → V →
+    Result (core.result.Result Value Error)
+  /-- Provided: `true`. -/
+  is_human_readable : Self → Result Bool := fun _ => ok true
+
+structure SeqAccessF (Self Error : Type) : Type 1 where
+  serde_coredeErrorInst : serde_core.de.Error Error
+  next_element_seed : {T Value : Type} → X.Seed T Value → Self → T →
+    Result (core.result.Result (Option Value) Error × Self)
+  /-- Provided: `self.next_element_seed(PhantomData)`. -/
+  next_element : {T : Type} → X.Deserialize T → Self →
+    Result (core.result.Result (Option T) Error × Self) :=
+    fun d self => next_element_seed (X.phantom d) self ()
+  /-- Provided: `None`. -/
+  size_hint : Self → Result (Option Usize) := fun _ => ok none
+
+structure MapAccessF (Self Error : Type) : Type 1 where
+  serde_coredeErrorInst : serde_core.de.Error Error
+  next_key_seed : {K Value : Type} → X.Seed K Value → Self → K →
+    Result (core.result.Result (Option Value) Error × Self)
+  next_value_seed : {V Value : Type} → X.Seed V Value → Self → V →
+    Result (core.result.Result Value Error × Self)
+  /-- Provided: `next_key_seed(kseed)?` then, for a key, `next_value_seed(vseed)?`. -/
+  next_entry_seed : {K V KValue VValue : Type} → X.Seed K KValue → X.Seed V VValue → Self →
+    K → V → Result (core.result.Result (Option (KValue × VValue)) Error × Self) :=
+    fun kInst vInst self kseed vseed => do
+      let (r, self) ← next_key_seed kInst self kseed
+      match r with
+      | .Err e => ok (.Err e, self)
+      | .Ok none => ok (.Ok none, self)
+      | .Ok (some key) =>
+        let (r, self) ← next_value_seed vInst self vseed
+        match r with
+        | .Err e => ok (.Err e, self)
+        | .Ok value => ok (.Ok (some (key, value)), self)
+  /-- Provided: `self.next_key_seed(PhantomData)`. -/
+  next_key : {K : Type} → X.Deserialize K → Self →
+    Result (core.result.Result (Option K) Error × Self) :=
+    fun d self => next_key_seed (X.phantom d) self ()
+  /-- Provided: `self.next_value_seed(PhantomData)`. -/
+  next_value : {V : Type} → X.Deserialize V → Self →
+    Result (core.result.Result V Error × Self) :=
+    fun d self => next_value_seed (X.phantom d) self ()
+  /-- Provided: `self.next_entry_seed(PhantomData, PhantomData)`. -/
+  next_entry : {K V : Type} → X.Deserialize K → X.Deserialize V → Self →
+    Result (core.result.Result (Option (K × V)) Error × Self) :=
+    fun dk dv self => next_entry_seed (X.phantom dk) (X.phantom dv) self () ()
+  /-- Provided: `None`. -/
+  size_hint : Self → Result (Option Usize) := fun _ => ok none
+
+structure VariantAccessF (Self Error : Type) : Type 1 where
+  serde_coredeErrorInst : serde_core.de.Error Error
+  unit_variant : Self → Result (core.result.Result Unit Error)
+  newtype_variant_seed : {T Value : Type} → X.Seed T Value → Self → T →
+    Result (core.result.Result Value Error)
+  /-- Provided: `self.newtype_variant_seed(PhantomData)`. -/
+  newtype_variant : {T : Type} → X.Deserialize T → Self → Result (core.result.Result T Error) :=
+    fun d self => newtype_variant_seed (X.phantom d) self ()
+  tuple_variant : {V Value : Type} → X.Visitor V Value → Self → Usize → V →
+    Result (core.result.Result Value Error)
+  struct_variant : {V Value : Type} → X.Visitor V Value → Self → Slice Str → V →
+    Result (core.result.Result Value Error)
+
+structure EnumAccessF (Self Error Variant : Type) : Type 1 where
+  serde_coredeErrorInst : serde_core.de.Error Error
+  VariantAccessInst : VariantAccessF X Variant Error
+  variant_seed : {V Value : Type} → X.Seed V Value → Self → V →
+    Result (core.result.Result (Value × Variant) Error)
+  /-- Provided: `self.variant_seed(PhantomData)`. -/
+  variant : {V : Type} → X.Deserialize V → Self → Result (core.result.Result (V × Variant) Error) :=
+    fun d self => variant_seed (X.phantom d) self ()
+
+/-! ## Data side, relative to the knot family `X` -/
+
+structure DeserializeStep (Self : Type) : Type 1 where
+  deserialize : {D Error : Type} → DeserializerF X D Error → D →
+    Result (core.result.Result Self Error)
+
+structure SeedStep (Self Value : Type) : Type 1 where
+  deserialize : {D Error : Type} → DeserializerF X D Error → Self → D →
+    Result (core.result.Result Value Error)
+
+/-- `Err(Error::invalid_type(unexp, &self))` of the provided `visit_*` methods (`&self` as
+    `&dyn Expected`: `impl<T: Visitor> Expected for T` is `self.expecting(formatter)`). -/
+def invalidType {Self Value E : Type} (expecting : Self → core.fmt.Formatter → core.fmt.Outcome)
+    (errInst : serde_core.de.Error E) (self : Self) (unexp : serde_core.de.Unexpected) :
+    Result (core.result.Result Value E) := do
+  .ok (.Err (← errInst.invalid_type unexp (expectedOf expecting self)))
+
+structure VisitorStep (Self Value : Type) : Type 1 where
+  expecting : Self → core.fmt.Formatter → core.fmt.Outcome
+  visit_bool : {E : Type} → serde_core.de.Error E → Self → Bool →
+    Result (core.result.Result Value E) :=
+    fun e self v => invalidType expecting e self (.Bool v)
+  visit_i64 : {E : Type} → serde_core.de.Error E → Self → I64 →
+    Result (core.result.Result Value E) :=
+    fun e self v => invalidType expecting e self (.Signed v)
+  visit_i8 : {E : Type} → serde_core.de.Error E → Self → I8 →
+    Result (core.result.Result Value E) :=
+    fun e self v => visit_i64 e self (v.cast .I64)
+  visit_i16 : {E : Type} → serde_core.de.Error E → Self → I16 →
+    Result (core.result.Result Value E) :=
+    fun e self v => visit_i64 e self (v.cast .I64)
+  visit_i32 : {E : Type} → serde_core.de.Error E → Self → I32 →
+    Result (core.result.Result Value E) :=
+    fun e self v => visit_i64 e self (v.cast .I64)
+  visit_i128 : {E : Type} → serde_core.de.Error E → Self → I128 →
+    Result (core.result.Result Value E) :=
+    fun e self v => do
+      let text := "integer `" ++ toString v.val ++ "` as i128"
+      invalidType expecting e self (.Other (← Str.ofString text))
+  visit_u64 : {E : Type} → serde_core.de.Error E → Self → U64 →
+    Result (core.result.Result Value E) :=
+    fun e self v => invalidType expecting e self (.Unsigned v)
+  visit_u8 : {E : Type} → serde_core.de.Error E → Self → U8 →
+    Result (core.result.Result Value E) :=
+    fun e self v => visit_u64 e self (v.cast .U64)
+  visit_u16 : {E : Type} → serde_core.de.Error E → Self → U16 →
+    Result (core.result.Result Value E) :=
+    fun e self v => visit_u64 e self (v.cast .U64)
+  visit_u32 : {E : Type} → serde_core.de.Error E → Self → U32 →
+    Result (core.result.Result Value E) :=
+    fun e self v => visit_u64 e self (v.cast .U64)
+  visit_u128 : {E : Type} → serde_core.de.Error E → Self → U128 →
+    Result (core.result.Result Value E) :=
+    fun e self v => do
+      let text := "integer `" ++ toString v.val ++ "` as u128"
+      invalidType expecting e self (.Other (← Str.ofString text))
+  visit_f64 : {E : Type} → serde_core.de.Error E → Self → F64 →
+    Result (core.result.Result Value E) :=
+    fun e self v => invalidType expecting e self (.Float v)
+  visit_f32 : {E : Type} → serde_core.de.Error E → Self → F32 →
+    Result (core.result.Result Value E) :=
+    fun e self v => visit_f64 e self (F32.toF64 v)
+  visit_str : {E : Type} → serde_core.de.Error E → Self → Str →
+    Result (core.result.Result Value E) :=
+    fun e self v => invalidType expecting e self (.Str v)
+  visit_char : {E : Type} → serde_core.de.Error E → Self → Char →
+    Result (core.result.Result Value E) :=
+    fun e self v => do visit_str e self (← utf8 v)
+  visit_borrowed_str : {E : Type} → serde_core.de.Error E → Self → Str →
+    Result (core.result.Result Value E) :=
+    fun e self v => visit_str e self v
+  visit_string : {E : Type} → serde_core.de.Error E → Self → String →
+    Result (core.result.Result Value E) :=
+    fun e self v => do visit_str e self (← Str.ofString v)
+  visit_bytes : {E : Type} → serde_core.de.Error E → Self → Slice U8 →
+    Result (core.result.Result Value E) :=
+    fun e self v => invalidType expecting e self (.Bytes v)
+  visit_borrowed_bytes : {E : Type} → serde_core.de.Error E → Self → Slice U8 →
+    Result (core.result.Result Value E) :=
+    fun e self v => visit_bytes e self v
+  visit_byte_buf : {E : Type} → serde_core.de.Error E → Self → alloc.vec.Vec U8 →
+    Result (core.result.Result Value E) :=
+    fun e self v => visit_bytes e self v
+  visit_none : {E : Type} → serde_core.de.Error E → Self → Result (core.result.Result Value E) :=
+    fun e self => invalidType expecting e self .Option
+  visit_some : {D Error : Type} → DeserializerF X D Error → Self → D →
+    Result (core.result.Result Value Error) :=
+    fun d self _ => invalidType expecting d.serde_coredeErrorInst self .Option
+  visit_unit : {E : Type} → serde_core.de.Error E → Self → Result (core.result.Result Value E) :=
+    fun e self => invalidType expecting e self .Unit
+  visit_newtype_struct : {D Error : Type} → DeserializerF X D Error → Self → D →
+    Result (core.result.Result Value Error) :=
+    fun d self _ => invalidType expecting d.serde_coredeErrorInst self .NewtypeStruct
+  visit_seq : {A Error : Type} → SeqAccessF X A Error → Self → A →
+    Result (core.result.Result Value Error) :=
+    fun a self _ => invalidType expecting a.serde_coredeErrorInst self .Seq
+  visit_map : {A Error : Type} → MapAccessF X A Error → Self → A →
+    Result (core.result.Result Value Error) :=
+    fun a self _ => invalidType expecting a.serde_coredeErrorInst self .Map
+  visit_enum : {A Error Variant : Type} → EnumAccessF X A Error Variant → Self → A →
+    Result (core.result.Result Value Error) :=
+    fun a self _ => invalidType expecting a.serde_coredeErrorInst self .Enum
+
+/-- One level up: the data side over the format side at `X`. -/
+def Step (X : Fam) : Fam where
+  Deserialize := DeserializeStep X
+  Seed := SeedStep X
+  Visitor := VisitorStep X
+  phantom := fun d => ⟨fun inst _ de => d.deserialize inst de⟩
+
+end
+
+/-! ## Maps along a morphism of knot families -/
+
+section map
+variable {X Y : Fam} (g : Fam.Hom Y X)
+
+def DeserializerF.map {Self Error : Type} (d : DeserializerF X Self Error) :
+    DeserializerF Y Self Error :=
+  { serde_coredeErrorInst := d.serde_coredeErrorInst
+    deserialize_any := fun v => d.deserialize_any (g.visitor v)
+    deserialize_bool := fun v => d.deserialize_bool (g.visitor v)
+    deserialize_i8 := fun v => d.deserialize_i8 (g.visitor v)
+    deserialize_i16 := fun v => d.deserialize_i16 (g.visitor v)
+    deserialize_i32 := fun v => d.deserialize_i32 (g.visitor v)
+    deserialize_i64 := fun v => d.deserialize_i64 (g.visitor v)
+    deserialize_i128 := fun v => d.deserialize_i128 (g.visitor v)
+    deserialize_u8 := fun v => d.deserialize_u8 (g.visitor v)
+    deserialize_u16 := fun v => d.deserialize_u16 (g.visitor v)
+    deserialize_u32 := fun v => d.deserialize_u32 (g.visitor v)
+    deserialize_u64 := fun v => d.deserialize_u64 (g.visitor v)
+    deserialize_u128 := fun v => d.deserialize_u128 (g.visitor v)
+    deserialize_f32 := fun v => d.deserialize_f32 (g.visitor v)
+    deserialize_f64 := fun v => d.deserialize_f64 (g.visitor v)
+    deserialize_char := fun v => d.deserialize_char (g.visitor v)
+    deserialize_str := fun v => d.deserialize_str (g.visitor v)
+    deserialize_string := fun v => d.deserialize_string (g.visitor v)
+    deserialize_bytes := fun v => d.deserialize_bytes (g.visitor v)
+    deserialize_byte_buf := fun v => d.deserialize_byte_buf (g.visitor v)
+    deserialize_option := fun v => d.deserialize_option (g.visitor v)
+    deserialize_unit := fun v => d.deserialize_unit (g.visitor v)
+    deserialize_unit_struct := fun v => d.deserialize_unit_struct (g.visitor v)
+    deserialize_newtype_struct := fun v => d.deserialize_newtype_struct (g.visitor v)
+    deserialize_seq := fun v => d.deserialize_seq (g.visitor v)
+    deserialize_tuple := fun v => d.deserialize_tuple (g.visitor v)
+    deserialize_tuple_struct := fun v => d.deserialize_tuple_struct (g.visitor v)
+    deserialize_map := fun v => d.deserialize_map (g.visitor v)
+    deserialize_struct := fun v => d.deserialize_struct (g.visitor v)
+    deserialize_enum := fun v => d.deserialize_enum (g.visitor v)
+    deserialize_identifier := fun v => d.deserialize_identifier (g.visitor v)
+    deserialize_ignored_any := fun v => d.deserialize_ignored_any (g.visitor v)
+    is_human_readable := d.is_human_readable }
+
+def SeqAccessF.map {Self Error : Type} (d : SeqAccessF X Self Error) : SeqAccessF Y Self Error :=
+  { serde_coredeErrorInst := d.serde_coredeErrorInst
+    next_element_seed := fun s => d.next_element_seed (g.seed s)
+    next_element := fun t => d.next_element (g.deserialize t)
+    size_hint := d.size_hint }
+
+def MapAccessF.map {Self Error : Type} (d : MapAccessF X Self Error) : MapAccessF Y Self Error :=
+  { serde_coredeErrorInst := d.serde_coredeErrorInst
+    next_key_seed := fun s => d.next_key_seed (g.seed s)
+    next_value_seed := fun s => d.next_value_seed (g.seed s)
+    next_entry_seed := fun k v => d.next_entry_seed (g.seed k) (g.seed v)
+    next_key := fun t => d.next_key (g.deserialize t)
+    next_value := fun t => d.next_value (g.deserialize t)
+    next_entry := fun k v => d.next_entry (g.deserialize k) (g.deserialize v)
+    size_hint := d.size_hint }
+
+def VariantAccessF.map {Self Error : Type} (d : VariantAccessF X Self Error) :
+    VariantAccessF Y Self Error :=
+  { serde_coredeErrorInst := d.serde_coredeErrorInst
+    unit_variant := d.unit_variant
+    newtype_variant_seed := fun s => d.newtype_variant_seed (g.seed s)
+    newtype_variant := fun t => d.newtype_variant (g.deserialize t)
+    tuple_variant := fun v => d.tuple_variant (g.visitor v)
+    struct_variant := fun v => d.struct_variant (g.visitor v) }
+
+def EnumAccessF.map {Self Error Variant : Type} (d : EnumAccessF X Self Error Variant) :
+    EnumAccessF Y Self Error Variant :=
+  { serde_coredeErrorInst := d.serde_coredeErrorInst
+    VariantAccessInst := d.VariantAccessInst.map g
+    variant_seed := fun s => d.variant_seed (g.seed s)
+    variant := fun t => d.variant (g.deserialize t) }
+
+def DeserializeStep.map {Self : Type} (d : DeserializeStep Y Self) : DeserializeStep X Self :=
+  ⟨fun inst de => d.deserialize (inst.map g) de⟩
+
+def SeedStep.map {Self Value : Type} (d : SeedStep Y Self Value) : SeedStep X Self Value :=
+  ⟨fun inst self de => d.deserialize (inst.map g) self de⟩
+
+def VisitorStep.map {Self Value : Type} (d : VisitorStep Y Self Value) : VisitorStep X Self Value :=
+  { expecting := d.expecting
+    visit_bool := d.visit_bool, visit_i64 := d.visit_i64, visit_i8 := d.visit_i8
+    visit_i16 := d.visit_i16, visit_i32 := d.visit_i32, visit_i128 := d.visit_i128
+    visit_u64 := d.visit_u64, visit_u8 := d.visit_u8, visit_u16 := d.visit_u16
+    visit_u32 := d.visit_u32, visit_u128 := d.visit_u128, visit_f64 := d.visit_f64
+    visit_f32 := d.visit_f32, visit_str := d.visit_str, visit_char := d.visit_char
+    visit_borrowed_str := d.visit_borrowed_str, visit_string := d.visit_string
+    visit_bytes := d.visit_bytes, visit_borrowed_bytes := d.visit_borrowed_bytes
+    visit_byte_buf := d.visit_byte_buf, visit_none := d.visit_none
+    visit_some := fun inst => d.visit_some (inst.map g)
+    visit_unit := d.visit_unit
+    visit_newtype_struct := fun inst => d.visit_newtype_struct (inst.map g)
+    visit_seq := fun inst => d.visit_seq (inst.map g)
+    visit_map := fun inst => d.visit_map (inst.map g)
+    visit_enum := fun inst => d.visit_enum (inst.map g) }
+
+/-- A morphism one level up. -/
+def Fam.Hom.step (g : Fam.Hom Y X) : Fam.Hom (Step Y) (Step X) where
+  deserialize := fun d => d.map g
+  seed := fun d => d.map g
+  visitor := fun d => d.map g
+end map
+
+/-! ## Levels and the limit -/
+
+/-- The data-side dictionaries usable with formats nesting at most `n` data-side calls. -/
+def DeAt : Nat → Fam
+  | 0 => ⟨fun _ => PUnit, fun _ _ => PUnit, fun _ _ => PUnit, fun _ => PUnit.unit⟩
+  | n + 1 => Step (DeAt n)
+
+structure DeserializeΩ (T : Type) : Type 1 where
+  level : ∀ n, (DeAt n).Deserialize T
+
+structure SeedΩ (T Value : Type) : Type 1 where
+  level : ∀ n, (DeAt n).Seed T Value
+
+structure VisitorΩ (V Value : Type) : Type 1 where
+  level : ∀ n, (DeAt n).Visitor V Value
+
+/-- The knot positions of the Rust format side: data-side dictionaries at every level. -/
+@[reducible] def Ω : Fam where
+  Deserialize := DeserializeΩ
+  Seed := SeedΩ
+  Visitor := VisitorΩ
+  phantom := fun d => ⟨fun n => (DeAt n).phantom (d.level n)⟩
+
+/-- The projection of the limit to level `n`. -/
+def proj (n : Nat) : Fam.Hom Ω (DeAt n) where
+  deserialize := fun d => d.level n
+  seed := fun d => d.level n
+  visitor := fun d => d.level n
+
+end serde_core.de
+
