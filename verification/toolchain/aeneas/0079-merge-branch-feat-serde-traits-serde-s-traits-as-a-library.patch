+/-! ## The knot -/
+
+def Deserialize.wrap {T : Type} (d : serde_core.de.Deserialize T) : DeserializeΩ T :=
+  ⟨fun n => match n with
+    | 0 => PUnit.unit
+    | n + 1 => DeserializeStep.map (proj n) d⟩
+
+def DeserializeSeed.wrap {T Value : Type} (d : serde_core.de.DeserializeSeed T Value) :
+    SeedΩ T Value :=
+  ⟨fun n => match n with
+    | 0 => PUnit.unit
+    | n + 1 => SeedStep.map (proj n) d⟩
+
+def Visitor.wrap {V Value : Type} (d : serde_core.de.Visitor V Value) : VisitorΩ V Value :=
+  ⟨fun n => match n with
+    | 0 => PUnit.unit
+    | n + 1 => VisitorStep.map (proj n) d⟩
+
+/-- The knot is definitional: at level `n + 1` a wrapped dictionary runs against the level-`n`
+    formats. -/
+theorem Deserialize.wrap_level_succ {T : Type} (d : serde_core.de.Deserialize T) (n : Nat) :
+    (Deserialize.wrap d).level (n + 1) = DeserializeStep.map (proj n) d := rfl
+
+theorem DeserializeSeed.wrap_level_succ {T Value : Type} (d : serde_core.de.DeserializeSeed T Value)
+    (n : Nat) : (DeserializeSeed.wrap d).level (n + 1) = SeedStep.map (proj n) d := rfl
+
+theorem Visitor.wrap_level_succ {V Value : Type} (d : serde_core.de.Visitor V Value) (n : Nat) :
+    (Visitor.wrap d).level (n + 1) = VisitorStep.map (proj n) d := rfl
+
+/-! ## Every Rust format has an encoding -/
+
+/-- The types of a Rust format: its deserializers, sequence/map/enum/variant access types (each
+    family indexed by its own index type) with their associated types. -/
+structure FormatTypes where
+  ιD : Type
+  D : ιD → Type
+  DError : ιD → Type
+  ιS : Type
+  S : ιS → Type
+  SError : ιS → Type
+  ιM : Type
+  M : ιM → Type
+  MError : ιM → Type
+  ιE : Type
+  E : ιE → Type
+  EError : ιE → Type
+  EVariant : ιE → Type
+  ιV : Type
+  V : ιV → Type
+  VError : ιV → Type
+
+/-- The format-side dictionaries of the family at the knot family `X`. -/
+structure FormatTypes.Dicts (τ : FormatTypes) (X : Fam) : Type 1 where
+  des : ∀ i, DeserializerF X (τ.D i) (τ.DError i)
+  seqs : ∀ i, SeqAccessF X (τ.S i) (τ.SError i)
+  maps : ∀ i, MapAccessF X (τ.M i) (τ.MError i)
+  enums : ∀ i, EnumAccessF X (τ.E i) (τ.EError i) (τ.EVariant i)
+  variants : ∀ i, VariantAccessF X (τ.V i) (τ.VError i)
+
+/-- A Rust format: its dictionaries, generic in the knot family, given the family's dictionaries one
+    level down. A received `X'.Visitor` (resp. seed, `Deserialize`) at `X' = Step X` can only be run
+    against format-side dictionaries at `X`: the family one level down, or dictionaries built from
+    it, as a Rust format calls `visitor.visit_seq(access)` or `seed.deserialize(sub)`. -/
+structure FormatProgram (τ : FormatTypes) where
+  base : τ.Dicts (DeAt 0)
+  step : ∀ (X : Fam), τ.Dicts X → τ.Dicts (Step X)
+
+def FormatProgram.level {τ : FormatTypes} (p : FormatProgram τ) : (n : Nat) → τ.Dicts (DeAt n)
+  | 0 => p.base
+  | n + 1 => p.step (DeAt n) (p.level n)
+
+/-- The encoded deserializers of a Rust format, with nesting bound `n`. -/
+def FormatProgram.encode {τ : FormatTypes} (p : FormatProgram τ) (n : Nat) (i : τ.ιD) :
+    serde_core.de.Deserializer (τ.D i) (τ.DError i) :=
+  ((p.level n).des i).map (proj n)
+
+def FormatProgram.encodeSeq {τ : FormatTypes} (p : FormatProgram τ) (n : Nat) (i : τ.ιS) :
+    serde_core.de.SeqAccess (τ.S i) (τ.SError i) :=
+  ((p.level n).seqs i).map (proj n)
+
+def FormatProgram.encodeMap {τ : FormatTypes} (p : FormatProgram τ) (n : Nat) (i : τ.ιM) :
+    serde_core.de.MapAccess (τ.M i) (τ.MError i) :=
+  ((p.level n).maps i).map (proj n)
+
+def FormatProgram.encodeEnum {τ : FormatTypes} (p : FormatProgram τ) (n : Nat) (i : τ.ιE) :
+    serde_core.de.EnumAccess (τ.E i) (τ.EError i) (τ.EVariant i) :=
+  ((p.level n).enums i).map (proj n)
+
+/-- The encoded format at bound `n + 1` is the program's step over the level-`n` family, with the
+    nested dictionaries projected to level `n + 1`. -/
+theorem FormatProgram.encode_succ {τ : FormatTypes} (p : FormatProgram τ) (n : Nat) (i : τ.ιD) :
+    p.encode (n + 1) i = ((p.step (DeAt n) (p.level n)).des i).map (proj (n + 1)) := rfl
+
+/-- A received wrapped visitor, run with an access dictionary of the family one level down, runs
+    the Rust visitor with that access dictionary's encoding: the Rust semantics of
+    `visitor.visit_seq(access)` inside a format. -/
+theorem FormatProgram.visit_seq_wrap {τ : FormatTypes} (p : FormatProgram τ) {V Value : Type}
+    (d : serde_core.de.Visitor V Value) (n : Nat) (j : τ.ιS) :
+    ((Visitor.wrap d).level (n + 1)).visit_seq ((p.level n).seqs j) =
+      d.visit_seq (p.encodeSeq n j) := rfl
+
+theorem FormatProgram.visit_map_wrap {τ : FormatTypes} (p : FormatProgram τ) {V Value : Type}
+    (d : serde_core.de.Visitor V Value) (n : Nat) (j : τ.ιM) :
+    ((Visitor.wrap d).level (n + 1)).visit_map ((p.level n).maps j) =
+      d.visit_map (p.encodeMap n j) := rfl
+
+theorem FormatProgram.visit_enum_wrap {τ : FormatTypes} (p : FormatProgram τ) {V Value : Type}
+    (d : serde_core.de.Visitor V Value) (n : Nat) (j : τ.ιE) :
+    ((Visitor.wrap d).level (n + 1)).visit_enum ((p.level n).enums j) =
+      d.visit_enum (p.encodeEnum n j) := rfl
+
+theorem FormatProgram.visit_some_wrap {τ : FormatTypes} (p : FormatProgram τ) {V Value : Type}
+    (d : serde_core.de.Visitor V Value) (n : Nat) (j : τ.ιD) :
+    ((Visitor.wrap d).level (n + 1)).visit_some ((p.level n).des j) =
+      d.visit_some (p.encode n j) := rfl
+
+/-- `seed.deserialize(sub)` / `T::deserialize(sub)` inside a format. -/
+theorem FormatProgram.seed_wrap {τ : FormatTypes} (p : FormatProgram τ) {T Value : Type}
+    (d : serde_core.de.DeserializeSeed T Value) (n : Nat) (j : τ.ιD) :
+    ((DeserializeSeed.wrap d).level (n + 1)).deserialize ((p.level n).des j) =
+      d.deserialize (p.encode n j) := rfl
+
+theorem FormatProgram.deserialize_wrap {τ : FormatTypes} (p : FormatProgram τ) {T : Type}
+    (d : serde_core.de.Deserialize T) (n : Nat) (j : τ.ιD) :
+    ((Deserialize.wrap d).level (n + 1)).deserialize ((p.level n).des j) =
+      d.deserialize (p.encode n j) := rfl
+
+/-- An error type's dictionary whose methods diverge. -/
+def bottomError (Error : Type) : serde_core.de.Error Error :=
+  { coreerrorErrorInst := ⟨⟨fun _ _ => .div⟩, ⟨fun _ _ => .div⟩⟩, custom := fun _ _ => .div }
+
+/-- Every family of format types has a program (e.g. the one whose methods diverge): the
+    `Deserializer` dictionaries of statements about data-side implementations are never vacuous. -/
+def bottom (X : Fam) (τ : FormatTypes) : τ.Dicts X where
+  des := fun i =>
+    { serde_coredeErrorInst := bottomError (τ.DError i)
+      deserialize_any := fun _ _ _ => .div, deserialize_bool := fun _ _ _ => .div
+      deserialize_i8 := fun _ _ _ => .div, deserialize_i16 := fun _ _ _ => .div
+      deserialize_i32 := fun _ _ _ => .div, deserialize_i64 := fun _ _ _ => .div
+      deserialize_u8 := fun _ _ _ => .div, deserialize_u16 := fun _ _ _ => .div
+      deserialize_u32 := fun _ _ _ => .div, deserialize_u64 := fun _ _ _ => .div
+      deserialize_f32 := fun _ _ _ => .div, deserialize_f64 := fun _ _ _ => .div
+      deserialize_char := fun _ _ _ => .div, deserialize_str := fun _ _ _ => .div
+      deserialize_string := fun _ _ _ => .div, deserialize_bytes := fun _ _ _ => .div
+      deserialize_byte_buf := fun _ _ _ => .div, deserialize_option := fun _ _ _ => .div
+      deserialize_unit := fun _ _ _ => .div, deserialize_unit_struct := fun _ _ _ _ => .div
+      deserialize_newtype_struct := fun _ _ _ _ => .div, deserialize_seq := fun _ _ _ => .div
+      deserialize_tuple := fun _ _ _ _ => .div, deserialize_tuple_struct := fun _ _ _ _ _ => .div
+      deserialize_map := fun _ _ _ => .div, deserialize_struct := fun _ _ _ _ _ => .div
+      deserialize_enum := fun _ _ _ _ _ => .div, deserialize_identifier := fun _ _ _ => .div
+      deserialize_ignored_any := fun _ _ _ => .div }
+  seqs := fun i => { serde_coredeErrorInst := bottomError (τ.SError i),
+                     next_element_seed := fun _ _ _ => .div }
+  maps := fun i => { serde_coredeErrorInst := bottomError (τ.MError i),
+                     next_key_seed := fun _ _ _ => .div, next_value_seed := fun _ _ _ => .div }
+  enums := fun i => { serde_coredeErrorInst := bottomError (τ.EError i),
+                      VariantAccessInst := { serde_coredeErrorInst := bottomError (τ.EError i),
+                                             unit_variant := fun _ => .div,
+                                             newtype_variant_seed := fun _ _ _ => .div,
+                                             tuple_variant := fun _ _ _ _ => .div,
+                                             struct_variant := fun _ _ _ _ => .div },
+                      variant_seed := fun _ _ _ => .div }
+  variants := fun i => { serde_coredeErrorInst := bottomError (τ.VError i),
+                         unit_variant := fun _ => .div, newtype_variant_seed := fun _ _ _ => .div,
+                         tuple_variant := fun _ _ _ _ => .div, struct_variant := fun _ _ _ _ => .div }
+
+end serde_core.de
+
+end Aeneas.Std
