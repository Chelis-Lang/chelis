+//! The serde traits, a recursive trait group (`Serialize::serialize<S: Serializer>`,
+//! `SerializeMap::serialize_key<T: Serialize>`, `Deserializer::deserialize_map<V: Visitor>`,
+//! `MapAccess::next_key<K: Deserialize>`, ...), through the library model of `serde_core`
+//! (`Aeneas/Std/Serde`): the dictionaries passed at the format side's method-level bounds are
+//! wrapped with the group's knot.
+//!
+//! `Pairs` is a map with unique keys (as `chelis_unord::UnordMap`): serialized as a map,
+//! deserialized by a visitor over a map that rejects a repeated key. `Entry` has the hand-written
+//! form of `#[derive(Serialize, Deserialize)]` with `deny_unknown_fields` (a `Field` identifier
+//! with its visitor, a struct visitor over a map and over a sequence, `Error::invalid_length` and
+//! `Error::invalid_value` with a `&dyn Expected` built from a `&str`).
+//!
+//! `SerdeVisitors/Checks.lean` runs these implementations against the in-test format of the
+//! `native` test module (a value tree), encoded as a `FormatProgram`, and compares with the native
+//! results.
+
+use serde::de::{self, Deserialize, Deserializer, MapAccess, SeqAccess, Visitor};
+use serde::ser::{Serialize, SerializeMap, SerializeStruct, Serializer};
+use std::fmt;
+use std::marker::PhantomData;
+
+/// A map with unique keys, in insertion order.
+pub struct Pairs<K, V>(pub Vec<(K, V)>);
+
+fn contains_key<K: PartialEq, V>(pairs: &Vec<(K, V)>, key: &K) -> bool {
+    let mut i = 0;
+    while i < pairs.len() {
+        if pairs[i].0 == *key {
+            return true;
+        }
+        i += 1;
+    }
+    false
+}
+
+impl<K: Serialize, V: Serialize> Serialize for Pairs<K, V> {
+    fn serialize<S: Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
+        let mut map = serializer.serialize_map(Some(self.0.len()))?;
+        let mut i = 0;
+        while i < self.0.len() {
+            map.serialize_entry(&self.0[i].0, &self.0[i].1)?;
+            i += 1;
+        }
+        map.end()
+    }
+}
+
+struct PairsVisitor<K, V>(PhantomData<fn() -> (K, V)>);
+
+impl<'de, K, V> Visitor<'de> for PairsVisitor<K, V>
+where
+    K: Deserialize<'de> + PartialEq,
+    V: Deserialize<'de>,
+{
+    type Value = Pairs<K, V>;
+
+    fn expecting(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        formatter.write_str("a map with unique keys")
+    }
+
+    fn visit_map<A: MapAccess<'de>>(self, mut map: A) -> Result<Self::Value, A::Error> {
+        let mut result: Vec<(K, V)> = Vec::new();
+        while let Some(key) = map.next_key::<K>()? {
+            if contains_key(&result, &key) {
+                return Err(de::Error::custom("duplicate key"));
+            }
+            let value = map.next_value::<V>()?;
+            result.push((key, value));
+        }
+        Ok(Pairs(result))
+    }
+}
+
+impl<'de, K, V> Deserialize<'de> for Pairs<K, V>
+where
+    K: Deserialize<'de> + PartialEq,
+    V: Deserialize<'de>,
+{
+    fn deserialize<D: Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+        deserializer.deserialize_map(PairsVisitor(PhantomData))
+    }
+}
+
+/// A struct with the hand-written form of its serde derives.
+pub struct Entry {
+    pub id: u32,
+    pub name: String,
+    pub pairs: Pairs<u32, u32>,
+}
+
+const FIELDS: &[&str] = &["id", "name", "pairs"];
+
+impl Serialize for Entry {
+    fn serialize<S: Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
+        let mut state = serializer.serialize_struct("Entry", 3)?;
+        state.serialize_field("id", &self.id)?;
+        state.serialize_field("name", &self.name)?;
+        state.serialize_field("pairs", &self.pairs)?;
+        state.end()
+    }
+}
+
+enum Field {
+    Id,
+    Name,
+    Pairs,
+}
+
+struct FieldVisitor;
+
+impl<'de> Visitor<'de> for FieldVisitor {
+    type Value = Field;
+
+    fn expecting(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        formatter.write_str("field identifier")
+    }
+
+    fn visit_u64<E: de::Error>(self, value: u64) -> Result<Field, E> {
+        match value {
+            0 => Ok(Field::Id),
+            1 => Ok(Field::Name),
+            2 => Ok(Field::Pairs),
+            _ => Err(E::invalid_value(de::Unexpected::Unsigned(value), &"field index 0 <= i < 3")),
+        }
+    }
+
+    fn visit_str<E: de::Error>(self, value: &str) -> Result<Field, E> {
+        match value {
+            "id" => Ok(Field::Id),
+            "name" => Ok(Field::Name),
+            "pairs" => Ok(Field::Pairs),
+            _ => Err(E::unknown_field(value, FIELDS)),
+        }
+    }
+}
+
+impl<'de> Deserialize<'de> for Field {
+    fn deserialize<D: Deserializer<'de>>(deserializer: D) -> Result<Field, D::Error> {
+        deserializer.deserialize_identifier(FieldVisitor)
+    }
+}
+
+struct EntryVisitor;
+
+impl<'de> Visitor<'de> for EntryVisitor {
+    type Value = Entry;
+
+    fn expecting(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        formatter.write_str("struct Entry")
+    }
+
+    fn visit_seq<A: SeqAccess<'de>>(self, mut seq: A) -> Result<Entry, A::Error> {
+        let id = match seq.next_element::<u32>()? {
+            Some(value) => value,
+            None => return Err(de::Error::invalid_length(0, &"struct Entry with 3 elements")),
+        };
+        let name = match seq.next_element::<String>()? {
+            Some(value) => value,
+            None => return Err(de::Error::invalid_length(1, &"struct Entry with 3 elements")),
+        };
+        let pairs = match seq.next_element::<Pairs<u32, u32>>()? {
+            Some(value) => value,
+            None => return Err(de::Error::invalid_length(2, &"struct Entry with 3 elements")),
+        };
+        Ok(Entry { id, name, pairs })
+    }
+
+    fn visit_map<A: MapAccess<'de>>(self, mut map: A) -> Result<Entry, A::Error> {
+        let mut id: Option<u32> = None;
+        let mut name: Option<String> = None;
+        let mut pairs: Option<Pairs<u32, u32>> = None;
+        while let Some(key) = map.next_key::<Field>()? {
+            match key {
+                Field::Id => {
+                    if id.is_some() {
+                        return Err(de::Error::duplicate_field("id"));
+                    }
+                    id = Some(map.next_value::<u32>()?);
+                }
+                Field::Name => {
+                    if name.is_some() {
+                        return Err(de::Error::duplicate_field("name"));
+                    }
+                    name = Some(map.next_value::<String>()?);
+                }
+                Field::Pairs => {
+                    if pairs.is_some() {
+                        return Err(de::Error::duplicate_field("pairs"));
+                    }
+                    pairs = Some(map.next_value::<Pairs<u32, u32>>()?);
+                }
+            }
+        }
+        let id = match id {
+            Some(id) => id,
+            None => return Err(de::Error::missing_field("id")),
+        };
+        let name = match name {
+            Some(name) => name,
+            None => return Err(de::Error::missing_field("name")),
+        };
+        let pairs = match pairs {
+            Some(pairs) => pairs,
+            None => return Err(de::Error::missing_field("pairs")),
+        };
+        Ok(Entry { id, name, pairs })
+    }
+}
+
+impl<'de> Deserialize<'de> for Entry {
+    fn deserialize<D: Deserializer<'de>>(deserializer: D) -> Result<Entry, D::Error> {
+        deserializer.deserialize_struct("Entry", FIELDS, EntryVisitor)
+    }
+}
