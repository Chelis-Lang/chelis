+    pub struct ValueDe(pub Value);
+    pub struct SeqDe(std::vec::IntoIter<Value>);
+    pub struct MapDe {
+        entries: std::vec::IntoIter<(Value, Value)>,
+        value: Option<Value>,
+    }
+
+    impl<'de> Deserializer<'de> for ValueDe {
+        type Error = TestError;
+
+        fn deserialize_any<V: Visitor<'de>>(self, visitor: V) -> Result<V::Value, TestError> {
+            match self.0 {
+                U32(v) => visitor.visit_u32(v),
+                Str(s) => visitor.visit_str(&s),
+                Seq(items) => visitor.visit_seq(SeqDe(items.into_iter())),
+                Map(entries) => visitor.visit_map(MapDe { entries: entries.into_iter(), value: None }),
+                Struct(_, fields) => {
+                    let entries: Vec<(Value, Value)> =
+                        fields.into_iter().map(|(k, v)| (Str(k.to_string()), v)).collect();
+                    visitor.visit_map(MapDe { entries: entries.into_iter(), value: None })
+                }
+            }
+        }
+
+        serde::forward_to_deserialize_any! {
+            bool i8 i16 i32 i64 i128 u8 u16 u32 u64 u128 f32 f64 char str string
+            bytes byte_buf option unit unit_struct newtype_struct seq tuple
+            tuple_struct map struct enum identifier ignored_any
+        }
+    }
+
+    impl<'de> SeqAccess<'de> for SeqDe {
+        type Error = TestError;
+        fn next_element_seed<T: DeserializeSeed<'de>>(
+            &mut self, seed: T,
+        ) -> Result<Option<T::Value>, TestError> {
+            match self.0.next() {
+                Some(v) => seed.deserialize(ValueDe(v)).map(Some),
+                None => Ok(None),
+            }
+        }
+    }
+
+    impl<'de> MapAccess<'de> for MapDe {
+        type Error = TestError;
+        fn next_key_seed<K: DeserializeSeed<'de>>(
+            &mut self, seed: K,
+        ) -> Result<Option<K::Value>, TestError> {
+            match self.entries.next() {
+                Some((k, v)) => {
+                    self.value = Some(v);
+                    seed.deserialize(ValueDe(k)).map(Some)
+                }
+                None => Ok(None),
+            }
+        }
+        fn next_value_seed<V: DeserializeSeed<'de>>(
+            &mut self, seed: V,
+        ) -> Result<V::Value, TestError> {
+            match self.value.take() {
+                Some(v) => seed.deserialize(ValueDe(v)),
+                None => Err(TestError("value missing".to_string())),
+            }
+        }
+    }
+
+    fn ser<T: Serialize>(v: &T) -> Result<Value, TestError> {
+        v.serialize(ValueSer)
+    }
+
+    fn de_pairs(v: Value) -> Result<Vec<(u32, u32)>, TestError> {
+        Pairs::<u32, u32>::deserialize(ValueDe(v)).map(|p| p.0)
+    }
+
+    fn de_entry(v: Value) -> Result<(u32, String, Vec<(u32, u32)>), TestError> {
+        Entry::deserialize(ValueDe(v)).map(|e| (e.id, e.name, e.pairs.0))
+    }
+
+    fn err(msg: &str) -> TestError {
+        TestError(msg.to_string())
+    }
+
+    fn entry() -> Entry {
+        Entry { id: 7, name: "ab".to_string(), pairs: Pairs(vec![(3, 4)]) }
+    }
+
+    fn entry_value() -> Value {
+        Struct("Entry", vec![
+            ("id", U32(7)),
+            ("name", Str("ab".to_string())),
+            ("pairs", Map(vec![(U32(3), U32(4))])),
+        ])
+    }
+
+    #[test]
+    fn serialize() {
+        assert_eq!(
+            ser(&Pairs(vec![(1u32, 10u32), (2, 20)])),
+            Ok(Map(vec![(U32(1), U32(10)), (U32(2), U32(20))]))
+        );
+        assert_eq!(ser(&Pairs::<u32, u32>(vec![])), Ok(Map(vec![])));
+        assert_eq!(ser(&entry()), Ok(entry_value()));
+    }
+
+    #[test]
+    fn deserialize_pairs() {
+        assert_eq!(
+            de_pairs(Map(vec![(U32(1), U32(10)), (U32(2), U32(20))])),
+            Ok(vec![(1, 10), (2, 20)])
+        );
+        assert_eq!(
+            de_pairs(Map(vec![(U32(1), U32(10)), (U32(1), U32(20))])),
+            Err(err("duplicate key"))
+        );
+        assert_eq!(
+            de_pairs(Seq(vec![])),
+            Err(err("invalid type: sequence, expected a map with unique keys"))
+        );
+        assert_eq!(
+            de_pairs(Map(vec![(U32(1), Str("x".to_string()))])),
+            Err(err("invalid type: string \"x\", expected u32"))
+        );
+    }
+
+    #[test]
+    fn deserialize_entry() {
+        assert_eq!(de_entry(entry_value()), Ok((7, "ab".to_string(), vec![(3, 4)])));
+        assert_eq!(
+            de_entry(Struct("Entry", vec![("id", U32(7)), ("pairs", Map(vec![]))])),
+            Err(err("missing field `name`"))
+        );
+        assert_eq!(
+            de_entry(Struct("Entry", vec![("id", U32(7)), ("id", U32(8))])),
+            Err(err("duplicate field `id`"))
+        );
+        assert_eq!(
+            de_entry(Struct("Entry", vec![("bogus", U32(7))])),
+            Err(err("unknown field `bogus`, expected one of `id`, `name`, `pairs`"))
+        );
+        assert_eq!(
+            de_entry(Seq(vec![U32(7), Str("ab".to_string()), Map(vec![])])),
+            Ok((7, "ab".to_string(), vec![]))
+        );
+        assert_eq!(
+            de_entry(Seq(vec![U32(7)])),
+            Err(err("invalid length 1, expected struct Entry with 3 elements"))
+        );
+        assert_eq!(
+            de_entry(Map(vec![(U32(5), U32(7))])),
+            Err(err("invalid value: integer `5`, expected field index 0 <= i < 3"))
+        );
+        assert_eq!(
+            de_entry(U32(3)),
+            Err(err("invalid type: integer `3`, expected struct Entry"))
+        );
+    }
+
+    #[test]
+    fn round_trip() {
+        let value = ser(&entry()).unwrap();
+        assert_eq!(de_entry(value), Ok((7, "ab".to_string(), vec![(3, 4)])));
+    }
