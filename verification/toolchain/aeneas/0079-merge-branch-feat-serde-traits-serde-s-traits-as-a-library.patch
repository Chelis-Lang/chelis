index 0000000..74e40bf
--- /dev/null
+++ b/backends/lean/Aeneas/Std/Serde/Ser.lean
@@ -0,0 +1,470 @@
+import Aeneas.Std.Core.Fmt
+import Aeneas.Std.Core.FmtWithSlice
+import Aeneas.Std.Core.Error
+import Aeneas.Std.Core.Result
+import Aeneas.Std.Float
+import Aeneas.Std.String
+
+/-!
+# `serde_core::ser` (serde 1.0.228)
+
+The traits `Serialize`, `Serializer` and `SerializeSeq`/`SerializeTuple`/`SerializeTupleStruct`/
+`SerializeTupleVariant`/`SerializeMap`/`SerializeStruct`/`SerializeStructVariant` form a recursive
+group: `Serialize::serialize<S: Serializer>` takes a serializer, and a serializer's methods
+(`serialize_element<T: Serialize>`, `serialize_some<T: Serialize>`, ...) take `Serialize`
+dictionaries. Both occurrences are method-level bounds, i.e. negative positions: the group has no
+inductive encoding (the kernel rejects `serialize_element : Serialize T → ...` inside a structure
+that `Serialize` refers to as a non-positive occurrence).
+
+## The knot
+
+The *format side* (`Serializer` and its compound states) is defined relative to a family
+`X : Type → Type 1` standing for the `Serialize` dictionaries it receives at its *knot positions*
+(the method-level `T: Serialize` bounds). The *data side* `SerializeStep X` is an ordinary
+structure over the format side at `X`. The level-`n` approximations are
+`SerializeAt 0 = PUnit`, `SerializeAt (n + 1) = SerializeStep (SerializeAt n)`: a dictionary that can
+be run against formats nesting at most `n` data-side calls. `SerializeΩ T` holds a dictionary at
+every level. The Rust traits are the structures at `SerializeΩ`:
+`Serializer = SerializerF SerializeΩ`, `Serialize = SerializeStep SerializeΩ`.
+
+`Serialize.wrap : Serialize T → SerializeΩ T` is the knot: at level `n + 1` it runs the dictionary
+against the level-`n` format seen at `SerializeΩ` (`SerializerF.map`, projecting the nested
+dictionaries to level `n`); `wrap_level_succ` is `rfl`. It is the `knot` of the `rust_trait`
+attribute of `Serialize`: Aeneas extracts a call `inst.SerializeSeqInst.serialize_element d s v` as
+`serialize_element (Serialize.wrap d) s v`.
+
+`FormatProgram` (below) is what a Rust implementation of the format side is: the dictionaries of a
+family of format types, generic in the knot family, built from the family one level down (a Rust
+format can use a `T: Serialize` it receives only by calling `serialize` with a serializer of its
+own family). `FormatProgram.encode` turns every such program into `Serializer` dictionaries, and
+`FormatProgram.stepDict_serialize` states, by `rfl`, that the encoded format given `wrap d` runs the
+program with `d` run against the encoded formats one level down: the Rust semantics, with the nesting
+depth explicit. Statements about the extracted (generic) data-side implementations quantify over
+all `Serializer` dictionaries, hence cover every Rust format.
+-/
+
+namespace Aeneas.Std
+
+open Result
+
+/-- `serde_core::ser::Error` -/
+@[rust_trait "serde_core::ser::Error" (parentClauses := ["coreerrorErrorInst"])]
+structure serde_core.ser.Error (Self : Type) where
+  coreerrorErrorInst : core.error.Error Self
+  custom : {T : Type} → core.fmt.Display T → T → Result Self
+
+namespace serde_core.ser
+
+/-! ## Format side, relative to the knot family `X` -/
+
+section
+variable (X : Type → Type 1)
+
+structure SerializeSeqF (Self Ok Error : Type) : Type 1 where
+  serde_coreserErrorInst : serde_core.ser.Error Error
+  serialize_element : {T : Type} → X T → Self → T →
+    Result (core.result.Result Unit Error × Self)
+  «end» : Self → Result (core.result.Result Ok Error)
+
+structure SerializeTupleF (Self Ok Error : Type) : Type 1 where
+  serde_coreserErrorInst : serde_core.ser.Error Error
+  serialize_element : {T : Type} → X T → Self → T →
+    Result (core.result.Result Unit Error × Self)
+  «end» : Self → Result (core.result.Result Ok Error)
+
+structure SerializeTupleStructF (Self Ok Error : Type) : Type 1 where
+  serde_coreserErrorInst : serde_core.ser.Error Error
+  serialize_field : {T : Type} → X T → Self → T →
+    Result (core.result.Result Unit Error × Self)
+  «end» : Self → Result (core.result.Result Ok Error)
+
+structure SerializeTupleVariantF (Self Ok Error : Type) : Type 1 where
+  serde_coreserErrorInst : serde_core.ser.Error Error
+  serialize_field : {T : Type} → X T → Self → T →
+    Result (core.result.Result Unit Error × Self)
+  «end» : Self → Result (core.result.Result Ok Error)
+
+structure SerializeMapF (Self Ok Error : Type) : Type 1 where
+  serde_coreserErrorInst : serde_core.ser.Error Error
+  serialize_key : {T : Type} → X T → Self → T →
+    Result (core.result.Result Unit Error × Self)
+  serialize_value : {T : Type} → X T → Self → T →
+    Result (core.result.Result Unit Error × Self)
+  /-- Provided: `serialize_key(key)?; serialize_value(value)`. -/
+  serialize_entry : {K V : Type} → X K → X V → Self → K → V →
+    Result (core.result.Result Unit Error × Self) :=
+    fun kInst vInst self key value => do
+      let (r, self) ← serialize_key kInst self key
+      match r with
+      | .Err e => ok (.Err e, self)
+      | .Ok () => serialize_value vInst self value
+  «end» : Self → Result (core.result.Result Ok Error)
+
+structure SerializeStructF (Self Ok Error : Type) : Type 1 where
+  serde_coreserErrorInst : serde_core.ser.Error Error
+  serialize_field : {T : Type} → X T → Self → Str → T →
+    Result (core.result.Result Unit Error × Self)
+  /-- Provided: `let _ = key; Ok(())`. -/
+  skip_field : Self → Str → Result (core.result.Result Unit Error × Self) :=
+    fun self _ => ok (.Ok (), self)
+  «end» : Self → Result (core.result.Result Ok Error)
+
+structure SerializeStructVariantF (Self Ok Error : Type) : Type 1 where
+  serde_coreserErrorInst : serde_core.ser.Error Error
+  serialize_field : {T : Type} → X T → Self → Str → T →
+    Result (core.result.Result Unit Error × Self)
+  /-- Provided: `let _ = key; Ok(())`. -/
+  skip_field : Self → Str → Result (core.result.Result Unit Error × Self) :=
+    fun self _ => ok (.Ok (), self)
+  «end» : Self → Result (core.result.Result Ok Error)
+
+/-- The message of the provided `serialize_i128`/`serialize_u128`:
+    `Err(Error::custom("i128 is not supported"))`. -/
+def unsupported {Ok Error : Type} (errInst : serde_core.ser.Error Error) (msg : String) :
+    Result (core.result.Result Ok Error) := do
+  .ok (.Err (← errInst.custom core.fmt.DisplayStr (← Str.ofString msg)))
+
+structure SerializerF (Self Ok Error SerializeSeq SerializeTuple SerializeTupleStruct
+    SerializeTupleVariant SerializeMap SerializeStruct SerializeStructVariant : Type) : Type 1 where
+  serde_coreserErrorInst : serde_core.ser.Error Error
+  SerializeSeqInst : SerializeSeqF X SerializeSeq Ok Error
+  SerializeTupleInst : SerializeTupleF X SerializeTuple Ok Error
+  SerializeTupleStructInst : SerializeTupleStructF X SerializeTupleStruct Ok Error
+  SerializeTupleVariantInst : SerializeTupleVariantF X SerializeTupleVariant Ok Error
+  SerializeMapInst : SerializeMapF X SerializeMap Ok Error
+  SerializeStructInst : SerializeStructF X SerializeStruct Ok Error
+  SerializeStructVariantInst : SerializeStructVariantF X SerializeStructVariant Ok Error
+  serialize_bool : Self → Bool → Result (core.result.Result Ok Error)
+  serialize_i8 : Self → I8 → Result (core.result.Result Ok Error)
+  serialize_i16 : Self → I16 → Result (core.result.Result Ok Error)
+  serialize_i32 : Self → I32 → Result (core.result.Result Ok Error)
+  serialize_i64 : Self → I64 → Result (core.result.Result Ok Error)
+  /-- Provided: `Err(Error::custom("i128 is not supported"))`. -/
+  serialize_i128 : Self → I128 → Result (core.result.Result Ok Error) :=
+    fun _ _ => unsupported serde_coreserErrorInst "i128 is not supported"
+  serialize_u8 : Self → U8 → Result (core.result.Result Ok Error)
+  serialize_u16 : Self → U16 → Result (core.result.Result Ok Error)
+  serialize_u32 : Self → U32 → Result (core.result.Result Ok Error)
+  serialize_u64 : Self → U64 → Result (core.result.Result Ok Error)
+  /-- Provided: `Err(Error::custom("u128 is not supported"))`. -/
+  serialize_u128 : Self → U128 → Result (core.result.Result Ok Error) :=
+    fun _ _ => unsupported serde_coreserErrorInst "u128 is not supported"
+  serialize_f32 : Self → F32 → Result (core.result.Result Ok Error)
+  serialize_f64 : Self → F64 → Result (core.result.Result Ok Error)
+  serialize_char : Self → Char → Result (core.result.Result Ok Error)
+  serialize_str : Self → Str → Result (core.result.Result Ok Error)
+  serialize_bytes : Self → Slice U8 → Result (core.result.Result Ok Error)
+  serialize_none : Self → Result (core.result.Result Ok Error)
+  serialize_some : {T : Type} → X T → Self → T → Result (core.result.Result Ok Error)
+  serialize_unit : Self → Result (core.result.Result Ok Error)
+  serialize_unit_struct : Self → Str → Result (core.result.Result Ok Error)
+  serialize_unit_variant : Self → Str → U32 → Str → Result (core.result.Result Ok Error)
+  serialize_newtype_struct : {T : Type} → X T → Self → Str → T →
+    Result (core.result.Result Ok Error)
+  serialize_newtype_variant : {T : Type} → X T → Self → Str → U32 → Str → T →
+    Result (core.result.Result Ok Error)
+  serialize_seq : Self → Option Usize → Result (core.result.Result SerializeSeq Error)
+  serialize_tuple : Self → Usize → Result (core.result.Result SerializeTuple Error)
+  serialize_tuple_struct : Self → Str → Usize →
+    Result (core.result.Result SerializeTupleStruct Error)
+  serialize_tuple_variant : Self → Str → U32 → Str → Usize →
+    Result (core.result.Result SerializeTupleVariant Error)
+  serialize_map : Self → Option Usize → Result (core.result.Result SerializeMap Error)
+  serialize_struct : Self → Str → Usize → Result (core.result.Result SerializeStruct Error)
+  serialize_struct_variant : Self → Str → U32 → Str → Usize →
+    Result (core.result.Result SerializeStructVariant Error)
+  /-- Provided: `true`. -/
+  is_human_readable : Self → Result Bool := fun _ => ok true
+
+/-- The data side (`Serialize`) relative to the knot family. -/
+structure SerializeStep (Self : Type) : Type 1 where
+  serialize : {S Ok Error SerializeSeq SerializeTuple SerializeTupleStruct SerializeTupleVariant
+    SerializeMap SerializeStruct SerializeStructVariant : Type} →
+    SerializerF X S Ok Error SerializeSeq SerializeTuple SerializeTupleStruct
+      SerializeTupleVariant SerializeMap SerializeStruct SerializeStructVariant →
+    Self → S → Result (core.result.Result Ok Error)
+end
+
+/-! ## Contravariance of the format side in the knot family -/
+
+section map
+variable {X Y : Type → Type 1} (g : ∀ {T : Type}, Y T → X T)
+
+def SerializeSeqF.map {Self Ok Error : Type} (d : SerializeSeqF X Self Ok Error) :
+    SerializeSeqF Y Self Ok Error :=
+  { serde_coreserErrorInst := d.serde_coreserErrorInst
+    serialize_element := fun x => d.serialize_element (g x)
+    «end» := d.«end» }
+
+def SerializeTupleF.map {Self Ok Error : Type} (d : SerializeTupleF X Self Ok Error) :
+    SerializeTupleF Y Self Ok Error :=
+  { serde_coreserErrorInst := d.serde_coreserErrorInst
+    serialize_element := fun x => d.serialize_element (g x)
+    «end» := d.«end» }
+
+def SerializeTupleStructF.map {Self Ok Error : Type} (d : SerializeTupleStructF X Self Ok Error) :
+    SerializeTupleStructF Y Self Ok Error :=
+  { serde_coreserErrorInst := d.serde_coreserErrorInst
+    serialize_field := fun x => d.serialize_field (g x)
+    «end» := d.«end» }
+
+def SerializeTupleVariantF.map {Self Ok Error : Type}
+    (d : SerializeTupleVariantF X Self Ok Error) : SerializeTupleVariantF Y Self Ok Error :=
+  { serde_coreserErrorInst := d.serde_coreserErrorInst
+    serialize_field := fun x => d.serialize_field (g x)
+    «end» := d.«end» }
+
+def SerializeMapF.map {Self Ok Error : Type} (d : SerializeMapF X Self Ok Error) :
+    SerializeMapF Y Self Ok Error :=
+  { serde_coreserErrorInst := d.serde_coreserErrorInst
+    serialize_key := fun x => d.serialize_key (g x)
+    serialize_value := fun x => d.serialize_value (g x)
+    serialize_entry := fun k v => d.serialize_entry (g k) (g v)
+    «end» := d.«end» }
+
+def SerializeStructF.map {Self Ok Error : Type} (d : SerializeStructF X Self Ok Error) :
+    SerializeStructF Y Self Ok Error :=
+  { serde_coreserErrorInst := d.serde_coreserErrorInst
+    serialize_field := fun x => d.serialize_field (g x)
+    skip_field := d.skip_field
+    «end» := d.«end» }
+
+def SerializeStructVariantF.map {Self Ok Error : Type}
+    (d : SerializeStructVariantF X Self Ok Error) : SerializeStructVariantF Y Self Ok Error :=
+  { serde_coreserErrorInst := d.serde_coreserErrorInst
+    serialize_field := fun x => d.serialize_field (g x)
+    skip_field := d.skip_field
+    «end» := d.«end» }
+
+def SerializerF.map {Self Ok Error SS ST STS STV SM SSt SSV : Type}
+    (d : SerializerF X Self Ok Error SS ST STS STV SM SSt SSV) :
+    SerializerF Y Self Ok Error SS ST STS STV SM SSt SSV :=
+  { serde_coreserErrorInst := d.serde_coreserErrorInst
+    SerializeSeqInst := d.SerializeSeqInst.map g
+    SerializeTupleInst := d.SerializeTupleInst.map g
+    SerializeTupleStructInst := d.SerializeTupleStructInst.map g
+    SerializeTupleVariantInst := d.SerializeTupleVariantInst.map g
+    SerializeMapInst := d.SerializeMapInst.map g
+    SerializeStructInst := d.SerializeStructInst.map g
+    SerializeStructVariantInst := d.SerializeStructVariantInst.map g
+    serialize_bool := d.serialize_bool
+    serialize_i8 := d.serialize_i8
+    serialize_i16 := d.serialize_i16
+    serialize_i32 := d.serialize_i32
+    serialize_i64 := d.serialize_i64
+    serialize_i128 := d.serialize_i128
+    serialize_u8 := d.serialize_u8
+    serialize_u16 := d.serialize_u16
+    serialize_u32 := d.serialize_u32
+    serialize_u64 := d.serialize_u64
+    serialize_u128 := d.serialize_u128
+    serialize_f32 := d.serialize_f32
+    serialize_f64 := d.serialize_f64
+    serialize_char := d.serialize_char
+    serialize_str := d.serialize_str
+    serialize_bytes := d.serialize_bytes
+    serialize_none := d.serialize_none
+    serialize_some := fun x => d.serialize_some (g x)
+    serialize_unit := d.serialize_unit
+    serialize_unit_struct := d.serialize_unit_struct
+    serialize_unit_variant := d.serialize_unit_variant
+    serialize_newtype_struct := fun x => d.serialize_newtype_struct (g x)
+    serialize_newtype_variant := fun x => d.serialize_newtype_variant (g x)
+    serialize_seq := d.serialize_seq
+    serialize_tuple := d.serialize_tuple
+    serialize_tuple_struct := d.serialize_tuple_struct
+    serialize_tuple_variant := d.serialize_tuple_variant
+    serialize_map := d.serialize_map
+    serialize_struct := d.serialize_struct
+    serialize_struct_variant := d.serialize_struct_variant
+    is_human_readable := d.is_human_readable }
+end map
+
+/-! ## Levels and the limit -/
+
+/-- The data-side dictionaries usable with formats nesting at most `n` data-side calls. -/
+def SerializeAt : Nat → Type → Type 1
+  | 0, _ => PUnit
+  | n + 1, T => SerializeStep (SerializeAt n) T
+
+/-- A `Serialize` dictionary at every level: the knot positions of the format side. -/
+structure SerializeΩ (T : Type) : Type 1 where
+  level : ∀ n, SerializeAt n T
+
+end serde_core.ser
+
+/-! ## The Rust traits -/
+
