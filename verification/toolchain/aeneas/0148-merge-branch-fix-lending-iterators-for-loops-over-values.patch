diff --git a/tests/src/lending-iterator-loops.rs b/tests/src/lending-iterator-loops.rs
new file mode 100644
index 0000000..5194336
--- /dev/null
+++ b/tests/src/lending-iterator-loops.rs
@@ -0,0 +1,263 @@
+//@ [!lean] skip
+//@ [lean] subdir=LendingIteratorLoops
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! `for` loops over lending iterators: `BTreeMap::values_mut` and the slice
+//! `iter_mut`. Charon's `--monomorphize-mut` specializes the blanket
+//! `IntoIterator::into_iter` of the loop at the iterator (`into_iter::<IterMut<'0,
+//! T>, &'0 mut T>`), whose body is `self`: the call is an assignment. Each
+//! iteration lends one element; the model's lens gives it back to the collection
+//! after the loop. The shapes are those of `chelis_ir::lower`
+//! (`lower_program_to_library_inner`, `lower_program_with_context_inner`: remap
+//! the nodes and the root nodes of every evaluation entry).
+//! `LendingIteratorLoops/Checks.lean` evaluates the models on the inputs of the
+//! `native` test module below and compares with the native results, including
+//! the collections after the loops.
+use std::collections::BTreeMap;
+
+/// Increments every value of the map.
+pub fn bump_values(m: &mut BTreeMap<u32, u32>) {
+    for v in m.values_mut() {
+        *v += 1;
+    }
+}
+
+/// Increments every element through `Vec::iter_mut` (the slice iterator).
+pub fn bump_vec(v: &mut Vec<u32>) {
+    for x in v.iter_mut() {
+        *x += 1;
+    }
+}
+
+/// Adds 2 to every element of a slice.
+pub fn bump_slice(s: &mut [u32]) {
+    for x in s.iter_mut() {
+        *x += 2;
+    }
+}
+
+/// Replaces every value by its image in `table` (panics on a missing key) and
+/// counts the values, in a captured counter.
+pub fn remap_values(m: &mut BTreeMap<u32, u32>, table: &BTreeMap<u32, u32>, count: &mut u32) {
+    for node in m.values_mut() {
+        *node = table[node];
+        *count += 1;
+    }
+}
+
+fn record(x: &mut u32, log: &mut Vec<u32>) {
+    log.push(*x);
+    *x *= 2;
+}
+
+/// Calls a function on every element with other mutable state.
+pub fn double_and_log(v: &mut Vec<u32>, log: &mut Vec<u32>) {
+    for x in v.iter_mut() {
+        record(x, log);
+    }
+}
+
+/// Doubles the values up to the first one above `limit`: the element lent at
+/// the `break` is given back unchanged, and the elements after it are untouched.
+pub fn double_until(m: &mut BTreeMap<u32, u32>, limit: u32) {
+    for v in m.values_mut() {
+        if *v > limit {
+            break;
+        }
+        *v *= 2;
+    }
+}
+
+/// Returns the key-order position of the first value equal to `target` after
+/// incrementing the values before it (and that one).
+pub fn bump_to_first(m: &mut BTreeMap<u32, u32>, target: u32) -> Option<u32> {
+    let mut index = 0;
+    for v in m.values_mut() {
+        let hit = *v == target;
+        *v += 1;
+        if hit {
+            return Some(index);
+        }
+        index += 1;
+    }
+    None
+}
+
+/// The element lent by the last iteration escapes the loop and is written
+/// after it; the elements lent before are given back when `last` drops them.
+pub fn last_value_zero(m: &mut BTreeMap<u32, u32>) {
+    let mut last = None;
+    for v in m.values_mut() {
+        *v += 1;
+        last = Some(v);
+    }
+    if let Some(v) = last {
+        *v = 0;
+    }
+}
+
+/// The same through the slice iterator of a `Vec`.
+pub fn last_zero(v: &mut Vec<u32>) {
+    let mut last = None;
+    for x in v.iter_mut() {
+        *x += 1;
+        last = Some(x);
+    }
+    if let Some(x) = last {
+        *x = 0;
+    }
+}
+
+/// An evaluation entry: root nodes by name and the nodes.
+pub struct Entry {
+    pub roots: BTreeMap<u32, u32>,
+    pub nodes: Vec<u32>,
+}
+
+/// Remaps the nodes and the root nodes of every entry through two tables (the
+/// shape of `lower_program_to_library_inner`: `*node = linear_remap[&remap[node]]`).
+pub fn remap_entries(entries: &mut Vec<Entry>, remap: &BTreeMap<u32, u32>, linear: &BTreeMap<u32, u32>) {
+    for entry in &mut *entries {
+        for node in &mut entry.nodes {
+            *node = linear[&remap[node]];
+        }
+        for node in entry.roots.values_mut() {
+            *node = linear[&remap[node]];
+        }
+    }
+}
+
+/// The same through `iter_mut` for the entries and one table.
+pub fn remap_entries_iter_mut(entries: &mut Vec<Entry>, remap: &BTreeMap<u32, u32>) {
+    for entry in entries.iter_mut() {
+        for node in entry.nodes.iter_mut() {
+            *node = remap[node];
+        }
+        for node in entry.roots.values_mut() {
+            *node = remap[node];
+        }
+    }
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn bump_values_increments_every_value() {
+        let mut m = BTreeMap::from([(3, 10), (1, 20), (2, 0)]);
+        bump_values(&mut m);
+        assert_eq!(m, BTreeMap::from([(1, 21), (2, 1), (3, 11)]));
+        let mut e = BTreeMap::new();
+        bump_values(&mut e);
+        assert!(e.is_empty());
+    }
+
+    #[test]
+    fn bump_vec_and_slice() {
+        let mut v = vec![1, 2, 3];
+        bump_vec(&mut v);
+        assert_eq!(v, vec![2, 3, 4]);
+        let mut s = [5, 0];
+        bump_slice(&mut s);
+        assert_eq!(s, [7, 2]);
+    }
+
+    #[test]
+    fn remap_values_and_count() {
+        let mut m = BTreeMap::from([(1, 7), (2, 8), (3, 7)]);
+        let table = BTreeMap::from([(7, 70), (8, 80)]);
+        let mut count = 5;
+        remap_values(&mut m, &table, &mut count);
+        assert_eq!(m, BTreeMap::from([(1, 70), (2, 80), (3, 70)]));
+        assert_eq!(count, 8);
+    }
+
+    #[test]
+    #[should_panic]
+    fn remap_values_missing_key_panics() {
+        let mut m = BTreeMap::from([(1, 7), (2, 9)]);
+        let table = BTreeMap::from([(7, 70)]);
+        let mut count = 0;
+        remap_values(&mut m, &table, &mut count);
+    }
+
+    #[test]
+    fn double_and_log_records_in_order() {
+        let mut v = vec![3, 1, 4];
+        let mut log = vec![9];
+        double_and_log(&mut v, &mut log);
+        assert_eq!(v, vec![6, 2, 8]);
+        assert_eq!(log, vec![9, 3, 1, 4]);
+    }
+
+    #[test]
+    fn double_until_stops_at_the_limit() {
+        let mut m = BTreeMap::from([(1, 1), (2, 2), (3, 9), (4, 3)]);
+        double_until(&mut m, 5);
+        assert_eq!(m, BTreeMap::from([(1, 2), (2, 4), (3, 9), (4, 3)]));
+        let mut m = BTreeMap::from([(1, 1), (2, 2)]);
+        double_until(&mut m, 5);
+        assert_eq!(m, BTreeMap::from([(1, 2), (2, 4)]));
+    }
+
+    #[test]
+    fn bump_to_first_returns_early() {
+        let mut m = BTreeMap::from([(1, 5), (2, 7), (3, 7), (4, 0)]);
+        assert_eq!(bump_to_first(&mut m, 7), Some(1));
+        assert_eq!(m, BTreeMap::from([(1, 6), (2, 8), (3, 7), (4, 0)]));
+        let mut m = BTreeMap::from([(1, 5), (2, 6)]);
+        assert_eq!(bump_to_first(&mut m, 7), None);
+        assert_eq!(m, BTreeMap::from([(1, 6), (2, 7)]));
+    }
+
+    #[test]
+    fn last_element_escapes_the_loop() {
+        let mut m = BTreeMap::from([(1, 1), (2, 2), (3, 3)]);
+        last_value_zero(&mut m);
+        assert_eq!(m, BTreeMap::from([(1, 2), (2, 3), (3, 0)]));
+        let mut e = BTreeMap::new();
+        last_value_zero(&mut e);
+        assert!(e.is_empty());
+        let mut v = vec![1, 2, 3];
+        last_zero(&mut v);
+        assert_eq!(v, vec![2, 3, 0]);
+    }
+
+    fn entries() -> Vec<Entry> {
+        vec![
+            Entry { roots: BTreeMap::from([(1, 10), (2, 11)]), nodes: vec![10, 12] },
+            Entry { roots: BTreeMap::new(), nodes: vec![] },
+            Entry { roots: BTreeMap::from([(5, 12)]), nodes: vec![11] },
+        ]
+    }
+
+    fn shape(entries: &[Entry]) -> Vec<(Vec<(u32, u32)>, Vec<u32>)> {
+        entries
+            .iter()
+            .map(|e| (e.roots.iter().map(|(k, v)| (*k, *v)).collect(), e.nodes.clone()))
+            .collect()
+    }
+
+    #[test]
+    fn remap_entries_remaps_nodes_and_roots() {
+        let remap = BTreeMap::from([(10, 1), (11, 2), (12, 3)]);
+        let linear = BTreeMap::from([(1, 100), (2, 200), (3, 300)]);
+        let mut e = entries();
+        remap_entries(&mut e, &remap, &linear);
+        assert_eq!(
+            shape(&e),
+            vec![
+                (vec![(1, 100), (2, 200)], vec![100, 300]),
+                (vec![], vec![]),
+                (vec![(5, 300)], vec![200]),
+            ]
+        );
+        let mut e = entries();
+        remap_entries_iter_mut(&mut e, &remap);
+        assert_eq!(
+            shape(&e),
+            vec![(vec![(1, 1), (2, 2)], vec![1, 3]), (vec![], vec![]), (vec![(5, 3)], vec![2])]
+        );
+    }
+}
