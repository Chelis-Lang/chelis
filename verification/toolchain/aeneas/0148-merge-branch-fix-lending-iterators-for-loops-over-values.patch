diff --git a/backends/lean/Aeneas/Std/BTreeMap.lean b/backends/lean/Aeneas/Std/BTreeMap.lean
index 3da3637..235c2bd 100644
--- a/backends/lean/Aeneas/Std/BTreeMap.lean
+++ b/backends/lean/Aeneas/Std/BTreeMap.lean
@@ -33,6 +33,16 @@ structure alloc.collections.btree.map.Keys (K V : Type) where
 structure alloc.collections.btree.map.Values (K V : Type) where
   inner : alloc.collections.btree.map.Iter K V
 
+/-- `btree_map::ValuesMut<'a, K, V>` is `{ inner: IterMut<'a, K, V> }` (map.rs, rustc 1.95): a
+    lending iterator over the values in key order. Like the slice `IterMut`, the model retains
+    the complete borrowed storage and the position of the next entry: `next` lends the value at
+    that position, and its lens writes the value given back at the same position of a later
+    state; `values_mut`'s restoration lens reads the map back from the final state. -/
+@[rust_type "alloc::collections::btree::map::ValuesMut" (mutRegions := #[0]) (body := .opaque)]
+structure alloc.collections.btree.map.ValuesMut (K V : Type) where
+  entries : List (K × V)
+  i : Nat := 0
+
 @[rust_type "alloc::collections::btree::map::IntoIter"
   (keepParams := [true, true, false]) (body := .opaque)]
 structure alloc.collections.btree.map.IntoIter (K V : Type) where
@@ -260,6 +270,14 @@ def BTreeMap.keys {K V : Type} (map : BTreeMap K V) : Result (Keys K V) :=
 def BTreeMap.values {K V : Type} (map : BTreeMap K V) : Result (Values K V) :=
   .ok ⟨⟨map.entries⟩⟩
 
+/-- `BTreeMap::values_mut`: `ValuesMut { inner: self.iter_mut() }`, positioned before the first
+    entry. The restoration lens gives back the map from the final iterator state. -/
+@[rust_fun "alloc::collections::btree::map::{alloc::collections::btree::map::BTreeMap<@K, @V, @A>}::values_mut"
+  (keepParams := [true, true, false]) (keepTraitClauses := [false])]
+def BTreeMap.values_mut {K V : Type} (map : BTreeMap K V) :
+    Result (ValuesMut K V × (ValuesMut K V → BTreeMap K V)) :=
+  .ok ({ entries := map.entries }, fun it => ⟨it.entries⟩)
+
 /-- The entry-wise comparison of `BTreeMap`'s `PartialEq::eq` after its length
     check: `self.iter().zip(other).all(|(a, b)| a == b)`, where the pair
     comparison is `a.0 == b.0 && a.1 == b.1` (core tuple `PartialEq`). -/
@@ -516,6 +534,22 @@ def IteratorValues.next {K V : Type} (it : Values K V) : Result (Option V × Val
   let (item, inner) ← IteratorIter.next it.inner
   .ok (item.map (·.2), ⟨inner⟩)
 
+/-- `ValuesMut::next`: `self.inner.next().map(|(_, v)| v)`, lending the value of the entry at
+    the iterator's position. The lens writes the value given back (if any) at that position of a
+    later state, keeping its key; an exhausted iterator gives nothing back. -/
+@[rust_fun "alloc::collections::btree::map::{core::iter::traits::iterator::Iterator<alloc::collections::btree::map::ValuesMut<'a, @K, @V>, &'a mut @V>}::next"]
+def IteratorValuesMut.next {K V : Type} (it : ValuesMut K V) :
+    Result (Option V × ValuesMut K V × (ValuesMut K V → Option V → ValuesMut K V)) :=
+  match it.entries[it.i]? with
+  | none => .ok (none, it, fun it _ => it)
+  | some (_, v) =>
+    let i := it.i
+    let back (it' : ValuesMut K V) (x : Option V) : ValuesMut K V :=
+      match x with
+      | none => it'
+      | some x => { it' with entries := it'.entries.modify i (fun (k, _) => (k, x)) }
+    .ok (some v, { it with i := i + 1 }, back)
+
 /-- `Values::size_hint`: `self.inner.size_hint()`. -/
 @[rust_fun "alloc::collections::btree::map::{core::iter::traits::iterator::Iterator<alloc::collections::btree::map::Values<'a, @K, @V>, &'a @V>}::size_hint"]
 def IteratorValues.size_hint {K V : Type} (it : Values K V) : Result (Usize × Option Usize) :=
