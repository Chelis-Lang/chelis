index 0f5e49b..67f55c4 100644
--- a/src/PrePasses.ml
+++ b/src/PrePasses.ml
@@ -1476,7 +1476,10 @@ let rename_type_vars (crate : crate) : crate =
 
 (** Simplify calls to:
     - the blanket [IntoIterator::into_iter] implementation (we replace it with
-      an assignment)
+      an assignment), including its partial-monomorphization instances (e.g.
+      [into_iter::<IterMut<'0, T>, &'0 mut T>] of a [for] loop over a lending
+      iterator): the body of the blanket implementation is [self] at every
+      instantiation
     - the blanket [TryInto::try_into] implementation (we replace it with a call
       to the [try_from] method of the required [TryFrom] clause)
     - unary reference identities, verified from their complete Rust bodies
@@ -1503,7 +1506,17 @@ let simplify_trait_calls (crate : crate) : crate =
         match_with_trait_decl_refs = Config.match_patterns_with_trait_decl_refs;
       }
   in
-  let is_blanket_into_iter = match_pattern into_iter_pat in
+  (* The name of a partial-monomorphization instance without its shape: the
+     matcher compares the shape with the generics of the pattern's last
+     element, which the blanket pattern leaves empty. *)
+  let logical_name (name : name) =
+    match List.rev name with
+    | PeInstantiated _ :: rest -> List.rev rest
+    | _ -> name
+  in
+  let is_blanket_into_iter name =
+    match_pattern into_iter_pat (logical_name name)
+  in
   let is_blanket_try_into = match_pattern try_into_pat in
   let reference_identities =
     FunDeclId.Map.fold
