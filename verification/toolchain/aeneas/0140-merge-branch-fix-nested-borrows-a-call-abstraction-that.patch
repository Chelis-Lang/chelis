+(** A function-call abstraction whose continuation is the one of a loop or of a
+    join: the loop (or join) gives back its values (see
+    [InterpLoops.eval_loop_symbolic], which introduces the continuation of the
+    loop in the fresh abstractions at the break) *)
+let fun_call_abs_is_loop_output (abs : V.abs) : bool =
+  match abs.cont with
+  | Some { input = Some { value = V.EApp ((V.ELoop _ | V.EJoin _), _); _ }; _ }
+    ->
+      true
+  | _ -> false
+
 (** Merging abstractions wraps their outputs in tuples *)
 let rec strip_singleton_tuples (v : V.tevalue) : V.tevalue =
   match (v.value, v.ty) with
@@ -1978,6 +1989,13 @@ and translate_end_abs (ectx : C.eval_ctx) (abs : V.abs)
   match abs.kind with
   | V.SynthInput rg_id ->
       translate_end_abstraction_synth_input ectx abs e ctx rg_id abs_level
+  | V.FunCall _ when fun_call_abs_is_loop_output abs ->
+      (* The abstraction of a call made before a loop which the loop body does
+         not touch, normalized by the loop join (see
+         [InterpReduceCollapse.collapse_ctx_aux]) and not merged: it is an
+         output of the loop (its continuation is the one of the loop, which
+         applied the backward function of the call at the break) *)
+      translate_end_abstraction_join_or_loop ectx abs abs_level e ctx
   | V.FunCall _ -> translate_end_abstraction_fun_call ectx abs abs_level e ctx
   | V.SynthRet rg_id ->
       translate_end_abstraction_synth_ret ectx abs e ctx rg_id abs_level
