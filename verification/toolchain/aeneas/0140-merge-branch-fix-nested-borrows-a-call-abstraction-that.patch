+//@ [!lean] skip
+//@ [lean] subdir=NestedBorrowsCallThenLoop
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::option::{core::option::Option} --include core::ops::deref::{core::ops::deref::Deref} --include core::ops::deref::{core::ops::deref::DerefMut}
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! A value holding a mutable borrow is moved into a call, then a loop which
+//! does not touch it runs before the function returns. The loop join
+//! normalizes the abstraction of the call (its structured arguments become
+//! the borrows they hold), so the fixed point does not keep it: it becomes an
+//! output of the loop (its continuation is the loop's, which applies the
+//! backward function of the call at the break), and must be ended as such
+//! after the loop instead of applying the backward function of the call
+//! again (production: chelis_deep `with_scope`, which calls the closure it
+//! receives, capturing `&mut F`, then removes the names it added in a loop).
+
+pub struct W<'a> {
+    pub r: &'a mut u32,
+    pub k: u32,
+}
+
+/// Consumes the value: writes through its borrow
+fn bump(w: W<'_>, s: &mut u32) -> u32 {
+    *w.r = (*w.r).wrapping_add(w.k);
+    *s = (*s).wrapping_add(1);
+    w.k
+}
+
+/// The value is moved into a call, then a loop which does not touch it
+pub fn call_then_loop(scope: &mut u32, w: W<'_>, n: u32) -> u32 {
+    let r = bump(w, scope);
+    let mut j = 0;
+    while j < n {
+        *scope = (*scope).wrapping_sub(1);
+        j += 1;
+    }
+    r
+}
+
+pub fn run_call_then_loop(scope: &mut u32, x: &mut u32, k: u32, n: u32) -> u32 {
+    call_then_loop(scope, W { r: x, k }, n)
+}
+
+/// The same with a borrow of a value of a type parameter (the borrowed value
+/// is given back unchanged)
+pub struct G<'a, T> {
+    pub r: &'a mut T,
+    pub k: u32,
+}
+
+fn touch<T>(g: G<'_, T>, s: &mut u32) -> u32 {
+    let _ = g.r;
+    *s = (*s).wrapping_add(g.k);
+    g.k
+}
+
+pub fn generic_call_then_loop<T>(scope: &mut u32, g: G<'_, T>, n: u32) -> u32 {
+    let r = touch(g, scope);
+    let mut j = 0;
+    while j < n {
+        *scope = (*scope).wrapping_sub(1);
+        j += 1;
+    }
+    r
+}
+
+pub fn run_generic_call_then_loop(scope: &mut u32, x: &mut u32, k: u32, n: u32) -> u32 {
+    generic_call_then_loop(scope, G { r: x, k }, n)
+}
+
+/// The production shape: the closure (capturing a mutable borrow) is called
+/// by value, then a loop restores the scope
+fn with_scope<R, F>(scope: &mut u32, added: u32, f: F) -> R
+where
+    F: FnOnce(&mut u32) -> R,
+{
+    *scope = (*scope).wrapping_add(added);
+    let result = f(scope);
+    let mut j = 0;
+    while j < added {
+        *scope = (*scope).wrapping_sub(1);
+        j += 1;
+    }
+    result
+}
+
+pub fn run_with_scope(scope: &mut u32, acc: &mut u32, added: u32) -> u32 {
+    with_scope(scope, added, |s| {
+        *acc = (*acc).wrapping_add(*s);
+        *s = (*s).wrapping_mul(2);
+        *s
+    })
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    /// `(result, scope, x)` after running `run` on `scope` and `x`
+    fn on(scope: u32, x: u32, run: impl FnOnce(&mut u32, &mut u32) -> u32) -> (u32, u32, u32) {
+        let mut s = scope;
+        let mut v = x;
+        let r = run(&mut s, &mut v);
+        (r, s, v)
+    }
+
+    #[test]
+    fn call_then_loop_native() {
+        assert_eq!(on(10, 5, |s, x| run_call_then_loop(s, x, 3, 0)), (3, 11, 8));
+        assert_eq!(on(10, 5, |s, x| run_call_then_loop(s, x, 3, 4)), (3, 7, 8));
+        assert_eq!(on(0, u32::MAX, |s, x| run_call_then_loop(s, x, 2, 3)), (2, u32::MAX - 1, 1));
+    }
+
+    #[test]
+    fn generic_call_then_loop_native() {
+        assert_eq!(on(10, 5, |s, x| run_generic_call_then_loop(s, x, 3, 0)), (3, 13, 5));
+        assert_eq!(on(10, 5, |s, x| run_generic_call_then_loop(s, x, 3, 2)), (3, 11, 5));
+    }
+
+    #[test]
+    fn with_scope_native() {
+        assert_eq!(on(10, 5, |s, x| run_with_scope(s, x, 0)), (20, 20, 15));
+        assert_eq!(on(10, 5, |s, x| run_with_scope(s, x, 3)), (26, 23, 18));
+        assert_eq!(on(u32::MAX, 1, |s, x| run_with_scope(s, x, 2)), (2, 0, 2));
+    }
+}
