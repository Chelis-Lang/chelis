+import NestedBorrowsCallThenLoop.NestedBorrowsCallThenLoop
+
+/-! Evaluate the model of `tests/src/nested-borrows-call-then-loop.rs` on the
+    inputs of its `native` test module and compare with the native results
+    `(result, scope, x)`: `scope` is the value given back through `&mut scope`
+    after the loop, `x` the value given back through the borrow the moved
+    value (or the closure) held, written by the call before the loop. -/
+
+namespace nested_borrows_call_then_loop.checks
+open Aeneas Aeneas.Std Result
+
+def u (x : Nat) : U32 := ⟨BitVec.ofNat _ x⟩
+
+def max := 4294967295
+
+def on (run : U32 → U32 → Result (U32 × U32 × U32)) (scope x : Nat) :
+    Option (Nat × Nat × Nat) :=
+  match run (u scope) (u x) with
+  | ok (r, s, v) => some (r.val, s.val, v.val)
+  | _ => none
+
+-- call_then_loop_native
+#guard on (run_call_then_loop · · (u 3) (u 0)) 10 5 == some (3, 11, 8)
+#guard on (run_call_then_loop · · (u 3) (u 4)) 10 5 == some (3, 7, 8)
+#guard on (run_call_then_loop · · (u 2) (u 3)) 0 max == some (2, max - 1, 1)
+
+-- generic_call_then_loop_native
+#guard on (run_generic_call_then_loop · · (u 3) (u 0)) 10 5 == some (3, 13, 5)
+#guard on (run_generic_call_then_loop · · (u 3) (u 2)) 10 5 == some (3, 11, 5)
+
+-- with_scope_native
+#guard on (run_with_scope · · (u 0)) 10 5 == some (20, 20, 15)
+#guard on (run_with_scope · · (u 3)) 10 5 == some (26, 23, 18)
+#guard on (run_with_scope · · (u 2)) max 1 == some (2, 0, 2)
+
+end nested_borrows_call_then_loop.checks
