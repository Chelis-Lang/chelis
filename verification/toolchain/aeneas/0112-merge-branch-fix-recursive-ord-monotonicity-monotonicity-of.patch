+++ b/tests/src/recursive-box-hash.rs
@@ -0,0 +1,109 @@
+//@ [!lean] skip
+//@ [lean] subdir=RecursiveBoxHash
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! `Hash` of `Box<T>` (it hashes the boxed value) and a `Hash` impl which is
+//! recursive through `Box<Self>` (the shape of the derived `Hash` of chelis-ir
+//! `dag::DimExpr`; here the leaves write their bytes directly instead of going
+//! through the integer `Hash` impls). The Lean definition of `Dim`'s `hash` is
+//! a `partial_fixpoint` which calls the model of `Hash for Box<T>` with an
+//! instance built from itself. `RecursiveBoxHash/Checks.lean` evaluates the
+//! model on the inputs of the `native` test module below and compares with the
+//! native results; the hasher is given back through `&mut H`.
+
+use std::hash::{Hash, Hasher};
+
+/// A hasher which folds the written bytes and counts the writes
+pub struct Fold {
+    pub acc: u64,
+    pub writes: u32,
+}
+
+impl Hasher for Fold {
+    fn finish(&self) -> u64 {
+        self.acc.wrapping_mul(1000).wrapping_add(self.writes as u64)
+    }
+
+    fn write(&mut self, bytes: &[u8]) {
+        let mut i = 0;
+        while i < bytes.len() {
+            self.acc = self.acc.wrapping_mul(31).wrapping_add(bytes[i] as u64);
+            i += 1;
+        }
+        self.writes += 1;
+    }
+}
+
+pub struct Leaf(pub u8);
+
+impl Hash for Leaf {
+    fn hash<H: Hasher>(&self, state: &mut H) {
+        state.write(&[self.0, 7]);
+    }
+}
+
+pub enum Dim {
+    Lit(Leaf),
+    Mul(Box<Dim>, Box<Dim>),
+    Neg(Box<Dim>),
+}
+
+impl Hash for Dim {
+    fn hash<H: Hasher>(&self, state: &mut H) {
+        match self {
+            Dim::Lit(leaf) => {
+                state.write(&[0]);
+                leaf.hash(state)
+            }
+            Dim::Mul(a, b) => {
+                state.write(&[1]);
+                a.hash(state);
+                b.hash(state)
+            }
+            Dim::Neg(a) => {
+                state.write(&[2]);
+                a.hash(state)
+            }
+        }
+    }
+}
+
+pub fn hash_of<T: Hash>(x: &T) -> u64 {
+    let mut state = Fold { acc: 0, writes: 0 };
+    x.hash(&mut state);
+    state.finish()
+}
+
+/// `Hash for Box<Leaf>`
+pub fn box_leaf_hash(n: u8) -> u64 {
+    hash_of(&Box::new(Leaf(n)))
+}
+
+pub fn dim_hash(a: u8, b: u8) -> u64 {
+    let d = Dim::Mul(
+        Box::new(Dim::Neg(Box::new(Dim::Lit(Leaf(a))))),
+        Box::new(Dim::Mul(
+            Box::new(Dim::Lit(Leaf(b))),
+            Box::new(Dim::Lit(Leaf(a))),
+        )),
+    );
+    hash_of(&d)
+}
+
+/// `Hash for Box<Dim>`
+pub fn box_dim_hash(a: u8) -> u64 {
+    hash_of(&Box::new(Dim::Neg(Box::new(Dim::Lit(Leaf(a))))))
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn hashes() {
+        assert_eq!(box_leaf_hash(5), 162001);
+        assert_eq!(dim_hash(3, 4), 8603741549474383393);
+        assert_eq!(dim_hash(4, 3), 8604594439588334393);
+        assert_eq!(box_dim_hash(9), 59868003);
+    }
+}
diff --git a/tests/src/recursive-ord-derives.rs b/tests/src/recursive-ord-derives.rs
new file mode 100644
index 0000000..f0c697f
--- /dev/null
+++ b/tests/src/recursive-ord-derives.rs
@@ -0,0 +1,233 @@
+//@ [!lean] skip
+//@ [lean] subdir=RecursiveOrdDerives
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Derived `PartialEq`, `PartialOrd` and `Ord` (with `Clone` and `Debug`) of a
+//! type recursive through `Box<[Self]>` and `Box<Self>` (the shape of chelis-ir
+//! `capacity_key::CanonicalCapacity`): the derived comparisons recurse through
+//! the models of the comparison impls of `[T]` and `Box<T>`, called with an
+//! instance built from the method being defined. The Lean definitions are
+//! `partial_fixpoint`s, whose monotonicity goes through those models.
+//! `RecursiveOrdDerives/Checks.lean` evaluates the model on the inputs of the
+//! `native` test module below and compares with the native results.
+
+use std::cmp::Ordering;
+
+#[derive(Clone, Copy, Debug, Eq, Ord, PartialEq, PartialOrd)]
+pub enum Source {
+    Axis { scope: u64, load: u32, axis: usize },
+    Scalar { scope: u64, node: u32 },
+}
+
+#[derive(Clone, Debug, Eq, Ord, PartialEq, PartialOrd)]
+pub enum Canonical {
+    Literal(u64),
+    Source(Source),
+    Product(Box<[Canonical]>),
+    ExactQuotient {
+        dividend: Box<Canonical>,
+        divisor: Box<Canonical>,
+    },
+}
+
+/// Not recursive itself: holds the recursive type (`CapacityPredicate`)
+#[derive(Clone, Debug, Eq, Ord, PartialEq, PartialOrd)]
+pub enum Predicate {
+    NonZero(Canonical),
+    DividesEvenly {
+        dividend: Canonical,
+        divisor: Canonical,
+    },
+}
+
+/// The sorted, deduplicated obligations (`ValidityDomain`)
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub struct Validity {
+    pub obligations: Box<[Predicate]>,
+}
+
+pub fn lit(n: u64) -> Canonical {
+    Canonical::Literal(n)
+}
+
+pub fn axis(scope: u64, load: u32) -> Canonical {
+    Canonical::Source(Source::Axis {
+        scope,
+        load,
+        axis: 0,
+    })
+}
+
+pub fn scalar(scope: u64, node: u32) -> Canonical {
+    Canonical::Source(Source::Scalar { scope, node })
+}
+
+pub fn product(factors: Vec<Canonical>) -> Canonical {
+    Canonical::Product(factors.into_boxed_slice())
+}
+
+pub fn quotient(dividend: Canonical, divisor: Canonical) -> Canonical {
+    Canonical::ExactQuotient {
+        dividend: Box::new(dividend),
+        divisor: Box::new(divisor),
+    }
+}
+
+/// `canonical_factors.sort()`
+pub fn sort_factors(mut factors: Vec<Canonical>) -> Vec<Canonical> {
+    factors.sort();
+    factors
+}
+
+/// `ValidityDomain::new`: sort, then dedup
+pub fn validity(mut obligations: Vec<Predicate>) -> Validity {
+    obligations.sort();
+    obligations.dedup();
+    Validity {
+        obligations: obligations.into_boxed_slice(),
+    }
+}
+
+/// Mixed factors: literals, sources, nested products (compared
+/// lexicographically, including a strict prefix) and quotients (compared by
+/// dividend, then divisor)
+pub fn sample(a: u64, b: u64) -> Vec<Canonical> {
+    let mut v = Vec::new();
+    v.push(quotient(axis(a, 2), lit(b)));
+    v.push(product(vec![axis(a, 1), lit(b), scalar(a, 3)]));
+    v.push(lit(b));
+    v.push(product(vec![axis(a, 1), lit(b)]));
+    v.push(scalar(a, 1));
+    v.push(quotient(axis(a, 2), lit(a)));
+    v.push(product(vec![axis(a, 1), product(vec![lit(a)])]));
+    v.push(axis(b, 7));
+    v.push(lit(a));
+    v.push(product(vec![axis(a, 1), lit(b)]));
+    v
+}
+
+pub fn sorted_debug(a: u64, b: u64) -> String {
+    format!("{:?}", sort_factors(sample(a, b)))
+}
+
+fn ordering_code(o: Ordering) -> u32 {
+    match o {
+        Ordering::Less => 1,
+        Ordering::Equal => 2,
+        Ordering::Greater => 3,
+    }
+}
+
+fn partial_code(o: Option<Ordering>) -> u32 {
+    match o {
+        None => 0,
+        Some(o) => ordering_code(o),
+    }
+}
+
+/// `cmp`, `partial_cmp`, `==`, `!=`, `lt` and `ge` of two values, one decimal digit each
+pub fn compare(x: &Canonical, y: &Canonical) -> u32 {
+    let mut r = ordering_code(x.cmp(y));
+    r = r * 10 + partial_code(x.partial_cmp(y));
+    r = r * 10 + if x == y { 1 } else { 0 };
+    r = r * 10 + if x != y { 1 } else { 0 };
+    r = r * 10 + if x.lt(y) { 1 } else { 0 };
+    r = r * 10 + if x.ge(y) { 1 } else { 0 };
+    r
+}
+
+/// The comparisons of the `i`-th element of `sample(a, b)` with every element
+pub fn compare_row(a: u64, b: u64, i: usize) -> Vec<u32> {
+    let v = sample(a, b);
+    let mut row = Vec::new();
+    let mut j = 0;
+    while j < v.len() {
+        row.push(compare(&v[i], &v[j]));
+        j += 1;
+    }
+    row
+}
+
+/// A clone compares equal to its original; the maximum and minimum by `Ord`
+pub fn clone_max_min(a: u64, b: u64) -> String {
+    let v = sample(a, b);
+    let c = v[1].clone();
+    let eq = c == v[1];
+    let mx = std::cmp::max(v[1].clone(), v[3].clone());
+    let mn = std::cmp::min(v[6].clone(), v[3].clone());
+    format!("{eq} {mx:?} {mn:?}")
+}
+
+/// Obligations with duplicates (`ValidityDomain::new`)
+pub fn validity_debug(a: u64, b: u64) -> String {
+    let mut obligations = Vec::new();
+    obligations.push(Predicate::DividesEvenly {
+        dividend: axis(a, 2),
+        divisor: product(vec![lit(b), scalar(a, 1)]),
+    });
+    obligations.push(Predicate::NonZero(product(vec![lit(b), scalar(a, 1)])));
+    obligations.push(Predicate::DividesEvenly {
+        dividend: axis(a, 2),
+        divisor: lit(b),
+    });
+    obligations.push(Predicate::NonZero(product(vec![lit(b), scalar(a, 1)])));
+    obligations.push(Predicate::NonZero(quotient(axis(a, 2), lit(b))));
+    obligations.push(Predicate::DividesEvenly {
+        dividend: axis(a, 2),
+        divisor: lit(b),
+    });
+    let v = validity(obligations);
+    format!("{} {:?}", v.obligations.len(), v)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn sorted() {
+        assert_eq!(
+            sorted_debug(4, 9),
+            "[Literal(4), Literal(9), Source(Axis { scope: 9, load: 7, axis: 0 }), Source(Scalar { scope: 4, node: 1 }), Product([Source(Axis { scope: 4, load: 1, axis: 0 }), Literal(9)]), Product([Source(Axis { scope: 4, load: 1, axis: 0 }), Literal(9)]), Product([Source(Axis { scope: 4, load: 1, axis: 0 }), Literal(9), Source(Scalar { scope: 4, node: 3 })]), Product([Source(Axis { scope: 4, load: 1, axis: 0 }), Product([Literal(4)])]), ExactQuotient { dividend: Source(Axis { scope: 4, load: 2, axis: 0 }), divisor: Literal(4) }, ExactQuotient { dividend: Source(Axis { scope: 4, load: 2, axis: 0 }), divisor: Literal(9) }]"
+        );
+        assert_eq!(
+            sorted_debug(9, 4),
+            "[Literal(4), Literal(9), Source(Axis { scope: 4, load: 7, axis: 0 }), Source(Scalar { scope: 9, node: 1 }), Product([Source(Axis { scope: 9, load: 1, axis: 0 }), Literal(4)]), Product([Source(Axis { scope: 9, load: 1, axis: 0 }), Literal(4)]), Product([Source(Axis { scope: 9, load: 1, axis: 0 }), Literal(4), Source(Scalar { scope: 9, node: 3 })]), Product([Source(Axis { scope: 9, load: 1, axis: 0 }), Product([Literal(9)])]), ExactQuotient { dividend: Source(Axis { scope: 9, load: 2, axis: 0 }), divisor: Literal(4) }, ExactQuotient { dividend: Source(Axis { scope: 9, load: 2, axis: 0 }), divisor: Literal(9) }]"
+        );
+    }
+
+    #[test]
+    fn comparisons() {
+        let expected: [[u32; 10]; 10] = [
+            [221001, 330101, 330101, 330101, 330101, 330101, 330101, 330101, 330101, 330101],
+            [110110, 221001, 330101, 330101, 330101, 110110, 110110, 330101, 330101, 330101],
+            [110110, 110110, 221001, 110110, 110110, 110110, 110110, 110110, 330101, 110110],
+            [110110, 110110, 330101, 221001, 330101, 110110, 110110, 330101, 330101, 221001],
+            [110110, 110110, 330101, 110110, 221001, 110110, 110110, 330101, 330101, 110110],
+            [110110, 330101, 330101, 330101, 330101, 221001, 330101, 330101, 330101, 330101],
+            [110110, 330101, 330101, 330101, 330101, 110110, 221001, 330101, 330101, 330101],
+            [110110, 110110, 330101, 110110, 110110, 110110, 110110, 221001, 330101, 110110],
+            [110110, 110110, 110110, 110110, 110110, 110110, 110110, 110110, 221001, 110110],
+            [110110, 110110, 330101, 221001, 330101, 110110, 110110, 330101, 330101, 221001],
+        ];
+        for (i, row) in expected.iter().enumerate() {
+            assert_eq!(compare_row(4, 9, i), row.to_vec());
+        }
+    }
+
+    #[test]
+    fn clones() {
+        assert_eq!(
+            clone_max_min(4, 9),
+            "true Product([Source(Axis { scope: 4, load: 1, axis: 0 }), Literal(9), Source(Scalar { scope: 4, node: 3 })]) Product([Source(Axis { scope: 4, load: 1, axis: 0 }), Literal(9)])"
+        );
+    }
+
+    #[test]
+    fn validity_domain() {
+        assert_eq!(
+            validity_debug(4, 9),
+            "4 Validity { obligations: [NonZero(Product([Literal(9), Source(Scalar { scope: 4, node: 1 })])), NonZero(ExactQuotient { dividend: Source(Axis { scope: 4, load: 2, axis: 0 }), divisor: Literal(9) }), DividesEvenly { dividend: Source(Axis { scope: 4, load: 2, axis: 0 }), divisor: Literal(9) }, DividesEvenly { dividend: Source(Axis { scope: 4, load: 2, axis: 0 }), divisor: Product([Literal(9), Source(Scalar { scope: 4, node: 1 })]) }] }"
+        );
+    }
+}
