+#guard arity 12 == some (some (3, 1))
+#guard arity 10 == some none
+#guard arity 13 == some none
+
+/-- `count_matches` on the model: the total and the counter given back -/
+def count (ctor visited : Nat) : Option (Nat × Nat) :=
+  match count_matches defs (u32' ctor) (u32' visited) with
+  | ok (total, visited) => some (total.val, visited.val)
+  | _ => none
+
+-- native `count`
+#guard count 10 5 == some (9, 8)
+#guard count 13 8 == some (0, 11)
+
