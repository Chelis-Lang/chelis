diff --git a/tests/src/closure-clause-regions.rs b/tests/src/closure-clause-regions.rs
new file mode 100644
index 0000000..a00634b
--- /dev/null
+++ b/tests/src/closure-clause-regions.rs
@@ -0,0 +1,84 @@
+//@ [!lean] skip
+//@ [lean] subdir=ClosureClauseRegions
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::iter::adapters::map::Map --include core::iter::adapters::rev::Rev
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! A closure defined in a function generic over its visitor, as in
+//! `chelis_deep::literal_source::visit_binder_literal_uses`: the closure type
+//! `closure<'a, V>` keeps the clause `V: FnMut(u32, Option<&'a str>)` of its
+//! parent (closure types keep their clauses), and its trait reference in the
+//! signatures of the closure methods proves it. Charon resolved that clause
+//! with erased lifetimes, so the predicate of the trait reference had lost
+//! `'a` (`V: FnMut(u32, Option<&'_ str>)`) and Aeneas rejected the closure
+//! methods ("Expected a runtime region type").
+//! `ClosureClauseRegions/Checks.lean` evaluates the model on the inputs of the
+//! `native` test module below and compares with the native results, including
+//! the visitor state given back by `visit_leaves`.
+
+pub enum Expr {
+    Leaf(u32),
+    Node(Vec<Expr>),
+}
+
+/// Visit the leaves, depth first, with the name of the node they come from
+pub fn visit_leaves<'a>(expr: &'a Expr, visitor: &mut impl FnMut(u32, Option<&'a str>)) {
+    let mut stack: Vec<(&'a Expr, Option<&'a str>)> = Vec::new();
+    stack.push((expr, None));
+    while let Some((e, name)) = stack.pop() {
+        match e {
+            Expr::Leaf(v) => visitor(*v, name),
+            Expr::Node(children) => {
+                stack.extend(children.iter().rev().map(|child| (child, Some("node"))))
+            }
+        }
+    }
+}
+
+/// The sum of the leaves, and the number of leaves inside a node
+pub fn sum_leaves(e: &Expr) -> (u32, u32) {
+    let mut sum = 0;
+    let mut inside = 0;
+    visit_leaves(e, &mut |v, name| {
+        sum += v;
+        if name.is_some() {
+            inside += 1;
+        }
+    });
+    (sum, inside)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn leaves() {
+        assert_eq!(sum_leaves(&Expr::Leaf(4)), (4, 0));
+        let e = Expr::Node(vec![
+            Expr::Leaf(1),
+            Expr::Node(vec![Expr::Leaf(2), Expr::Leaf(3)]),
+            Expr::Node(vec![]),
+        ]);
+        assert_eq!(sum_leaves(&e), (6, 3));
+    }
+
+    /// The visitor state given back by `visit_leaves`, from a nonzero start
+    #[test]
+    fn visitor_state() {
+        let tree = Expr::Node(vec![
+            Expr::Leaf(1),
+            Expr::Node(vec![Expr::Leaf(2), Expr::Leaf(3)]),
+            Expr::Node(vec![]),
+        ]);
+        let leaf = Expr::Leaf(4);
+        for (e, start, end) in [(&tree, (10, 20), (16, 23)), (&leaf, (1, 1), (5, 1))] {
+            let (mut sum, mut inside) = start;
+            visit_leaves(e, &mut |v, name| {
+                sum += v;
+                if name.is_some() {
+                    inside += 1;
+                }
+            });
+            assert_eq!((sum, inside), end);
+        }
+    }
+}
diff --git a/tests/src/closure-returns-closure.rs b/tests/src/closure-returns-closure.rs
new file mode 100644
index 0000000..2bb36da
--- /dev/null
+++ b/tests/src/closure-returns-closure.rs
@@ -0,0 +1,89 @@
+//@ [!lean] skip
+//@ [lean] subdir=ClosureReturnsClosure
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::iter::adapters::filter_map::FilterMap --include core::option::{core::ops::try_trait::Try} --include core::option::{core::ops::try_trait::FromResidual}
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! A closure returning a closure it creates, as in
+//! `chelis_ir::adt::lookup_variant_terminal_unique`: the `flat_map` closure
+//! returns `FilterMap<Iter<'_, Variant>, F>` where the inner closure `F`
+//! captures `adt` (an argument of the outer closure) and `ctor` (captured by
+//! the outer closure). In the signature of the outer closure's methods,
+//! Charon left the lifetimes of the inner closure type erased
+//! (`closure<'_, '_>`), and Aeneas rejected both methods ("Expected a runtime
+//! region type"). `ClosureReturnsClosure/Checks.lean` evaluates the model on
+//! the inputs of the `native` test module below and compares with the native
+//! results, including the counter given back by `count_matches`.
+
+pub struct Variant {
+    pub name: u32,
+    pub arity: u32,
+}
+
+pub struct Def {
+    pub variants: Vec<Variant>,
+}
+
+/// The only (definition, variant) pair whose variant is named `ctor`
+pub fn lookup_unique<'a>(defs: &'a [(u32, Def)], ctor: &u32) -> Option<(&'a u32, &'a Variant)> {
+    let mut matches = defs.iter().flat_map(|(adt, def)| {
+        def.variants
+            .iter()
+            .filter_map(move |variant| (variant.name == *ctor).then_some((adt, variant)))
+    });
+    let first = matches.next()?;
+    matches.next().is_none().then_some(first)
+}
+
+/// The definition and the arity of the only variant named `ctor`
+pub fn unique_arity(defs: &[(u32, Def)], ctor: u32) -> Option<(u32, u32)> {
+    let (adt, variant) = lookup_unique(defs, &ctor)?;
+    Some((*adt, variant.arity))
+}
+
+/// The sum of the definition and the arity of every variant named `ctor`;
+/// `visited` counts the definitions the outer closure visits
+pub fn count_matches(defs: &[(u32, Def)], ctor: u32, visited: &mut u32) -> u32 {
+    let mut total = 0;
+    let matches = defs.iter().flat_map(|(adt, def)| {
+        *visited += 1;
+        def.variants
+            .iter()
+            .filter_map(move |variant| (variant.name == ctor).then_some((adt, variant)))
+    });
+    for (adt, variant) in matches {
+        total += *adt + variant.arity;
+    }
+    total
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    fn defs() -> Vec<(u32, Def)> {
+        let variant = |name, arity| Variant { name, arity };
+        vec![
+            (1, Def { variants: vec![variant(10, 2), variant(11, 0)] }),
+            (2, Def { variants: vec![] }),
+            (3, Def { variants: vec![variant(12, 1), variant(10, 3)] }),
+        ]
+    }
+
+    #[test]
+    fn lookup() {
+        let defs = defs();
+        assert_eq!(unique_arity(&defs, 11), Some((1, 0)));
+        assert_eq!(unique_arity(&defs, 12), Some((3, 1)));
+        assert_eq!(unique_arity(&defs, 10), None);
+        assert_eq!(unique_arity(&defs, 13), None);
+    }
+
+    #[test]
+    fn count() {
+        let defs = defs();
+        let mut visited = 5;
+        assert_eq!(count_matches(&defs, 10, &mut visited), 9);
+        assert_eq!(visited, 8);
+        assert_eq!(count_matches(&defs, 13, &mut visited), 0);
+        assert_eq!(visited, 11);
+    }
+}
diff --git a/tests/src/lifted-assoc-regions.rs b/tests/src/lifted-assoc-regions.rs
new file mode 100644
index 0000000..ed6a853
--- /dev/null
+++ b/tests/src/lifted-assoc-regions.rs
@@ -0,0 +1,95 @@
+//@ [!lean] skip
+//@ [lean] subdir=LiftedAssocRegions
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! A method returning `impl Iterator` over the maps of a borrowed optional
+//! box, as `chelis_deep::annotations::Metadata::values`. Its revealed return
+//! type is `FlatMap<option::Iter<'a, Box<Storage>>, Values<'a, u32, u64>, F>`,
+//! with the associated types `U::Item = &'a u64` and
+//! `U::IntoIter = Values<'a, u32, u64>` of its `U: IntoIterator` clause lifted
+//! as type arguments. Charon computed them from the impl proving the clause,
+//! which is resolved with erased lifetimes, so they had lost `'a`
+//! (`&'_ u64`, `Values<'_, u32, u64>`) and Aeneas rejected both the signature
+//! ("Expected a runtime region type") and the body of `values`.
+//! `LiftedAssocRegions/Checks.lean` evaluates the model on the inputs of the
+//! `native` test module below and compares with the native results, including
+//! the metadata given back by `record_total`.
+
+use std::collections::BTreeMap;
+
+pub struct Storage {
+    core: BTreeMap<u32, u64>,
+}
+
+pub struct Metadata {
+    storage: Option<Box<Storage>>,
+}
+
+impl Metadata {
+    pub fn new() -> Self {
+        Metadata { storage: None }
+    }
+
+    pub fn insert(&mut self, key: u32, value: u64) {
+        match &mut self.storage {
+            Some(storage) => {
+                storage.core.insert(key, value);
+            }
+            None => {
+                let mut map = BTreeMap::new();
+                map.insert(key, value);
+                self.storage = Some(Box::new(Storage { core: map }));
+            }
+        }
+    }
+
+    pub fn values(&self) -> impl Iterator<Item = &u64> {
+        self.storage.iter().flat_map(|s| s.core.values())
+    }
+}
+
+/// The sum of the values, visited through `values`
+pub fn total(metadata: &Metadata) -> u64 {
+    let mut total = 0;
+    for value in metadata.values() {
+        total += *value;
+    }
+    total
+}
+
+/// The values, in the order `values` visits them
+pub fn visited(metadata: &Metadata) -> Vec<u64> {
+    let mut out = Vec::new();
+    for value in metadata.values() {
+        out.push(*value);
+    }
+    out
+}
+
+/// Record the sum of the values under `key`, and return it
+pub fn record_total(metadata: &mut Metadata, key: u32) -> u64 {
+    let total = total(metadata);
+    metadata.insert(key, total);
+    total
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn values() {
+        let mut metadata = Metadata::new();
+        assert_eq!(total(&metadata), 0);
+        assert_eq!(record_total(&mut metadata, 7), 0);
+        assert_eq!(visited(&metadata), vec![0]);
+        metadata.insert(3, 5);
+        metadata.insert(9, 11);
+        assert_eq!(total(&metadata), 16);
+        assert_eq!(record_total(&mut metadata, 1), 16);
+        assert_eq!(visited(&metadata), vec![16, 5, 0, 11]);
+        assert_eq!(record_total(&mut metadata, 3), 32);
+        assert_eq!(visited(&metadata), vec![16, 32, 0, 11]);
+        assert_eq!(total(&metadata), 59);
+    }
+}
