+/-- The definitions of the native test -/
+def defs : Slice (U32 × Def) :=
+  slice [(u32' 1, { variants := vec [variant 10 2, variant 11 0] }),
+         (u32' 2, { variants := vec [] }),
+         (u32' 3, { variants := vec [variant 12 1, variant 10 3] })]
