+import ClosureClauseRegions.ClosureClauseRegions
+
+/-! Evaluate the model of `tests/src/closure-clause-regions.rs` on the inputs
+    of its `native` test module and compare with the native results, including
+    the visitor state given back by `visit_leaves`. -/
+
+namespace closure_clause_regions.checks
+open Aeneas Aeneas.Std Result
+
+def u32' (n : Nat) : U32 := ⟨BitVec.ofNat _ n⟩
+
+def vec {α} (xs : List α) (h : xs.length ≤ Usize.max := by scalar_tac) : alloc.vec.Vec α := ⟨xs, h⟩
+
+def leaf (n : Nat) : Expr := Expr.Leaf (u32' n)
+
+def node (xs : List Expr) (h : xs.length ≤ Usize.max := by scalar_tac) : Expr :=
+  Expr.Node (vec xs h).toNested
+
+/-- `Node([Leaf(1), Node([Leaf(2), Leaf(3)]), Node([])])` -/
+def tree : Expr := node [leaf 1, node [leaf 2, leaf 3], node []]
+
+/-- `sum_leaves` on the model: the sum and the count read back from the
+    closure state that `visit_leaves` gives back -/
+def sums (e : Expr) : Option (Nat × Nat) :=
+  match sum_leaves e with
+  | ok (s, i) => some (s.val, i.val)
+  | _ => none
+
+-- native `leaves`
+#guard sums (leaf 4) == some (4, 0)
+#guard sums tree == some (6, 3)
+
+/-- The generic `visit_leaves` with the closure of `sum_leaves` as visitor,
+    started from the captured state `(sum, inside)`: the state given back -/
+def visit (e : Expr) (sum inside : Nat) : Option (Nat × Nat) :=
+  match visit_leaves sum_leaves.closure.Insts.CoreOpsFunctionFnMutPairU32OptionSharedStrTuple e
+      (u32' sum, u32' inside) with
+  | ok (s, i) => some (s.val, i.val)
+  | _ => none
+
+-- native `visitor_state`
+#guard visit tree 10 20 == some (16, 23)
+#guard visit (leaf 4) 1 1 == some (5, 1)
+
+end closure_clause_regions.checks
