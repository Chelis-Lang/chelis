+import LiftedAssocRegions.LiftedAssocRegions
+
+/-! Evaluate the model of `tests/src/lifted-assoc-regions.rs` on the inputs of
+    its `native` test module and compare with the native results, including
+    the metadata given back by `record_total` (its values, in the order
+    `values` visits them). -/
+
+namespace lifted_assoc_regions.checks
+open Aeneas Aeneas.Std Result
+
+def u32' (n : Nat) : U32 := ⟨BitVec.ofNat _ n⟩
+def u64' (n : Nat) : U64 := ⟨BitVec.ofNat _ n⟩
+
+/-- `insert` on the model -/
+def ins (m : Metadata) (k v : Nat) : Option Metadata :=
+  match Metadata.insert m (u32' k) (u64' v) with
+  | ok m' => some m'
+  | _ => none
+
+/-- `total` on the model -/
+def tot (m : Metadata) : Option Nat :=
+  match total m with
+  | ok t => some t.val
+  | _ => none
+
+/-- `visited` on the model: the values in the order `values` visits them -/
+def vis (m : Metadata) : Option (List Nat) :=
+  match visited m with
+  | ok v => some (v.val.map (·.val))
+  | _ => none
+
+/-- `record_total` on the model: the result and the metadata given back -/
+def rec (m : Metadata) (k : Nat) : Option (Nat × Metadata) :=
+  match record_total m (u32' k) with
+  | ok (t, m') => some (t.val, m')
+  | _ => none
+
+def empty : Metadata := { storage := none }
+
+#guard tot empty == some 0
+#guard vis empty == some []
+
+/-- The native test, step by step: each observed result, then the values of
+    the final metadata. -/
+def native : Option (List Nat) := do
+  let m := empty
+  let t0 ← tot m
+  let (r0, m) ← rec m 7
+  let v0 ← vis m
+  let m ← ins m 3 5
+  let m ← ins m 9 11
+  let t1 ← tot m
+  let (r1, m) ← rec m 1
+  let v1 ← vis m
+  let (r2, m) ← rec m 3
+  let v2 ← vis m
+  let t2 ← tot m
+  some ([t0, r0] ++ v0 ++ [t1, r1] ++ v1 ++ [r2] ++ v2 ++ [t2])
+
+-- native: 0, 0, [0], 16, 16, [16, 5, 0, 11], 32, [16, 32, 0, 11], 59
+#guard native == some [0, 0, 0, 16, 16, 16, 5, 0, 11, 32, 16, 32, 0, 11, 59]
+
+end lifted_assoc_regions.checks
