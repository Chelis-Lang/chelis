+/-!
+# Monotonicity of the models in their trait instances
+
+The methods of a type which is recursive through a collection (`Vec<Self>`,
+`Option<Box<Self>>`, `BTreeMap<K, Self>`, ...) call the model of the
+collection's trait implementation with an instance built from the method being
+defined, e.g. the derived `Clone` of `enum T { Node(Vec<T>) }` is
+
+```
+def T.clone (self : T) : Result T := do
+  match self with
+  | .Node v => ... alloc.vec.CloneVec.clone { clone := T.clone } v ...
+partial_fixpoint
+```
+
+`partial_fixpoint` needs the body to be monotone in the recursive function,
+so the monotonicity prover needs to know that every such model is monotone in
+the methods of its instance arguments. The lemmas below state this for the
+models of the implementations of the derivable traits (`Clone`, `PartialEq`,
+`Debug`) on containers. Each instance argument is a structure literal whose
+fields all depend on the recursive function `g`; the hypotheses only concern
+the fields the model calls (e.g. `PartialEq for [T]` compares with `ne`).
+Each lemma comes in the forms the derived code produces: the model applied to
+its instances only (when it is itself a field of an enclosing instance, e.g.
+`PartialEqShared (PartialEqVec {..})`) and fully applied (the discrimination
+tree keys of the monotonicity lemmas include the number of arguments).
+-/
+
+namespace Aeneas.Std
+
+open Lean.Order
+
+section CloneMono
+
+variable {γ : Type w} [Lean.Order.PartialOrder γ]
+
+/-- `List.clone` is the element-wise fallible map; its length proof is carried by
+    the result. -/
+theorem List.clone_eq_bind {α : Type u} (c : α → Result α) (l : List α) :
+    List.clone c l = (List.mapM c l >>= fun v =>
+      if h : v.length = l.length then .ok ⟨v, h⟩ else .div) := by
+  unfold List.clone
+  split
+  · rename_i v h
+    simp [h, List.mapM_Result_length h]
+  · rename_i h; simp [h]
+  · rename_i h; simp [h]
+
+@[partial_fixpoint_monotone]
+theorem List.clone.monotone {α : Type u} (c : γ → α → Result α) (l : List α)
+    (hmono : Lean.Order.monotone c) : Lean.Order.monotone (fun g => List.clone (c g) l) := by
+  simp only [List.clone_eq_bind]
+  exact monotone_bind Result _ _ (List.monotone_mapM c l hmono) (monotone_const _)
+
+@[partial_fixpoint_monotone]
+theorem Slice.clone.monotone {α : Type} (c : γ → α → Result α) (s : Slice α)
+    (hmono : Lean.Order.monotone c) : Lean.Order.monotone (fun g => Slice.clone (c g) s) :=
+  monotone_bind Result _ _ (List.clone.monotone c s.val hmono) (monotone_const _)
+
+@[partial_fixpoint_monotone]
+theorem Array.clone.monotone {α : Type u} {n : Usize} (c : γ → α → Result α) (s : Array α n)
+    (hmono : Lean.Order.monotone c) : Lean.Order.monotone (fun g => Array.clone (c g) s) :=
+  monotone_bind Result _ _ (List.clone.monotone c s.val hmono) (monotone_const _)
+
