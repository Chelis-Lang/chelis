+@[partial_fixpoint_monotone]
+theorem alloc.collections.btree.map.BTreeMap.clone.apply_monotone {K V : Type}
+    (kclone : γ → K → Result K) (kclone_from : γ → K → K → Result K)
+    (vclone : γ → V → Result V) (vclone_from : γ → V → V → Result V)
+    (map : alloc.collections.btree.map.BTreeMap K V)
+    (hk : Lean.Order.monotone kclone) (hv : Lean.Order.monotone vclone) :
+    Lean.Order.monotone (fun g => alloc.collections.btree.map.BTreeMap.clone
