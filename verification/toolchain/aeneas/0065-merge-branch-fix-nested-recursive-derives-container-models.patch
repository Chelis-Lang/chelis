+@[partial_fixpoint_monotone]
+theorem core.fmt.DebugPair.fmt.apply_fmt_monotone {A B : Type} (ca : γ → A → Callback)
+    (cb : γ → B → Callback) (x : A × B) (fmt : Formatter)
+    (ha : Lean.Order.monotone ca) (hb : Lean.Order.monotone cb) :
+    Lean.Order.monotone (fun g => DebugPair.fmt ⟨ca g⟩ ⟨cb g⟩ x fmt) := by
+  refine Formatter.debugTuple.values_monotone fmt ""
+    (fun g (b : Bool) => if b then (⟨A, ⟨ca g⟩, x.1⟩ : DebugValue) else ⟨B, ⟨cb g⟩, x.2⟩)
+    [true, false] ?_
+  intro b _
+  cases b
+  · exact monotone_apply x.2 _ hb
+  · exact monotone_apply x.1 _ ha
+
