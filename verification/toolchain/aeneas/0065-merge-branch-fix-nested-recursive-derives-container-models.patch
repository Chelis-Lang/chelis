+//@ [!lean] skip
+//@ [lean] subdir=NestedRecursiveDerives
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Derived `Clone`, `PartialEq` and `Debug` of types which are recursive through
+//! `Vec`, `Option<Box<_>>` and `BTreeMap`: the derived methods recurse through
+//! the models of the collections' trait implementations, called with an
+//! instance built from the method being defined, directly or through the
+//! derived methods of a generic type. The Lean definitions are
+//! `partial_fixpoint`s, whose monotonicity goes through those models.
+//! `NestedRecursiveDerives/Checks.lean` evaluates the model on the inputs of
+//! the `native` test module below and compares with the native results.
+
+use std::collections::BTreeMap;
+
+#[derive(Clone, PartialEq, Debug)]
+pub enum Tree {
+    Leaf(u32),
+    Node(Vec<Tree>),
+    Opt(Option<Box<Tree>>),
+}
+
+/// Not recursive itself: holds the recursive type in a vector inside a map
+#[derive(Clone, PartialEq, Debug)]
+pub struct Env {
+    pub scopes: BTreeMap<u32, Vec<Tree>>,
+    pub depth: u32,
+}
+
+/// Recursive through a map
+#[derive(Clone, PartialEq, Debug)]
+pub enum Scope {
+    Leaf(u32),
+    Nest(BTreeMap<u32, Scope>),
+}
+
+/// Generic recursive type (the shape of `HostExprKind<T>`): the instance of the
+/// collection model is built from the method applied to the caller's instance
+#[derive(Clone, PartialEq, Debug)]
+pub enum Term<A> {
+    Val(A),
+    Call(u32, Vec<Term<A>>),
+    Maybe(Option<Box<Term<A>>>),
+}
+
+/// A generic, non-recursive type whose derived methods are called with the
+/// methods of a recursive type (`Wrapper<Doc>`)
+#[derive(Clone, PartialEq, Debug)]
+pub struct Wrapper<T> {
+    pub items: Vec<T>,
+    pub tag: u32,
+}
+
+#[derive(Clone, PartialEq, Debug)]
+pub enum Doc {
+    Text(u32),
+    Block(Wrapper<Doc>),
+}
+
+/// Mutually recursive pair (the shape of `HostExpr`/`HostExprKind`)
+#[derive(Clone, PartialEq, Debug)]
+pub struct Expr {
+    pub kind: ExprKind,
+    pub span: u32,
+}
+
+#[derive(Clone, PartialEq, Debug)]
+pub enum ExprKind {
+    Lit(u32),
+    Tuple(Vec<Expr>),
+    Guard(Box<Expr>, Option<Box<Expr>>),
+}
+
+pub fn sum(t: &Tree) -> u32 {
+    match t {
+        Tree::Leaf(n) => *n,
+        Tree::Node(children) => {
+            let mut s = 0u32;
+            let mut i = 0;
+            while i < children.len() {
+                s = s.wrapping_add(sum(&children[i]));
+                i += 1;
+            }
+            s
+        }
+        Tree::Opt(Some(t)) => sum(t),
+        Tree::Opt(None) => 0,
+    }
+}
+
+pub fn bump(t: &mut Tree) {
+    match t {
+        Tree::Leaf(n) => *n = n.wrapping_add(1),
+        Tree::Node(children) => {
+            let mut i = 0;
+            while i < children.len() {
+                bump(&mut children[i]);
+                i += 1;
+            }
+        }
+        Tree::Opt(Some(t)) => bump(t),
+        Tree::Opt(None) => {}
+    }
+}
+
+pub fn sample(a: u32, b: u32) -> Tree {
+    let mut inner = Vec::new();
+    inner.push(Tree::Leaf(b));
+    inner.push(Tree::Opt(None));
+    let mut children = Vec::new();
+    children.push(Tree::Leaf(a));
+    children.push(Tree::Node(inner));
+    children.push(Tree::Opt(Some(Box::new(Tree::Leaf(a.wrapping_add(b))))));
+    Tree::Node(children)
+}
+
+/// Clone, then change the copy only
+pub fn tree_clone_scenario(a: u32, b: u32) -> u32 {
+    let t = sample(a, b);
+    let mut c = t.clone();
+    bump(&mut c);
+    let mut r = sum(&t).wrapping_mul(1000).wrapping_add(sum(&c));
+    if t == c {
+        r = r.wrapping_add(1_000_000);
+    }
+    if t == t.clone() {
+        r = r.wrapping_add(10_000_000);
+    }
+    if t != sample(a, b.wrapping_add(1)) {
+        r = r.wrapping_add(100_000_000);
+    }
+    r
+}
+
+pub fn tree_debug(a: u32, b: u32) -> String {
+    format!("{:?}", sample(a, b))
+}
+
+pub fn env_scenario(a: u32) -> u32 {
+    let mut scopes = BTreeMap::new();
+    let mut v = Vec::new();
+    v.push(sample(a, 1));
+    scopes.insert(1, v);
+    scopes.insert(2, Vec::new());
+    let env = Env { scopes, depth: 3 };
+    let mut copy = env.clone();
+    let mut r = 0u32;
+    if copy == env {
+        r += 1;
+    }
+    copy.depth = 4;
+    if copy != env {
+        r += 10;
+    }
+    let mut copy2 = env.clone();
+    copy2.scopes.insert(2, Vec::new());
+    if copy2 == env {
+        r += 100;
+    }
+    copy2.scopes.insert(3, Vec::new());
+    if copy2 == env {
+        r += 1000;
+    }
+    r
+}
+
+pub fn env_debug(a: u32) -> String {
+    let mut scopes = BTreeMap::new();
+    let mut v = Vec::new();
+    v.push(Tree::Leaf(a));
+    scopes.insert(7, v);
+    format!("{:?}", Env { scopes, depth: 1 })
+}
+
+/// Pretty (`{:#?}`) output of a map entry holding a vector of the recursive type
+pub fn env_pretty(a: u32) -> String {
+    let mut scopes = BTreeMap::new();
+    let mut v = Vec::new();
+    v.push(Tree::Leaf(a));
+    scopes.insert(7, v);
+    scopes.insert(8, Vec::new());
+    format!("{:#?}", Env { scopes, depth: 1 })
+}
+
+pub fn scope_depth(s: &Scope) -> u32 {
+    match s {
+        Scope::Leaf(_) => 0,
+        Scope::Nest(m) => {
+            let mut d = 0u32;
+            for (_, v) in m.iter() {
+                let x = scope_depth(v);
+                if x > d {
+                    d = x;
+                }
+            }
+            d + 1
+        }
+    }
+}
+
+pub fn scope_scenario(a: u32) -> u32 {
+    let mut inner = BTreeMap::new();
+    inner.insert(0, Scope::Leaf(a));
+    let mut outer = BTreeMap::new();
+    outer.insert(a, Scope::Nest(inner));
+    outer.insert(a.wrapping_add(1), Scope::Leaf(1));
+    let s = Scope::Nest(outer);
+    let c = s.clone();
+    let mut r = scope_depth(&c);
+    if c == s {
+        r += 10;
+    }
+    if c != Scope::Leaf(a) {
+        r += 100;
+    }
+    r
+}
+
+pub fn scope_debug(a: u32) -> String {
+    let mut m = BTreeMap::new();
+    m.insert(a, Scope::Leaf(a));
+    format!("{:?}", Scope::Nest(m))
+}
+
+pub fn term_size<A>(t: &Term<A>) -> u32 {
+    match t {
+        Term::Val(_) => 1,
+        Term::Call(_, args) => {
+            let mut s = 1u32;
+            let mut i = 0;
+            while i < args.len() {
+                s = s.wrapping_add(term_size(&args[i]));
+                i += 1;
+            }
+            s
+        }
+        Term::Maybe(Some(t)) => 1 + term_size(t),
+        Term::Maybe(None) => 1,
+    }
+}
+
+pub fn term_scenario(a: u32) -> u32 {
+    let mut args = Vec::new();
+    args.push(Term::Val(a));
+    args.push(Term::Maybe(Some(Box::new(Term::Val(a + 1)))));
+    args.push(Term::Maybe(None));
+    let t: Term<u32> = Term::Call(5, args);
+    let c = t.clone();
+    let mut r = term_size(&c);
+    if c == t {
+        r += 100;
+    }
+    if c != Term::Call(5, Vec::new()) {
+        r += 1000;
+    }
+    r
+}
+
+pub fn term_debug(a: u32) -> String {
+    let mut args = Vec::new();
+    args.push(Term::Val(a));
+    args.push(Term::Maybe(None));
+    format!("{:?}", Term::Call(2, args))
+}
+
+pub fn doc_scenario(n: u32) -> u32 {
+    let mut items = Vec::new();
+    items.push(Doc::Text(n));
+    items.push(Doc::Block(Wrapper {
+        items: Vec::new(),
+        tag: 2,
+    }));
+    let d = Doc::Block(Wrapper { items, tag: 1 });
+    let c = d.clone();
+    let mut r = 0u32;
+    if c == d {
+        r += 1;
+    }
+    if c != Doc::Text(n) {
+        r += 10;
+    }
+    r
+}
+
+pub fn doc_debug(n: u32) -> String {
+    let mut items = Vec::new();
+    items.push(Doc::Text(n));
+    format!("{:?}", Doc::Block(Wrapper { items, tag: 1 }))
+}
+
+pub fn expr_scenario(a: u32) -> u32 {
+    let lit = Expr {
+        kind: ExprKind::Lit(a),
+        span: 1,
+    };
+    let mut items = Vec::new();
+    items.push(lit.clone());
+    items.push(Expr {
+        kind: ExprKind::Guard(Box::new(lit.clone()), None),
+        span: 2,
+    });
+    let e = Expr {
+        kind: ExprKind::Guard(
+            Box::new(Expr {
+                kind: ExprKind::Tuple(items),
+                span: 3,
+            }),
+            Some(Box::new(lit)),
+        ),
+        span: 4,
+    };
+    let c = e.clone();
+    let mut r = 0u32;
+    if c == e {
+        r += 1;
+    }
+    let mut d = e.clone();
+    d.span = 5;
+    if d != e {
+        r += 10;
+    }
+    r
+}
+
+pub fn expr_debug(a: u32) -> String {
+    let lit = Expr {
+        kind: ExprKind::Lit(a),
+        span: 1,
+    };
+    let mut items = Vec::new();
+    items.push(lit.clone());
+    format!(
+        "{:?}",
+        Expr {
+            kind: ExprKind::Guard(
+                Box::new(Expr {
+                    kind: ExprKind::Tuple(items),
+                    span: 3
+                }),
+                Some(Box::new(lit))
+            ),
+            span: 4,
+        }
+    )
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn trees() {
+        assert_eq!(tree_clone_scenario(2, 3), 110010013);
+        assert_eq!(tree_clone_scenario(0, 0), 110000003);
+        assert_eq!(
+            tree_debug(2, 3),
+            "Node([Leaf(2), Node([Leaf(3), Opt(None)]), Opt(Some(Leaf(5)))])"
+        );
+    }
+
+    #[test]
+    fn envs() {
+        assert_eq!(env_scenario(4), 111);
+        assert_eq!(env_debug(9), "Env { scopes: {7: [Leaf(9)]}, depth: 1 }");
+        assert_eq!(
+            env_pretty(9),
+            "Env {\n    scopes: {\n        7: [\n            Leaf(\n                9,\n            ),\n        ],\n        8: [],\n    },\n    depth: 1,\n}"
+        );
+    }
+
+    #[test]
+    fn scopes() {
+        assert_eq!(scope_scenario(3), 112);
+        assert_eq!(scope_debug(6), "Nest({6: Leaf(6)})");
+    }
+
+    #[test]
+    fn terms() {
+        assert_eq!(term_scenario(3), 1105);
+        assert_eq!(term_debug(8), "Call(2, [Val(8), Maybe(None)])");
+    }
+
+    #[test]
+    fn docs() {
+        assert_eq!(doc_scenario(5), 11);
+        assert_eq!(doc_debug(5), "Block(Wrapper { items: [Text(5)], tag: 1 })");
+    }
+
+    #[test]
+    fn exprs() {
+        assert_eq!(expr_scenario(3), 11);
+        assert_eq!(
+            expr_debug(3),
+            "Expr { kind: Guard(Expr { kind: Tuple([Expr { kind: Lit(3), span: 1 }]), span: 3 }, \
+             Some(Expr { kind: Lit(3), span: 1 })), span: 4 }"
+        );
+    }
+}
