+/-- The entries of a list rendered by a callback which depends monotonically on `g`. -/
+@[partial_fixpoint_monotone]
+theorem core.fmt.debugEntries.render_monotone {T : Type u} (pretty : Bool)
+    (render : γ → T → Callback) (l : List T) (hmono : Lean.Order.monotone render) :
+    Lean.Order.monotone (fun g => debugEntries pretty (render g) l) := by
+  induction l with
+  | nil => exact monotone_const _
+  | cons v rest ih =>
+    apply monotone_of_monotone_apply
+    intro fmt
+    simp only [debugEntries]
+    repeat' first
+      | exact ih
+      | exact monotone_apply _ _ (monotone_apply _ _ hmono)
+      | monotonicity
+
+/-- The entries of a list whose elements depend monotonically on `g`. -/
+theorem core.fmt.debugEntries.values_monotone {α : Type v} {T : Type u} (pretty : Bool)
+    (render : T → Callback) (elem : γ → α → T) (vs : List α)
+    (hmono : ∀ v ∈ vs, Lean.Order.monotone (fun g => render (elem g v))) :
+    Lean.Order.monotone (fun g => debugEntries pretty render (vs.map (elem g))) := by
+  induction vs with
+  | nil => exact monotone_const _
+  | cons v vs ih =>
+    have hv := hmono v List.mem_cons_self
+    have ih := ih (fun w hw => hmono w (List.mem_cons_of_mem _ hw))
+    apply monotone_of_monotone_apply
+    intro fmt
+    simp only [List.map_cons, debugEntries, List.isEmpty_map]
+    repeat' first
+      | exact ih
+      | exact monotone_apply _ _ hv
+      | monotonicity
+
+theorem core.fmt.Formatter.debugTuple.values_monotone {α : Type v} (fmt : Formatter)
+    (nm : String) (elem : γ → α → DebugValue) (vs : List α)
+    (hmono : ∀ v ∈ vs, Lean.Order.monotone (fun g => debugValue (elem g v))) :
+    Lean.Order.monotone (fun g => fmt.debugTuple nm (vs.map (elem g))) := by
+  simp only [Formatter.debugTuple, List.isEmpty_map, List.length_map]
+  repeat' first
+    | exact debugEntries.values_monotone _ debugValue elem vs hmono
+    | monotonicity
+
+theorem core.fmt.Formatter.debugStruct.values_monotone (fmt : Formatter) (nm : String)
+    (fields : List (String × (γ → DebugValue)))
+    (hmono : ∀ p ∈ fields, Lean.Order.monotone (fun g => debugValue (p.2 g))) :
+    Lean.Order.monotone (fun g => fmt.debugStruct nm (fields.map (fun p => (p.1, p.2 g)))) := by
+  have hfields : ∀ p ∈ fields, Lean.Order.monotone (fun g =>
+      (fun (x : String × DebugValue) (fmt : Formatter) =>
+        thenFormat (fmt.append (x.1 ++ ": ")) (debugValue x.2)) (p.1, p.2 g)) := by
+    intro p hp
+    dsimp only
+    apply monotone_of_monotone_apply
+    intro fmt'
+    exact thenFormat.monotone _ _ (monotone_const _) (hmono p hp)
+  simp only [Formatter.debugStruct, debugFields, List.isEmpty_map]
+  repeat' first
+    | exact debugEntries.values_monotone _ _ (fun g (p : String × (γ → DebugValue)) => (p.1, p.2 g))
+        fields hfields
+    | monotonicity
+
+@[partial_fixpoint_monotone]
+theorem core.fmt.Formatter.debugList.monotone {T : Type} (fmt : Formatter)
+    (callback : γ → T → Callback) (values : List T) (hmono : Lean.Order.monotone callback) :
+    Lean.Order.monotone (fun g => fmt.debugList ⟨callback g⟩ values) := by
+  simp only [Formatter.debugList]
+  repeat' first
+    | exact debugEntries.render_monotone _ callback values hmono
+    | monotonicity
