+/-- `Formatter::debug_map().entries(..).finish()` (core/src/fmt/builders.rs `DebugMap`):
+    `{`, the entries as `key: value` separated by `, ` (pretty: each entry on its own
+    indented line followed by `,`), then `}`. The key and the value of an entry are
+    written through the same pad adapter. -/
+def Formatter.debugMap {K V : Type} (fmt : Formatter) (keyInst : Debug K) (valueInst : Debug V)
+    (entries : List (K × V)) : Outcome :=
+  let pretty := fmt.options.bit 23 && !entries.isEmpty
+  thenFormat (fmt.append (if pretty then "{\n" else "{")) (fun f =>
+    thenFormat (f.indented (if pretty then fmt.indent + 4 else fmt.indent)
+      (debugEntries pretty (fun (key, value) fmt =>
+        thenFormat (keyInst.fmt key fmt) (fun fmt =>
+          thenFormat (fmt.append ": ") (valueInst.fmt value))) entries))
+      (fun f => f.append "}"))
+
 @[rust_fun "core::fmt::{core::fmt::Debug<&'0 @T>}::fmt"]
 def DebugShared.fmt {T : Type} (inst : Debug T) (x : T) (fmt : Formatter) : Outcome := inst.fmt x fmt
 @[reducible, rust_trait_impl "core::fmt::Debug<&'0 @T>"]
