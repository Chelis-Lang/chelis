+open Lean Meta Elab Tactic in
+/-- Fallback step of `aeneas_monotonicity`, for a goal `monotone (fun f => c args)` to
+    which no monotonicity lemma applies. If `c` is a non-recursive definition (e.g. the
+    derived method of a generic type, called with an instance built from the recursive
+    function `f`), unfold it once; if `c` is a structure projection, reduce it.
+    Recursive definitions (structural, well-founded, `partial_fixpoint`) and matchers
+    are never unfolded, so repeating this step terminates. -/
+elab "aeneas_unfold_monotone" : tactic => do
+  let goal ← getMainGoal
+  let unfolded? ← goal.withContext do
+    let type ← instantiateMVars (← goal.getType)
+    let_expr Lean.Order.monotone α inst_α β inst_β f := type
+      | throwError "aeneas_unfold_monotone: not a monotonicity goal"
+    let f := f.headBeta
+    unless f.isLambda do throwError "aeneas_unfold_monotone: not a lambda"
+    let some c := f.bindingBody!.getAppFn.constName?
+      | throwError "aeneas_unfold_monotone: no head constant"
+    let env ← getEnv
+    if (← isProjectionFn c) then return none
+    if isMatcherCore env c || (← isRecursiveDefinition c) ||
+        (Lean.Elab.PartialFixpoint.eqnInfoExt.find? env c).isSome then
+      throwError "aeneas_unfold_monotone: {c} is recursive or a matcher"
+    let f' ← lambdaBoundedTelescope f 1 fun xs b => do
+      let some b' ← unfoldDefinition? b
+        | throwError "aeneas_unfold_monotone: cannot unfold {c}"
+      mkLambdaFVars xs b'.headBeta
+    return some (← goal.replaceTargetDefEq (mkAppN type.getAppFn #[α, inst_α, β, inst_β, f']))
+  match unfolded? with
+  | some goal' =>
+    replaceMainGoal [goal']
+    evalTactic (← `(tactic| dsimp (config := { failIfUnchanged := false }) only))
+  | none => evalTactic (← `(tactic| dsimp only))
+
 open Aeneas.Std Lean.Order in
 /-- Normalize callback containers before monadic monotonicity: `Result.ok` has
-    flat equality, so its callback payload must be consumed before comparing it. -/
+    flat equality, so its callback payload must be consumed before comparing it.
+    Goals no monotonicity lemma applies to go through `aeneas_unfold_monotone`
+    (the monotonicity lemmas of the models taking trait instances are in
+    `Aeneas.Std.InstanceMonotonicity`). -/
