--- /dev/null
+++ b/tests/lean/ZipBorrowedAdapters/Checks.lean
@@ -0,0 +1,33 @@
+import ZipBorrowedAdapters.ZipBorrowedAdapters
+
+/-! Evaluate the model of `tests/src/zip-borrowed-adapters.rs` on the inputs of
+    its `native` test module and compare with the native results. -/
+
+namespace zip_borrowed_adapters.checks
+open Aeneas Aeneas.Std Result
+
+def us (x : Nat) : Usize := ⟨BitVec.ofNat _ x⟩
+
+def val {α} (f : α → β) : Result α → Option β
+  | ok x => some (f x)
+  | _ => none
+
+def show4 : Usize × Option Usize × Usize × Usize → Nat × Option Nat × Nat × Nat
+  | (c, n, l, r) => (c.val, n.map (·.val), l.val, r.val)
+
+def thenLeft (n m : Nat) := val show4 (zip_borrowed_count_then_left (us n) (us m))
+def thenRight (n m : Nat) := val show4 (zip_borrowed_count_then_right (us n) (us m))
+
+#guard thenLeft 4 2 == some (2, some 2, 3, 2)
+#guard thenLeft 2 4 == some (2, none, 2, 2)
+#guard thenLeft 0 3 == some (0, none, 0, 0)
+#guard thenLeft 3 3 == some (3, none, 3, 3)
+#guard thenLeft 3 0 == some (0, some 0, 1, 0)
+
+#guard thenRight 4 2 == some (2, none, 2, 2)
+#guard thenRight 2 4 == some (2, some 4, 2, 3)
+#guard thenRight 0 3 == some (0, some 0, 0, 1)
+#guard thenRight 3 3 == some (3, none, 3, 3)
+#guard thenRight 3 0 == some (0, none, 0, 0)
+
+end zip_borrowed_adapters.checks
