+//@ [!lean] skip
+//@ [lean] subdir=ZipBorrowedAdapters
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::iter::adapters::map::Map
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! `Iterator::zip` on mutable borrows of `Map` adapters whose closures capture
+//! `&mut` counters. The zip returns `Zip<&'a mut Map<I, F<'c>>, ..>`: a mutable
+//! borrow of `'c` nested under `'a` in the type arguments of a model type,
+//! while its inputs `&'a mut Map<I, F<'c>>` only have two levels. The region
+//! groups keep the two-level backward functions, so that the model state
+//! recovery of the zip constructor applies.
+
+pub fn zip_borrowed_count_then_left(n: usize, m: usize) -> (usize, Option<usize>, usize, usize) {
+    let mut left_calls = 0;
+    let mut right_calls = 0;
+    let (count, next) = {
+        let mut left = (0usize..n).map(|x| {
+            left_calls += 1;
+            x
+        });
+        let mut right = (0usize..m).map(|x| {
+            right_calls += 1;
+            x * 2
+        });
+        let count = (&mut left).zip(&mut right).count();
+        (count, left.next())
+    };
+    (count, next, left_calls, right_calls)
+}
+
+pub fn zip_borrowed_count_then_right(n: usize, m: usize) -> (usize, Option<usize>, usize, usize) {
+    let mut left_calls = 0;
+    let mut right_calls = 0;
+    let (count, next) = {
+        let mut left = (0usize..n).map(|x| {
+            left_calls += 1;
+            x
+        });
+        let mut right = (0usize..m).map(|x| {
+            right_calls += 1;
+            x * 2
+        });
+        let count = (&mut left).zip(&mut right).count();
+        (count, right.next())
+    };
+    (count, next, left_calls, right_calls)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn zip_borrowed_count_then_left_native() {
+        assert_eq!(zip_borrowed_count_then_left(4, 2), (2, Some(2), 3, 2));
+        assert_eq!(zip_borrowed_count_then_left(2, 4), (2, None, 2, 2));
+        assert_eq!(zip_borrowed_count_then_left(0, 3), (0, None, 0, 0));
+        assert_eq!(zip_borrowed_count_then_left(3, 3), (3, None, 3, 3));
+        assert_eq!(zip_borrowed_count_then_left(3, 0), (0, Some(0), 1, 0));
+    }
+
+    #[test]
+    fn zip_borrowed_count_then_right_native() {
+        assert_eq!(zip_borrowed_count_then_right(4, 2), (2, None, 2, 2));
+        assert_eq!(zip_borrowed_count_then_right(2, 4), (2, Some(4), 2, 3));
+        assert_eq!(zip_borrowed_count_then_right(0, 3), (0, Some(0), 0, 1));
+        assert_eq!(zip_borrowed_count_then_right(3, 3), (3, None, 3, 3));
+        assert_eq!(zip_borrowed_count_then_right(3, 0), (0, None, 0, 0));
+    }
+}
