+++ b/tests/separate-compilation/diagnostic_manifest.rs
@@ -0,0 +1,17 @@
+//! Separate compilation in diagnostic runs (see `diagnostic-manifest.sh`).
+//! Chunk A starts from `double` and `apply`, chunk B from `caller`.
+
+/// Chunk A: translated and listed in the manifest of A.
+pub fn double(x: u32) -> u32 {
+    x.wrapping_mul(2)
+}
+
+/// Chunk A: an argument of arrow type, not translated.
+pub fn apply(f: fn(u32) -> u32, x: u32) -> u32 {
+    f(x)
+}
+
+/// Chunk B: uses `double` as emitted by chunk A.
+pub fn caller(x: u32) -> u32 {
+    double(x).wrapping_add(1)
+}
