diff --git a/tests/separate-compilation/diagnostic-manifest.sh b/tests/separate-compilation/diagnostic-manifest.sh
new file mode 100755
index 0000000..31622dd
--- /dev/null
+++ b/tests/separate-compilation/diagnostic-manifest.sh
@@ -0,0 +1,120 @@
+#!/usr/bin/env bash
+# Separate compilation in diagnostic runs (-diagnostic-manifest).
+#
+# Usage: diagnostic-manifest.sh <charon> <aeneas> [<work directory>]
+#
+# Chunks of diagnostic_manifest.rs, extracted like the chunks of a workspace
+# (-canonical-names, -split-files, one -subdir per chunk, -warnings-as-errors,
+# no -abort-on-error):
+# - A (double, apply; apply is rejected): with -diagnostic-manifest, A exits
+#   with status 1 and writes an incomplete manifest ("version":2,
+#   "complete":false) listing double but not apply; without the option, no
+#   manifest.
+# - B (caller, which calls double) with -external <manifest of A>: with
+#   -diagnostic-manifest, B translates caller against the double of A (status 0,
+#   B imports A and does not emit double) and its manifest is incomplete too;
+#   without the option, B rejects the manifest of A with an explicit error.
+# - C (double alone, no error): the complete manifest is the same with and
+#   without -diagnostic-manifest ("version":1, no "complete").
+# - -diagnostic-manifest is rejected together with -abort-on-error.
+set -uo pipefail
+
+charon=$1
+aeneas=$2
+here=$(cd "$(dirname "$0")" && pwd)
+work=${3:-$(mktemp -d)}
+mkdir -p "$work"
+failures=0
+
+check() { # check <description> <command...>
+  local what=$1
+  shift
+  if "$@"; then
+    echo "ok: $what"
+  else
+    echo "FAILED: $what"
+    failures=$((failures + 1))
+  fi
+}
+absent() { # absent <grep arguments...>: the files exist and do not match
+  grep -q "$@"
+  [ $? -eq 1 ]
+}
+
+llbc() { # llbc <chunk> <start-from item...>
+  local chunk=$1
+  shift
+  local roots=()
+  for item in "$@"; do roots+=(--start-from "diagnostic_manifest::$item"); done
+  "$charon" rustc --preset=aeneas --mir=promoted --monomorphize-mut=except-types \
+    --remove-adt-clauses '--lift-associated-types=*' --error-on-warnings "${roots[@]}" \
+    --dest-file "$work/$chunk.llbc" -- "$here/diagnostic_manifest.rs" \
+    --crate-name=diagnostic_manifest --crate-type=rlib --edition=2021 \
+    >"$work/$chunk.charon.log" 2>&1 ||
+    { echo "charon failed on chunk $chunk (see $work/$chunk.charon.log)"; exit 1; }
+}
+
+run() { # run <name> <chunk> <aeneas options...>; sets $status
+  local name=$1 chunk=$2
+  shift 2
+  rm -rf "${work:?}/$name" && mkdir -p "$work/$name"
+  "$aeneas" -backend lean -checks -warnings-as-errors -strict-joins -sequential \
+    -no-progress-bar -canonical-names -split-files -subdir "Chunk$chunk" \
+    -dest "$work/$name/lean" -emit-manifest "$work/$name/manifest.json" "$@" \
+    "$work/$chunk.llbc" >"$work/$name/log" 2>&1
+  status=$?
+}
+
+llbc A double apply
+llbc B caller
+llbc C double
+
+run a-diag A -diagnostic-manifest
+check "A (-diagnostic-manifest) exits with status 1" test "$status" -eq 1
+check "A reports the error of apply" \
+  grep -q "Could not translate the function signature of 'diagnostic_manifest::apply" "$work/a-diag/log"
+check "A writes an incomplete manifest" \
+  grep -q '^{"version":2,"complete":false,' "$work/a-diag/manifest.json"
+check "the manifest of A lists double" \
+  grep -q '"key":"fun diagnostic_manifest::double"' "$work/a-diag/manifest.json"
+check "the manifest of A does not list apply" \
+  absent '"key":"fun diagnostic_manifest::apply"' "$work/a-diag/manifest.json"
+
+run a-plain A
+check "A (no option) exits with status 1" test "$status" -eq 1
+check "A (no option) writes no manifest" test ! -e "$work/a-plain/manifest.json"
+
+run b-diag B -diagnostic-manifest -external "$work/a-diag/manifest.json"
+check "B (-diagnostic-manifest) exits with status 0" test "$status" -eq 0
+check "B imports the module of A" grep -q '^import ChunkA\.Funs$' "$work/b-diag/lean/ChunkB/Funs.lean"
+check "B calls the double of A" \
+  grep -q '_root_\.diagnostic_manifest\.double x' "$work/b-diag/lean/ChunkB/Funs.lean"
+check "B does not emit double" absent -r 'def diagnostic_manifest\.double' "$work/b-diag/lean"
+check "the manifest of B is incomplete (it uses an incomplete manifest)" \
+  grep -q '^{"version":2,"complete":false,' "$work/b-diag/manifest.json"
+
+run b-plain B -external "$work/a-diag/manifest.json"
+check "B (no option) exits with status 1" test "$status" -eq 1
+check "B (no option) rejects the incomplete manifest of A" \
+  grep -q "a-diag/manifest.json is incomplete (written by a diagnostic run with -diagnostic-manifest): only runs with -diagnostic-manifest may use it" \
+  "$work/b-plain/log"
+check "B (no option) writes no manifest" test ! -e "$work/b-plain/manifest.json"
+
+run c-diag C -diagnostic-manifest
+check "C (-diagnostic-manifest) exits with status 0" test "$status" -eq 0
+run c-plain C
+check "C (no option) exits with status 0" test "$status" -eq 0
+check "the manifest of C is complete" grep -q '^{"version":1,"namespace":' "$work/c-plain/manifest.json"
+check "the manifest of C is the same with -diagnostic-manifest" \
+  cmp -s "$work/c-diag/manifest.json" "$work/c-plain/manifest.json"
+
+run c-abort C -diagnostic-manifest -abort-on-error
+check "-diagnostic-manifest is rejected with -abort-on-error" test "$status" -ne 0
+check "the rejection names both options" \
+  grep -q "the use of -diagnostic-manifest is incompatible with -abort-on-error" "$work/c-abort/log"
+
+if [ "$failures" -ne 0 ]; then
+  echo "$failures check(s) failed; outputs in $work"
+  exit 1
+fi
+echo "all checks passed"
