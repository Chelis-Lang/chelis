+-- [diagnostic_recovery]
+import Aeneas
+open Aeneas Aeneas.Std Result ControlFlow Error
+set_option linter.dupNamespace false
+set_option linter.hashCommand false
+set_option linter.unusedVariables false
+
+/- You can set the `maxHeartbeats` value with the `-max-heartbeats` CLI option -/
+set_option maxHeartbeats 1000000
+
+namespace diagnostic_recovery
+
+/-- [diagnostic_recovery::incr]:
+    Source: 'tests/src/diagnostic-recovery.rs', lines 24:0-26:1
+    Visibility: public -/
+def incr
+  (x : _root_.Aeneas.Std.U32) :
+  _root_.Aeneas.Std.Result _root_.Aeneas.Std.U32
+  := do
+  _root_.Aeneas.Std.Result.ok (core.num.U32.wrapping_add x 1#u32)
+
+/-- [diagnostic_recovery::incr_twice]:
+    Source: 'tests/src/diagnostic-recovery.rs', lines 28:0-30:1
+    Visibility: public -/
+def incr_twice
+  (x : _root_.Aeneas.Std.U32) :
+  _root_.Aeneas.Std.Result _root_.Aeneas.Std.U32
+  := do
+  let i ← _root_.diagnostic_recovery.incr x
+  _root_.diagnostic_recovery.incr i
+
+end diagnostic_recovery
