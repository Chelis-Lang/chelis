diff --git a/tests/src/diagnostic-recovery.rs b/tests/src/diagnostic-recovery.rs
new file mode 100644
index 0000000..a26be4a
--- /dev/null
+++ b/tests/src/diagnostic-recovery.rs
@@ -0,0 +1,45 @@
+//@ [!lean] skip
+//@ [lean] recover-errors
+//@ [lean] subdir=DiagnosticRecovery
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Without `-abort-on-error`, Aeneas records every error, drops the declaration
+//! it was translating and continues with the next one. With
+//! `-warnings-as-errors`, the warnings of the recovery handlers ("Could not
+//! translate ... because of previous error") are recorded as errors, not
+//! raised out of the handlers: the run reports the errors of `Callback` (type
+//! declaration) and of `apply` (signature, body and function), still emits
+//! `incr` and `incr_twice`, and exits with status 1.
+
+/// A field of arrow type: the type declaration is not translated.
+pub struct Callback {
+    pub f: fn(u32) -> u32,
+}
+
+/// An argument of arrow type: neither the signature nor the body is translated.
+pub fn apply(f: fn(u32) -> u32, x: u32) -> u32 {
+    f(x)
+}
+
+pub fn incr(x: u32) -> u32 {
+    x.wrapping_add(1)
+}
+
+pub fn incr_twice(x: u32) -> u32 {
+    incr(incr(x))
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn results() {
+        assert_eq!(incr(41), 42);
+        assert_eq!(incr(u32::MAX), 0);
+        assert_eq!(incr_twice(40), 42);
+        assert_eq!(incr_twice(u32::MAX), 1);
+        assert_eq!(apply(incr, 1), 2);
+        assert_eq!((Callback { f: incr_twice }.f)(3), 5);
+    }
+}
