+import DiagnosticRecovery.DiagnosticRecovery
+
+/-! The functions that the diagnostic run of `tests/src/diagnostic-recovery.rs`
+    still translates, evaluated on the inputs of its `native` test module and
+    compared with the native results. -/
+namespace diagnostic_recovery.checks
+open Aeneas Aeneas.Std Result
+def u (x : Nat) : U32 := ⟨BitVec.ofNat _ x⟩
+def nat (r : Result U32) : Option Nat :=
+  match r with | ok v => some v.val | _ => none
+#guard nat (incr (u 41)) == some 42
+#guard nat (incr (u 4294967295)) == some 0
+#guard nat (incr_twice (u 40)) == some 42
+#guard nat (incr_twice (u 4294967295)) == some 1
+end diagnostic_recovery.checks
