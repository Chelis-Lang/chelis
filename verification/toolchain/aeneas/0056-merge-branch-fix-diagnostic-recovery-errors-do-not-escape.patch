+(** Separate compilation, diagnostic runs only (incompatible with
+    [-abort-on-error]): the manifest of this chunk is also written when the
+    chunk has errors, or when it uses an incomplete manifest. It then lists only
+    the declarations this chunk emitted and is marked incomplete. Incomplete
+    manifests are accepted by [-external] only in this mode. *)
+let diagnostic_manifest = ref false
+
 (** Where to write the collection obligations (see [CollectionContracts]): the
     propositions that the generated code states but does not prove, and that a
     checked theorem must discharge. A collection which needs one is rejected
diff --git a/src/Errors.ml b/src/Errors.ml
index c135674..1d1a0b9 100644
--- a/src/Errors.ml
+++ b/src/Errors.ml
@@ -198,6 +198,47 @@ let warn_opt_span (file : string) (line : int) (span : Meta.span option)
 let warn (file : string) (line : int) (span : Meta.span) (msg : string) =
   warn_opt_span file line (Some span) msg
 
+(** Report, from a handler which recovers from an error (by dropping or
+    degrading the declaration it was translating), what the recovery does.
+
+    Under [-warnings-as-errors] without [-abort-on-error] the warning is
+    recorded as an error but not raised: raising it would escape the recovery
+    and stop the translation of the remaining declarations. In every other mode
+    this is [warn_opt_span]. *)
+let warn_recovered_opt_span (file : string) (line : int)
+    (span : Meta.span option) (msg : string) =
+  if !Config.warnings_as_errors && not !Config.fail_hard then
+    push_error file line span msg
+  else warn_opt_span file line span msg
+
+let warn_recovered (file : string) (line : int) (span : Meta.span)
+    (msg : string) =
+  warn_recovered_opt_span file line (Some span) msg
+
+(** Run [f], the translation of a declaration (or of a group of declarations)
+    whose recovery handler catches [CFailure].
+
+    Without [-abort-on-error], an exception raised by [f] which is not a
+    [CFailure] (an internal error, e.g. [Not_found] raised by a failed lookup)
+    is registered as an error and raised as a [CFailure], so that the recovery
+    handler drops the declaration and the translation continues, as for any
+    other error. With [-abort-on-error] the exception propagates unchanged. *)
+let recover_internal_errors_opt_span (file : string) (line : int)
+    (span : Meta.span option) (f : unit -> 'a) : 'a =
+  if !Config.fail_hard then f ()
+  else
+    try f () with
+    | (CFailure _ | Out_of_memory | Sys.Break) as e -> raise e
+    | e ->
+        let backtrace = Printexc.get_raw_backtrace () in
+        craise_opt_span file line span
+          ("Internal error: uncaught exception " ^ Printexc.to_string e ^ "\n"
+          ^ Printexc.raw_backtrace_to_string backtrace)
+
+let recover_internal_errors (file : string) (line : int) (span : Meta.span)
+    (f : unit -> 'a) : 'a =
+  recover_internal_errors_opt_span file line (Some span) f
+
 let cassert_warn_opt_span (file : string) (line : int) (span : Meta.span option)
     (b : bool) (msg : string) =
   if not b then warn_opt_span file line span msg
