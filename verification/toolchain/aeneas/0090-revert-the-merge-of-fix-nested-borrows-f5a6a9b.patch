-import NestedBorrowsLoopReborrow.NestedBorrowsLoopReborrow
-
-/-! Evaluate the model of `tests/src/nested-borrows-loop-reborrow.rs` on the
-    inputs of its `native` test module and compare with the native results
-    `(result, ctx, pos)`: `pos` is the frame given back through the `&mut`
-    (the forward output), `ctx` the value of the frame's region given back by
-    the backward function of that region when the caller gives the frame
-    back. -/
-
-namespace nested_borrows_loop_reborrow.checks
-open Aeneas Aeneas.Std Result
-
-def u (x : Nat) : U32 := ⟨BitVec.ofNat _ x⟩
-def us (x : Nat) : Usize := ⟨BitVec.ofNat _ x⟩
-
-def max := 4294967295
-
-def sl (xs : List Nat) (h : xs.length ≤ Usize.max := by scalar_tac) : Slice U32 :=
-  ⟨xs.map u, by simpa using h⟩
-
-def frame (ctx pos : Nat) : Frame := { steps := sl [3, 5, 7, 11], ctx := u ctx, pos := us pos }
-
-/-- `run(Some(&mut frame), n)`; the caller gives the frame back -/
-def onSome (run : Option Frame → U32 → Result (U32 × Option Frame × (Option Frame → Option Frame)))
-    (ctx pos n : Nat) : Option (Nat × Nat × Nat) :=
-  match run (some (frame ctx pos)) (u n) with
-  | ok (r, some f1, back) =>
-    match back (some f1) with
-    | some f2 => some (r.val, f2.ctx.val, f1.pos.val)
-    | none => none
-  | _ => none
-
-/-- `run(&mut frame, n)`; the caller gives the frame back -/
-def onFrame (run : Frame → U32 → Result (U32 × Frame × (Frame → Frame)))
-    (ctx pos n : Nat) : Option (Nat × Nat × Nat) :=
-  match run (frame ctx pos) (u n) with
-  | ok (r, f1, back) => some (r.val, (back f1).ctx.val, f1.pos.val)
-  | _ => none
-
-/-- `run(None, n)`: the result, and whether `None` is given back -/
-def onNone (run : Option Frame → U32 → Result (U32 × Option Frame × (Option Frame → Option Frame)))
-    (n : Nat) : Option (Nat × Bool) :=
-  match run none (u n) with
-  | ok (r, o, back) => some (r.val, o.isNone && (back none).isNone)
-  | _ => none
-
--- loop_reborrow_native
-#guard onSome loop_reborrow 10 0 0 == some (0, 10, 0)
-#guard onSome loop_reborrow 10 0 1 == some (3, 13, 1)
-#guard onSome loop_reborrow 10 0 3 == some (15, 25, 3)
-#guard onSome loop_reborrow (max - 4) 1 2 == some (12, 7, 3)
-#guard onNone loop_reborrow 3 == some (3, true)
-#guard onFrame run_loop_reborrow 10 1 2 == some (12, 22, 3)
-
--- loop_is_some_reborrow_native
-#guard onSome loop_is_some_reborrow 10 0 0 == some (0, 10, 0)
-#guard onSome loop_is_some_reborrow 10 0 3 == some (18, 25, 3)
-#guard onSome loop_is_some_reborrow (max - 4) 1 2 == some (14, 7, 3)
-#guard onNone loop_is_some_reborrow 3 == some (3, true)
-
-end nested_borrows_loop_reborrow.checks
