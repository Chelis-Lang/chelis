-//! Loops over `Option::as_deref_mut` of the loop state
-//! `execution: Option<&'1 mut Frame<'2>>`, the reborrow given to a call at
-//! each iteration (the shape of `chelis_ir::eval`'s node loop over the frame
-//! option). The first stage of the backward function of `as_deref_mut` for the
-//! region of the frame receives the inner borrows of the value given back to
-//! the loop state's own borrow (level 1 of the loop abstraction of that
-//! region): the continuation of the loop abstraction is staged at level 1, and
-//! at each `continue` its first stage chains the first stage of the call. The
-//! backward function of the call gives back, at level 1, the value which the
-//! callee of the reborrow consumes, which gives back the input of the call at
-//! level 0: the continuation applies the call around the callee.
-
-pub struct Frame<'a> {
-    pub steps: &'a [u32],
-    pub ctx: &'a mut u32,
-    pub pos: usize,
-}
-
-impl<'a> Frame<'a> {
-    pub fn advance(&mut self) -> u32 {
-        let s = self.steps[self.pos];
-        self.pos += 1;
-        *self.ctx = (*self.ctx).wrapping_add(s);
-        s
-    }
-}
-
-pub fn advance_or(execution: Option<&mut Frame<'_>>, d: u32) -> u32 {
-    match execution {
-        Some(f) => f.advance(),
-        None => d,
-    }
-}
-
-/// The reborrow is given to a call at each iteration.
-pub fn loop_reborrow(mut execution: Option<&mut Frame<'_>>, n: u32) -> u32 {
-    let mut acc = 0u32;
-    let mut i = 0;
-    while i < n {
-        acc = acc.wrapping_add(advance_or(execution.as_deref_mut(), i));
-        i += 1;
-    }
-    acc
-}
-
-/// The option is read (`is_some`) before the reborrow at each iteration.
-pub fn loop_is_some_reborrow(mut execution: Option<&mut Frame<'_>>, n: u32) -> u32 {
-    let mut acc = 0u32;
-    let mut i = 0;
-    while i < n {
-        if execution.is_some() {
-            acc = acc.wrapping_add(1);
-        }
-        acc = acc.wrapping_add(advance_or(execution.as_deref_mut(), i));
-        i += 1;
-    }
-    acc
-}
-
-pub fn run_loop_reborrow(f: &mut Frame<'_>, n: u32) -> u32 {
-    loop_reborrow(Some(f), n)
-}
