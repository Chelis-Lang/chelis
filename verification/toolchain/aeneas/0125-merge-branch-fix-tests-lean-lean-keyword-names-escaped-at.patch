+#guard lean_keyword_names.«at» (u 3) == ok false
+#guard lean_keyword_names.«at» (u 4) == ok true
+#guard lean_keyword_names.«by» (u 3) == ok true
+#guard lean_keyword_names.«by» (u 0) == ok false
+#guard n (lean_keyword_names.«then» true (u 4)) == some 68
+#guard n (lean_keyword_names.«then» true (u 3)) == some 10
+#guard n (lean_keyword_names.«then» false (u 3)) == some 48
+#guard n (lean_keyword_names.«def» (u 5)) == some 15
+#guard n (lean_keyword_names.«local» (u 5)) == some 16
+#guard n (lean_keyword_names.«meta» (u 5)) == some 46
+#guard pair (lean_keyword_names.«structure» (u 5)) == some (46, 16)
