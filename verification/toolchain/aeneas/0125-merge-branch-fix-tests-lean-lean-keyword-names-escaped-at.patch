+#guard n (lean_keyword_names.«scoped» (u 3)) == some 10
+#guard n (lean_keyword_names.«scoped» (u 4294967295)) == some 6
+#guard n (lean_keyword_names.«end» (u 0)) == some 0
+#guard n (lean_keyword_names.«end» (u 3)) == some 24
