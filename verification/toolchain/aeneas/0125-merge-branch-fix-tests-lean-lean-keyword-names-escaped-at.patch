diff --git a/tests/src/lean-keyword-names.rs b/tests/src/lean-keyword-names.rs
new file mode 100644
index 0000000..f00ed1f
--- /dev/null
+++ b/tests/src/lean-keyword-names.rs
@@ -0,0 +1,214 @@
+//@ [!lean] skip
+//@ [lean] subdir=LeanKeywordNames
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Declarations named like Lean keywords: functions (`scoped`, `end`, `open`,
+//! `at`, `by`, `then`, `def`, `local`, `meta`, `structure`, `syntax`, `only`
+//! and the raw identifiers `r#let`, `r#in`), a mutually recursive pair (`at`
+//! and `by`, which name each other without the namespace), a global (`from`),
+//! a type (`Type`) with fields `end` and `at`, an enumeration whose variants
+//! are `Type`, `Sort` and `Prop`, inherent methods (`Type::end`,
+//! `Type::open`), a trait with methods `scoped` and `end`, and a loop in
+//! `end` (`end_loop`). An identifier spelled like a Lean keyword does not
+//! parse: the model did not compile (`def scoped`, as in chelis-ir's
+//! lowering_runtime). `LeanKeywordNames/Checks.lean` evaluates the model on
+//! the inputs of the `native` test module and compares with the native
+//! results, including the values given back by `r#in` and `Type::open`, which
+//! the callers write through after the calls.
+#![allow(non_snake_case, non_camel_case_types, non_upper_case_globals)]
+
+pub const from: u32 = 7;
+
+pub fn scoped(x: u32) -> u32 {
+    x.wrapping_add(from)
+}
+
+/// A loop (`end_loop`) and a call of `scoped`.
+pub fn end(n: u32) -> u32 {
+    let mut acc = 0u32;
+    let mut i = 0;
+    while i < n {
+        acc = acc.wrapping_add(scoped(i));
+        i += 1;
+    }
+    acc
+}
+
+pub fn open(x: u32, y: u32) -> u32 {
+    end(x).wrapping_mul(y)
+}
+
+/// `at` and `by` are mutually recursive.
+pub fn at(n: u32) -> bool {
+    if n == 0 { true } else { by(n - 1) }
+}
+
+pub fn by(n: u32) -> bool {
+    if n == 0 { false } else { at(n - 1) }
+}
+
+pub fn then(b: bool, x: u32) -> u32 {
+    if at(x) == b { open(x, 2) } else { scoped(x) }
+}
+
+pub fn def(x: u32) -> u32 {
+    x.wrapping_mul(3)
+}
+
+pub fn local(x: u32) -> u32 {
+    def(x).wrapping_add(1)
+}
+
+pub fn meta(x: u32) -> u32 {
+    local(def(x))
+}
+
+pub fn structure(x: u32) -> (u32, u32) {
+    (meta(x), local(x))
+}
+
+pub fn syntax(x: u32) -> u32 {
+    x ^ 0xff
+}
+
+pub fn only(x: u32) -> u32 {
+    syntax(x).wrapping_add(from)
+}
+
+pub fn r#let(x: u32) -> u32 {
+    only(x) >> 1
+}
+
+/// Writes through the given-back reference.
+pub fn r#in(x: &mut u32, y: u32) -> u32 {
+    let old = *x;
+    *x = r#let(y);
+    old
+}
+
+/// The caller writes through the value `r#in` gives back.
+pub fn in_then_bump(x: &mut u32, y: u32) -> u32 {
+    let old = r#in(x, y);
+    *x += 100;
+    old
+}
+
+pub struct Type {
+    pub end: u32,
+    pub at: u32,
+}
+
+impl Type {
+    pub fn end(&self) -> u32 {
+        self.end.wrapping_add(self.at)
+    }
+
+    /// Writes through `self`.
+    pub fn open(&mut self, v: u32) -> u32 {
+        let old = self.at;
+        self.at = v;
+        self.end = r#let(v);
+        old
+    }
+}
+
+/// The caller writes through the value `Type::open` gives back.
+pub fn open_then_bump(t: &mut Type, v: u32) -> u32 {
+    let old = t.open(v);
+    t.end += 1000;
+    old
+}
+
+pub enum Kind {
+    Type,
+    Sort(u32),
+    Prop { at: u32 },
+}
+
+pub fn kind(k: &Kind) -> u32 {
+    match k {
+        Kind::Type => 0,
+        Kind::Sort(n) => scoped(*n),
+        Kind::Prop { at } => *at + 1,
+    }
+}
+
+pub fn mk_kind(n: u32) -> Kind {
+    if n == 0 {
+        Kind::Type
+    } else if n % 2 == 0 {
+        Kind::Sort(n)
+    } else {
+        Kind::Prop { at: n }
+    }
+}
+
+pub trait Syntax {
+    fn scoped(&self) -> u32;
+    fn end(&self, x: u32) -> u32;
+}
+
+impl Syntax for Type {
+    fn scoped(&self) -> u32 {
+        self.end()
+    }
+    fn end(&self, x: u32) -> u32 {
+        self.at.wrapping_mul(x)
+    }
+}
+
+pub fn use_syntax<T: Syntax>(t: &T, x: u32) -> (u32, u32) {
+    (t.scoped(), t.end(x))
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn functions() {
+        assert_eq!(scoped(3), 10);
+        assert_eq!(scoped(u32::MAX), 6);
+        assert_eq!(end(0), 0);
+        assert_eq!(end(3), 24);
+        assert_eq!(open(3, 5), 120);
+        assert_eq!(at(0), true);
+        assert_eq!(at(3), false);
+        assert_eq!(at(4), true);
+        assert_eq!(by(3), true);
+        assert_eq!(by(0), false);
+        assert_eq!(then(true, 4), 68);
+        assert_eq!(then(true, 3), 10);
+        assert_eq!(then(false, 3), 48);
+        assert_eq!(def(5), 15);
+        assert_eq!(local(5), 16);
+        assert_eq!(meta(5), 46);
+        assert_eq!(structure(5), (46, 16));
+        assert_eq!(syntax(0x0f), 0xf0);
+        assert_eq!(only(0x0f), 0xf7);
+        assert_eq!(r#let(0x0f), 0x7b);
+        let mut x = 9;
+        assert_eq!(r#in(&mut x, 0x0f), 9);
+        assert_eq!(x, 0x7b);
+        assert_eq!(in_then_bump(&mut x, 0), 0x7b);
+        assert_eq!(x, 0x83 + 100);
+    }
+
+    #[test]
+    fn types() {
+        let mut t = Type { end: 2, at: 3 };
+        assert_eq!(t.end(), 5);
+        assert_eq!(t.open(0x0f), 3);
+        assert_eq!((t.end, t.at), (0x7b, 0x0f));
+        assert_eq!(open_then_bump(&mut t, 0), 0x0f);
+        assert_eq!((t.end, t.at), (0x83 + 1000, 0));
+        assert_eq!(use_syntax(&Type { end: 2, at: 3 }, 4), (5, 12));
+        assert_eq!(kind(&Kind::Type), 0);
+        assert_eq!(kind(&Kind::Sort(4)), 11);
+        assert_eq!(kind(&Kind::Prop { at: 4 }), 5);
+        assert_eq!(kind(&mk_kind(0)), 0);
+        assert_eq!(kind(&mk_kind(6)), 13);
+        assert_eq!(kind(&mk_kind(5)), 6);
+        assert_eq!(from, 7);
+    }
+}
