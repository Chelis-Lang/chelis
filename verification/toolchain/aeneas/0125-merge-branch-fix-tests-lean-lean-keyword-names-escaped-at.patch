+#guard n (lean_keyword_names.kind (lean_keyword_names.Kind.«Sort» (u 4))) == some 11
+#guard n (lean_keyword_names.kind (lean_keyword_names.Kind.«Prop» (u 4))) == some 5
+#guard n (lean_keyword_names.mk_kind (u 0) >>= lean_keyword_names.kind) == some 0
+#guard n (lean_keyword_names.mk_kind (u 6) >>= lean_keyword_names.kind) == some 13
+#guard n (lean_keyword_names.mk_kind (u 5) >>= lean_keyword_names.kind) == some 6
+#guard lean_keyword_names.«from».val == 7
+
+end lean_keyword_names.checks
