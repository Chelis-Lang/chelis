+#guard res (fun (o, t) => (o.val, fields t)) (lean_keyword_names.Type.open (ty 2 3) (u 0x0f)) ==
+  some (3, (0x7b, 0x0f))
+#guard res (fun (o, t) => (o.val, fields t)) (lean_keyword_names.open_then_bump (ty 0x7b 0x0f) (u 0)) ==
