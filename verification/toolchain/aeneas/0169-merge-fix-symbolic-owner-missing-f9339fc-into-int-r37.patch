+//@ [!lean] skip
+//@ [lean] subdir=SymbolicOwnerMissing
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::option::{core::option::Option} --include core::option::{core::ops::try_trait::Try} --include core::option::{core::ops::try_trait::FromResidual} --include core::ops::deref::{core::ops::deref::Deref} --include core::ops::deref::{core::ops::deref::DerefMut}
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+
+pub struct Checked {
+    base: u32,
+}
+
+pub struct State {
+    value: u32,
+}
+
+pub struct Runtime {
+    events: u32,
+}
+
+pub struct Native {
+    polls: u32,
+}
+
+pub struct HostCx<'a> {
+    checked: &'a Checked,
+    state: &'a mut State,
+    runtime: &'a mut Runtime,
+    native: &'a mut Native,
+}
+
+impl HostCx<'_> {
+    fn step(&mut self, delta: u32) -> u32 {
+        self.state.value = self.state.value.wrapping_add(delta);
+        self.runtime.events = self.runtime.events.wrapping_add(self.checked.base);
+        self.native.polls = self.native.polls.wrapping_add(1);
+        self.state.value.wrapping_add(self.checked.base)
+    }
+}
+
+pub struct LowerCtx<'a> {
+    host_program: Option<&'a Checked>,
+    host_state: Option<&'a mut State>,
+    runtime: &'a mut Runtime,
+    native: &'a mut Native,
+}
+
+impl LowerCtx<'_> {
+    fn host_cx(&mut self) -> Option<HostCx<'_>> {
+        Some(HostCx {
+            checked: self.host_program?,
+            state: self.host_state.as_deref_mut()?,
+            runtime: &mut *self.runtime,
+            native: &mut *self.native,
+        })
+    }
+}
+
+pub fn exercise(
+    has_program: bool,
+    has_state: bool,
+    base: u32,
+    state_value: u32,
+    events: u32,
+    polls: u32,
+    delta: u32,
+) -> (Option<u32>, u32, u32, u32) {
+    let checked = Checked { base };
+    let mut state = State { value: state_value };
+    let mut runtime = Runtime { events };
+    let mut native = Native { polls };
+    let result = {
+        let mut lower = LowerCtx {
+            host_program: if has_program { Some(&checked) } else { None },
+            host_state: if has_state { Some(&mut state) } else { None },
+            runtime: &mut runtime,
+            native: &mut native,
+        };
+        match lower.host_cx() {
+            Some(mut host) => Some(host.step(delta)),
+            None => None,
+        }
+    };
+    (result, state.value, runtime.events, native.polls)
+}
+
+#[cfg(test)]
+mod native {
+    use super::exercise;
+
+    #[test]
+    fn returned_value_and_state_match_host_context() {
+        assert_eq!(exercise(true, true, 4, 5, 6, 7, 3), (Some(12), 8, 10, 8));
+        assert_eq!(exercise(false, true, 4, 5, 6, 7, 3), (None, 5, 6, 7));
+        assert_eq!(exercise(true, false, 4, 5, 6, 7, 3), (None, 5, 6, 7));
+        assert_eq!(exercise(false, false, 4, 5, 6, 7, 3), (None, 5, 6, 7));
+        assert_eq!(
+            exercise(true, true, 1, u32::MAX, 3, u32::MAX, 1),
+            (Some(1), 0, 4, 0)
+        );
+    }
+}
