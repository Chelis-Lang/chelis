+import SymbolicOwnerMissing.SymbolicOwnerMissing
+
+/-! These #guards compare the extracted host-context return and post-state with
+    the native unit-test cases in `tests/src/symbolic-owner-missing.rs`. -/
+
+namespace symbolic_owner_missing.checks
+open Aeneas Aeneas.Std Result
+
+def u (x : Nat) : U32 := ⟨BitVec.ofNat _ x⟩
+
+def val {α} (f : α → β) : Result α → Option β
+  | ok x => some (f x)
+  | _ => none
+
+def run (hasProgram hasState : Bool) (base state events polls delta : Nat) :
+    Option (Option Nat × Nat × Nat × Nat) :=
+  val (fun (result, state, events, polls) =>
+      (result.map (·.val), state.val, events.val, polls.val))
+    (exercise hasProgram hasState (u base) (u state) (u events) (u polls)
+      (u delta))
+
+#guard run true true 4 5 6 7 3 == some (some 12, 8, 10, 8)
+#guard run false true 4 5 6 7 3 == some (none, 5, 6, 7)
+#guard run true false 4 5 6 7 3 == some (none, 5, 6, 7)
+#guard run false false 4 5 6 7 3 == some (none, 5, 6, 7)
+#guard run true true 1 4294967295 3 4294967295 1 ==
+  some (some 1, 0, 4, 0)
+
+end symbolic_owner_missing.checks
