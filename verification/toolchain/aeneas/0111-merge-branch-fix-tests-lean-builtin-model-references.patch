+/- The fork translates the loop of `find` with the `loop` combinator: its body joins the arms of
+   the match through sums, and the loop state also carries the (unchanged) root. One iteration of
+   the loop is the recursive shape of the search. -/
+theorem Tree.find_loop_unfold {T : Type} (OrdInst : Ord T) (root : Subtree T) (value : T)
+  (t : Subtree T) :
+  Tree.find_loop OrdInst root value t =
+    (match t with
+     | none => ok false
+     | some node => do
+       let ordering ← OrdInst.cmp node.value value
+       match ordering with
+       | .Less => Tree.find_loop OrdInst root value node.right
+       | .Equal => ok true
+       | .Greater => Tree.find_loop OrdInst root value node.left) := by
+  unfold find_loop
+  conv_lhs => rw [loop]
+  cases t with
+  | none => simp [find_loop.body]
+  | some node =>
+    simp only [find_loop.body]
+    cases h : OrdInst.cmp node.value value with
+    | ok ordering => cases ordering <;> simp
+    | fail e => simp
+    | div => simp
+
