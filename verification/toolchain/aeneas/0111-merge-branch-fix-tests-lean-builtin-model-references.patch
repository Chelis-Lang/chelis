diff --git a/tests/src/builtin-shadowing.rs b/tests/src/builtin-shadowing.rs
new file mode 100644
index 0000000..51d210e
--- /dev/null
+++ b/tests/src/builtin-shadowing.rs
@@ -0,0 +1,152 @@
+//@ [!lean] skip
+//@ [lean] subdir=BuiltinShadowing
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Locals and type parameters named like the first component of the Lean name
+//! of a builtin model: `core` (`core.cmp.OrdU32`, `core.num.U32.wrapping_mul`,
+//! `core.num.U32.MAX`), `U32` (`U32.checked_add`), `UScalar` (`UScalar.cast`),
+//! `Slice` (`Slice.index_usize`, `Slice.update`), `Array`
+//! (`Array.index_usize`) and `Std` (`Std.Array.empty`). These model
+//! names were printed relative to the opened `Aeneas.Std`, so the binder
+//! captured their first component and the model did not compile (a local map
+//! named `core`, as in chelis_deep::annotations). `BuiltinShadowing/Checks.lean`
+//! evaluates the model on the inputs of the `native` test module and compares
+//! with the native results, including the maps and the slice given back by
+//! `record`, `record_all`, `record_then_bump` and `slice_set`, which the
+//! callers write through after the calls and after the loop.
+#![allow(non_snake_case)]
+
+use std::collections::BTreeMap;
+
+/// A parameter named `core` holds the map (`insert` takes the `core.cmp.OrdU32`
+/// instance).
+pub fn record(core: &mut BTreeMap<u32, u32>, key: u32, value: u32) -> Option<u32> {
+    core.insert(key, value)
+}
+
+/// The caller writes through the map `record` gives back, after each call.
+pub fn record_then_bump(map: &mut BTreeMap<u32, u32>, key: u32) -> (Option<u32>, Option<u32>) {
+    let first = record(map, key, 1);
+    map.insert(key.wrapping_add(1), 5);
+    let second = record(map, key, 2);
+    map.insert(0, 9);
+    (first, second)
+}
+
+/// A loop inserts through `core`, a reborrow of the caller's map; the map is
+/// written after the loop.
+pub fn record_all(map: &mut BTreeMap<u32, u32>, keys: &[u32]) -> u32 {
+    let core = &mut *map;
+    let mut replaced = 0;
+    let mut i = 0;
+    while i < keys.len() {
+        let key = keys[i];
+        if core.insert(key, key.wrapping_mul(10)).is_some() {
+            replaced += 1;
+        }
+        i += 1;
+    }
+    map.insert(1000, replaced);
+    replaced
+}
+
+/// Integer models with a local named `core` in scope.
+pub fn mix(x: u32, y: u32) -> (u32, u32, u32) {
+    let core = x.wrapping_add(y);
+    let wrapped = core.wrapping_mul(3);
+    let top = u32::MAX - core;
+    (core, wrapped, top.max(y))
+}
+
+/// Locals named `U32` (`U32.checked_add`) and `UScalar` (`UScalar.cast`).
+pub fn checked(x: u32, y: u32) -> (Option<u32>, u32) {
+    let U32 = x.wrapping_add(1);
+    let sum = U32.checked_add(y);
+    let UScalar = y as u8;
+    let wide = UScalar as u32;
+    (sum, wide)
+}
+
+/// Type parameters named `Slice`, `Array` and `Std`.
+pub fn slice_at<Slice>(s: &[u32], i: usize, tag: Slice) -> (u32, Slice) {
+    (s[i], tag)
+}
+
+pub fn slice_set<Slice>(s: &mut [u32], i: usize, v: u32, tag: Slice) -> Slice {
+    s[i] = v;
+    tag
+}
+
+/// The caller writes through the slice `slice_set` gives back.
+pub fn set_then_bump(s: &mut [u32], i: usize) -> u8 {
+    let tag = slice_set(s, i, 7, 3u8);
+    s[0] += 100;
+    tag
+}
+
+pub fn array_at<Array>(a: [u32; 3], i: usize, tag: Array) -> (u32, Array) {
+    (a[i], tag)
+}
+
+pub fn empty_array<Std>(tag: Std) -> ([u32; 0], Std) {
+    ([], tag)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    fn entries(map: &BTreeMap<u32, u32>) -> Vec<(u32, u32)> {
+        map.iter().map(|(k, v)| (*k, *v)).collect()
+    }
+
+    #[test]
+    fn maps() {
+        let mut map = BTreeMap::new();
+        assert_eq!(record(&mut map, 3, 30), None);
+        assert_eq!(record(&mut map, 3, 31), Some(30));
+        assert_eq!(entries(&map), vec![(3, 31)]);
+        assert_eq!(record_then_bump(&mut map, 7), (None, Some(1)));
+        assert_eq!(entries(&map), vec![(0, 9), (3, 31), (7, 2), (8, 5)]);
+        assert_eq!(record_then_bump(&mut map, 3), (Some(31), Some(1)));
+        assert_eq!(entries(&map), vec![(0, 9), (3, 2), (4, 5), (7, 2), (8, 5)]);
+        assert_eq!(record_all(&mut map, &[4, 5, 4, 6]), 2);
+        assert_eq!(entries(&map), vec![(0, 9), (3, 2), (4, 40), (5, 50), (6, 60), (7, 2), (8, 5), (1000, 2)]);
+        let mut empty = BTreeMap::new();
+        assert_eq!(record_all(&mut empty, &[]), 0);
+        assert_eq!(entries(&empty), vec![(1000, 0)]);
+    }
+
+    #[test]
+    fn integers() {
+        assert_eq!(mix(1, 2), (3, 9, 4294967292));
+        assert_eq!(mix(u32::MAX, 2), (1, 3, 4294967294));
+        assert_eq!(mix(4000000000, 1000000000), (705032704, 2115098112, 3589934591));
+        assert_eq!(checked(1, 2), (Some(4), 2));
+        assert_eq!(checked(u32::MAX - 1, 1), (None, 1));
+        assert_eq!(checked(u32::MAX, 1), (Some(1), 1));
+        assert_eq!(checked(5, 300), (Some(306), 44));
+        assert_eq!(slice_at(&[1, 2, 3], 1, 7u8), (2, 7));
+        let mut s = [1, 2, 3];
+        assert_eq!(slice_set(&mut s, 2, 9, true), true);
+        assert_eq!(s, [1, 2, 9]);
+        assert_eq!(set_then_bump(&mut s, 1), 3);
+        assert_eq!(s, [101, 7, 9]);
+        assert_eq!(set_then_bump(&mut s, 0), 3);
+        assert_eq!(s, [107, 7, 9]);
+        assert_eq!(array_at([4, 5, 6], 2, 'x'), (6, 'x'));
+        assert_eq!(empty_array(3u64), ([], 3));
+    }
+
+    #[test]
+    #[should_panic]
+    fn array_out_of_bounds() {
+        array_at([4, 5, 6], 3, ());
+    }
+
+    #[test]
+    #[should_panic]
+    fn slice_out_of_bounds() {
+        slice_set(&mut [1, 2], 2, 0, ());
+    }
+}
