+(** The Lean reference to the definition [name] of the Aeneas library
+    ([Aeneas.Std.name]), spelled from the root like the models generated in
+    [ExtractBuiltinLean]: a local binder, a type parameter or the extraction
+    namespace may not capture its first component (a local [core] captures
+    [core.cmp.OrdU32]). Other backends keep [name]. *)
+let lean_std_ref (name : string) : string =
+  match backend () with
+  | Lean -> "_root_.Aeneas.Std." ^ name
+  | FStar | Coq | HOL4 -> name
+
 let () =
   assert (split_on_separator "x::y::z" = [ "x"; "y"; "z" ]);
   assert (split_on_separator "x.y.z" = [ "x"; "y"; "z" ])
