+(** Nested borrows: the route of a position of a value of an abstraction (the
+    regions of the ignored mutable borrows on the way, see
+    [SymbolicToPureTypes.back_ty_routes_for_regions]). The values of a join or
+    loop abstraction with a staged continuation have a single route to the
+    regions of the abstraction (see [abs_kstage_stages]). *)
+let kstage_route (ctx : bs_ctx) (owned : T.RegionId.Set.t) (ty : T.ty) :
+    T.region list =
+  match
+    List.sort_uniq compare
+      (back_ty_routes_for_regions ctx.decls_ctx (region_selected owned) ty)
+  with
+  | [ route ] -> route
+  | _ ->
+      [%craise] ctx.span
+        ("Nested borrows: a value of type " ^ ty_to_string ctx ty
+       ^ " of a join or loop abstraction reaches the regions of the \
+          abstraction through several routes of mutable borrows, which a \
+          staged continuation does not distinguish")
+
+(** Nested borrows: the value of a position of a staged continuation (see
+    [StagePaths]) is the value directly below the innermost ignored mutable
+    borrow on its route. The translation of the values of an abstraction (see
+    [SymbolicToPureValues]) gives the first ADT below the mutable borrows at
+    the root of the value of type [ty]. This function returns the fields to
+    project from that ADT (the index, the type of the field value, the number
+    of fields and the type of the ADT), and the type of the value of the
+    position. A field which holds the route must be unique, and must be a
+    structure. Otherwise the position is ambiguous and we raise an error. *)
+let kstage_norm_fields (ctx : bs_ctx) (owned : T.RegionId.Set.t) (ty : T.ty) :
+    (int * T.ty * int * T.ty) list * T.ty =
+  let span = ctx.span in
+  let keep_region = region_selected owned in
+  let rec strip (ty : T.ty) (route : T.region list) =
+    match (ty, route) with
+    | T.TRef (r, pointee, T.RMut), r' :: route when r = r' -> strip pointee route
+    | _ -> (ty, route)
+  in
+  let rec fields (ty : T.ty) (route : T.region list) =
+    match route with
+    | [] -> ([], ty)
+    | r :: rest -> (
+        match ty with
+        | T.TAdt { id = T.TAdtId adt_id; generics } -> (
+            match
+              T.TypeDeclId.Map.find_opt adt_id ctx.decls_ctx.type_ctx.type_decls
+            with
+            | Some ({ kind = T.Struct _; _ } as def) -> (
+                let field_tys =
+                  List.concat_map snd
+                    (Substitute.type_decl_get_instantiated_variants_fields_types
+                       def generics)
+                in
+                let candidates =
+                  List.filter
+                    (fun (_, fty) ->
+                      List.mem route
+                        (back_ty_routes_for_regions ctx.decls_ctx keep_region
+                           fty))
+                    (List.mapi (fun i fty -> (i, fty)) field_tys)
+                in
+                let n = List.length field_tys in
+                match candidates with
+                | [ (i, T.TRef (r', pointee, T.RMut)) ] when r' = r ->
+                    let projs, ty' = fields pointee rest in
+                    ((i, pointee, n, ty) :: projs, ty')
+                | [ (i, (T.TAdt { id = T.TAdtId _; _ } as fty)) ] ->
+                    let projs, ty' = fields fty route in
+                    ((i, fty, n, ty) :: projs, ty')
+                | _ ->
+                    [%craise] span
+                      ("Nested borrows: the position of a staged continuation \
+                        inside a value of type " ^ ty_to_string ctx ty
+                     ^ " is not held by a single field"))
+            | _ ->
+                [%craise] span
+                  ("Nested borrows: the position of a staged continuation \
+                    inside a value of type " ^ ty_to_string ctx ty
+                 ^ " is not inside a structure"))
+        | _ ->
+            [%craise] span
+              ("Nested borrows: the position of a staged continuation inside \
+                a value of type " ^ ty_to_string ctx ty
+             ^ " is not inside a structure"))
+  in
+  let ty, route = strip ty (kstage_route ctx owned ty) in
+  fields ty route
+
+(** Nested borrows: the value of a position of a staged continuation (see
+    [kstage_norm_fields]) in the translation [e] of a value of the abstraction. *)
+let kstage_norm_texpr (ctx : bs_ctx) (owned : T.RegionId.Set.t) (ty : T.ty)
+    (e : texpr) : texpr =
+  let projs, _ = kstage_norm_fields ctx owned ty in
+  List.fold_left
+    (fun (e : texpr) (i, fty, _, _) ->
+      mk_adt_proj ctx.span e (FieldId.of_int i) (ctx_translate_fwd_ty ctx fty))
+    e projs
+
+(** Nested borrows: the inverse of [kstage_norm_texpr]. The structures on the
+    way must have no other field than the one which holds the position. *)
+let kstage_denorm_texpr (ctx : bs_ctx) (owned : T.RegionId.Set.t) (ty : T.ty)
+    (e : texpr) : texpr =
+  let projs, _ = kstage_norm_fields ctx owned ty in
+  List.fold_right
+    (fun (_, _, n, adt_ty) (e : texpr) ->
+      [%cassert] ctx.span (n = 1)
+        "Nested borrows: the value of a position of a staged continuation is \
+         inside a structure with other fields";
+      mk_adt_texpr ctx.span (ctx_translate_fwd_ty ctx adt_ty) None [ e ])
+    projs e
+
+(** Nested borrows: the pattern of the value of a position of a staged
+    continuation (see [kstage_norm_fields]) in the pattern [p] of a value of
+    the abstraction. The other fields of [p] must not bind variables: the
+    stage gives back the value of the position only. If [p] binds a value of a
+    structure on the way as a whole, the structure must have no other field:
+    we bind a fresh variable for the value of its field, and return the
+    binding which rebuilds the structure from it (inner bindings first). *)
+let kstage_norm_tpat (ctx : bs_ctx) (owned : T.RegionId.Set.t) (ty : T.ty)
+    (p : tpat) : bs_ctx * tpat * (tpat * texpr) list =
+  let span = ctx.span in
+  let projs, nty = kstage_norm_fields ctx owned ty in
+  let nty = ctx_translate_fwd_ty ctx nty in
+  let rec extract ctx (p : tpat) projs =
+    match projs with
+    | [] -> (ctx, p, [])
+    | (i, fty, n, _) :: projs -> (
+        match p.pat with
+        | PIgnored -> (ctx, mk_ignored_pat nty, [])
+        | PAdt { variant_id = None; fields } when i < List.length fields ->
+            List.iteri
+              (fun j (q : tpat) ->
+                [%cassert] span
+                  (j = i || FVarId.Set.is_empty (tpat_get_fvars q))
+                  "Nested borrows: a value given back at a position of a staged \
+                   continuation binds variables outside of the position")
+              fields;
+            extract ctx (List.nth fields i) projs
+        | POpen _ when n = 1 ->
+            let ctx, var = fresh_var None (ctx_translate_fwd_ty ctx fty) ctx in
+            let ctx, inner, bindings =
+              extract ctx (mk_tpat_from_fvar None var) projs
+            in
+            let rebuild =
+              mk_adt_texpr span p.ty None [ mk_texpr_from_fvar var ]
+            in
+            (ctx, inner, bindings @ [ (p, rebuild) ])
+        | _ ->
+            [%craise] span
+              ("Nested borrows: a value given back at a position of a staged \
+                continuation is bound as a whole, with other fields than the \
+                position: "
+             ^ tpat_to_string ctx p))
+  in
+  let ctx, p, bindings = extract ctx p projs in
+  [%cassert] span (p.ty = nty)
+    "Nested borrows: the value given back at a position of a staged \
+     continuation has an unexpected type";
+  (ctx, p, bindings)
+
+(** Nested borrows: the stages of the continuation of a join or loop
+    abstraction with pending loans, if its positions span three levels of
+    ignored mutable borrows or more (see [StagePaths]). Otherwise [None]: the
+    continuation is staged with [StagePending] or [StageLevel] (two stages at
+    most).
+
+    The values of the abstraction are the two sides of a virtual mutable
+    borrow (DESIGN-4LEVELS, section 1). A loan (a pending loan, a loan, a loan
+    projector) holds a value given back to a parent borrow. If its value is
+    [d] borrows away from the regions of the abstraction, its parent is the
+    borrow at depth [D - d - 1] of the chain of borrows of depth [D] (the
+    depth of the deepest loan plus one, for the virtual borrow). Its position
+    is then [c] [D - d - 1] times, then [g], then its own path. The loan at
+    depth [D - 1] is the value given back to the virtual borrow: the joined
+    value. A borrow at depth [d] lies on the borrowed side of every borrow of
+    the chain: [c] [D - d] times, then its own path. The stage of a position
+    is the one of an input [&'virtual mut X] (see
+    [SymbolicToPureTypes.back_sig_stage_map]). E.g., for a joined
+    [&'w mut C<'s, 't>] with [C { f : &'s mut D<'t> }], [D { x : &'t mut u32 }]
+    and the region ['t]: the borrow [ccc], the pending loans of the parents
+    ['s] ([ccg]) and ['w] ([cgc], [cgg]), and the joined value ([gcc], [gcg],
+    [ggc], [ggg]). The stages are [ccg -> gcg], [ggg -> cgg], [cgc -> ggc], then
+    the last one [gcc -> ccc]. *)
+let abs_kstage_stages (ctx : bs_ctx) (abs : V.abs) :
+    staged_cont_stage list option =
+  let span = ctx.span in
+  let owned = abs.regions.owned in
+  let type_infos = ctx.type_ctx.type_infos in
+  let values =
+    List.filter
+      (fun (_, (av : V.tavalue)) ->
+        TypesUtils.ty_has_mut_borrow_for_region_in_set type_infos owned av.ty)
+      (List.mapi (fun index av -> (index, av)) abs.avalues)
+  in
+  let has_pending =
+    List.exists
+      (fun (_, (av : V.tavalue)) ->
+        match av.value with
+        | V.ASymbolic (_, V.APendingLoans _) -> true
+        | _ -> false)
+      values
+  in
+  if not has_pending then None
+  else
+    let kind (av : V.tavalue) : bool =
+      match av.value with
+      | V.ABorrow
+          ( V.AMutBorrow _ | V.AIgnoredMutBorrow _ | V.AEndedMutBorrow _
+          | V.AEndedIgnoredMutBorrow _ )
+      | V.ASymbolic (_, (V.AProjBorrows _ | V.AEndedProjBorrows _)) -> false
+      | V.ALoan
+          ( V.AMutLoan _ | V.AIgnoredMutLoan _ | V.AEndedMutLoan _
+          | V.AEndedIgnoredMutLoan _ )
+      | V.ASymbolic
+          (_, (V.APendingLoans _ | V.AProjLoans _ | V.AEndedProjLoans _)) ->
+          true
+      | V.AIgnored _ -> raise Not_found
+      | _ ->
+          [%craise] span
+            "Nested borrows: a value of a join or loop abstraction with \
+             pending loans is neither a mutable borrow nor a mutable loan"
+    in
+    let values =
+      List.filter_map
+        (fun (index, (av : V.tavalue)) ->
+          match kind av with
+          | is_loan ->
+              Some (index, av, is_loan, List.length (kstage_route ctx owned av.ty))
+          | exception Not_found -> None)
+        values
+    in
+    let depth =
+      1
+      + List.fold_left
+          (fun depth (_, _, is_loan, d) -> if is_loan then max depth d else depth)
+          0 values
+    in
+    if depth < 3 then None
+    else
+      let positions =
+        List.concat_map
+          (fun (index, (av : V.tavalue), is_loan, d) ->
+            let prefix =
+              if is_loan then List.init (depth - d - 1) (fun _ -> false) @ [ true ]
+              else (
+                [%cassert] span (d <= depth)
+                  "Nested borrows: a borrow of a join or loop abstraction is \
+                   deeper than its loans";
+                List.init (depth - d) (fun _ -> false))
+            in
+            List.map
+              (fun rel ->
+                let level = List.length (List.filter Fun.id rel) in
+                ({ av_index = index; rel_path = rel; level }, prefix @ rel))
+              (back_ty_paths_for_regions ctx.decls_ctx (region_selected owned)
+                 av.ty))
