+         different depths";
+      let stage_map =
+        back_positions_stage_map (List.map (fun (_, full) -> (true, full)) positions)
+      in
+      let num_stages = back_num_stages stage_map in
+      if num_stages < 3 then None
+      else
+        let stage_of full =
+          ( List.assoc (true, full) stage_map,
+            snd (back_path_raw_stage (false :: full)) )
+        in
+        let positions =
+          List.map
+            (fun (pos, full) ->
+              let stage, received = stage_of full in
+              (pos, full, stage, received))
+            positions
+        in
+        (* The values whose positions at level 0 belong to the early stages
+           are not inputs of the last stage *)
+        List.iter
+          (fun (index, _, _, _) ->
+            let stages =
+              List.sort_uniq compare
+                (List.filter_map
+                   (fun (pos, _, stage, _) ->
+                     if pos.av_index = index && pos.level = 0 then
+                       Some (stage = num_stages - 1)
+                     else None)
+                   positions)
+            in
+            [%cassert] span
+              (List.length stages <= 1)
