diff --git a/tests/src/nested-borrows-depth3-generic-fnmut.rs b/tests/src/nested-borrows-depth3-generic-fnmut.rs
new file mode 100644
index 0000000..99eb72a
--- /dev/null
+++ b/tests/src/nested-borrows-depth3-generic-fnmut.rs
@@ -0,0 +1,193 @@
+//@ [!lean] skip
+//@ [lean] subdir=NestedBorrowsDepth3GenericFnmut
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::option::{core::option::Option}
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Three levels of mutable borrows of closures whose innermost closure is an
+//! `FnMut` type parameter (production: chelis_deep `Metadata::any_expression`,
+//! which calls `find_expression` with a closure capturing `&mut f` for a
+//! generic `f: impl FnMut(&Expr) -> bool`, and `find_expression` visits the
+//! expressions with a closure capturing `&mut result` and `&mut` that closure;
+//! chelis-ir lowering_runtime `try_any_metadata_expression`).
+//!
+//! The type of the closure of `find_expression` instantiated with the closure
+//! of `any_expression` has the field `&'r mut AnyClosure<'s, F>`, whose type
+//! arguments carry the clause `F : for<'a> FnMut(&'a Expr) -> bool`. The
+//! implied predicate `AnyClosure<'s, F> : 'r` (so `'s : 'r`) was not added to
+//! the closure type because of the region bound by the clause: in the regions
+//! hierarchy of the visitors, the regions of the closure of `any_expression`
+//! were not below the region of its borrow, and its input abstraction ended
+//! before the loan of that borrow ('Internal error', InterpBorrows in a loop,
+//! SymbolicToPureExpressions in straight-line code). The generic functions are
+//! translated as such (the shapes of production), and the concrete entry points
+//! instantiate them with closures whose clauses bind regions too.
+
+pub struct Expr {
+    pub n: u32,
+}
+
+pub struct Meta {
+    pub values: Vec<Expr>,
+}
+
+impl Meta {
+    /// The production visitor: a loop over the expressions
+    pub fn visit_expressions<'a>(&'a self, visit: &mut impl FnMut(&'a Expr)) {
+        for value in self.values.iter() {
+            visit(value);
+        }
+    }
+
+    /// Straight-line code: the first two expressions
+    pub fn visit_first_two<'a>(&'a self, visit: &mut impl FnMut(&'a Expr)) {
+        visit(&self.values[0]);
+        visit(&self.values[1]);
+    }
+
+    pub fn find_expression<'a, T>(
+        &'a self,
+        mut f: impl FnMut(&'a Expr) -> Option<T>,
+    ) -> Option<T> {
+        let mut result = None;
+        self.visit_expressions(&mut |value| {
+            if result.is_none() {
+                result = f(value);
+            }
+        });
+        result
+    }
+
+    pub fn find_first_two<'a, T>(
+        &'a self,
+        mut f: impl FnMut(&'a Expr) -> Option<T>,
+    ) -> Option<T> {
+        let mut result = None;
+        self.visit_first_two(&mut |value| {
+            if result.is_none() {
+                result = f(value);
+            }
+        });
+        result
+    }
+
+    /// The production shape
+    pub fn any_expression(&self, mut f: impl FnMut(&Expr) -> bool) -> bool {
+        self.find_expression(|value| if f(value) { Some(()) } else { None })
+            .is_some()
+    }
+
+    /// The middle closure also writes through a borrow of the caller
+    pub fn any_counting(&self, calls: &mut u32, mut f: impl FnMut(&Expr) -> bool) -> bool {
+        self.find_expression(|value| {
+            *calls += 1;
+            if f(value) {
+                Some(())
+            } else {
+                None
+            }
+        })
+        .is_some()
+    }
+
+    /// The same in straight-line code
+    pub fn any_first_two(&self, calls: &mut u32, mut f: impl FnMut(&Expr) -> bool) -> bool {
+        self.find_first_two(|value| {
+            *calls += 1;
+            if f(value) {
+                Some(())
+            } else {
+                None
+            }
+        })
+        .is_some()
+    }
+}
+
+/// The generic closure is itself called through a closure
+pub fn any_generic(m: &Meta, calls: &mut u32, mut g: impl FnMut(&Expr) -> bool) -> bool {
+    m.any_first_two(calls, |e| g(e))
+}
+
+fn meta(a: u32, b: u32, c: u32) -> Meta {
+    let mut values = Vec::new();
+    values.push(Expr { n: a });
+    values.push(Expr { n: b });
+    values.push(Expr { n: c });
+    Meta { values }
+}
+
+/// The production shape, in a loop
+pub fn run_any(a: u32, b: u32, c: u32, limit: u32) -> bool {
+    let m = meta(a, b, c);
+    m.any_expression(|e| e.n > limit)
+}
+
+/// `(found, calls)`: the middle closure counts its calls, in a loop
+pub fn run_counting(a: u32, b: u32, c: u32, limit: u32) -> (bool, u32) {
+    let m = meta(a, b, c);
+    let mut calls = 10;
+    let found = m.any_counting(&mut calls, |e| e.n > limit);
+    (found, calls)
+}
+
+/// `(found, calls, hits, last)`: every closure writes through a borrow of its
+/// caller (the innermost one counts the expressions it visits and records the
+/// last one)
+pub fn run_first_two(a: u32, b: u32, c: u32, limit: u32) -> (bool, u32, u32, u32) {
+    let m = meta(a, b, c);
+    let mut calls = 10;
+    let mut hits = 0;
+    let mut last = 0;
+    let found = m.any_first_two(&mut calls, |e| {
+        hits += 1;
+        last = e.n;
+        e.n > limit
+    });
+    (found, calls, hits, last)
+}
+
+/// `(found, calls, hits, last)` through `any_generic`
+pub fn run_generic(a: u32, b: u32, c: u32, limit: u32) -> (bool, u32, u32, u32) {
+    let m = meta(a, b, c);
+    let mut calls = 20;
+    let mut hits = 0;
+    let mut last = 0;
+    let found = any_generic(&m, &mut calls, |e| {
+        hits += 1;
+        last = e.n;
+        e.n > limit
+    });
+    (found, calls, hits, last)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn run_any_native() {
+        assert_eq!(run_any(1, 5, 2, 3), true);
+        assert_eq!(run_any(1, 2, 3, 9), false);
+        assert_eq!(run_any(1, 2, 7, 3), true);
+    }
+
+    #[test]
+    fn run_counting_native() {
+        assert_eq!(run_counting(1, 5, 2, 3), (true, 12));
+        assert_eq!(run_counting(1, 2, 3, 9), (false, 13));
+        assert_eq!(run_counting(7, 1, 1, 3), (true, 11));
+    }
+
+    #[test]
+    fn run_first_two_native() {
+        assert_eq!(run_first_two(1, 5, 2, 3), (true, 12, 2, 5));
+        assert_eq!(run_first_two(1, 2, 9, 3), (false, 12, 2, 2));
+        assert_eq!(run_first_two(4, 2, 9, 3), (true, 11, 1, 4));
+    }
+
+    #[test]
+    fn run_generic_native() {
+        assert_eq!(run_generic(1, 5, 2, 3), (true, 22, 2, 5));
+        assert_eq!(run_generic(1, 2, 9, 3), (false, 22, 2, 2));
+        assert_eq!(run_generic(8, 2, 9, 7), (true, 21, 1, 8));
+    }
+}
diff --git a/tests/src/nested-borrows-four-levels-join-loop.rs b/tests/src/nested-borrows-four-levels-join-loop.rs
new file mode 100644
index 0000000..322ca75
--- /dev/null
+++ b/tests/src/nested-borrows-four-levels-join-loop.rs
@@ -0,0 +1,137 @@
+//@ [!lean] skip
+//@ [lean] subdir=NestedBorrowsFourLevelsJoinLoop
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::option::{core::option::Option}
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Four levels of mutable borrows at a join and in a loop. The abstraction of
+//! the innermost region holds pending loans for two parent borrows. Its
+//! continuation is staged in four stages, like the backward function of a
+//! callee on `&mut A<'a, 'b, 'c>` (DESIGN-4LEVELS section 1). The structures
+//! give real backward functions. The closures give the visitor shape of
+//! `Metadata::visit_expressions` (a loop with a match over a closure chain of
+//! three levels).
+
+pub struct C<'a> {
+    pub x: &'a mut u32,
+}
+pub struct B<'a, 'b> {
+    pub c: &'a mut C<'b>,
+}
+pub struct A<'a, 'b, 'c> {
+    pub b: &'a mut B<'b, 'c>,
+}
+
+pub fn bump(a: &mut A<'_, '_, '_>, k: u32) {
+    *a.b.c.x = a.b.c.x.wrapping_add(k);
+}
+
+pub fn join_bump(a: &mut A<'_, '_, '_>, flag: bool) {
+    if flag {
+        bump(a, 1);
+    }
+    bump(a, 10);
+}
+
+pub fn loop_bump(a: &mut A<'_, '_, '_>, n: u32) {
+    let mut i = 0;
+    while i < n {
+        bump(a, i + 1);
+        i += 1;
+    }
+}
+
+pub fn run_join(x: u32, flag: bool) -> u32 {
+    let mut x = x;
+    let mut c = C { x: &mut x };
+    let mut b = B { c: &mut c };
+    let mut a = A { b: &mut b };
+    join_bump(&mut a, flag);
+    x
+}
+
+pub fn run_loop(x: u32, n: u32) -> u32 {
+    let mut x = x;
+    let mut c = C { x: &mut x };
+    let mut b = B { c: &mut c };
+    let mut a = A { b: &mut b };
+    loop_bump(&mut a, n);
+    x
+}
+
+/// The value is written back through the borrows after the call.
+pub fn run_join_then_write(x: u32, flag: bool) -> u32 {
+    let mut x = x;
+    let mut c = C { x: &mut x };
+    let mut b = B { c: &mut c };
+    let mut a = A { b: &mut b };
+    join_bump(&mut a, flag);
+    *a.b.c.x = a.b.c.x.wrapping_mul(2);
+    x
+}
+
+pub struct E(pub u32);
+pub enum V {
+    T(E),
+    I,
+}
+pub struct M {
+    pub v: Vec<V>,
+}
+
+impl M {
+    pub fn vis<'a>(&'a self, f: &mut impl FnMut(&'a E)) {
+        for x in self.v.iter() {
+            match x {
+                V::T(e) => f(e),
+                V::I => {}
+            }
+        }
+    }
+
+    pub fn find<'a, T>(&'a self, mut f: impl FnMut(&'a E) -> Option<T>) -> Option<T> {
+        let mut r = None;
+        self.vis(&mut |x| {
+            if r.is_none() {
+                r = f(x);
+            }
+        });
+        r
+    }
+
+    pub fn any(&self, mut f: impl FnMut(&E) -> bool) -> bool {
+        self.find(|x| if f(x) { Some(()) } else { None }).is_some()
+    }
+}
+
+pub fn count(m: &M, n: u32) -> (bool, u32) {
+    let mut c = 0u32;
+    let b = m.any(|x| {
+        c += 1;
+        x.0 == n
+    });
+    (b, c)
+}
+
+pub fn run_count(a: u32, b: u32, c: u32, n: u32) -> (bool, u32) {
+    let m = M { v: vec![V::I, V::T(E(a)), V::T(E(b)), V::I, V::T(E(c))] };
+    count(&m, n)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn four_levels() {
+        assert_eq!(run_join(5, true), 16);
+        assert_eq!(run_join(5, false), 15);
+        assert_eq!(run_loop(5, 3), 11);
+        assert_eq!(run_loop(0, 0), 0);
+        assert_eq!(run_loop(7, 1), 8);
+        assert_eq!(run_join_then_write(5, true), 32);
+        assert_eq!(run_join_then_write(4, false), 28);
+        assert_eq!(run_count(3, 7, 9, 7), (true, 2));
+        assert_eq!(run_count(3, 7, 9, 3), (true, 1));
+        assert_eq!(run_count(3, 7, 9, 8), (false, 3));
+        assert_eq!(run_count(1, 1, 1, 1), (true, 1));
+    }
+}
