+import NestedBorrowsDepth3GenericFnmut.NestedBorrowsDepth3GenericFnmut
+
+/-! Evaluate the model of `tests/src/nested-borrows-depth3-generic-fnmut.rs`
+    on the inputs of its `native` test module and compare with the native
+    results: whether an expression was found, the calls counted by the middle
+    closure, and the expressions counted and recorded by the innermost closure
+    (each written through the borrows of its caller, given back through every
+    level). -/
+
+namespace nested_borrows_depth3_generic_fnmut.checks
+open Aeneas Aeneas.Std Result
+
+def u (x : Nat) : U32 := ⟨BitVec.ofNat _ x⟩
+
+def runAny (a b c limit : Nat) : Option Bool :=
+  match run_any (u a) (u b) (u c) (u limit) with
+  | ok found => some found
+  | _ => none
+
+/-- `(found, calls)` -/
+def runCounting (a b c limit : Nat) : Option (Bool × Nat) :=
+  match run_counting (u a) (u b) (u c) (u limit) with
+  | ok (found, calls) => some (found, calls.val)
+  | _ => none
+
+/-- `(found, calls, hits, last)` -/
+def runFirstTwo (a b c limit : Nat) : Option (Bool × Nat × Nat × Nat) :=
+  match run_first_two (u a) (u b) (u c) (u limit) with
+  | ok (found, calls, hits, last) => some (found, calls.val, hits.val, last.val)
+  | _ => none
+
+/-- `(found, calls, hits, last)` -/
+def runGeneric (a b c limit : Nat) : Option (Bool × Nat × Nat × Nat) :=
+  match run_generic (u a) (u b) (u c) (u limit) with
+  | ok (found, calls, hits, last) => some (found, calls.val, hits.val, last.val)
+  | _ => none
+
+-- run_any_native
+#guard runAny 1 5 2 3 == some true
+#guard runAny 1 2 3 9 == some false
+#guard runAny 1 2 7 3 == some true
+
+-- run_counting_native
+#guard runCounting 1 5 2 3 == some (true, 12)
+#guard runCounting 1 2 3 9 == some (false, 13)
+#guard runCounting 7 1 1 3 == some (true, 11)
+
+-- run_first_two_native
+#guard runFirstTwo 1 5 2 3 == some (true, 12, 2, 5)
+#guard runFirstTwo 1 2 9 3 == some (false, 12, 2, 2)
+#guard runFirstTwo 4 2 9 3 == some (true, 11, 1, 4)
+
+-- run_generic_native
+#guard runGeneric 1 5 2 3 == some (true, 22, 2, 5)
+#guard runGeneric 1 2 9 3 == some (false, 22, 2, 2)
+#guard runGeneric 8 2 9 7 == some (true, 21, 1, 8)
+
+end nested_borrows_depth3_generic_fnmut.checks
