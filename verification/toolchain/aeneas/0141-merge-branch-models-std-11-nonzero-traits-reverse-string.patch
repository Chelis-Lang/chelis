+@[rust_fun
+  "core::cmp::{core::cmp::PartialOrd<core::cmp::Reverse<@T>, core::cmp::Reverse<@T>>}::__chaining_le"]
+def core.cmp.PartialOrdReverse.__chaining_le {T : Type} (inst : core.cmp.PartialOrd T T)
+    (self other : core.cmp.Reverse T) : Result (core.ops.control_flow.ControlFlow Bool Unit) :=
+  core.cmp.PartialOrd.chaining_body (· != .gt) (core.cmp.PartialOrdReverse.partial_cmp inst)
+    self other
+
+@[rust_fun
+  "core::cmp::{core::cmp::PartialOrd<core::cmp::Reverse<@T>, core::cmp::Reverse<@T>>}::__chaining_gt"]
