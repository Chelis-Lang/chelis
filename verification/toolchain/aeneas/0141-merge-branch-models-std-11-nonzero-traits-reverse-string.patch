+/-- `lt` is `other.0 < self.0` (`T::lt`, not through `partial_cmp`), and so for `le`, `gt`
+    and `ge`. -/
+@[rust_fun "core::cmp::{core::cmp::PartialOrd<core::cmp::Reverse<@T>, core::cmp::Reverse<@T>>}::lt"]
+def core.cmp.PartialOrdReverse.lt {T : Type} (inst : core.cmp.PartialOrd T T)
+    (self other : core.cmp.Reverse T) : Result Bool :=
+  inst.lt other self
+
+@[rust_fun "core::cmp::{core::cmp::PartialOrd<core::cmp::Reverse<@T>, core::cmp::Reverse<@T>>}::le"]
+def core.cmp.PartialOrdReverse.le {T : Type} (inst : core.cmp.PartialOrd T T)
+    (self other : core.cmp.Reverse T) : Result Bool :=
+  inst.le other self
+
+@[rust_fun "core::cmp::{core::cmp::PartialOrd<core::cmp::Reverse<@T>, core::cmp::Reverse<@T>>}::gt"]
+def core.cmp.PartialOrdReverse.gt {T : Type} (inst : core.cmp.PartialOrd T T)
+    (self other : core.cmp.Reverse T) : Result Bool :=
+  inst.gt other self
+
+@[rust_fun "core::cmp::{core::cmp::PartialOrd<core::cmp::Reverse<@T>, core::cmp::Reverse<@T>>}::ge"]
