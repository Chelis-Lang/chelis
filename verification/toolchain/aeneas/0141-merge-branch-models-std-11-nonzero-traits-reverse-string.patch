+    (self other : core.cmp.Reverse T) : Result (core.ops.control_flow.ControlFlow Bool Unit) :=
+  core.cmp.PartialOrd.chaining_body (· == .gt) (core.cmp.PartialOrdReverse.partial_cmp inst)
+    self other
+
+@[rust_fun
+  "core::cmp::{core::cmp::PartialOrd<core::cmp::Reverse<@T>, core::cmp::Reverse<@T>>}::__chaining_ge"]
+def core.cmp.PartialOrdReverse.__chaining_ge {T : Type} (inst : core.cmp.PartialOrd T T)
+    (self other : core.cmp.Reverse T) : Result (core.ops.control_flow.ControlFlow Bool Unit) :=
+  core.cmp.PartialOrd.chaining_body (· != .lt) (core.cmp.PartialOrdReverse.partial_cmp inst)
+    self other
+
+@[reducible, rust_trait_impl
+  "core::cmp::PartialOrd<core::cmp::Reverse<@T>, core::cmp::Reverse<@T>>"]
+def core.cmp.PartialOrdReverse {T : Type} (inst : core.cmp.PartialOrd T T) :
+    core.cmp.PartialOrd (core.cmp.Reverse T) (core.cmp.Reverse T) := {
+  partialEqInst := core.cmp.PartialEqReverse inst.partialEqInst
+  partial_cmp := core.cmp.PartialOrdReverse.partial_cmp inst
+  lt := core.cmp.PartialOrdReverse.lt inst
+  le := core.cmp.PartialOrdReverse.le inst
+  gt := core.cmp.PartialOrdReverse.gt inst
+  ge := core.cmp.PartialOrdReverse.ge inst
+  __chaining_lt := core.cmp.PartialOrdReverse.__chaining_lt inst
+  __chaining_le := core.cmp.PartialOrdReverse.__chaining_le inst
+  __chaining_gt := core.cmp.PartialOrdReverse.__chaining_gt inst
+  __chaining_ge := core.cmp.PartialOrdReverse.__chaining_ge inst
