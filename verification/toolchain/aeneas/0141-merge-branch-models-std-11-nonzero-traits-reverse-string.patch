+def core.cmp.OrdReverse {T : Type} (inst : core.cmp.Ord T) :
+    core.cmp.Ord (core.cmp.Reverse T) := {
+  eqInst := core.cmp.EqReverse inst.eqInst
+  partialOrdInst := core.cmp.PartialOrdReverse inst.partialOrdInst
