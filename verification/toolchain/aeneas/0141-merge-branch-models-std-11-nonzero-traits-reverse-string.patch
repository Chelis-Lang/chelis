+    (hash : γ → core.hash.Hasher H → T → H → Result H) (hasher : core.hash.Hasher H)
+    (xs : List T) (state : H) (hmono : Lean.Order.monotone hash) :
+    Lean.Order.monotone (fun g => core.hash.hashEach (hash g) hasher xs state) := by
+  induction xs generalizing state with
+  | nil => exact monotone_const _
+  | cons x xs ih =>
+    simp only [core.hash.hashEach]
+    repeat' first
+      | exact ih _
+      | exact monotone_apply _ _ (monotone_apply _ _ (monotone_apply _ _ hmono))
+      | monotonicity
+
 end HashMono
 
