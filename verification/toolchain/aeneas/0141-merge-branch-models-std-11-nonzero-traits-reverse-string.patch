+import Aeneas.Std.Core.Cmp
+
+/-! `core::cmp::Reverse<T>` (core/src/cmp.rs, rustc 1.95): `pub struct Reverse<T>(pub T)` with
+    the derived `PartialEq` and `Eq` and the hand-written `PartialOrd` and `Ord`, which compare
+    the fields in the other order. Aeneas represents a tuple structure of one field by that field
+    (`Reverse(x)` is `x` and `r.0` is `r`), so the model of the type is the alias `T`. -/
+
+namespace Aeneas.Std
+
+open Result
+
+@[reducible, rust_type "core::cmp::Reverse"]
+def core.cmp.Reverse (T : Type) : Type := T
+
+/-- `#[derive(PartialEq)]`: `self.0 == other.0`. -/
+@[rust_fun "core::cmp::{core::cmp::PartialEq<core::cmp::Reverse<@T>, core::cmp::Reverse<@T>>}::eq"]
+def core.cmp.PartialEqReverse.eq {T : Type} (inst : core.cmp.PartialEq T T)
+    (self other : core.cmp.Reverse T) : Result Bool :=
+  inst.eq self other
+
+/-- The derive defines only `eq`: `ne` is the provided `!self.eq(other)`, not `T::ne`. -/
+@[rust_fun "core::cmp::{core::cmp::PartialEq<core::cmp::Reverse<@T>, core::cmp::Reverse<@T>>}::ne"]
+def core.cmp.PartialEqReverse.ne {T : Type} (inst : core.cmp.PartialEq T T)
+    (self other : core.cmp.Reverse T) : Result Bool := do
+  ok (not (← inst.eq self other))
+
+@[reducible, rust_trait_impl "core::cmp::PartialEq<core::cmp::Reverse<@T>, core::cmp::Reverse<@T>>"]
+def core.cmp.PartialEqReverse {T : Type} (inst : core.cmp.PartialEq T T) :
+    core.cmp.PartialEq (core.cmp.Reverse T) (core.cmp.Reverse T) := {
+  eq := core.cmp.PartialEqReverse.eq inst
+  ne := core.cmp.PartialEqReverse.ne inst
+}
+
+/-- `#[derive(Eq)]`: the receiver check exists only at compile time. -/
+@[rust_fun "core::cmp::{core::cmp::Eq<core::cmp::Reverse<@T>>}::assert_receiver_is_total_eq"]
+def core.cmp.EqReverse.assert_receiver_is_total_eq {T : Type} (_ : core.cmp.Eq T)
+    (_ : core.cmp.Reverse T) : Result Unit :=
+  ok ()
+
+@[reducible, rust_trait_impl "core::cmp::Eq<core::cmp::Reverse<@T>>"]
+def core.cmp.EqReverse {T : Type} (inst : core.cmp.Eq T) : core.cmp.Eq (core.cmp.Reverse T) := {
+  partialEqInst := core.cmp.PartialEqReverse inst.partialEqInst
+  assert_receiver_is_total_eq := core.cmp.EqReverse.assert_receiver_is_total_eq inst
+}
+
+/-- `partial_cmp` is `other.0.partial_cmp(&self.0)`. -/
+@[rust_fun
+  "core::cmp::{core::cmp::PartialOrd<core::cmp::Reverse<@T>, core::cmp::Reverse<@T>>}::partial_cmp"]
+def core.cmp.PartialOrdReverse.partial_cmp {T : Type} (inst : core.cmp.PartialOrd T T)
+    (self other : core.cmp.Reverse T) : Result (Option Ordering) :=
+  inst.partial_cmp other self
