+/-- `max`, `min` and `clamp` are `Ord`'s provided methods, through `Reverse`'s `lt`, `le` and
+    `gt`: `max` is `if other < self { self } else { other }`, `min` is
+    `if other < self { other } else { self }`, and `clamp` asserts `min <= max`. -/
+@[rust_fun "core::cmp::{core::cmp::Ord<core::cmp::Reverse<@T>>}::max"]
+def core.cmp.OrdReverse.max {T : Type} (inst : core.cmp.Ord T)
+    (self other : core.cmp.Reverse T) : Result (core.cmp.Reverse T) :=
+  core.cmp.Ord.max_body (core.cmp.PartialOrdReverse.lt inst.partialOrdInst) self other
+
+@[rust_fun "core::cmp::{core::cmp::Ord<core::cmp::Reverse<@T>>}::min"]
+def core.cmp.OrdReverse.min {T : Type} (inst : core.cmp.Ord T)
+    (self other : core.cmp.Reverse T) : Result (core.cmp.Reverse T) :=
+  core.cmp.Ord.min_body (core.cmp.PartialOrdReverse.lt inst.partialOrdInst) self other
+
+@[rust_fun "core::cmp::{core::cmp::Ord<core::cmp::Reverse<@T>>}::clamp"]
+def core.cmp.OrdReverse.clamp {T : Type} (inst : core.cmp.Ord T)
+    (self min max : core.cmp.Reverse T) : Result (core.cmp.Reverse T) :=
+  core.cmp.Ord.clamp_body (core.cmp.PartialOrdReverse.le inst.partialOrdInst)
+    (core.cmp.PartialOrdReverse.lt inst.partialOrdInst)
+    (core.cmp.PartialOrdReverse.gt inst.partialOrdInst) self min max
