+open Aeneas Aeneas.Std Result
+
+def u32' (n : Nat) : U32 := ⟨BitVec.ofNat _ n⟩
+
+def vec (xs : List Nat) (h : xs.length ≤ Usize.max := by scalar_tac) : alloc.vec.Vec U32 :=
+  ⟨xs.map u32', by simpa using h⟩
+
+def nats (v : alloc.vec.Vec U32) : List Nat := v.val.map (·.val)
+
+/-- Native `after`: call `f` on a sink over `[5]` and `n0`, then write through
+    the sink; the result, the vector and counter after the call, and the vector
+    and counter given back. -/
+def after (n0 : Nat) (f : Sink → Result (U32 × Sink × (Sink → Sink))) :
+    Option (Nat × List Nat × Nat × List Nat × Nat) :=
+  match (do
+    let (x, s, back) ← f { errors := vec [5], native := u32' n0 }
+    let v ← alloc.vec.Vec.push s.errors (u32' 7)
+    let n ← s.native + u32' 100
+    let g := back { errors := v, native := n }
+    ok (x, s, g) : Result (U32 × Sink × Sink)) with
+  | ok (x, s, g) => some (x.val, nats s.errors, s.native.val, nats g.errors, g.native.val)
+  | _ => none
+
+def ran (r : Result (U32 × alloc.vec.Vec U32 × U32)) : Option (Nat × List Nat × Nat) :=
+  match r with
+  | ok (x, v, n) => some (x.val, nats v, n.val)
+  | _ => none
+
