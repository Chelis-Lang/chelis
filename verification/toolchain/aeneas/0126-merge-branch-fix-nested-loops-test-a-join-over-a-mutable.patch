+//@ [!lean] skip
+//@ [lean] subdir=JoinMutFieldsStruct
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! A mutable borrow of a struct whose fields are mutable borrows (the
+//! diagnostics sink of `chelis_types::infer::expr_record::infer_cast`:
+//! `DiagnosticSink<'s> { errors: &'s mut Vec<..>, native: &'s mut .. }`),
+//! passed to a call in a short-circuit condition with an early return
+//! (`if b && check(.., errors) { return ..; }`), then a match on an enum with a
+//! boxed variant.
+//!
+//! The join after the condition builds an abstraction over the struct value
+//! behind the borrow (`{ MB .., MB .., ⌊s : Sink⌋ }`), whose continuation takes
+//! one `Sink`. In the arms of the match that value is expanded into
+//! `Sink { errors = MB ..; native = MB .. }`, which turns the input of the
+//! abstraction into the loans `Sink { errors = ML ..; native = ML .. }`. The join
+//! of the match arms kept that abstraction unchanged, but its canonicalization
+//! flattened it into `{ .., ML .., ML .. }`: ending it at the return gave two
+//! arguments to the one-argument continuation ("Expected an arrow type"). The
+//! canonicalization of a join of branches now gives an abstraction it kept
+//! unchanged and did not merge its shape back (see the test
+//! loop-untouched-shared-reborrows), so the continuation receives one `Sink`.
+//!
+//! JoinMutFieldsStruct/Checks.lean compares the model with the native results
+//! asserted in the native test module, including the vector and the counter
+//! given back through the sink after the caller writes through it.
+
+pub struct Sink<'s> {
+    pub errors: &'s mut Vec<u32>,
+    pub native: &'s mut u32,
+}
+
+pub enum Ty {
+    Prim(u32),
+    Adt(u32),
+    Ref(Box<Ty>),
+}
+
+/// Record `id`; true once the counter exceeds 2
+fn check(id: &u32, errors: &mut Sink<'_>) -> bool {
+    *errors.native += 1;
+    errors.errors.push(*id);
+    *errors.native > 2
+}
+
+/// The shape of `infer_cast`
+pub fn cast(b: bool, target: Ty, errors: &mut Sink<'_>) -> u32 {
+    if b && check(&1, errors) {
+        return 2;
+    }
+    match target {
+        Ty::Prim(p) => p,
+        _ => 0,
+    }
+}
+
+/// Two short-circuit conditions with early returns
+pub fn cast_twice(b: bool, c: bool, target: Ty, errors: &mut Sink<'_>) -> u32 {
+    if b && check(&1, errors) {
+        return 2;
+    }
+    if c && check(&4, errors) {
+        return 3;
+    }
+    match target {
+        Ty::Prim(p) => p,
+        _ => 0,
+    }
+}
+
+/// A write through a field of the sink after the join
+pub fn cast_then_write(b: bool, target: Ty, errors: &mut Sink<'_>) -> u32 {
+    if b && check(&1, errors) {
+        return 2;
+    }
+    *errors.native += 10;
+    match target {
+        Ty::Prim(p) => p,
+        _ => 0,
+    }
+}
+
+/// The condition in a loop, which it leaves with `break`
+pub fn cast_loop(b: bool, n: u32, target: Ty, errors: &mut Sink<'_>) -> u32 {
+    let mut i = 0;
+    while i < n {
+        if b && check(&i, errors) {
+            break;
+        }
+        i += 1;
+    }
+    match target {
+        Ty::Prim(p) => p + i,
+        _ => i,
+    }
+}
+
+/// A caller: builds the sink, calls `cast_twice`, then writes through the sink
+/// before its borrows end
+pub fn run(b: bool, c: bool, target: Ty, v: &mut Vec<u32>, n: &mut u32) -> u32 {
+    let mut sink = Sink { errors: v, native: n };
+    let r = cast_twice(b, c, target, &mut sink);
+    sink.errors.push(7);
+    *sink.native += 100;
+    r
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    /// Call `f` on a sink over `[5]` and `n0`, then write through the sink
+    /// (push 7, add 100 to the counter): the result, the vector and counter
+    /// after the call, and the vector and counter given back.
+    fn after(n0: u32, f: impl FnOnce(&mut Sink<'_>) -> u32) -> (u32, Vec<u32>, u32, Vec<u32>, u32) {
+        let mut v = vec![5];
+        let mut n = n0;
+        let (x, v1, n1);
+        {
+            let mut sink = Sink { errors: &mut v, native: &mut n };
+            x = f(&mut sink);
+            v1 = sink.errors.clone();
+            n1 = *sink.native;
+            sink.errors.push(7);
+            *sink.native += 100;
+        }
+        (x, v1, n1, v, n)
+    }
+
+    #[test]
+    fn cast_native() {
+        assert_eq!(after(1, |s| cast(false, Ty::Prim(4), s)), (4, vec![5], 1, vec![5, 7], 101));
+        assert_eq!(after(1, |s| cast(true, Ty::Prim(4), s)), (4, vec![5, 1], 2, vec![5, 1, 7], 102));
+        assert_eq!(after(2, |s| cast(true, Ty::Prim(4), s)), (2, vec![5, 1], 3, vec![5, 1, 7], 103));
+        assert_eq!(after(1, |s| cast(true, Ty::Adt(3), s)), (0, vec![5, 1], 2, vec![5, 1, 7], 102));
+        let r = Ty::Ref(Box::new(Ty::Prim(6)));
+        assert_eq!(after(0, |s| cast(true, r, s)), (0, vec![5, 1], 1, vec![5, 1, 7], 101));
+    }
+
+    #[test]
+    fn cast_twice_native() {
+        assert_eq!(after(0, |s| cast_twice(true, true, Ty::Prim(4), s)), (4, vec![5, 1, 4], 2, vec![5, 1, 4, 7], 102));
+        assert_eq!(after(1, |s| cast_twice(true, true, Ty::Prim(4), s)), (3, vec![5, 1, 4], 3, vec![5, 1, 4, 7], 103));
+        assert_eq!(after(2, |s| cast_twice(true, true, Ty::Prim(4), s)), (2, vec![5, 1], 3, vec![5, 1, 7], 103));
+        assert_eq!(after(2, |s| cast_twice(false, true, Ty::Adt(4), s)), (3, vec![5, 4], 3, vec![5, 4, 7], 103));
+        assert_eq!(after(0, |s| cast_twice(false, false, Ty::Prim(9), s)), (9, vec![5], 0, vec![5, 7], 100));
+    }
+
+    #[test]
+    fn cast_then_write_native() {
+        assert_eq!(after(1, |s| cast_then_write(true, Ty::Prim(4), s)), (4, vec![5, 1], 12, vec![5, 1, 7], 112));
+        assert_eq!(after(2, |s| cast_then_write(true, Ty::Prim(4), s)), (2, vec![5, 1], 3, vec![5, 1, 7], 103));
+        assert_eq!(after(0, |s| cast_then_write(false, Ty::Adt(4), s)), (0, vec![5], 10, vec![5, 7], 110));
+    }
+
+    #[test]
+    fn cast_loop_native() {
+        assert_eq!(after(0, |s| cast_loop(true, 5, Ty::Prim(10), s)), (12, vec![5, 0, 1, 2], 3, vec![5, 0, 1, 2, 7], 103));
+        assert_eq!(after(0, |s| cast_loop(true, 2, Ty::Adt(10), s)), (2, vec![5, 0, 1], 2, vec![5, 0, 1, 7], 102));
+        assert_eq!(after(4, |s| cast_loop(false, 3, Ty::Prim(1), s)), (4, vec![5], 4, vec![5, 7], 104));
+    }
+
+    #[test]
+    fn run_native() {
+        let (mut v, mut n) = (vec![5], 1);
+        assert_eq!(run(true, true, Ty::Prim(4), &mut v, &mut n), 3);
+        assert_eq!((v, n), (vec![5, 1, 4, 7], 103));
+        let (mut v, mut n) = (vec![], 0);
+        assert_eq!(run(true, false, Ty::Adt(4), &mut v, &mut n), 0);
+        assert_eq!((v, n), (vec![1, 7], 101));
+        let (mut v, mut n) = (vec![2], 5);
+        assert_eq!(run(false, false, Ty::Prim(8), &mut v, &mut n), 8);
+        assert_eq!((v, n), (vec![2, 7], 105));
+    }
+}
