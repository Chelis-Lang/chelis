+#guard after 1 (cast false (.Prim (u32' 4))) == some (4, [5], 1, [5, 7], 101)
+#guard after 1 (cast true (.Prim (u32' 4))) == some (4, [5, 1], 2, [5, 1, 7], 102)
+#guard after 2 (cast true (.Prim (u32' 4))) == some (2, [5, 1], 3, [5, 1, 7], 103)
+#guard after 1 (cast true (.Adt (u32' 3))) == some (0, [5, 1], 2, [5, 1, 7], 102)
+#guard after 0 (cast true (.Ref (.Prim (u32' 6)))) == some (0, [5, 1], 1, [5, 1, 7], 101)
+
