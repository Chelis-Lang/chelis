+#guard after 0 (cast_twice true true (.Prim (u32' 4))) == some (4, [5, 1, 4], 2, [5, 1, 4, 7], 102)
+#guard after 1 (cast_twice true true (.Prim (u32' 4))) == some (3, [5, 1, 4], 3, [5, 1, 4, 7], 103)
+#guard after 2 (cast_twice true true (.Prim (u32' 4))) == some (2, [5, 1], 3, [5, 1, 7], 103)
+#guard after 2 (cast_twice false true (.Adt (u32' 4))) == some (3, [5, 4], 3, [5, 4, 7], 103)
+#guard after 0 (cast_twice false false (.Prim (u32' 9))) == some (9, [5], 0, [5, 7], 100)
+
+-- native::cast_then_write_native
+#guard after 1 (cast_then_write true (.Prim (u32' 4))) == some (4, [5, 1], 12, [5, 1, 7], 112)
+#guard after 2 (cast_then_write true (.Prim (u32' 4))) == some (2, [5, 1], 3, [5, 1, 7], 103)
+#guard after 0 (cast_then_write false (.Adt (u32' 4))) == some (0, [5], 10, [5, 7], 110)
+
+-- native::cast_loop_native
+#guard after 0 (cast_loop true (u32' 5) (.Prim (u32' 10))) == some (12, [5, 0, 1, 2], 3, [5, 0, 1, 2, 7], 103)
+#guard after 0 (cast_loop true (u32' 2) (.Adt (u32' 10))) == some (2, [5, 0, 1], 2, [5, 0, 1, 7], 102)
+#guard after 4 (cast_loop false (u32' 3) (.Prim (u32' 1))) == some (4, [5], 4, [5, 7], 104)
+
+-- native::run_native
+#guard ran (run true true (.Prim (u32' 4)) (vec [5]) (u32' 1)) == some (3, [5, 1, 4, 7], 103)
+#guard ran (run true false (.Adt (u32' 4)) (vec []) (u32' 0)) == some (0, [1, 7], 101)
+#guard ran (run false false (.Prim (u32' 8)) (vec [2]) (u32' 5)) == some (8, [2, 7], 105)
+
+end join_mut_fields_struct.checks
