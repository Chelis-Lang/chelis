+import NestedBorrowsSymbolicPaths.NestedBorrowsSymbolicPaths
+
+/-! Evaluate the model of `tests/src/nested-borrows-symbolic-paths.rs` on the
+    inputs of its `native` test module and compare with the native results. -/
+
+namespace nested_borrows_symbolic_paths.checks
+open Aeneas Aeneas.Std Result
+
+def u (x : Nat) : U32 := ⟨BitVec.ofNat _ x⟩
+
+def max := 4294967295
+
+def addTwice (n v d : Nat) : Option (Nat × Nat × Nat) :=
+  match run_add_twice (u n) (u v) (u d) with
+  | ok (a, b, n') => some (a.val, b.val, n'.val)
+  | _ => none
+
+def addTwiceThen (n v d : Nat) : Option (Nat × Nat × Nat × Nat) :=
+  match run_add_twice_then (u n) (u v) (u d) with
+  | ok (a, b, r, n') => some (a.val, b.val, r.val, n'.val)
+  | _ => none
+
+def addThrice (n v : Nat) : Option (Nat × Nat) :=
+  match run_add_thrice (u n) (u v) with
+  | ok (r, n') => some (r.val, n'.val)
+  | _ => none
+
+#guard addTwice 1 2 3 == some (3, 6, 6)
+#guard addTwice max 1 5 == some (0, 5, 5)
+
+#guard addTwiceThen 1 2 3 == some (3, 6, 6, 18)
+#guard addTwiceThen max 1 5 == some (0, 5, 5, 15)
+
+#guard addThrice 1 2 == some (13, 13)
+#guard addThrice max max == some (4294967288, 4294967288)
+
+end nested_borrows_symbolic_paths.checks
