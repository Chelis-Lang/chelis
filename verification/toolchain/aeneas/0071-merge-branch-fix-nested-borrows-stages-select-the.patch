+      in
+      match aproj with
+      | V.AProjLoans p ->
+          let consumed = consumed p.consumed in
+          V.AProjLoans { p with consumed; borrows = children p.borrows }
+      | V.AEndedProjLoans p ->
+          let consumed = consumed p.consumed in
+          V.AEndedProjLoans { p with consumed; borrows = children p.borrows }
+      | V.AProjBorrows p -> V.AProjBorrows { p with loans = children p.loans }
+      | V.AEndedProjBorrows p ->
