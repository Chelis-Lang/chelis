+    (keep_region : T.region -> bool) (selected : bool list list) (depth : int)
+    (ty : T.ty) (aproj : V.aproj) : V.aproj option =
+  let routes =
+    SymbolicToPureTypes.back_ty_routes_for_regions decls_ctx keep_region ty
+  in
+  let positions (ended : T.RegionId.Set.t) : bool list list =
+    List.sort_uniq compare
+      (List.filter_map
+         (fun route ->
+           let path =
+             List.map
+               (fun (r : T.region) ->
+                 match r with
+                 | RVar (Free rid) -> T.RegionId.Set.mem rid ended
+                 | _ -> false)
+               route
+           in
+           if SymbolicToPureTypes.back_path_level path = depth then Some path
+           else None)
