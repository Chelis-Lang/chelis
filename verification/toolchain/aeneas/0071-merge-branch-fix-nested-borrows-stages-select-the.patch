+//@ [!lean] skip
+//@ [lean] subdir=NestedBorrowsSymbolicPaths
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Four levels of nested mutable borrows through structures, with a structure
+//! which the caller does not read: `add_twice` passes the structure `O` it
+//! receives to `add` twice, so the second call consumes the (symbolic)
+//! structure given back by the first one. At a level of the backward function
+//! of the innermost region, the positions of that structure are split between
+//! stages by path (the `C` given back to `W::c` inside the borrowed `W`, and
+//! the `C` inside the `W` given back to `O::w`): the projector of the symbolic
+//! value holds one projection per path (the values given back when the region
+//! of `O::w`, resp. `W::c`, ended), and each stage takes its own.
+
+pub struct C<'a> {
+    pub r: &'a mut u32,
+}
+
+pub struct W<'a, 'b> {
+    pub c: &'a mut C<'b>,
+}
+
+pub struct O<'a, 'b, 'c> {
+    pub w: &'a mut W<'b, 'c>,
+}
+
+pub fn add(o: &mut O<'_, '_, '_>, v: u32) -> u32 {
+    *o.w.c.r = (*o.w.c.r).wrapping_add(v);
+    *o.w.c.r
+}
+
+pub fn add_twice(o: &mut O<'_, '_, '_>, v: u32, d: u32) -> (u32, u32) {
+    let a = add(o, v);
+    let b = add(o, d);
+    (a, b)
+}
+
+pub fn add_thrice(o: &mut O<'_, '_, '_>, v: u32) -> u32 {
+    let (a, b) = add_twice(o, v, v);
+    let c = add(o, a.wrapping_add(b));
+    c
+}
+
+pub fn run_add_twice(n: u32, v: u32, d: u32) -> (u32, u32, u32) {
+    let mut n = n;
+    let mut c = C { r: &mut n };
+    let mut w = W { c: &mut c };
+    let mut o = O { w: &mut w };
+    let (a, b) = add_twice(&mut o, v, d);
+    (a, b, n)
+}
+
+/// The caller reads and writes through the structures after the calls.
+pub fn run_add_twice_then(n: u32, v: u32, d: u32) -> (u32, u32, u32, u32) {
+    let mut n = n;
+    let mut c = C { r: &mut n };
+    let mut w = W { c: &mut c };
+    let mut o = O { w: &mut w };
+    let (a, b) = add_twice(&mut o, v, d);
+    let r = *o.w.c.r;
+    *o.w.c.r = r.wrapping_mul(3);
+    (a, b, r, n)
+}
+
+pub fn run_add_thrice(n: u32, v: u32) -> (u32, u32) {
+    let mut n = n;
+    let mut c = C { r: &mut n };
+    let mut w = W { c: &mut c };
+    let mut o = O { w: &mut w };
+    let r = add_thrice(&mut o, v);
+    (r, n)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn run_add_twice_native() {
+        assert_eq!(run_add_twice(1, 2, 3), (3, 6, 6));
+        assert_eq!(run_add_twice(u32::MAX, 1, 5), (0, 5, 5));
+    }
+
+    #[test]
+    fn run_add_twice_then_native() {
+        assert_eq!(run_add_twice_then(1, 2, 3), (3, 6, 6, 18));
+        assert_eq!(run_add_twice_then(u32::MAX, 1, 5), (0, 5, 5, 15));
+    }
+
+    #[test]
+    fn run_add_thrice_native() {
+        assert_eq!(run_add_thrice(1, 2), (13, 13));
+        assert_eq!(run_add_thrice(u32::MAX, u32::MAX), (4294967288, 4294967288));
+    }
+}
