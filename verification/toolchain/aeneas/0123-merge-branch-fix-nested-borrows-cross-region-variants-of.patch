+/// [visit_meta] with an inner closure which reads both borrows to update each
+/// one: the value given back to each borrow depends on the other borrow's
+/// values along the visit
+pub fn visit_meta_cross(m: &Meta, acc: &mut u32, flag: &mut bool) -> u32 {
+    let mut count = |e: &Expr| {
+        *acc = acc.wrapping_add(if *flag { e.n.wrapping_mul(10) } else { e.n });
+        *flag = (*acc > 12) != *flag;
+    };
+    let mut calls = 0u32;
+    m.visit_expressions(&mut |e, _| {
+        calls += 1;
+        count(e);
+    });
+    count(&Expr { n: 2 });
+    calls
+}
