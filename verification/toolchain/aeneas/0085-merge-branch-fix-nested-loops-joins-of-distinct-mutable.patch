+import NestedBorrowsAsDerefMutJoin.NestedBorrowsAsDerefMutJoin
+
+/-! Evaluate the model of `tests/src/nested-borrows-as-deref-mut-join.rs` on
+    the inputs of its `native` test module and compare with the native results
+    `(result, ctx, pos)`: `pos` is the frame given back through the `&mut`
+    (the forward output), `ctx` the value of the frame's region given back by
+    the backward function of that region when the caller gives the frame
+    back. -/
+
+namespace nested_borrows_as_deref_mut_join.checks
+open Aeneas Aeneas.Std Result
+
+def u (x : Nat) : U32 := ⟨BitVec.ofNat _ x⟩
+def us (x : Nat) : Usize := ⟨BitVec.ofNat _ x⟩
+
+def max := 4294967295
+
+def sl (xs : List Nat) (h : xs.length ≤ Usize.max := by scalar_tac) : Slice U32 :=
+  ⟨xs.map u, by simpa using h⟩
+
+def frame (ctx pos : Nat) : Frame := { steps := sl [3, 5, 7], ctx := u ctx, pos := us pos }
+
+/-- `run (&mut frame)`; the caller then sets the frame's `ctx` to `set` (if
+    any) and gives the frame back -/
+def onFrame {R S : Type} (res : R → S) (run : Frame → Result (R × Frame × (Frame → Frame)))
+    (ctx pos : Nat) (set : Option Nat := none) : Option (S × Nat × Nat) :=
+  match run (frame ctx pos) with
+  | ok (r, f1, back) =>
+    let f1' := match set with
+      | some c => { f1 with ctx := u c }
+      | none => f1
+    some (res r, (back f1').ctx.val, f1.pos.val)
+  | _ => none
+
+def pair (r : U32 × U32) : Nat × Nat := (r.1.val, r.2.val)
+def triple (r : U32 × U32 × Bool) : Nat × Nat × Bool := (r.1.val, r.2.1.val, r.2.2)
+def one (r : U32) : Nat := r.val
+
+-- advance_reread_native
+#guard onFrame pair (run_advance_reread · true (u 4)) 10 0 == some ((3, 4), 13, 1)
+#guard onFrame pair (run_advance_reread · true (u 4)) 10 1 == some ((5, 4), 15, 2)
+#guard onFrame pair (run_advance_reread · false (u 4)) 10 1 == some ((4, 5), 10, 1)
+#guard onFrame pair (run_advance_reread · true (u 4)) (max - 4) 1 == some ((5, 4), 0, 2)
+#guard onFrame pair (run_advance_reread · true (u 4)) 10 1 (set := some 99) == some ((5, 4), 99, 2)
+
+-- try_reread_native
+#guard onFrame triple (run_try_reread · (u 4)) 10 1 == some ((5, 4, true), 15, 2)
+#guard onFrame triple (run_try_reread · (u 4)) 10 3 == some ((3, 4, false), 10, 3)
+#guard (match run_try_reread_none (u 4) with | ok r => some (triple r) | _ => none) == some (4, 5, true)
+#guard onFrame triple (run_try_reread · (u 4)) 10 2 (set := some 99) == some ((7, 4, true), 99, 3)
+
+-- pos_reread_native
+#guard onFrame one (run_pos_reread · true (u 9)) 10 2 == some (2, 10, 2)
+#guard onFrame one (run_pos_reread · false (u 9)) 10 2 == some (0, 10, 2)
+
+end nested_borrows_as_deref_mut_join.checks
