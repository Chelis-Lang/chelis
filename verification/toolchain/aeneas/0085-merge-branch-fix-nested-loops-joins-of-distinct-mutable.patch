--- /dev/null
+++ b/tests/src/loop-nested-closure-levels.rs
@@ -0,0 +1,60 @@
+//@ [lean] known-failure
+//@ [!lean] skip
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! The shape of `chelis_ir::eval::resolve_load_inputs` with three levels of
+//! mutable borrows: the loop of `resolve_inputs` calls a
+//! `&'1 mut eval_with::closure<'2, run::closure<'3, '4>>`, where the closure
+//! of `eval_with` captures `&'2 mut run::closure` and the closure of `run`
+//! captures `&'3 mut u32` (and `&'4 u32`). The loop fixed point is computed:
+//! at the end of an iteration the abstraction of `'3` lends the counter to the
+//! call through the ignored loans of the two reborrows (the reborrow of
+//! `'1`, holding the one of `'2`), and the region group `'3` of the call gives
+//! back the pending loans of both; the closure type holds a trait clause
+//! whose regions are refreshed at every join. The continuation of the loop
+//! abstraction of `'3` is then staged in three stages (two levels of pending
+//! loans), which the translation does not support yet: explicit error.
+
+pub enum Demand {
+    Selected,
+    Shape,
+}
+
+fn resolve_inputs<F>(names: &Vec<u32>, strict: bool, mut load: F) -> Result<Vec<u32>, u32>
+where
+    F: FnMut(u32, Demand) -> Result<Option<u32>, u32>,
+{
+    let mut out = Vec::new();
+    for n in names.iter() {
+        let demand = if *n > 3 { Demand::Selected } else { Demand::Shape };
+        match load(*n, demand)? {
+            Some(v) => out.push(v),
+            None if strict => return Err(*n),
+            None => {}
+        }
+    }
+    Ok(out)
+}
+
+fn prepare<G>(names: &Vec<u32>, strict: bool, mut load: G) -> Result<Vec<u32>, u32>
+where
+    G: FnMut(u32, Demand) -> Result<Option<u32>, u32>,
+{
+    resolve_inputs(names, strict, &mut load)
+}
+
+fn eval_with<F>(names: &Vec<u32>, mut load: F) -> Result<Vec<u32>, u32>
+where
+    F: FnMut(u32) -> Option<u32>,
+{
+    prepare(names, true, |n, _| Ok(load(n)))
+}
+
+pub fn run(names: &Vec<u32>, k: u32) -> (Result<Vec<u32>, u32>, u32) {
+    let mut calls = 0u32;
+    let r = eval_with(names, |n| {
+        calls = calls.wrapping_add(1);
+        if n == k { None } else { Some(n.wrapping_mul(2)) }
+    });
+    (r, calls)
+}
diff --git a/tests/src/loop-nested-join.rs b/tests/src/loop-nested-join.rs
new file mode 100644
index 0000000..f610ded
--- /dev/null
+++ b/tests/src/loop-nested-join.rs
@@ -0,0 +1,81 @@
+//@ [!lean] skip
+//@ [lean] subdir=LoopNestedJoin
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Loops over a reborrowed `&'a mut Counter<'b>` whose body joins a branch
+//! calling `bump` with a branch leaving the reference untouched. The join
+//! gives a fresh reference which is expanded (a concrete borrow of a counter
+//! holding a concrete borrow of `'b`), and the loop entry joins it with the
+//! concrete reborrow of the input: two distinct outer borrows whose borrowed
+//! values hold distinct inner borrows of the nested region `'b`.
+
+pub struct Counter<'b> {
+    pub total: &'b mut u32,
+    pub calls: u32,
+}
+
+pub fn bump(c: &mut &mut Counter<'_>, v: u32) -> u32 {
+    *c.total = (*c.total).wrapping_add(v);
+    c.calls = c.calls.wrapping_add(1);
+    c.calls
+}
+
+/// The reference is given back by the call at the odd iterations only
+pub fn bump_odd(c: &mut Counter<'_>, n: u32) -> u32 {
+    let mut r = c;
+    let mut i = 0;
+    let mut acc = 0u32;
+    while i < n {
+        let d = if i % 2 == 1 { bump(&mut r, i) } else { 0 };
+        acc = acc.wrapping_add(d);
+        i += 1;
+    }
+    acc
+}
+
+/// The call is in the other branch of the join: the reference is given back
+/// by the call at the even iterations
+pub fn bump_even(c: &mut Counter<'_>, n: u32) -> u32 {
+    let mut r = c;
+    let mut i = 0;
+    let mut acc = 0u32;
+    while i < n {
+        let d = if i % 2 == 1 { 0 } else { bump(&mut r, i) };
+        acc = acc.wrapping_add(d);
+        i += 1;
+    }
+    acc
+}
+
+/// The caller writes through the inner borrow after the loop
+pub fn drive_odd(n: u32) -> (u32, u32, u32) {
+    let mut t = 7u32;
+    let mut c = Counter { total: &mut t, calls: 2 };
+    let r = bump_odd(&mut c, n);
+    *c.total = (*c.total).wrapping_add(1000);
+    let calls = c.calls;
+    (r, calls, t)
+}
+
+pub fn drive_even(n: u32) -> (u32, u32, u32) {
+    let mut t = 3u32;
+    let mut c = Counter { total: &mut t, calls: 10 };
+    let r = bump_even(&mut c, n);
+    let calls = c.calls;
+    (r, calls, t)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn drives() {
+        println!("{:?}", drive_odd(0));
+        println!("{:?}", drive_odd(1));
+        println!("{:?}", drive_odd(5));
+        println!("{:?}", drive_even(0));
+        println!("{:?}", drive_even(1));
+        println!("{:?}", drive_even(6));
+    }
+}
diff --git a/tests/src/nested-borrows-as-deref-mut-join.rs b/tests/src/nested-borrows-as-deref-mut-join.rs
new file mode 100644
index 0000000..83bcdcd
--- /dev/null
+++ b/tests/src/nested-borrows-as-deref-mut-join.rs
@@ -0,0 +1,166 @@
+//@ [!lean] skip
+//@ [lean] subdir=NestedBorrowsAsDerefMutJoin
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::option::{core::option::Option} --include core::ops::deref::{core::ops::deref::Deref} --include core::ops::deref::{core::ops::deref::DerefMut}
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! `Option::as_deref_mut` on `Option<&'1 mut Frame<'2>>` in one branch of a
+//! join, the option being read again after the join (the shape of the
+//! `UniformLike` arm of `chelis_ir::eval::eval_node_value`). The region of the
+//! frame has a backward function in three stages; in the branches, none of
+//! them was applied when the join happens (no sub-abstraction of the call
+//! ended), so the continuation of the join abstraction of that region applies
+//! them itself, in the snapshot of the join: the values given back at the
+//! nested levels of the call are those at the join. Its output is recombined
+//! with the current values of its nested loans (the frame the caller gives
+//! back) when the join abstraction ends.
+//!
+//! Using the frame again mutably after the join (e.g. `match execution {
+//! Some(f) => f.advance(), .. }`) would apply that continuation without the
+//! recombination: this is rejected with an explicit error.
+
+pub struct Frame<'a> {
+    pub steps: &'a [u32],
+    pub ctx: &'a mut u32,
+    pub pos: usize,
+}
+
+impl<'a> Frame<'a> {
+    pub fn advance(&mut self) -> u32 {
+        let s = self.steps[self.pos];
+        self.pos += 1;
+        *self.ctx = (*self.ctx).wrapping_add(s);
+        s
+    }
+
+    pub fn try_advance(&mut self) -> Result<u32, u32> {
+        if self.pos >= self.steps.len() {
+            return Err(self.pos as u32);
+        }
+        Ok(self.advance())
+    }
+}
+
+/// The frame is advanced through the reborrow in one branch; the option is
+/// tested after the join.
+pub fn advance_reread(mut execution: Option<&mut Frame<'_>>, counter: &mut u32) -> u32 {
+    let key = if let Some(frame) = execution.as_deref_mut() {
+        frame.advance()
+    } else {
+        *counter
+    };
+    if execution.is_none() {
+        *counter = counter.wrapping_add(1);
+    }
+    key
+}
+
+/// Same, with an early exit from the reborrowing branch.
+pub fn try_reread(mut execution: Option<&mut Frame<'_>>, counter: &mut u32) -> Result<u32, u32> {
+    let key = if let Some(frame) = execution.as_deref_mut() {
+        frame.try_advance()?
+    } else {
+        *counter
+    };
+    if execution.is_none() {
+        *counter = counter.wrapping_add(1);
+    }
+    Ok(key)
+}
+
+/// The frame is only read through the reborrow.
+pub fn pos_reread(mut execution: Option<&mut Frame<'_>>, d: u32) -> u32 {
+    let k = match execution.as_deref_mut() {
+        Some(f) => f.pos as u32,
+        None => d,
+    };
+    if execution.is_none() {
+        return 0;
+    }
+    k
+}
+
+pub fn run_advance_reread(f: &mut Frame<'_>, some: bool, counter: u32) -> (u32, u32) {
+    let mut c = counter;
+    let r = if some {
+        advance_reread(Some(f), &mut c)
+    } else {
+        advance_reread(None, &mut c)
+    };
+    (r, c)
+}
+
+pub fn run_try_reread(f: &mut Frame<'_>, counter: u32) -> (u32, u32, bool) {
+    let mut c = counter;
+    match try_reread(Some(f), &mut c) {
+        Ok(k) => (k, c, true),
+        Err(e) => (e, c, false),
+    }
+}
+
+pub fn run_try_reread_none(counter: u32) -> (u32, u32, bool) {
+    let mut c = counter;
+    match try_reread(None, &mut c) {
+        Ok(k) => (k, c, true),
+        Err(e) => (e, c, false),
+    }
+}
+
+pub fn run_pos_reread(f: &mut Frame<'_>, some: bool, d: u32) -> u32 {
+    if some {
+        pos_reread(Some(f), d)
+    } else {
+        pos_reread(None, d)
+    }
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    /// `(result, ctx, pos)` after running `run` on a frame over `steps`
+    fn on_frame<R>(ctx: u32, pos: usize, run: impl FnOnce(&mut Frame<'_>) -> R) -> (R, u32, usize) {
+        let steps = [3u32, 5, 7];
+        let mut c = ctx;
+        let mut f = Frame { steps: &steps, ctx: &mut c, pos };
+        let r = run(&mut f);
+        let pos = f.pos;
+        (r, c, pos)
+    }
+
+    #[test]
+    fn advance_reread_native() {
+        assert_eq!(on_frame(10, 0, |f| run_advance_reread(f, true, 4)), ((3, 4), 13, 1));
+        assert_eq!(on_frame(10, 1, |f| run_advance_reread(f, true, 4)), ((5, 4), 15, 2));
+        assert_eq!(on_frame(10, 1, |f| run_advance_reread(f, false, 4)), ((4, 5), 10, 1));
+        assert_eq!(on_frame(u32::MAX - 4, 1, |f| run_advance_reread(f, true, 4)), ((5, 4), 0, 2));
+        // The caller writes through the frame after the call
+        assert_eq!(
+            on_frame(10, 1, |f| {
+                let r = run_advance_reread(&mut *f, true, 4);
+                *f.ctx = 99;
+                r
+            }),
+            ((5, 4), 99, 2)
+        );
+    }
+
+    #[test]
+    fn try_reread_native() {
+        assert_eq!(on_frame(10, 1, |f| run_try_reread(f, 4)), ((5, 4, true), 15, 2));
+        assert_eq!(on_frame(10, 3, |f| run_try_reread(f, 4)), ((3, 4, false), 10, 3));
+        assert_eq!(run_try_reread_none(4), (4, 5, true));
+        assert_eq!(
+            on_frame(10, 2, |f| {
+                let r = run_try_reread(&mut *f, 4);
+                *f.ctx = 99;
+                r
+            }),
+            ((7, 4, true), 99, 3)
+        );
+    }
+
+    #[test]
+    fn pos_reread_native() {
+        assert_eq!(on_frame(10, 2, |f| run_pos_reread(f, true, 9)), (2, 10, 2));
+        assert_eq!(on_frame(10, 2, |f| run_pos_reread(f, false, 9)), (0, 10, 2));
+    }
+}
