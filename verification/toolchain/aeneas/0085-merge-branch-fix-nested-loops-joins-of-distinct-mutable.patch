+#guard val3 (drive_even 0#u32) == some (0, 10, 3)
+#guard val3 (drive_even 1#u32) == some (11, 11, 3)
+#guard val3 (drive_even 6#u32) == some (36, 13, 9)
+
+end loop_nested_join.checks
