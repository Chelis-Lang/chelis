+namespace loop_nested_join.checks
+open Aeneas Aeneas.Std Result
+
+def val3 (r : Result (U32 × U32 × U32)) : Option (Nat × Nat × Nat) :=
+  match r with
+  | ok (a, b, c) => some (a.val, b.val, c.val)
+  | _ => none
