+(** Check that the backward functions of the methods of a trait implementation
+    are those of their trait methods, in the same order (see
+    {!RegionsHierarchy.check_trait_impl_method_region_groups}), for the methods
+    whose translation the record of the implementation stores as it is (see
+    {!ModelStateABI.record_stores_translated_method}). *)
+let check_trait_impl_region_groups (ctx : Contexts.decls_ctx)
+    (trait_impl : A.trait_impl) : unit =
+  let span = trait_impl.item_meta.span in
+  let fmt_env = Print.Contexts.decls_ctx_to_fmt_env ctx in
+  let trait_decl =
+    [%silent_unwrap] span
+      (T.TraitDeclId.Map.find_opt trait_impl.impl_trait.id ctx.crate.trait_decls)
+  in
+  let lookup_fun_decl (id : A.FunDeclId.id) : A.fun_decl =
+    match A.FunDeclId.Map.find_opt id ctx.crate.fun_decls with
+    | Some d -> d
+    | None ->
+        [%craise] span
+          ("Missing the declaration of a method of the trait implementation "
+          ^ Print.name_to_string fmt_env trait_impl.item_meta.name
+          ^ ": cannot check that its backward functions are those of the \
+             trait method")
+  in
+  let groups (d : A.fun_decl) =
+    RegionsHierarchy.compute_regions_hierarchy_for_sig (Some d.item_meta.span)
+      ctx.crate
+      (LlbcAstUtils.bound_fun_sig_of_decl d)
+  in
+  let back (d : A.fun_decl) =
+    (* Whether a region group leads to a backward function does not depend on
+       the effects of the function: the functions which are not translated
+       (e.g., the methods of the models' traits) have no effect information,
+       give them some *)
+    let fun_infos = ctx.fun_ctx.fun_infos in
+    let fun_infos =
+      if A.FunDeclId.Map.mem d.def_id fun_infos then fun_infos
+      else
+        A.FunDeclId.Map.add d.def_id
+          {
+            FunsAnalysis.can_fail = true;
+            stateful = false;
+            can_diverge = false;
+            is_rec = false;
+          }
+          fun_infos
+    in
+    let ctx = { ctx with fun_ctx = { ctx.fun_ctx with fun_infos } } in
+    let dsg = translate_fun_sig_from_decl_to_decomposed ctx d in
+    fun gid -> not (T.RegionGroupId.Map.find gid dsg.fun_ty.back_sg).filter
+  in
+  let check_method ((name, m) : string * T.fun_decl_ref T.binder) =
+    if
+      ModelStateABI.record_stores_translated_method ctx.crate trait_impl name
+        m.binder_value.id
+    then begin
+      let impl_decl = lookup_fun_decl m.binder_value.id in
+      let trait_method =
+        match
+          List.find_opt
+            (fun (tm : A.trait_method T.binder) -> tm.binder_value.name = name)
+            trait_decl.methods
+        with
+        | Some tm -> tm.binder_value
+        | None ->
+            [%craise] span
+              ("The trait of the trait implementation "
+              ^ Print.name_to_string fmt_env trait_impl.item_meta.name
+              ^ " has no method " ^ name)
+      in
+      let trait_fun_decl = lookup_fun_decl trait_method.item.id in
+      let impl_span = impl_decl.item_meta.span in
+      let impl_name = Print.name_to_string fmt_env impl_decl.item_meta.name in
+      let region_map =
+        match
+          RegionsHierarchy.trait_method_region_map trait_fun_decl.signature
+            impl_decl.signature
+        with
+        | Ok region_map -> region_map
+        | Error msg -> [%craise] impl_span (msg ^ ": " ^ impl_name)
+      in
+      let impl_region_name (rid : T.RegionId.id) =
+        let r = T.RegionId.nth impl_decl.generics.regions rid in
+        match r.name with
+        | Some n -> n
+        | None -> "'_" ^ T.RegionId.to_string rid
+      in
+      RegionsHierarchy.check_trait_impl_method_region_groups impl_span impl_name
+        ~trait_groups:(groups trait_fun_decl) ~impl_groups:(groups impl_decl)
+        ~region_map ~trait_back:(back trait_fun_decl)
+        ~impl_back:(back impl_decl) ~impl_region_name
+    end
+  in
+  List.iter check_method trait_impl.methods
+
 let translate_trait_impl (ctx : Contexts.decls_ctx) (trait_impl : A.trait_impl)
     : trait_impl =
