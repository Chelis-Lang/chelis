+//@ [!lean] skip
+//@ [lean] subdir=TraitImplRegionOrder
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! The record of a trait stores an implementation of a method as the trait
+//! method: the backward functions of the implementation must be those of the
+//! trait method, in the same order. The region groups of a signature, which
+//! determine the backward functions and their order, are ordered by the
+//! outlives relations of its regions, taken in their order, and the
+//! implementation orders its regions independently of the trait method. When
+//! the given back values have the same type, another order still type-checks
+//! and silently swaps them:
+//! - `shared_step`: the closure captures `step` by shared reference. The trait
+//!   method `FnMut<(&'a mut u32,)>::call_mut` gives back the argument, then the
+//!   closure's state; in the implementation, the region of the captured
+//!   reference outlives the borrow of the state and puts the state first.
+//! - `use_two`: the implementation instantiates the regions of the trait in the
+//!   other order.
+//! The region parameters of the implementations are laid out so that their
+//! backward functions follow the trait method's order.
+//! `TraitImplRegionOrder/Checks.lean` evaluates the model on the inputs of the
+//! `native` test module below and compares with the native results.
+
+pub fn bump_twice(x: &mut u32, mut f: impl FnMut(&mut u32) -> u32) -> u32 {
+    let a = f(x);
+    let b = f(x);
+    a.wrapping_add(b)
+}
+
+pub fn shared_step(x: &mut u32, step: u32) -> u32 {
+    bump_twice(x, |x| {
+        *x = x.wrapping_add(step);
+        *x
+    })
+}
+
+pub fn once(x: &mut u32, f: impl FnOnce(&mut u32) -> u32) -> u32 {
+    f(x)
+}
+
+/// The implementation of `FnOnce::call_once` calls the implementation of
+/// `FnMut::call_mut` directly.
+pub fn shared_once(x: &mut u32, step: u32) -> u32 {
+    once(x, |x| {
+        *x = x.wrapping_add(step);
+        x.wrapping_mul(2)
+    })
+}
+
+pub trait Two<'a, 'b> {
+    fn two(&mut self, x: &'a mut u32, y: &'b mut u32) -> u32;
+}
+
+pub struct S {
+    pub k: u32,
+}
+
+impl<'a, 'b> Two<'b, 'a> for S {
+    fn two(&mut self, x: &'b mut u32, y: &'a mut u32) -> u32 {
+        *x = x.wrapping_add(1);
+        *y = y.wrapping_add(self.k);
+        self.k = self.k.wrapping_add(100);
+        *x
+    }
+}
+
+pub fn call_two<'a, 'b, T: Two<'a, 'b>>(t: &mut T, x: &'a mut u32, y: &'b mut u32) -> u32 {
+    t.two(x, y)
+}
+
+/// Through the trait.
+pub fn use_two(a: u32, b: u32) -> (u32, u32, u32) {
+    let mut s = S { k: 7 };
+    let mut a = a;
+    let mut b = b;
+    let r = call_two(&mut s, &mut a, &mut b);
+    (r, a, b)
+}
+
+/// A direct call of the implementation.
+pub fn direct_two(a: u32, b: u32) -> (u32, u32, u32, u32) {
+    let mut s = S { k: 7 };
+    let mut a = a;
+    let mut b = b;
+    let r = s.two(&mut a, &mut b);
+    (r, a, b, s.k)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn shared_step_native() {
+        for (x, step, r, x_after) in [(1u32, 5u32, 17u32, 11u32), (0, 0, 0, 0), (10, 1, 23, 12)] {
+            let mut x = x;
+            assert_eq!(shared_step(&mut x, step), r);
+            assert_eq!(x, x_after);
+        }
+    }
+
+    #[test]
+    fn shared_once_native() {
+        let mut x = 1u32;
+        assert_eq!(shared_once(&mut x, 5), 12);
+        assert_eq!(x, 6);
+    }
+
+    #[test]
+    fn use_two_native() {
+        assert_eq!(use_two(1, 5), (2, 2, 12));
+        assert_eq!(use_two(0, 0), (1, 1, 7));
+    }
+
+    #[test]
+    fn direct_two_native() {
+        assert_eq!(direct_two(1, 5), (2, 2, 12, 107));
+    }
+}
