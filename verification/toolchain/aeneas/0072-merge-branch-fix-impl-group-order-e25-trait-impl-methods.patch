diff --git a/src/llbc/RegionsHierarchy.ml b/src/llbc/RegionsHierarchy.ml
index 72cf8e3..5ddc874 100644
--- a/src/llbc/RegionsHierarchy.ml
+++ b/src/llbc/RegionsHierarchy.ml
@@ -285,3 +285,149 @@ let compute_regions_hierarchy_for_sig (span : Meta.span option) (crate : crate)
       (* Put together *)
       Some { id; regions; parents })
     (SccId.Map.bindings sccs.sccs)
+
+(** {1 Trait-implementation methods}
+
+    A trait-implementation method is used as the method of its trait: the
+    trait's record stores it in the field of the trait method, and the calls
+    through the trait use the signature of the trait method. The region groups
+    of a function determine its backward functions and the order in which its
+    forward function returns them, so the region groups of an implementation
+    must lead to the backward functions of the trait method, in the same order.
+    The regions of the implementation are ordered independently of those of the
+    trait method: when two backward functions give back values of the same type,
+    a different order still type-checks. *)
+
+(** Map the free regions of a trait method's signature to the regions which
+    instantiate them in the signature of an implementation of this method, by
+    walking the two signatures together. The implementation instantiates the
+    type variables of the trait signature (e.g., [Self]): the regions they
+    contain have no counterpart in the trait signature. Returns an error if the
+    two signatures differ in structure, or if the implementation instantiates a
+    region of the trait signature by two different regions. *)
+let trait_method_region_map (trait_sg : fun_sig) (impl_sg : fun_sig) :
+    (region RegionId.Map.t, string) result =
+  let exception Mismatch of string in
+  let map = ref RegionId.Map.empty in
+  let mismatch () =
+    raise
+      (Mismatch
+         "The signature of the trait-impl method is not an instance of the \
+          signature of its trait method")
+  in
+  let pair (rt : region) (ri : region) =
+    match rt with
+    | RVar (Free rid) -> (
+        match RegionId.Map.find_opt rid !map with
+        | None -> map := RegionId.Map.add rid ri !map
+        | Some ri' ->
+            if ri' <> ri then
+              raise
+                (Mismatch
+                   "The trait-impl method instantiates a region of its trait \
+                    method by two different regions"))
+    | _ -> ()
+  in
+  let iter2 f l0 l1 =
+    if List.length l0 = List.length l1 then List.iter2 f l0 l1 else mismatch ()
+  in
+  let rec walk (tt : ty) (ti : ty) =
+    match (tt, ti) with
+    | (TVar _ | TTraitType _), _ -> ()
+    | TRef (rt, tt, kt), TRef (ri, ti, ki) ->
+        if kt <> ki then mismatch ();
+        pair rt ri;
+        walk tt ti
+    | TRawPtr (tt, kt), TRawPtr (ti, ki) ->
+        if kt <> ki then mismatch ();
+        walk tt ti
+    | TAdt at, TAdt ai ->
+        if at.id <> ai.id then mismatch ();
+        iter2 pair at.generics.regions ai.generics.regions;
+        iter2 walk at.generics.types ai.generics.types
+    | TArray (tt, _), TArray (ti, _) | TSlice tt, TSlice ti -> walk tt ti
+    | TLiteral lt, TLiteral li -> if lt <> li then mismatch ()
+    | TNever, TNever -> ()
+    | TFnPtr bt, TFnPtr bi ->
+        let st = bt.binder_value and si = bi.binder_value in
+        iter2 walk (st.output :: st.inputs) (si.output :: si.inputs)
+    | TFnDef _, TFnDef _ | TDynTrait _, TDynTrait _ -> ()
+    | _ -> mismatch ()
+  in
+  try
+    iter2 walk
+      (trait_sg.output :: trait_sg.inputs)
+      (impl_sg.output :: impl_sg.inputs);
+    Ok !map
+  with Mismatch msg -> Error msg
+
+(** Check that the backward functions of a trait-impl method are those of its
+    trait method, in the same order.
+
+    - [trait_groups], [impl_groups]: the region groups of the two signatures
+    - [region_map]: the regions of the trait method's signature and the regions
+      of the implementation's signature which instantiate them (see
+      {!trait_method_region_map})
+    - [trait_back], [impl_back]: whether a region group leads to a backward
+      function
+    - [impl_region_name]: the name of a region of the implementation, for the
+      error messages *)
+let check_trait_impl_method_region_groups (span : Meta.span) (name : string)
+    ~(trait_groups : region_var_groups) ~(impl_groups : region_var_groups)
+    ~(region_map : region RegionId.Map.t)
+    ~(trait_back : RegionGroupId.id -> bool)
+    ~(impl_back : RegionGroupId.id -> bool)
+    ~(impl_region_name : RegionId.id -> string) : unit =
+  let impl_group_of_region =
+    RegionId.Map.of_list
+      (List.concat_map
+         (fun (g : region_var_group) -> List.map (fun r -> (r, g.id)) g.regions)
+         impl_groups)
+  in
+  let group_to_string (gid : RegionGroupId.id) =
+    let g = RegionGroupId.nth impl_groups gid in
+    "{" ^ String.concat ", " (List.map impl_region_name g.regions) ^ "}"
+  in
+  let layout_to_string (l : RegionGroupId.id list) =
+    "[" ^ String.concat "; " (List.map group_to_string l) ^ "]"
+  in
+  (* The group of the implementation corresponding to every region group of the
+     trait method which leads to a backward function *)
+  let expected =
+    List.filter_map
+      (fun (g : region_var_group) ->
+        if not (trait_back g.id) then None
+        else
+          let images =
+            List.filter_map
+              (fun rid ->
+                match RegionId.Map.find_opt rid region_map with
+                | None -> (* Not in the signature *) None
+                | Some (RVar (Free rid)) ->
+                    Some (RegionId.Map.find_opt rid impl_group_of_region)
+                | Some _ -> Some None)
+              g.regions
+          in
+          match List.sort_uniq compare images with
+          | [ Some gid ] -> Some gid
+          | _ ->
+              [%craise] span
+                ("A backward function of the trait method of " ^ name
+               ^ " does not correspond to a single region group of the \
+                  implementation (implementation region groups: "
+                ^ layout_to_string
+                    (List.map (fun (g : region_var_group) -> g.id) impl_groups)
+                ^ ")"))
+      trait_groups
+  in
+  let actual =
+    List.filter_map
+      (fun (g : region_var_group) -> if impl_back g.id then Some g.id else None)
+      impl_groups
+  in
+  [%cassert] span (expected = actual)
+    ("The backward functions of the trait-impl method " ^ name
+   ^ " are not those of its trait method in the same order: the trait method \
+      gives back the region groups " ^ layout_to_string expected
+   ^ " in this order, the implementation gives back "
+    ^ layout_to_string actual)
diff --git a/src/symbolic/ModelStateABI.ml b/src/symbolic/ModelStateABI.ml
index 41e3543..00d6040 100644
--- a/src/symbolic/ModelStateABI.ml
+++ b/src/symbolic/ModelStateABI.ml
@@ -99,6 +99,49 @@ let crate_for_trait crate id method_name =
 let for_trait (ctx : Contexts.decls_ctx) id method_name =
   crate_for_trait ctx.crate id method_name
 
+(** How the record of a trait receives an implementation of one of its methods:
+    [Some contract] when the record stores the implementation adapted to the
+    canonical state ABI of the trait's model (see {!adapt_dictionary_method}),
+    [None] when it stores the implementation as it is. *)
+let dictionary_method_contract (crate : A.crate) id method_name
+    ~(method_is_builtin : bool) =
+  if Config.backend () = Config.Lean && not method_is_builtin then
+    match crate_for_trait crate id method_name with
+    | Some ((State _ | IntoIterator) as contract) -> Some contract
+    | _ -> None
+  else None
+
+(** Whether the record of the trait implementation [impl] stores the
+    translation of its implementation [method_id] of the trait method [name] as
+    it is, so that the calls through the trait use the backward functions of the
+    implementation's signature. It does not when the implementation is modeled
+    (its record is part of the model), when the method is not a field of the
+    record of the trait's model, when the method is modeled (the record stores
+    the model's function, whose signature is the model's), or when the record
+    stores the method adapted to the canonical state ABI of the trait's model
+    (see {!adapt_dictionary_method}). *)
+let record_stores_translated_method (crate : A.crate) (impl : A.trait_impl)
+    (name : string) (method_id : A.FunDeclId.id) : bool =
+  let mctx = NameMatcher.ctx_from_crate crate in
+  let trait_decl = T.TraitDeclId.Map.find impl.impl_trait.id crate.trait_decls in
+  let method_is_builtin =
+    match A.FunDeclId.Map.find_opt method_id crate.fun_decls with
+    | Some decl ->
+        ExtractBuiltin.find_fun_info mctx decl.def_id decl.item_meta.name
+        <> None
+    | None -> false
+  in
+  ExtractBuiltin.find_trait_impl_info mctx trait_decl.item_meta.name
+    impl.impl_trait.generics
+  = None
+  && ExtractBuiltin.trait_method_is_field
+       (ExtractBuiltin.find_trait_decl_info mctx trait_decl.item_meta.name)
+       name
+  && (not method_is_builtin)
+  && dictionary_method_contract crate trait_decl.def_id name
+       ~method_is_builtin:false
+     = None
+
 (** A field is true if any retained marker implementation's conjunction of
     dictionary conditions holds. Empty conjunctions are unconditional evidence.
 *)
