+import TraitImplRegionOrder.TraitImplRegionOrder
+
+/-! Evaluate the model of `tests/src/trait-impl-region-order.rs` on the inputs of
+    its `native` test module and compare with the native results. -/
+
+namespace trait_impl_region_order.checks
+open Aeneas Aeneas.Std Result
+
+def u (x : Nat) : U32 := ⟨BitVec.ofNat _ x⟩
+
+def val {α} (f : α → β) : Result α → Option β
+  | ok x => some (f x)
+  | _ => none
+
+def pair : Result (U32 × U32) → Option (Nat × Nat) :=
+  val fun (r, x) => (r.val, x.val)
+
+def triple : Result (U32 × U32 × U32) → Option (Nat × Nat × Nat) :=
+  val fun (r, a, b) => (r.val, a.val, b.val)
+
+def quad : Result (U32 × U32 × U32 × U32) → Option (Nat × Nat × Nat × Nat) :=
+  val fun (r, a, b, k) => (r.val, a.val, b.val, k.val)
+
+-- `FnMut` capturing by shared reference: the argument is given back, then the
+-- state (which has the type of the argument)
+#guard pair (shared_step (u 1) (u 5)) == some (17, 11)
+#guard pair (shared_step (u 0) (u 0)) == some (0, 0)
+#guard pair (shared_step (u 10) (u 1)) == some (23, 12)
+
+-- `FnOnce` capturing by shared reference
+#guard pair (shared_once (u 1) (u 5)) == some (12, 6)
+
+-- The implementation instantiates the regions of the trait in the other order
+#guard triple (use_two (u 1) (u 5)) == some (2, 2, 12)
+#guard triple (use_two (u 0) (u 0)) == some (1, 1, 7)
+
+-- A direct call of the implementation
+#guard quad (direct_two (u 1) (u 5)) == some (2, 2, 12, 107)
+
+end trait_impl_region_order.checks
