+(** Lay out the region parameters of every trait-impl method so that its region
+    groups are those of its trait method, in the same order.
+
+    The region groups of a signature are ordered by a depth-first search over
+    the outlives graph of its region parameters, taken in their order (see
+    {!RegionsHierarchy.compute_regions_hierarchy_for_sig}). The forward function
+    returns the backward functions in the order of the region groups, and the
+    record of the trait stores an implementation in the field of the trait
+    method, so that the calls through the trait use the order of the trait
+    method. An implementation may order the regions differently:
+    - its regions may instantiate those of the trait in another order, e.g. in
+      [impl<'a, 'b> Two<'b, 'a> for S];
+    - its instantiation of the type variables of the trait may contain regions
+      which outlive the regions of the method, and the search puts the region
+      groups they outlive first. For instance, for a closure capturing a
+      variable by shared reference:
+      {[
+        fn FnMut::call_mut::<..><'_0, '_1, T0, T1, T2>
+          (_1: &'_1 mut T0, _2: (&'_0 mut T1,)) -> T2
+        fn {impl FnMut::<..> for closure<'_0>}::call_mut<'_0, '_1, '_2>
+          (state_1: &'_2 mut closure<'_0>, args_2: (&'_1 mut u32,)) -> u32
+      ]}
+      the trait method gives back the argument, then the state, while in the
+      implementation ['_0 : '_2] puts the state first.
+    When the given back values have the same type, the other order silently
+    swaps them.
+
+    For every implementation that the record of its trait implementation stores
+    as it is (see {!ModelStateABI.record_stores_translated_method}) and whose
+    regions, grouped and ordered as in its signature, differ from the regions
+    which instantiate those of the trait method, grouped and ordered as in the
+    trait method, we put first the regions which instantiate those of the trait
+    method, in the order of the trait method's regions, then the other regions.
+    Every other function is left unchanged. [SymbolicToPure] then checks that
+    the backward functions of those implementations are those of their trait
+    method (see {!RegionsHierarchy.check_trait_impl_method_region_groups}). *)
+let order_impl_method_region_groups (crate : crate) : crate =
+  (* The trait method of an implementation stored as it is in its record *)
+  let trait_fun_decl (f : fun_decl) : fun_decl option =
+    match f.src with
+    | TraitImplItem (impl_ref, trait_ref, name, _) -> (
+        match
+          ( TraitImplId.Map.find_opt impl_ref.id crate.trait_impls,
+            TraitDeclId.Map.find_opt trait_ref.id crate.trait_decls )
+        with
+        | Some impl, Some decl
+          when ModelStateABI.record_stores_translated_method crate impl name
+                 f.def_id ->
+            Option.bind
+              (List.find_opt
+                 (fun (m : trait_method binder) -> m.binder_value.name = name)
+                 decl.methods)
+              (fun (m : trait_method binder) ->
+                FunDeclId.Map.find_opt m.binder_value.item.id crate.fun_decls)
+        | _ -> None)
+    | _ -> None
+  in
+  let orders : int list FunDeclId.Map.t =
+    FunDeclId.Map.filter_map
+      (fun _ (f : fun_decl) ->
+        match trait_fun_decl f with
+        | None -> None
+        | Some tf -> (
+            (* A mismatch of the signatures is reported by the check in
+               [SymbolicToPure] *)
+            match
+              RegionsHierarchy.trait_method_region_map tf.signature f.signature
+            with
+            | Error _ -> None
+            | Ok region_map ->
+                (* The regions of the implementation which instantiate those of
+                   the trait method, in the order of the trait method *)
+                let image (rid : RegionId.id) =
+                  match RegionId.Map.find_opt rid region_map with
+                  | Some (RVar (Free rid)) -> Some rid
+                  | _ -> None
+                in
+                let images =
+                  List.fold_left
+                    (fun images (r : region_param) ->
+                      match image r.index with
+                      | Some rid when not (List.mem rid images) ->
+                          images @ [ rid ]
+                      | _ -> images)
+                    [] tf.generics.regions
+                in
+                let groups (d : fun_decl) =
+                  RegionsHierarchy.compute_regions_hierarchy_for_sig
+                    (Some d.item_meta.span) crate
+                    (LlbcAstUtils.bound_fun_sig_of_decl d)
+                in
+                let layout (d : fun_decl) to_impl =
+                  List.filter_map
+                    (fun (g : region_var_group) ->
+                      match
+                        List.sort_uniq RegionId.compare_id
+                          (List.filter_map to_impl g.regions)
+                      with
+                      | [] -> None
+                      | l -> Some l)
+                    (groups d)
+                in
+                let in_images rid =
+                  if List.mem rid images then Some rid else None
+                in
+                if layout tf image = layout f in_images then None
+                else
+                  let others =
+                    List.filter
+                      (fun (r : region_param) -> not (List.mem r.index images))
+                      f.generics.regions
+                  in
+                  Some
+                    (List.map RegionId.to_int images
+                    @ List.map
+                        (fun (r : region_param) -> RegionId.to_int r.index)
+                        others)))
+      crate.fun_decls
+  in
+  reorder_fun_region_params crate orders
 
