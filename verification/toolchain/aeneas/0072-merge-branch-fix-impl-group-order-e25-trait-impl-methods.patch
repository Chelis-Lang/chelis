+(** Reorder the region parameters of the functions of [orders] (for every
+    function, the positions of its region parameters in their new order), and
+    the region arguments of every reference to them. *)
+let reorder_fun_region_params (crate : crate) (orders : int list FunDeclId.Map.t)
+    : crate =
+  if FunDeclId.Map.is_empty orders then crate
+  else
+    let reorder (order : int list) l = List.map (List.nth l) order in
+    let reorder_args (fid : FunDeclId.id) (generics : generic_args) =
+      match FunDeclId.Map.find_opt fid orders with
+      | None -> generics
+      | Some order -> { generics with regions = reorder order generics.regions }
+    in
+    (* Reorder the region parameters of a function, and rename accordingly its
+       free region variables, which are those parameters. Its name keeps its own
+       specialization binder. *)
+    let reorder_params (f : fun_decl) (order : int list) : fun_decl =
+      let params = reorder order f.generics.regions in
+      let renaming =
+        RegionId.Map.of_list
+          (List.mapi
+             (fun i (r : region_param) -> (r.index, RegionId.of_int i))
+             params)
+      in
+      let rename =
+        object
+          inherit [_] map_crate as super
+
+          method! visit_region env r =
+            match r with
+            | RVar (Free id) -> RVar (Free (RegionId.Map.find id renaming))
+            | _ -> super#visit_region env r
+        end
+      in
+      let f = rename#visit_fun_decl () f in
+      let regions =
+        List.mapi
+          (fun i (r : region_param) -> { r with index = RegionId.of_int i })
+          params
+      in
+      { f with generics = { f.generics with regions } }
+    in
+    let fun_decls =
+      FunDeclId.Map.map
+        (fun (f : fun_decl) ->
+          match FunDeclId.Map.find_opt f.def_id orders with
+          | None -> f
+          | Some order ->
+              let f = reorder_params f order in
+              [%ltrace
+                let env = Print.crate_to_fmt_env crate in
+                "Reordered the region parameters of: "
+                ^ Print.fun_decl_to_string env "" " " f];
+              f)
+        crate.fun_decls
+    in
+    let visitor =
+      object
+        inherit [_] map_crate as super
+
+        method! visit_fun_decl_ref env fref =
+          let fref = super#visit_fun_decl_ref env fref in
+          { fref with generics = reorder_args fref.id fref.generics }
+
+        method! visit_fn_ptr env ptr =
+          let ptr = super#visit_fn_ptr env ptr in
+          match ptr.kind with
+          | FunId (FRegular fid) ->
+              { ptr with generics = reorder_args fid ptr.generics }
+          | FunId (FBuiltin _) | TraitMethod _ -> ptr
+      end
+    in
+    visitor#visit_crate () { crate with fun_decls }
