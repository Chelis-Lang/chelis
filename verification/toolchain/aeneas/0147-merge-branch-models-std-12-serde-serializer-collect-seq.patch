+++ b/tests/lean/SerdeCollections/Checks.lean
@@ -0,0 +1,637 @@
+import SerdeCollections.SerdeCollections
+
+/-! Run the extracted implementations of `tests/src/serde-collections` (`Record`, `Holes`,
+    `Numbers`, `de_i8` ... `de_unit`, `de_point`, `de_ids` ... `de_shared`), and through them
+    serde's `Serialize` impls of the collections and the primitives, the provided
+    `Serializer::collect_seq`/`collect_map` and the `Deserialize` impls of the primitives and the
+    collections (`Aeneas/Std/Serde/Impls.lean`, `Ser.lean`), against the in-test formats of its
+    `native` test module (`ValueSer` and its compound states, `ValueDe`/`SeqDe`/`MapDe`), encoded as
+    `FormatProgram`s, and compare with the native results. -/
+
+namespace serde_collections.checks
+open Aeneas Aeneas.Std Result
+
+/-- `native::Value`; a float is `num "f64" bits` (`v.to_bits() as i128`). -/
+inductive TValue where
+  | unit
+  | bool (b : Bool)
+  | num (kind : String) (v : Int)
+  | str (s : String)
+  | none
+  | some (v : TValue)
+  | seq (len : Option Nat) (xs : List TValue)
+  | tuple (len : Nat) (xs : List TValue)
+  | map (len : Option Nat) (kvs : List (TValue × TValue))
+  | struct_ (typeName : String) (fields : List (String × TValue))
+deriving Repr, BEq, Inhabited
+
+/-! ## `native::TestError(String)` -/
+
+/-- `impl Display for TestError`: `f.write_str(&self.0)`. -/
+def errDisplay : core.fmt.Display String := ⟨fun s f => f.append s⟩
+
+/-- `#[derive(Debug)]`: `TestError("..")`. -/
+def errDebug : core.fmt.Debug String :=
+  ⟨fun s f => f.debugTuple "TestError" [⟨String, core.fmt.DebugString, s⟩]⟩
+
+/-- `ToString::to_string` (a `Display` returning an error panics). -/
+def toString' {T : Type} (d : core.fmt.Display T) (x : T) : Result String := do
+  let (status, f) ← d.fmt x {}
+  match status with
+  | .Ok () => ok f.output
+  | .Err _ => fail .panic
+
+/-- `impl ser::Error for TestError` / `impl de::Error for TestError`:
+    `TestError(msg.to_string())`. -/
+def serErr : serde_core.ser.Error String :=
+  { coreerrorErrorInst := ⟨errDebug, errDisplay⟩, custom := fun d msg => toString' d msg }
+
+def deErr : serde_core.de.Error String :=
+  { coreerrorErrorInst := ⟨errDebug, errDisplay⟩, custom := fun d msg => toString' d msg }
+
+/-- `fn fail(msg)`: `Err(TestError(msg.to_string()))`. -/
+def failWith {T : Type} (msg : String) : Result (core.result.Result T String) := ok (.Err msg)
+
+/-! ## `ValueSer` and its compound states, as a format program -/
+
+open serde_core.ser in
+/-- `SeqState(Option<usize>, Vec<Value>)`, `TupleState(usize, Vec<Value>)`,
+    `MapState { len, entries, key }`, `StructState { name, fields }`; the `Impossible` states of the
+    tuple-struct/variant and struct-variant serializers are empty. -/
+@[reducible] def serTypes : FormatTypes Unit where
+  S := fun _ => Unit
+  Ok := fun _ => TValue
+  Error := fun _ => String
+  SerializeSeq := fun _ => Option Nat × List TValue
+  SerializeTuple := fun _ => Nat × List TValue
+  SerializeTupleStruct := fun _ => Empty
+  SerializeTupleVariant := fun _ => Empty
+  SerializeMap := fun _ => Option Nat × List (TValue × TValue) × Option TValue
+  SerializeStruct := fun _ => String × List (String × TValue)
+  SerializeStructVariant := fun _ => Empty
+
+open serde_core.ser in
+def serStep (X : Type → Type 1) (sub : serTypes.Dicts X) : serTypes.Dicts (SerializeStep X) :=
+  fun _ =>
+  { serde_coreserErrorInst := serErr
+    SerializeSeqInst :=
+      { serde_coreserErrorInst := serErr
+        -- `match v.serialize(ValueSer)? { None => fail("none"), x => { self.1.push(x); Ok(()) } }`
+        serialize_element := fun d st v =>
+          d.serialize (sub ()) v () >>= fun r =>
+          match r with
+          | .Ok .none => ok (.Err "none", st)
+          | .Ok x => ok (.Ok (), (st.1, st.2 ++ [x]))
+          | .Err e => ok (.Err e, st)
+        «end» := fun st => ok (.Ok (.seq st.1 st.2)) }
+    SerializeTupleInst :=
+      { serde_coreserErrorInst := serErr
+        serialize_element := fun d st v =>
+          d.serialize (sub ()) v () >>= fun r =>
+          match r with
+          | .Ok x => ok (.Ok (), (st.1, st.2 ++ [x]))
+          | .Err e => ok (.Err e, st)
+        «end» := fun st => ok (.Ok (.tuple st.1 st.2)) }
+    SerializeTupleStructInst := { serde_coreserErrorInst := serErr,
+                                  serialize_field := fun _ st _ => (nomatch st),
+                                  «end» := fun st => nomatch st }
+    SerializeTupleVariantInst := { serde_coreserErrorInst := serErr,
+                                   serialize_field := fun _ st _ => (nomatch st),
+                                   «end» := fun st => nomatch st }
+    SerializeMapInst :=
+      { serde_coreserErrorInst := serErr
+        -- `self.key = Some(key.serialize(ValueSer)?)`
+        serialize_key := fun d st key =>
+          d.serialize (sub ()) key () >>= fun r =>
+          match r with
+          | .Ok x => ok (.Ok (), (st.1, st.2.1, .some x))
+          | .Err e => ok (.Err e, st)
+        -- `match self.key.take() { Some(key) => { let v = v.serialize(ValueSer)?;
+        --   self.entries.push((key, v)); Ok(()) } None => fail("value without key") }`
+        serialize_value := fun d st v =>
+          match st.2.2 with
+          | .none => ok (.Err "value without key", st)
+          | .some key =>
+            d.serialize (sub ()) v () >>= fun r =>
+            match r with
+            | .Ok x => ok (.Ok (), (st.1, st.2.1 ++ [(key, x)], .none))
+            | .Err e => ok (.Err e, (st.1, st.2.1, .none))
+        «end» := fun st => ok (.Ok (.map st.1 st.2.1)) }
+    SerializeStructInst :=
+      { serde_coreserErrorInst := serErr
+        serialize_field := fun d st key v =>
+          d.serialize (sub ()) v () >>= fun r =>
+          match r with
+          | .Ok x => Str.toString key >>= fun k => ok (.Ok (), (st.1, st.2 ++ [(k, x)]))
+          | .Err e => ok (.Err e, st)
+        «end» := fun st => ok (.Ok (.struct_ st.1 st.2)) }
+    SerializeStructVariantInst := { serde_coreserErrorInst := serErr,
+                                    serialize_field := fun _ st _ _ => (nomatch st),
+                                    «end» := fun st => nomatch st }
+    serialize_bool := fun _ v => ok (.Ok (.bool v))
+    serialize_i8 := fun _ v => ok (.Ok (.num "i8" v.val))
+    serialize_i16 := fun _ v => ok (.Ok (.num "i16" v.val))
+    serialize_i32 := fun _ v => ok (.Ok (.num "i32" v.val))
+    serialize_i64 := fun _ v => ok (.Ok (.num "i64" v.val))
+    serialize_u8 := fun _ v => ok (.Ok (.num "u8" v.val))
+    serialize_u16 := fun _ _ => failWith "u16"
+    serialize_u32 := fun _ v => if v.val > 100 then failWith "big" else ok (.Ok (.num "u32" v.val))
+    serialize_u64 := fun _ v => ok (.Ok (.num "u64" v.val))
+    serialize_f32 := fun _ _ => failWith "f32"
+    serialize_f64 := fun _ v => ok (.Ok (.num "f64" v.bits.toNat))
+    serialize_char := fun _ _ => failWith "char"
+    serialize_str := fun _ s => do
+      let s ← Str.toString s
+      ok (.Ok (.str s))
+    serialize_bytes := fun _ _ => failWith "bytes"
+    serialize_none := fun _ => ok (.Ok .none)
+    -- `Ok(Some(Box::new(v.serialize(ValueSer)?)))`
+    serialize_some := fun d _ v =>
+      d.serialize (sub ()) v () >>= fun r =>
+      match r with
+      | .Ok x => ok (.Ok (.some x))
+      | .Err e => ok (.Err e)
+    serialize_unit := fun _ => ok (.Ok .unit)
+    serialize_unit_struct := fun _ _ => failWith "unit struct"
+    serialize_unit_variant := fun _ _ _ _ => failWith "unit variant"
+    serialize_newtype_struct := fun _ _ _ _ => failWith "newtype struct"
+    serialize_newtype_variant := fun _ _ _ _ _ _ => failWith "newtype variant"
+    serialize_seq := fun _ len => ok (.Ok (len.map (·.val), []))
+    serialize_tuple := fun _ len => ok (.Ok (len.val, []))
+    serialize_tuple_struct := fun _ _ _ => failWith "tuple struct"
+    serialize_tuple_variant := fun _ _ _ _ _ => failWith "tuple variant"
+    serialize_map := fun _ len => ok (.Ok (len.map (·.val), [], .none))
+    serialize_struct := fun _ typeName _ => do
+      let n ← Str.toString typeName
+      ok (.Ok (n, []))
+    serialize_struct_variant := fun _ _ _ _ _ => failWith "struct variant" }
+
+open serde_core.ser in
+def serFormat : FormatProgram serTypes where
+  base := fun _ => bottom (SerializeAt 0)
+  step := serStep
+
+/-- `ValueSer` with nesting bound `n`. -/
+def valueSer (n : Nat) := serFormat.encode n ()
+
+/-! ## `ValueDe`, `SeqDe` and `MapDe`, as a format program -/
+
+open serde_core.de in
+def deTypes : FormatTypes where
+  ιD := Unit
+  D := fun _ => TValue
+  DError := fun _ => String
+  ιS := Unit
+  S := fun _ => List TValue
+  SError := fun _ => String
+  ιM := Unit
+  M := fun _ => List (TValue × TValue) × Option TValue
+  MError := fun _ => String
+  ιE := Empty
+  E := fun _ => Unit
+  EError := fun _ => String
+  EVariant := fun _ => Unit
+  ιV := Empty
+  V := fun _ => Unit
+  VError := fun _ => String
+
+open serde_core.de in
+/-- `ValueDe::deserialize_any`: a number with its kind's `visit_*` (`v as i8`, ..., a float from its
+    bits), a sequence or a tuple with `visit_seq(SeqDe(..))`, a map or a struct (its field names as
+    strings) with `visit_map(MapDe { .. })`. -/
+def deserializeAny {X : Fam} (sub : deTypes.Dicts X) {V Value : Type} (vis : VisitorStep X V Value)
+    (d : TValue) (v : V) : Result (core.result.Result Value String) :=
+  match d with
+  | .unit => vis.visit_unit deErr v
+  | .bool b => vis.visit_bool deErr v b
+  | .num kind n =>
+    match kind with
+    | "i8" => vis.visit_i8 deErr v ⟨BitVec.ofInt _ n⟩
+    | "i16" => vis.visit_i16 deErr v ⟨BitVec.ofInt _ n⟩
+    | "i32" => vis.visit_i32 deErr v ⟨BitVec.ofInt _ n⟩
+    | "i64" => vis.visit_i64 deErr v ⟨BitVec.ofInt _ n⟩
+    | "u8" => vis.visit_u8 deErr v ⟨BitVec.ofInt _ n⟩
+    | "u16" => vis.visit_u16 deErr v ⟨BitVec.ofInt _ n⟩
+    | "u32" => vis.visit_u32 deErr v ⟨BitVec.ofInt _ n⟩
+    | "u64" => vis.visit_u64 deErr v ⟨BitVec.ofInt _ n⟩
+    | "f32" => vis.visit_f32 deErr v ⟨BitVec.ofInt _ n⟩
+    | "f64" => vis.visit_f64 deErr v ⟨BitVec.ofInt _ n⟩
+    | _ => failWith "kind"
+  | .str s => do
+    let s ← Str.ofString s
+    vis.visit_str deErr v s
+  | .none => vis.visit_none deErr v
+  | .some x => vis.visit_some (sub.des ()) v x
+  | .seq _ xs => vis.visit_seq (sub.seqs ()) v xs
+  | .tuple _ xs => vis.visit_seq (sub.seqs ()) v xs
+  | .map _ kvs => vis.visit_map (sub.maps ()) v (kvs, .none)
+  | .struct_ _ fields => vis.visit_map (sub.maps ()) v (fields.map fun (k, x) => (.str k, x), .none)
+
+open serde_core.de in
+def deStep (X : Fam) (sub : deTypes.Dicts X) : deTypes.Dicts (Step X) where
+  des := fun _ =>
+    let any := @deserializeAny X sub
+    { serde_coredeErrorInst := deErr
+      deserialize_any := any
+      deserialize_bool := any, deserialize_i8 := any, deserialize_i16 := any
+      deserialize_i32 := any, deserialize_i64 := any, deserialize_i128 := any
+      deserialize_u8 := any, deserialize_u16 := any, deserialize_u32 := any
+      deserialize_u64 := any, deserialize_u128 := any, deserialize_f32 := any
+      deserialize_f64 := any, deserialize_char := any, deserialize_str := any
+      deserialize_string := any, deserialize_bytes := any, deserialize_byte_buf := any
+      deserialize_option := any, deserialize_unit := any
+      deserialize_unit_struct := fun vis d _ v => any vis d v
+      deserialize_newtype_struct := fun vis d _ v => any vis d v
+      deserialize_seq := any
+      deserialize_tuple := fun vis d _ v => any vis d v
+      deserialize_tuple_struct := fun vis d _ _ v => any vis d v
+      deserialize_map := any
+      deserialize_struct := fun vis d _ _ v => any vis d v
+      deserialize_enum := fun vis d _ _ v => any vis d v
+      deserialize_identifier := any
+      deserialize_ignored_any := any }
+  seqs := fun _ =>
+    { serde_coredeErrorInst := deErr
+      next_element_seed := fun seed xs t =>
+        match xs with
+        | [] => ok (.Ok .none, [])
+        | x :: rest =>
+          seed.deserialize (sub.des ()) t x >>= fun r =>
+          match r with
+          | .Ok v => ok (.Ok (.some v), rest)
+          | .Err e => ok (.Err e, rest) }
+  maps := fun _ =>
+    { serde_coredeErrorInst := deErr
+      next_key_seed := fun seed st k =>
+        match st.1 with
+        | [] => ok (.Ok .none, st)
+        | (key, value) :: rest =>
+          seed.deserialize (sub.des ()) k key >>= fun r =>
+          match r with
+          | .Ok v => ok (.Ok (.some v), (rest, .some value))
+          | .Err e => ok (.Err e, (rest, .some value))
+      next_value_seed := fun seed st v =>
+        match st.2 with
+        | .none => ok (.Err "value missing", st)
+        | .some value => do
+          let r ← seed.deserialize (sub.des ()) v value
+          ok (r, (st.1, .none)) }
+  enums := fun i => nomatch i
+  variants := fun i => nomatch i
+
+open serde_core.de in
+def deFormat : FormatProgram deTypes where
+  base := bottom (DeAt 0) deTypes
+  step := deStep
+
+/-- `ValueDe` with nesting bound `n`. -/
+def valueDe (n : Nat) := deFormat.encode n ()
+
+/-! ## The extracted implementations against the in-test formats (the asserts of `native`) -/
+
+/-- A result of the native test helpers: `Ok`, `Err(TestError(..))`, or no result (a panic or
+    divergence of the model, or the nesting bound reached). -/
+inductive Out (α : Type) where
+  | ok (a : α)
+  | err (e : String)
+  | none
+deriving BEq, Repr
+
+def out {α : Type} : Result (core.result.Result α String) → Out α
+  | ok (.Ok a) => .ok a
+  | ok (.Err e) => .err e
+  | _ => .none
+
+def Out.map {α β : Type} (f : α → β) : Out α → Out β
+  | .ok a => .ok (f a)
+  | .err e => .err e
+  | .none => .none
+
+/-- The nesting bound of the encoded formats (the tests nest at most four data-side calls). -/
+def bound : Nat := 8
+
+/-- `fn ser<T: Serialize>(v: &T)`: `v.serialize(ValueSer)`. -/
+def ser {T : Type} (d : serde_core.ser.Serialize T) (x : T) : Out TValue :=
+  out (d.serialize (valueSer bound) x ())
+
+/-- `f(ValueDe(v))` for an extracted `f<'de, D: Deserializer<'de>>(D)`. -/
+def de {T : Type}
+    (f : serde_core.de.Deserializer TValue String → TValue → Result (core.result.Result T String))
+    (v : TValue) : Out T :=
+  out (f (valueDe bound) v)
+
+def vec {α : Type} (xs : List α) : alloc.vec.Vec α :=
+  if h : xs.length ≤ Usize.max then ⟨xs, h⟩ else ⟨[], by simp⟩
+
+def u8 (n : Nat) : U8 := ⟨BitVec.ofNat _ n⟩
+def u32 (n : Nat) : U32 := ⟨BitVec.ofNat _ n⟩
+def f64 (bits : Nat) : F64 := BinaryFloat.ofNat _ bits
+
+/-- `Num("u32", n)` for each `n`. -/
+def u32s (ns : List Nat) : List TValue := ns.map fun n => .num "u32" n
+
+/-- `f64v(v)`: `Num("f64", v.to_bits() as i128)`. -/
+def f64v (bits : Nat) : TValue := .num "f64" bits
+def f32v (bits : Nat) : TValue := .num "f32" bits
+
+/-! Float bits. -/
+def nan : Nat := 0x7ff8000000000000
