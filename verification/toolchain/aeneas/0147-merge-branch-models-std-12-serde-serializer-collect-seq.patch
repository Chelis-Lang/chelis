+        Bool(bool),
+        /// The kind (`i8`, ..., `u64`, `f64` as its bits) and the value.
+        Num(&'static str, i128),
+        Str(String),
+        None,
+        Some(Box<Value>),
+        Seq(Option<usize>, Vec<Value>),
+        Tuple(usize, Vec<Value>),
+        Map(Option<usize>, Vec<(Value, Value)>),
+        Struct(&'static str, Vec<(&'static str, Value)>),
