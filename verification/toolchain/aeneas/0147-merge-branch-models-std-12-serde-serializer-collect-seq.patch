+    fn s(x: &str) -> Value {
+        Str(x.to_string())
+    }
+
+    #[test]
+    fn deserialize_collections() {
+        let seq = |xs: Vec<Value>| ValueDe(Seq(Option::None, xs));
+        let map = |kvs: Vec<(Value, Value)>| ValueDe(Map(Option::None, kvs));
+        assert_eq!(de_ids(seq(vec![Num("u32", 3), Num("u32", 1), Num("u8", 2)])), Ok(vec![3, 1, 2]));
+        assert_eq!(de_ids(ValueDe(Tuple(0, vec![]))), Ok(vec![]));
+        assert_eq!(
+            de_ids(seq(vec![Num("u32", 1), Num("i8", -1), Num("u32", 2)])),
+            Err(err("invalid value: integer `-1`, expected u32"))
+        );
+        assert_eq!(de_ids(map(vec![])), Err(err("invalid type: map, expected a sequence")));
+        assert_eq!(de_ids(ValueDe(s("x"))), Err(err("invalid type: string \"x\", expected a sequence")));
+        // `BTreeSet`: ascending, an equal element once.
+        assert_eq!(
+            de_tags(seq(vec![Num("i64", 9), Num("i8", -4), Num("i64", 9), Num("u8", 7)])),
+            Ok(BTreeSet::from([-4, 7, 9]))
+        );
+        assert_eq!(
+            de_tags(seq(vec![Num("i64", 1), Num("u64", 18446744073709551615)])),
+            Err(err("invalid value: integer `18446744073709551615`, expected i64"))
+        );
+        assert_eq!(de_tags(ValueDe(Unit)), Err(err("invalid type: unit value, expected a sequence")));
+        // `BTreeMap`: ascending keys, a later value of an equal key replaces the earlier one.
+        assert_eq!(
+            de_names(map(vec![(s("b"), Num("u8", 2)), (s("a"), Num("u8", 1)), (s("b"), Num("u8", 5))])),
+            Ok(BTreeMap::from([("a".to_string(), 1), ("b".to_string(), 5)]))
+        );
+        assert_eq!(
+            de_names(ValueDe(Struct("S", vec![("x", Num("u64", 255))]))),
+            Ok(BTreeMap::from([("x".to_string(), 255)]))
+        );
+        assert_eq!(
+            de_names(map(vec![(s("a"), Num("u8", 1)), (s("b"), Num("u16", 256))])),
+            Err(err("invalid value: integer `256`, expected u8"))
+        );
+        assert_eq!(
+            de_names(map(vec![(Num("u8", 1), Num("u8", 1))])),
+            Err(err("invalid type: integer `1`, expected a string"))
+        );
+        assert_eq!(de_names(seq(vec![])), Err(err("invalid type: sequence, expected a map")));
+        // `Box<Option<u64>>`, `Arc<Vec<Vec<u8>>>`: the content's.
+        assert_eq!(
+            de_boxed(ValueDe(Some(Box::new(Num("u64", 18446744073709551615))))),
+            Ok(Box::new(Option::Some(u64::MAX)))
+        );
+        assert_eq!(de_boxed(ValueDe(None)), Ok(Box::new(Option::None)));
+        assert_eq!(de_boxed(ValueDe(Unit)), Ok(Box::new(Option::None)));
+        assert_eq!(de_boxed(ValueDe(Num("u64", 1))), Err(err("invalid type: integer `1`, expected option")));
+        assert_eq!(
+            de_shared(seq(vec![Seq(Option::None, vec![Num("u8", 1), Num("u8", 2)]), Tuple(0, vec![])]))
+                .map(|a| (*a).clone()),
+            Ok(vec![vec![1, 2], vec![]])
+        );
+        assert_eq!(
+            de_shared(seq(vec![Seq(Option::None, vec![Num("u16", 300)])])).map(|a| (*a).clone()),
+            Err(err("invalid value: integer `300`, expected u8"))
+        );
+        assert_eq!(
+            de_shared(seq(vec![Num("u8", 1)])).map(|a| (*a).clone()),
+            Err(err("invalid type: integer `1`, expected a sequence"))
+        );
+    }
