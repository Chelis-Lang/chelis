+/-! ### Primitives (`impl_deserialize_num!`, `bool`, `()`) -/
+
+/-- An integer from a visited value `v` given as a signed (`Signed(v as i64)`) or an unsigned
+    (`Unsigned(v as u64)`) one: the value when it is within `[lo, hi]`, else
+    `Err(Error::invalid_value(unexp, &self))`. -/
+def intWithin {Value E : Type} (errInst : serde_core.de.Error E) (name : String) (lo hi : Int)
+    (mk : Int → Value) (v : Int) (unexp : serde_core.de.Unexpected) :
+    Result (core.result.Result Value E) :=
+  if lo ≤ v ∧ v ≤ hi then .ok (.Ok (mk v)) else invalidValue errInst name unexp
+
+/-- `PrimitiveVisitor` of `impl_deserialize_num!` for the integers `i8`, `i16`, `i32`, `i64`, `u8`,
+    `u64` and `usize` (de/impls.rs): `expecting` is `stringify!(ty)`, and every `visit_i8` ...
+    `visit_i64`, `visit_u8` ... `visit_u64` is one of `num_self!` (`Ok(v)`), `num_as_self!`
+    (`Ok(v as ty)`, a widening), `int_to_int!` (`ty::try_from(v as i64)`, else
+    `invalid_value(Signed(v as i64))`), `int_to_uint!` (`0 <= v` and `ty::try_from(v as u64)`, else
+    `invalid_value(Signed(v as i64))`) or `uint_to_self!` (`ty::try_from(v as u64)`, else
+    `invalid_value(Unsigned(v as u64))`): the value when it is within the bounds of `ty` (always
+    for the first two), else the error of its sign. The other `visit_*` are the provided ones. -/
+def intVisitor {T : Type} (name : String) (lo hi : Int) (mk : Int → T) :
+    serde_core.de.Visitor Unit T :=
+  let signed := fun {E : Type} (e : serde_core.de.Error E) (v : Int) =>
+    intWithin e name lo hi mk v (.Signed ⟨BitVec.ofInt 64 v⟩)
+  let unsigned := fun {E : Type} (e : serde_core.de.Error E) (v : Nat) =>
+    intWithin e name lo hi mk v (.Unsigned ⟨BitVec.ofNat 64 v⟩)
+  { expecting := fun _ f => f.append name
+    visit_i8 := fun e _ v => signed e v.val
+    visit_i16 := fun e _ v => signed e v.val
+    visit_i32 := fun e _ v => signed e v.val
+    visit_i64 := fun e _ v => signed e v.val
+    visit_u8 := fun e _ v => unsigned e v.val
+    visit_u16 := fun e _ v => unsigned e v.val
+    visit_u32 := fun e _ v => unsigned e v.val
+    visit_u64 := fun e _ v => unsigned e v.val }
+
+def I8Visitor : serde_core.de.Visitor Unit I8 :=
+  intVisitor "i8" I8.min I8.max fun v => ⟨BitVec.ofInt _ v⟩
+def I16Visitor : serde_core.de.Visitor Unit I16 :=
+  intVisitor "i16" I16.min I16.max fun v => ⟨BitVec.ofInt _ v⟩
+def I32Visitor : serde_core.de.Visitor Unit I32 :=
+  intVisitor "i32" I32.min I32.max fun v => ⟨BitVec.ofInt _ v⟩
+def I64Visitor : serde_core.de.Visitor Unit I64 :=
+  intVisitor "i64" I64.min I64.max fun v => ⟨BitVec.ofInt _ v⟩
+def U8Visitor : serde_core.de.Visitor Unit U8 :=
+  intVisitor "u8" 0 U8.max fun v => ⟨BitVec.ofNat _ v.toNat⟩
+def U64Visitor : serde_core.de.Visitor Unit U64 :=
+  intVisitor "u64" 0 U64.max fun v => ⟨BitVec.ofNat _ v.toNat⟩
+def UsizeVisitor : serde_core.de.Visitor Unit Usize :=
+  intVisitor "usize" 0 Usize.max fun v => ⟨BitVec.ofNat _ v.toNat⟩
+
