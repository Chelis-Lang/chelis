+    #[test]
+    fn deserialize_point() {
+        let point = |v: Value| de_point(ValueDe(v)).map(|(a, b)| (a, b.to_bits()));
+        assert_eq!(
+            point(Tuple(2, vec![Num("i64", -9223372036854775808), f64v(-0.0)])),
+            Ok((i64::MIN, 0x8000000000000000))
+        );
+        assert_eq!(point(Seq(Option::None, vec![Num("u8", 7), Num("u64", 3)])), Ok((7, 0x4008000000000000)));
+        assert_eq!(
+            point(Seq(Option::None, vec![Num("u64", 18446744073709551615), f64v(1.0)])),
+            Err(err("invalid value: integer `18446744073709551615`, expected i64"))
+        );
+        assert_eq!(point(Seq(Option::None, vec![Num("i8", 1)])), Err(err("invalid length 1, expected a tuple of size 2")));
+        assert_eq!(point(Seq(Option::None, vec![])), Err(err("invalid length 0, expected a tuple of size 2")));
+        assert_eq!(
+            point(Seq(Option::None, vec![Num("i8", 1), Bool(true)])),
+            Err(err("invalid type: boolean `true`, expected f64"))
+        );
+        assert_eq!(point(Num("i8", 1)), Err(err("invalid type: integer `1`, expected a tuple of size 2")));
+    }
