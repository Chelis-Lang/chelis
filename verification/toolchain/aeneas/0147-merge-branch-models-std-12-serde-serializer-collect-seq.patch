+    #[test]
+    fn deserialize_integers() {
+        assert_eq!(de_i8(ValueDe(Num("i8", -128))), Ok(i8::MIN));
+        assert_eq!(de_i8(ValueDe(Num("u8", 127))), Ok(127));
+        assert_eq!(de_i8(ValueDe(Num("u8", 128))), Err(err("invalid value: integer `128`, expected i8")));
+        assert_eq!(de_i8(ValueDe(Num("i16", -129))), Err(err("invalid value: integer `-129`, expected i8")));
+        assert_eq!(
+            de_i8(ValueDe(Num("u64", 18446744073709551615))),
+            Err(err("invalid value: integer `18446744073709551615`, expected i8"))
+        );
+        assert_eq!(de_i16(ValueDe(Num("i8", -128))), Ok(-128));
+        assert_eq!(de_i16(ValueDe(Num("i32", 32767))), Ok(i16::MAX));
+        assert_eq!(de_i16(ValueDe(Num("i32", 32768))), Err(err("invalid value: integer `32768`, expected i16")));
+        assert_eq!(de_i32(ValueDe(Num("i64", -2147483648))), Ok(i32::MIN));
+        assert_eq!(
+            de_i32(ValueDe(Num("i64", -2147483649))),
+            Err(err("invalid value: integer `-2147483649`, expected i32"))
+        );
+        assert_eq!(
+            de_i32(ValueDe(Num("u32", 4294967295))),
+            Err(err("invalid value: integer `4294967295`, expected i32"))
+        );
+        assert_eq!(de_i64(ValueDe(Num("i64", -9223372036854775808))), Ok(i64::MIN));
+        assert_eq!(de_i64(ValueDe(Num("u64", 9223372036854775807))), Ok(i64::MAX));
+        assert_eq!(
+            de_i64(ValueDe(Num("u64", 9223372036854775808))),
+            Err(err("invalid value: integer `9223372036854775808`, expected i64"))
+        );
+        assert_eq!(de_u8(ValueDe(Num("i64", 255))), Ok(u8::MAX));
+        assert_eq!(de_u8(ValueDe(Num("i8", -1))), Err(err("invalid value: integer `-1`, expected u8")));
+        assert_eq!(de_u8(ValueDe(Num("u16", 256))), Err(err("invalid value: integer `256`, expected u8")));
+        assert_eq!(de_u64(ValueDe(Num("u64", 18446744073709551615))), Ok(u64::MAX));
+        assert_eq!(de_u64(ValueDe(Num("i8", 0))), Ok(0));
+        assert_eq!(
+            de_u64(ValueDe(Num("i64", -9223372036854775808))),
+            Err(err("invalid value: integer `-9223372036854775808`, expected u64"))
+        );
+        assert_eq!(de_usize(ValueDe(Num("u64", 18446744073709551615))), Ok(usize::MAX));
+        assert_eq!(de_usize(ValueDe(Num("u32", 7))), Ok(7));
+        assert_eq!(de_usize(ValueDe(Num("i32", -5))), Err(err("invalid value: integer `-5`, expected usize")));
+        // The provided `visit_*`: `invalid_type`.
+        assert_eq!(de_i8(ValueDe(f64v(1.5))), Err(err("invalid type: floating point `1.5`, expected i8")));
+        assert_eq!(de_u64(ValueDe(Str("7".to_string()))), Err(err("invalid type: string \"7\", expected u64")));
+        assert_eq!(de_i64(ValueDe(Bool(true))), Err(err("invalid type: boolean `true`, expected i64")));
+        assert_eq!(de_usize(ValueDe(Unit)), Err(err("invalid type: unit value, expected usize")));
+        assert_eq!(
+            de_i32(ValueDe(Some(Box::new(Num("i32", 1))))),
+            Err(err("invalid type: Option value, expected i32"))
+        );
+        assert_eq!(de_i16(ValueDe(Seq(Option::None, vec![]))), Err(err("invalid type: sequence, expected i16")));
+    }
+
+    #[test]
+    fn deserialize_floats() {
+        let bits = |r: Result<f64, TestError>| r.map(f64::to_bits);
+        assert_eq!(bits(de_f64(ValueDe(f64v(f64::NAN)))), Ok(0x7ff8000000000000));
+        assert_eq!(bits(de_f64(ValueDe(f64v(-f64::NAN)))), Ok(0xfff8000000000000));
+        assert_eq!(bits(de_f64(ValueDe(f64v(-0.0)))), Ok(0x8000000000000000));
+        assert_eq!(bits(de_f64(ValueDe(f64v(f64::NEG_INFINITY)))), Ok(0xfff0000000000000));
+        assert_eq!(bits(de_f64(ValueDe(f64v(5e-324)))), Ok(1));
+        // `v as f64`, rounded to nearest (ties to even).
+        assert_eq!(bits(de_f64(ValueDe(Num("i64", -9223372036854775808)))), Ok(0xc3e0000000000000));
+        assert_eq!(bits(de_f64(ValueDe(Num("i64", 9223372036854775807)))), Ok(0x43e0000000000000));
+        assert_eq!(bits(de_f64(ValueDe(Num("u64", 18446744073709551615)))), Ok(0x43f0000000000000));
+        assert_eq!(bits(de_f64(ValueDe(Num("i64", 9007199254740993)))), Ok(0x4340000000000000));
+        assert_eq!(bits(de_f64(ValueDe(Num("u64", 9007199254740995)))), Ok(0x4340000000000002));
+        assert_eq!(bits(de_f64(ValueDe(Num("i8", -1)))), Ok((-1.0f64).to_bits()));
+        // `(v as f64).copysign(sign)`.
+        assert_eq!(bits(de_f64(ValueDe(f32v(-0.0)))), Ok(0x8000000000000000));
+        assert_eq!(bits(de_f64(ValueDe(f32v(0.1)))), Ok((0.1f32 as f64).to_bits()));
+        assert_eq!(bits(de_f64(ValueDe(f32v(f32::NAN)))), Ok(0x7ff8000000000000));
+        assert_eq!(bits(de_f64(ValueDe(f32v(-f32::NAN)))), Ok(0xfff8000000000000));
+        assert_eq!(bits(de_f64(ValueDe(f32v(f32::NEG_INFINITY)))), Ok(0xfff0000000000000));
+        assert_eq!(bits(de_f64(ValueDe(Bool(false)))), Err(err("invalid type: boolean `false`, expected f64")));
+        assert_eq!(bits(de_f64(ValueDe(Str("1.0".to_string())))), Err(err("invalid type: string \"1.0\", expected f64")));
+    }
+
+    #[test]
+    fn deserialize_bool_unit() {
+        assert_eq!(de_bool(ValueDe(Bool(true))), Ok(true));
+        assert_eq!(de_bool(ValueDe(Bool(false))), Ok(false));
+        let float = |v: Value| de_bool(ValueDe(v));
+        let msg = |text: &str| Err(err(&format!("invalid type: floating point `{text}`, expected a boolean")));
+        assert_eq!(float(f64v(f64::NAN)), msg("NaN"));
+        assert_eq!(float(f64v(-f64::NAN)), msg("NaN"));
+        assert_eq!(float(f64v(f64::INFINITY)), msg("inf"));
+        assert_eq!(float(f64v(f64::NEG_INFINITY)), msg("-inf"));
+        assert_eq!(float(f64v(-0.0)), msg("-0.0"));
+        assert_eq!(float(f64v(0.0)), msg("0.0"));
+        assert_eq!(float(f64v(0.1)), msg("0.1"));
+        assert_eq!(float(f64v(-2.5)), msg("-2.5"));
+        assert_eq!(float(f64v(1e21)), msg("1000000000000000000000.0"));
+        assert_eq!(float(f64v(1e-7)), msg("0.0000001"));
+        assert_eq!(float(f64v(f64::MAX)), msg(&format!("{}.0", f64::MAX)));
+        assert_eq!(float(f64v(5e-324)), msg(&format!("{}", 5e-324f64)));
+        assert_eq!(float(f32v(-f32::NAN)), msg("NaN"));
+        assert_eq!(float(f32v(0.1)), msg("0.10000000149011612"));
+        assert_eq!(
+            de_bool(ValueDe(Num("i64", -9223372036854775808))),
+            Err(err("invalid type: integer `-9223372036854775808`, expected a boolean"))
+        );
+        assert_eq!(
+            de_bool(ValueDe(Num("u64", 18446744073709551615))),
+            Err(err("invalid type: integer `18446744073709551615`, expected a boolean"))
+        );
+        assert_eq!(de_unit(ValueDe(Unit)), Ok(()));
+        assert_eq!(de_unit(ValueDe(None)), Err(err("invalid type: Option value, expected unit")));
+        assert_eq!(de_unit(ValueDe(Num("u8", 255))), Err(err("invalid type: integer `255`, expected unit")));
+        assert_eq!(de_unit(ValueDe(Tuple(0, vec![]))), Err(err("invalid type: sequence, expected unit")));
+    }
