+    (dk : serde_core.de.DeserializeΩ K) (dv : serde_core.de.DeserializeΩ V)
+    (insert : C → K → V → Result C) (values : C) (access : A) :
+    Result (core.result.Result C Error) := do
+  let (r, access) ← map.next_entry dk dv access
