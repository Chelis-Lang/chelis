+//! serde's `Serialize` impls of the collections and the primitives (`Aeneas/Std/Serde/Impls.lean`)
+//! and the provided `Serializer::collect_seq`/`collect_map` (`Aeneas/Std/Serde/Ser.lean`) that the
+//! collection impls call: `Vec<T>` and `BTreeSet<T>` (`collect_seq` over the shared iterator, with
+//! its exact length hint), `BTreeMap<K, V>` (`collect_map`), `Option<T>`, `Box<T>`, `Arc<T>`, `()`,
+//! `bool`, the integers, `usize` (as a `u64`), `f64` and `str`.
+//!
+//! `Record` has the hand-written form of `#[derive(Serialize)]`: a struct of such fields. `Holes`
+//! delegates to `Vec<Option<u32>>`, which the in-test format rejects at the first `None` or the
+//! first number above 100: the first error of an element stops the iteration and is the result.
+//!
+//! `Numbers` serializes the integers and the floats at their bounds (the format records a float by
+//! its bits: NaN and its sign, the infinities, `-0.0`, the subnormals). `de_i8` ... `de_unit` and
+//! `de_point` are `Deserialize` of the primitives (`impl_deserialize_num!`, `bool`, `()`, the pair):
+//! within the target's bounds or `invalid_value` with the sign of the visited integer, the widening
+//! float conversions (rounded to nearest, `f32` with its sign kept), and the provided `visit_*`
+//! (`invalid_type`, the float written by serde's `WithDecimalPoint`).
+//!
+//! `de_ids`, `de_tags`, `de_names`, `de_boxed` and `de_shared` are `Deserialize` of the collections
+//! (`Vec<T>`, `BTreeSet<T>`: every element of a sequence in order, an equal element kept once;
+//! `BTreeMap<K, V>`: every entry of a map, a later value of an equal key replacing the earlier one;
+//! `Box<T>`, `Arc<T>`: the content's), stopped by the first error.
+//!
+//! `SerdeCollections/Checks.lean` runs these implementations against the in-test formats of the
+//! `native` test module (`ValueSer`: a value tree which records the length hints; `ValueDe`: its
+//! deserializer), encoded as `FormatProgram`s, and compares with the native results.
+
+use serde::de::{Deserialize, Deserializer};
+use serde::ser::{Serialize, SerializeStruct, Serializer};
+use std::collections::{BTreeMap, BTreeSet};
+use std::sync::Arc;
+
+pub struct Record {
+    pub ids: Vec<u32>,
+    pub names: BTreeMap<String, u32>,
+    pub tags: BTreeSet<u32>,
+    pub nested: Vec<Vec<u8>>,
+    pub maybe: Option<Box<u64>>,
+    pub shared: Arc<String>,
+    pub flag: bool,
+    pub small: i8,
+    pub mid: i16,
+    pub word: i32,
+    pub delta: i64,
+    pub count: usize,
+    pub ratio: f64,
+    pub unit: (),
+}
+
+impl Serialize for Record {
+    fn serialize<S: Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
+        let mut s = serializer.serialize_struct("Record", 15)?;
+        s.serialize_field("ids", &self.ids)?;
+        s.serialize_field("names", &self.names)?;
+        s.serialize_field("tags", &self.tags)?;
+        s.serialize_field("nested", &self.nested)?;
+        s.serialize_field("maybe", &self.maybe)?;
+        s.serialize_field("shared", &self.shared)?;
+        s.serialize_field("flag", &self.flag)?;
+        s.serialize_field("small", &self.small)?;
+        s.serialize_field("mid", &self.mid)?;
+        s.serialize_field("word", &self.word)?;
+        s.serialize_field("delta", &self.delta)?;
+        s.serialize_field("count", &self.count)?;
+        s.serialize_field("ratio", &self.ratio)?;
+        s.serialize_field("unit", &self.unit)?;
+        s.serialize_field("label", "rec")?;
+        s.end()
+    }
+}
+
+/// A record from plain vectors (the map and the set by insertion).
+pub fn record(
+    ids: Vec<u32>,
+    names: Vec<(String, u32)>,
+    tags: Vec<u32>,
+    nested: Vec<Vec<u8>>,
+    maybe: Option<u64>,
+    shared: String,
+    small: i8,
+    count: usize,
+    ratio: f64,
+) -> Record {
+    let mut map = BTreeMap::new();
+    for (name, value) in names {
+        map.insert(name, value);
+    }
+    let mut set = BTreeSet::new();
+    for tag in tags {
+        set.insert(tag);
+    }
+    Record {
+        ids,
+        names: map,
+        tags: set,
+        nested,
+        maybe: match maybe {
+            Some(v) => Some(Box::new(v)),
+            None => None,
+        },
+        shared: Arc::new(shared),
+        flag: small < 0,
+        small,
+        mid: small as i16 * -300,
+        word: small as i32 * 70000,
+        delta: small as i64 * -5_000_000_000,
+        count,
+        ratio,
+        unit: (),
+    }
+}
+
+/// A sequence with holes.
+pub struct Holes(pub Vec<Option<u32>>);
+
+impl Serialize for Holes {
+    fn serialize<S: Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
+        self.0.serialize(serializer)
+    }
+}
+
+/// The integers and the floats at their bounds.
+pub struct Numbers {
+    pub small: i8,
+    pub mid: i16,
+    pub word: i32,
+    pub wide: i64,
+    pub byte: u8,
+    pub big: u64,
+    pub size: usize,
+    pub floats: Vec<f64>,
+}
+
+impl Serialize for Numbers {
+    fn serialize<S: Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
+        let mut s = serializer.serialize_struct("Numbers", 8)?;
+        s.serialize_field("small", &self.small)?;
+        s.serialize_field("mid", &self.mid)?;
+        s.serialize_field("word", &self.word)?;
+        s.serialize_field("wide", &self.wide)?;
+        s.serialize_field("byte", &self.byte)?;
+        s.serialize_field("big", &self.big)?;
+        s.serialize_field("size", &self.size)?;
+        s.serialize_field("floats", &self.floats)?;
+        s.end()
+    }
+}
+
+pub fn de_i8<'de, D: Deserializer<'de>>(deserializer: D) -> Result<i8, D::Error> {
+    i8::deserialize(deserializer)
+}
+
+pub fn de_i16<'de, D: Deserializer<'de>>(deserializer: D) -> Result<i16, D::Error> {
+    i16::deserialize(deserializer)
+}
+
+pub fn de_i32<'de, D: Deserializer<'de>>(deserializer: D) -> Result<i32, D::Error> {
+    i32::deserialize(deserializer)
+}
+
+pub fn de_i64<'de, D: Deserializer<'de>>(deserializer: D) -> Result<i64, D::Error> {
+    i64::deserialize(deserializer)
+}
+
+pub fn de_u8<'de, D: Deserializer<'de>>(deserializer: D) -> Result<u8, D::Error> {
+    u8::deserialize(deserializer)
+}
+
+pub fn de_u64<'de, D: Deserializer<'de>>(deserializer: D) -> Result<u64, D::Error> {
+    u64::deserialize(deserializer)
+}
+
+pub fn de_usize<'de, D: Deserializer<'de>>(deserializer: D) -> Result<usize, D::Error> {
+    usize::deserialize(deserializer)
+}
+
+pub fn de_f64<'de, D: Deserializer<'de>>(deserializer: D) -> Result<f64, D::Error> {
+    f64::deserialize(deserializer)
+}
+
+pub fn de_bool<'de, D: Deserializer<'de>>(deserializer: D) -> Result<bool, D::Error> {
+    bool::deserialize(deserializer)
+}
+
+pub fn de_unit<'de, D: Deserializer<'de>>(deserializer: D) -> Result<(), D::Error> {
+    <()>::deserialize(deserializer)
+}
+
+/// The primitives as the elements of a sequence (`next_element`, as derived code does).
+pub fn de_point<'de, D: Deserializer<'de>>(deserializer: D) -> Result<(i64, f64), D::Error> {
+    <(i64, f64)>::deserialize(deserializer)
+}
+
+pub fn de_ids<'de, D: Deserializer<'de>>(deserializer: D) -> Result<Vec<u32>, D::Error> {
+    Vec::<u32>::deserialize(deserializer)
+}
+
+pub fn de_tags<'de, D: Deserializer<'de>>(deserializer: D) -> Result<BTreeSet<i64>, D::Error> {
+    BTreeSet::<i64>::deserialize(deserializer)
+}
+
+pub fn de_names<'de, D: Deserializer<'de>>(
+    deserializer: D,
+) -> Result<BTreeMap<String, u8>, D::Error> {
+    BTreeMap::<String, u8>::deserialize(deserializer)
+}
+
+pub fn de_boxed<'de, D: Deserializer<'de>>(deserializer: D) -> Result<Box<Option<u64>>, D::Error> {
+    Box::<Option<u64>>::deserialize(deserializer)
+}
+
+pub fn de_shared<'de, D: Deserializer<'de>>(
+    deserializer: D,
+) -> Result<Arc<Vec<Vec<u8>>>, D::Error> {
+    Arc::<Vec<Vec<u8>>>::deserialize(deserializer)
+}
+
+#[cfg(test)]
+mod native {
