+/-- `while let Some(value) = tri!(seq.next_element()) { insert(&mut values, value); }` then
+    `Ok(values)`: the elements in order through `insert`, until the first error or the end. -/
+def collectElements {A Error T C : Type} (seq : serde_core.de.SeqAccess A Error)
+    (d : serde_core.de.DeserializeΩ T) (insert : C → T → Result C) (values : C) (access : A) :
+    Result (core.result.Result C Error) := do
+  let (r, access) ← seq.next_element d access
+  match r with
+  | .Err e => ok (.Err e)
+  | .Ok none => ok (.Ok values)
+  | .Ok (some value) => collectElements seq d insert (← insert values value) access
+partial_fixpoint
