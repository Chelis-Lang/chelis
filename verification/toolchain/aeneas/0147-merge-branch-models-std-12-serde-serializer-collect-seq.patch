+    visit_i16 := fun _ _ v => .ok (.Ok (F64.ofIScalar v))
+    visit_i32 := fun _ _ v => .ok (.Ok (F64.ofIScalar v))
+    visit_i64 := fun _ _ v => .ok (.Ok (F64.ofIScalar v))
+    visit_u8 := fun _ _ v => .ok (.Ok (F64.ofUScalar v))
+    visit_u16 := fun _ _ v => .ok (.Ok (F64.ofUScalar v))
+    visit_u32 := fun _ _ v => .ok (.Ok (F64.ofUScalar v))
+    visit_u64 := fun _ _ v => .ok (.Ok (F64.ofUScalar v)) }
