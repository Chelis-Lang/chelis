+    /// The deserializer of a value tree: a number is visited with its kind's `visit_*` (a float
+    /// from its bits), a sequence or a tuple as a sequence, a map or a struct (its field names as
+    /// strings) as a map.
+    pub struct ValueDe(pub Value);
+    pub struct SeqDe(std::vec::IntoIter<Value>);
+    pub struct MapDe {
+        entries: std::vec::IntoIter<(Value, Value)>,
+        value: Option<Value>,
+    }
+
+    impl<'de> de::Deserializer<'de> for ValueDe {
+        type Error = TestError;
+
+        fn deserialize_any<V: Visitor<'de>>(self, visitor: V) -> Result<V::Value, TestError> {
+            match self.0 {
+                Unit => visitor.visit_unit(),
+                Bool(b) => visitor.visit_bool(b),
+                Num(kind, v) => match kind {
+                    "i8" => visitor.visit_i8(v as i8),
+                    "i16" => visitor.visit_i16(v as i16),
+                    "i32" => visitor.visit_i32(v as i32),
+                    "i64" => visitor.visit_i64(v as i64),
+                    "u8" => visitor.visit_u8(v as u8),
+                    "u16" => visitor.visit_u16(v as u16),
+                    "u32" => visitor.visit_u32(v as u32),
+                    "u64" => visitor.visit_u64(v as u64),
+                    "f32" => visitor.visit_f32(f32::from_bits(v as u32)),
+                    "f64" => visitor.visit_f64(f64::from_bits(v as u64)),
+                    _ => fail("kind"),
+                },
+                Str(s) => visitor.visit_str(&s),
+                None => visitor.visit_none(),
+                Some(v) => visitor.visit_some(ValueDe(*v)),
+                Seq(_, items) | Tuple(_, items) => visitor.visit_seq(SeqDe(items.into_iter())),
+                Map(_, entries) => {
+                    visitor.visit_map(MapDe { entries: entries.into_iter(), value: Option::None })
+                }
+                Struct(_, fields) => {
+                    let entries: Vec<(Value, Value)> =
+                        fields.into_iter().map(|(k, v)| (Str(k.to_string()), v)).collect();
+                    visitor.visit_map(MapDe { entries: entries.into_iter(), value: Option::None })
+                }
+            }
+        }
+
+        serde::forward_to_deserialize_any! {
+            bool i8 i16 i32 i64 i128 u8 u16 u32 u64 u128 f32 f64 char str string
+            bytes byte_buf option unit unit_struct newtype_struct seq tuple
+            tuple_struct map struct enum identifier ignored_any
+        }
+    }
+
+    impl<'de> SeqAccess<'de> for SeqDe {
+        type Error = TestError;
+        fn next_element_seed<T: DeserializeSeed<'de>>(
+            &mut self, seed: T,
+        ) -> Result<Option<T::Value>, TestError> {
+            match self.0.next() {
+                Option::Some(v) => seed.deserialize(ValueDe(v)).map(Option::Some),
+                Option::None => Ok(Option::None),
+            }
+        }
+    }
+
+    impl<'de> MapAccess<'de> for MapDe {
+        type Error = TestError;
+        fn next_key_seed<K: DeserializeSeed<'de>>(
+            &mut self, seed: K,
+        ) -> Result<Option<K::Value>, TestError> {
+            match self.entries.next() {
+                Option::Some((k, v)) => {
+                    self.value = Option::Some(v);
+                    seed.deserialize(ValueDe(k)).map(Option::Some)
+                }
+                Option::None => Ok(Option::None),
+            }
+        }
+        fn next_value_seed<V: DeserializeSeed<'de>>(
+            &mut self, seed: V,
+        ) -> Result<V::Value, TestError> {
+            match self.value.take() {
+                Option::Some(v) => seed.deserialize(ValueDe(v)),
+                Option::None => fail("value missing"),
+            }
+        }
+    }
+
+    fn f64v(v: f64) -> Value {
+        Num("f64", v.to_bits() as i128)
+    }
+
+    fn f32v(v: f32) -> Value {
+        Num("f32", v.to_bits() as i128)
+    }
+
+    #[test]
+    fn serialize_numbers() {
+        let low = Numbers {
+            small: i8::MIN,
+            mid: i16::MIN,
+            word: i32::MIN,
+            wide: i64::MIN,
+            byte: u8::MAX,
+            big: u64::MAX,
+            size: usize::MAX,
+            floats: vec![
+                f64::NAN,
+                -f64::NAN,
+                f64::INFINITY,
+                f64::NEG_INFINITY,
+                -0.0,
+                f64::MIN_POSITIVE,
+                5e-324,
+                f64::MAX,
+            ],
+        };
+        assert_eq!(
+            ser(&low),
+            Ok(Struct(
+                "Numbers",
+                vec![
+                    ("small", Num("i8", -128)),
+                    ("mid", Num("i16", -32768)),
+                    ("word", Num("i32", -2147483648)),
+                    ("wide", Num("i64", -9223372036854775808)),
+                    ("byte", Num("u8", 255)),
+                    ("big", Num("u64", 18446744073709551615)),
+                    ("size", Num("u64", 18446744073709551615)),
+                    (
+                        "floats",
+                        Seq(
+                            Option::Some(8),
+                            vec![
+                                Num("f64", 0x7ff8000000000000),
+                                Num("f64", 0xfff8000000000000),
+                                Num("f64", 0x7ff0000000000000),
+                                Num("f64", 0xfff0000000000000),
+                                Num("f64", 0x8000000000000000),
+                                Num("f64", 0x0010000000000000),
+                                Num("f64", 1),
+                                Num("f64", 0x7fefffffffffffff),
+                            ],
+                        ),
+                    ),
+                ],
+            ))
+        );
+        let high = Numbers {
+            small: i8::MAX,
+            mid: i16::MAX,
+            word: i32::MAX,
+            wide: i64::MAX,
+            byte: 0,
+            big: 0,
+            size: 0,
+            floats: vec![],
+        };
+        let Ok(Struct(_, fields)) = ser(&high) else { panic!() };
+        assert_eq!(fields[0], ("small", Num("i8", 127)));
+        assert_eq!(fields[1], ("mid", Num("i16", 32767)));
+        assert_eq!(fields[2], ("word", Num("i32", 2147483647)));
+        assert_eq!(fields[3], ("wide", Num("i64", 9223372036854775807)));
+        assert_eq!(fields[6], ("size", Num("u64", 0)));
+        assert_eq!(fields[7], ("floats", Seq(Option::Some(0), vec![])));
