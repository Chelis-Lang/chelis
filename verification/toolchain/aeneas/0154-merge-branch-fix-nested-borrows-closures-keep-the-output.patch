+import ClosureGenericReturnInputRef.ClosureGenericReturnInputRef
+
+/-! Evaluate the model of `tests/src/closure-generic-return-input-ref.rs` on
+    the inputs of its `native` test module and compare with the native results
+    (including the values the visitors write back through their captures). -/
+
+namespace closure_generic_return_input_ref.checks
+open Aeneas Aeneas.Std Result
+open closure_generic_return_input_ref
+
+def u (x : Nat) : U32 := ⟨BitVec.ofNat _ x⟩
+
+/-- `(picked.v, visited atoms)` -/
+def runPick (v atom : Nat) : Option (Nat × Nat) :=
+  match run_pick (u v) (u atom) with
+  | ok (p, s) => some (p.val, s.val)
+  | _ => none
+
+/-- `(visits, atoms)` -/
+def runVisit (depth v : Nat) : Option (Nat × Nat) :=
+  match run_visit (u depth) (u v) with
+  | ok (n, a) => some (n.val, a.val)
+  | _ => none
+
+-- pick_native
+#guard runPick 3 5 == some (3, 5)
+#guard runPick 3 0 == some (3, 1)
+#guard runPick 0 5 == some (0, 0)
+
+-- visit_native
+#guard runVisit 0 1 == some (0, 0)
+#guard runVisit 1 1 == some (1, 7)
+#guard runVisit 3 1 == some (3, 108)
+#guard runVisit 3 0 == some (3, 101)
+
+end closure_generic_return_input_ref.checks
