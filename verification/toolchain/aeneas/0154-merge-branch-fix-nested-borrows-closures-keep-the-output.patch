--- a/src/PrePasses.ml
+++ b/src/PrePasses.ml
@@ -1933,6 +1933,19 @@ let simplify_trait_calls (crate : crate) : crate =
     See https://github.com/AeneasVerif/aeneas/issues/804 and
     https://github.com/AeneasVerif/charon/issues/1040.
 
+    The output keeps its region when the signature says that a region other
+    than the one of the closure outlives it: the output then borrows from an
+    input, not from the state. For instance, a closure defined in
+    [fn visit<'a, T>] has the region ['a] (closure types take the generics of
+    their parent) even if it captures nothing, and the closure [|s| s.literal]
+    on [s : Src<'_1>] has the signature
+    {[
+      call_once<'a, '_1, '_2, T>(v@1 : closure<'a, T>, (Src<'_1>,)) -> &'_2 Expr
+      where '_1 : '_2
+    ]}
+    which the update above would turn into a function whose output borrows
+    from [v@1].
+
     TODO: remove once the Charon issue is fixed. *)
 let fix_closure_lifetimes (crate : crate) (f : fun_decl) : fun_decl =
   (* Check that the function is a closure *)
@@ -1955,7 +1968,19 @@ let fix_closure_lifetimes (crate : crate) (f : fun_decl) : fun_decl =
   match f.signature.inputs with
   | [] -> f
   | first_input :: _ -> (
+      (* Does a region other than the one of the closure outlive [r]? *)
+      let outlived_by_other_region (input_rid : region_id de_bruijn_var)
+          (r : region) =
+        List.exists
+          (fun (p : (region, region) outlives_pred region_binder) ->
+            let long, short = p.binder_value in
+            short = r && long <> r && long <> RVar input_rid)
+          f.generics.regions_outlive
+      in
       match (find_input_region first_input, f.signature.output) with
+      | Some input_rid, TRef ((RVar _ as r), _, _)
+        when outlived_by_other_region input_rid r ->
+          f
       | Some input_rid, TRef (RVar _, ref_ty, kind) ->
           (* TODO: support more cases for the output? *)
           let output = TRef (RVar input_rid, ref_ty, kind) in
