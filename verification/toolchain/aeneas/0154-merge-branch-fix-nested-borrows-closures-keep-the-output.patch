+//@ [!lean] skip
+//@ [lean] subdir=ClosureGenericReturnInputRef
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::option::{core::option::Option} --include core::ops::deref::{core::ops::deref::Deref} --include core::ops::deref::{core::ops::deref::DerefMut}
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! A closure which returns a reference borrowed from its argument, defined in
+//! a function with a region parameter and a type parameter: the closure type
+//! takes them (`closure<'a, T>`) even if it captures nothing. The output of
+//! its `call_once` was replaced by a borrow of the closure's region (the
+//! work-around of Charon issue 1040), although the signature says that it
+//! borrows from the argument: 'Can't end abstraction .. as it is set as
+//! non-endable' (production: chelis_deep literal_source
+//! `visit_binder_literal_uses`, `source.map_or(operand, |source| source.literal)`).
+
+pub struct Atom {
+    pub a: u32,
+}
+
+pub struct Expr {
+    pub v: u32,
+    pub children: Vec<Expr>,
+    pub atom: Option<Atom>,
+}
+
+#[derive(Clone, Copy)]
+pub struct Src<'a> {
+    literal: &'a Expr,
+    numeric_atom: Option<&'a Atom>,
+}
+
+pub fn classify<'a>(e: &'a Expr) -> Option<Src<'a>> {
+    if e.v > 0 {
+        Some(Src { literal: e, numeric_atom: e.atom.as_ref() })
+    } else {
+        None
+    }
+}
+
+pub fn atom_value(s: Option<Src<'_>>) -> u32 {
+    match s {
+        Some(Src { numeric_atom: Some(a), .. }) => a.a,
+        Some(_) => 1,
+        None => 0,
+    }
+}
+
+/// The closure is generic over `'a` and `T`
+pub fn pick<'a, T: FnMut(Option<Src<'a>>)>(operand: &'a Expr, visitor: &mut T) -> &'a Expr {
+    let source = classify(operand);
+    visitor(source);
+    source.map_or(operand, |source| source.literal)
+}
+
+/// The production shape: a traversal with an explicit stack
+pub fn visit_uses<'a>(expr: &'a Expr, visitor: &mut impl FnMut(Option<Src<'a>>)) {
+    let mut stack = vec![expr];
+    while let Some(expr) = stack.pop() {
+        if let Some(operand) = expr.children.first() {
+            let source = classify(operand);
+            visitor(source);
+            stack.push(source.map_or(operand, |source| source.literal));
+        }
+    }
+}
+
+pub fn leaf(v: u32, atom: Option<u32>) -> Expr {
+    Expr { v, children: Vec::new(), atom: atom.map(|a| Atom { a }) }
+}
+
+/// `(picked.v, visited atoms)`
+pub fn run_pick(v: u32, atom: u32) -> (u32, u32) {
+    let e = leaf(v, if atom > 0 { Some(atom) } else { None });
+    let mut seen = 0;
+    let picked = pick(&e, &mut |s| seen += atom_value(s));
+    (picked.v, seen)
+}
+
+/// A chain of `depth` nodes, each with one child; `(visits, atoms)`
+pub fn run_visit(depth: u32, v: u32) -> (u32, u32) {
+    let mut e = leaf(v, Some(7));
+    let mut i = 0;
+    while i < depth {
+        e = Expr { v: i, children: vec![e], atom: Some(Atom { a: i + 100 }) };
+        i += 1;
+    }
+    let mut visits = 0;
+    let mut atoms = 0;
+    visit_uses(&e, &mut |s| {
+        visits += 1;
+        atoms += atom_value(s);
+    });
+    (visits, atoms)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn pick_native() {
+        assert_eq!(run_pick(3, 5), (3, 5));
+        assert_eq!(run_pick(3, 0), (3, 1));
+        assert_eq!(run_pick(0, 5), (0, 0));
+    }
+
+    #[test]
+    fn visit_native() {
+        assert_eq!(run_visit(0, 1), (0, 0));
+        assert_eq!(run_visit(1, 1), (1, 7));
+        assert_eq!(run_visit(3, 1), (3, 108));
+        assert_eq!(run_visit(3, 0), (3, 101));
+    }
+}
