+//@ [!lean] skip
+//@ [lean] subdir=NestedBorrowsFrozenPayloadLoans
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::option::{core::option::Option} --include core::ops::deref::{core::ops::deref::Deref} --include core::ops::deref::{core::ops::deref::DerefMut}
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! A shared reborrow of a place of `**x`, for an input `x : &&T`, puts a
+//! shared loan in the payload retained by the frozen input abstraction of the
+//! inner region, and the loan stays once the reborrow ended. When only one
+//! branch borrowed the place, the join must end this loan (no borrow refers
+//! to it, the other branch does not hold it) instead of giving the joined
+//! payload a fresh loan: otherwise the frozen abstraction of the joined
+//! context no longer matches the source context of the join (production:
+//! chelis_ir `verify_materialized_roots`, whose filter closure called on
+//! `&&HostBinding` tests `a || matches!(&binding.value.kind, ..)`, then reads
+//! the binding again).
+
+pub enum Kind {
+    Call { function: String, args: Vec<u32> },
+    Other,
+}
+
+pub struct Expr {
+    pub kind: Kind,
+}
+
+pub struct Binding {
+    pub name: String,
+    pub value: Expr,
+    pub roots: Vec<u32>,
+}
+
+pub struct Entry {
+    pub def_name: String,
+}
+
+/// The production shape: the closure is called on `&&Binding`; the
+/// right-hand side of `||` borrows a place of the binding in one branch only
+pub fn count_selected(bindings: &[Binding], entry: &Entry, expected: u32) -> usize {
+    bindings
+        .iter()
+        .filter(|binding| {
+            let selected = binding.name == entry.def_name
+                || matches!(
+                    &binding.value.kind,
+                    Kind::Call { function, args } if function == &entry.def_name && args.is_empty()
+                );
+            selected && binding.roots.iter().filter(|root| **root == expected).count() == 1
+        })
+        .count()
+}
+
+/// The same test in a function taking `&&Binding`
+pub fn selected(binding: &&Binding, entry: &Entry) -> bool {
+    let selected = binding.name == entry.def_name
+        || matches!(
+            &binding.value.kind,
+            Kind::Call { function, args } if function == &entry.def_name && args.is_empty()
+        );
+    selected && binding.roots.len() == 2
+}
+
+pub fn mk(name: String, function: String, call: bool, nargs: u32, r0: u32, r1: u32) -> Binding {
+    let mut args = Vec::new();
+    let mut i = 0;
+    while i < nargs {
+        args.push(i);
+        i += 1;
+    }
+    let kind = if call { Kind::Call { function, args } } else { Kind::Other };
+    let mut roots = Vec::new();
+    roots.push(r0);
+    roots.push(r1);
+    Binding { name, value: Expr { kind }, roots }
+}
+
+pub fn run_count(b0: Binding, b1: Binding, b2: Binding, def_name: String, expected: u32) -> usize {
+    let mut bindings = Vec::new();
+    bindings.push(b0);
+    bindings.push(b1);
+    bindings.push(b2);
+    count_selected(bindings.as_slice(), &Entry { def_name }, expected)
+}
+
+pub fn run_selected(b: Binding, def_name: String) -> bool {
+    selected(&&b, &Entry { def_name })
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    fn s(x: &str) -> String {
+        String::from(x)
+    }
+
+    #[test]
+    fn count_selected_native() {
+        // selected by name, by a call without arguments; a call with arguments
+        // and a call of another function are not selected
+        let bs = || {
+            (
+                mk(s("f"), s("g"), false, 0, 7, 8),
+                mk(s("a"), s("f"), true, 0, 7, 7),
+                mk(s("b"), s("f"), true, 0, 8, 7),
+            )
+        };
+        let (b0, b1, b2) = bs();
+        assert_eq!(run_count(b0, b1, b2, s("f"), 7), 2);
+        let (b0, b1, b2) = bs();
+        assert_eq!(run_count(b0, b1, b2, s("f"), 8), 2);
+        let (b0, b1, b2) = bs();
+        assert_eq!(run_count(b0, b1, b2, s("a"), 7), 0);
+        let (b0, b1, b2) = bs();
+        assert_eq!(run_count(b0, b1, b2, s("g"), 7), 0);
+        assert_eq!(
+            run_count(
+                mk(s("f"), s("f"), true, 2, 7, 1),
+                mk(s("c"), s("f"), true, 1, 7, 1),
+                mk(s("c"), s("g"), true, 0, 7, 1),
+                s("f"),
+                7
+            ),
+            1
+        );
+    }
+
+    #[test]
+    fn selected_native() {
+        assert!(run_selected(mk(s("f"), s("g"), false, 0, 1, 2), s("f")));
+        assert!(run_selected(mk(s("a"), s("f"), true, 0, 1, 2), s("f")));
+        assert!(!run_selected(mk(s("a"), s("f"), true, 3, 1, 2), s("f")));
+        assert!(!run_selected(mk(s("a"), s("g"), true, 0, 1, 2), s("f")));
+        assert!(!run_selected(mk(s("a"), s("f"), false, 0, 1, 2), s("f")));
+    }
+}
