+
+namespace loop_then_collect_join.checks
+open Aeneas Aeneas.Std Result
+
+def vec {α} (xs : List α) (h : xs.length ≤ Usize.max := by scalar_tac) : alloc.vec.Vec α := ⟨xs, h⟩
+
+def a (xs : List Nat) (h : xs.length ≤ Usize.max := by scalar_tac) : Storage :=
+  { buf := .A (vec (xs.map fun x => (⟨BitVec.ofNat _ x⟩ : U32)) (by simpa using h)) }
+def b (xs : List Nat) (h : xs.length ≤ Usize.max := by scalar_tac) : Storage :=
+  { buf := .B (vec (xs.map fun x => (⟨BitVec.ofNat _ x⟩ : U64)) (by simpa using h)) }
+def c (xs : List Int) (h : xs.length ≤ Usize.max := by scalar_tac) : Storage :=
+  { buf := .C (vec (xs.map fun x => (⟨BitVec.ofInt _ x⟩ : I64)) (by simpa using h)) }
+
+/-- `Ok v` as the list of its values, `Err n` as `n` -/
+def res (r : Result (core.result.Result (alloc.vec.Vec U32) Usize)) : Option (Sum (List Nat) Nat) :=
+  match r with
+  | ok (core.result.Result.Ok v) => some (.inl (v.val.map (·.val)))
+  | ok (core.result.Result.Err n) => some (.inr n.val)
+  | _ => none
+
+-- family_then_collect_native
+#guard res (family_then_collect (a [1, 2, 3]) (b [4])) == some (.inl [1, 2, 3])
+#guard res (family_then_collect (a []) (a [5])) == some (.inl [])
+#guard res (family_then_collect (b [1, 2]) (a [5])) == some (.inl [])
+#guard res (family_then_collect (c [1, 2]) (a [5])) == some (.inr 2)
+#guard res (family_then_collect (a [7]) (c [1, 2, 3])) == some (.inr 3)
+
+-- family_then_collect_last_native
+#guard res (family_then_collect_last (a [9, 8]) (a [])) == some (.inl [9, 8])
+#guard res (family_then_collect_last (b [1]) (b [])) == some (.inl [])
+#guard res (family_then_collect_last (a [1]) (c [])) == some (.inr 0)
+
