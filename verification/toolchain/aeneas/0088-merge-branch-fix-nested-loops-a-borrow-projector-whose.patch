+import JoinSharedBorrowField.JoinSharedBorrowField
+
+/-! Evaluate the model of `tests/src/join-shared-borrow-field.rs` on the
+    inputs of its `native` test module and compare with the native results
+    `(result, ctx, pos)`: `pos` is the frame given back through the `&mut`
+    (the forward output), `ctx` the value of the frame's region given back by
+    the backward function of that region when the caller gives the frame
+    back. -/
+
+namespace join_shared_borrow_field.checks
+open Aeneas Aeneas.Std Result
+
+def u (x : Nat) : U32 := ⟨BitVec.ofNat _ x⟩
+def us (x : Nat) : Usize := ⟨BitVec.ofNat _ x⟩
+
+def max := 4294967295
+
+def sl (xs : List Nat) (h : xs.length ≤ Usize.max := by scalar_tac) : Slice U32 :=
+  ⟨xs.map u, by simpa using h⟩
+
+def frame (ctx pos : Nat) : Frame := { steps := sl [3, 5, 7], ctx := u ctx, pos := us pos }
+
+/-- `run (&mut frame)`; the caller then sets the frame's `ctx` to `set` (if
+    any) and gives the frame back -/
+def onFrame {R S : Type} (res : R → S) (run : Frame → Result (R × Frame × (Frame → Frame)))
+    (ctx pos : Nat) (set : Option Nat := none) : Option (S × Nat × Nat) :=
+  match run (frame ctx pos) with
+  | ok (r, f1, back) =>
+    let f1' := match set with
+      | some c => { f1 with ctx := u c }
+      | none => f1
+    some (res r, (back f1').ctx.val, f1.pos.val)
+  | _ => none
+
+def triple (r : U32 × U32 × Bool) : Nat × Nat × Bool := (r.1.val, r.2.1.val, r.2.2)
+
+-- run_try_plain_native
+#guard onFrame triple (run_try_plain · true (u 4)) 10 0 == some ((3, 4, true), 13, 1)
+#guard onFrame triple (run_try_plain · true (u 4)) 10 2 == some ((7, 4, true), 17, 3)
+#guard onFrame triple (run_try_plain · true (u 4)) 10 3 == some ((3, 4, false), 10, 3)
+#guard onFrame triple (run_try_plain · false (u 4)) 10 1 == some ((5, 5, true), 10, 1)
+#guard onFrame triple (run_try_plain · true (u max)) (max - 1) 2 == some ((7, max, true), 5, 3)
+#guard onFrame triple (run_try_plain · false (u max)) 10 1 == some ((0, 0, true), 10, 1)
+#guard onFrame triple (run_try_plain · false (u 4)) 10 1 (set := some 99) == some ((5, 5, true), 99, 1)
+
+end join_shared_borrow_field.checks
