diff --git a/tests/src/join-shared-borrow-field.rs b/tests/src/join-shared-borrow-field.rs
new file mode 100644
index 0000000..40c9606
--- /dev/null
+++ b/tests/src/join-shared-borrow-field.rs
@@ -0,0 +1,94 @@
+//@ [!lean] skip
+//@ [lean] subdir=JoinSharedBorrowField
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::option::{core::option::Option}
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! A join over a struct holding a shared borrow and a mutable borrow of the
+//! same region (`Frame<'a>`), passed to a call in one branch
+//! (`try_plain(Some(f), ..)`) and left untouched in the other
+//! (`try_plain(None, ..)`). The join abstraction of the region gives the
+//! frame's mutable borrow back through a pattern over the whole frame: its
+//! shared-borrow field gives nothing back. That field used to be bound by a
+//! unit pattern (`let ⟨ (), i, _ ⟩ := f`), which Lean rejects; it is now
+//! ignored with the type of the field.
+//!
+//! JoinSharedBorrowField/Checks.lean compares the model with the native
+//! results asserted in the native test module.
+
+pub struct Frame<'a> {
+    pub steps: &'a [u32],
+    pub ctx: &'a mut u32,
+    pub pos: usize,
+}
+
+impl<'a> Frame<'a> {
+    pub fn advance(&mut self) -> u32 {
+        let s = self.steps[self.pos];
+        self.pos += 1;
+        *self.ctx = (*self.ctx).wrapping_add(s);
+        s
+    }
+
+    pub fn try_advance(&mut self) -> Result<u32, u32> {
+        if self.pos >= self.steps.len() {
+            return Err(self.pos as u32);
+        }
+        Ok(self.advance())
+    }
+}
+
+pub fn try_plain(execution: Option<&mut Frame<'_>>, counter: &mut u32) -> Result<u32, u32> {
+    match execution {
+        Some(frame) => frame.try_advance(),
+        None => {
+            *counter = counter.wrapping_add(1);
+            Ok(*counter)
+        }
+    }
+}
+
+pub fn run_try_plain(f: &mut Frame<'_>, some: bool, counter: u32) -> (u32, u32, bool) {
+    let mut c = counter;
+    let r = if some {
+        try_plain(Some(f), &mut c)
+    } else {
+        try_plain(None, &mut c)
+    };
+    match r {
+        Ok(k) => (k, c, true),
+        Err(e) => (e, c, false),
+    }
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    /// `run (&mut frame)`, then the frame's `ctx` and `pos`
+    fn on_frame<R>(ctx: u32, pos: usize, run: impl FnOnce(&mut Frame<'_>) -> R) -> (R, u32, usize) {
+        let steps = [3u32, 5, 7];
+        let mut c = ctx;
+        let mut f = Frame { steps: &steps, ctx: &mut c, pos };
+        let r = run(&mut f);
+        let pos = f.pos;
+        (r, c, pos)
+    }
+
+    #[test]
+    fn run_try_plain_native() {
+        assert_eq!(on_frame(10, 0, |f| run_try_plain(f, true, 4)), ((3, 4, true), 13, 1));
+        assert_eq!(on_frame(10, 2, |f| run_try_plain(f, true, 4)), ((7, 4, true), 17, 3));
+        assert_eq!(on_frame(10, 3, |f| run_try_plain(f, true, 4)), ((3, 4, false), 10, 3));
+        assert_eq!(on_frame(10, 1, |f| run_try_plain(f, false, 4)), ((5, 5, true), 10, 1));
+        assert_eq!(on_frame(u32::MAX - 1, 2, |f| run_try_plain(f, true, u32::MAX)), ((7, u32::MAX, true), 5, 3));
+        assert_eq!(on_frame(10, 1, |f| run_try_plain(f, false, u32::MAX)), ((0, 0, true), 10, 1));
+        // The caller writes through the frame after the call
+        assert_eq!(
+            on_frame(10, 1, |f| {
+                let r = run_try_plain(&mut *f, false, 4);
+                *f.ctx = 99;
+                r
+            }),
+            ((5, 5, true), 99, 1)
+        );
+    }
+}
diff --git a/tests/src/loop-then-collect-join.rs b/tests/src/loop-then-collect-join.rs
new file mode 100644
index 0000000..5db43d9
--- /dev/null
+++ b/tests/src/loop-then-collect-join.rs
@@ -0,0 +1,99 @@
+//@ [!lean] skip
+//@ [lean] subdir=LoopThenCollectJoin
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! A loop over `[input, other]` (an array of shared borrows) which may return
+//! early, then a `match &input.buf` whose `_` arm covers several variants and
+//! whose other arm collects an iterator over the payload (the shape of the
+//! family check followed by a collect in the tensor backward functions of
+//! chelis). At the loop exit, the region abstraction of the last `next` call
+//! only holds a borrow projector over the iterator, whose loan projector is
+//! held by the (non-fixed) abstraction of `into_iter`: ending the former only
+//! gives back to the latter, like ending a concrete mutable borrow whose loan
+//! is in a non-fixed abstraction. Simplifying the contexts before the join of
+//! the arms used to keep it in the arms without a join (while the join of the
+//! `_` contexts merged both abstractions), and matching the contexts failed.
+//!
+//! LoopThenCollectJoin/Checks.lean compares the model with the native results
+//! asserted in the native test module.
+
+pub enum Buf {
+    A(Vec<u32>),
+    B(Vec<u64>),
+    C(Vec<i64>),
+}
+
+pub struct Storage {
+    pub buf: Buf,
+}
+
+impl Storage {
+    pub fn is_int(&self) -> bool {
+        !matches!(self.buf, Buf::C(_))
+    }
+
+    pub fn len(&self) -> usize {
+        match &self.buf {
+            Buf::A(v) => v.len(),
+            Buf::B(v) => v.len(),
+            Buf::C(v) => v.len(),
+        }
+    }
+}
+
+/// The collecting arm first
+pub fn family_then_collect(input: &Storage, other: &Storage) -> Result<Vec<u32>, usize> {
+    for value in [input, other] {
+        if !value.is_int() {
+            return Err(value.len());
+        }
+    }
+    match &input.buf {
+        Buf::A(x) => Ok(x.iter().copied().collect()),
+        _ => Ok(Vec::new()),
+    }
+}
+
+/// The collecting arm last
+pub fn family_then_collect_last(input: &Storage, other: &Storage) -> Result<Vec<u32>, usize> {
+    for value in [input, other] {
+        if !value.is_int() {
+            return Err(value.len());
+        }
+    }
+    match &input.buf {
+        Buf::B(_) | Buf::C(_) => Ok(Vec::new()),
+        Buf::A(x) => Ok(x.iter().copied().collect()),
+    }
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    fn a(xs: &[u32]) -> Storage {
+        Storage { buf: Buf::A(xs.to_vec()) }
+    }
+    fn b(xs: &[u64]) -> Storage {
+        Storage { buf: Buf::B(xs.to_vec()) }
+    }
+    fn c(xs: &[i64]) -> Storage {
+        Storage { buf: Buf::C(xs.to_vec()) }
+    }
+
+    #[test]
+    fn family_then_collect_native() {
+        assert_eq!(family_then_collect(&a(&[1, 2, 3]), &b(&[4])), Ok(vec![1, 2, 3]));
+        assert_eq!(family_then_collect(&a(&[]), &a(&[5])), Ok(vec![]));
+        assert_eq!(family_then_collect(&b(&[1, 2]), &a(&[5])), Ok(vec![]));
+        assert_eq!(family_then_collect(&c(&[1, 2]), &a(&[5])), Err(2));
+        assert_eq!(family_then_collect(&a(&[7]), &c(&[1, 2, 3])), Err(3));
+    }
+
+    #[test]
+    fn family_then_collect_last_native() {
+        assert_eq!(family_then_collect_last(&a(&[9, 8]), &a(&[])), Ok(vec![9, 8]));
+        assert_eq!(family_then_collect_last(&b(&[1]), &b(&[])), Ok(vec![]));
