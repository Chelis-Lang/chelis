+import ClosureCallKinds.ClosureCallKinds
+
+/-! Evaluate the model of `tests/src/closure-call-kinds.rs` on the inputs of
+    its `native` test module and compare with the native results. -/
+
+namespace closure_call_kinds.checks
+open Aeneas Aeneas.Std Result
+
+def u (x : Nat) : U32 := ⟨BitVec.ofNat _ x⟩
+
+def sl (xs : List Nat) (h : xs.length ≤ Usize.max := by scalar_tac) : Slice U32 :=
+  ⟨xs.map u, by simpa using h⟩
+
+def vec (xs : List Nat) (h : xs.length ≤ Usize.max := by scalar_tac) : alloc.vec.Vec U32 :=
+  ⟨xs.map u, by simpa using h⟩
+
+def val {α} (f : α → β) : Result α → Option β
+  | ok x => some (f x)
+  | _ => none
+
+-- `FnOnce` by value, consuming an owned vector moved into the closure
+#guard val (·.val) (once_owned (vec []) (u 7)) == some 8
+#guard val (·.val) (once_owned (vec [1, 2, 3]) (u 10)) == some 14
+#guard val (·.val) (once_owned (vec [0]) (u 4294967295)) == some 1
+
+-- `FnOnce` by value, capturing a shared borrow
+#guard val (·.val) (once_shared (sl [4, 5, 6]) 1#usize (u 10)) == some 15
+#guard val (·.val) (once_shared (sl [4294967295]) 0#usize (u 2)) == some 1
+
+-- `FnOnce` by value, capturing a mutable borrow: the update is visible after
+-- the call
+def runOnceMut (start x : Nat) : Option (Nat × Nat) :=
+  val (fun (r, a) => (r.val, a.val)) (once_mut (u start) (u x))
+
+#guard runOnceMut 10 5 == some (30, 15)
+#guard runOnceMut 4294967295 1 == some (0, 0)
+#guard runOnceMut 3 2147483648 == some (6, 2147483651)
+
+-- `FnOnce`-only closures (moving a captured vector out) capturing a mutable
+-- borrow: one through `run_once`, one called directly
+def runOnly (v w : List Nat) (x : Nat)
+    (hv : v.length ≤ Usize.max := by scalar_tac) (hw : w.length ≤ Usize.max := by scalar_tac) :
+    Option (Nat × Nat × Nat) :=
+  val (fun (a, b, s) => (a.val, b.val, s.val)) (once_only (vec v) (vec w) (u x))
+
+#guard runOnly [1, 2] [7] 10 == some (4, 3, 15)
+#guard runOnly [] [] 4294967295 == some (2, 0, 4)
+
+-- `FnMut` by `&mut`, capturing a mutable borrow (a call counter) and a value
+def runCounter (k x : Nat) : Option (Nat × Nat) :=
+  val (fun (r, c) => (r.val, c.val)) (mut_counter (u k) (u x))
+
+#guard runCounter 3 2 == some (18, 2)
+#guard runCounter 0 9 == some (0, 2)
+#guard runCounter 65536 65536 == some (0, 2)
+
+-- `FnMut` by `&mut` owning its state, then called directly
+def runOwned (x : Nat) : Option (Nat × Nat) :=
+  val (fun (a, b) => (a.val, b.val)) (mut_owned_state (u x))
+
+#guard runOwned 5 == some (10, 11)
+#guard runOwned 0 == some (0, 1)
+#guard runOwned 2147483648 == some (0, 1)
+
+-- `Fn` by `&`, capturing a shared borrow of a struct
+def runShared (scale offset x : Nat) : Option Nat :=
+  val (·.val) (fn_shared { scale := u scale, offset := u offset } (u x))
+
+#guard runShared 3 1 4 == some 26
+#guard runShared 0 7 100 == some 14
+#guard runShared 2 0 2147483648 == some 0
+
+-- `FnOnce(&mut Ctx)` callback of a context helper, capturing a mutable borrow
+def runCtx (x : Nat) : Option (Nat × Nat × Nat × Nat) :=
+  val (fun (r, d, l, s) => (r.val, d.val, l.val, s.val)) (ctx_callback (u x))
+
+#guard runCtx 3 == some (9, 5, 1, 6)
+#guard runCtx 4294967295 == some (5, 5, 1, 6)
+
+end closure_call_kinds.checks
