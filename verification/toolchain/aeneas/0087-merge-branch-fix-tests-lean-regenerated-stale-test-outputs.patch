+//@ [!lean] skip
+//@ [lean] subdir=TraitDefaultSelf
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! A trait implementation using default items that refer to the
+//! implementation itself (a recursive implementation, extracted with Lean's
+//! `impl_def`): the default constants read the implementation's own
+//! constants.
+//! `TraitDefaultSelf/Checks.lean` evaluates the model on the inputs of the
+//! `native` test module below and compares with the native results.
+
+pub trait Dims {
+    const N: usize;
+    const M: usize;
+    const NM: usize = Self::N * Self::M;
+    const AREA: usize = Self::NM + Self::N;
+}
+
+pub struct Grid;
+
+impl Dims for Grid {
+    const N: usize = 3;
+    const M: usize = 4;
+}
+
+pub fn grid_nm() -> usize {
+    <Grid as Dims>::NM
+}
+
+pub fn grid_area(extra: usize) -> usize {
+    <Grid as Dims>::AREA + extra
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn dims_native() {
+        assert_eq!(grid_nm(), 12);
+        assert_eq!(grid_area(0), 15);
+        assert_eq!(grid_area(5), 20);
+    }
+}
