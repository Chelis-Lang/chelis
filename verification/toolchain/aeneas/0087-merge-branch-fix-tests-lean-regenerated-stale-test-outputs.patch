diff --git a/tests/separate-compilation/external-holes.sh b/tests/separate-compilation/external-holes.sh
new file mode 100755
index 0000000..0ebf08f
--- /dev/null
+++ b/tests/separate-compilation/external-holes.sh
@@ -0,0 +1,116 @@
+#!/usr/bin/env bash
+# The external functions file of a chunk: generated, and imported by the Funs
+# module, exactly when it has holes.
+#
+# Usage: external-holes.sh <charon> <aeneas> [<work directory>]
+#
+# Chunks of external_holes.rs, extracted like the chunks of a workspace
+# (-canonical-names, -split-files, one -subdir per chunk, -abort-on-error):
+# - A owns double.
+# - B (nested) with -external <manifest of A>: double has no body in B's LLBC
+#   (A emits it), and neither has the partial-monomorphization instance of the
+#   hard-opaque primitive scoped at the state Cx<'_>, whose translation is the
+#   model at an extended state. B has no hole: it generates no
+#   FunsExternal_Template and its Funs module does not import FunsExternal;
+#   every module imported by the files of A and B is generated.
+# - C is B with bias opaque too (an unknown external, run without
+#   -warnings-as-errors): the template declares bias, its one hole, and the
+#   Funs module imports FunsExternal, the file the user writes from the
+#   template; every other imported module is generated.
+set -uo pipefail
+
+charon=$1
+aeneas=$2
+here=$(cd "$(dirname "$0")" && pwd)
+work=${3:-$(mktemp -d)}
+mkdir -p "$work"
+failures=0
+
+check() { # check <description> <command...>
+  local what=$1
+  shift
+  if "$@"; then
+    echo "ok: $what"
+  else
+    echo "FAILED: $what"
+    failures=$((failures + 1))
+  fi
+}
+absent() { # absent <grep arguments...>: the files exist and do not match
+  grep -q "$@"
+  [ $? -eq 1 ]
+}
+
+llbc() { # llbc <chunk> <charon options...>
+  local chunk=$1
+  shift
+  "$charon" rustc --preset=aeneas --mir=promoted --monomorphize-mut=except-types \
+    --remove-adt-clauses '--lift-associated-types=*' --error-on-warnings \
+    --opaque-hard=chelis_ir::lowering_runtime::scoped "$@" \
+    --dest-file "$work/$chunk.llbc" -- "$here/external_holes.rs" \
+    --crate-name=chelis_ir --crate-type=rlib --edition=2021 \
+    >"$work/$chunk.charon.log" 2>&1 ||
+    { echo "charon failed on chunk $chunk (see $work/$chunk.charon.log)"; exit 1; }
+}
+
+strict=(-warnings-as-errors)
+run() { # run <name> <chunk> <aeneas options...>; sets $status
+  local name=$1 chunk=$2
+  shift 2
+  rm -rf "${work:?}/$name" && mkdir -p "$work/$name"
+  "$aeneas" -backend lean -checks -abort-on-error ${strict[@]+"${strict[@]}"} -strict-joins \
+    -sequential -no-progress-bar -canonical-names -split-files -subdir "Chunk$chunk" \
+    -dest "$work/$name/lean" -emit-manifest "$work/$name/manifest.json" "$@" \
+    "$work/$chunk.llbc" >"$work/$name/log" 2>&1
+  status=$?
+}
+
+# unresolved <lean root>... : the modules imported by the files under the
+# roots which none of them generates (Aeneas aside), one per line.
+unresolved() {
+  python3 -c '
+import pathlib, sys
+roots = [pathlib.Path(r) for r in sys.argv[1:]]
+files = [f for r in roots for f in r.rglob("*.lean")]
+modules = {".".join(f.relative_to(r).with_suffix("").parts) for r in roots for f in r.rglob("*.lean")}
+imports = {l.split()[1] for f in files for l in f.read_text().splitlines() if l.startswith("import ")}
+print("\n".join(sorted(i for i in imports if i != "Aeneas" and i not in modules)))' "$@"
+}
+
+llbc A --start-from chelis_ir::double
+llbc B --opaque chelis_ir::double --start-from chelis_ir::nested
+llbc C --opaque chelis_ir::double --opaque chelis_ir::bias --start-from chelis_ir::nested
+
+run a A
+check "A exits with status 0" test "$status" -eq 0
+
+run b B -external "$work/a/manifest.json"
+check "B exits with status 0" test "$status" -eq 0
+check "B uses the double of A" absent -rE '^def chelis_ir\.double$' "$work/b/lean"
+check "B defines the instance of scoped at Cx<'_>" \
+  grep -qE '^  chelis_ir\.lowering_runtime\.scoped0Cx.*_specialized_' "$work/b/lean/ChunkB/Funs.lean"
+check "B generates no external functions template" \
+  test ! -e "$work/b/lean/ChunkB/FunsExternal_Template.lean"
+check "the Funs module of B does not import FunsExternal" \
+  absent -q '^import ChunkB.FunsExternal$' "$work/b/lean/ChunkB/Funs.lean"
+check "every module imported by A and B is generated" \
+  test -z "$(unresolved "$work/a/lean" "$work/b/lean")"
+
+strict=()
+run c C -external "$work/a/manifest.json"
+strict=(-warnings-as-errors)
+check "C exits with status 0" test "$status" -eq 0
+check "the template of C declares bias" \
+  grep -qE '^axiom chelis_ir\.bias$' "$work/c/lean/ChunkC/FunsExternal_Template.lean"
+check "the template of C declares nothing else" \
+  test "$(grep -cE '^axiom ' "$work/c/lean/ChunkC/FunsExternal_Template.lean")" -eq 1
+check "the Funs module of C imports FunsExternal" \
+  grep -q '^import ChunkC.FunsExternal$' "$work/c/lean/ChunkC/Funs.lean"
+check "FunsExternal is the only module imported by A and C and not generated" \
+  test "$(unresolved "$work/a/lean" "$work/c/lean")" = "ChunkC.FunsExternal"
+
+if [ "$failures" -ne 0 ]; then
+  echo "$failures check(s) failed; outputs in $work"
+  exit 1
+fi
+echo "all checks passed"
diff --git a/tests/separate-compilation/external_holes.rs b/tests/separate-compilation/external_holes.rs
new file mode 100644
index 0000000..4f97375
--- /dev/null
+++ b/tests/separate-compilation/external_holes.rs
@@ -0,0 +1,59 @@
+//! Chunks of external-holes.sh (crate `chelis_ir`, so that the native shell
+//! models of `chelis_ir::lowering_runtime` apply). The Funs module imports the
+//! FunsExternal module exactly when the external functions template has holes:
+//! - chunk A owns `double`;
+//! - chunk B calls `double` (opaque in its LLBC, owned by A) and the
+//!   hard-opaque native primitive `scoped` at a state holding a mutable
+//!   borrow: Charon's partial-monomorphization instance `scoped::<'_, Cx<'_>,
+//!   ..>` has no Rust body, but its translation is the model at an extended
+//!   state (ModelStateABI). Nothing is left for the user to write;
+//! - chunk C is B with `bias` opaque as well: an unknown external, the one
+//!   hole of the template.
+
+pub mod lowering_runtime {
+    /// Primitive (hard-opaque). Model: `let t := enter s; let r := body s;
+    /// exit s t; r`.
+    pub(crate) fn scoped<S, T, R>(
+        state: &mut S,
+        enter: impl FnOnce(&mut S) -> T,
+        exit: impl FnOnce(&mut S, T),
+        body: impl FnOnce(&mut S) -> R,
+    ) -> R {
+        let token = enter(state);
+        let result = body(state);
+        exit(state, token);
+        result
+    }
+}
+
+use lowering_runtime::scoped;
+
+// Chunk A
+
+pub fn double(x: u32) -> u32 {
+    x.wrapping_mul(2)
+}
+
+// Chunk B
+
+pub struct Cx<'a> {
+    pub depth: &'a mut u32,
+}
+
+pub fn bias(x: u32) -> u32 {
+    x.wrapping_add(1)
+}
+
+/// `scoped` at the state `Cx<'_>`, which holds a mutable borrow.
+pub fn nested(depth: &mut u32, x: u32) -> u32 {
+    let mut cx = Cx { depth };
+    scoped(
+        &mut cx,
+        |cx| {
+            *cx.depth = cx.depth.wrapping_add(1);
+            *cx.depth
+        },
+        |cx, previous| *cx.depth = previous.wrapping_sub(1),
+        |cx| double(bias(x)).wrapping_add(*cx.depth),
+    )
+}
diff --git a/tests/src/closure-call-kinds.rs b/tests/src/closure-call-kinds.rs
new file mode 100644
index 0000000..e9bcd99
--- /dev/null
+++ b/tests/src/closure-call-kinds.rs
@@ -0,0 +1,195 @@
+//@ [!lean] skip
+//@ [lean] subdir=ClosureCallKinds
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Closures called through each closure trait the way production code passes
+//! them: `FnOnce` by value, `FnMut` by `&mut`, `Fn` by `&`, with captures by
+//! value, by shared borrow and by mutable borrow, and the `FnOnce(&mut Ctx)`
+//! callback of a context helper. The effects on the captured and borrowed
+//! state must be visible after the calls. Each call goes through the model's
+//! `core.ops.function` records (`call_once` returns the consumed state).
+//! `ClosureCallKinds/Checks.lean` evaluates the model on the inputs of the
+//! `native` test module below and compares with the native results.
+
+pub fn run_once<F: FnOnce(u32) -> u32>(f: F, x: u32) -> u32 {
+    f(x)
+}
+
+pub fn run_mut<F: FnMut(u32) -> u32>(f: &mut F, x: u32) -> u32 {
+    let a = f(x);
+    f(a)
+}
+
+pub fn run_ref<F: Fn(u32) -> u32>(f: &F, x: u32) -> u32 {
+    f(x).wrapping_add(f(x))
+}
+
+/// `FnOnce` consuming an owned vector moved into the closure.
+pub fn once_owned(v: Vec<u32>, x: u32) -> u32 {
+    run_once(
+        move |y| {
+            let mut v = v;
+            v.push(y);
+            (v.len() as u32).wrapping_add(y)
+        },
+        x,
+    )
+}
+
+/// `FnOnce` capturing a shared borrow.
+pub fn once_shared(a: &[u32], i: usize, x: u32) -> u32 {
+    run_once(|y| a[i].wrapping_add(y), x)
+}
+
+/// `FnOnce` capturing a mutable borrow: the update is visible after the call.
+pub fn once_mut(start: u32, x: u32) -> (u32, u32) {
+    let mut acc = start;
+    let r = run_once(
+        |y| {
+            acc = acc.wrapping_add(y);
+            acc.wrapping_mul(2)
+        },
+        x,
+    );
+    (r, acc)
+}
+
+/// Closures that are only `FnOnce` (they move a captured vector out) and
+/// capture a mutable borrow: one called through `run_once`, one directly.
+pub fn once_only(v: Vec<u32>, w: Vec<u32>, x: u32) -> (u32, u32, u32) {
+    let mut seen = x;
+    let r1 = run_once(
+        |y| {
+            seen = seen.wrapping_add(y);
+            let v = v;
+            (v.len() as u32).wrapping_add(y)
+        },
+        2,
+    );
+    let f = |y: u32| {
+        seen = seen.wrapping_add(y);
+        let w = w;
+        (w.len() as u32).wrapping_mul(y)
+    };
+    let r2 = f(3);
+    (r1, r2, seen)
+}
+
+/// `FnMut` by `&mut`, capturing a mutable borrow (a call counter) and a value.
+pub fn mut_counter(k: u32, x: u32) -> (u32, u32) {
+    let mut calls = 0u32;
+    let mut f = |y: u32| {
+        calls += 1;
+        y.wrapping_mul(k)
+    };
+    let r = run_mut(&mut f, x);
+    (r, calls)
+}
+
+/// `FnMut` by `&mut` owning its state, called through the helper and then
+/// directly: the second direct call sees the state left by the helper.
+pub fn mut_owned_state(x: u32) -> (u32, u32) {
+    let mut n = 0u32;
+    let mut f = move |y: u32| {
+        n = n.wrapping_add(y);
+        n
+    };
+    let a = run_mut(&mut f, x);
+    let b = f(1);
+    (a, b)
+}
+
+pub struct Cfg {
+    pub scale: u32,
+    pub offset: u32,
+}
+
+/// `Fn` by `&`, capturing a shared borrow of a struct.
+pub fn fn_shared(cfg: &Cfg, x: u32) -> u32 {
+    let f = |y: u32| y.wrapping_mul(cfg.scale).wrapping_add(cfg.offset);
+    run_ref(&f, x)
+}
+
+pub struct Ctx {
+    pub depth: u32,
+    pub log: Vec<u32>,
+}
+
+/// A context helper running a callback on the borrowed context.
+pub fn with_ctx<R, F: FnOnce(&mut Ctx) -> R>(ctx: &mut Ctx, f: F) -> R {
+    ctx.depth = ctx.depth.wrapping_add(1);
+    let r = f(ctx);
+    ctx.depth = ctx.depth.wrapping_sub(1);
+    r
+}
+
+/// `FnOnce(&mut Ctx)` capturing a mutable borrow of a local counter and a
+/// value: both the context and the counter are updated.
+pub fn ctx_callback(x: u32) -> (u32, u32, u32, u32) {
+    let mut ctx = Ctx { depth: 5, log: Vec::new() };
+    let mut seen = 0u32;
+    let r = with_ctx(&mut ctx, |c| {
+        c.log.push(x);
+        seen = seen.wrapping_add(c.depth);
+        c.depth.wrapping_add(x)
+    });
+    (r, ctx.depth, ctx.log.len() as u32, seen)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn once_owned_native() {
+        assert_eq!(once_owned(vec![], 7), 8);
+        assert_eq!(once_owned(vec![1, 2, 3], 10), 14);
+        assert_eq!(once_owned(vec![0], u32::MAX), 1);
+    }
+
+    #[test]
+    fn once_shared_native() {
+        assert_eq!(once_shared(&[4, 5, 6], 1, 10), 15);
+        assert_eq!(once_shared(&[u32::MAX], 0, 2), 1);
+    }
+
+    #[test]
+    fn once_only_native() {
+        assert_eq!(once_only(vec![1, 2], vec![7], 10), (4, 3, 15));
+        assert_eq!(once_only(vec![], vec![], u32::MAX), (2, 0, 4));
+    }
+
+    #[test]
+    fn once_mut_native() {
+        assert_eq!(once_mut(10, 5), (30, 15));
+        assert_eq!(once_mut(u32::MAX, 1), (0, 0));
+        assert_eq!(once_mut(3, 2147483648), (6, 2147483651));
+    }
+
+    #[test]
+    fn mut_counter_native() {
+        assert_eq!(mut_counter(3, 2), (18, 2));
+        assert_eq!(mut_counter(0, 9), (0, 2));
+        assert_eq!(mut_counter(65536, 65536), (0, 2));
+    }
+
+    #[test]
+    fn mut_owned_state_native() {
+        assert_eq!(mut_owned_state(5), (10, 11));
+        assert_eq!(mut_owned_state(0), (0, 1));
+        assert_eq!(mut_owned_state(2147483648), (0, 1));
+    }
+
+    #[test]
+    fn fn_shared_native() {
+        assert_eq!(fn_shared(&Cfg { scale: 3, offset: 1 }, 4), 26);
+        assert_eq!(fn_shared(&Cfg { scale: 0, offset: 7 }, 100), 14);
+        assert_eq!(fn_shared(&Cfg { scale: 2, offset: 0 }, 2147483648), 0);
+    }
+
+    #[test]
+    fn ctx_callback_native() {
+        assert_eq!(ctx_callback(3), (9, 5, 1, 6));
+        assert_eq!(ctx_callback(u32::MAX), (5, 5, 1, 6));
+    }
+}
