diff --git a/tests/src/loop-nested-join.rs b/tests/src/loop-nested-join.rs
index f610ded..2938471 100644
--- a/tests/src/loop-nested-join.rs
+++ b/tests/src/loop-nested-join.rs
@@ -65,6 +65,28 @@ pub fn drive_even(n: u32) -> (u32, u32, u32) {
     (r, calls, t)
 }
 
+/// The caller writes through both the inner borrow and the counter after the
+/// loop (the values given back by the loop are observed)
+pub fn drive_odd_write(n: u32) -> (u32, u32, u32) {
+    let mut t = 7u32;
+    let mut c = Counter { total: &mut t, calls: 2 };
+    let r = bump_odd(&mut c, n);
+    *c.total = (*c.total).wrapping_mul(3);
+    c.calls = c.calls.wrapping_add(50);
+    let calls = c.calls;
+    (r, calls, t)
+}
+
+pub fn drive_even_write(n: u32) -> (u32, u32, u32) {
+    let mut t = 3u32;
+    let mut c = Counter { total: &mut t, calls: 10 };
+    let r = bump_even(&mut c, n);
+    *c.total = (*c.total).wrapping_add(1000);
+    c.calls = c.calls.wrapping_mul(2);
+    let calls = c.calls;
+    (r, calls, t)
+}
+
 #[cfg(test)]
 mod native {
     use super::*;
@@ -77,5 +99,9 @@ mod native {
         println!("{:?}", drive_even(0));
         println!("{:?}", drive_even(1));
         println!("{:?}", drive_even(6));
+        for n in [0u32, 1, 2, 5, 6] {
+            println!("odd_write {} {:?}", n, drive_odd_write(n));
+            println!("even_write {} {:?}", n, drive_even_write(n));
+        }
     }
 }
