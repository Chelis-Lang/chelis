+    let r = bump_n(&mut c, n);
+    *c.total = (*c.total).wrapping_add(100);
+    c.calls = c.calls.wrapping_mul(7);
+    let calls = c.calls;
+    (r, calls, t)
+}
+
 #[cfg(test)]
 mod native {
     use super::*;
@@ -64,5 +76,8 @@ mod native {
         println!("{:?}", drive_n(4));
         println!("{:?}", drive_n_then_write(0));
         println!("{:?}", drive_n_then_write(3));
+        for n in [0u32, 1, 2, 4] {
+            println!("write_both {} {:?}", n, drive_n_write_both(n));
+        }
     }
