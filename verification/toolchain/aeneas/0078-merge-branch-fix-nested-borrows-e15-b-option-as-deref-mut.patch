+//@ [!lean] skip
+//@ [lean] subdir=NestedBorrowsAsDerefMut
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::option::{core::option::Option} --include core::ops::deref::{core::ops::deref::Deref} --include core::ops::deref::{core::ops::deref::DerefMut}
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! `Option::as_deref_mut` on `Option<&'1 mut Frame<'2>>` (the body of `core`,
+//! with `<&mut T as DerefMut>::deref_mut`): three nested levels for the region
+//! of the frame, whose backward function is staged.
+//!
+//! - In the backward function of the region of the frame, the frame given back
+//!   to the reborrow of the payload (the carrier of the value given back
+//!   through the returned reference) is given back by the backward function of
+//!   `deref_mut` for the region of the reborrow, which receives the value given
+//!   back to the ancestor region `'1`: it is not available. The value given
+//!   back through the returned reference stands for it, and the value lent to
+//!   the reborrow is the default of the other variants.
+//! - In the `None` branch, the returned `None` holds no borrow: the return
+//!   abstraction of the region of the frame never ends and gives back `None`.
+//! - Callers: a stage of the backward function of the region of the frame gives
+//!   back, through the returned reference, a value whose positions do not exist
+//!   in the variant the caller got (`None`): the caller ignores it. The frame
+//!   lent to the reborrow, whose fields the caller reborrowed (a shared and a
+//!   mutable one), is given back as a whole.
+
+pub struct Frame<'a> {
+    pub steps: &'a [u32],
+    pub ctx: &'a mut u32,
+    pub pos: usize,
+}
+
+impl<'a> Frame<'a> {
+    pub fn advance(&mut self) -> u32 {
+        let s = self.steps[self.pos];
+        self.pos += 1;
+        *self.ctx = (*self.ctx).wrapping_add(s);
+        s
+    }
+}
+
+/// The frame is used through the reference returned by `as_deref_mut`, then
+/// through the one the caller got back.
+pub fn twice(mut execution: Option<&mut Frame<'_>>) -> u32 {
+    let a = execution.as_deref_mut().unwrap().advance();
+    let b = execution.unwrap().advance();
+    a.wrapping_add(b)
+}
+
+/// Both variants of `as_deref_mut`.
+pub fn advance_or(mut execution: Option<&mut Frame<'_>>, d: u32) -> u32 {
+    match execution.as_deref_mut() {
+        Some(f) => f.advance(),
+        None => d,
+    }
+}
+
+/// Both variants of `as_deref_mut`, then the frame the caller got back.
+pub fn advance_then(mut execution: Option<&mut Frame<'_>>, d: u32) -> u32 {
+    match execution.as_deref_mut() {
+        Some(f) => {
+            let a = f.advance();
+            a.wrapping_add(execution.unwrap().advance())
+        }
+        None => d,
+    }
+}
+
+pub fn run_twice(f: &mut Frame<'_>) -> u32 {
+    twice(Some(f))
+}
+
+pub fn run_advance_or(f: &mut Frame<'_>, some: bool, d: u32) -> u32 {
+    if some {
+        advance_or(Some(f), d)
+    } else {
+        advance_or(None, d)
+    }
+}
+
+pub fn run_advance_then(f: &mut Frame<'_>, d: u32) -> u32 {
+    advance_then(Some(f), d)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    /// `(result, ctx, pos)` after running `run` on a frame over `steps`
+    fn on_frame(
+        steps: &[u32],
+        ctx: u32,
+        pos: usize,
+        run: impl FnOnce(&mut Frame<'_>) -> u32,
+    ) -> (u32, u32, usize) {
+        let mut c = ctx;
+        let mut f = Frame { steps, ctx: &mut c, pos };
+        let r = run(&mut f);
+        let pos = f.pos;
+        (r, c, pos)
+    }
+
+    #[test]
+    fn twice_native() {
+        assert_eq!(on_frame(&[3, 5, 7], 10, 0, |f| twice(Some(f))), (8, 18, 2));
+        assert_eq!(on_frame(&[3, 5, 7], 10, 1, |f| twice(Some(f))), (12, 22, 3));
+        assert_eq!(
+            on_frame(&[3, 5, 7], u32::MAX - 4, 1, |f| twice(Some(f))),
+            (12, 7, 3)
+        );
+        assert_eq!(on_frame(&[3, 5, 7], 10, 0, run_twice), (8, 18, 2));
+        // The caller writes through the frame after `twice`: the region of the
+        // frame gives back the value the caller gives back.
+        assert_eq!(
+            on_frame(&[3, 5, 7], 10, 0, |f| {
+                let r = twice(Some(&mut *f));
+                *f.ctx = 99;
+                r
+            }),
+            (8, 99, 2)
+        );
+        assert_eq!(
+            on_frame(&[3, 5, 7], 10, 1, |f| {
+                let r = run_twice(&mut *f);
+                *f.ctx = 99;
+                r
+            }),
+            (12, 99, 3)
+        );
+    }
+
+    #[test]
+    fn advance_or_native() {
+        assert_eq!(
+            on_frame(&[3, 5, 7], 10, 1, |f| advance_or(Some(f), 100)),
+            (5, 15, 2)
+        );
+        assert_eq!(advance_or(None, 100), 100);
+        assert_eq!(
+            on_frame(&[3, 5, 7], 10, 0, |f| run_advance_or(f, true, 100)),
+            (3, 13, 1)
+        );
+        assert_eq!(
+            on_frame(&[3, 5, 7], 10, 0, |f| run_advance_or(f, false, 100)),
+            (100, 10, 0)
+        );
+        assert_eq!(
+            on_frame(&[3, 5, 7], 10, 1, |f| {
+                let r = run_advance_or(&mut *f, true, 100);
+                *f.ctx = 99;
+                r
+            }),
+            (5, 99, 2)
+        );
+    }
+
+    #[test]
+    fn advance_then_native() {
+        assert_eq!(
+            on_frame(&[3, 5, 7], 10, 0, |f| advance_then(Some(f), 100)),
+            (8, 18, 2)
+        );
+        assert_eq!(
+            on_frame(&[3, 5, 7], u32::MAX - 4, 1, |f| advance_then(Some(f), 100)),
+            (12, 7, 3)
+        );
+        assert_eq!(advance_then(None, 100), 100);
+        assert_eq!(on_frame(&[3, 5, 7], 10, 1, |f| run_advance_then(f, 100)), (12, 22, 3));
+    }
+}
