+/-! ## `chelis_types::native` -/
+
+/-- `chelis_types::native::NativeServices`: the native effects of one checking
+    invocation. Cancellation polls and stack-exhaustion probes are the next
+    elements of oracle observation schedules (`cancel n` / `stack n` is the
+    `n`-th observation; correspondence theorems assume what they need, e.g.
+    monotone cancellation). `depth` is the explicit guarded-frame counter.
+    Profiling marks are an oracle of `usize` values only consumed by
+    `profile_phase`, which has no modeled effect. The constructors `new`,
+    `with_profiling` and `with_grow_segment_bytes_for_test` are shell-only and
+    deliberately unmodeled. -/
+@[rust_type "chelis_types::native::NativeServices" (body := .opaque)]
+structure chelis_types.native.NativeServices where
+  cancel : Nat → Bool
+  cancelTaken : Nat
+  stack : Nat → Bool
+  stackTaken : Nat
+  depth : Usize
+  profileMark : Nat → Usize
+  profileTaken : Nat
+
+namespace chelis_types.native.NativeServices
+
+/-- `cancellation_observed`: the next cancellation observation. -/
+@[rust_fun "chelis_types::native::{chelis_types::native::NativeServices}::cancellation_observed"]
+def cancellation_observed (s : NativeServices) : Result (Bool × NativeServices) :=
+  .ok (s.cancel s.cancelTaken, { s with cancelTaken := s.cancelTaken + 1 })
+
+/-- `stack_exhausted`: the next stack-exhaustion observation. -/
+@[rust_fun "chelis_types::native::{chelis_types::native::NativeServices}::stack_exhausted"]
+def stack_exhausted (s : NativeServices) : Result (Bool × NativeServices) :=
+  .ok (s.stack s.stackTaken, { s with stackTaken := s.stackTaken + 1 })
+
+/-- `enter_frame`: `depth += 1`, failing on overflow like Rust's checked `+=`. -/
+@[rust_fun "chelis_types::native::{chelis_types::native::NativeServices}::enter_frame"]
+def enter_frame (s : NativeServices) : Result NativeServices := do
+  let depth ← s.depth + 1#usize
+  .ok { s with depth }
+
+/-- `exit_frame`: `depth := depth.saturating_sub(1)`. -/
+@[rust_fun "chelis_types::native::{chelis_types::native::NativeServices}::exit_frame"]
+def exit_frame (s : NativeServices) : Result NativeServices :=
+  .ok { s with depth := UScalar.saturating_sub s.depth 1#usize }
+
+/-- `reset_frames`: `depth := 0`. -/
+@[rust_fun "chelis_types::native::{chelis_types::native::NativeServices}::reset_frames"]
+def reset_frames (s : NativeServices) : Result NativeServices :=
+  .ok { s with depth := 0#usize }
+
+/-- `profile_start`: the next oracle mark. -/
+@[rust_fun "chelis_types::native::{chelis_types::native::NativeServices}::profile_start"]
+def profile_start (s : NativeServices) : Result (Usize × NativeServices) :=
+  .ok (s.profileMark s.profileTaken, { s with profileTaken := s.profileTaken + 1 })
+
+/-- `profile_phase`: no modeled effect (stderr timing only). -/
+@[rust_fun "chelis_types::native::{chelis_types::native::NativeServices}::profile_phase"]
+def profile_phase (s : NativeServices) (_mark : Usize) (_scope _label : Str) :
+    Result NativeServices :=
+  .ok s
+
+/-- `with_grown_stack`: `f self`. The fresh native stack segment is not
+    observable (a failed segment allocation aborts the process, like any
+    allocation failure). `F : FnOnce(&mut Self) -> R` is Charon's
+    `FnOnce<(&mut NativeServices,)>` specialization: the call returns the
+    closure's value and the services it was lent. -/
+@[rust_fun "chelis_types::native::{chelis_types::native::NativeServices}::with_grown_stack"]
+def with_grown_stack {R F : Type}
+    (fnInst : core.ops.function.FnOnceMutArg F NativeServices R)
+    (s : NativeServices) (f : F) : Result (R × NativeServices) :=
+  fnInst.call_once f s
+
+end chelis_types.native.NativeServices
+
+/-- `chelis_types::native::sha256_concat`: FIPS 180-4 SHA-256 of the
+    concatenated parts (`ChelisModels.Sha256.digest`). -/
+@[rust_fun "chelis_types::native::sha256_concat"]
+def chelis_types.native.sha256_concat (parts : Slice (Slice U8)) : Result (Array U8 32#usize) :=
+  let msg := parts.val.flatMap fun part => part.val.map fun b => UInt8.ofBitVec b.bv
+  let bytes := (ChelisModels.Sha256.digest msg).map fun b => (⟨b.toBitVec⟩ : U8)
+  .ok ⟨bytes, by simp [bytes, ChelisModels.Sha256.digest_length]⟩
+
 end Aeneas.Std
