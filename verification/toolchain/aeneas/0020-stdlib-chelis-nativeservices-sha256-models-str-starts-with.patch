+/-- `core::str::pattern::StrSearcher<'a, 'b>`, the searcher of a `&str` needle.
+    Only its construction data are modeled; its search steps are not, so an
+    extracted call to them is an unknown external. -/
+@[rust_type "core::str::pattern::StrSearcher" (body := .opaque)]
+structure core.str.pattern.StrSearcher where
+  haystack : Str
+  needle : Str
+
+/-- `core::str::pattern::Pattern`, through its provided `is_prefix_of`
+    (the only method `str::starts_with` uses). -/
+@[rust_trait "core::str::pattern::Pattern"]
+structure core.str.pattern.Pattern (Self : Type) where
+  is_prefix_of : Self → Str → Result Bool
+
+/-- `impl Pattern for &str`, pattern.rs: `haystack.as_bytes().starts_with(self.as_bytes())`,
+    a prefix test on the UTF-8 bytes. -/
+@[rust_fun "core::str::pattern::{core::str::pattern::Pattern<&'b str>}::is_prefix_of"]
+def core.str.pattern.PatternSharedStr.is_prefix_of (needle haystack : Str) : Result Bool :=
+  .ok (needle.val.isPrefixOf haystack.val)
+
+@[reducible, rust_trait_impl "core::str::pattern::Pattern<&'b str>"]
+def core.str.pattern.PatternSharedStr : core.str.pattern.Pattern Str := {
+  is_prefix_of := core.str.pattern.PatternSharedStr.is_prefix_of
+}
+
+/-- `str::starts_with`, str/mod.rs: `pat.is_prefix_of(self)`. -/
+@[rust_fun "core::str::{str}::starts_with"]
+def core.str.Str.starts_with {P : Type} (patInst : core.str.pattern.Pattern P)
+    (s : Str) (pat : P) : Result Bool :=
