+            :: rest -> (
+              (* The indexing call may follow storage markers *)
+              let rec split lives = function
+                | ({ kind = StorageLive id; _ } as st) :: rest when id <> borrow
+                  -> split (st :: lives) rest
+                | st1 :: rest -> Some (List.rev lives, st1, rest)
+                | [] -> None
+              in
+              match (rv, split [] rest) with
+              | RvRef (_, BShared, _), Some (lives, st1, rest') -> (
+                  match shared_index st1 with
+                  | Some (builtin, generics, borrow', idx, result, ty)
+                    when borrow = borrow' ->
+                      let key = (rv, builtin, generics, idx) in
+                      let written =
+                        List.fold_left
+                          (fun w st -> LocalId.Set.union w (written st))
+                          LocalId.Set.empty
+                          ((st0 :: lives) @ [ st1 ])
+                      in
+                      let avail = List.filter (valid written) avail in
+                      let previous =
+                        List.find_opt (fun (key', _, _) -> key' = key) avail
+                      in
+                      let sts, avail =
+                        match previous with
+                        | Some (_, _, previous) ->
+                            (* The previous result is still valid after these
+                               statements, which write [result] *)
+                            let copy =
+                              {
+                                st1 with
+                                kind =
+                                  Assign
+                                    ( { kind = PlaceLocal result; ty },
+                                      Use
+                                        (Copy { kind = PlaceLocal previous; ty })
+                                    );
+                                comments_before =
+                                  st0.comments_before @ st1.comments_before;
+                              }
+                            in
+                            (lives @ [ copy ], avail)
+                        | None ->
+                            let locals = key_locals (rv, idx) in
+                            ( (st0 :: lives) @ [ st1 ],
+                              (key, locals, result) :: avail )
+                      in
+                      sts @ go avail rest'
+                  | _ -> statement avail st0 rest)
+              | _ -> statement avail st0 rest)
+          | st :: rest -> statement avail st rest
+          | [] -> []
