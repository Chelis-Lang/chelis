+(** Share repeated shared indexings of an unchanged place.
+
+    A slice pattern such as [[A(B(x)), C(y), rest @ ..]] tests the variant of
+    each element, then reads the tested elements again through fresh
+    constant-index projections. Charon lowers every such projection to its own
+    builtin call ([@SliceIndexShared], [@ArrayIndexShared]) on a fresh shared
+    borrow of the indexed place, so the symbolic interpreter sees unrelated
+    element references: projecting through the variant tested on the first
+    reference then requires expanding the second one without branching, which
+    fails ("Not allowed to expand enumerations with several variants").
+
+    A shared indexing is a pure function of the indexed place and the index:
+    while the indexed place, the index and the first result are unchanged, a
+    second shared indexing with the same arguments returns the same element
+    reference (and cannot fail, since the first one did not). Replace it with a
+    copy of the first result, which is the MIR semantics of the projection.
+
+    A result is available in the statements which follow it in its block,
+    including nested blocks, until a statement may write one of the locals it
+    depends on (assignment, move, mutable or raw borrow, storage marker, drop).
+    After a branching, a result survives only if no branch writes those locals;
+    in a loop body, only if the loop body does not write them. *)
+let share_repeated_shared_indexing (_crate : crate) (f : fun_decl) : fun_decl =
+  let rec root (p : place) : LocalId.id option =
+    match p.kind with
+    | PlaceLocal id -> Some id
+    | PlaceProjection (p, _) -> root p
+    | PlaceGlobal _ -> None
+  in
+  (* The locals a statement (with its nested blocks) may write *)
+  let written (st : statement) : LocalId.Set.t =
+    let set = ref LocalId.Set.empty in
+    let add (p : place) =
+      Option.iter (fun id -> set := LocalId.Set.add id !set) (root p)
+    in
+    let visitor =
+      object
+        inherit [_] iter_statement as super
+
+        method! visit_statement env st =
+          (match st.kind with
+          | Assign (p, _) | SetDiscriminant (p, _) | Drop (p, _, _) -> add p
+          | Call call -> add call.dest
+          | StorageLive id | StorageDead id -> set := LocalId.Set.add id !set
+          | _ -> ());
+          super#visit_statement env st
+
+        method! visit_operand env op =
+          (match op with
+          | Move p -> add p
+          | _ -> ());
+          super#visit_operand env op
+
+        method! visit_rvalue env rv =
+          (match rv with
+          | RvRef (_, BShared, _) -> ()
+          | RvRef (p, _, _) | RawPtr (p, _, _) -> add p
+          | _ -> ());
+          super#visit_rvalue env rv
+      end
+    in
+    visitor#visit_statement () st;
+    !set
+  in
+  (* The locals read by an indexing key: the borrow of the indexed place and
+     the index *)
+  let key_locals (rv, idx) : LocalId.Set.t =
+    let set = ref LocalId.Set.empty in
+    let visitor =
+      object
+        inherit [_] iter_statement
+        method! visit_local_id _ id = set := LocalId.Set.add id !set
+      end
+    in
+    visitor#visit_rvalue () rv;
+    visitor#visit_operand () idx;
+    !set
+  in
+  (* An available result: the key (borrow rvalue, builtin, generics, index),
+     its locals, and the local holding the result *)
+  let valid written (key, locals, result) =
+    ignore key;
+    (not (LocalId.Set.mem result written))
+    && LocalId.Set.disjoint locals written
+  in
+  let shared_index (st : statement) =
+    match st.kind with
+    | Call
