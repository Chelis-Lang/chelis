+//@ [!lean] skip
+//@ [lean] subdir=SlicePatterns
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Slice patterns over borrowed slices whose elements are enumerations: the
+//! variants of the matched elements are tested, then the elements (and their
+//! nested fields) are read again, and the rest of the slice is bound.
+//! `SlicePatterns/Checks.lean` evaluates the model on the inputs of the
+//! `native` test module below and compares with the native results.
+
+pub enum Atom {
+    Tag(u32),
+    Name(u32),
+}
+
+pub enum Expr {
+    Atom(Atom, u32),
+    Map(u32, u32),
+    Pair(u32, u32),
+}
+
+/// A view borrowing parts of the matched slice.
+pub enum Carrier<'a> {
+    Decoded(u32, &'a u32, &'a [Expr]),
+    Undecodable(&'a u32, &'a u32, &'a [Expr]),
+    Malformed(&'a [Expr]),
+}
+
+/// The shape of `chelis_deep::ast::Expr::carrier`: nested variants tested on
+/// two elements, the rest bound as a subslice (possibly empty).
+pub fn carrier(elements: &[Expr]) -> Carrier<'_> {
+    match elements {
+        [Expr::Atom(Atom::Tag(tag), _), Expr::Map(m, _), children @ ..] => {
+            Carrier::Decoded(*tag, m, children)
+        }
+        [Expr::Atom(Atom::Name(head), _), Expr::Map(m, _), children @ ..] => {
+            Carrier::Undecodable(head, m, children)
+        }
+        _ => Carrier::Malformed(elements),
+    }
+}
+
+/// A numeric summary of the view, reading through the borrowed parts.
+pub fn summary(elements: &[Expr]) -> u32 {
+    match carrier(elements) {
+        Carrier::Decoded(tag, m, children) => 10000 + tag * 100 + *m * 10 + children.len() as u32,
+        Carrier::Undecodable(head, m, children) => {
+            20000 + *head * 100 + *m * 10 + children.len() as u32
+        }
+        Carrier::Malformed(all) => 30000 + all.len() as u32,
+    }
+}
+
+/// The first element of the rest, when it is a tagged atom.
+pub fn first_child_tag(elements: &[Expr]) -> u32 {
+    match carrier(elements) {
+        Carrier::Decoded(_, _, children) => match children {
+            [Expr::Atom(Atom::Tag(t), _), ..] => *t,
+            _ => 1,
+        },
+        _ => 0,
+    }
+}
+
+/// A loop over the rest of the slice.
+pub fn count_tags(elements: &[Expr]) -> u32 {
+    match elements {
+        [Expr::Atom(Atom::Tag(_), _), Expr::Map(_, _), children @ ..] => {
+            let mut count = 0;
+            let mut i = 0;
+            while i < children.len() {
+                if let Expr::Atom(Atom::Tag(t), _) = &children[i] {
+                    count += *t;
+                }
+                i += 1;
+            }
+            count
+        }
+        _ => 0,
+    }
+}
+
+/// A fixed-size array pattern testing nested variants of two elements.
+pub fn array_pattern(a: &[Expr; 3]) -> u32 {
+    match a {
+        [Expr::Atom(Atom::Tag(t), s), Expr::Map(m, _), _] => *t + *s + *m,
+        [Expr::Atom(Atom::Name(n), _), _, Expr::Atom(Atom::Tag(t), _)] => *n * 2 + *t,
+        _ => 7,
+    }
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    fn tag(t: u32) -> Expr {
+        Expr::Atom(Atom::Tag(t), 0)
+    }
+    fn name(n: u32) -> Expr {
+        Expr::Atom(Atom::Name(n), 0)
+    }
+    fn map(m: u32) -> Expr {
+        Expr::Map(m, 0)
+    }
+
+    #[test]
+    fn summaries() {
+        assert_eq!(summary(&[tag(3), map(4)]), 10340);
+        assert_eq!(summary(&[tag(3), map(4), tag(1), name(2)]), 10342);
+        assert_eq!(summary(&[name(5), map(6), map(1)]), 20561);
+        assert_eq!(summary(&[tag(3)]), 30001);
+        assert_eq!(summary(&[]), 30000);
+        assert_eq!(summary(&[map(1), map(2)]), 30002);
+        assert_eq!(summary(&[tag(3), name(4)]), 30002);
+        assert_eq!(summary(&[Expr::Pair(1, 2), map(4)]), 30002);
+    }
+
+    #[test]
+    fn first_child_tags() {
+        assert_eq!(first_child_tag(&[tag(3), map(4), tag(9)]), 9);
+        assert_eq!(first_child_tag(&[tag(3), map(4), name(9)]), 1);
+        assert_eq!(first_child_tag(&[tag(3), map(4)]), 1);
+        assert_eq!(first_child_tag(&[name(3), map(4), tag(9)]), 0);
+    }
+
+    #[test]
+    fn counts() {
+        assert_eq!(count_tags(&[tag(1), map(0)]), 0);
+        assert_eq!(count_tags(&[tag(1), map(0), tag(2), name(5), tag(3)]), 5);
+        assert_eq!(count_tags(&[map(0), tag(1), tag(2)]), 0);
+        assert_eq!(count_tags(&[]), 0);
+    }
+
+    #[test]
+    fn arrays() {
+        assert_eq!(array_pattern(&[Expr::Atom(Atom::Tag(2), 3), map(4), tag(0)]), 9);
+        assert_eq!(array_pattern(&[name(5), map(4), tag(1)]), 11);
+        assert_eq!(array_pattern(&[name(5), map(4), name(1)]), 7);
+        assert_eq!(array_pattern(&[map(5), map(4), tag(1)]), 7);
+    }
+}
