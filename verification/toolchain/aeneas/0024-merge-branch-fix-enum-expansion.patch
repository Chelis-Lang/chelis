+import SlicePatterns.SlicePatterns
+
+/-! Evaluate the model of `tests/src/slice-patterns.rs` on the inputs of its
+    `native` test module and compare with the native results. -/
+
+namespace slice_patterns.checks
+open Aeneas Aeneas.Std Result
+
+def u (n : Nat) : U32 := ⟨BitVec.ofNat _ n⟩
+
+def tag (t : Nat) : Expr := .Atom (.Tag (u t)) (u 0)
+def nm (n : Nat) : Expr := .Atom (.Name (u n)) (u 0)
+def map (m : Nat) : Expr := .Map (u m) (u 0)
+
+def sl (xs : List Expr) (h : xs.length ≤ Usize.max := by simp; try scalar_tac) : Slice Expr :=
+  ⟨xs, h⟩
+
+def arr (x y z : Expr) : Array Expr 3#usize := ⟨[x, y, z], by simp⟩
+
+def res (r : Result U32) : Option Nat :=
+  match r with
+  | ok v => some v.val
+  | _ => none
+
+-- summaries
+#guard res (summary (sl [tag 3, map 4])) == some 10340
+#guard res (summary (sl [tag 3, map 4, tag 1, nm 2])) == some 10342
+#guard res (summary (sl [nm 5, map 6, map 1])) == some 20561
+#guard res (summary (sl [tag 3])) == some 30001
+#guard res (summary (sl [])) == some 30000
+#guard res (summary (sl [map 1, map 2])) == some 30002
+#guard res (summary (sl [tag 3, nm 4])) == some 30002
+#guard res (summary (sl [.Pair (u 1) (u 2), map 4])) == some 30002
+
+-- first_child_tags
+#guard res (first_child_tag (sl [tag 3, map 4, tag 9])) == some 9
+#guard res (first_child_tag (sl [tag 3, map 4, nm 9])) == some 1
+#guard res (first_child_tag (sl [tag 3, map 4])) == some 1
+#guard res (first_child_tag (sl [nm 3, map 4, tag 9])) == some 0
+
+-- counts
+#guard res (count_tags (sl [tag 1, map 0])) == some 0
+#guard res (count_tags (sl [tag 1, map 0, tag 2, nm 5, tag 3])) == some 5
+#guard res (count_tags (sl [map 0, tag 1, tag 2])) == some 0
+#guard res (count_tags (sl [])) == some 0
+
+-- arrays
+#guard res (array_pattern (arr (.Atom (.Tag (u 2)) (u 3)) (map 4) (tag 0))) == some 9
+#guard res (array_pattern (arr (nm 5) (map 4) (tag 1))) == some 11
+#guard res (array_pattern (arr (nm 5) (map 4) (nm 1))) == some 7
+#guard res (array_pattern (arr (map 5) (map 4) (tag 1))) == some 7
+
+end slice_patterns.checks
