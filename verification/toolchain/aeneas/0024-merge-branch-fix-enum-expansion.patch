+/-- The shared subslice `s[start..end_]` (builtin `@SliceSubSliceShared`, which
+    Charon generates for range projections such as the rest `rest @ ..` of a
+    slice pattern). As in Rust, the subslice may be empty (`start = end_`). -/
+def Slice.subslice_shared {α : Type u} (s : Slice α) (start end_ : Usize) : Result (Slice α) :=
+  if start.val ≤ end_.val ∧ end_.val ≤ s.length then
+    ok ⟨ s.val.slice start.val end_.val,
+          by
+            have := s.val.slice_length_le start.val end_.val
+            scalar_tac ⟩
+  else
+    fail panic
+
+@[step]
+theorem Slice.subslice_shared_spec {α : Type u} (s : Slice α) (start end_ : Usize)
+  (h0 : start.val ≤ end_.val) (h1 : end_.val ≤ s.val.length) :
+  subslice_shared s start end_ ⦃ ns => ns.val = s.val.slice start.val end_.val ⦄ := by
+  simp_all only [subslice_shared, length, and_self, ite_true, spec_ok]
+
