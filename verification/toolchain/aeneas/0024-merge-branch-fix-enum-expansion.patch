+            | Switch switch ->
+                (* A branch runs from the switch: its scan invalidates the
+                   results it writes from the writing statement on *)
+                let inner = avail in
+                let switch =
+                  match switch with
+                  | If (op, b0, b1) -> If (op, block inner b0, block inner b1)
+                  | SwitchInt (op, ty, branches, otherwise) ->
+                      SwitchInt
+                        ( op,
+                          ty,
+                          List.map (fun (v, b) -> (v, block inner b)) branches,
+                          block inner otherwise )
+                  | Match (p, branches, otherwise) ->
+                      Match
+                        ( p,
+                          List.map (fun (v, b) -> (v, block inner b)) branches,
+                          Option.map (block inner) otherwise )
+                in
+                { st with kind = Switch switch }
+            | Loop b ->
+                (* Every iteration may follow a write of the loop body *)
+                {
+                  st with
+                  kind = Loop (block (List.filter (valid written) avail) b);
+                }
+            | _ -> st
+          in
+          st :: go (List.filter (valid written) avail) rest
+        in
