+(** Nested borrows: the values given back by the mutable borrows of an
+    abstraction which end at [abs_level] below one of its ignored shared loans.
+
+    Such borrows are frozen: e.g., [Option::as_ref] on
+    [Option<&'1 mut Frame<'2>>] where [Frame<'2>] holds a [&'2 mut u32] returns
+    [Option<&'0 &'1 mut Frame<'2>>]; the abstraction of ['2] of the call holds,
+    below the shared loan of ['0], the frame given back to ['1] (at level 1),
+    whose field is a borrow of ['2] of the call. Ending this borrow gives its
+    value back to the loan of the same abstraction at level 0: the callee gives
+    nothing back for the frozen positions (see [aloan_content_to_given_back_aux]
+    and [SymbolicToPureTypes.translate_back_ty_aux]), and the value is the
+    original value of the borrow, which nothing can have updated below the
+    shared borrow ([bs_ctx.mut_borrow_to_original]). We bind the values given
+    back which are not bound yet to these original values. *)
+let abs_frozen_given_back_bindings (ctx : bs_ctx) (abs : V.abs)
+    (abs_level : abs_level) : bs_ctx * (tpat * texpr) list =
+  let found = ref [] in
+  let visitor =
+    object
+      inherit [_] InterpBorrowsCore.iter_tavalue_with_levels as super
+      method incr_level (level, frozen) = (level + 1, frozen)
+
+      method! visit_AIgnoredSharedLoan (level, _) child =
+        super#visit_AIgnoredSharedLoan (level, true) child
+
+      method! visit_AEndedMutBorrow ((level, frozen) as state) meta child =
+        if frozen && level = abs_level then found := meta :: !found;
+        super#visit_AEndedMutBorrow state meta child
+    end
+  in
+  List.iter (visitor#visit_tavalue (0, false)) abs.avalues;
+  List.fold_left_map
+    (fun ctx (meta : V.aended_mut_borrow_meta) ->
+      let sv = meta.given_back in
+      if V.SymbolicValueId.Map.mem sv.sv_id ctx.sv_to_var then (ctx, None)
+      else
+        let original =
+          [%unwrap_with_span] ctx.span
+            (V.BorrowId.Map.find_opt meta.bid ctx.mut_borrow_to_original)
+            "Nested borrows: a mutable borrow frozen below a shared borrow of \
+             a region abstraction was not introduced by the expansion of a \
+             symbolic mutable reference: its original value is unknown"
+        in
+        let ctx, var = fresh_var_for_symbolic_value sv ctx in
+        [%cassert] ctx.span (var.ty = original.ty)
+          "Nested borrows: the value given back by a frozen mutable borrow \
+           disagrees with its original value";
+        (ctx, Some (mk_tpat_from_fvar None var, original)))
+    ctx (List.rev !found)
+  |> fun (ctx, bindings) -> (ctx, List.filter_map Fun.id bindings)
