+//@ [!lean] skip
+//@ [lean] subdir=FrozenNestedRegion
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::option::{core::option::Option}
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! A shared borrow of a mutable borrow of a struct which holds a mutable
+//! borrow itself, as `Option::as_ref` on the `Option<&mut ExecutionFrame<'_>>`
+//! of `chelis_ir::eval` (`ExecutionFrame` holds `context: &mut _`):
+//! `Option<&'a &'b mut Frame<'c>>`. The regions `'b` and `'c` are frozen below
+//! `'a`: their backward functions receive the final value of the frame
+//! (unchanged) and give nothing back, at every level.
+//! `FrozenNestedRegion/Checks.lean` evaluates the model on the inputs of the
+//! `native` test module below and compares with the native results.
+
+pub struct Frame<'a> {
+    steps: &'a [u32],
+    ctx: &'a mut u32,
+    pos: usize,
+}
+
+impl Frame<'_> {
+    pub fn steps(&self) -> &[u32] {
+        self.steps
+    }
+}
+
+/// The callee: a shared borrow of the payload
+pub fn first<'a, 'b, 'c>(o: &'a Option<&'b mut Frame<'c>>) -> Option<&'a &'b mut Frame<'c>> {
+    if let Some(f) = o { Some(f) } else { None }
+}
+
+/// The caller: read through the frozen borrows
+pub fn first_step(execution: &Option<&mut Frame<'_>>) -> u32 {
+    match first(execution) {
+        Some(frame) => frame.steps[frame.pos] + *frame.ctx,
+        None => 0,
+    }
+}
+
+/// `Option::as_ref`, reading through a method which takes `&self` (as
+/// `frame.steps()` in `eval_tensor_internal_with_result_claims`)
+pub fn first_step_as_ref(execution: &Option<&mut Frame<'_>>) -> u32 {
+    match execution.as_ref() {
+        Some(frame) => frame.steps()[frame.pos] + *frame.ctx,
+        None => 0,
+    }
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn frames() {
+        let steps = [3, 5, 7];
+        let mut ctx = 1;
+        let mut frame = Frame { steps: &steps, ctx: &mut ctx, pos: 1 };
+        assert_eq!(first_step(&Some(&mut frame)), 6);
+        assert_eq!(first_step(&None), 0);
+        assert_eq!(first_step_as_ref(&Some(&mut frame)), 6);
+        assert_eq!(first_step_as_ref(&None), 0);
+        frame.pos = 2;
+        assert_eq!(first_step_as_ref(&Some(&mut frame)), 8);
+        assert_eq!(first_step(&Some(&mut frame)), 8);
+    }
