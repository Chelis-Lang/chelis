+import FrozenNestedRegion.FrozenNestedRegion
+
+/-! Evaluate the model of `tests/src/frozen-nested-region.rs` on the inputs of
+    its `native` test module and compare with the native results. -/
+
+namespace frozen_nested_region.checks
+open Aeneas Aeneas.Std Result
+
+def u (n : Nat) : U32 := ⟨BitVec.ofNat _ n⟩
+
+def steps : Slice U32 := ⟨[u 3, u 5, u 7], by simp; scalar_tac⟩
+
+def frame (pos : Nat) : Frame := { steps, ctx := u 1, pos := ⟨BitVec.ofNat _ pos⟩ }
+
+def val (r : Result U32) : Option Nat :=
+  match r with
+  | ok v => some v.val
+  | _ => none
+
+#guard val (first_step (some (frame 1))) == some 6
+#guard val (first_step none) == some 0
+#guard val (first_step_as_ref (some (frame 1))) == some 6
+#guard val (first_step_as_ref none) == some 0
+#guard val (first_step_as_ref (some (frame 2))) == some 8
+#guard val (first_step (some (frame 2))) == some 8
+
+end frozen_nested_region.checks
