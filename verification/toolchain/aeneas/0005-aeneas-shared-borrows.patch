+let compare_norm_proj_tys span ctx default combine compare_selected
+    (ty1 : norm_proj_ty) (ty2 : norm_proj_ty) : bool =
+  let selected = function
+    | RVar (Free rid) ->
+        [%sanity_check] span (rid = RegionId.zero);
+        true
+    | RErased -> false
+    | RStatic | RVar (Bound _) | RBody _ -> [%internal_error] span
+  in
+  (* Traverse both masks together, including dictionaries. A static or bound
+     region is not an owned position, but its identity is part of the shape. *)
+  let compare_regions r1 r2 =
+    match (r1, r2) with
+    | (RVar (Free _) | RErased), (RVar (Free _) | RErased) ->
+        compare_selected (selected r1) (selected r2)
+    | RStatic, RStatic -> compare_selected false false
+    | RVar (Bound (db1, var1)), RVar (Bound (db2, var2)) ->
+        [%sanity_check] span (db1 = db2 && var1 = var2);
+        compare_selected false false
+    | _ -> [%internal_error] span
+  in
+  let compare_list compare xs ys =
