+                          { sv_id = value.sv_id; sv_ty = value.proj_ty } )
+                      :: !projected)
+                  consumed
+            | _ -> ())
+          () aproj ty
+    end
+  in
+  List.iter
+    (fun (av : V.tavalue) -> visitor#visit_tavalue (0, av.ty) av)
+    abs.avalues;
+  updates @ List.rev !projected
+
+(** Descendant reborrow bindings are not additional declared callee outputs. *)
+let abs_nested_given_back_bindings (ctx : bs_ctx) (ectx : C.eval_ctx)
+    (abs : V.abs) (abs_level : abs_level) : (tpat * texpr) list =
+  let updates = abs_nested_current_updates ctx ectx abs abs_level in
+  let bindings = ref FVarId.Map.empty in
+  let visitor =
+    object
+      inherit [_] InterpBorrowsCore.iter_tavalue_with_levels as super
+      method incr_level (level, ty) = (level + 1, ty)
+
+      method! visit_tavalue (level, _) av =
+        super#visit_tavalue (level, av.ty) av
+
+      method! visit_aproj (level, ty) aproj =
+        fold_aproj_at_level abs_level level
+          (fun () aproj _ ->
+            match aproj with
+            | V.AEndedProjBorrows { mvalues; _ }
+              when TypesUtils.ty_has_mut_borrow_for_region_in_set
+                     ctx.type_ctx.type_infos abs.regions.owned
+                     mvalues.given_back.sv_ty ->
+                let var =
+                  [%unwrap_with_span] ctx.span
+                    (lookup_var_for_symbolic_value mvalues.given_back.sv_id ctx)
+                    "Nested giveback variable was not introduced"
+                in
+                let carrier =
+                  symbolic_value_to_texpr ctx
+                    {
+                      sv_id = mvalues.consumed;
+                      sv_ty = mvalues.given_back.sv_ty;
+                    }
+                in
+                let value =
+                  [%unwrap_with_span] ctx.span
+                    (recombine_nested_projection_exprs ctx.span ctx.decls_ctx
+                       abs.regions.owned mvalues.given_back.sv_ty carrier
+                       updates ctx.fresh_fvar_id)
+                    "Nested reborrow has no authoritative current update"
+                in
+                [%sanity_check] ctx.span (not (FVarId.Map.mem var.id !bindings));
+                bindings :=
+                  FVarId.Map.add var.id
+                    (mk_tpat_from_fvar None var, value)
+                    !bindings
+            | _ -> ())
+          () aproj ty
+    end
+  in
+  List.iter
+    (fun (av : V.tavalue) -> visitor#visit_tavalue (0, av.ty) av)
+    abs.avalues;
+  FVarId.Map.values !bindings
+
 (** Simply calls [abs_to_given_back] *)
