@@ -0,0 +1,410 @@
+//@ [!lean] skip
+//@ [lean] subdir=NestedCollections
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Types which are recursive through collections. Lean rejects `Vec<Self>`,
+//! `Box<[Self]>` and `[Box<Self>; N]` in an inductive (their invariant mentions the
+//! elements), so the Lean backend stores those fields in nested carriers and
+//! converts at every use of the fields. Also covered: `Vec<(String, Self)>`,
+//! `Vec<Vec<Self>>`, `Option<Box<Self>>`, a mutual group through `BTreeMap`
+//! and `Option`, and a generic wrapper whose `Vec<T>` field is instantiated
+//! with a type of a recursive group.
+//! `NestedCollections/Checks.lean` evaluates the model on the inputs of the
+//! `native` test module below and compares with the native results.
+
+use std::collections::BTreeMap;
+
+pub enum Tree {
+    Leaf(u32),
+    Node(Vec<Tree>),
+    Named(Vec<(String, Tree)>),
+    Boxed(Box<[Tree]>),
+    Pair([Box<Tree>; 2]),
+    Opt(Option<Box<Tree>>),
+    Grid(Vec<Vec<Tree>>),
+}
+
+pub fn leaf(n: u32) -> Tree {
+    Tree::Leaf(n)
+}
+
+pub fn node(children: Vec<Tree>) -> Tree {
+    Tree::Node(children)
+}
+
+pub fn node2(a: Tree, b: Tree) -> Tree {
+    let mut children = Vec::new();
+    children.push(a);
+    children.push(b);
+    Tree::Node(children)
+}
+
+pub fn named(name: String, t: Tree) -> Tree {
+    let mut entries = Vec::new();
+    entries.push((name, t));
+    Tree::Named(entries)
+}
+
+pub fn boxed(children: Vec<Tree>) -> Tree {
+    Tree::Boxed(children.into_boxed_slice())
+}
+
+pub fn pair(a: Tree, b: Tree) -> Tree {
+    Tree::Pair([Box::new(a), Box::new(b)])
+}
+
+pub fn opt(t: Option<Tree>) -> Tree {
+    match t {
+        Some(t) => Tree::Opt(Some(Box::new(t))),
+        None => Tree::Opt(None),
+    }
+}
+
+pub fn grid(row: Vec<Tree>) -> Tree {
+    let mut rows = Vec::new();
+    rows.push(row);
+    Tree::Grid(rows)
+}
+
+pub fn sum_slice(ts: &[Tree]) -> u32 {
+    let mut s = 0u32;
+    let mut i = 0;
+    while i < ts.len() {
+        s = s.wrapping_add(sum(&ts[i]));
+        i += 1;
+    }
+    s
+}
+
+pub fn sum(t: &Tree) -> u32 {
+    match t {
+        Tree::Leaf(n) => *n,
+        Tree::Node(children) => sum_slice(children),
+        Tree::Named(entries) => {
+            let mut s = 0u32;
+            for (_, t) in entries.iter() {
+                s = s.wrapping_add(sum(t));
+            }
+            s
+        }
+        Tree::Boxed(children) => sum_slice(children),
+        Tree::Pair(ts) => sum(&ts[0]).wrapping_add(sum(&ts[1])),
+        Tree::Opt(Some(t)) => sum(t),
+        Tree::Opt(None) => 0,
+        Tree::Grid(rows) => {
+            let mut s = 0u32;
+            let mut i = 0;
+            while i < rows.len() {
+                s = s.wrapping_add(sum_slice(&rows[i]));
+                i += 1;
+            }
+            s
+        }
+    }
+}
+
+/// Number of direct children
+pub fn width(t: &Tree) -> usize {
+    match t {
+        Tree::Node(children) => children.len(),
+        Tree::Named(entries) => entries.len(),
+        Tree::Boxed(children) => children.len(),
+        Tree::Pair(_) => 2,
+        Tree::Opt(o) => {
+            if o.is_some() {
+                1
+            } else {
+                0
+            }
+        }
+        Tree::Grid(rows) => rows.len(),
+        Tree::Leaf(_) => 0,
+    }
+}
+
+pub fn push_child(t: &mut Tree, c: Tree) -> bool {
+    match t {
+        Tree::Node(children) => {
+            children.push(c);
+            true
+        }
+        _ => false,
+    }
+}
+
+pub fn pop_child(t: &mut Tree) -> Option<Tree> {
+    match t {
+        Tree::Node(children) => children.pop(),
+        _ => None,
+    }
+}
+
+pub fn set_leaf(t: &mut Tree, i: usize, n: u32) {
+    match t {
+        Tree::Node(children) => children[i] = Tree::Leaf(n),
+        Tree::Pair(ts) => ts[i] = Box::new(Tree::Leaf(n)),
+        _ => {}
+    }
+}
+
+/// Recursive update through the collections
+pub fn bump(t: &mut Tree) {
+    match t {
+        Tree::Leaf(n) => *n = n.wrapping_add(1),
+        Tree::Node(children) => {
+            let mut i = 0;
+            while i < children.len() {
+                bump(&mut children[i]);
+                i += 1;
+            }
+        }
+        Tree::Pair(ts) => {
+            bump(&mut ts[0]);
+            bump(&mut ts[1]);
+        }
+        _ => {}
+    }
+}
+
+/// Mutual group through `Vec`, `Option` and `BTreeMap`
+pub enum Expr {
+    Int(i64),
+    List(Vec<Expr>, Metadata),
+    Call(String, Vec<Expr>),
+}
+
+pub struct Metadata {
+    pub storage: Option<Storage>,
+    pub line: u32,
+}
+
+pub struct Storage {
+    pub entries: BTreeMap<u32, Expr>,
+}
+
+pub fn plain(line: u32) -> Metadata {
+    Metadata {
+        storage: None,
+        line,
+    }
+}
+
+pub fn with_entry(key: u32, e: Expr, line: u32) -> Metadata {
+    let mut entries = BTreeMap::new();
+    entries.insert(key, e);
+    Metadata {
+        storage: Some(Storage { entries }),
+        line,
+    }
+}
+
+/// Same name as a field of the recursive structure `Metadata`: the binders of
+/// the projector simp lemmas are renamed, the lemma bodies must follow
+pub fn line(meta: &Metadata) -> u32 {
+    meta.line
+}
+
+pub fn list(items: Vec<Expr>, meta: Metadata) -> Expr {
+    Expr::List(items, meta)
+}
+
+pub fn call(name: String, args: Vec<Expr>) -> Expr {
+    Expr::Call(name, args)
+}
+
+pub fn eval(e: &Expr, key: u32) -> i64 {
+    match e {
+        Expr::Int(n) => *n,
+        Expr::List(items, meta) => {
+            let mut s = line(meta) as i64;
+            let mut i = 0;
+            while i < items.len() {
+                s = s.wrapping_add(eval(&items[i], key));
+                i += 1;
+            }
+            match &meta.storage {
+                Some(storage) => match storage.entries.get(&key) {
+                    Some(x) => s.wrapping_add(eval(x, key)),
+                    None => s,
+                },
+                None => s,
+            }
+        }
+        Expr::Call(_, args) => args.len() as i64,
+    }
+}
+
+pub fn append(e: &mut Expr, x: Expr) {
+    match e {
+        Expr::List(items, _) => items.push(x),
+        Expr::Call(_, args) => args.push(x),
+        Expr::Int(_) => {}
+    }
+}
+
+/// A generic wrapper whose field is nested in a recursive group through its
+/// type parameter
+pub struct Wrapper<T> {
+    pub items: Vec<T>,
+    pub tag: u32,
+}
+
+pub enum Doc {
+    Text(u32),
+    Block(Wrapper<Doc>),
+}
+
+pub fn text(n: u32) -> Doc {
+    Doc::Text(n)
+}
+
+pub fn block(tag: u32) -> Doc {
+    Doc::Block(Wrapper {
+        items: Vec::new(),
+        tag,
+    })
+}
+
+pub fn add(d: &mut Doc, child: Doc) -> bool {
+    match d {
+        Doc::Block(w) => {
+            w.items.push(child);
+            w.tag = w.tag.wrapping_add(1);
+            true
+        }
+        Doc::Text(_) => false,
+    }
+}
+
+pub fn take_last(d: &mut Doc) -> Option<Doc> {
+    match d {
+        Doc::Block(w) => w.items.pop(),
+        Doc::Text(_) => None,
+    }
+}
+
+pub fn doc_size(d: &Doc) -> u32 {
+    match d {
+        Doc::Text(n) => *n,
+        Doc::Block(w) => {
+            let mut s = w.tag;
+            let mut i = 0;
+            while i < w.items.len() {
+                s = s.wrapping_add(doc_size(&w.items[i]));
+                i += 1;
+            }
+            s
+        }
+    }
+}
+
+/// The wrapper is also used with types which are not recursive
+pub fn wrap_nums(items: Vec<u32>, tag: u32) -> Wrapper<u32> {
+    Wrapper { items, tag }
+}
+
+pub fn wrapper_len<T>(w: &Wrapper<T>) -> usize {
+    w.items.len()
+}
+
+pub fn retag<T>(w: Wrapper<T>, tag: u32) -> Wrapper<T> {
+    Wrapper { tag, ..w }
+}
+
+pub fn wrapper_first(w: &Wrapper<u32>) -> u32 {
+    if w.items.len() > 0 {
+        w.items[0]
+    } else {
+        w.tag
+    }
+}
+
+/// End-to-end scenarios
+pub fn tree_scenario(a: u32, b: u32) -> u32 {
+    let mut t = node2(leaf(a), pair(leaf(b), leaf(1)));
+    push_child(&mut t, named(String::from("x"), leaf(10)));
+    let mut bs = Vec::new();
+    bs.push(leaf(100));
+    push_child(&mut t, boxed(bs));
+    push_child(&mut t, opt(Some(leaf(1000))));
+    let mut row = Vec::new();
+    row.push(leaf(7));
+    row.push(leaf(8));
+    push_child(&mut t, grid(row));
+    bump(&mut t);
+    let w = width(&t) as u32;
+    let s = sum(&t);
+    s.wrapping_mul(10).wrapping_add(w)
+}
+
+pub fn tree_pop_scenario(a: u32) -> u32 {
+    let mut children = Vec::new();
+    children.push(leaf(a));
+    children.push(leaf(a + 1));
+    let mut t = node(children);
+    set_leaf(&mut t, 0, 5);
+    let popped = match pop_child(&mut t) {
+        Some(c) => sum(&c),
+        None => 0,
+    };
+    let mut p = pair(leaf(1), leaf(2));
+    set_leaf(&mut p, 1, 9);
+    popped * 1000 + sum(&t) * 10 + sum(&p)
+}
+
+pub fn expr_scenario(key: u32) -> i64 {
+    let mut args = Vec::new();
+    args.push(Expr::Int(1));
+    let mut items = Vec::new();
+    items.push(Expr::Int(5));
+    items.push(call(String::from("f"), args));
+    let mut e = list(items, with_entry(3, Expr::Int(100), 7));
+    append(&mut e, Expr::Int(20));
+    let inner = list(Vec::new(), plain(2));
+    append(&mut e, inner);
+    eval(&e, key)
+}
+
+pub fn doc_scenario(n: u32) -> u32 {
+    let mut d = block(1);
+    add(&mut d, text(n));
+    let mut inner = block(10);
+    add(&mut inner, text(100));
+    add(&mut d, inner);
+    add(&mut d, text(1000));
+    let last = match take_last(&mut d) {
+        Some(x) => doc_size(&x),
+        None => 0,
+    };
+    let w = retag(wrap_nums(Vec::new(), 4), 6);
+    doc_size(&d)
+        .wrapping_mul(10)
+        .wrapping_add(last)
+        .wrapping_add(wrapper_first(&w))
+        .wrapping_add(wrapper_len(&w) as u32)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn trees() {
+        assert_eq!(tree_scenario(2, 3), 11346);
+        assert_eq!(tree_scenario(0, 0), 11296);
+        assert_eq!(tree_pop_scenario(4), 5060);
+        assert_eq!(tree_pop_scenario(0), 1060);
+    }
+
+    #[test]
+    fn exprs() {
+        assert_eq!(expr_scenario(3), 135);
+        assert_eq!(expr_scenario(4), 35);
+    }
+
+    #[test]
+    fn docs() {
+        assert_eq!(doc_scenario(5), 2206);
+        assert_eq!(doc_scenario(0), 2156);
+    }
+}
