+    | none => _root_.Aeneas.Std.Result.ok 0#u32
+    | some x => _root_.nested_collections.doc_size x
+  let w ←
+    _root_.nested_collections.wrap_nums (_root_.Aeneas.Std.alloc.vec.Vec.new
+      _root_.Aeneas.Std.U32) 4#u32
+  let w1 ← _root_.nested_collections.retag w 6#u32
+  let i ← _root_.nested_collections.doc_size d7
+  let i1 ← lift (core.num.U32.wrapping_mul i 10#u32)
+  let i2 ← lift (core.num.U32.wrapping_add i1 last)
+  let i3 ← _root_.nested_collections.wrapper_first w1
+  let i4 ← lift (core.num.U32.wrapping_add i2 i3)
+  let i5 ← _root_.nested_collections.wrapper_len w1
+  let i6 ← lift (UScalar.cast .U32 i5)
+  _root_.Aeneas.Std.Result.ok (core.num.U32.wrapping_add i4 i6)
+
+end nested_collections
