diff --git a/src/pure/PureNestedCollections.ml b/src/pure/PureNestedCollections.ml
new file mode 100644
index 0000000..09c875a
--- /dev/null
+++ b/src/pure/PureNestedCollections.ml
@@ -0,0 +1,673 @@
+(** Carriers for the collections nested in recursive types (Lean backend).
+
+    In the Lean library, [Vec], [Slice] and [Array] are subtypes of [List] whose
+    invariant mentions the element type. Lean's nested-inductive elaboration
+    rejects them as containers of the types being declared, so a Rust type
+    which is recursive through, e.g., [Vec<Self>] can not be translated
+    directly. The Lean library provides carriers ([NestedVec], [NestedSlice],
+    [NestedArray]) which have the same values but whose invariant only
+    mentions a length index, together with mutually inverse conversions.
+
+    This pass:
+    - replaces the nested collections by their carriers in the fields of the
+      type declarations (see {!compute_nested_decls} for the exact rule);
+    - inserts the conversions wherever a value crosses such a field: in
+      constructor applications (constructors used as function values are
+      eta-expanded), field projections, structure updates and patterns (we
+      bind the carrier then convert it with a let-binding).
+
+    Everything else (function signatures, local variables) keeps the original
+    collection types. *)
+
+open Pure
+open PureUtils
+open TranslateCore
+
+(** The local logger *)
+let log = Logging.pure_micro_passes_log
+
+(** {1 Type declarations} *)
+
+(** The collections which have a carrier *)
+type collection = { kind : nested_collection; elem : ty; generics : generic_args }
+
+(** Library types whose Lean model has an invariant which depends on its type
+    parameters (they wrap a [Vec], [Slice] or [Array], or a proof about their
+    parameter), and which thus can not contain the types being declared in a
+    recursive group. They have no carrier: we report an error if a recursive
+    group is nested through them. *)
+let non_nestable_builtin_types =
+  [
+    "alloc::vec::into_iter::IntoIter";
+    "core::array::iter::IntoIter";
+    "core::slice::iter::Iter";
+    "core::slice::iter::IterMut";
+    "core::slice::iter::Windows";
+    "core::slice::iter::Chunks";
+    "core::slice::iter::ChunksExact";
+    "core::num::nonzero::NonZero";
+  ]
+
+let builtin_rust_name (d : type_decl) : string option =
+  Option.map
+    (fun (info : builtin_type_info) ->
+      NameMatcher.pattern_to_string { tgt = TkPattern } info.rust_name)
+    d.builtin_info
+
+type decls_info = {
+  type_decls : type_decl TypeDeclId.Map.t;  (** The original declarations *)
+  vec_ids : TypeDeclId.Set.t;  (** The ids of [alloc::vec::Vec] *)
+  recursive_ids : TypeDeclId.Set.t;  (** The recursive declarations *)
+}
+
+let as_collection (info : decls_info) (ty : ty) : collection option =
+  match ty with
+  | TAdt (TAdtId id, generics) when TypeDeclId.Set.mem id info.vec_ids -> (
+      match generics.types with
+      | [ elem ] -> Some { kind = NestedVec; elem; generics }
+      | _ -> None)
+  | TAdt (TBuiltin TSlice, ({ types = [ elem ]; _ } as generics)) ->
+      Some { kind = NestedSlice; elem; generics }
+  | TAdt (TBuiltin TArray, ({ types = [ elem ]; _ } as generics)) ->
+      Some { kind = NestedArray; elem; generics }
+  | _ -> None
+
+let as_carrier (ty : ty) : collection option =
+  match ty with
+  | TAdt (TBuiltin (TNested kind), ({ types = [ elem ]; _ } as generics)) ->
+      Some { kind; elem; generics }
+  | _ -> None
+
+let collection_ty (info : decls_info) (c : collection) : ty =
+  match c.kind with
+  | NestedVec ->
+      let id = TypeDeclId.Set.choose info.vec_ids in
+      TAdt (TAdtId id, c.generics)
+  | NestedSlice -> TAdt (TBuiltin TSlice, c.generics)
+  | NestedArray -> TAdt (TBuiltin TArray, c.generics)
+
+let carrier_ty (c : collection) : ty = TAdt (TBuiltin (TNested c.kind), c.generics)
+
+let rec ty_exists (p : ty -> bool) (ty : ty) : bool =
+  p ty
+  ||
+  match ty with
+  | TAdt (_, generics) -> List.exists (ty_exists p) generics.types
+  | TArrow (a, b) -> ty_exists p a || ty_exists p b
+  | _ -> false
+
+let type_var_id (v : type_var_id de_bruijn_var) : type_var_id =
+  match v with
+  | Free id -> id
+  | Bound (_, id) -> id
+
+(** Is [ty] in the scope of the recursive group [group] (for a declaration
+    whose type parameters [params] may be instantiated with types of a
+    recursive group, see {!compute_nested_decls})? *)
+let mentions (group : TypeDeclId.Set.t) (params : TypeVarId.Set.t) (ty : ty) :
+    bool =
+  ty_exists
+    (function
+      | TAdt (TAdtId id, _) -> TypeDeclId.Set.mem id group
+      | TVar v -> TypeVarId.Set.mem (type_var_id v) params
+      | _ -> false)
+    ty
+
+(** Replace, in the type of a field, the collections applied to types which
+    mention the group (or the nesting parameters) by their carriers. *)
+let rec nest_ty (span : Meta.span) (info : decls_info)
+    (mentions : ty -> bool) (ty : ty) : ty =
+  let nest = nest_ty span info mentions in
+  match ty with
+  | TAdt (id, generics) -> (
+      let generics' = { generics with types = List.map nest generics.types } in
+      match as_collection info ty with
+      | Some c when mentions c.elem -> carrier_ty { c with generics = generics' }
+      | _ ->
+          (match id with
+          | TAdtId id -> (
+              match TypeDeclId.Map.find_opt id info.type_decls with
+              | Some d -> (
+                  match builtin_rust_name d with
+                  | Some name
+                    when List.mem name non_nestable_builtin_types
+                         && List.exists mentions generics.types ->
+                      [%craise] span
+                        ("The type '" ^ name
+                       ^ "' can not contain a type of the recursive group in \
+                          which it is used: its Lean model has an invariant \
+                          which depends on its type parameters, and it has no \
+                          nested carrier")
+                  | _ -> ())
+              | None -> ())
+          | _ -> ());
+          TAdt (id, generics'))
+  | TArrow (a, b) -> TArrow (nest a, nest b)
+  | _ -> ty
+
+(** The fields of a declaration, per variant *)
+let decl_fields (d : type_decl) : (VariantId.id option * field list) list =
+  match d.kind with
+  | Struct fields -> [ (None, fields) ]
+  | Enum variants ->
+      List.mapi
+        (fun i (v : variant) -> (Some (VariantId.of_int i), v.fields))
+        variants
+  | Opaque -> []
+
+let is_transparent_local (d : type_decl) : bool =
+  d.builtin_info = None && d.kind <> Opaque
+
+(** Compute the declarations whose fields need carriers, and update them.
+
+    Carriers are used exactly in the following positions of the fields of a
+    (non-builtin) declaration [d] of recursive group [G] (the group computed
+    by Charon; [G = {d}] if [d] is not recursive): a collection
+    ([alloc::vec::Vec], a slice or an array) applied to an element type which
+    mentions a declaration of [G], or a *nesting parameter* of [d].
+
+    The nesting parameters are the least fixed point of: the [i]-th type
+    parameter of a non-builtin declaration [g] is a nesting parameter if some
+    declaration [d] not in the group of [g] uses [g] in a field, with an [i]-th
+    type argument which mentions the group of [d] or a nesting parameter of
+    [d]. Lean elaborates such a use as a nested occurrence in which the
+    parameter is instantiated with the types being declared, so the
+    collections of this parameter in [g] need carriers as well (for all the
+    instantiations of [g], as the Lean definition of [g] is unique).
+
+    Returns the updated declarations. *)
+let compute_nested_decls (trans_ctx : trans_ctx) (info : decls_info) :
+    type_decl TypeDeclId.Map.t =
+  let group_of (id : TypeDeclId.id) : TypeDeclId.Set.t =
+    match TypeDeclId.Map.find_opt id trans_ctx.type_ctx.type_decls_groups with
+    | Some (RecGroup ids) -> TypeDeclId.Set.of_list ids
+    | Some (NonRecGroup _) | None -> TypeDeclId.Set.singleton id
+  in
+  let decls =
+    List.filter is_transparent_local (TypeDeclId.Map.values info.type_decls)
+  in
+  (* Compute the nesting parameters (fixed point) *)
+  let params = ref TypeDeclId.Map.empty in
+  let get_params id =
+    Option.value ~default:TypeVarId.Set.empty
+      (TypeDeclId.Map.find_opt id !params)
+  in
+  let changed = ref true in
+  while !changed do
+    changed := false;
+    List.iter
+      (fun (d : type_decl) ->
+        let group = group_of d.def_id in
+        let mentions = mentions group (get_params d.def_id) in
+        let visit (ty : ty) : bool =
+          (match ty with
+          | TAdt (TAdtId gid, generics) when not (TypeDeclId.Set.mem gid group)
+            -> (
+              match TypeDeclId.Map.find_opt gid info.type_decls with
+              | Some g when is_transparent_local g ->
+                  let gparams = get_params gid in
+                  let gparams' =
+                    List.fold_left2
+                      (fun set (p : type_param) arg ->
+                        if mentions arg then TypeVarId.Set.add p.index set
+                        else set)
+                      gparams g.generics.types generics.types
+                  in
+                  if not (TypeVarId.Set.equal gparams gparams') then (
+                    params := TypeDeclId.Map.add gid gparams' !params;
+                    changed := true)
+              | _ -> ())
+          | _ -> ());
+          false
+        in
+        List.iter
+          (fun (_, fields) ->
+            List.iter
+              (fun (f : field) -> ignore (ty_exists visit f.field_ty))
+              fields)
+          (decl_fields d))
+      decls
+  done;
+  (* Update the declarations *)
+  List.fold_left
+    (fun map (d : type_decl) ->
+      let span = d.item_meta.span in
+      let mentions = mentions (group_of d.def_id) (get_params d.def_id) in
+      let update_fields =
+        List.map (fun (f : field) ->
+            { f with field_ty = nest_ty span info mentions f.field_ty })
+      in
+      let kind =
+        match d.kind with
+        | Struct fields -> Struct (update_fields fields)
+        | Enum variants ->
+            Enum
+              (List.map
+                 (fun (v : variant) -> { v with fields = update_fields v.fields })
+                 variants)
+        | Opaque -> Opaque
+      in
+      if kind = d.kind then map
+      else TypeDeclId.Map.add d.def_id { d with kind } map)
+    TypeDeclId.Map.empty decls
+
+(** {1 Expressions} *)
+
+type ctx = {
+  span : Meta.span;
+  info : decls_info;
+  new_decls : type_decl TypeDeclId.Map.t;
+      (** The updated declarations (only those which changed) *)
+  fresh_fvar_id : unit -> fvar_id;
+}
+
+(** Original and updated types of the fields of a variant, if the variant has
+    updated fields *)
+let changed_fields (ctx : ctx) (adt_id : type_id)
+    (variant_id : VariantId.id option) (generics : generic_args) :
+    (ty * ty) list option =
+  match adt_id with
+  | TAdtId id -> (
+      match TypeDeclId.Map.find_opt id ctx.new_decls with
+      | None -> None
+      | Some new_decl ->
+          let old_decl = TypeDeclId.Map.find id ctx.info.type_decls in
+          let olds =
+            type_decl_get_instantiated_fields_types old_decl variant_id generics
+          in
+          let news =
+            type_decl_get_instantiated_fields_types new_decl variant_id generics
+          in
+          if olds = news then None else Some (List.combine olds news))
+  | _ -> None
+
+let lookup_decl (ctx : ctx) (id : TypeDeclId.id) : type_decl =
+  match TypeDeclId.Map.find_opt id ctx.new_decls with
+  | Some d -> d
+  | None -> TypeDeclId.Map.find id ctx.info.type_decls
+
+let mk_fresh (ctx : ctx) (basename : string option) (ty : ty) : fvar =
+  mk_fresh_fvar ctx.fresh_fvar_id ~basename ty
+
+let mk_pure_fun (fid : pure_builtin_fun_id) (generics : generic_args) (ty : ty)
+    : texpr =
+  { e = Qualif { id = FunOrOp (Fun (Pure fid)); generics }; ty }
+
+(** Convert an expression of type [e.ty] to type [ty], where [ty] is [e.ty] in
+    which some collections have been replaced by their carriers, or the
+    reverse. *)
+let rec convert (ctx : ctx) (ty : ty) (e : texpr) : texpr =
+  let span = ctx.span in
+  if e.ty = ty then e
+  else
+    match (as_collection ctx.info e.ty, as_carrier ty) with
+    | Some src, Some tgt ->
+        (* Collection to carrier: convert, then map the elements *)
+        let e =
+          [%add_loc] mk_app span
+            (mk_pure_fun (ToNested src.kind) src.generics
+               (mk_arrow e.ty (carrier_ty src)))
+            e
+        in
+        map_carrier ctx src tgt.elem e
+    | _ -> (
+        match (as_carrier e.ty, as_collection ctx.info ty) with
+        | Some src, Some tgt ->
+            (* Carrier to collection: map the elements, then convert *)
+            let e = map_carrier ctx src tgt.elem e in
+            let src = { src with elem = tgt.elem; generics = tgt.generics } in
+            [%add_loc] mk_app span
+              (mk_pure_fun (OfNested src.kind) src.generics
+                 (mk_arrow e.ty (collection_ty ctx.info src)))
+              e
+        | _ -> convert_adt ctx ty e)
+
+(** Map the elements of a carrier *)
+and map_carrier (ctx : ctx) (c : collection) (elem : ty) (e : texpr) : texpr =
+  if c.elem = elem then e
+  else
+    let span = ctx.span in
+    let x = mk_fresh ctx (Some "x") c.elem in
+    let f =
+      mk_opened_lambda span (mk_tpat_from_fvar None x)
+        (convert ctx elem (mk_texpr_from_fvar x))
+    in
+    let tgt = { c with elem; generics = { c.generics with types = [ elem ] } } in
+    let generics = { c.generics with types = [ c.elem; elem ] } in
+    let map =
+      mk_pure_fun (NestedMap c.kind) generics
+        (mk_arrows [ f.ty; e.ty ] (carrier_ty tgt))
+    in
+    [%add_loc] mk_apps span map [ f; e ]
+
+(** Convert a value of an ADT (or tuple) whose type arguments contain
+    collections which need to be converted, by rebuilding it *)
+and convert_adt (ctx : ctx) (ty : ty) (e : texpr) : texpr =
+  let span = ctx.span in
+  let unsupported () =
+    [%craise] span
+      ("Unsupported conversion of a collection nested in a recursive type: \
+        can not convert a value of type '"
+      ^ show_ty e.ty ^ "' to type '" ^ show_ty ty ^ "'")
+  in
+  match (e.ty, ty) with
+  | TAdt (src_id, src_generics), TAdt (tgt_id, tgt_generics)
+    when src_id = tgt_id -> (
+      let rebuild (variant_id : VariantId.id option) : tpat * texpr =
+        let src_tys, tgt_tys =
+          match src_id with
+          | TTuple -> (src_generics.types, tgt_generics.types)
+          | TAdtId id ->
+              let d = lookup_decl ctx id in
+              ( type_decl_get_instantiated_fields_types d variant_id
+                  src_generics,
+                type_decl_get_instantiated_fields_types d variant_id
+                  tgt_generics )
+          | TBuiltin _ -> unsupported ()
+        in
+        let vars = List.map (mk_fresh ctx None) src_tys in
+        let pat =
+          mk_adt_pat e.ty variant_id (List.map (mk_tpat_from_fvar None) vars)
+        in
+        let fields =
+          List.map2
+            (fun v ty -> convert ctx ty (mk_texpr_from_fvar v))
+            vars tgt_tys
+        in
+        (pat, mk_adt_texpr span ty variant_id fields)
+      in
+      match src_id with
+      | TTuple ->
+          let pat, value = rebuild None in
+          mk_opened_let false pat e value
+      | TAdtId id -> (
+          let d = lookup_decl ctx id in
+          (* We would need a recursive function to convert a value of a
+             recursive type *)
+          if TypeDeclId.Set.mem id ctx.info.recursive_ids then unsupported ();
+          match d.kind with
+          | Struct _ ->
+              let pat, value = rebuild None in
+              mk_opened_let false pat e value
+          | Enum variants ->
+              let branches =
+                List.mapi
+                  (fun i _ ->
+                    let pat, branch = rebuild (Some (VariantId.of_int i)) in
+                    mk_opened_branch pat branch)
+                  variants
+              in
+              mk_switch ~empty_ty:ty e (Match branches)
+          | Opaque -> unsupported ())
+      | TBuiltin _ -> unsupported ())
+  | _ -> unsupported ()
+
+(** Is a pattern irrefutable? *)
+let rec is_irrefutable (ctx : ctx) (p : tpat) : bool =
+  match p.pat with
+  | PIgnored | POpen _ | PBound _ -> true
+  | PConstant _ -> false
+  | PAdt { variant_id = None; fields } -> List.for_all (is_irrefutable ctx) fields
+  | PAdt { variant_id = Some _; _ } -> false
+
+(** Update a pattern: the sub-patterns in the updated fields now match the
+    carriers. Returns the updated pattern and the let-bindings which introduce
+    the original variables. *)
+let rec update_pat (ctx : ctx) (p : tpat) : tpat * (tpat * texpr) list =
+  match p.pat with
+  | PAdt { variant_id; fields } -> (
+      let adt_id, generics = ty_as_adt ctx.span p.ty in
+      let fields_bindings =
+        match changed_fields ctx adt_id variant_id generics with
+        | None -> List.map (update_pat ctx) fields
+        | Some tys ->
+            List.map2
+              (fun (field : tpat) (old_ty, new_ty) ->
+                if old_ty = new_ty then update_pat ctx field
+                else
+                  match field.pat with
+                  | PIgnored -> ({ field with ty = new_ty }, [])
+                  | POpen (v, mp) ->
+                      let v' = mk_fresh ctx v.basename new_ty in
+                      ( { pat = POpen (v', mp); ty = new_ty },
+                        [ (field, convert ctx old_ty (mk_texpr_from_fvar v')) ] )
+                  | _ ->
+                      if not (is_irrefutable ctx field) then
+                        [%craise] ctx.span
+                          "Unsupported refutable pattern on a collection \
+                           nested in a recursive type";
+                      let field, bindings = update_pat ctx field in
+                      let v' = mk_fresh ctx None new_ty in
+                      ( mk_tpat_from_fvar None v',
+                        (field, convert ctx old_ty (mk_texpr_from_fvar v'))
+                        :: bindings ))
+              fields tys
+      in
+      let fields, bindings = List.split fields_bindings in
+      ({ p with pat = PAdt { variant_id; fields } }, List.concat bindings))
+  | _ -> (p, [])
+
+let bind (bindings : (tpat * texpr) list) (e : texpr) : texpr =
+  mk_opened_lets false bindings e
+
+let rec update_texpr (ctx : ctx) (e : texpr) : texpr =
+  let span = ctx.span in
+  let update = update_texpr ctx in
+  match e.e with
+  | FVar _ | BVar _ | CVar _ | Const _ | EError _ -> e
+  | Qualif qualif -> update_qualif_app ctx e qualif []
+  | App _ -> (
+      let f, args = destruct_apps e in
+      let args = List.map update args in
+      match f.e with
+      | Qualif qualif -> update_qualif_app ctx f qualif args
+      | _ -> [%add_loc] mk_apps span (update f) args)
+  | Lambda (pat, body) ->
+      let pat, bindings = update_pat ctx pat in
+      { e with e = Lambda (pat, bind bindings (update body)) }
+  | Let (monadic, pat, re, next) ->
+      let re = update re in
+      let pat, bindings = update_pat ctx pat in
+      { e with e = Let (monadic, pat, re, bind bindings (update next)) }
+  | Switch (scrut, If (e_then, e_else)) ->
+      { e with e = Switch (update scrut, If (update e_then, update e_else)) }
+  | Switch (scrut, Match branches) ->
+      let branches =
+        List.map
+          (fun (br : match_branch) ->
+            let pat, bindings = update_pat ctx br.pat in
+            { pat; branch = bind bindings (update br.branch) })
+          branches
+      in
+      { e with e = Switch (update scrut, Match branches) }
+  | Loop loop ->
+      let inputs, bindings =
+        List.split (List.map (update_pat ctx) loop.loop_body.inputs)
+      in
+      let loop_body =
+        {
+          inputs;
+          loop_body =
+            bind (List.concat bindings) (update loop.loop_body.loop_body);
+        }
+      in
+      { e with e = Loop { loop with inputs = List.map update loop.inputs; loop_body } }
+  | StructUpdate supd ->
+      let init = Option.map update supd.init in
+      let adt_id, generics = ty_as_adt span e.ty in
+      let tys = changed_fields ctx adt_id None generics in
+      let updates =
+        List.map
+          (fun (fid, fe) ->
+            let fe = update fe in
+            match tys with
+            | None -> (fid, fe)
+            | Some tys ->
+                let _, new_ty = FieldId.nth tys fid in
+                (fid, convert ctx new_ty fe))
+          supd.updates
+      in
+      { e with e = StructUpdate { supd with init; updates } }
+  | Meta (m, inner) -> { e with e = Meta (m, update inner) }
+
+(** Update a (partial) application of a qualifier, whose arguments were already
+    updated *)
+and update_qualif_app (ctx : ctx) (f : texpr) (qualif : qualif)
+    (args : texpr list) : texpr =
+  let span = ctx.span in
+  let default () = [%add_loc] mk_apps span f args in
+  match qualif.id with
+  | AdtCons { adt_id; variant_id } -> (
+      match changed_fields ctx adt_id variant_id qualif.generics with
+      | None -> default ()
+      | Some tys ->
+          let old_tys, new_tys = List.split tys in
+          let adt_ty = TAdt (adt_id, qualif.generics) in
+          (* Eta-expand the missing arguments *)
+          let missing =
+            List.map (mk_fresh ctx None)
+              (Collections.List.drop (List.length args) old_tys)
+          in
+          let args = args @ List.map mk_texpr_from_fvar missing in
+          let f = { f with ty = mk_arrows new_tys adt_ty } in
+          let args = List.map2 (convert ctx) new_tys args in
+          mk_opened_lambdas span
+            (List.map (mk_tpat_from_fvar None) missing)
+            ([%add_loc] mk_apps span f args))
+  | Proj { adt_id; field_id } -> (
+      match changed_fields ctx adt_id None qualif.generics with
+      | None -> default ()
+      | Some tys ->
+          let old_ty, new_ty = FieldId.nth tys field_id in
+          if old_ty = new_ty then default ()
+          else
+            let adt_ty = TAdt (adt_id, qualif.generics) in
+            let f = { f with ty = mk_arrow adt_ty new_ty } in
+            let project (x : texpr) : texpr =
+              convert ctx old_ty ([%add_loc] mk_app span f x)
+            in
+            match args with
+            | x :: args -> [%add_loc] mk_apps span (project x) args
+            | [] ->
+                let x = mk_fresh ctx None adt_ty in
+                mk_opened_lambda span (mk_tpat_from_fvar None x)
+                  (project (mk_texpr_from_fvar x)))
+  | _ -> default ()
+
+(** {1 Type checking} *)
+
+(** Type-check an opened function body (the free variables are all bound in
+    the body) *)
+let type_check_fun_body (trans_ctx : trans_ctx)
+    (type_decls : type_decl TypeDeclId.Map.t) (span : Meta.span)
+    (sg : fun_sig) (body : fun_body) : unit =
+  let fenv = ref FVarId.Map.empty in
+  let visitor =
+    object
+      inherit [_] iter_expr
+
+      method! visit_POpen _ (v : fvar) _ =
+        fenv := FVarId.Map.add v.id v.ty !fenv
+    end
+  in
+  List.iter (visitor#visit_tpat ()) body.inputs;
+  visitor#visit_texpr () body.body;
+  let const_generics =
+    ConstGenericVarId.Map.of_list
+      (List.map
+         (fun (cg : const_generic_param) -> (cg.index, TLiteral cg.ty))
+         sg.generics.const_generics)
+  in
+  let ctx : PureTypeCheck.tc_ctx =
+    {
+      type_decls;
+      global_decls = trans_ctx.crate.global_decls;
+      const_generics;
+      decls_ctx = trans_ctx;
+      fenv = !fenv;
+      benv = [];
+      pbenv = None;
+      bvar_counter = BVarId.zero;
+    }
+  in
+  PureTypeCheck.check_texpr span ctx body.body
+
+(** {1 Entry point} *)
+
+(** Apply the pass to all the declarations. Only for the Lean backend. *)
+let apply (trans_ctx : trans_ctx) (type_decls : type_decl list)
+    (funs : pure_fun_translation list) :
+    type_decl list * pure_fun_translation list =
+  let type_decls_map =
+    TypeDeclId.Map.of_list
+      (List.map (fun (d : type_decl) -> (d.def_id, d)) type_decls)
+  in
+  let vec_ids =
+    TypeDeclId.Set.of_list
+      (List.filter_map
+         (fun (d : type_decl) ->
+           if builtin_rust_name d = Some "alloc::vec::Vec" then Some d.def_id
+           else None)
+         type_decls)
+  in
+  let recursive_ids =
+    TypeDeclId.Set.of_list
+      (List.filter_map
+         (fun (id, (g : Charon.GAst.type_declaration_group)) ->
+           match g with
+           | RecGroup _ -> Some id
+           | NonRecGroup _ -> None)
+         (TypeDeclId.Map.bindings trans_ctx.type_ctx.type_decls_groups))
+  in
+  let info = { type_decls = type_decls_map; vec_ids; recursive_ids } in
+  let new_decls = compute_nested_decls trans_ctx info in
+  if TypeDeclId.Map.is_empty new_decls then (type_decls, funs)
+  else
+    let all_decls =
+      TypeDeclId.Map.union (fun _ d _ -> Some d) new_decls type_decls_map
+    in
+    let update_fun (f : fun_decl) : fun_decl =
+      match f.body with
+      | None -> f
+      | Some body ->
+          let span = f.item_meta.span in
+          let _, fresh_fvar_id = FVarId.fresh_stateful_generator () in
+          let _, opened = open_all_fun_body fresh_fvar_id span body in
+          let ctx = { span; info; new_decls; fresh_fvar_id } in
+          let inputs, bindings =
+            List.split (List.map (update_pat ctx) opened.inputs)
+          in
+          let updated =
+            {
+              inputs;
+              body = bind (List.concat bindings) (update_texpr ctx opened.body);
+            }
+          in
+          if updated = opened then f
+          else (
+            [%ltrace
+              "Updated nested collections in: " ^ f.name ^ "\n"
+              ^ PrintPure.fun_body_to_string
+                  (trans_ctx_to_pure_fmt_env trans_ctx)
+                  updated];
+            if !Config.sanity_checks then
+              type_check_fun_body trans_ctx all_decls span f.signature updated;
+            { f with body = Some (close_all_fun_body span updated) })
+    in
+    let funs =
+      List.map
+        (fun (t : pure_fun_translation) ->
+          {
+            f = update_fun t.f;
+            loops = List.map update_fun t.loops;
+            bodies = List.map update_fun t.bodies;
+          })
+        funs
+    in
+    let type_decls =
+      List.map
+        (fun (d : type_decl) ->
+          Option.value ~default:d (TypeDeclId.Map.find_opt d.def_id new_decls))
+        type_decls
+    in
+    (type_decls, funs)
