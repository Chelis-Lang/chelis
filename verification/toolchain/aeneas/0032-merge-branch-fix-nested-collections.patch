+namespace nested_collections.checks
+open Aeneas Aeneas.Std Result
+
+def okU32 : Result U32 → Option Nat
+  | ok a => some a.val
+  | _ => none
+
+def okI64 : Result I64 → Option Int
+  | ok a => some a.val
+  | _ => none
+
+#guard okU32 (tree_scenario 2#u32 3#u32) == some 11346
+#guard okU32 (tree_scenario 0#u32 0#u32) == some 11296
+#guard okU32 (tree_pop_scenario 4#u32) == some 5060
+#guard okU32 (tree_pop_scenario 0#u32) == some 1060
+
+#guard okI64 (expr_scenario 3#u32) == some 135
+#guard okI64 (expr_scenario 4#u32) == some 35
+
+#guard okU32 (doc_scenario 5#u32) == some 2206
+#guard okU32 (doc_scenario 0#u32) == some 2156
