     (x y : U × T) : Result Bool := do
   if ← first.ne x.1 y.1 then ok true else second.ne x.2 y.2
 
+/-- `PartialEq for (W, V, U, T)` (core/src/tuple.rs): the components compared in order with
+    `&&`, so a later component is only compared when the earlier ones are equal. -/
+@[rust_fun "core::tuple::{core::cmp::PartialEq<(@W, @V, @U, @T), (@W, @V, @U, @T)>}::eq"]
+def core.tuple.PartialEqQuad.eq {W V U T : Type}
+    (first : core.cmp.PartialEq W W) (second : core.cmp.PartialEq V V)
+    (third : core.cmp.PartialEq U U) (fourth : core.cmp.PartialEq T T)
+    (x y : W × V × U × T) : Result Bool := do
+  if ← first.eq x.1 y.1 then
+    if ← second.eq x.2.1 y.2.1 then
+      if ← third.eq x.2.2.1 y.2.2.1 then fourth.eq x.2.2.2 y.2.2.2 else ok false
+    else ok false
+  else ok false
+
