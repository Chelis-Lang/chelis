diff --git a/backends/lean/Aeneas/Std/IteratorSources.lean b/backends/lean/Aeneas/Std/IteratorSources.lean
index 62bfad9..1654138 100644
--- a/backends/lean/Aeneas/Std/IteratorSources.lean
+++ b/backends/lean/Aeneas/Std/IteratorSources.lean
@@ -29,6 +29,22 @@ def core.ops.range.RangeInclusive.new {Idx : Type} (start end_ : Idx) :
   Result (core.ops.range.RangeInclusive Idx) :=
   ok ⟨start, end_, false⟩
 
+/-- `RangeInclusive::contains` (core/src/ops/range.rs, rustc 1.95) is
+    `<Self as RangeBounds<Idx>>::contains` with `start_bound = Included(start)`
+    and `end_bound = Included(end)`, or `Excluded(end)` once iteration has
+    exhausted the range: `start <= item && item <= end` (`item < end` when
+    exhausted). As for `Range::contains`, the first comparison uses
+    `Idx: PartialOrd<U>` and the second (only when the first holds)
+    `U: PartialOrd<Idx>`; the impl's own `Idx: PartialOrd<Idx>` is not used. -/
+@[rust_fun "core::ops::range::{core::ops::range::RangeInclusive<@Idx>}::contains"]
+def core.ops.range.RangeInclusive.contains {Idx U : Type}
+  (_ : core.cmp.PartialOrd Idx Idx) (idxOrdInst : core.cmp.PartialOrd Idx U)
+  (itemOrdInst : core.cmp.PartialOrd U Idx) (self : core.ops.range.RangeInclusive Idx)
+  (item : U) : Result Bool := do
+  if ← idxOrdInst.le self.start item then
+    if self.exhausted then itemOrdInst.lt item self.end else itemOrdInst.le item self.end
+  else ok false
+
 -- Keep the short circuit: an exhausted range does not invoke PartialOrd again.
 def core.ops.range.RangeInclusive.isEmpty {Idx : Type}
   (ordInst : core.cmp.PartialOrd Idx Idx)
