diff --git a/tests/src/join-nested-closure.rs b/tests/src/join-nested-closure.rs
new file mode 100644
index 0000000..1037f83
--- /dev/null
+++ b/tests/src/join-nested-closure.rs
@@ -0,0 +1,87 @@
+//@ [!lean] skip
+//@ [lean] subdir=JoinNestedClosure
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! An if-join over a call of a `&mut F` closure argument, where `F` is a
+//! closure which captures a mutable borrow of another closure (the shape of
+//! `chelis_ir::eval::resolve_load_inputs`): the value of type
+//! `&'a mut Closure<'b, T>` given back by `call_mut` in one branch is joined
+//! with the one the other branch started with. The join abstraction of `'b`
+//! holds the pending loans of the value given back to the outer borrow; its
+//! continuation is staged (see `join-nested-staged.rs`).
+
+fn pick<F>(n: u32, mut load: F) -> u32
+where
+    F: FnMut(u32) -> Option<u32>,
+{
+    let a = if n > 3 { load(n) } else { None };
+    let b = load(n.wrapping_add(1));
+    a.unwrap_or(0).wrapping_add(b.unwrap_or(0))
+}
+
+fn pick_ref<G>(n: u32, mut load: G) -> u32
+where
+    G: FnMut(u32) -> Option<u32>,
+{
+    pick(n, &mut load)
+}
+
+fn pick_with<F>(n: u32, mut load: F) -> u32
+where
+    F: FnMut(u32) -> Option<u32>,
+{
+    pick_ref(n, |x| load(x))
+}
+
+/// The loader is called in one branch only, then once more; it counts its
+/// calls in its own state
+pub fn run_pick(n: u32) -> u32 {
+    let mut calls = 0u32;
+    pick_with(n, move |x| {
+        calls = calls.wrapping_add(1);
+        if x == 7 { None } else { Some(x.wrapping_mul(100).wrapping_add(calls)) }
+    })
+}
+
+/// A call in each branch, with different arguments
+fn either<F>(n: u32, mut load: F) -> u32
+where
+    F: FnMut(u32) -> Option<u32>,
+{
+    let a = if n > 3 { load(n) } else { load(n.wrapping_mul(2)) };
+    let b = load(0);
+    a.unwrap_or(1).wrapping_add(b.unwrap_or(2))
+}
+
+fn either_ref<G>(n: u32, mut load: G) -> u32
+where
+    G: FnMut(u32) -> Option<u32>,
+{
+    either(n, &mut load)
+}
+
+/// The loader's state is observed after the call
+pub fn run_either(n: u32) -> (u32, u32) {
+    let mut calls = 0u32;
+    let r = either_ref(n, |x| {
+        calls = calls.wrapping_add(1);
+        if x == 6 { None } else { Some(x.wrapping_mul(10).wrapping_add(calls)) }
+    });
+    (r, calls)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn drives() {
+        println!("{}", run_pick(2));
+        println!("{}", run_pick(5));
+        println!("{}", run_pick(7));
+        println!("{}", run_pick(6));
+        println!("{:?}", run_either(2));
+        println!("{:?}", run_either(3));
+        println!("{:?}", run_either(5));
+    }
+}
diff --git a/tests/src/join-nested-staged.rs b/tests/src/join-nested-staged.rs
new file mode 100644
index 0000000..7aa11fe
--- /dev/null
+++ b/tests/src/join-nested-staged.rs
@@ -0,0 +1,99 @@
+//@ [!lean] skip
+//@ [lean] subdir=JoinNestedStaged
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Joins of a reborrowed `&'a mut Counter<'b>` whose inner borrow of `'b`
+//! may have gone through a call in one branch (the shape of
+//! `chelis_ir::eval::resolve_load_inputs`, where a `&mut F` closure capturing
+//! mutable state is called in a branch). The join abstraction of `'b` holds
+//! the pending loans of the value given back to the outer borrow: its
+//! continuation is staged like the backward function of the region group
+//! `'b` of `bump` (first stage: the value given back to the outer borrow at
+//! level 1; second stage: the current inner borrows at level 0).
+
+pub struct Counter<'b> {
+    pub total: &'b mut u32,
+    pub calls: u32,
+}
+
+pub fn bump(c: &mut &mut Counter<'_>, v: u32) -> u32 {
+    *c.total = (*c.total).wrapping_add(v);
+    c.calls = c.calls.wrapping_add(1);
+    c.calls
+}
+
+/// The reference is given back by the call in one branch only
+pub fn maybe_bump(c: &mut Counter<'_>, b: bool, v: u32) -> u32 {
+    let mut r = c;
+    let a = if b { bump(&mut r, v) } else { 0 };
+    let x = bump(&mut r, 1);
+    a.wrapping_add(x)
+}
+
+/// The reference is given back by a call in both branches
+pub fn either_bump(c: &mut Counter<'_>, b: bool) -> u32 {
+    let mut r = c;
+    let a = if b { bump(&mut r, 10) } else { bump(&mut r, 20) };
+    a.wrapping_add(bump(&mut r, 1))
+}
+
+/// No call after the join: a write through the joined reference
+pub fn maybe_bump_write(c: &mut Counter<'_>, b: bool, v: u32) -> u32 {
+    let mut r = c;
+    let a = if b { bump(&mut r, v) } else { 0 };
+    *r.total = (*r.total).wrapping_add(100);
+    a
+}
+
+pub fn drive_maybe(b: bool, v: u32) -> (u32, u32, u32) {
+    let mut t = 5u32;
+    let mut c = Counter { total: &mut t, calls: 1 };
+    let r = maybe_bump(&mut c, b, v);
+    let calls = c.calls;
+    (r, calls, t)
+}
+
+/// The caller writes through the inner borrow after the call: the value
+/// given back at level 1 goes through the staged continuation
+pub fn drive_maybe_then_write(b: bool, v: u32) -> (u32, u32, u32) {
+    let mut t = 5u32;
+    let mut c = Counter { total: &mut t, calls: 1 };
+    let r = maybe_bump(&mut c, b, v);
+    *c.total = (*c.total).wrapping_mul(3);
+    let calls = c.calls;
+    (r, calls, t)
+}
+
+pub fn drive_either(b: bool) -> (u32, u32, u32) {
+    let mut t = 7u32;
+    let mut c = Counter { total: &mut t, calls: 2 };
+    let r = either_bump(&mut c, b);
+    *c.total = (*c.total).wrapping_add(1000);
+    let calls = c.calls;
+    (r, calls, t)
+}
+
+pub fn drive_write(b: bool, v: u32) -> (u32, u32, u32) {
+    let mut t = 5u32;
+    let mut c = Counter { total: &mut t, calls: 0 };
+    let r = maybe_bump_write(&mut c, b, v);
+    let calls = c.calls;
+    (r, calls, t)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn drives() {
+        println!("{:?}", drive_maybe(true, 3));
+        println!("{:?}", drive_maybe(false, 3));
+        println!("{:?}", drive_maybe_then_write(true, 3));
+        println!("{:?}", drive_maybe_then_write(false, 3));
+        println!("{:?}", drive_either(true));
+        println!("{:?}", drive_either(false));
+        println!("{:?}", drive_write(true, 4));
+        println!("{:?}", drive_write(false, 4));
+    }
+}
diff --git a/tests/src/loop-fixed-point-abs-ids.rs b/tests/src/loop-fixed-point-abs-ids.rs
new file mode 100644
index 0000000..06c227a
--- /dev/null
+++ b/tests/src/loop-fixed-point-abs-ids.rs
@@ -0,0 +1,89 @@
+//@ [!lean] skip
+//@ [lean] subdir=LoopFixedPointAbsIds
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::iter::adapters::map::Map --include core::option::{core::option::Option} --include core::cmp
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Loops over a vector of shared borrows while a borrow of one of its elements
+//! (indexing, `split_first`) lives across the loop, with a conditional in the
+//! loop body. The join of the next iteration leaves the abstraction of the
+//! element borrow untouched and regenerates the abstraction of the loop
+//! iterator: both are parents of the abstraction of the vector's region, and
+//! the order of their ids changes from one iteration to the next. The join can
+//! also list that abstraction before its parents. The fixed-point check matches
+//! the parents through the mapping of the abstractions themselves.
+//! `LoopFixedPointAbsIds/Checks.lean` evaluates the model on the inputs of the
+//! `native` test module below and compares with the native results.
+
+/// Pushes the values above `bound`; returns the first value, borrowed across
+/// the loop.
+pub fn above(values: Vec<&u32>, bound: u32, out: &mut Vec<u32>) -> u32 {
+    let first = &values[0];
+    for v in &values {
+        if **v > bound {
+            out.push(**v);
+        }
+    }
+    **first
+}
+
+/// Pushes the labels above 1; returns the axis of the first label, whose
+/// borrow (`split_first`) lives across the loop.
+pub fn select(labels: &[u32], out: &mut Vec<u32>) -> usize {
+    let witnesses = labels.iter().map(|l| (l, *l as usize)).collect::<Vec<_>>();
+    let Some((canonical, _)) = witnesses.split_first() else {
+        return 0;
+    };
+    for (label, _) in &witnesses {
+        if **label > 1 {
+            out.push(**label);
+        }
+    }
+    canonical.1
+}
+
+/// The values which are not live, and the axis of the first value.
+pub fn missing(values: Vec<(&u32, usize)>, live: &[u32]) -> (Vec<u32>, usize) {
+    let mut out = Vec::new();
+    let Some((canonical, _)) = values.split_first() else {
+        return (out, 0);
+    };
+    for (v, _) in &values {
+        if !live.contains(*v) {
+            out.push(**v);
+        }
+    }
+    (out, canonical.1)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn above_bound() {
+        let (a, b, c) = (3, 1, 5);
+        let mut out = vec![9];
+        assert_eq!(above(vec![&a, &b, &c], 2, &mut out), 3);
+        assert_eq!(out, vec![9, 3, 5]);
+        let mut out = Vec::new();
+        assert_eq!(above(vec![&b], 2, &mut out), 1);
+        assert_eq!(out, Vec::<u32>::new());
+    }
+
+    #[test]
+    fn select_labels() {
+        let mut out = Vec::new();
+        assert_eq!(select(&[4, 1, 2], &mut out), 4);
+        assert_eq!(out, vec![4, 2]);
+        let mut out = vec![7];
+        assert_eq!(select(&[], &mut out), 0);
+        assert_eq!(out, vec![7]);
+    }
+
+    #[test]
+    fn missing_values() {
+        let (a, b, c) = (3, 1, 5);
+        assert_eq!(missing(vec![(&a, 0), (&b, 1), (&c, 2)], &[1]), (vec![3, 5], 0));
+        assert_eq!(missing(vec![(&b, 6)], &[1]), (vec![], 6));
+        assert_eq!(missing(vec![], &[1]), (vec![], 0));
+    }
+}
