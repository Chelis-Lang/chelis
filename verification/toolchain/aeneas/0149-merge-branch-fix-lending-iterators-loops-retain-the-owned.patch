@@ -0,0 +1,87 @@
+//@ [!lean] skip
+//@ [lean] subdir=LoopOptionTupleLoan
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! A loop over a function returning an `Option` of a tuple which holds a
+//! mutable borrow and owned values (the shape of `Enumerate::next` over a
+//! lending iterator: `Option<(usize, &'a mut T)>`). The backward function of
+//! the call consumes the whole `Option` (a nominal ADT), including the tuple's
+//! owned fields; the loop continuation used to drop those fields, which
+//! stopped the translation with an internal error in
+//! `SymbolicToPureValues.gtranslate_adt_fields`. They are now retained as
+//! meta-values, as for the fields of a nominal ADT.
+//! `LoopOptionTupleLoan/Checks.lean` evaluates the models on the inputs of the
+//! `native` test module below and compares with the native results, including
+//! the slices after the loops.
+
+/// `Enumerate::next` over a mutable slice iterator, by hand.
+pub fn next_pair<'a>(it: &mut std::slice::IterMut<'a, u32>, i: &mut usize) -> Option<(usize, &'a mut u32)> {
+    match it.next() {
+        Some(x) => {
+            let k = *i;
+            *i += 1;
+            Some((k, x))
+        }
+        None => None,
+    }
+}
+
+/// Adds its position to every element.
+pub fn add_positions(v: &mut [u32]) {
+    let mut it = v.iter_mut();
+    let mut i = 0;
+    while let Some((k, x)) = next_pair(&mut it, &mut i) {
+        *x += k as u32;
+    }
+}
+
+/// The borrow first, then an owned flag.
+pub fn next_flagged<'a>(it: &mut std::slice::IterMut<'a, u32>, limit: u32) -> Option<(&'a mut u32, bool)> {
+    match it.next() {
+        Some(x) => {
+            let big = *x > limit;
+            Some((x, big))
+        }
+        None => None,
+    }
+}
+
+/// Doubles the elements up to `limit`, stops at the first one above it (given
+/// back unchanged), and returns how many were doubled.
+pub fn double_small(v: &mut [u32], limit: u32) -> u32 {
+    let mut it = v.iter_mut();
+    let mut n = 0;
+    while let Some((x, big)) = next_flagged(&mut it, limit) {
+        if big {
+            break;
+        }
+        *x *= 2;
+        n += 1;
+    }
+    n
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn add_positions_adds_the_index() {
+        let mut v = [1, 2, 3];
+        add_positions(&mut v);
+        assert_eq!(v, [1, 3, 5]);
+        let mut e: [u32; 0] = [];
+        add_positions(&mut e);
+        assert_eq!(e, []);
+    }
+
+    #[test]
+    fn double_small_stops_at_the_first_big_element() {
+        let mut v = [1, 2, 9, 3];
+        assert_eq!(double_small(&mut v, 5), 2);
+        assert_eq!(v, [2, 4, 9, 3]);
+        let mut v = [1, 2];
+        assert_eq!(double_small(&mut v, 5), 2);
+        assert_eq!(v, [2, 4]);
+    }
+}
