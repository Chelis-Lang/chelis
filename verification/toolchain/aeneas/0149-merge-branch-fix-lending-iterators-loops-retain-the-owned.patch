+import LoopOptionTupleLoan.LoopOptionTupleLoan
+
+/-! Evaluate the model of `tests/src/loop-option-tuple-loan.rs` on the inputs of its
+    `native` test module and compare with the native results, including the
+    slices after the loops. -/
+
+namespace loop_option_tuple_loan.checks
+open Aeneas Aeneas.Std Result
+
+def u (n : Nat) : U32 := ⟨BitVec.ofNat _ n⟩
+
+def slice (xs : List Nat) : Slice U32 :=
+  let xs := xs.map u
+  if h : xs.length ≤ Usize.max then ⟨xs, h⟩ else ⟨[], by simp⟩
+
+def addPositionsR (xs : List Nat) : Option (List Nat) :=
+  match add_positions (slice xs) with
+  | ok s => some (s.val.map (·.val))
+  | _ => none
+
+#guard addPositionsR [1, 2, 3] == some [1, 3, 5]
+#guard addPositionsR [] == some []
+
+def doubleSmallR (xs : List Nat) (limit : Nat) : Option (Nat × List Nat) :=
+  match double_small (slice xs) (u limit) with
+  | ok (n, s) => some (n.val, s.val.map (·.val))
+  | _ => none
+
+#guard doubleSmallR [1, 2, 9, 3] 5 == some (2, [2, 4, 9, 3])
+#guard doubleSmallR [1, 2] 5 == some (2, [2, 4])
+
+end loop_option_tuple_loan.checks
