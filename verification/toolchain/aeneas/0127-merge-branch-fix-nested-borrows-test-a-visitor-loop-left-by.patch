+/// `(calls, acc, flag)` after visiting `[a, b, c]` up to the first value which
+/// is not an expression, then adding 100 to `acc` and negating `flag` through
+/// the borrows given back by the call
+pub fn run_visit_loop_until(a: u32, ea: bool, b: u32, eb: bool, c: u32, ec: bool, acc: u32) -> (u32, u32, bool) {
+    let m = sample(a, ea, b, eb, c, ec);
+    let mut acc = acc;
+    let mut flag = false;
+    let calls = {
+        let acc_ref = &mut acc;
+        let flag_ref = &mut flag;
+        let calls = visit_loop_until(&m, acc_ref, flag_ref);
+        *acc_ref = acc_ref.wrapping_add(100);
+        *flag_ref = !*flag_ref;
+        calls
+    };
+    (calls, acc, flag)
+}
