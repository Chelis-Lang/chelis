+/// The same loop, left at the first value which is not an expression while
+/// both closures are live (the context at the `break` is joined with the fixed
+/// point of the loop); the caller writes through both borrows after the call
+pub fn visit_loop_until(m: &Meta, acc: &mut u32, flag: &mut bool) -> u32 {
+    let mut count = |e: &Expr| {
+        *acc = acc.wrapping_add(e.n);
+        *flag |= e.n > 3;
+    };
+    let mut calls = 0u32;
+    let mut visit = |e: &Expr| {
+        calls += 1;
+        count(e);
+    };
+    for value in m.values.iter() {
+        match value {
+            MetaValue::Type(e) => visit(e),
+            MetaValue::Other(_) => break,
+        }
+    }
+    calls
+}
