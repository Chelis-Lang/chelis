+/-- `<[T]>::sort_by` (alloc/src/slice.rs): `stable_sort(self, |a, b| compare(a, b) == Less)`
+ (driftsort). Natively, the sequence of comparisons is unspecified, and the result is
+ unspecified (or a panic) when `compare` is not a total order. Aeneas admits a call only
+ where `compare` is a closure returning `Ord::cmp` of the same key of its two arguments, a
+ key projected from the argument without computation (llbc/SortContracts.ml), on a key type
+ as for `sort_unstable`: the comparator is pure and a total preorder, so the stable order
+ is unique and this merge sort returns the native result. -/
+@[rust_fun "alloc::slice::{[@T]}::sort_by"]
+def Slice.sort_by {T F : Type}
+    (fnInst : core.ops.function.FnMut F (T × T) Ordering) (self : Std.Slice T) (compare : F) :
+    Result (Unit × Std.Slice T × F) := do
+  let (out, compare) ← stableSort (fun compare x y => do
+    let (order, compare) ← fnInst.call_mut compare (x, y)
+    return (order matches .lt, compare)) self.val compare
+  return ((), ⟨out.val, by rw [out.property]; exact self.property⟩, compare)
+
 end alloc.slice
 
