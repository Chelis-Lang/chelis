+  "alloc::collections::vec_deque::{alloc::collections::vec_deque::VecDeque<@T, @A>}::push_back"
+  (keepParams := [true, false])]
+def VecDeque.push_back {T : Type} (self : VecDeque T) (value : T) : Result (VecDeque T) :=
+  if self.items.length < Usize.max then .ok ⟨self.items ++ [value]⟩
+  else .fail .maximumSizeExceeded
+
+/-- `VecDeque::push_front`: as `push_back`, the value written before the first element. -/
+@[rust_fun
+  "alloc::collections::vec_deque::{alloc::collections::vec_deque::VecDeque<@T, @A>}::push_front"
+  (keepParams := [true, false])]
+def VecDeque.push_front {T : Type} (self : VecDeque T) (value : T) : Result (VecDeque T) :=
+  if self.items.length < Usize.max then .ok ⟨value :: self.items⟩
+  else .fail .maximumSizeExceeded
+
+/-- `VecDeque::pop_front`: `None` when empty, else the front element, removed. -/
+@[rust_fun
+  "alloc::collections::vec_deque::{alloc::collections::vec_deque::VecDeque<@T, @A>}::pop_front"
+  (keepParams := [true, false])]
+def VecDeque.pop_front {T : Type} (self : VecDeque T) : Result (Option T × VecDeque T) :=
+  match self.items with
+  | [] => .ok (none, self)
+  | item :: rest => .ok (some item, ⟨rest⟩)
+
+/-- `VecDeque::pop_back`: `None` when empty, else the back element, removed. -/
+@[rust_fun
+  "alloc::collections::vec_deque::{alloc::collections::vec_deque::VecDeque<@T, @A>}::pop_back"
+  (keepParams := [true, false])]
+def VecDeque.pop_back {T : Type} (self : VecDeque T) : Result (Option T × VecDeque T) :=
+  match self.items.getLast? with
+  | none => .ok (none, self)
+  | some item => .ok (some item, ⟨self.items.dropLast⟩)
+
+/-- `VecDeque::front`: the first element, `None` when empty. -/
+@[rust_fun "alloc::collections::vec_deque::{alloc::collections::vec_deque::VecDeque<@T, @A>}::front"
+  (keepParams := [true, false])]
+def VecDeque.front {T : Type} (self : VecDeque T) : Result (Option T) :=
+  .ok self.items.head?
+
+/-- `VecDeque::back`: the last element, `None` when empty. -/
+@[rust_fun "alloc::collections::vec_deque::{alloc::collections::vec_deque::VecDeque<@T, @A>}::back"
+  (keepParams := [true, false])]
+def VecDeque.back {T : Type} (self : VecDeque T) : Result (Option T) :=
+  .ok self.items.getLast?
+
+end alloc.collections.vec_deque
+
+end Aeneas.Std
