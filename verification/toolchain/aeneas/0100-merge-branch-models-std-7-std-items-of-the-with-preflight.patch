     (_keyOrd : core.cmp.Ord K) (ord : core.cmp.Ord Q) (map : BTreeMap K V)
     (query : Q) : Result (Option V) := getList borrow ord query map.entries
 
+/-- The entries around the value selected by `get`'s search: the entries before it
+    (in order), its key and value, and the entries after it. -/
+def getMutList {K V Q : Type} (borrow : core.borrow.Borrow K Q) (ord : core.cmp.Ord Q)
+    (query : Q) (beforeRev : List (K × V)) :
+    List (K × V) → Result (Option (List (K × V) × K × V × List (K × V)))
+  | [] => .ok none
+  | (key, value) :: rest => do
+    match ← ord.cmp query (← borrow.borrow key) with
+    | .lt => .ok none
+    | .eq => .ok (some (beforeRev.reverse, key, value, rest))
+    | .gt => getMutList borrow ord query ((key, value) :: beforeRev) rest
+
+/-- `BTreeMap::get_mut` (btree/map.rs): `search_tree` as for `get`; the value of the
+    found entry, borrowed mutably. The backward function writes the final value of
+    that borrow in place, keeping the stored key and every other entry. -/
+@[rust_fun "alloc::collections::btree::map::{alloc::collections::btree::map::BTreeMap<@K, @V, @A>}::get_mut"
+  (keepParams := [true, true, false, true]) (keepTraitClauses := [false, true, true, true])]
+def BTreeMap.get_mut {K V Q : Type} (borrow : core.borrow.Borrow K Q)
+    (_keyOrd : core.cmp.Ord K) (ord : core.cmp.Ord Q) (map : BTreeMap K V)
+    (query : Q) : Result (Option V × (Option V → BTreeMap K V)) := do
+  match ← getMutList borrow ord query [] map.entries with
+  | none => .ok (none, fun _ => map)
+  | some (before, key, value, after) =>
+    .ok (some value, fun
+      | some value => ⟨before ++ (key, value) :: after⟩
+      | none => map)
+
