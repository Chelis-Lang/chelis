+//! A collection nested in a recursive type through the parameter of another
+//! recursive type: the field of `D::Node` has the carrier type
+//! `L<NestedVec<D>>`, and converting a value of type `L<Vec<D>>` to it would
+//! need a recursive function. The Lean backend rejects the constructor with an
+//! explicit error naming the two types, at the span of the function.
+
+pub enum L<T> {
+    Nil,
+    Cons(T, Box<L<T>>),
+}
+
+pub enum D {
+    Leaf(u32),
+    Node(L<Vec<D>>),
+}
+
+pub fn node(l: L<Vec<D>>) -> D {
+    D::Node(l)
+}
