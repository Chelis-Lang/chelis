+    match r with
+    | RVar (Free rid) -> (
+        match RegionId.Map.find_opt rid group_of_region with
+        | Some g -> g
+        | None -> RegionGroupId.of_int (-1))
+    | _ -> RegionGroupId.of_int (-1)
+  in
+  match groups with
+  | [] -> false
+  | (_, abs) :: _ -> (
