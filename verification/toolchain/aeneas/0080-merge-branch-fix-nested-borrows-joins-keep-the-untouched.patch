+//@ [!lean] skip
+//@ [lean] subdir=NestedBorrowsUntouchedJoin
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::iter::adapters::map::Map
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! A join of contexts which all hold the same levels of a staged function
+//! call. `map_node` collects the dimensions of a node through a closure which
+//! captures `resolve: &mut F`, with `F` a closure which captures a mutable
+//! borrow: the backward functions of `map` for the regions of `F` are staged
+//! (the `Map` it returns holds the closure), and `collect` consumes that `Map`.
+//! The `_` arm of the match on the kind covers three variants, whose entry
+//! contexts are joined while these calls are pending. No branch modifies
+//! them: the join keeps them unchanged instead of ending the levels which can
+//! end in every branch separately (the values those give back are fresh in
+//! every branch, and the remaining levels would be merged into a join
+//! abstraction whose continuation holds the staged call before its earlier
+//! stages are applied). The shape of `map_node_symbolic_bindings` and
+//! `required_prebinding_symbols` in chelis-ir's dag.rs.
+
+#[derive(Clone)]
+pub enum DimInfo {
+    Lit(usize),
+    Named(u32, Option<usize>),
+}
+
+pub enum Kind {
+    A,
+    B(u32),
+    C,
+    D(u32),
+}
+
+pub struct Node {
+    pub dims: Vec<DimInfo>,
+    pub kind: Kind,
+}
+
+fn map_node<E>(
+    node: &Node,
+    resolve: &mut impl FnMut(&u32) -> Result<Option<usize>, E>,
+) -> Result<(Vec<DimInfo>, u32), E> {
+    let dims = node
+        .dims
+        .iter()
+        .map(|dim| match dim {
+            DimInfo::Named(name, None) => Ok(DimInfo::Named(*name, resolve(name)?)),
+            other => Ok(other.clone()),
+        })
+        .collect::<Result<Vec<DimInfo>, E>>()?;
+    match &node.kind {
+        Kind::B(x) => Ok((dims, *x)),
+        _ => Ok((dims, 3)),
+    }
+}
+
+/// The names other than `k` which the nodes need (the shape of
+/// `required_prebinding_symbols` in chelis-ir's dag.rs).
+pub fn required(nodes: &Vec<Node>, k: u32) -> Vec<u32> {
+    let mut required = Vec::new();
+    for node in nodes.iter() {
+        let observed = map_node(node, &mut |name| {
+            if *name != k {
+                required.push(*name);
+            }
+            Ok::<_, std::convert::Infallible>(None)
+        });
+        match observed {
+            Ok(_) => {}
+            Err(never) => match never {},
+        }
+    }
+    required
+}
+
+/// The dimensions of a node, with `k` resolved to `v`, and the kind; the name
+/// `bad` fails instead (no dimensions, and `bad` for the kind). Also the
+/// number of names resolved.
+pub fn resolved(node: &Node, k: u32, v: usize, bad: u32) -> (Vec<DimInfo>, u32, u32) {
+    let mut calls = 0u32;
+    let observed = map_node(node, &mut |name| {
+        calls = calls.wrapping_add(1);
+        if *name == bad {
+            return Err(*name);
+        }
+        Ok(if *name == k { Some(v) } else { None })
+    });
+    match observed {
+        Ok((dims, e)) => (dims, e, calls),
+        Err(name) => (Vec::new(), name, calls),
+    }
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    fn node(dims: Vec<DimInfo>, kind: Kind) -> Node {
+        Node { dims, kind }
+    }
+
+    fn named(dims: &[DimInfo]) -> Vec<(u32, Option<usize>)> {
+        dims.iter()
+            .map(|d| match d {
+                DimInfo::Lit(n) => (u32::MAX, Some(*n)),
+                DimInfo::Named(name, v) => (*name, *v),
+            })
+            .collect()
+    }
+
+    #[test]
+    fn required_native() {
+        let nodes = vec![
+            node(vec![DimInfo::Named(1, None), DimInfo::Lit(4)], Kind::B(10)),
+            node(vec![DimInfo::Named(2, None), DimInfo::Named(3, Some(5))], Kind::A),
+            node(vec![DimInfo::Named(7, None)], Kind::D(20)),
+            node(vec![], Kind::C),
+        ];
+        assert_eq!(required(&nodes, 2), vec![1, 7]);
+        assert_eq!(required(&nodes, 9), vec![1, 2, 7]);
+        assert_eq!(required(&vec![], 0), vec![]);
+    }
+
+    #[test]
+    fn resolved_native() {
+        let n = node(
+            vec![DimInfo::Named(1, None), DimInfo::Lit(4), DimInfo::Named(2, None), DimInfo::Named(1, Some(6))],
+            Kind::B(10),
+        );
+        let (dims, e, calls) = resolved(&n, 1, 8, 99);
+        assert_eq!(
+            (named(&dims), e, calls),
+            (vec![(1, Some(8)), (u32::MAX, Some(4)), (2, None), (1, Some(6))], 10, 2)
+        );
+        let (dims, e, calls) = resolved(&n, 1, 8, 2);
+        assert_eq!((named(&dims), e, calls), (vec![], 2, 2));
+        let n = node(vec![DimInfo::Named(2, None)], Kind::C);
+        let (dims, e, calls) = resolved(&n, 2, 5, 99);
+        assert_eq!((named(&dims), e, calls), (vec![(2, Some(5))], 3, 1));
+        let n = node(vec![DimInfo::Named(5, None), DimInfo::Lit(1)], Kind::D(7));
+        let (dims, e, calls) = resolved(&n, 5, 9, 99);
+        assert_eq!((named(&dims), e, calls), (vec![(5, Some(9)), (u32::MAX, Some(1))], 3, 1));
+        let (dims, e, calls) = resolved(&node(vec![], Kind::A), 5, 9, 99);
+        assert_eq!((named(&dims), e, calls), (vec![], 3, 0));
+    }
+}
