+
+/-! Evaluate the model of `tests/src/nested-borrows-untouched-join.rs` on the
+    inputs of its `native` test module and compare with the native results. -/
+
+namespace nested_borrows_untouched_join.checks
+open Aeneas Aeneas.Std Result
+
+def u (x : Nat) : U32 := ⟨BitVec.ofNat _ x⟩
+def us (x : Nat) : Usize := ⟨BitVec.ofNat _ x⟩
+def vec {α} (xs : List α) (h : xs.length ≤ Usize.max := by scalar_tac) : alloc.vec.Vec α := ⟨xs, h⟩
+
+def lit (n : Nat) : DimInfo := .Lit (us n)
+def named (n : Nat) (v : Option Nat := none) : DimInfo := .Named (u n) (v.map us)
+def node (dims : List DimInfo) (kind : Kind) (h : dims.length ≤ Usize.max := by scalar_tac) : Node :=
+  { dims := vec dims h, kind }
+
+def umax : Nat := 4294967295
+
+/-- The dimensions as the native test compares them: `(u32::MAX, Some(n))` for `Lit(n)` -/
+def dims (v : alloc.vec.Vec DimInfo) : List (Nat × Option Nat) :=
+  v.val.map fun
+    | .Lit n => (umax, some n.val)
+    | .Named n v => (n.val, v.map (·.val))
+
+def requiredR (nodes : alloc.vec.Vec Node) (k : Nat) : Option (List Nat) :=
+  match required nodes (u k) with
+  | ok names => some (names.val.map (·.val))
+  | _ => none
+
+def resolvedR (n : Node) (k v bad : Nat) : Option (List (Nat × Option Nat) × Nat × Nat) :=
+  match resolved n (u k) (us v) (u bad) with
+  | ok (ds, e, calls) => some (dims ds, e.val, calls.val)
+  | _ => none
+
+def nodes : alloc.vec.Vec Node := vec
+  [ node [named 1, lit 4] (.B (u 10)),
+    node [named 2, named 3 (some 5)] .A,
+    node [named 7] (.D (u 20)),
+    node [] .C ]
+
+-- required_native
+#guard requiredR nodes 2 == some [1, 7]
+#guard requiredR nodes 9 == some [1, 2, 7]
+#guard requiredR (vec []) 0 == some []
+
+-- resolved_native
+def n1 : Node := node [named 1, lit 4, named 2, named 1 (some 6)] (.B (u 10))
+#guard resolvedR n1 1 8 99 == some ([(1, some 8), (umax, some 4), (2, none), (1, some 6)], 10, 2)
+#guard resolvedR n1 1 8 2 == some ([], 2, 2)
+#guard resolvedR (node [named 2] .C) 2 5 99 == some ([(2, some 5)], 3, 1)
+#guard resolvedR (node [named 5, lit 1] (.D (u 7))) 5 9 99 == some ([(5, some 9), (umax, some 1)], 3, 1)
+#guard resolvedR (node [] .A) 5 9 99 == some ([], 3, 0)
+
+end nested_borrows_untouched_join.checks
