+    [eval_function_call_symbolic_from_inst_sig]: their values are the
+    projections of the inputs and of the output, whose types are those of the
+    instantiated signature, and their regions are those of their groups. *)
+let fun_call_is_staged (ctx : eval_ctx) (call : abs list) : bool =
+  (* The stage map is a property of the types: it only reads [type_ctx] *)
+  let decls_ctx : decls_ctx =
+    {
+      crate = ctx.crate;
+      graph_of_uses =
+        { graph = AnyDeclIdMap.empty; locals = AnyDeclIdSet.empty };
+      type_ctx = ctx.type_ctx;
+      fun_ctx = ctx.fun_ctx;
+      global_decls_to_extract = GlobalDeclId.Map.empty;
+      trait_decls_to_extract = TraitDeclId.Map.empty;
+      trait_impls_to_extract = TraitImplId.Map.empty;
+    }
+  in
+  let groups =
+    List.filter_map
+      (fun (abs : abs) ->
+        match abs.kind with
+        | FunCall (_, gid) -> Some (gid, abs)
+        | _ -> None)
+      call
+  in
+  let group_of_region =
+    List.fold_left
+      (fun map (gid, (abs : abs)) ->
+        RegionId.Set.fold
+          (fun rid map -> RegionId.Map.add rid gid map)
+          abs.regions.owned map)
+      RegionId.Map.empty groups
+  in
