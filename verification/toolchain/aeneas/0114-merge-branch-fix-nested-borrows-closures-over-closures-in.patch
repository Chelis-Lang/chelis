+import NestedBorrowsClosureVisitor.NestedBorrowsClosureVisitor
+
+/-! Evaluate the model of `tests/src/nested-borrows-closure-visitor.rs` on
+    the inputs of its `native` test module and compare with the native results
+    (the counter of the visiting closure, and the values given back to the two
+    borrows of the caller which the inner closure captures, after the caller
+    used the inner closure again). -/
+
+namespace nested_borrows_closure_visitor.checks
+open Aeneas Aeneas.Std Result
+
+def u (x : Nat) : U32 := ⟨BitVec.ofNat _ x⟩
+
+def max := 4294967295
+
+def runVisitJoin (a : Nat) (ea : Bool) (b : Nat) (eb : Bool) (acc : Nat) :
+    Option (Nat × Nat × Bool) :=
+  match run_visit_join (u a) ea (u b) eb (u acc) with
+  | ok (calls, acc', flag) => some (calls.val, acc'.val, flag)
+  | _ => none
+
+#guard runVisitJoin 1 true 2 true 10 == some (2, 15, false)
+#guard runVisitJoin 5 true 2 false 10 == some (1, 17, true)
+#guard runVisitJoin 5 false 9 true 0 == some (1, 11, true)
+#guard runVisitJoin 5 false 9 false 7 == some (0, 9, false)
+#guard runVisitJoin max true 1 true 0 == some (2, 2, true)
+
+end nested_borrows_closure_visitor.checks
