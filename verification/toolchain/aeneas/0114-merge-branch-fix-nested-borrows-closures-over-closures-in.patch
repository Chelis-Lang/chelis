+++ b/tests/src/nested-borrows-closure-visitor.rs
@@ -0,0 +1,93 @@
+//@ [!lean] skip
+//@ [lean] subdir=NestedBorrowsClosureVisitor
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! A visiting closure which captures a counter and another closure, which
+//! captures two mutable borrows of the caller, called in two branches (the
+//! shape of the closures of `visit_semantic_expr_children` in chelis_ir
+//! `host.rs`, over the closures of `collect_dynamic_to_tensor_def_refs`, called
+//! by `Metadata::visit_expressions` in chelis_deep `annotations.rs`): the
+//! regions of the inner borrows are nested under three borrows in the calls of
+//! the visiting closure.
+//!
+//! - The value given back to the visiting closure at level 1 holds the
+//!   reborrow of the inner closure, a loan of another region which was not
+//!   ended: it is not a level boundary of the continuation of the call.
+//! - The join abstractions of the inner regions route the value given back to
+//!   the inner closure (their pending loans) through the first stage of the
+//!   backward function of `call_mut`, whose input is the visiting closure
+//!   which holds it.
+//! - That value is given back after the join abstractions end their level 1:
+//!   the first stage is applied when their level 0 ends, and the values it
+//!   gives back are bound then.
+
+pub struct Expr {
+    pub n: u32,
+}
+
+pub enum MetaValue {
+    Type(Expr),
+    Other(u32),
+}
+
+pub struct Meta {
+    pub values: Vec<MetaValue>,
+}
+
+/// Counts the visited expressions, sums them into `acc` and flags the large
+/// ones; then uses the inner closure again (the values given back to its
+/// captures after the visits)
+pub fn visit_join(m: &Meta, acc: &mut u32, flag: &mut bool) -> u32 {
+    let mut count = |e: &Expr| {
+        *acc = acc.wrapping_add(e.n);
+        *flag |= e.n > 3;
+    };
+    let mut calls = 0u32;
+    let mut visit = |e: &Expr| {
+        calls += 1;
+        count(e);
+    };
+    if let MetaValue::Type(e) = &m.values[0] {
+        visit(e);
+    }
+    if let MetaValue::Type(e) = &m.values[1] {
+        visit(e);
+    }
+    count(&Expr { n: 2 });
+    calls
+}
+
+fn value(n: u32, expr: bool) -> MetaValue {
+    if expr {
+        MetaValue::Type(Expr { n })
+    } else {
+        MetaValue::Other(n)
+    }
+}
+
+/// `(calls, acc, flag)` after visiting `[a, b]` (`ea`, `eb`: whether they are
+/// expressions)
+pub fn run_visit_join(a: u32, ea: bool, b: u32, eb: bool, acc: u32) -> (u32, u32, bool) {
+    let mut values = Vec::new();
+    values.push(value(a, ea));
+    values.push(value(b, eb));
+    let m = Meta { values };
+    let mut acc = acc;
+    let mut flag = false;
+    let calls = visit_join(&m, &mut acc, &mut flag);
+    (calls, acc, flag)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
