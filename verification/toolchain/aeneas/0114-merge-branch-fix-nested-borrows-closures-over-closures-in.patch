diff --git a/src/extract/ExtractBase.ml b/src/extract/ExtractBase.ml
index d1cb7f9..7f4c4e3 100644
--- a/src/extract/ExtractBase.ml
+++ b/src/extract/ExtractBase.ml
@@ -4,7 +4,24 @@ open Contexts
 open Pure
 open StringUtils
 open Config
-module F = Format
+
+(** [Format], with strings measured in characters instead of bytes: the output
+    is UTF-8, and Lean reads its columns in characters. The layout of some terms
+    depends on the columns, e.g., the body of a [let] on its own line must not
+    be indented deeper than the [let] (it would continue the bound value), which
+    happened after the multi-byte symbols ([→], [×], [⟨], ...) of the same
+    line. *)
+module F = struct
+  include Format
+
+  let pp_print_string (fmt : formatter) (s : string) : unit =
+    let width = ref 0 in
+    String.iter
+      (fun c -> if Char.code c land 0xC0 <> 0x80 then incr width)
+      s;
+    pp_print_as fmt !width s
+end
+
 open ExtractBuiltin
 open TranslateCore
 
