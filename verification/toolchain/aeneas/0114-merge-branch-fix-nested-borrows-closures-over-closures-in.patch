diff --git a/tests/src/nested-borrows-closure-visitor-fn.rs b/tests/src/nested-borrows-closure-visitor-fn.rs
new file mode 100644
index 0000000..42b3793
--- /dev/null
+++ b/tests/src/nested-borrows-closure-visitor-fn.rs
@@ -0,0 +1,169 @@
+//@ [!lean] skip
+//@ [lean] subdir=NestedBorrowsClosureVisitorFn
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! A visitor over metadata which receives `visit: &mut impl FnMut(&Expr, u8)`
+//! and calls it in a loop and recursively (the shape of
+//! `Metadata::visit_expressions` in chelis_deep `annotations.rs`, called by
+//! `visit_semantic_expr_children` in chelis_ir `host.rs`), instantiated with a
+//! closure which captures a counter and another closure, which captures two
+//! mutable borrows of the caller: the regions of those borrows are nested under
+//! three borrows in the visitor.
+//!
+//! In the backward function of the region of one of the inner borrows, the
+//! loop abstraction of the region of the reborrow of the inner closure applies
+//! its continuation to the value given back to the ancestor's borrow, which
+//! this backward function does not receive: the application is deferred (never
+//! emitted), and the value it gives back, the base of the recombination of the
+//! value given back to the parent borrow of the loop abstraction of the inner
+//! region, is carried by the value this region's own projector gives back.
+
+pub struct Expr {
+    pub n: u32,
+}
+
+pub enum MetaValue {
+    Type(Expr),
+    Nested(Meta),
+}
+
+pub struct Meta {
+    pub values: Vec<MetaValue>,
+}
+
+impl Meta {
+    pub fn visit_expressions<'a>(&'a self, visit: &mut impl FnMut(&'a Expr, u8)) {
+        for value in self.values.iter() {
+            match value {
+                MetaValue::Type(v) => visit(v, 0),
+                MetaValue::Nested(m) => m.visit_expressions(visit),
+            }
+        }
+    }
+
+    /// The same visitor with a join after each call instead of a loop
+    pub fn visit_first_two<'a>(&'a self, visit: &mut impl FnMut(&'a Expr, u8)) {
+        match &self.values[0] {
+            MetaValue::Type(v) => visit(v, 0),
+            MetaValue::Nested(_) => {}
+        }
+        if let MetaValue::Type(v) = &self.values[1] {
+            visit(v, 1);
+        }
+    }
+}
+
+/// Counts the visited expressions, sums them into `acc` and flags the large
+/// ones; then uses the inner closure again (the values given back to its
+/// captures after the visit)
+pub fn visit_meta(m: &Meta, acc: &mut u32, flag: &mut bool) -> u32 {
+    let mut count = |e: &Expr| {
+        *acc = acc.wrapping_add(e.n);
+        *flag |= e.n > 3;
+    };
+    let mut calls = 0u32;
+    m.visit_expressions(&mut |e, _| {
+        calls += 1;
+        count(e);
+    });
+    count(&Expr { n: 2 });
+    calls
+}
+
+pub fn visit_meta_two(m: &Meta, acc: &mut u32, flag: &mut bool) -> u32 {
+    let mut count = |e: &Expr| {
+        *acc = acc.wrapping_add(e.n);
+        *flag |= e.n > 3;
+    };
+    let mut calls = 0u32;
+    m.visit_first_two(&mut |e, _| {
+        calls += 1;
+        count(e);
+    });
+    count(&Expr { n: 2 });
+    calls
+}
+
+fn leaf(n: u32) -> MetaValue {
+    MetaValue::Type(Expr { n })
+}
+
+/// `[a, [b], c]`
+fn sample(a: u32, b: u32, c: u32) -> Meta {
+    let mut inner = Vec::new();
+    inner.push(leaf(b));
+    let mut values = Vec::new();
+    values.push(leaf(a));
+    values.push(MetaValue::Nested(Meta { values: inner }));
+    values.push(leaf(c));
+    Meta { values }
+}
+
+/// `(calls, acc, flag)`
+pub fn run_visit(a: u32, b: u32, c: u32, acc: u32) -> (u32, u32, bool) {
+    let m = sample(a, b, c);
+    let mut acc = acc;
+    let mut flag = false;
+    let calls = visit_meta(&m, &mut acc, &mut flag);
+    (calls, acc, flag)
+}
+
+/// `(calls, acc, flag)` on `[a, b]` (`nested`: `[a, [b]]`)
+pub fn run_visit_two(a: u32, b: u32, nested: bool, acc: u32) -> (u32, u32, bool) {
+    let mut values = Vec::new();
+    values.push(leaf(a));
+    if nested {
+        let mut inner = Vec::new();
+        inner.push(leaf(b));
+        values.push(MetaValue::Nested(Meta { values: inner }));
+    } else {
+        values.push(leaf(b));
+    }
+    let m = Meta { values };
+    let mut acc = acc;
+    let mut flag = false;
+    let calls = visit_meta_two(&m, &mut acc, &mut flag);
+    (calls, acc, flag)
+}
+
+/// `(calls, acc, flag)` after visiting `[a, [b], c]`, then adding 100 to `acc`
+/// and negating `flag` through the borrows given back by the call
+pub fn run_visit_then(a: u32, b: u32, c: u32, acc: u32) -> (u32, u32, bool) {
+    let m = sample(a, b, c);
+    let mut acc = acc;
+    let mut flag = false;
+    let calls = {
+        let acc_ref = &mut acc;
+        let flag_ref = &mut flag;
+        let calls = visit_meta(&m, acc_ref, flag_ref);
+        *acc_ref = acc_ref.wrapping_add(100);
+        *flag_ref = !*flag_ref;
+        calls
+    };
+    (calls, acc, flag)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn run_visit_native() {
+        assert_eq!(run_visit(1, 2, 3, 10), (3, 18, false));
+        assert_eq!(run_visit(1, 7, 3, 0), (3, 13, true));
+        assert_eq!(run_visit(u32::MAX, 1, 0, 0), (3, 2, true));
+    }
+
+    #[test]
+    fn run_visit_then_native() {
+        assert_eq!(run_visit_then(1, 2, 3, 10), (3, 118, true));
+        assert_eq!(run_visit_then(1, 7, 3, 0), (3, 113, false));
+    }
+
+    #[test]
+    fn run_visit_two_native() {
+        assert_eq!(run_visit_two(1, 2, false, 10), (2, 15, false));
+        assert_eq!(run_visit_two(5, 2, true, 10), (1, 17, true));
+        assert_eq!(run_visit_two(1, 9, false, 0), (2, 12, true));
+    }
+}
diff --git a/tests/src/nested-borrows-closure-visitor-loop.rs b/tests/src/nested-borrows-closure-visitor-loop.rs
new file mode 100644
index 0000000..7df0480
--- /dev/null
+++ b/tests/src/nested-borrows-closure-visitor-loop.rs
@@ -0,0 +1,140 @@
+//@ [!lean] skip
+//@ [lean] subdir=NestedBorrowsClosureVisitorLoop
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! A visiting closure which captures a counter and another closure, which
+//! captures two mutable borrows of the caller, called in a loop (the loop form
+//! of `nested-borrows-closure-visitor`: `Metadata::visit_expressions` in
+//! chelis_deep `annotations.rs` loops over the metadata values): the regions of
+//! the inner borrows are nested under three borrows in the calls of the
+//! visiting closure.
+//!
+//! The body of the loop expands the inner closure (behind the reborrow held by
+//! the visiting closure) and its fields, the references of the two regions:
+//! the loop abstraction of each region holds the reference of the other region
+//! as the snapshot of a position it does not own, which is only bound in the
+//! body. After the loop, the translation uses the value it was expanded to (an
+//! output of the loop).
+
+pub struct Expr {
+    pub n: u32,
+}
+
+pub enum MetaValue {
+    Type(Expr),
+    Other(u32),
+}
+
+pub struct Meta {
+    pub values: Vec<MetaValue>,
+}
+
+/// Counts the visited expressions, sums them into `acc` and flags the large
+/// ones; then uses the inner closure again (the values given back to its
+/// captures after the loop)
+pub fn visit_loop(m: &Meta, acc: &mut u32, flag: &mut bool) -> u32 {
+    let mut count = |e: &Expr| {
+        *acc = acc.wrapping_add(e.n);
+        *flag |= e.n > 3;
+    };
+    let mut calls = 0u32;
+    let mut visit = |e: &Expr| {
+        calls += 1;
+        count(e);
+    };
+    for value in m.values.iter() {
+        if let MetaValue::Type(e) = value {
+            visit(e);
+        }
+    }
+    count(&Expr { n: 2 });
+    calls
+}
+
+/// The same visit in a loop over the indices, which skips the values which
+/// are not expressions; the caller writes through both borrows after the call
+pub fn visit_loop_index(m: &Meta, acc: &mut u32, flag: &mut bool) -> u32 {
+    let mut count = |e: &Expr| {
+        *acc = acc.wrapping_add(e.n);
+        *flag |= e.n > 3;
+    };
+    let mut calls = 0u32;
+    let mut visit = |e: &Expr| {
+        calls += 1;
+        count(e);
+    };
+    let mut i = 0;
+    while i < m.values.len() {
+        match &m.values[i] {
+            MetaValue::Type(e) => visit(e),
+            MetaValue::Other(_) => {}
+        }
+        i += 1;
+    }
+    calls
+}
+
+fn value(n: u32, expr: bool) -> MetaValue {
+    if expr {
+        MetaValue::Type(Expr { n })
+    } else {
+        MetaValue::Other(n)
+    }
+}
+
+/// `[a, b, c]` (`ea`, `eb`, `ec`: whether they are expressions)
+fn sample(a: u32, ea: bool, b: u32, eb: bool, c: u32, ec: bool) -> Meta {
+    let mut values = Vec::new();
+    values.push(value(a, ea));
+    values.push(value(b, eb));
+    values.push(value(c, ec));
+    Meta { values }
+}
+
+/// `(calls, acc, flag)` after visiting `[a, b, c]`
+pub fn run_visit_loop(a: u32, ea: bool, b: u32, eb: bool, c: u32, ec: bool, acc: u32) -> (u32, u32, bool) {
+    let m = sample(a, ea, b, eb, c, ec);
+    let mut acc = acc;
+    let mut flag = false;
+    let calls = visit_loop(&m, &mut acc, &mut flag);
+    (calls, acc, flag)
+}
+
+/// `(calls, acc, flag)` after visiting `[a, b, c]` by index, then adding 100 to
+/// `acc` and negating `flag` through the borrows given back by the call
+pub fn run_visit_loop_index(a: u32, ea: bool, b: u32, eb: bool, c: u32, ec: bool, acc: u32) -> (u32, u32, bool) {
+    let m = sample(a, ea, b, eb, c, ec);
+    let mut acc = acc;
+    let mut flag = false;
+    let calls = {
+        let acc_ref = &mut acc;
+        let flag_ref = &mut flag;
+        let calls = visit_loop_index(&m, acc_ref, flag_ref);
+        *acc_ref = acc_ref.wrapping_add(100);
+        *flag_ref = !*flag_ref;
+        calls
+    };
+    (calls, acc, flag)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn run_visit_loop_native() {
+        assert_eq!(run_visit_loop(1, true, 2, true, 3, true, 10), (3, 18, false));
+        assert_eq!(run_visit_loop(5, true, 2, false, 9, true, 10), (2, 26, true));
+        assert_eq!(run_visit_loop(5, false, 9, false, 1, false, 7), (0, 9, false));
+        assert_eq!(run_visit_loop(u32::MAX, true, 1, true, 0, false, 0), (2, 2, true));
+    }
+
+    #[test]
+    fn run_visit_loop_index_native() {
+        assert_eq!(run_visit_loop_index(1, true, 2, true, 3, true, 10), (3, 116, true));
+        assert_eq!(run_visit_loop_index(5, true, 2, false, 9, true, 10), (2, 124, false));
+        assert_eq!(run_visit_loop_index(5, false, 9, true, 1, true, 7), (2, 117, false));
+        assert_eq!(run_visit_loop_index(u32::MAX, true, 4, true, 0, false, 0), (2, 103, false));
+        assert_eq!(run_visit_loop_index(1, false, 2, false, 3, false, 0), (0, 100, true));
+    }
+}
