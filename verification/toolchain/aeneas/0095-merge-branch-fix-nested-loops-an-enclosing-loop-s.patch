+#guard val2 (drive_nested_one 5#u32) == some (10, 1016)
+#guard val2 (drive_nested_one 40#u32) == some (45, 1051)
+#guard val3 (drive_nested3 0#u32 0#u64) == some (17, 11, 37)
+#guard val3 (drive_nested3 5#u32 7#u64) == some (22, 16, 49)
+#guard val3 (drive_nested3 40#u32 1000#u64) == some (57, 51, 1077)
