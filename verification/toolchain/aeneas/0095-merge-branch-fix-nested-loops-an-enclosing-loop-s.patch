diff --git a/tests/src/join-shared-proj-give-back.rs b/tests/src/join-shared-proj-give-back.rs
new file mode 100644
index 0000000..5f0cbde
--- /dev/null
+++ b/tests/src/join-shared-proj-give-back.rs
@@ -0,0 +1,181 @@
+//@ [!lean] skip
+//@ [lean] subdir=JoinSharedProjGiveBack
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::option::{core::ops::try_trait::Try} --include core::option::{core::ops::try_trait::FromResidual}
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! `let (Tag::TPrim, _, kids) = stamped_parts(expr)? else { .. }` then a
+//! `let .. = kids.first() else { .. }` (chelis_ir::lower::LowerCtx::try_extract_prim).
+//! Before the join of the `else` branches, each branch ends the abstraction of
+//! `branch` (the `?`), whose borrow projector over the result of `stamped_parts`
+//! holds shared borrows only; each gives back a fresh value to the loan
+//! projector of the abstraction of `stamped_parts`. The join must reconcile the
+//! two records of that given-back value, which no continuation consumes.
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+pub enum DeepTag {
+    Module,
+    Def,
+    App,
+    TPrim,
+    TRef,
+    Var,
+}
+
+pub struct Span {
+    pub start: u32,
+    pub end: u32,
+}
+
+pub enum Atom {
+    Name(String),
+    Tag(DeepTag),
+    Int(i64),
+    Bool(bool),
+}
+
+pub struct Storage {
+    pub entries: Vec<(String, u32)>,
+}
+
+pub struct Metadata {
+    pub storage: Option<Box<Storage>>,
+}
+
+pub struct Node {
+    pub tag: DeepTag,
+    pub meta: Metadata,
+    pub children: Vec<Expr>,
+}
+
+pub enum Expr {
+    Atom(Atom, Span),
+    Map(Metadata, Span),
+    Node(Box<Node>, Span),
+    BareList(Vec<Expr>, Span),
+}
+
+pub enum ExprCarrier<'a> {
+    DecodedNode(DeepTag, &'a Metadata, &'a [Expr]),
+    StructuralList(&'a [Expr]),
+    Atom(&'a Atom),
+    MetadataMap(&'a Metadata),
+}
+
+impl Expr {
+    pub fn carrier(&self) -> ExprCarrier<'_> {
+        match self {
+            Expr::Atom(a, _) => ExprCarrier::Atom(a),
+            Expr::Map(m, _) => ExprCarrier::MetadataMap(m),
+            Expr::Node(n, _) => ExprCarrier::DecodedNode(n.tag, &n.meta, &n.children),
+            Expr::BareList(v, _) => ExprCarrier::StructuralList(v),
+        }
+    }
+}
+
+pub enum Prim {
+    F32,
+    F64,
+}
+
+impl Prim {
+    pub fn parse_name(s: &str) -> Option<Prim> {
+        if s.is_empty() {
+            Some(Prim::F32)
+        } else if s.len() == 3 {
+            Some(Prim::F64)
+        } else {
+            None
+        }
+    }
+}
+
+fn stamped_parts(expr: &Expr) -> Option<(DeepTag, &Metadata, &[Expr])> {
+    match expr.carrier() {
+        ExprCarrier::DecodedNode(tag, metadata, children) => Some((tag, metadata, children)),
+        ExprCarrier::StructuralList(_) | ExprCarrier::Atom(_) | ExprCarrier::MetadataMap(_) => {
+            None
+        }
+    }
+}
+
+pub fn try_extract_prim(expr: &Expr) -> Option<Prim> {
+    let (DeepTag::TPrim, _, kids) = stamped_parts(expr)? else {
+        return None;
+    };
+    let Some(Expr::Atom(Atom::Name(name), _)) = kids.first() else {
+        return None;
+    };
+    Prim::parse_name(name)
+}
+
+fn code(p: Option<Prim>) -> u8 {
+    match p {
+        None => 0,
+        Some(Prim::F32) => 1,
+        Some(Prim::F64) => 2,
+    }
+}
+
+fn span() -> Span {
+    Span { start: 0, end: 0 }
+}
+
+fn node(tag: DeepTag, children: Vec<Expr>) -> Expr {
+    Expr::Node(
+        Box::new(Node {
+            tag,
+            meta: Metadata { storage: None },
+            children,
+        }),
+        span(),
+    )
+}
+
+/// 0: `(t-prim {} "")`, 1: `(t-ref {} "")`, 2: `(t-prim {} 7)`, 3: `(t-prim {})`,
+/// 4: an atom, 5: a metadata map, 6: `(t-prim {} f64)`, 7: `(t-ref {} f64)`,
+/// 8: `(t-prim {} f16x)`.
+pub fn make(which: u8) -> Expr {
+    if which == 0 {
+        node(DeepTag::TPrim, vec![Expr::Atom(Atom::Name(String::from("")), span())])
+    } else if which == 1 {
+        node(DeepTag::TRef, vec![Expr::Atom(Atom::Name(String::from("")), span())])
+    } else if which == 6 {
+        node(DeepTag::TPrim, vec![Expr::Atom(Atom::Name(String::from("f64")), span())])
+    } else if which == 7 {
+        node(DeepTag::TRef, vec![Expr::Atom(Atom::Name(String::from("f64")), span())])
+    } else if which == 8 {
+        node(DeepTag::TPrim, vec![Expr::Atom(Atom::Name(String::from("f16x")), span())])
+    } else if which == 2 {
+        node(DeepTag::TPrim, vec![Expr::Atom(Atom::Int(7), span())])
+    } else if which == 3 {
+        node(DeepTag::TPrim, Vec::new())
+    } else if which == 4 {
+        Expr::Atom(Atom::Bool(true), span())
+    } else {
+        Expr::Map(Metadata { storage: None }, span())
+    }
+}
+
+/// Extracts, then writes through a mutable borrow of the expression (retags a
+/// node as `t-prim`) and extracts again.
+pub fn drive(which: u8) -> (u8, u8) {
+    let mut e = make(which);
+    let before = code(try_extract_prim(&e));
+    let r = &mut e;
+    if let Expr::Node(n, _) = r {
+        n.tag = DeepTag::TPrim;
+    }
+    let after = code(try_extract_prim(&e));
+    (before, after)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn drives() {
+        for which in 0u8..9 {
+            println!("{} {:?}", which, drive(which));
+        }
+    }
+}
