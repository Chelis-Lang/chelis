+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Nested loops after a call on `&mut Cx<'_>`, where `Cx<'a>` holds `&'a mut`
+//! fields (the `HostCx` of `chelis_ir::host::cached_dynamic_to_tensor_def_summaries`).
+//! The abstraction of the outer loop for `'a` consumes a whole `Cx` (its
+//! continuation applies the backward function of the outer loop to a `Cx`),
+//! and the body of the outer loop expands its fields. The inner loop keeps that
+//! abstraction: its continuation must stay the one of the outer loop, not be
+//! recomputed from the loans of the fields (with two fields: "Expected an arrow
+//! type"; with one field: the backward function applied to the field).
+
+pub struct Cx<'a> {
+    pub state: &'a mut u32,
+    pub runtime: &'a mut u64,
+}
+
+pub struct CxOne<'a> {
+    pub state: &'a mut u32,
+}
+
+fn items(cx: &mut Cx<'_>) -> Vec<u32> {
+    *cx.state += 1;
+    vec![*cx.state, 2]
+}
+
+fn items_one(cx: &mut CxOne<'_>) -> Vec<u32> {
+    *cx.state += 1;
+    vec![*cx.state]
+}
+
+/// A call on `&mut Cx`, then two nested loops.
+pub fn nested(cx: &mut Cx<'_>) -> usize {
+    let xs = items(cx);
+    let mut out = Vec::new();
+    for x in xs.iter() {
+        let ys = vec![*x, 3];
+        for y in ys {
+            out.push(y);
+        }
+    }
+    out.len()
+}
+
+/// The same, then writes through the context after the loops.
+pub fn nested_then_write(cx: &mut Cx<'_>) -> u32 {
+    let xs = items(cx);
+    let mut sum = 0u32;
+    for x in xs.iter() {
+        let ys = vec![*x, 10];
+        for y in ys {
+            sum += y;
+        }
+    }
+    *cx.state += sum;
+    *cx.runtime += 100;
+    sum
+}
+
+/// A context with a single `&'a mut` field.
+pub fn nested_one(cx: &mut CxOne<'_>) -> u32 {
+    let xs = items_one(cx);
+    let mut sum = 0u32;
+    for x in xs.iter() {
+        let ys = vec![*x, 4];
+        for y in ys {
+            sum += y;
+        }
+    }
+    *cx.state += 1000;
+    sum
+}
+
+/// Three nested loops.
+pub fn nested3(cx: &mut Cx<'_>) -> u32 {
+    let xs = items(cx);
+    let mut sum = 0u32;
+    for x in xs.iter() {
+        let ys = vec![*x, 5];
+        for y in ys {
+            let zs = vec![y, 1];
+            for z in zs {
+                sum += z;
+            }
+        }
+    }
+    *cx.runtime += sum as u64;
+    sum
+}
+
+/// The inner loop has several breaks: the value given at each break is built
+/// in the loop body, with the continuation of the outer loop.
+pub fn nested_break(cx: &mut Cx<'_>) -> usize {
+    let xs = items(cx);
+    let mut out = Vec::new();
+    for x in xs.iter() {
+        let ys = vec![*x, 3, 0, 7];
+        for y in ys {
+            if y == 0 {
+                break;
+            }
+            out.push(y);
+        }
+    }
+    *cx.runtime += 5;
+    out.len()
+}
+
+/// Three nested loops, the innermost with several breaks.
+pub fn nested3_break(cx: &mut Cx<'_>) -> usize {
+    let xs = items(cx);
+    let mut out = Vec::new();
+    for x in xs.iter() {
+        let ys = vec![*x, 5];
+        for y in ys {
+            let zs = vec![y, 0, 1];
+            for z in zs {
+                if z == 0 {
+                    break;
+                }
+                out.push(z);
+            }
+        }
+    }
+    *cx.runtime += 9;
+    out.len()
+}
+
+/// Two inner loops in sequence in the outer loop.
+pub fn nested_siblings(cx: &mut Cx<'_>) -> usize {
+    let xs = items(cx);
+    let mut out = Vec::new();
+    for x in xs.iter() {
+        let ys = vec![*x, 5];
+        for y in ys {
+            out.push(y);
+        }
+        let zs = vec![*x, 6];
+        for z in zs {
+            out.push(z);
+        }
+    }
+    *cx.state += 3;
+    out.len()
+}
+
+/// Callers which write through the context after the call.
+pub fn drive_nested(s: u32, r: u64) -> (usize, u32, u64) {
+    let mut s = s;
+    let mut r = r;
+    let n = {
+        let mut cx = Cx { state: &mut s, runtime: &mut r };
+        let n = nested(&mut cx);
+        *cx.state += 10;
+        *cx.runtime += 20;
+        n
+    };
+    (n, s, r)
+}
+
+pub fn drive_nested_then_write(s: u32, r: u64) -> (u32, u32, u64) {
+    let mut s = s;
+    let mut r = r;
+    let n = {
+        let mut cx = Cx { state: &mut s, runtime: &mut r };
+        let n = nested_then_write(&mut cx);
+        *cx.state += 10;
+        *cx.runtime += 20;
+        n
+    };
+    (n, s, r)
+}
+
+pub fn drive_nested_one(s: u32) -> (u32, u32) {
+    let mut s = s;
+    let n = {
+        let mut cx = CxOne { state: &mut s };
+        let n = nested_one(&mut cx);
+        *cx.state += 10;
+        n
+    };
+    (n, s)
+}
+
+pub fn drive_nested3(s: u32, r: u64) -> (u32, u32, u64) {
+    let mut s = s;
+    let mut r = r;
+    let n = {
+        let mut cx = Cx { state: &mut s, runtime: &mut r };
+        let n = nested3(&mut cx);
+        *cx.state += 10;
+        *cx.runtime += 20;
+        n
+    };
+    (n, s, r)
+}
+
+pub fn drive_usize(which: u8, s: u32, r: u64) -> (usize, u32, u64) {
+    let mut s = s;
+    let mut r = r;
+    let n = {
+        let mut cx = Cx { state: &mut s, runtime: &mut r };
+        let n = if which == 0 {
+            nested_break(&mut cx)
+        } else if which == 1 {
+            nested3_break(&mut cx)
+        } else {
+            nested_siblings(&mut cx)
+        };
+        *cx.state += 10;
+        *cx.runtime += 20;
+        n
+    };
+    (n, s, r)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn drives() {
+        for (s, r) in [(0u32, 0u64), (5, 7), (40, 1000)] {
+            println!("nested {} {} {:?}", s, r, drive_nested(s, r));
+            println!("nested_then_write {} {} {:?}", s, r, drive_nested_then_write(s, r));
+            println!("nested_one {} {:?}", s, drive_nested_one(s));
+            println!("nested3 {} {} {:?}", s, r, drive_nested3(s, r));
+            for w in 0u8..3 {
+                println!("usize {} {} {} {:?}", w, s, r, drive_usize(w, s, r));
+            }
+        }
+    }
+}
