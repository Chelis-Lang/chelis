+-- two inner loops in sequence (nested_siblings)
+#guard valN (drive_usize 0#u8 0#u32 0#u64) == some (4, 11, 25)
+#guard valN (drive_usize 0#u8 5#u32 7#u64) == some (4, 16, 32)
+#guard valN (drive_usize 0#u8 40#u32 1000#u64) == some (4, 51, 1025)
