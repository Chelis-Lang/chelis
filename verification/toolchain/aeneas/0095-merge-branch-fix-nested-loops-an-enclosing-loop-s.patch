+import JoinSharedProjGiveBack.JoinSharedProjGiveBack
+
+/-! Evaluate the model of `tests/src/join-shared-proj-give-back.rs` on the inputs
+    of its `native` test module and compare with the native results. The driver
+    writes through a mutable borrow of the expression between the two
+    extractions. -/
+
+namespace join_shared_proj_give_back.checks
+open Aeneas Aeneas.Std Result
+
+def val2 (r : Result (U8 × U8)) : Option (Nat × Nat) :=
+  match r with
+  | ok (a, b) => some (a.val, b.val)
+  | _ => none
+
+-- native::drives
+#guard val2 (drive 0#u8) == some (1, 1)
+#guard val2 (drive 1#u8) == some (0, 1)
+#guard val2 (drive 2#u8) == some (0, 0)
+#guard val2 (drive 3#u8) == some (0, 0)
+#guard val2 (drive 4#u8) == some (0, 0)
+#guard val2 (drive 5#u8) == some (0, 0)
+#guard val2 (drive 6#u8) == some (2, 2)
+#guard val2 (drive 7#u8) == some (0, 2)
+#guard val2 (drive 8#u8) == some (0, 0)
+
+end join_shared_proj_give_back.checks
