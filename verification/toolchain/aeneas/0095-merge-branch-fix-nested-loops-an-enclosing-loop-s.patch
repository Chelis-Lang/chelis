+#guard valN (drive_nested 0#u32 0#u64) == some (4, 11, 20)
+#guard valN (drive_nested 5#u32 7#u64) == some (4, 16, 27)
+#guard valN (drive_nested 40#u32 1000#u64) == some (4, 51, 1020)
+#guard val3 (drive_nested_then_write 0#u32 0#u64) == some (23, 34, 120)
+#guard val3 (drive_nested_then_write 5#u32 7#u64) == some (28, 44, 127)
+#guard val3 (drive_nested_then_write 40#u32 1000#u64) == some (63, 114, 1120)
