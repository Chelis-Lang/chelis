 end alloc.slice
+
+/-- `<[T]>::sort_unstable` (core/src/slice/mod.rs): `sort::unstable::sort(self, &mut T::lt)`
+ (ipnsort). Natively, the order of the elements that compare `Equal`, and the sequence of
+ comparisons, are unspecified. Aeneas admits a call only where `Ord` is total and `Equal`
+ holds exactly for indistinguishable values (llbc/SortContracts.ml: integers, `bool`,
+ `char`, `str`, `String`, references, boxes, tuples and derived `Ord` types of those):
+ there every sorted permutation is the same list, which this stable sort returns. -/
+@[rust_fun "core::slice::{[@T]}::sort_unstable"]
+def core.slice.Slice.sort_unstable {T : Type} (ordInst : core.cmp.Ord T) (self : Std.Slice T) :
+    Result (Std.Slice T) := do
+  let (out, _) ← alloc.slice.stableSort
+    (fun (_ : Unit) x y => do return (← ordInst.partialOrdInst.lt x y, ())) self.val ()
+  return ⟨out.val, by rw [out.property]; exact self.property⟩
+
+/-- `<[T]>::sort_unstable_by` (core/src/slice/mod.rs):
+ `sort::unstable::sort(self, &mut |a, b| compare(a, b) == Ordering::Less)`. Aeneas admits a
+ call only where `compare` is a closure returning `Ord::cmp(a, b)` or `Ord::cmp(b, a)` on
+ an element type as for `sort_unstable` (llbc/SortContracts.ml): the comparator is pure,
+ total and returns `Equal` only for indistinguishable values, so the list sorted by it is
+ unique and this stable sort returns the native result. -/
+@[rust_fun "core::slice::{[@T]}::sort_unstable_by"]
+def core.slice.Slice.sort_unstable_by {T F : Type}
+    (fnInst : core.ops.function.FnMut F (T × T) Ordering) (self : Std.Slice T) (compare : F) :
+    Result (Unit × Std.Slice T × F) := do
+  let (out, compare) ← alloc.slice.stableSort (fun compare x y => do
+    let (order, compare) ← fnInst.call_mut compare (x, y)
+    return (order matches .lt, compare)) self.val compare
+  return ((), ⟨out.val, by rw [out.property]; exact self.property⟩, compare)
+
 end Aeneas.Std
