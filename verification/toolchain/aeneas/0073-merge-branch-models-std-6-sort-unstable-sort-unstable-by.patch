index 0000000..3faf355
--- /dev/null
+++ b/src/llbc/SortContracts.ml
@@ -0,0 +1,318 @@
+(** Admission for the models of [<[T]>::sort_unstable] and
+    [<[T]>::sort_unstable_by] (Aeneas.Std.Sort).
+
+    Natively, the order of the elements that compare [Equal], and the sequence of
+    comparisons, are unspecified. The models (a stable sort) return the native
+    result exactly when the comparison is pure and total and returns [Equal] only
+    for indistinguishable values: then every sorted permutation is the same list.
+
+    [sort_unstable] compares with the element type's [Ord]. By coherence a type
+    has a single [Ord] impl, so this is a property of the element type. It holds
+    for the integer types, [bool], [char], [str] and [String], for references,
+    boxes and tuples of such types, and for non-generic crate types whose [Ord]
+    impl is derived and whose fields all have such types (the derived [cmp]
+    compares the variants, then the fields in order). A derived impl is the one
+    rustc marks [#[automatically_derived]], which Charon keeps as an unknown
+    attribute.
+
+    [sort_unstable_by] is admitted when its comparator is a closure whose body
+    returns [Ord::cmp(a, b)] (ascending) or [Ord::cmp(b, a)] (descending) of its
+    two arguments, for an element type as above; the model sorts with that
+    comparator. Every other comparator, and every call to [sort_unstable_by_key]
+    (equal keys may hide distinct elements), is rejected with
+    [E_UNSUPPORTED_SORT]. *)
+
+open Types
+open Expressions
+open LlbcAst
+open Errors
+
+let check (crate : crate) : crate =
+  if Config.backend () <> Config.Lean then crate
+  else
+    let env = Print.crate_to_fmt_env crate in
+    let mctx = NameMatcher.ctx_from_crate crate in
+    let config =
+      {
+        NameMatcher.map_vars_to_vars = true;
+        match_with_trait_decl_refs = Config.match_patterns_with_trait_decl_refs;
+      }
+    in
+    let pattern s = NameMatcher.parse_pattern s in
+    let sort_unstable = pattern "core::slice::{[@T]}::sort_unstable" in
+    let sort_by = pattern "core::slice::{[@T]}::sort_unstable_by" in
+    let sort_by_key = pattern "core::slice::{[@T]}::sort_unstable_by_key" in
+    let matches pat (name : name) = NameMatcher.match_name mctx config pat name in
+    let name_of (name : name) = Print.name_to_string env name in
+    let reject span reason =
+      [%craise] span
+        ("E_UNSUPPORTED_SORT: " ^ reason
+       ^ ". The sort_unstable models are admitted only where the comparison is \
+          Ord::cmp on a type whose Equal holds exactly for indistinguishable \
+          values (integers, bool, char, str, String, references, boxes, tuples \
+          and #[derive(Ord)] types of those), where every sorted permutation is \
+          the same list.")
+    in
+    let trait_name id =
+      name_of (TraitDeclId.Map.find id crate.trait_decls).item_meta.name
+    in
+    let derived (impl : trait_impl) =
+      List.exists
+        (function
+          | Meta.AttrUnknown { path = "automatically_derived"; args = None } ->
+              true
+          | _ -> false)
+        impl.item_meta.attr_info.attributes
+    in
+    let ord_impl (adt : TypeDeclId.id) =
+      TraitImplId.Map.fold
+        (fun _ (impl : trait_impl) found ->
+          match found with
+          | Some _ -> found
+          | None -> (
+              if trait_name impl.impl_trait.id <> "core::cmp::Ord" then None
+              else
+                match impl.impl_trait.generics.types with
+                | [ TAdt { id = TAdtId id; _ } ] when id = adt -> Some impl
+                | _ -> None))
+        crate.trait_impls None
+    in
+    (* [visiting]: the crate types under examination (a recursive type is
+       structural if its other fields are). *)
+    let rec structural span visiting (ty : ty) : unit =
+      let unsupported why =
+        reject span ("the element type " ^ Print.ty_to_string env ty ^ " " ^ why)
+      in
+      match ty with
+      | TLiteral (TInt _ | TUInt _ | TBool | TChar) -> ()
+      | TLiteral (TFloat _) -> unsupported "has no total order"
+      | TRef (_, inner, _) -> structural span visiting inner
+      | TAdt { id = TTuple; generics } | TAdt { id = TBuiltin TBox; generics } ->
+          List.iter (structural span visiting) generics.types
+      | TAdt { id = TBuiltin TStr; _ } -> ()
+      | TAdt { id = TAdtId id; generics } -> (
+          let decl = TypeDeclId.Map.find id crate.type_decls in
+          if name_of decl.item_meta.name = "alloc::string::String" then ()
+          else if List.mem id visiting then ()
+          else if generics.types <> [] || generics.const_generics <> [] then
+            unsupported "is generic"
+          else
+            match ord_impl id with
+            | None -> unsupported "has no Ord impl in the crate"
+            | Some impl when not (derived impl) ->
+                unsupported
+                  "has an Ord impl without #[automatically_derived] (a \
+                   hand-written Equal may hold between distinct values)"
+            | Some _ -> (
+                let fields =
+                  match decl.kind with
+                  | Struct fields -> fields
+                  | Enum variants ->
+                      List.concat_map (fun (v : variant) -> v.fields) variants
+                  | _ -> unsupported "is not a struct or an enum"
+                in
+                List.iter
+                  (fun (field : field) ->
+                    structural span (id :: visiting) field.field_ty)
+                  fields))
+      | _ -> unsupported "is not a reviewed Ord type"
+    in
+    (* Whether a call target is [Ord::cmp] (of any impl: the argument types fix
+       the implementing type). *)
+    let is_ord_cmp (ptr : fn_ptr) =
+      match ptr.kind with
+      | TraitMethod (tr, "cmp", _) ->
+          trait_name tr.trait_decl_ref.binder_value.id = "core::cmp::Ord"
+      | FunId (FRegular id) -> (
+          match (FunDeclId.Map.find id crate.fun_decls).src with
+          | TraitImplItem (_, trait_ref, "cmp", _) ->
+              trait_name trait_ref.id = "core::cmp::Ord"
+          | _ -> false)
+      | _ -> false
+    in
+    (* The comparator of [sort_unstable_by] over [elem]: the [FnMut] impl [tr]
+       must be a closure's, whose [call_mut] body, apart from storage markers
+       and references to the unit metadata (the metadata of the reborrows),
+       only moves or reborrows the two arguments (fields 0 and 1 of the tupled
+       arguments) and returns [Ord::cmp] of them, in either order. The closure
+       state is never read. *)
+    let comparator span (elem : ty) (tr : trait_ref) =
+      let unsupported why =
+        reject span ("sort_unstable_by: the comparator " ^ why)
+      in
+      let impl_ref =
+        match tr.kind with
+        | TraitImpl impl_ref -> impl_ref
+        | _ -> unsupported "is not a closure"
+      in
+      let impl = TraitImplId.Map.find impl_ref.id crate.trait_impls in
+      let is_closure_impl =
+        match impl.impl_trait.generics.types with
+        | TAdt { id = TAdtId id; _ } :: _ -> (
+            match (TypeDeclId.Map.find id crate.type_decls).src with
+            | ClosureItem { fn_mut_impl = Some fn_mut; _ } ->
+                fn_mut.binder_value.id = impl_ref.id
+            | _ -> false)
+        | _ -> false
+      in
+      if not is_closure_impl then unsupported "is not a closure";
+      let call_mut =
+        match List.assoc_opt "call_mut" impl.methods with
+        | Some method_ref -> method_ref.binder_value.id
+        | None -> unsupported "has no call_mut"
+      in
+      let body =
+        match (FunDeclId.Map.find call_mut crate.fun_decls).body with
+        | StructuredBody body when body.locals.arg_count = 2 -> body
+        | _ -> unsupported "has no body"
+      in
+      let tupled_args = LocalId.of_int 2 in
+      let return_local = LocalId.of_int 0 in
+      (* The locals holding a reference to argument 0 or 1, and the locals
+         holding a reference to the unit metadata global (the pre-pass
+         decompose_global_accesses introduces them for the metadata operand of
+         the reborrows [&*a]). *)
+      let origins = ref LocalId.Map.empty in
+      let unit_refs = ref LocalId.Set.empty in
+      let is_unit_metadata (gref : global_decl_ref) =
+        gref.id = crate.unit_metadata.id
+      in
+      let unit_metadata_operand = function
+        | Copy { kind = PlaceGlobal gref; _ } -> is_unit_metadata gref
+        | Copy { kind = PlaceProjection ({ kind = PlaceLocal id; _ }, Deref); _ }
+          ->
+            LocalId.Set.mem id !unit_refs
+        | _ -> false
+      in
+      let place_origin (place : place) =
+        match place.kind with
+        | PlaceLocal id -> LocalId.Map.find_opt id !origins
+        | PlaceProjection
+            ({ kind = PlaceLocal id; _ }, Field (ProjTuple 2, field))
+          when id = tupled_args ->
+            Some (FieldId.to_int field)
+        | _ -> None
+      in
+      let rvalue_origin = function
+        | Use (Move place | Copy place) -> place_origin place
+        | RvRef ({ kind = PlaceProjection (inner, Deref); _ }, BShared, metadata)
+          when unit_metadata_operand metadata ->
+            place_origin inner
+        | _ -> None
+      in
+      let argument (operand : operand) =
+        match operand with
+        | Move place | Copy place -> (
+            match
+              (place_origin place, TypesUtils.ty_erase_regions place.ty)
+            with
+            | Some index, TRef (_, pointee, RShared)
+              when pointee = TypesUtils.ty_erase_regions elem ->
+                index
+            | _ -> unsupported "does not pass its arguments to Ord::cmp")
+        | Constant _ -> unsupported "does not pass its arguments to Ord::cmp"
+      in
+      let rec walk compared (statements : statement list) =
+        match (statements, compared) with
+        | [ { kind = Return; _ } ], true -> ()
+        | { kind = StorageLive _ | StorageDead _ | Nop; _ } :: rest, _ ->
+            walk compared rest
+        | {
+            kind =
+              Assign
+                ( { kind = PlaceLocal id; _ },
+                  RvRef ({ kind = PlaceGlobal gref; _ }, BShared, metadata) );
+            _;
+          }
+          :: rest,
+          false
+          when id <> return_local && is_unit_metadata gref
+               && unit_metadata_operand metadata ->
+            origins := LocalId.Map.remove id !origins;
+            unit_refs := LocalId.Set.add id !unit_refs;
+            walk compared rest
+        | { kind = Assign ({ kind = PlaceLocal id; _ }, rvalue); _ } :: rest, false
+          when id <> return_local -> (
+            match rvalue_origin rvalue with
+            | Some index ->
+                origins := LocalId.Map.add id index !origins;
+                unit_refs := LocalId.Set.remove id !unit_refs;
+                walk compared rest
+            | None -> unsupported "computes more than Ord::cmp of its arguments")
+        | { kind = Call { func = FnOpRegular ptr; args = [ a; b ]; dest }; _ }
+          :: rest,
+          false
+          when dest.kind = PlaceLocal return_local && is_ord_cmp ptr ->
+            (match (argument a, argument b) with
+            | 0, 1 | 1, 0 -> ()
+            | _ -> unsupported "does not compare its two arguments");
+            walk true rest
+        | _ ->
+            unsupported "is not Ord::cmp(a, b) or Ord::cmp(b, a) of its arguments"
+      in
+      walk false body.body.statements;
+      structural span [] elem
+    in
+    (* A partial-monomorphization instance (last name element [PeInstantiated],
+       e.g. [sort_unstable_by] at a closure that captures a mutable borrow) is
+       the generic function at the instantiated arguments, and
+       [PrePasses.admit_modeled_fun_instances] gives it the same model: check
+       the generic name at those arguments. *)
+    let check_ptr span (ptr : fn_ptr) =
+      match ptr.kind with
+      | FunId (FRegular id) -> (
+          let decl = FunDeclId.Map.find id crate.fun_decls in
+          let name, generics =
+            NameMatcher.instantiate_name_generics decl.item_meta.name
+              ptr.generics
+          in
+          if matches sort_by name then
+            match (generics.types, generics.trait_refs) with
+            | [ element; _ ], [ compare ] -> comparator span element compare
+            | _ -> reject span "unexpected generics of sort_unstable_by"
+          else if matches sort_by_key name then
+            reject span
+              "sort_unstable_by_key: equal keys may hide distinct elements"
+          else if matches sort_unstable name then
+            match generics.types with
+            | [ element ] -> structural span [] element
+            | _ -> reject span "unexpected generics of sort_unstable")
+      | _ -> ()
+    in
+    let failed = ref FunDeclId.Map.empty in
+    FunDeclId.Map.iter
+      (fun id (decl : fun_decl) ->
+        match decl.body with
+        | StructuredBody body -> (
+            let visitor =
+              object
+                inherit [_] iter_statement as super
+                method! visit_fn_ptr span ptr = check_ptr span ptr
+
+                method! visit_statement _ st =
+                  super#visit_statement st.span st
+              end
+            in
+            try
+              [%recover_internal_errors] decl.item_meta.span (fun () ->
+                  visitor#visit_block decl.item_meta.span body.body)
+            with CFailure e -> failed := FunDeclId.Map.add id e !failed)
+        | _ -> ())
+      crate.fun_decls;
+    let fun_decls =
+      FunDeclId.Map.mapi
+        (fun id (decl : fun_decl) ->
+          match FunDeclId.Map.find_opt id !failed with
+          | None -> decl
+          | Some e ->
+              [%save_error] decl.item_meta.span
+                ("Ignoring the body of '"
+                ^ name_of decl.item_meta.name
+                ^ "' because of previous error");
+              let msg =
+                format_error_message_with_file_line e.file e.line e.span e.msg
+              in
+              { decl with body = ErrorBody { span = decl.item_meta.span; msg } })
+        crate.fun_decls
+    in
+    { crate with fun_decls }
