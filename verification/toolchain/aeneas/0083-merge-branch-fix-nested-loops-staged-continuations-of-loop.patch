+import LoopNestedClosure.LoopNestedClosure
+namespace loop_nested_closure.checks
+open Aeneas Aeneas.Std Result
+
+def v (l : List U32) (h : l.length ≤ Usize.max := by first | (simp; done) | (simp; scalar_tac)) : alloc.vec.Vec U32 := ⟨l, h⟩
+
+def res (r : Result (core.result.Result (alloc.vec.Vec U32) U32)) : Option (Sum (List Nat) Nat) :=
+  match r with
+  | ok (.Ok xs) => some (.inl (xs.val.map (·.val)))
+  | ok (.Err e) => some (.inr e.val)
+  | _ => none
+
+def num (r : Result U32) : Option Nat :=
+  match r with
+  | ok x => some x.val
+  | _ => none
+
+#guard res (run (v [1#u32, 5#u32, 2#u32, 9#u32]) true 100#u32) == some (.inr 23)
+#guard res (run (v [1#u32, 5#u32, 2#u32, 9#u32]) true 2#u32) == some (.inr 2)
+#guard res (run (v [1#u32, 5#u32, 2#u32, 9#u32]) false 2#u32) == some (.inl [11, 52, 94])
+#guard res (run (v []) true 2#u32) == some (.inl [])
+#guard res (run (v [5#u32, 3#u32, 1#u32]) true 100#u32) == some (.inr 32)
+#guard num (run_pick 2#u32) == some 301
+#guard num (run_pick 5#u32) == some 1103
+#guard num (run_pick 7#u32) == some 802
+#guard num (run_pick 6#u32) == some 601
+end loop_nested_closure.checks
