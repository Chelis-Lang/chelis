+//@ [!lean] skip
+//@ [lean] subdir=LoopNestedStaged
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Loops over a reborrowed `&'a mut Counter<'b>` whose inner borrow of `'b`
+//! goes through a call at each iteration (the shape of
+//! `chelis_ir::eval::resolve_load_inputs`, where a `&mut F` closure capturing
+//! mutable state is called in a loop). The loop abstraction of `'b` holds the
+//! pending loans of the value given back to the outer borrow: its
+//! continuation is staged like the backward function of the region group `'b`
+//! of `bump` (first stage: the value given back to the outer borrow at level
+//! 1; second stage: the current inner borrows at level 0).
+
+pub struct Counter<'b> {
+    pub total: &'b mut u32,
+    pub calls: u32,
+}
+
+pub fn bump(c: &mut &mut Counter<'_>, v: u32) -> u32 {
+    *c.total = (*c.total).wrapping_add(v);
+    c.calls = c.calls.wrapping_add(1);
+    c.calls
+}
+
+/// The reference is given back by the call at each iteration
+pub fn bump_n(c: &mut Counter<'_>, n: u32) -> u32 {
+    let mut r = c;
+    let mut i = 0;
+    let mut acc = 0u32;
+    while i < n {
+        acc = acc.wrapping_add(bump(&mut r, i));
+        i += 1;
+    }
+    acc
+}
+
+pub fn drive_n(n: u32) -> (u32, u32, u32) {
+    let mut t = 5u32;
+    let mut c = Counter { total: &mut t, calls: 1 };
+    let r = bump_n(&mut c, n);
+    let calls = c.calls;
+    (r, calls, t)
+}
+
+/// The caller writes through the inner borrow after the loop: the value
+/// given back at level 1 goes through the staged continuation
+pub fn drive_n_then_write(n: u32) -> (u32, u32, u32) {
+    let mut t = 5u32;
+    let mut c = Counter { total: &mut t, calls: 1 };
+    let r = bump_n(&mut c, n);
+    *c.total = (*c.total).wrapping_mul(3);
+    let calls = c.calls;
+    (r, calls, t)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn drives() {
+        println!("{:?}", drive_n(0));
+        println!("{:?}", drive_n(1));
+        println!("{:?}", drive_n(4));
+        println!("{:?}", drive_n_then_write(0));
+        println!("{:?}", drive_n_then_write(3));
+    }
+}
