+//@ [!lean] skip
+//@ [lean] subdir=LoopNestedClosure
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! `chelis_ir::eval::resolve_load_inputs` (eval.rs:2155): a loop (and an
+//! if-join) over calls of a `&mut F` where `F` is a closure which captures a
+//! mutable borrow of another closure: the value of type
+//! `&'a mut Closure<'b, T>` given back by `call_mut` is joined with the one
+//! the loop (or the branch) started with.
+
+pub enum Demand {
+    Selected,
+    Shape,
+}
+
+fn resolve_inputs<F>(names: &Vec<u32>, strict: bool, mut load: F) -> Result<Vec<u32>, u32>
+where
+    F: FnMut(u32, Demand) -> Result<Option<u32>, u32>,
+{
+    let mut out = Vec::new();
+    for n in names.iter() {
+        let demand = if *n > 3 { Demand::Selected } else { Demand::Shape };
+        match load(*n, demand)? {
+            Some(v) => out.push(v),
+            None if strict => return Err(*n),
+            None => {}
+        }
+    }
+    Ok(out)
+}
+
+fn prepare<G>(names: &Vec<u32>, strict: bool, mut load: G) -> Result<Vec<u32>, u32>
+where
+    G: FnMut(u32, Demand) -> Result<Option<u32>, u32>,
+{
+    resolve_inputs(names, strict, &mut load)
+}
+
+fn eval_with<F>(names: &Vec<u32>, strict: bool, mut load: F) -> Result<Vec<u32>, u32>
+where
+    F: FnMut(u32) -> Option<u32>,
+{
+    prepare(names, strict, |n, d| match d {
+        Demand::Selected => Ok(load(n)),
+        Demand::Shape => match load(n) {
+            Some(v) if v > 20 => Err(v),
+            r => Ok(r),
+        },
+    })
+}
+
+/// The loader counts its calls in its own state
+pub fn run(names: &Vec<u32>, strict: bool, k: u32) -> Result<Vec<u32>, u32> {
+    let mut calls = 0u32;
+    eval_with(names, strict, move |n| {
+        calls = calls.wrapping_add(1);
+        if n == k { None } else { Some(n.wrapping_mul(10).wrapping_add(calls)) }
+    })
+}
+
+fn pick<F>(n: u32, mut load: F) -> u32
+where
+    F: FnMut(u32) -> Option<u32>,
+{
+    let a = if n > 3 { load(n) } else { None };
+    let b = load(n.wrapping_add(1));
+    a.unwrap_or(0).wrapping_add(b.unwrap_or(0))
+}
+
+fn pick_ref<G>(n: u32, mut load: G) -> u32
+where
+    G: FnMut(u32) -> Option<u32>,
+{
+    pick(n, &mut load)
+}
+
+fn pick_with<F>(n: u32, mut load: F) -> u32
+where
+    F: FnMut(u32) -> Option<u32>,
+{
+    pick_ref(n, |x| load(x))
+}
+
+/// if-join: the loader is called in one branch only, then once more
+pub fn run_pick(n: u32) -> u32 {
+    let mut calls = 0u32;
+    pick_with(n, move |x| {
+        calls = calls.wrapping_add(1);
+        if x == 7 { None } else { Some(x.wrapping_mul(100).wrapping_add(calls)) }
+    })
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn drives() {
+        let v = vec![1u32, 5, 2, 9];
+        println!("{:?}", run(&v, true, 100));
+        println!("{:?}", run(&v, true, 2));
+        println!("{:?}", run(&v, false, 2));
+        println!("{:?}", run(&vec![], true, 2));
+        println!("{:?}", run(&vec![5u32, 3, 1], true, 100));
+        println!("{}", run_pick(2));
+        println!("{}", run_pick(5));
+        println!("{}", run_pick(7));
+        println!("{}", run_pick(6));
+    }
+}
