+import VecRetainMut.VecRetainMut
+
+/-! Evaluate the model of `tests/src/vec-retain-mut.rs` on the inputs of its
+    `native` test module and compare with the native results. -/
+
+namespace vec_retain_mut.checks
+open Aeneas Aeneas.Std Result
+
+def u (n : Nat) : U32 := ⟨BitVec.ofNat _ n⟩
+def w (n : Nat) : U64 := ⟨BitVec.ofNat _ n⟩
+
+def vec {α : Type} (xs : List α) : alloc.vec.Vec α :=
+  if h : xs.length ≤ Usize.max then ⟨xs, h⟩ else ⟨[], by simp⟩
+
+def nats (v : alloc.vec.Vec U32) : List Nat := v.val.map (·.val)
+
+def buckets (xs : List (Nat × List Nat)) : alloc.vec.Vec (U64 × alloc.vec.Vec U32) :=
+  vec (xs.map fun (m, b) => (w m, vec (b.map u)))
+
+def bucketsR (v : alloc.vec.Vec (U64 × alloc.vec.Vec U32)) : List (Nat × List Nat) :=
+  v.val.map fun (m, b) => (m.val, nats b)
+
+/-- The closure captures the merged mask and the merged bucket mutably; both are
+    read after `retain_mut` (the pushed bucket). -/
+def mergeR : Option (List (Nat × List Nat) × List (Nat × List Nat)) :=
+  match merge (buckets [(3, [1, 2]), (4, [3]), (8, [4])]) (w 9) (u 9) with
+  | ok b =>
+    match merge b (w 16) (u 5) with
+    | ok b' => some (bucketsR b, bucketsR b')
+    | _ => none
+  | _ => none
+
+#guard mergeR == some ([(4, [3]), (11, [1, 2, 4, 9])],
+  [(4, [3]), (11, [1, 2, 4, 9]), (16, [5])])
+
+/-- The closure captures two counters mutably; both are read after
+    `retain_mut`. -/
+def doubleEvensR (xs : List Nat) : Option ((Nat × Nat) × List Nat) :=
+  match double_evens (vec (xs.map u)) with
+  | ok ((calls, dropped), v) => some ((calls.val, dropped.val), nats v)
+  | _ => none
+
+#guard doubleEvensR [1, 2, 3, 4, 6] == some ((5, 2), [4, 8, 12])
+#guard doubleEvensR [] == some ((0, 0), [])
+
+/-- A closure capturing nothing mutable (the `FnMutMutArg` schema). -/
+def clampBelowR (xs : List Nat) (limit : Nat) : Option (List Nat) :=
+  match clamp_below (vec (xs.map u)) (u limit) with
+  | ok v => some (nats v)
+  | _ => none
+
+#guard clampBelowR [0, 5, 12, 0, 7] 6 == some [5, 6, 6]
+
+end vec_retain_mut.checks
