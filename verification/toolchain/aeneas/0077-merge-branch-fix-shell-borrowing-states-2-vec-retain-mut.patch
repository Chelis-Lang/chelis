@@ -0,0 +1,25 @@
+//@ [lean] known-failure
+//@ [!lean] skip
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! A value of function pointer type stays rejected: only the type arguments of
+//! a `PhantomData`, which hold no value, translate function pointer types (see
+//! `phantom-fn-types.rs`). The shape of `chelis_ir::host::definitions_owning`:
+//! a closure capturing a function pointer passed as an argument.
+
+pub struct Named {
+    pub name: u32,
+    pub alias: u32,
+}
+
+fn name_of(named: &Named) -> u32 {
+    named.name
+}
+
+pub fn count_owning(definitions: &[Named], name: u32, key: fn(&Named) -> u32) -> usize {
+    definitions.iter().filter(|definition| key(definition) == name).count()
+}
+
+pub fn count_named(definitions: &[Named], name: u32) -> usize {
+    count_owning(definitions, name, name_of)
+}
diff --git a/tests/src/phantom-fn-types.rs b/tests/src/phantom-fn-types.rs
new file mode 100644
index 0000000..96ba5fb
--- /dev/null
+++ b/tests/src/phantom-fn-types.rs
@@ -0,0 +1,243 @@
+//@ [!lean] skip
+//@ [lean] subdir=PhantomFnTypes
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Function pointer types under `PhantomData`, as in the serde visitors of
+//! `chelis_unord` (`struct MapVisitor<K, V>(PhantomData<fn() -> (K, V)>)`).
+//! A `PhantomData<T>` holds no value of type `T`, so a function pointer type in
+//! its type argument is translated as a Lean function type; values of function
+//! pointer type stay rejected (see `fn-pointer-value.rs`). Function pointer
+//! types with bound regions (`fn(&T) -> bool`, `fn(&mut T)`) occur in fields;
+//! the markers are live across a loop (their types are matched at the join).
+//! `PhantomFnTypes/Checks.lean` evaluates the models on the inputs of the
+//! `native` test module below and compares with the native results.
+
+use std::marker::PhantomData;
+
+/// A sequence of words (`serde::de::SeqAccess`).
+pub trait SeqAccess {
+    fn next_element(&mut self) -> Option<u32>;
+}
+
+/// `serde::de::Visitor`: consumes the visitor, builds its value.
+pub trait Visitor: Sized {
+    type Value;
+    fn visit_seq<A: SeqAccess>(self, sequence: A) -> Result<Self::Value, u32>;
+}
+
+/// `serde::Deserializer`: drives a visitor.
+pub trait Deserializer: Sized {
+    fn deserialize_seq<V: Visitor>(self, visitor: V) -> Result<V::Value, u32>;
+}
+
+/// `serde::Deserialize`.
+pub trait Deserialize: Sized {
+    fn deserialize<D: Deserializer>(deserializer: D) -> Result<Self, u32>;
+}
+
+pub trait FromWord: Sized {
+    fn from_word(word: u32) -> Self;
+}
+
+impl FromWord for u32 {
+    fn from_word(word: u32) -> u32 {
+        word
+    }
+}
+
+impl FromWord for bool {
+    fn from_word(word: u32) -> bool {
+        word % 2 == 1
+    }
+}
+
+/// The words of a vector, in order.
+pub struct Words {
+    words: Vec<u32>,
+    position: usize,
+}
+
+impl SeqAccess for Words {
+    fn next_element(&mut self) -> Option<u32> {
+        if self.position < self.words.len() {
+            let word = self.words[self.position];
+            self.position += 1;
+            Some(word)
+        } else {
+            None
+        }
+    }
+}
+
+pub struct WordDeserializer(pub Vec<u32>);
+
+impl Deserializer for WordDeserializer {
+    fn deserialize_seq<V: Visitor>(self, visitor: V) -> Result<V::Value, u32> {
+        visitor.visit_seq(Words { words: self.0, position: 0 })
+    }
+}
+
+fn contains_key<K: PartialEq, V>(pairs: &Vec<(K, V)>, key: &K) -> bool {
+    let mut i = 0;
+    while i < pairs.len() {
+        if pairs[i].0 == *key {
+            return true;
+        }
+        i += 1;
+    }
+    false
+}
+
+fn contains<T: PartialEq>(elements: &Vec<T>, element: &T) -> bool {
+    let mut i = 0;
+    while i < elements.len() {
+        if elements[i] == *element {
+            return true;
+        }
+        i += 1;
+    }
+    false
+}
+
+/// Key-value pairs: a repeated key, or a key without value, is rejected with
+/// that key's word.
+pub struct MapVisitor<K, V>(PhantomData<fn() -> (K, V)>);
+
+impl<K: FromWord + PartialEq, V: FromWord> Visitor for MapVisitor<K, V> {
+    type Value = Vec<(K, V)>;
+
+    fn visit_seq<A: SeqAccess>(self, mut sequence: A) -> Result<Vec<(K, V)>, u32> {
+        let mut result: Vec<(K, V)> = Vec::new();
+        while let Some(key_word) = sequence.next_element() {
+            let value_word = match sequence.next_element() {
+                Some(word) => word,
+                None => return Err(key_word),
+            };
+            let key = K::from_word(key_word);
+            if contains_key(&result, &key) {
+                return Err(key_word);
+            }
+            result.push((key, V::from_word(value_word)));
+        }
+        Ok(result)
+    }
+}
+
+/// Elements: a repeated element is rejected with its word.
+pub struct SetVisitor<T>(PhantomData<fn() -> T>);
+
+impl<T: FromWord + PartialEq> Visitor for SetVisitor<T> {
+    type Value = Vec<T>;
+
+    fn visit_seq<A: SeqAccess>(self, mut sequence: A) -> Result<Vec<T>, u32> {
+        let mut result: Vec<T> = Vec::new();
+        while let Some(word) = sequence.next_element() {
+            let element = T::from_word(word);
+            if contains(&result, &element) {
+                return Err(word);
+            }
+            result.push(element);
+        }
+        Ok(result)
+    }
+}
+
+/// A map deserialized through its visitor, as `UnordMap`'s `Deserialize`.
+pub struct Pairs<K, V>(pub Vec<(K, V)>);
+
+impl<K: FromWord + PartialEq, V: FromWord> Deserialize for Pairs<K, V> {
+    fn deserialize<D: Deserializer>(deserializer: D) -> Result<Self, u32> {
+        match deserializer.deserialize_seq(MapVisitor(PhantomData)) {
+            Ok(pairs) => Ok(Pairs(pairs)),
+            Err(word) => Err(word),
+        }
+    }
+}
+
+pub fn deserialize_pairs(words: Vec<u32>) -> Result<Vec<(u32, bool)>, u32> {
+    match Pairs::<u32, bool>::deserialize(WordDeserializer(words)) {
+        Ok(Pairs(pairs)) => Ok(pairs),
+        Err(word) => Err(word),
+    }
+}
+
+pub fn deserialize_set(words: Vec<u32>) -> Result<Vec<u32>, u32> {
+    WordDeserializer(words).deserialize_seq(SetVisitor::<u32>(PhantomData))
+}
+
+/// A counter tagged with an invariant marker: a function type taking and
+/// returning `T`, and a function type with a higher-ranked region.
+pub struct Tagged<T> {
+    pub count: u32,
+    marker: PhantomData<fn(T) -> T>,
+    by_ref: PhantomData<fn(&T) -> bool>,
+}
+
+/// A function type in a signature.
+pub fn marker<T>() -> PhantomData<fn(T) -> T> {
+    PhantomData
+}
+
+/// The markers are live across the loop.
+pub fn bump_tagged<T>(n: u32) -> Tagged<T> {
+    let mut tagged: Tagged<T> = Tagged { count: 0, marker: marker(), by_ref: PhantomData };
+    let mut i = 0;
+    while i < n {
+        tagged.count += 2;
+        i += 1;
+    }
+    tagged
+}
+
+pub fn bumped(n: u32) -> u32 {
+    bump_tagged::<Vec<u32>>(n).count
+}
+
+/// A counter tagged with a function type taking a mutable borrow (a bound
+/// region), updated through a mutable borrow.
+pub struct Sink<T> {
+    pub count: u32,
+    pub last: T,
+    feed: PhantomData<fn(&mut T)>,
+}
+
+pub fn bump<T>(sink: &mut Sink<T>) {
+    sink.count += 1;
+}
+
+pub fn bumped_twice(n: u32) -> u32 {
+    let mut sink: Sink<u32> = Sink { count: n, last: n, feed: PhantomData };
+    bump(&mut sink);
+    bump(&mut sink);
+    sink.count + sink.last
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn pairs() {
+        assert_eq!(deserialize_pairs(vec![1, 3, 2, 4]), Ok(vec![(1, true), (2, false)]));
+        assert_eq!(deserialize_pairs(vec![]), Ok(vec![]));
+        assert_eq!(deserialize_pairs(vec![1, 3, 1, 4]), Err(1));
+        assert_eq!(deserialize_pairs(vec![5, 3, 7]), Err(7));
+    }
+
+    #[test]
+    fn set() {
+        assert_eq!(deserialize_set(vec![3, 1, 2]), Ok(vec![3, 1, 2]));
+        assert_eq!(deserialize_set(vec![3, 1, 3]), Err(3));
+    }
+
+    #[test]
+    fn tagged() {
+        assert_eq!(bumped(0), 0);
+        assert_eq!(bumped(5), 10);
+    }
+
+    #[test]
+    fn sink() {
+        assert_eq!(bumped_twice(7), 16);
+    }
+}
