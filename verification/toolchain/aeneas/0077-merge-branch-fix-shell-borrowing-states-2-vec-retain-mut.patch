+#guard pairsR [1, 3, 2, 4] == some (.inl [(1, true), (2, false)])
+#guard pairsR [] == some (.inl [])
+#guard pairsR [1, 3, 1, 4] == some (.inr 1)
+#guard pairsR [5, 3, 7] == some (.inr 7)
+
+/-- `SetVisitor<u32>` (a `PhantomData<fn() -> T>`). -/
+def setR (xs : List Nat) : Option (Sum (List Nat) Nat) :=
+  match deserialize_set (vec (xs.map u)) with
+  | ok (core.result.Result.Ok v) => some (.inl (v.val.map (·.val)))
+  | ok (core.result.Result.Err e) => some (.inr e.val)
+  | _ => none
+
+#guard setR [3, 1, 2] == some (.inl [3, 1, 2])
+#guard setR [3, 1, 3] == some (.inr 3)
+
