+    generic `Deserialize` of `Pairs`: the pairs, or the rejected key word. -/
+def pairsR (xs : List Nat) : Option (Sum (List (Nat × Bool)) Nat) :=
+  match deserialize_pairs (vec (xs.map u)) with
+  | ok (core.result.Result.Ok v) => some (.inl (v.val.map fun (k, b) => (k.val, b)))
+  | ok (core.result.Result.Err e) => some (.inr e.val)
+  | _ => none
