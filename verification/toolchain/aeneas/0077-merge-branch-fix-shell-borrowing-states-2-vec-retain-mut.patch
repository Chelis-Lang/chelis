+    List.find
+      (fun (c : T.trait_param) -> c.clause_id = inst.cs_clause)
+      decl.generics.trait_clauses
+  in
+  let tr =
+    translate_fwd_trait_ref (Some span) ctx
+      { kind = T.Clause (T.Free inst.cs_clause); trait_decl_ref = c.trait }
+  in
+  let method_decl = A.FunDeclId.Map.find inst.cs_method ctx.fun_ctx.fun_decls in
+  let method_sig =
+    translate_fun_sig_from_decomposed
+      (translate_fun_sig_from_decl_to_decomposed ctx method_decl)
+  in
+  (* The instantiation of the trait method declaration by the bound: its trait
+     clauses are those of the trait, in order, and the clause of the trait
+     itself ([Self]), which is the bound *)
+  let decl_generics = tr.trait_decl_ref.decl_generics in
+  let refs = ref decl_generics.trait_refs in
+  let trait_refs =
+    List.map
+      (fun (c : trait_param) ->
+        if c.trait_id = tr.trait_decl_ref.trait_decl_id then tr
+        else
+          match !refs with
+          | r :: rs ->
+              refs := rs;
+              r
+          | [] ->
+              [%craise] span
+                "Model consuming a closure: the bound's call_mut has trait \
+                 clauses of its own")
+      method_sig.generics.trait_clauses
+  in
+  let generics = { decl_generics with trait_refs } in
+  [%cassert] span
+    (List.length method_sig.generics.types = List.length generics.types
+    && List.length method_sig.generics.const_generics
+       = List.length generics.const_generics
+    && !refs = [])
+    ("Model consuming a closure: the bound's call_mut has parameters of its \
+      own (types "
+    ^ string_of_int (List.length method_sig.generics.types)
+    ^ "/"
+    ^ string_of_int (List.length generics.types)
+    ^ ", clauses "
+    ^ string_of_int (List.length method_sig.generics.trait_clauses)
+    ^ "/"
+    ^ string_of_int (List.length decl_generics.trait_refs)
+    ^ ")");
+  let call =
+    adapt_dictionary_method
+      ~through:(tr.trait_decl_ref.trait_decl_id, tr.trait_id)
+      ~give_back_args:true span ctx method_decl method_sig generics (State [ 0 ])
+  in
+  let closure_ty = List.nth fun_ty.fwd_inputs inst.cs_closure in
+  (match call.ty with
+  | TArrow
+      ( f,
+        TArrow
+          ( _,
+            TAdt
+              ( TBuiltin TResult,
+                { types = [ TAdt (TTuple, { types = [ _; f'; _ ]; _ }) ]; _ } )
+          ) )
+    when f = closure_ty && f' = closure_ty -> ()
+  | _ ->
+      [%craise] span
+        "Model consuming a closure: the closure's call does not return its \
+         state and its argument");
+  (* The model: the output and the final state of every input *)
+  let raw_tys = fun_ty.fwd_output :: fun_ty.fwd_inputs in
+  let vars = List.map (fresh (Some "model_state")) raw_tys in
+  let finals = List.tl vars in
+  let func =
+    {
+      e =
+        Qualif
+          {
+            id =
+              FunOrOp
+                (Fun
+                   (Pure
+                      (ThreadedModel { model = inst.cs_model; dictionaries = [] })));
+            generics = { types = []; const_generics = []; trait_refs = [] };
+          };
+      ty =
+        mk_arrows (call.ty :: fun_ty.fwd_inputs)
+          (mk_result_ty (mk_simpl_tuple_ty raw_tys));
+    }
+  in
+  let raw_call =
+    [%add_loc] mk_apps span func (call :: List.map mk_texpr_from_fvar inputs)
+  in
+  (* The results of the instance *)
+  let groups =
+    RegionsHierarchy.compute_regions_hierarchy_for_sig (Some span) ctx.crate
+      { item_binder_params = decl.generics; item_binder_value = decl.signature }
+  in
+  let given_back =
+    List.filter_map
+      (fun (((gid, (back : back_sg_info)), ty) :
+             (T.region_group_id * back_sg_info) * (_ * ty) option) ->
+        match ty with
+        | None -> None
+        | Some (_, ty) -> (
+            let g =
+              List.find (fun (g : T.region_var_group) -> g.id = gid) groups
+            in
+            let regions = T.RegionId.Set.of_list g.regions in
+            let holders =
+              List.filter
+                (fun (_, input) ->
+                  TypesUtils.ty_has_mut_borrow_for_region_in_set
+                    ctx.type_ctx.type_infos regions input)
+                (List.mapi (fun i ty -> (i, ty)) decl.signature.inputs)
+            in
+            match holders with
+            | [ (i, _) ]
+              when back.inputs = [] && back.early = []
+                   && ty = (List.nth finals i).ty ->
+                Some (mk_texpr_from_fvar (List.nth finals i))
+            | _ ->
+                [%craise] span
+                  "Model consuming a closure: a region group does not give \
+                   back the final state of one input"))
+      (List.combine
+         (T.RegionGroupId.Map.bindings fun_ty.back_sg)
+         (compute_back_tys_with_info fun_ty))
+  in
+  let outputs =
+    (if fun_ty.fwd_info.ignore_output then []
+     else [ mk_texpr_from_fvar (List.hd vars) ])
+    @ given_back
+  in
+  let body =
+    mk_closed_let span true
+      (mk_simpl_tuple_pat (List.map (mk_tpat_from_fvar None) vars))
+      raw_call
+      (mk_result_ok_texpr span (mk_simpl_tuple_texpr span outputs))
+  in
+  mk_closed_fun_body span (List.map (mk_tpat_from_fvar None) inputs) body
