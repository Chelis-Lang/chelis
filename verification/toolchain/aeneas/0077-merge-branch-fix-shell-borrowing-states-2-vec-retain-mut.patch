+//@ [!lean] skip
+//@ [lean] subdir=VecRetainMut
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! `Vec::retain_mut`. Charon's `--monomorphize-mut` specializes its bound
+//! `F: FnMut(&mut T) -> bool` to `FnMut<F, (&mut T,), bool>`, modeled by the
+//! schema `core.ops.function.FnMutMutArg`, whose `call_mut` returns the closure
+//! state and the element. A closure capturing mutable borrows is adapted to it
+//! (the returned state recombines the values given back to the captured
+//! borrows), and the `retain_mut` model threads this state through the calls,
+//! so the caller reads the final values of the captured borrows. The first
+//! shape is that of `chelis_ir::axis_sources` (merge the buckets intersecting a
+//! mask, then push the merged bucket).
+//! `VecRetainMut/Checks.lean` evaluates the models on the inputs of the
+//! `native` test module below and compares with the native results.
+
+/// Merges every bucket intersecting `mask` into one bucket holding `entry`
+/// last; the closure captures two mutable borrows, read after `retain_mut`.
+pub fn merge(buckets: &mut Vec<(u64, Vec<u32>)>, mask: u64, entry: u32) {
+    let mut merged: Vec<u32> = Vec::new();
+    let mut merged_mask = mask;
+    buckets.retain_mut(|(bucket_mask, bucket)| {
+        if *bucket_mask & merged_mask != 0 {
+            merged_mask |= *bucket_mask;
+            merged.append(bucket);
+            false
+        } else {
+            true
+        }
+    });
+    merged.push(entry);
+    buckets.push((merged_mask, merged));
+}
+
+/// Doubles the kept elements, drops the odd ones, and counts the calls and the
+/// dropped elements (two captured mutable borrows).
+pub fn double_evens(values: &mut Vec<u32>) -> (u32, u32) {
+    let mut calls = 0u32;
+    let mut dropped = 0u32;
+    values.retain_mut(|x| {
+        calls += 1;
+        if *x % 2 == 0 {
+            *x *= 2;
+            true
+        } else {
+            dropped += 1;
+            false
+        }
+    });
+    (calls, dropped)
+}
+
+/// A closure capturing nothing mutable.
+pub fn clamp_below(values: &mut Vec<u32>, limit: u32) {
+    values.retain_mut(|x| {
+        if *x > limit {
+            *x = limit;
+        }
+        *x != 0
+    });
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn merge_absorbs_intersecting_buckets() {
+        let mut buckets = vec![(0b0011, vec![1, 2]), (0b0100, vec![3]), (0b1000, vec![4])];
+        merge(&mut buckets, 0b1001, 9);
+        assert_eq!(buckets, vec![(0b0100, vec![3]), (0b1011, vec![1, 2, 4, 9])]);
+        merge(&mut buckets, 0b10000, 5);
+        assert_eq!(
+            buckets,
+            vec![(0b0100, vec![3]), (0b1011, vec![1, 2, 4, 9]), (0b10000, vec![5])]
+        );
+    }
+
+    #[test]
+    fn double_evens_counts() {
+        let mut values = vec![1, 2, 3, 4, 6];
+        assert_eq!(double_evens(&mut values), (5, 2));
+        assert_eq!(values, vec![4, 8, 12]);
+        let mut values = vec![];
+        assert_eq!(double_evens(&mut values), (0, 0));
+        assert_eq!(values, Vec::<u32>::new());
+    }
+
+    #[test]
+    fn clamp_below_limits() {
+        let mut values = vec![0, 5, 12, 0, 7];
+        clamp_below(&mut values, 6);
+        assert_eq!(values, vec![5, 6, 6]);
+    }
+}
