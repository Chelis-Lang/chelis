+(** The partial-monomorphization instance of a model consuming a closure at a
+    closure capturing mutable borrows that a declaration is, if it is one (see
+    [closure_state_instance]). *)
+let closure_state_instance_of_decl (crate : A.crate) (decl : A.fun_decl) =
+  if Config.backend () <> Config.Lean then None
+  else
+    match List.rev decl.item_meta.name with
+    | T.PeInstantiated shape :: _
+      when not
+             (A.FunDeclId.Set.mem decl.def_id
+                !ExtractBuiltin.admitted_fun_instances) -> (
+        match
+          ExtractBuiltin.find_generic_fun_info
+            (NameMatcher.ctx_from_crate crate)
+            decl.item_meta.name
+        with
+        | Some info -> closure_state_fun_instance crate decl info shape
+        | None -> None)
+    | _ -> None
+
+(** The body of a partial-monomorphization instance of a model consuming a
+    closure capturing mutable borrows (see [closure_state_instance]): the
+    model's variant applied to the closure's canonical call and to the inputs;
+    it returns the output and the final state of every input, and each region
+    group of the instance gives back the final state of the one input holding
+    its borrows. Raises if a layout differs: the instance then stays an unknown
+    external. *)
+let closure_state_fun_body (span : Meta.span) (ctx : Contexts.decls_ctx)
+    (fresh : string option -> ty -> fvar) (decl : A.fun_decl)
+    (dsg : decomposed_fun_sig) (inst : closure_state_instance) : fun_body =
+  let fun_ty = dsg.fun_ty in
+  [%cassert] span
+    (fun_ty.state_outputs = []
+    && fun_ty.fwd_info.effect_info.can_fail
+    && List.length fun_ty.fwd_inputs = List.length decl.signature.inputs)
