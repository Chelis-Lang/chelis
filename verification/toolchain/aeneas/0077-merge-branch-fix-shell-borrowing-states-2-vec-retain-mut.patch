diff --git a/backends/lean/Aeneas/Std/Core/Ops.lean b/backends/lean/Aeneas/Std/Core/Ops.lean
index 052e5d4..e4965a4 100644
--- a/backends/lean/Aeneas/Std/Core/Ops.lean
+++ b/backends/lean/Aeneas/Std/Core/Ops.lean
@@ -98,6 +98,20 @@ structure core.ops.function.FnMutSharedMutArg (Self : Type u) (T : Type v)
   FnOnceInst : core.ops.function.FnOnceSharedMutArg Self T Output
   call_mut : Self → T → Result (Output × Self)
 
+/-- The specialization `FnMut<(&'a mut T,)>` that Charon's `--monomorphize-mut`
+    creates for a closure taking one mutable borrow (e.g. the predicate of
+    `Vec::retain_mut`), when the closure type is a parameter: the call returns
+    the output, the borrowed argument and the closure state (the argument's
+    region is a parameter of the trait, the region of `&mut self` one of the
+    method). (For a closure capturing mutable borrows the specialization is
+    specific to the closure; such a bound is not this schema, see
+    `ModelStateABI.closure_state_instance`.) -/
+@[rust_trait "core::ops::function::FnMut<@Self, (&'a mut @T), @Output>"
+  (parentClauses := ["FnOnceInst"])]
+structure core.ops.function.FnMutMutArg (Self : Type u) (T : Type v) (Output : Type w) where
+  FnOnceInst : core.ops.function.FnOnceMutArg Self T Output
+  call_mut : Self → T → Result (Output × T × Self)
+
 /-! ### Closure specializations at borrowing states
 
 A partial-monomorphization instance of a modeled function which threads a state
diff --git a/backends/lean/Aeneas/Std/Vec.lean b/backends/lean/Aeneas/Std/Vec.lean
index b3036d0..ef03272 100644
--- a/backends/lean/Aeneas/Std/Vec.lean
+++ b/backends/lean/Aeneas/Std/Vec.lean
@@ -475,6 +475,40 @@ def alloc.vec.Vec.append {T : Type} (v other : alloc.vec.Vec T) :
     ok (⟨ v.val ++ other.val, by scalar_tac ⟩, ⟨ [], by simp ⟩)
   else fail .panic
 
+/-- The elements kept by `Vec::retain_mut` and the final closure state: `call` is
+    called once on every element, in order, with the element, and the (possibly
+    updated) elements for which it returns `true` are kept, in order. The
+    closure state is threaded through the calls and returned. -/
+def alloc.vec.Vec.retainMutList {T F : Type} (call : F → T → Result (Bool × F × T)) :
+    (xs : List T) → F → Result ({ys : List T // ys.length ≤ xs.length} × F)
+  | [], f => ok (⟨[], by simp⟩, f)
+  | x :: xs, f => do
+    let (keep, f, x) ← call f x
+    let (rest, f) ← alloc.vec.Vec.retainMutList call xs f
+    if keep then ok (⟨x :: rest.val, by have := rest.property; simp; omega⟩, f)
+    else ok (⟨rest.val, by have := rest.property; simp; omega⟩, f)
+
+/-- `Vec::retain_mut` (alloc/src/vec/mod.rs) given the call of its closure: the
+    output, the vector and the final closure state. A partial-monomorphization
+    instance at a closure capturing mutable borrows is this model applied to the
+    closure's call recovered from its region-indexed `call_mut`, the final state
+    giving back the captured borrows (`ModelStateABI.closure_state_fun_body`). -/
+def alloc.vec.Vec.retain_mut_with {T F : Type} (call : F → T → Result (Bool × F × T))
+    (v : alloc.vec.Vec T) (f : F) : Result (Unit × alloc.vec.Vec T × F) := do
+  let (ys, f) ← alloc.vec.Vec.retainMutList call v.val f
+  ok ((), ⟨ys.val, Nat.le_trans ys.property v.property⟩, f)
+
+/-- `Vec::retain_mut` (alloc/src/vec/mod.rs): see `retain_mut_with`. Only
+    `call_mut` is called. -/
+@[rust_fun "alloc::vec::{alloc::vec::Vec<@T>}::retain_mut" (keepParams := [true, false, true])]
+def alloc.vec.Vec.retain_mut {T F : Type} (fnInst : core.ops.function.FnMutMutArg F T Bool)
+    (v : alloc.vec.Vec T) (f : F) : Result (Unit × alloc.vec.Vec T × F) :=
+  alloc.vec.Vec.retain_mut_with
+    (fun f x => do
+      let (keep, x, f) ← fnInst.call_mut f x
+      ok (keep, f, x))
+    v f
+
 @[rust_fun "alloc::vec::{core::ops::deref::Deref<alloc::vec::Vec<@T>, [@T]>}::deref"
            -canFail -lift (keepParams := [true, false])]
