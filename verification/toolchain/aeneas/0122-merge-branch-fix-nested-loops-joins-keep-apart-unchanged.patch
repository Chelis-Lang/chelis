--- /dev/null
+++ b/tests/src/loop-untouched-shared-reborrows.rs
@@ -0,0 +1,250 @@
+//@ [!lean] skip
+//@ [lean] subdir=LoopUntouchedSharedReborrows
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::option::{core::option::Option}
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! A shared reference returned by a call made before a loop, which borrows
+//! `*self` and reborrows shared arguments (`out = self.expr_type(expr, scope)`),
+//! compared with in the loop, then `self` written and the arguments read after
+//! the write (the shape of
+//! `chelis_types::linearity::Checker::maybe_mark_reusable_app_input`). A switch
+//! reborrows the shared arguments (an abstraction lends the reborrow `expr`
+//! now holds); the abstraction of the call borrows `*self` and those
+//! reborrows. The join of the loop entrance with the continue context kept
+//! both abstractions unchanged, and its final canonicalization merged the
+//! call into the reborrow: writing `self.info` then ended the merged
+//! abstraction, and with it the reborrow of `expr`, which the push still reads
+//! ("Can not apply a projection to the ⊥ value"). That canonicalization no
+//! longer merges two abstractions the join kept unchanged when one borrows a
+//! loan held by a variable (`*self`) and a variable borrows a loan of the
+//! other (`expr`).
+//!
+//! With `continue` branches in the loop (`mark_kids`), the first join of the
+//! loop body kept the call abstraction `{ SB .., Some (SL l) }` unchanged, but
+//! its final canonicalization normalized it to `{ SB .., SL l }`: it then
+//! differed from its version in the context of the early `continue`, and the
+//! join of the two contexts merged it (and the reborrows it borrows) into a
+//! join abstraction. That canonicalization now gives the abstractions the join
+//! kept unchanged, and which it does not merge, their shape back.
+//!
+//! Control (`Targets::total`, the shape of
+//! `chelis_deep::annotations::WrtTargets::variables`): a match whose arms
+//! borrow different variables (a promoted empty slice in one, a call on the
+//! payload in the other), joined, then iterated. The join's own abstraction
+//! borrows the promoted slice and the reborrow of `self`: it is canonicalized
+//! as before (keeping it apart as well made the arms no longer match the
+//! joined context).
+//!
+//! LoopUntouchedSharedReborrows/Checks.lean compares the model, including the
+//! checker given back, with the native results asserted in the native test
+//! module.
+
+pub struct Checker {
+    pub info: Vec<u32>,
+    pub top: Vec<u32>,
+}
+
+impl Checker {
+    fn expr_type<'a>(&'a self, e: &'a u32, scope: &'a Vec<u32>) -> Option<&'a u32> {
+        scope.get(*e as usize)
+    }
+
+    fn owned(&self, e: &u32, scope: &Vec<u32>) -> bool {
+        self.expr_type(e, scope).is_some()
+    }
+
+    /// Push `expr` when the type of one of the `kids` is the type of `expr`
+    pub fn mark(&mut self, expr: &u32, kids: &[u32], scope: &Vec<u32>) {
+        if !self.owned(expr, scope) {
+            return;
+        }
+        let Some(out) = self.expr_type(expr, scope) else {
+            return;
+        };
+        for arg in kids.iter() {
+            if self.expr_type(arg, scope) == Some(out) {
+                self.info.push(*expr);
+                break;
+            }
+        }
+    }
+
+    /// Push `expr` plus the position (after the head) of the first kid whose
+    /// type is the type of `expr`, skipping the kids `0` and those without a
+    /// type: the loop has `continue` branches (the shape of
+    /// `maybe_mark_reusable_app_input`)
+    pub fn mark_kids(&mut self, expr: &u32, kids: &[u32], scope: &Vec<u32>) {
+        if !self.owned(expr, scope) {
+            return;
+        }
+        let Some(out) = self.expr_type(expr, scope) else {
+            return;
+        };
+        for (index, arg) in kids.iter().skip(1).enumerate() {
+            if *arg == 0 || !self.owned(arg, scope) {
+                continue;
+            }
+            if self.expr_type(arg, scope).is_some_and(|t| *t == *out) {
+                self.info.push(*expr + index as u32);
+                break;
+            }
+        }
+    }
+
+    /// Same, and count the matching kids in `top` (the loop goes on)
+    pub fn mark_all(&mut self, expr: &u32, kids: &[u32], scope: &Vec<u32>) -> usize {
+        let Some(out) = self.expr_type(expr, scope) else {
+            return 0;
+        };
+        let mut n = 0;
+        for arg in kids.iter() {
+            if self.expr_type(arg, scope) == Some(out) {
+                n += 1;
+            }
+        }
+        if n > 0 {
+            self.top.push(*expr + n as u32);
+        }
+        n
+    }
+
+    /// Count the leading kids whose type is the type of `expr`, a `while`
+    /// loop; when there are some, push `expr` plus the length of `scope` and
+    /// the count (both arguments are read after `self` is written)
+    pub fn mark_len(&mut self, expr: &u32, kids: &[u32], scope: &Vec<u32>) -> u32 {
+        if !self.owned(expr, scope) {
+            return 0;
+        }
+        let Some(out) = self.expr_type(expr, scope) else {
+            return 0;
+        };
+        let mut i = 0;
+        while i < kids.len() {
+            if self.expr_type(&kids[i], scope) != Some(out) {
+                break;
+            }
+            i += 1;
+        }
+        if i > 0 {
+            self.info.push(*expr + scope.len() as u32 + i as u32);
+        }
+        *expr + scope[0]
+    }
+}
+
+pub struct Var {
+    pub name: u32,
+}
+
+pub enum Targets {
+    One(Var),
+    Many(Var, Vec<Var>),
+}
+
+impl Targets {
+    /// The sum of the names of the targets
+    pub fn total(&self) -> u32 {
+        let (first, rest) = match self {
+            Self::One(v) => (v, &[][..]),
+            Self::Many(f, r) => (f, r.as_slice()),
+        };
+        let mut n = 0;
+        for v in std::iter::once(first).chain(rest) {
+            n += v.name;
+        }
+        n
+    }
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    fn checker() -> Checker {
+        Checker { info: vec![9], top: vec![] }
+    }
+
+    #[test]
+    fn mark_native() {
+        let scope = vec![10, 20, 10, 30];
+        let mut c = checker();
+        c.mark(&0, &[1, 3, 2], &scope);
+        assert_eq!((c.info, c.top), (vec![9, 0], vec![]));
+        let mut c = checker();
+        c.mark(&1, &[0, 2, 3], &scope);
+        assert_eq!((c.info, c.top), (vec![9], vec![]));
+        let mut c = checker();
+        c.mark(&7, &[0, 1], &scope);
+        assert_eq!((c.info, c.top), (vec![9], vec![]));
+        let mut c = checker();
+        c.mark(&2, &[0, 2], &scope);
+        assert_eq!((c.info, c.top), (vec![9, 2], vec![]));
+        let mut c = checker();
+        c.mark(&2, &[], &scope);
+        assert_eq!((c.info, c.top), (vec![9], vec![]));
+    }
+
+    #[test]
+    fn mark_kids_native() {
+        let scope = vec![10, 20, 10, 30];
+        let mut c = checker();
+        c.mark_kids(&0, &[5, 0, 3, 2, 2], &scope);
+        assert_eq!((c.info, c.top), (vec![9, 2], vec![]));
+        let mut c = checker();
+        c.mark_kids(&1, &[1, 1, 7, 3], &scope);
+        assert_eq!((c.info, c.top), (vec![9, 1], vec![]));
+        let mut c = checker();
+        c.mark_kids(&2, &[0, 9, 0, 1], &scope);
+        assert_eq!((c.info, c.top), (vec![9], vec![]));
+        let mut c = checker();
+        c.mark_kids(&2, &[2, 0, 5, 2], &scope);
+        assert_eq!((c.info, c.top), (vec![9, 4], vec![]));
+        let mut c = checker();
+        c.mark_kids(&4, &[0, 2], &scope);
+        assert_eq!((c.info, c.top), (vec![9], vec![]));
+        let mut c = checker();
+        c.mark_kids(&3, &[], &scope);
+        assert_eq!((c.info, c.top), (vec![9], vec![]));
+    }
+
+    #[test]
+    fn mark_all_native() {
+        let scope = vec![10, 20, 10, 30];
+        let mut c = checker();
+        assert_eq!(c.mark_all(&0, &[0, 2, 1, 2], &scope), 3);
+        assert_eq!((c.info, c.top), (vec![9], vec![3]));
+        let mut c = checker();
+        assert_eq!(c.mark_all(&3, &[0, 1], &scope), 0);
+        assert_eq!((c.info, c.top), (vec![9], vec![]));
+        let mut c = checker();
+        assert_eq!(c.mark_all(&5, &[0], &scope), 0);
+        assert_eq!((c.info, c.top), (vec![9], vec![]));
+    }
+
+    #[test]
+    fn mark_len_native() {
+        let scope = vec![10, 20, 10, 30];
+        let mut c = checker();
+        assert_eq!(c.mark_len(&0, &[2, 0, 1, 2], &scope), 10);
+        assert_eq!((c.info, c.top), (vec![9, 6], vec![]));
+        let mut c = checker();
+        assert_eq!(c.mark_len(&1, &[0, 1], &scope), 11);
+        assert_eq!((c.info, c.top), (vec![9], vec![]));
+        let mut c = checker();
+        assert_eq!(c.mark_len(&6, &[0], &scope), 0);
+        assert_eq!((c.info, c.top), (vec![9], vec![]));
+        let mut c = checker();
+        assert_eq!(c.mark_len(&3, &[3, 3, 3], &scope), 13);
+        assert_eq!((c.info, c.top), (vec![9, 10], vec![]));
+        let mut c = checker();
+        assert_eq!(c.mark_len(&2, &[0, 7], &scope), 12);
+        assert_eq!((c.info, c.top), (vec![9, 7], vec![]));
+    }
+
+    #[test]
+    fn total_native() {
+        assert_eq!(Targets::One(Var { name: 4 }).total(), 4);
+        let many = Targets::Many(Var { name: 1 }, vec![Var { name: 2 }, Var { name: 5 }]);
+        assert_eq!(many.total(), 8);
+        assert_eq!(Targets::Many(Var { name: 3 }, vec![]).total(), 3);
+    }
+}
