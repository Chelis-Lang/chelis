+(** Move array elements out through shared indexings.
+
+    Rust moves an element out of an owned array only by a constant index (array
+    patterns: [let [a, b] = arr]). Charon lowers the move to
+    [b = &mut arr; r = @ArrayIndexMut(move b, k); x = move ( *r).path]: a move
+    behind a mutable borrow, which the interpreter cannot evaluate (ending the
+    borrow would give back an array holding a moved element). The borrow
+    checker forbids any later read of the moved element: the array is only
+    accessed at its other constant indices, dropped or reassigned as a whole.
+    So the move may leave the element in the array: it reads the element
+    through a shared indexing [b = &arr; r = @ArrayIndexShared(move b, k)],
+    which [share_repeated_shared_indexing] then identifies with the shared
+    indexings of the same element that tested its variants (refutable
+    patterns), and the interpreter evaluates [move ( *r).path] as a read of a
+    value without borrows (see
+    [InterpExpressions.place_moves_through_shared_borrow]).
+
+    Applies to adjacent statements when [b] and [r] have no other use. *)
+let shared_indexing_for_array_moves (_crate : crate) (f : fun_decl) : fun_decl =
+  match f.body with
+  | StructuredBody body ->
+      let counts = ref LocalId.Map.empty in
+      let occurrences =
+        object
+          inherit [_] iter_statement as super
+
+          method! visit_place () p =
+            match p.kind with
+            | PlaceLocal id ->
+                counts :=
+                  LocalId.Map.update id
+                    (fun n -> Some (1 + Option.value n ~default:0))
+                    !counts
+            | _ -> super#visit_place () p
+        end
+      in
+      occurrences#visit_block () body.body;
+      let used_twice id = LocalId.Map.find_opt id !counts = Some 2 in
+      let rec moved_through_deref id (p : place) =
+        match p.kind with
+        | PlaceProjection ({ kind = PlaceLocal root; _ }, Deref) -> root = id
+        | PlaceProjection (p, _) -> moved_through_deref id p
+        | _ -> false
+      in
+      (* Skip the storage markers between the statements *)
+      let rec split lives = function
+        | ({ kind = StorageLive _; _ } as st) :: rest -> split (st :: lives) rest
+        | st :: rest -> Some (List.rev lives, st, rest)
+        | [] -> None
+      in
+      let converted = ref LocalId.Set.empty in
+      let rec rewrite (sts : statement list) : statement list =
+        match sts with
+        | ({ kind = Assign (({ kind = PlaceLocal b; _ } as bp), RvRef (arr, (BMut | BTwoPhaseMut), meta)); _ } as st0)
+          :: rest -> (
+            match split [] rest with
+            | Some
+                ( lives0,
+                  ({
+                     kind =
+                       Call
+                         ({
+                            func =
+                              FnOpRegular
+                                ({
+                                   kind =
+                                     FunId
+                                       (FBuiltin
+                                          (Index
+                                             {
+                                               is_array = true;
+                                               mutability = RMut;
+                                               is_range = false;
+                                             }));
+                                   _;
+                                 } as fn_ptr);
+                            args = [ Move { kind = PlaceLocal b'; _ }; idx ];
+                            dest = { kind = PlaceLocal r; _ } as rp;
+                          });
+                     _;
+                   } as st1),
+                  rest' )
+              when b = b' && used_twice b && used_twice r -> (
+                match split [] rest' with
+                | Some
+                    ( lives1,
+                      ({ kind = Assign (_, Use (Move p)); _ } as st2),
+                      rest'' )
+                  when moved_through_deref r p ->
+                    converted := LocalId.Set.add b (LocalId.Set.add r !converted);
+                    let st0 = { st0 with kind = Assign (bp, RvRef (arr, BShared, meta)) } in
+                    let fn_ptr =
+                      {
+                        fn_ptr with
+                        kind =
+                          FunId
+                            (FBuiltin
+                               (Index
+                                  {
+                                    is_array = true;
+                                    mutability = RShared;
+                                    is_range = false;
+                                  }));
+                      }
+                    in
+                    let st1 =
+                      {
+                        st1 with
+                        kind =
+                          Call
+                            {
+                              func = FnOpRegular fn_ptr;
+                              args = [ Move bp; idx ];
+                              dest = rp;
+                            };
+                      }
+                    in
+                    (st0 :: lives0) @ (st1 :: lives1) @ (st2 :: rewrite rest'')
+                | _ -> st0 :: rewrite rest)
+            | _ -> st0 :: rewrite rest)
+        | st :: rest -> st :: rewrite rest
+        | [] -> []
+      in
+      let rewrite_blocks =
+        object
+          inherit [_] map_statement as super
+
+          method! visit_block env b =
+            let b = super#visit_block env b in
+            { b with statements = rewrite b.statements }
+        end
+      in
+      let body_body = rewrite_blocks#visit_block () body.body in
+      if LocalId.Set.is_empty !converted then f
+      else
+        (* The borrow and the result become shared references *)
+        let shared (ty : ty) : ty =
+          match ty with
+          | TRef (r, ty, RMut) -> TRef (r, ty, RShared)
+          | _ -> ty
+        in
+        let retype =
+          object
+            inherit [_] map_statement as super
+
+            method! visit_place env p =
+              match p.kind with
+              | PlaceLocal id when LocalId.Set.mem id !converted ->
+                  { p with ty = shared p.ty }
+              | _ -> super#visit_place env p
+          end
+        in
+        let locals =
+          List.map
+            (fun (local : local) ->
+              if LocalId.Set.mem local.index !converted then
+                { local with local_ty = shared local.local_ty }
+              else local)
+            body.locals.locals
+        in
+        let body =
+          {
+            body with
+            body = retype#visit_block () body_body;
+            locals = { body.locals with locals };
+          }
+        in
+        { f with body = StructuredBody body }
+  | _ -> f
