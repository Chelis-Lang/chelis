+(** Rust rejects moving out of a place behind a reference. The pre-pass
+    [PrePasses.shared_indexing_for_array_moves] produces such a move for one
+    construct: moving an element out of an owned array by a constant index
+    (array patterns: [let [a, b] = arr]), as [move ( *@ArrayIndexShared(&arr,
+    k)).path]. The borrow checker forbids any later read of the moved element
+    (the array is only accessed at its other constant indices, dropped or
+    reassigned as a whole), so the move reads the element and leaves it in
+    place. This duplicates the value: it must hold neither borrows nor loans. *)
+let place_moves_through_shared_borrow (p : place) : bool =
+  let rec aux (p : place) =
+    match p.kind with
+    | PlaceLocal _ | PlaceGlobal _ -> false
+    | PlaceProjection (p', Deref) -> (
+        match p'.ty with
+        | TRef (_, _, RShared) -> true
+        | _ -> aux p')
+    | PlaceProjection (p', _) -> aux p'
+  in
+  aux p
+
