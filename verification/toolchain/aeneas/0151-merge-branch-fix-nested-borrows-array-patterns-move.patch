+import ArrayPatternMove.ArrayPatternMove
+
+/-! Evaluate the model of `tests/src/array-pattern-move.rs` on the inputs of
+    its `native` test module and compare with the native results. -/
+
+namespace array_pattern_move.checks
+open Aeneas Aeneas.Std Result
+open array_pattern_move
+
+def u (x : Nat) : U32 := ⟨BitVec.ofNat _ x⟩
+
+def nats (v : alloc.vec.Vec U32) : List Nat := v.val.map (·.val)
+
+def oneName (n : Nat) (isName : Bool) (span : Nat) : Option (Except Nat (String × Nat)) :=
+  match run_one_name (u n) isName (u span) with
+  | ok (core.result.Result.Ok (s, k)) => some (.ok (s, k.val))
+  | ok (core.result.Result.Err e) => some (.error e.val)
+  | _ => none
+
+def pair (firstName list extra : Bool) : Option (Except Nat (Nat × Nat)) :=
+  match run_pair firstName list extra with
+  | ok (core.result.Result.Ok (n, m)) => some (.ok (n.val, m.val))
+  | ok (core.result.Result.Err e) => some (.error e.val)
+  | _ => none
+
+def split (x y tag : Nat) : Option (List Nat × List Nat × Nat) :=
+  match run_split (u x) (u y) (u tag) with
+  | ok (a, b, t) => some (nats a, nats b, t.val)
+  | _ => none
+
+/-- `(out, b)`: `out` observes the caller's write through the reference after
+    the call -/
+def pushLens (k : Nat) : Option (List Nat × List Nat) :=
+  match run_push_lens (u k) with
+  | ok (out, b) => some (nats out, nats b)
+  | _ => none
+
+def singles (n : Nat) (bad : Bool) : Option (Except Nat Nat) :=
+  match run_singles (u n) bad with
+  | ok (core.result.Result.Ok t) => some (.ok t.val)
+  | ok (core.result.Result.Err e) => some (.error e.val)
+  | _ => none
+
+-- one_name_native
+#guard oneName 1 true 4 == some (.ok ("x", 4))
+#guard oneName 1 false 4 == some (.error 2)
+#guard oneName 0 true 4 == some (.error 1)
+#guard oneName 2 true 4 == some (.error 1)
+
+-- pair_native
+#guard pair false true false == some (.ok (15, 2))
+#guard pair true true false == some (.ok (10, 2))
+#guard pair false false false == some (.error 4)
+#guard pair false true true == some (.error 3)
+
+-- split_native
+#guard split 1 2 9 == some ([1, 9], [2, 3], 10)
+#guard split 0 0 0 == some ([0, 0], [0, 1], 1)
+
+-- push_lens_native
+#guard pushLens 3 == some ([100, 1, 3, 200], [2, 3, 7])
+#guard pushLens 0 == some ([100, 1, 0, 200], [2, 3, 7])
+
+-- singles_native
+#guard singles 3 false == some (.ok 6)
