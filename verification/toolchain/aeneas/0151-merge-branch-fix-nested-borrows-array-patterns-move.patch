+//@ [!lean] skip
+//@ [lean] subdir=NestedBorrowsOutputSharedLevels
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::option::{core::option::Option} --include core::ops::deref::{core::ops::deref::Deref} --include core::ops::deref::{core::ops::deref::DerefMut}
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! A function whose output `&'c View<'d>` has its levels in different region
+//! groups (the regions of a closure signature are all distinct: `|p|
+//! p.children.first()` on `&'a Parts<'b>`). The backward function of a region
+//! group ends the return abstractions of the other groups too, including their
+//! sub-abstractions: the level of `'d` was rejected ('ending a sub-abstraction
+//! of the return abstraction of another region group'). Its borrows are shared:
+//! it consumes and gives back nothing (production: chelis_deep metadata
+//! `check_entries`, `body.as_ref().and_then(|p| p.children.first())`).
+
+#[derive(Clone, Copy)]
+pub enum View<'a> {
+    Num(&'a u32),
+    Name(&'a str),
+    Empty,
+}
+
+pub struct Parts<'a> {
+    pub tag: u32,
+    pub children: Vec<View<'a>>,
+}
+
+pub fn first<'a, 'b, 'c, 'd>(p: &'a Parts<'b>) -> Option<&'c View<'d>>
+where
+    'a: 'c,
+    'b: 'd,
+    'b: 'a,
+{
+    p.children.first()
+}
+
+/// With a mutable borrow: the backward function of its region ends the
+/// return abstractions of the other groups
+pub fn first_counted<'a, 'b, 'c, 'd>(p: &'a Parts<'b>, n: &mut u32) -> Option<&'c View<'d>>
+where
+    'a: 'c,
+    'b: 'd,
+    'b: 'a,
+{
+    *n += p.tag;
+    p.children.get(1)
+}
+
+/// The production shape: a closure passed to `Option::and_then`
+pub fn second_child<'a>(parts: Option<Parts<'a>>) -> Option<View<'a>> {
+    parts.as_ref().and_then(|p| p.children.get(1)).copied()
+}
+
+pub fn value(v: Option<View<'_>>) -> u32 {
+    match v {
+        Some(View::Num(n)) => *n,
+        Some(View::Name(s)) => s.len() as u32 + 100,
+        Some(View::Empty) => 1000,
+        None => 0,
+    }
+}
+
+pub fn mk<'a>(tag: u32, k: &'a u32, name: &'a str, n: u32) -> Parts<'a> {
+    let mut children = Vec::new();
+    if n > 0 {
+        children.push(View::Num(k));
+    }
+    if n > 1 {
+        children.push(View::Name(name));
+    }
+    if n > 2 {
+        children.push(View::Empty);
+    }
+    Parts { tag, children }
+}
+
+pub fn run_first(k: u32, n: u32) -> u32 {
+    let p = mk(1, &k, "abc", n);
+    value(first(&p).copied())
+}
+
+/// The caller writes through the counter after the call, then reads it
+pub fn run_first_counted(tag: u32, n: u32, set: u32) -> (u32, u32) {
+    let k = 7;
+    let p = mk(tag, &k, "ab", n);
+    let mut count = 5;
+    let v = {
+        let c = &mut count;
+        let v = first_counted(&p, &mut *c).copied();
+        *c += set;
+        v
+    };
+    (value(v), count)
+}
+
+pub fn run_second_child(k: u32, some: bool, n: u32) -> u32 {
+    let parts = if some { Some(mk(0, &k, "abcd", n)) } else { None };
+    value(second_child(parts))
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn first_native() {
+        assert_eq!(run_first(9, 1), 9);
+        assert_eq!(run_first(9, 0), 0);
+        assert_eq!(run_first(3, 3), 3);
+    }
+
+    #[test]
+    fn first_counted_native() {
+        assert_eq!(run_first_counted(2, 2, 10), (102, 17));
+        assert_eq!(run_first_counted(0, 1, 0), (0, 5));
+        assert_eq!(run_first_counted(4, 3, 1), (102, 10));
+    }
+
+    #[test]
+    fn second_child_native() {
+        assert_eq!(run_second_child(9, true, 2), 104);
+        assert_eq!(run_second_child(9, true, 1), 0);
+        assert_eq!(run_second_child(9, false, 3), 0);
+        assert_eq!(run_second_child(9, true, 3), 104);
+    }
+}
