@@ -0,0 +1,221 @@
+//@ [!lean] skip
+//@ [lean] subdir=ArrayPatternMove
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::option::{core::option::Option} --include core::ops::deref::{core::ops::deref::Deref} --include core::ops::deref::{core::ops::deref::DerefMut}
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Moving elements out of an owned array by constant indices (array
+//! patterns: `let [a, b] = arr`). Charon lowers each move to
+//! `move *(ArrayIndexMut(&mut arr, i))`, a move behind a mutable borrow, which
+//! the interpreter rejected ('Could not read a borrow'). The borrow checker
+//! forbids any later read of a moved element, so the move reads the element
+//! and leaves it in the array (production: chelis_deep annotations_codec
+//! `variable`/`binder`/`effects`/`decode_value` and the `try_from_expression`
+//! functions of annotations_transform, which destructure `Vec::try_into`
+//! results).
+
+pub enum Atom {
+    Name(String),
+    Num(u32),
+}
+
+pub enum Expr {
+    Atom(Atom, u32),
+    List(Vec<Expr>),
+}
+
+/// The production shape of `VariableRef::try_from_expression`: a refutable
+/// pattern that moves fields out of the single element
+pub fn one_name(children: Vec<Expr>) -> Result<(String, u32), u32> {
+    let arr: [Expr; 1] = match children.try_into() {
+        Ok(arr) => arr,
+        Err(_) => return Err(1),
+    };
+    let [Expr::Atom(Atom::Name(name), span)] = arr else {
+        return Err(2);
+    };
+    Ok((name, span))
+}
+
+/// Two elements: the second is moved after the array was given back by the
+/// first move's `index_mut`
+pub fn pair(items: Vec<Expr>) -> Result<(u32, Vec<Expr>), u32> {
+    let arr: [Expr; 2] = match items.try_into() {
+        Ok(arr) => arr,
+        Err(_) => return Err(3),
+    };
+    let [n, Expr::List(m)] = arr else {
+        return Err(4);
+    };
+    let n = match n {
+        Expr::Atom(Atom::Num(k), s) => k + s,
+        Expr::Atom(Atom::Name(_), s) => s,
+        Expr::List(v) => v.len() as u32,
+    };
+    Ok((n, m))
+}
+
+pub struct Holder {
+    pub arr: [Vec<u32>; 2],
+    pub tag: u32,
+}
+
+/// A partial move out of a field: the other field is read and written after
+/// the moves; the moved vectors are mutated
+pub fn split(mut h: Holder) -> (Vec<u32>, Vec<u32>, u32) {
+    let [mut a, b] = h.arr;
+    a.push(h.tag);
+    h.tag += 1;
+    (a, b, h.tag)
+}
+
+/// The moves happen while a mutable borrow of the caller is live; the caller
+/// writes through it after the call
+pub fn push_lens(out: &mut Vec<u32>, arr: [Vec<u32>; 3]) -> Vec<u32> {
+    let [a, mut b, c] = arr;
+    out.push(a.len() as u32);
+    out.push(c.len() as u32);
+    b.push(7);
+    b
+}
+
+/// In a loop (production: `effects` destructures inside `for child in children`)
+pub fn singles(groups: Vec<Vec<Vec<u32>>>) -> Result<u32, u32> {
+    let mut total = 0;
+    for g in groups {
+        let [mut x]: [Vec<u32>; 1] = match g.try_into() {
+            Ok(arr) => arr,
+            Err(_) => return Err(9),
+        };
+        x.push(1);
+        total += x.len() as u32;
+    }
+    Ok(total)
+}
+
+pub fn mk_atom(name: bool, s: String, k: u32, span: u32) -> Expr {
+    if name { Expr::Atom(Atom::Name(s), span) } else { Expr::Atom(Atom::Num(k), span) }
+}
+
+pub fn run_one_name(n: u32, name: bool, span: u32) -> Result<(String, u32), u32> {
+    let mut v = Vec::new();
+    let mut i = 0;
+    while i < n {
+        v.push(mk_atom(name, String::from("x"), i, span + i));
+        i += 1;
+    }
+    one_name(v)
+}
+
+pub fn run_pair(first_name: bool, list: bool, extra: bool) -> Result<(u32, usize), u32> {
+    let mut v = Vec::new();
+    v.push(mk_atom(first_name, String::from("n"), 5, 10));
+    if list {
+        let mut inner = Vec::new();
+        inner.push(mk_atom(true, String::from("a"), 0, 1));
+        inner.push(mk_atom(false, String::from("b"), 2, 3));
+        v.push(Expr::List(inner));
+    } else {
+        v.push(mk_atom(false, String::from("m"), 1, 2));
+    }
+    if extra {
+        v.push(mk_atom(false, String::from("e"), 0, 0));
+    }
+    match pair(v) {
+        Ok((n, m)) => Ok((n, m.len())),
+        Err(e) => Err(e),
+    }
+}
+
+pub fn run_split(x: u32, y: u32, tag: u32) -> (Vec<u32>, Vec<u32>, u32) {
+    let mut v0 = Vec::new();
+    v0.push(x);
+    let mut v1 = Vec::new();
+    v1.push(y);
+    v1.push(y + 1);
+    split(Holder { arr: [v0, v1], tag })
+}
+
+/// Caller: calls `push_lens` through a reborrow, then writes through `out`
+pub fn run_push_lens(k: u32) -> (Vec<u32>, Vec<u32>) {
+    let mut out = Vec::new();
+    out.push(100);
+    let mut a = Vec::new();
+    a.push(1);
+    let mut b = Vec::new();
+    b.push(2);
+    b.push(3);
+    let mut c = Vec::new();
+    let mut i = 0;
+    while i < k {
+        c.push(i);
+        i += 1;
+    }
+    let r = {
+        let o = &mut out;
+        let r = push_lens(&mut *o, [a, b, c]);
+        o.push(200);
+        r
+    };
+    (out, r)
+}
+
+pub fn run_singles(n: u32, bad: bool) -> Result<u32, u32> {
+    let mut groups = Vec::new();
+    let mut i = 0;
+    while i < n {
+        let mut v = Vec::new();
+        let mut j = 0;
+        while j < i {
+            v.push(j);
+            j += 1;
+        }
+        let mut g = Vec::new();
+        g.push(v);
+        groups.push(g);
+        i += 1;
+    }
+    if bad {
+        groups.push(Vec::new());
+    }
+    singles(groups)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn one_name_native() {
+        assert_eq!(run_one_name(1, true, 4), Ok((String::from("x"), 4)));
+        assert_eq!(run_one_name(1, false, 4), Err(2));
+        assert_eq!(run_one_name(0, true, 4), Err(1));
+        assert_eq!(run_one_name(2, true, 4), Err(1));
+    }
+
+    #[test]
+    fn pair_native() {
+        assert_eq!(run_pair(false, true, false), Ok((15, 2)));
+        assert_eq!(run_pair(true, true, false), Ok((10, 2)));
+        assert_eq!(run_pair(false, false, false), Err(4));
+        assert_eq!(run_pair(false, true, true), Err(3));
+    }
+
+    #[test]
+    fn split_native() {
+        assert_eq!(run_split(1, 2, 9), (vec![1, 9], vec![2, 3], 10));
+        assert_eq!(run_split(0, 0, 0), (vec![0, 0], vec![0, 1], 1));
+    }
+
+    #[test]
+    fn push_lens_native() {
+        assert_eq!(run_push_lens(3), (vec![100, 1, 3, 200], vec![2, 3, 7]));
+        assert_eq!(run_push_lens(0), (vec![100, 1, 0, 200], vec![2, 3, 7]));
+    }
+
+    #[test]
+    fn singles_native() {
+        assert_eq!(run_singles(3, false), Ok(6));
+        assert_eq!(run_singles(4, false), Ok(10));
+        assert_eq!(run_singles(0, false), Ok(0));
+        assert_eq!(run_singles(2, true), Err(9));
+    }
+}
