@@ -0,0 +1,31 @@
+//@ [!lean] skip
+//@ [lean] subdir=AnyTypeId
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! `Any` evidence retains `core::any::TypeId` through the signature of
+//! `Any::type_id`, although nothing calls it: the type must have a model,
+//! not become an axiom (an unknown external).
+//! `AnyTypeId/Checks.lean` evaluates the model on the inputs of the `native`
+//! test module below and compares with the native results.
+use std::any::Any;
+
+/// A payload threaded through an `Any` bound, as raise sites do.
+pub fn pass_any<P: Any>(payload: P) -> P {
+    payload
+}
+
+pub fn tagged(code: u32, fatal: bool) -> (u32, bool) {
+    let code = pass_any(code);
+    (code.wrapping_add(1), pass_any(fatal))
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn tagged_passes_payloads() {
+        assert_eq!(tagged(4, true), (5, true));
+        assert_eq!(tagged(u32::MAX, false), (0, false));
+    }
+}
diff --git a/tests/src/captured-fn-once-mut.rs b/tests/src/captured-fn-once-mut.rs
