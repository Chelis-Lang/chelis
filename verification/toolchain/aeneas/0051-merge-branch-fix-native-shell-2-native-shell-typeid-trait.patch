+/-! Evaluate the model of `tests/src/any-type-id.rs` on the inputs of its
+    `native` test module and compare with the native results. -/
+
+namespace any_type_id.checks
+open Aeneas Aeneas.Std Result
+
+def u (n : Nat) : U32 := ⟨BitVec.ofNat _ n⟩
+
+def res (r : Result (U32 × Bool)) : Option (Nat × Bool) :=
+  match r with
+  | ok (code, fatal) => some (code.val, fatal)
+  | _ => none
+
+#guard res (tagged (u 4) true) == some (5, true)
+#guard res (tagged (u 4294967295) false) == some (0, false)
+
