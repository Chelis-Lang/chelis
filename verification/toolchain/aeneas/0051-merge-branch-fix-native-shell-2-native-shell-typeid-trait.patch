index 0000000..d3af805
--- /dev/null
+++ b/tests/src/fn-once-mut-arg-mut-arg.rs
@@ -0,0 +1,56 @@
+//@ [!lean] skip
+//@ [lean] subdir=FnOnceMutArgMutArg
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! A closure taking two mutable borrows, as the callback of
+//! `LoweringRuntime::catch_native_unwind` takes the runtime and the explicit
+//! state. Charon's `--monomorphize-mut` specializes `FnOnce<(&mut T, &mut U)>`,
+//! whose model `FnOnceMutArgMutArg` returns both borrowed arguments (and not
+//! the consumed closure).
+//! `FnOnceMutArgMutArg/Checks.lean` evaluates the model on the inputs of the
+//! `native` test module below and compares with the native results.
+
+pub fn apply_both<R>(x: &mut u32, y: &mut u64, f: impl FnOnce(&mut u32, &mut u64) -> R) -> R {
+    f(x, y)
+}
+
+/// A closure that writes both borrows, with a captured value.
+pub fn step(x: &mut u32, y: &mut u64, by: u32) -> bool {
+    apply_both(x, y, move |x, y| {
+        *x = x.wrapping_add(by);
+        *y = y.wrapping_mul(2);
+        *y > 10
+    })
+}
+
+/// The borrows passed on through a closure that takes them.
+pub fn forwarded(x: &mut u32, y: &mut u64) -> u32 {
+    apply_both(x, y, |x, y| {
+        apply_both(x, y, |x, y| {
+            *y = y.wrapping_add(1);
+            *x
+        })
+    })
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn step_writes_both() {
+        let (mut x, mut y) = (4, 3);
+        assert!(!step(&mut x, &mut y, 5));
+        assert_eq!((x, y), (9, 6));
+        let (mut x, mut y) = (u32::MAX, 6);
+        assert!(step(&mut x, &mut y, 2));
+        assert_eq!((x, y), (1, 12));
+    }
+
+    #[test]
+    fn forwarded_returns_both() {
+        let (mut x, mut y) = (7, u64::MAX);
+        assert_eq!(forwarded(&mut x, &mut y), 7);
+        assert_eq!((x, y), (7, 0));
+    }
+}
diff --git a/tests/src/modeled-instance-admitted.rs b/tests/src/modeled-instance-admitted.rs
