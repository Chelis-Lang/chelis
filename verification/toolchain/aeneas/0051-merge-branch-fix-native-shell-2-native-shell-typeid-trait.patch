--- /dev/null
+++ b/tests/src/modeled-instance-admitted.rs
@@ -0,0 +1,48 @@
+//@ [!lean] skip
+//@ [lean] subdir=ModeledInstanceAdmitted
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Partial-monomorphization instances of modeled functions which keep the ABI
+//! of their generic model are modeled by it (compare
+//! `modeled-instance-fail-closed.rs`):
+//! - `Option::is_some`/`is_none` on an `Option<&mut T>` only read the borrow
+//!   beneath `&self`: the instance adds no backward function (ABI-neutral);
+//! - `bool::then_some` on a `&mut T` has a canonical model ABI
+//!   (constructor with state) which restores the borrowed value.
+//! `ModeledInstanceAdmitted/Checks.lean` evaluates the model on the inputs of
+//! the `native` test module below and compares with the native results.
+
+pub fn has_target<T>(target: Option<&mut T>) -> bool {
+    target.is_some()
+}
+
+pub fn lacks_target<T>(target: Option<&mut T>) -> bool {
+    target.is_none()
+}
+
+/// Whether a target was selected, then increment it through the `Option`.
+pub fn select_and_bump(select: bool, value: &mut u32) -> bool {
+    let present = has_target(if select { Some(&mut *value) } else { None });
+    if let Some(target) = select.then_some(&mut *value) {
+        *target = target.wrapping_add(1);
+    }
+    present && !lacks_target(Some(value))
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn select_and_bump_updates_only_selected() {
+        let mut x = 4;
+        assert!(select_and_bump(true, &mut x));
+        assert_eq!(x, 5);
+        let mut x = 4;
+        assert!(!select_and_bump(false, &mut x));
+        assert_eq!(x, 4);
+        let mut x = u32::MAX;
+        assert!(select_and_bump(true, &mut x));
+        assert_eq!(x, 0);
+    }
+}
diff --git a/tests/src/modeled-instance-fail-closed.rs b/tests/src/modeled-instance-fail-closed.rs
new file mode 100644
index 0000000..5bcc944
--- /dev/null
+++ b/tests/src/modeled-instance-fail-closed.rs
@@ -0,0 +1,28 @@
+//@ [lean] known-failure
+//@ [lean] no-check-output
+//@ [!lean] skip
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! `core::mem::swap` has a generic model. Swapping two mutable references
+//! makes Charon's `--monomorphize-mut` translate a partial-monomorphization
+//! instance `core::mem::swap::<&mut _>`, whose borrowed arguments carry nested
+//! backward continuations that the generic model's signature lacks. The name
+//! matcher ignores the instance shape, so the generic model used to be called
+//! with the wrong arguments. `swap` has no canonical model ABI and the shape's
+//! borrow is not beneath a shared reference, so the instance is not admitted
+//! as the model (compare `modeled-instance-admitted.rs`) and remains an
+//! unknown external.
+//! (No output check: the failure is reported after generation, next to the
+//! run's timing.)
+
+pub fn swap_targets<'a>(a: &mut &'a mut u32, b: &mut &'a mut u32) {
+    std::mem::swap(a, b);
+}
+
+pub fn swapped_writes(x: &mut u32, y: &mut u32) {
+    let mut a = x;
+    let mut b = y;
+    swap_targets(&mut a, &mut b);
+    *a = 1;
+    *b = 2;
+}
