+(** The partial-monomorphization instances of modeled functions (last name
+    element [PeInstantiated]) which [PrePasses.admit_modeled_fun_instances]
+    proved ABI-compatible with their generic model. Keyed by declaration: the
+    specialization passes rewrite the binders inside instance names. *)
+let admitted_fun_instances : Types.FunDeclId.Set.t ref =
+  ref Types.FunDeclId.Set.empty
+
+(** The model of a function by its logical name, ignoring [PeInstantiated]:
+    only for deciding whether an instance of the model is admissible. *)
+let find_generic_fun_info ctx name =
+  NameMatcherMap.find_opt ctx name (builtin_funs_map ())
+
+(** A partial-monomorphization instance of a function (last name element
+    [PeInstantiated]) substitutes a mutability shape into the generic function:
+    its dictionaries are specialized records and the borrows inside its
+    arguments may add backward continuations. The logical matcher ignores
+    [PeInstantiated] and would select the generic model with the wrong
+    arguments. So an instance is modeled only if PrePasses admitted it as
+    ABI-compatible with its generic model; otherwise it stays an unknown
+    external (or keeps its Rust body). *)
+let find_fun_info ctx (id : Types.FunDeclId.id) name =
+  if
+    backend () = Lean
+    && is_trait_specialization name
+    && not (Types.FunDeclId.Set.mem id !admitted_fun_instances)
+  then None
+  else find_generic_fun_info ctx name
+
+let mem_fun ctx id name = Option.is_some (find_fun_info ctx id name)
+
