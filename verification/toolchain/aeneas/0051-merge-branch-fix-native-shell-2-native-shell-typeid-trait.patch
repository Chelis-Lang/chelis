@@ -70,6 +70,15 @@ structure core.ops.function.FnOnceMutArgPair (Self : Type u) (T : Type v) (U : T
     (Output : Type x) where
   call_once : Self → (T × U) → Result (Output × T)
 
+/-- The specialization `FnOnce<(&'a mut T, &'b mut U)>` that Charon's
+    `--monomorphize-mut` creates for a closure taking two mutable borrows (e.g.
+    the runtime and the explicit state of a catch). Both borrowed arguments are
+    returned after the call; the consumed closure state is not. -/
+@[rust_trait "core::ops::function::FnOnce<@Self, (&'a mut @T, &'b mut @U), @Output>"]
+structure core.ops.function.FnOnceMutArgMutArg (Self : Type u) (T : Type v) (U : Type w)
+    (Output : Type x) where
+  call_once : Self → (T × U) → Result (Output × T × U)
+
 @[rust_trait "core::ops::function::FnMut" (parentClauses := ["FnOnceInst"])]
 structure core.ops.function.FnMut (Self : Type u) (Args : Type v) (Output : Type w) where
   FnOnceInst : core.ops.function.FnOnce Self Args Output
