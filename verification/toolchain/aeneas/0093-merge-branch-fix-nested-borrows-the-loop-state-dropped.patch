+#guard onSomeWrite plain_write 5 10 100 == some (1, 110, 3)
+#guard onFrameWrite run_plain_write 9 1 100 == some (1, 101, 3)
+#guard onSomeWrite ctx_write 5 10 100 == some (1, 107, 5)
+#guard onFrameWrite run_ctx_write 9 1 18446744073709551615 == some (1, 6, 9)
