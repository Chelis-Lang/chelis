+/-- `run(Some(&mut frame), n)`; the caller writes `ctx + w` through the frame
+    given back, then gives it back -/
+def onSomeWrite (run : Option Frame → U32 → Result (U32 × Option Frame × (Option Frame → Option Frame)))
+    (ctx pos n w : Nat) : Option (Nat × Nat × Nat) :=
+  match run (some (frame ctx pos)) (u n) with
+  | ok (r, some f1, back) =>
+    match back (some { f1 with ctx := u (f1.ctx.val + w) }) with
+    | some f2 => some (r.val, f2.ctx.val, f1.pos.val)
+    | none => none
+  | _ => none
+
+/-- `run(&mut frame, n)`; the caller writes `ctx + w` through the frame, then
+    gives it back -/
+def onFrameWrite (run : Frame → U32 → Result (U32 × Frame × (Frame → Frame)))
+    (ctx pos n w : Nat) : Option (Nat × Nat × Nat) :=
+  match run (frame ctx pos) (u n) with
+  | ok (r, f1, back) => some (r.val, (back { f1 with ctx := u (f1.ctx.val + w) }).ctx.val, f1.pos.val)
+  | _ => none
+
