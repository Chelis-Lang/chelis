+/-- `run(Some(&mut frame), 100)`; the caller writes `ctx + w` through the
+    frame given back, then gives it back -/
+def onSomeWrite (run : Option Frame → U32 → Result (U32 × Option Frame × (Option Frame → Option Frame)))
+    (ctx pos w : Nat) : Option (Nat × Nat × Nat) :=
+  match run (some (frame ctx pos)) (u 100) with
+  | ok (r, some f1, back) =>
+    match back (some { f1 with ctx := u (f1.ctx.val + w) }) with
+    | some f2 => some (r.val, f2.ctx.val, f1.pos.val)
+    | none => none
+  | _ => none
+
+/-- `run(&mut frame, 100)`; the caller writes `ctx + w` through the frame,
+    then gives it back -/
