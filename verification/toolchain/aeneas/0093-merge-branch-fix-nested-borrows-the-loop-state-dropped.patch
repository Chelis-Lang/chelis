@@ -38,6 +38,25 @@ def onNone (run : Option Frame → Result (U64 × Option Frame × (Option Frame
   | ok (r, o, back) => some (r.val, o.isNone && (back none).isNone)
   | _ => none
 
+/-- `run(Some(&mut frame))`; the caller writes `ctx + w` through the frame
+    given back, then gives it back -/
+def onSomeWrite (run : Option Frame → Result (U64 × Option Frame × (Option Frame → Option Frame)))
+    (count ctx w : Nat) : Option (Nat × Nat × Nat) :=
+  match run (some (frame count ctx)) with
+  | ok (r, some f1, back) =>
+    match back (some { f1 with ctx := u (f1.ctx.val + w) }) with
+    | some f2 => some (r.val, f2.ctx.val, f1.count.val)
+    | none => none
+  | _ => none
+
+/-- `run(&mut frame)`; the caller writes `ctx + w` through the frame, then
+    gives it back -/
+def onFrameWrite (run : Frame → Result (U64 × Frame × (Frame → Frame)))
+    (count ctx w : Nat) : Option (Nat × Nat × Nat) :=
+  match run (frame count ctx) with
+  | ok (r, f1, back) => some (r.val, (back { f1 with ctx := u (f1.ctx.val + w) }).ctx.val, f1.count.val)
+  | _ => none
+
 -- plain_read_native
