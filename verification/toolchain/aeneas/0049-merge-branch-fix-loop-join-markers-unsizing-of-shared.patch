+def u32R (r : Result (core.result.Result U32 U32)) : Option (Sum Nat Nat) :=
+  match r with
+  | ok (.Ok n) => some (.inl n.val)
+  | ok (.Err e) => some (.inr e.val)
+  | _ => none
