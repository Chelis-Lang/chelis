diff --git a/tests/src/join-observed-local.rs b/tests/src/join-observed-local.rs
new file mode 100644
index 0000000..47b8217
--- /dev/null
+++ b/tests/src/join-observed-local.rs
@@ -0,0 +1,155 @@
+//@ [!lean] skip
+//@ [lean] subdir=JoinObservedLocal
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::cmp
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! The shape of `View::parts` (chelis-deep metadata.rs); `branch` stands for
+//! the `Try::branch` call of `?`.
+//! - `list` is built with `v.iter().map(View::Ast).collect()`: the projection
+//!   types of the iterator contain the function item `View::Ast`, which the
+//!   symbolic value invariant failed to compare (internal error in
+//!   `compare_norm_proj_tys`).
+//! - `list.first()` leaves a child abstraction observing the borrows of
+//!   `list` in one branch of `match head`. The join of the branches replaces
+//!   `list` by a fresh symbol and consumes the branch symbols; the observation
+//!   follows the replacement (as for copies). It used to be registered twice
+//!   with the consuming projection ('Key already registered').
+//! `JoinObservedLocal/Checks.lean` evaluates the model on the inputs of the
+//! `native` test module below and compares with the native results.
+#![allow(dead_code)]
+
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub enum Tag {
+    Def,
+    Module,
+    Fn,
+}
+
+impl Tag {
+    pub fn parse(s: &str) -> Option<Tag> {
+        if s.len() == 3 {
+            Some(Tag::Def)
+        } else if s.len() == 2 {
+            Some(Tag::Fn)
+        } else {
+            None
+        }
+    }
+}
+
+pub enum Expr {
+    Atom(Tag),
+    Name(String),
+    List(Vec<Expr>),
+}
+
+#[derive(Clone, Copy)]
+pub enum View<'a> {
+    Ast(&'a Expr),
+    Name(&'a str),
+}
+
+/// Stands for the `Try::branch` call of `?`, which keeps the abstractions of
+/// the calls producing its argument alive until the branches are joined.
+fn branch<T>(o: Option<T>) -> Result<T, ()> {
+    match o {
+        Some(x) => Ok(x),
+        None => Err(()),
+    }
+}
+
+pub struct Parts<'a> {
+    pub tag: Option<Tag>,
+    pub meta: Vec<(&'a str, View<'a>)>,
+    pub children: Vec<View<'a>>,
+}
+
+impl<'a> View<'a> {
+    pub fn name(self) -> Option<&'a str> {
+        match self {
+            View::Name(v) => Some(v),
+            View::Ast(Expr::Name(v)) => Some(v),
+            _ => None,
+        }
+    }
+
+    pub fn list(self) -> Option<Vec<Self>> {
+        match self {
+            View::Ast(Expr::List(v)) => Some(v.iter().map(View::Ast).collect()),
+            _ => None,
+        }
+    }
+
+    pub fn map(self) -> Option<Vec<(&'a str, View<'a>)>> {
+        match self.name() {
+            Some(v) => Some(vec![(v, self)]),
+            None => None,
+        }
+    }
+
+    pub fn parts(self) -> Option<Parts<'a>> {
+        let list = match branch(self.list()) {
+            Ok(l) => l,
+            Err(()) => return None,
+        };
+        let head = match branch(list.first()) {
+            Ok(h) => *h,
+            Err(()) => return None,
+        };
+        let tag = match head {
+            Self::Ast(Expr::Atom(tag)) => Some(*tag),
+            _ => Tag::parse(match branch(head.name()) {
+                Ok(n) => n,
+                Err(()) => return None,
+            }),
+        };
+        Some(Parts {
+            tag,
+            meta: match branch(
+                match branch(list.get(1)) {
+                    Ok(m) => m,
+                    Err(()) => return None,
+                }
+                .map(),
+            ) {
+                Ok(m) => m,
+                Err(()) => return None,
+            },
+            children: list[2..].to_vec(),
+        })
+    }
+}
+
+/// `(tag, number of metadata entries, number of children)`
+pub fn summary(e: &Expr) -> Option<(Option<Tag>, usize, usize)> {
+    match View::Ast(e).parts() {
+        Some(p) => Some((p.tag, p.meta.len(), p.children.len())),
+        None => None,
+    }
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    fn name(s: &str) -> Expr {
+        Expr::Name(s.to_string())
+    }
+
+    #[test]
+    fn parts() {
+        let e = Expr::List(vec![Expr::Atom(Tag::Fn), name("m"), name("x"), name("y")]);
+        assert_eq!(summary(&e), Some((Some(Tag::Fn), 1, 2)));
+        let e = Expr::List(vec![name("def"), name("m")]);
+        assert_eq!(summary(&e), Some((Some(Tag::Def), 1, 0)));
+        let e = Expr::List(vec![name("long"), name("m"), Expr::Atom(Tag::Def)]);
+        assert_eq!(summary(&e), Some((None, 1, 1)));
+        let e = Expr::List(vec![Expr::List(vec![]), name("m")]);
+        assert_eq!(summary(&e), None);
+        let e = Expr::List(vec![Expr::Atom(Tag::Def), Expr::Atom(Tag::Def)]);
+        assert_eq!(summary(&e), None);
+        let e = Expr::List(vec![Expr::Atom(Tag::Def)]);
+        assert_eq!(summary(&e), None);
+        assert_eq!(summary(&Expr::List(vec![])), None);
+        assert_eq!(summary(&name("x")), None);
+    }
+}
diff --git a/tests/src/loop-ended-shared-input.rs b/tests/src/loop-ended-shared-input.rs
new file mode 100644
index 0000000..42f2f01
--- /dev/null
+++ b/tests/src/loop-ended-shared-input.rs
@@ -0,0 +1,101 @@
+//@ [!lean] skip
+//@ [lean] subdir=LoopEndedSharedInput
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::cmp
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! The shape of `infer_symbolic_bindings_from_inputs` (chelis-ir eval.rs):
+//! the fields of a witness returned by `?` are borrowed separately
+//! (`let Witness { name, canonical: (label, axis), remaining } = ...?`). The
+//! borrow of the whole witness ends while the loans of its fields stay alive,
+//! so the loop abstraction holds an ended shared loan which retains live inner
+//! shared loans. Such a loan gives nothing back: the translation of the loop
+//! inputs and outputs used to reject it (internal error in
+//! `SymbolicToPureAbs.register_inputs`).
+//! `LoopEndedSharedInput/Checks.lean` evaluates the model on the inputs of the
+//! `native` test module below and compares with the native results.
+#![allow(dead_code)]
+
+pub struct Witness {
+    pub name: u32,
+    pub canonical: (u32, usize),
+    pub remaining: Vec<(u32, usize)>,
+}
+
+pub struct Input {
+    pub label: u32,
+    pub shape: Vec<usize>,
+}
+
+/// Stands for `choice.as_ref().map_err(Clone::clone)`.
+fn as_ok(choice: &Result<Witness, u32>) -> Result<&Witness, u32> {
+    match choice {
+        Ok(w) => Ok(w),
+        Err(e) => Err(*e),
+    }
+}
+
+pub fn read_axis(inputs: &Vec<Input>, label: u32, axis: usize) -> Result<usize, u32> {
+    let mut i = 0;
+    while i < inputs.len() {
+        if inputs[i].label == label {
+            if axis < inputs[i].shape.len() {
+                return Ok(inputs[i].shape[axis]);
+            }
+            return Err(label);
+        }
+        i += 1;
+    }
+    Err(label)
+}
+
+pub fn infer(
+    witnesses: &Vec<Result<Witness, u32>>,
+    inputs: &Vec<Input>,
+) -> Result<Vec<(u32, usize)>, u32> {
+    let mut per_scope: Vec<(u32, usize)> = Vec::new();
+    for choice in witnesses {
+        let Witness {
+            name,
+            canonical: (canonical_label, canonical_axis),
+            remaining,
+        } = as_ok(choice)?;
+        let value = read_axis(inputs, *canonical_label, *canonical_axis)?;
+        for (label, axis) in remaining {
+            let other = read_axis(inputs, *label, *axis)?;
+            if other != value {
+                return Err(1000 + *name);
+            }
+        }
+        per_scope.push((*name, value));
+    }
+    Ok(per_scope)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    fn w(name: u32, canonical: (u32, usize), remaining: Vec<(u32, usize)>) -> Result<Witness, u32> {
+        Ok(Witness { name, canonical, remaining })
+    }
+
+    fn inputs() -> Vec<Input> {
+        vec![
+            Input { label: 1, shape: vec![2, 3] },
+            Input { label: 2, shape: vec![3, 2, 5] },
+        ]
+    }
+
+    #[test]
+    fn infer_cases() {
+        assert_eq!(infer(&vec![], &inputs()), Ok(vec![]));
+        assert_eq!(
+            infer(&vec![w(7, (1, 1), vec![(2, 0)]), w(8, (2, 2), vec![])], &inputs()),
+            Ok(vec![(7, 3), (8, 5)])
+        );
+        assert_eq!(infer(&vec![w(7, (1, 1), vec![(2, 1)])], &inputs()), Err(1007));
+        assert_eq!(infer(&vec![w(7, (1, 1), vec![]), Err(42)], &inputs()), Err(42));
+        assert_eq!(infer(&vec![w(7, (3, 0), vec![])], &inputs()), Err(3));
+        assert_eq!(infer(&vec![w(7, (1, 5), vec![])], &inputs()), Err(1));
+        assert_eq!(infer(&vec![w(7, (1, 0), vec![(2, 1), (2, 3)])], &inputs()), Err(2));
+    }
+}
