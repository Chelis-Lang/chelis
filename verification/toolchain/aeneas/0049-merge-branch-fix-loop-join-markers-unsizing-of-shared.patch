+import JoinObservedLocal.JoinObservedLocal
+
+/-! Evaluate the model of `tests/src/join-observed-local.rs` on the inputs of
+    its `native` test module and compare with the native results. -/
+
+namespace join_observed_local.checks
+open Aeneas Aeneas.Std Result
+
+def vec {α} (xs : List α) (h : xs.length ≤ Usize.max := by scalar_tac) :
+    alloc.vec.Vec α := ⟨xs, h⟩
+
+def list (xs : List Expr) (h : xs.length ≤ Usize.max := by scalar_tac) : Expr :=
+  .List (vec xs h).toNested
+
+def tagN : Option Tag → Option Nat
+  | none => none
+  | some .Def => some 0
+  | some .Module => some 1
+  | some .Fn => some 2
+
+def summaryR (r : Result (Option (Option Tag × Usize × Usize))) :
+    Option (Option (Option Nat × Nat × Nat)) :=
+  match r with
+  | ok (some (t, m, c)) => some (some (tagN t, m.val, c.val))
+  | ok none => some none
+  | _ => none
+
+-- native::parts
+#guard summaryR (summary (list [.Atom .Fn, .Name "m", .Name "x", .Name "y"])) ==
+  some (some (tagN (some .Fn), 1, 2))
+#guard summaryR (summary (list [.Name "def", .Name "m"])) == some (some (tagN (some .Def), 1, 0))
+#guard summaryR (summary (list [.Name "long", .Name "m", .Atom .Def])) == some (some (none, 1, 1))
+#guard summaryR (summary (list [list [], .Name "m"])) == some none
+#guard summaryR (summary (list [.Atom .Def, .Atom .Def])) == some none
+#guard summaryR (summary (list [.Atom .Def])) == some none
+#guard summaryR (summary (list [])) == some none
+#guard summaryR (summary (.Name "x")) == some none
+
+end join_observed_local.checks
