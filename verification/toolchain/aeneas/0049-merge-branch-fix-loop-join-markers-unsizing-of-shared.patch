+//@ [!lean] skip
+//@ [lean] subdir=LoopReturnedVecIter
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::cmp
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Loops over `vs.iter()`, where `vs: Vec<View<'a>>` is returned by a call.
+//! `vs.iter()` derefs the vector to a slice and creates the iterator: the
+//! child abstractions of both calls observe the borrows of the elements. The
+//! loop fixed point joins the shared payload of the slice, which is kept by
+//! the deref abstraction, into a fresh symbol, and consumes the branch
+//! symbols. The observations of the branch symbols follow the replacement
+//! (as for copies): they used to lose their lender when the branch
+//! abstractions were collapsed ('Markers remain after ownership reduction').
+//! `LoopReturnedVecIter/Checks.lean` evaluates the model on the inputs of the
+//! `native` test module below and compares with the native results.
+#![allow(dead_code)]
+
+#[derive(Clone, Copy)]
+pub enum View<'a> {
+    Name(&'a str),
+    Int(u32),
+}
+
+pub fn names<'a>(a: &'a str, b: &'a str) -> Vec<View<'a>> {
+    let mut v = Vec::new();
+    v.push(View::Name(a));
+    v.push(View::Int(7));
+    v.push(View::Name(b));
+    v
+}
+
+pub fn names_macro<'a>(a: &'a str, b: &'a str) -> Vec<View<'a>> {
+    vec![View::Int(2), View::Name(a), View::Name(b)]
+}
+
+pub fn count_names(a: &str, b: &str) -> usize {
+    let vs = names(a, b);
+    let mut n = 0;
+    for v in vs.iter() {
+        if let View::Name(s) = v {
+            n += s.len();
+        }
+    }
+    n
+}
+
+pub fn count_names_macro(a: &str, b: &str) -> usize {
+    let vs = names_macro(a, b);
+    let mut n = 0;
+    for v in vs.iter() {
+        if let View::Name(s) = v {
+            n += s.len();
+        }
+    }
+    n
+}
+
+pub fn weight(a: &str, b: &str) -> u32 {
+    let vs = names_macro(a, b);
+    let mut t = 0;
+    for v in vs.iter() {
+        match v {
+            View::Int(i) => t += *i,
+            View::Name(s) => t += s.len() as u32 * 10,
+        }
+    }
+    t
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn loops() {
+        assert_eq!(count_names("ab", "c"), 3);
+        assert_eq!(count_names("", ""), 0);
+        assert_eq!(count_names_macro("abcd", "ef"), 6);
+        assert_eq!(count_names_macro("", "x"), 1);
+        assert_eq!(weight("a", "bcd"), 2 + 10 + 30);
+        assert_eq!(weight("", ""), 2);
+    }
+}
diff --git a/tests/src/loop-shared-components.rs b/tests/src/loop-shared-components.rs
new file mode 100644
index 0000000..6144746
--- /dev/null
+++ b/tests/src/loop-shared-components.rs
@@ -0,0 +1,89 @@
+//@ [!lean] skip
+//@ [lean] subdir=LoopSharedComponents
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::cmp
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! An inner loop which reborrows the components of the shared element it
+//! iterates over (`for (x, y) in &w.1`) and leaves the outer loop by two
+//! early returns. The break fixed point joins two breaks of the same
+//! iteration and keeps the loans of `x` and `y` nested in the loan of the
+//! element; matching a break with it joins distinct loans, which puts the
+//! joined loans of `x` and `y` next to the joined element loan. Both forms
+//! denote the same shared ownership: the match compares them modulo this
+//! nesting (it used to fail: 'Could not match the contexts', the shape of
+//! `infer_symbolic_bindings_from_inputs` in chelis-ir eval.rs).
+//! `LoopSharedComponents/Checks.lean` evaluates the model on the inputs of the
+//! `native` test module below and compares with the native results.
+#![allow(dead_code)]
+
+pub fn check(x: &u32) -> Result<u32, u32> {
+    if *x < 10 { Ok(*x) } else { Err(*x) }
+}
+
+/// Two early returns from the inner loop, both with the components borrowed.
+pub fn first_mismatch(ws: &Vec<(u32, Vec<(u32, u32)>)>) -> Result<u32, u32> {
+    let mut total = 0;
+    for w in ws {
+        for (x, y) in &w.1 {
+            let other = check(x)? + *y;
+            if other == 0 {
+                return Err(100 + w.0);
+            }
+        }
+        total += w.0;
+    }
+    Ok(total)
+}
+
+/// The same with a named struct and the components compared with a value read
+/// before the inner loop.
+pub struct Witness {
+    pub name: u32,
+    pub canonical: (u32, u32),
+    pub remaining: Vec<(u32, u32)>,
+}
+
+pub fn agree(ws: &Vec<Witness>) -> Result<Vec<(u32, u32)>, u32> {
+    let mut out: Vec<(u32, u32)> = Vec::new();
+    for w in ws {
+        let (label, axis) = &w.canonical;
+        let value = check(label)? + *axis;
+        for (label, axis) in &w.remaining {
+            let other = check(label)? + *axis;
+            if other != value {
+                return Err(1000 + w.name);
+            }
+        }
+        out.push((w.name, value));
+    }
+    Ok(out)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    fn w(name: u32, canonical: (u32, u32), remaining: Vec<(u32, u32)>) -> Witness {
+        Witness { name, canonical, remaining }
+    }
+
+    #[test]
+    fn first_mismatch_cases() {
+        assert_eq!(first_mismatch(&vec![]), Ok(0));
+        assert_eq!(first_mismatch(&vec![(1, vec![(1, 2), (3, 4)]), (2, vec![])]), Ok(3));
+        assert_eq!(first_mismatch(&vec![(1, vec![(1, 2)]), (2, vec![(0, 0)])]), Err(102));
+        assert_eq!(first_mismatch(&vec![(1, vec![(12, 2)]), (2, vec![(0, 0)])]), Err(12));
+        assert_eq!(first_mismatch(&vec![(5, vec![(2, 0), (0, 0), (11, 0)])]), Err(105));
+    }
+
+    #[test]
+    fn agree_cases() {
+        assert_eq!(agree(&vec![]), Ok(vec![]));
+        assert_eq!(
+            agree(&vec![w(1, (2, 3), vec![(4, 1), (1, 4)]), w(2, (0, 7), vec![])]),
+            Ok(vec![(1, 5), (2, 7)])
+        );
+        assert_eq!(agree(&vec![w(1, (2, 3), vec![(4, 1)]), w(2, (1, 1), vec![(2, 1)])]), Err(1002));
+        assert_eq!(agree(&vec![w(1, (2, 3), vec![(40, 1)])]), Err(40));
+        assert_eq!(agree(&vec![w(1, (20, 3), vec![])]), Err(20));
+    }
+}
diff --git a/tests/src/shared-observation-consumed.rs b/tests/src/shared-observation-consumed.rs
new file mode 100644
index 0000000..750b5a4
--- /dev/null
+++ b/tests/src/shared-observation-consumed.rs
@@ -0,0 +1,108 @@
+//@ [!lean] skip
+//@ [lean] subdir=SharedObservationConsumed
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::cmp
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! A vector of values which hold shared borrows is observed through a shared
+//! borrow (`children.len()`, `children[0]`), then consumed (`into_iter`).
+//! The call which took the shared borrow leaves a child abstraction for the
+//! regions of the elements, which observes the borrows of the vector: it
+//! outlives the end of the outer borrow, because values copied out of the
+//! vector may still use them. The consuming projection of the vector then
+//! overlaps this observation. This is sound because the projected regions
+//! only hold shared borrows, which are copyable; overlaps with a consuming
+//! projection which moves mutable borrows are still rejected.
+//! `SharedObservationConsumed/Checks.lean` evaluates the model on the inputs
+//! of the `native` test module below and compares with the native results.
+#![allow(dead_code)]
+
+#[derive(Clone, Copy)]
+pub enum View<'a> {
+    Name(&'a str),
+    Int(u32),
+}
+
+impl<'a> View<'a> {
+    pub fn name(self) -> Option<&'a str> {
+        match self {
+            View::Name(v) => Some(v),
+            View::Int(_) => None,
+        }
+    }
+}
+
+pub struct Parts<'a> {
+    pub tag: u32,
+    pub children: Vec<View<'a>>,
+}
+
+pub fn is_var(v: View<'_>) -> bool {
+    v.name().is_some()
+}
+
+pub fn node<'a>(v: View<'a>, w: View<'a>, tag: u32) -> Option<Parts<'a>> {
+    match v {
+        View::Name(_) => Some(Parts { tag, children: vec![v, w] }),
+        View::Int(0) => Some(Parts { tag, children: Vec::new() }),
+        View::Int(_) => None,
+    }
+}
+
+/// The `S::Wrt` arm of `shape_valid` (chelis-deep metadata.rs), with the
+/// `is_some_and` closure inlined.
+pub fn wrt(v: View<'_>, w: View<'_>) -> bool {
+    is_var(v)
+        || match node(w, v, 3) {
+            Some(n) => !n.children.is_empty() && n.children.into_iter().all(is_var),
+            None => false,
+        }
+}
+
+fn same(a: View<'_>, b: View<'_>) -> bool {
+    match (a, b) {
+        (View::Name(a), View::Name(b)) => a == b,
+        (View::Int(a), View::Int(b)) => a == b,
+        _ => false,
+    }
+}
+
+/// The shape of `same_params` (chelis-deep metadata.rs).
+pub fn same_children(a: View<'_>, a1: View<'_>, b: View<'_>, b1: View<'_>) -> bool {
+    let (Some(a), Some(b)) = (node(a, a1, 1), node(b, b1, 1)) else {
+        return false;
+    };
+    a.children.len() == b.children.len()
+        && a.children.into_iter().zip(b.children).all(|(a, b)| same(a, b))
+}
+
+/// The copied element outlives the consumption of the vector.
+pub fn first_after_consume<'a>(p: Parts<'a>) -> (Option<&'a str>, bool) {
+    let first = p.children[0];
+    let all = p.children.into_iter().all(is_var);
+    (first.name(), all)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn observed_then_consumed() {
+        assert!(wrt(View::Name("x"), View::Int(1)));
+        assert!(wrt(View::Int(1), View::Name("y")) == false);
+        assert!(wrt(View::Name("z"), View::Name("y")));
+        assert!(!wrt(View::Int(0), View::Int(0)));
+        assert!(!wrt(View::Int(2), View::Int(3)));
+        assert!(same_children(View::Name("a"), View::Int(1), View::Name("a"), View::Int(1)));
+        assert!(!same_children(View::Name("a"), View::Int(1), View::Name("a"), View::Int(2)));
+        assert!(!same_children(View::Name("a"), View::Int(1), View::Name("b"), View::Int(1)));
+        assert!(same_children(View::Int(0), View::Int(1), View::Int(0), View::Name("q")));
+        assert!(!same_children(View::Int(0), View::Int(1), View::Name("a"), View::Int(1)));
+        assert!(!same_children(View::Int(5), View::Int(1), View::Name("a"), View::Int(1)));
+        let p = Parts { tag: 0, children: vec![View::Name("ab"), View::Name("c")] };
+        assert_eq!(first_after_consume(p), (Some("ab"), true));
+        let p = Parts { tag: 0, children: vec![View::Name("ab"), View::Int(4)] };
+        assert_eq!(first_after_consume(p), (Some("ab"), false));
+        let p = Parts { tag: 0, children: vec![View::Int(4), View::Name("c")] };
+        assert_eq!(first_after_consume(p), (None, false));
+    }
+}
diff --git a/tests/src/unsize-shared-borrows.rs b/tests/src/unsize-shared-borrows.rs
new file mode 100644
index 0000000..a7ccead
--- /dev/null
+++ b/tests/src/unsize-shared-borrows.rs
@@ -0,0 +1,92 @@
+//@ [!lean] skip
+//@ [lean] subdir=UnsizeSharedBorrows
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::cmp
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! `vec![...]` of values which hold shared borrows. The macro unsizes a
+//! `Box<[View<'a>; N]>` to a `Box<[View<'a>]>`: the cast result is a fresh
+//! symbolic value, whose borrows are linked to those of the unsized value
+//! by a region abstraction which projects the borrows of the input and the
+//! loans of the output (like a call to `fn unsize<'r>(x: T0<'r>) -> T1<'r>`).
+//! Values which hold mutable borrows are still rejected.
+//! `UnsizeSharedBorrows/Checks.lean` evaluates the model on the inputs of the
+//! `native` test module below and compares with the native results.
+#![allow(dead_code)]
+
+#[derive(Clone, Copy)]
+pub enum View<'a> {
+    Name(&'a str),
+    Int(u32),
+}
+
+pub struct Parts<'a> {
+    pub tag: u32,
+    pub children: Vec<View<'a>>,
+}
+
+pub fn singleton<'a>(v: View<'a>) -> Vec<View<'a>> {
+    vec![v]
+}
+
+pub fn names<'a>(a: &'a str, b: &'a str) -> Vec<View<'a>> {
+    vec![View::Name(a), View::Int(7), View::Name(b)]
+}
+
+pub fn pairs<'a>(k: &'a str, v: View<'a>) -> Vec<(&'a str, View<'a>)> {
+    vec![(k, v), ("x", View::Int(1))]
+}
+
+pub fn strs<'a>(a: &'a str, b: &'a str) -> Vec<&'a str> {
+    vec![b, a, b]
+}
+
+pub fn node<'a>(v: View<'a>, tag: u32) -> Option<Parts<'a>> {
+    match v {
+        View::Name(_) => Some(Parts { tag, children: vec![v, View::Int(tag)] }),
+        View::Int(_) => None,
+    }
+}
+
+fn weight(v: View<'_>) -> usize {
+    match v {
+        View::Name(s) => s.len(),
+        View::Int(i) => i as usize,
+    }
+}
+
+/// Reads the elements of the unsized vector after the cast.
+pub fn third_weight(a: &str, b: &str) -> usize {
+    let vs = names(a, b);
+    weight(vs[2]) + vs.len()
+}
+
+pub fn node_weight(v: View<'_>) -> usize {
+    match node(v, 5) {
+        Some(p) => weight(p.children[0]) + weight(p.children[1]) + p.children.len(),
+        None => 0,
+    }
+}
+
+pub fn pair_key_len(k: &str, s: &str) -> usize {
+    let ps = pairs(k, View::Name(s));
+    ps[0].0.len() + weight(ps[0].1) + ps[1].0.len() + weight(ps[1].1)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn unsize() {
+        assert_eq!(singleton(View::Name("ab")).len(), 1);
+        assert_eq!(names("x", "yz").len(), 3);
+        assert_eq!(strs("a", "bc"), vec!["bc", "a", "bc"]);
+        assert_eq!(third_weight("abc", "de"), 5);
+        assert_eq!(third_weight("", ""), 3);
+        assert_eq!(node_weight(View::Name("four")), 11);
+        assert_eq!(node_weight(View::Int(3)), 0);
+        assert_eq!(pair_key_len("key", "val"), 3 + 3 + 1 + 1);
+        assert_eq!(pair_key_len("", "q"), 0 + 1 + 1 + 1);
+        assert_eq!(pairs("k", View::Int(4)).len(), 2);
+        assert_eq!(node(View::Name("n"), 9).map(|p| p.tag), Some(9));
+    }
+}
