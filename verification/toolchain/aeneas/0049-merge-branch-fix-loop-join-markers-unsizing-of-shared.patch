+def inputs : alloc.vec.Vec Input :=
+  vec [{ label := 1#u32, shape := vec [2#usize, 3#usize] },
+       { label := 2#u32, shape := vec [3#usize, 2#usize, 5#usize] }]
+
+def inferR (r : Result (core.result.Result (alloc.vec.Vec (U32 × Usize)) U32)) :
+    Option (Sum (List (Nat × Nat)) Nat) :=
+  match r with
+  | ok (.Ok v) => some (.inl (v.val.map fun (a, b) => (a.val, b.val)))
+  | ok (.Err e) => some (.inr e.val)
+  | _ => none
