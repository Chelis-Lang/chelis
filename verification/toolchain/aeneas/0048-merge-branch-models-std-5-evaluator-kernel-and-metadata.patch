+/-- `alloc::borrow::ToOwned` (alloc/src/borrow.rs). The associated type
+    `Owned: Borrow<Self>` is lifted to the parameter `Owned`. -/
+@[rust_trait "alloc::borrow::ToOwned"
+  (parentClauses := ["coreborrowBorrowInst"]) (defaultMethods := ["clone_into"])]
+structure alloc.borrow.ToOwned (Self Owned : Type) where
+  coreborrowBorrowInst : core.borrow.Borrow Owned Self
+  to_owned : Self → Result Owned
+  /-- `fn clone_into(&self, target: &mut Owned) { *target = self.to_owned(); }` -/
+  clone_into : Self → Owned → Result Owned := fun self _ => to_owned self
+
+/-- The blanket `impl<T: Clone> ToOwned for T { type Owned = T; }`:
+    `to_owned` is `self.clone()`. -/
+@[rust_fun "alloc::borrow::{alloc::borrow::ToOwned<@T, @T>}::to_owned"]
+def alloc.borrow.ToOwnedClone.to_owned {T : Type} (cloneInst : core.clone.Clone T) (self : T) :
+  Result T :=
+  cloneInst.clone self
+
+/-- Blanket `clone_into`: `target.clone_from(self)`. -/
+@[rust_fun "alloc::borrow::{alloc::borrow::ToOwned<@T, @T>}::clone_into"]
+def alloc.borrow.ToOwnedClone.clone_into {T : Type} (cloneInst : core.clone.Clone T)
+  (self target : T) : Result T :=
+  cloneInst.clone_from target self
+
+@[reducible, rust_trait_impl "alloc::borrow::ToOwned<@T, @T>"]
+def alloc.borrow.ToOwnedClone {T : Type} (cloneInst : core.clone.Clone T) :
+  alloc.borrow.ToOwned T T := {
+  coreborrowBorrowInst := core.borrow.BorrowSelf T
+  to_owned := alloc.borrow.ToOwnedClone.to_owned cloneInst
+  clone_into := alloc.borrow.ToOwnedClone.clone_into cloneInst
+}
+
+/-- `impl ToOwned for str { type Owned = String; }` (alloc/src/str.rs): its
+    `clone_into` replaces the target with `self.to_owned()`, the default. -/
+@[reducible, rust_trait_impl "alloc::borrow::ToOwned<str, alloc::string::String>"]
+def alloc.borrow.ToOwnedStr : alloc.borrow.ToOwned Str String := {
+  coreborrowBorrowInst := core.borrow.BorrowString
+  to_owned := alloc.str.ToOwnedStr.to_owned
+}
+
+/-- `enum Cow<'a, B: ?Sized + ToOwned> { Borrowed(&'a B), Owned(<B as ToOwned>::Owned) }`
+    (alloc/src/borrow.rs); the lifted associated type is the parameter `O`. -/
+@[rust_type "alloc::borrow::Cow"]
+inductive alloc.borrow.Cow (B : Type) (O : Type) where
+| Borrowed : B → alloc.borrow.Cow B O
+| Owned : O → alloc.borrow.Cow B O
+
+/-- `impl Deref for Cow<'_, B>`:
+    `match *self { Borrowed(borrowed) => borrowed, Owned(ref owned) => owned.borrow() }`. -/
+@[rust_fun "alloc::borrow::{core::ops::deref::Deref<alloc::borrow::Cow<'0, @B, @O>, @B>}::deref"]
+def alloc.borrow.DerefCow.deref {B O : Type} (toOwnedInst : alloc.borrow.ToOwned B O) :
+  alloc.borrow.Cow B O → Result B
+  | .Borrowed borrowed => .ok borrowed
+  | .Owned owned => toOwnedInst.coreborrowBorrowInst.borrow owned
+
+@[reducible, rust_trait_impl "core::ops::deref::Deref<alloc::borrow::Cow<'0, @B, @O>, @B>"]
+def alloc.borrow.DerefCow {B O : Type} (toOwnedInst : alloc.borrow.ToOwned B O) :
+  core.ops.deref.Deref (alloc.borrow.Cow B O) B := {
