+          method! visit_region env r =
+            match r with
+            | RVar (Free id) -> RVar (Free (RegionId.Map.find id renaming))
+            | _ -> super#visit_region env r
+        end
+      in
+      let f = rename#visit_fun_decl () f in
+      let regions =
+        List.mapi
+          (fun i (r : region_param) -> { r with index = RegionId.of_int i })
+          params
+      in
+      { f with generics = { f.generics with regions } }
+    in
+    let fun_decls =
