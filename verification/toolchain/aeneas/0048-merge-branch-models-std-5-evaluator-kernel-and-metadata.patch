+    region groups, and thus of the values its backward functions give back: the
+    method field of the trait and the implementations of the method must agree
+    on it. *)
+let order_method_region_params (crate : crate) : crate =
+  (* The instantiation of a method by its trait or implementation, whose
+     binder binds the method's own parameters *)
+  let owner_ref (f : fun_decl) : fun_decl_ref option =
+    match f.src with
+    | TraitDeclItem (trait_ref, name, _) ->
+        Option.bind (TraitDeclId.Map.find_opt trait_ref.id crate.trait_decls)
