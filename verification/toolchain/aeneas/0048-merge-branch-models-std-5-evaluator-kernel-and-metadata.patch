+              | RVar (Bound (0, _)) -> true
+              | _ -> false
+            in
+            let order = List.map fst (owner @ own) in
+            if
+              List.for_all is_own own
+              && List.length regions = List.length f.generics.regions
+              && order <> List.map fst regions
+            then Some order
+            else None)
+      crate.fun_decls
+  in
+  if FunDeclId.Map.is_empty orders then crate
+  else
+    let reorder (order : int list) l = List.map (List.nth l) order in
+    let reorder_args (fid : FunDeclId.id) (generics : generic_args) =
+      match FunDeclId.Map.find_opt fid orders with
+      | None -> generics
+      | Some order -> { generics with regions = reorder order generics.regions }
+    in
+    (* Reorder the region parameters of a method, and rename accordingly its
+       free region variables, which are those parameters. Its name keeps its own
+       specialization binder. *)
+    let reorder_params (f : fun_decl) (order : int list) : fun_decl =
+      let params = reorder order f.generics.regions in
+      let renaming =
+        RegionId.Map.of_list
+          (List.mapi
+             (fun i (r : region_param) -> (r.index, RegionId.of_int i))
+             params)
+      in
+      let rename =
+        object
+          inherit [_] map_crate as super
