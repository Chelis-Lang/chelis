+  match r with | ok v => some v.val | _ => none
+def totals (r : Result (U32 × U32 × Bool)) : Option (Nat × Nat × Bool) :=
+  match r with | ok (count, total, empty) => some (count.val, total.val, empty) | _ => none
+#guard nat (owned_sum (vec [1, 2, 3])) == some 6
+#guard nat (owned_sum (vec [])) == some 0
+#guard nat (shared_sum (sl [4, 5])) == some 9
+#guard nat (shared_sum (sl [])) == some 0
+#guard totals (built_map_totals (sl [3, 1, 2, 3])) == some (3, 20, false)
+#guard totals (built_map_totals (sl [])) == some (0, 0, true)
+end generic_into_iterator_loop.checks
