+        method! visit_fn_ptr env ptr =
+          let ptr = super#visit_fn_ptr env ptr in
+          match ptr.kind with
+          | FunId (FRegular fid) ->
+              { ptr with generics = reorder_args fid ptr.generics }
+          | FunId (FBuiltin _) | TraitMethod _ -> ptr
