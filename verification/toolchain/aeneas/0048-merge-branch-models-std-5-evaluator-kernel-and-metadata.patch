+def core.option.IteratorIter.next {A : Type} (self : core.option.Iter A) :
+  Result (Option A × core.option.Iter A) :=
+  ok (self.opt, ⟨none⟩)
+
+@[rust_fun
+  "core::option::{core::iter::traits::iterator::Iterator<core::option::Iter<'a, @A>, &'a @A>}::size_hint"]
+def core.option.IteratorIter.size_hint {A : Type} (self : core.option.Iter A) :
+  Result (Usize × Option Usize) :=
+  let len := if self.opt.isSome then 1#usize else 0#usize
+  ok (len, some len)
+
+@[reducible, rust_trait_impl
+  "core::iter::traits::iterator::Iterator<core::option::Iter<'a, @A>, &'a @A>"]
+def core.iter.traits.iterator.IteratorOptionIter (A : Type) :
+  core.iter.traits.iterator.Iterator (core.option.Iter A) A := {
+  next := core.option.IteratorIter.next
+  size_hint := core.option.IteratorIter.size_hint
+  trusted_len := true
+  one_shot := true
+  fused := true
+}
