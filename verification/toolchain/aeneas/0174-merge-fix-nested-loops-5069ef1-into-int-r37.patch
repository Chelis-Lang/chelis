+  (c : _root_.Aeneas.Std.U32) (limit : _root_.Aeneas.Std.U32)
+  (stop : _root_.Aeneas.Std.U32) :
+  _root_.Aeneas.Std.Result (_root_.Bool × _root_.Aeneas.Std.U32)
+  := do
+  let xs ←
+    _root_.Aeneas.Std.alloc.vec.Vec.push (_root_.Aeneas.Std.alloc.vec.Vec.new
+      _root_.Aeneas.Std.U32) a
+  let xs1 ← _root_.Aeneas.Std.alloc.vec.Vec.push xs b
+  let xs2 ← _root_.Aeneas.Std.alloc.vec.Vec.push xs1 c
+  let (found, sink) ←
+    _root_.loop_visitor_captured_shared_ref.count_until xs2 limit stop
+      {
+        errors := (_root_.Aeneas.Std.alloc.vec.Vec.new _root_.Aeneas.Std.U32),
+        seen := 0#u32
+      }
+  _root_.Aeneas.Std.Result.ok (found, sink.seen)
+
+end loop_visitor_captured_shared_ref
