diff --git a/tests/src/loop-after-map-closure-budget.rs b/tests/src/loop-after-map-closure-budget.rs
new file mode 100644
index 0000000..fe31809
--- /dev/null
+++ b/tests/src/loop-after-map-closure-budget.rs
@@ -0,0 +1,139 @@
+//@ [!lean] skip
+//@ [lean] subdir=LoopAfterMapClosureBudget
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::iter::adapters::map::Map --include core::iter::adapters::skip::Skip
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! A loop after collecting `kids.iter().skip(1).map(|a| analyze(a, stack))`
+//! where `stack: &mut Budget<'_>` holds mutable borrows (the shape of
+//! `chelis_types::infer::vmap_extent::analyze_app`). At the loop entry, the
+//! abstractions of the calls of `map` and `collect` lend each other the inner
+//! borrows of the budget: the budget given back by `collect` to the closure of
+//! the `Map` is an output of level 1 of the call of `map`, nested in the `Map`.
+
+pub struct Native {
+    pub depth: u32,
+}
+
+pub struct Record {
+    pub first: Option<u32>,
+}
+
+pub struct Budget<'a> {
+    native: &'a mut Native,
+    record: &'a mut Record,
+}
+
+fn analyze(e: &u32, stack: &mut Budget<'_>) -> u32 {
+    stack.native.depth += 1;
+    if *e == 0 {
+        stack.record.first = Some(stack.native.depth);
+    }
+    *e
+}
+
+/// Push the analyses of the kids after the first one.
+pub fn app(kids: &[u32], deps: &mut Vec<u32>, stack: &mut Budget<'_>) -> u32 {
+    let arg_deps = kids.iter().skip(1).map(|a| analyze(a, stack)).collect::<Vec<_>>();
+    for d in arg_deps.iter() {
+        deps.push(*d);
+    }
+    0
+}
+
+fn analyze_logged(e: &u32, log: &mut Vec<u32>, stack: &mut Budget<'_>) -> u32 {
+    log.push(*e + stack.native.depth);
+    analyze(e, stack) + 1
+}
+
+/// The same with a closure which also captures a log, and a loop which stops
+/// at the first analysis equal to `stop`.
+pub fn app_logged(kids: &[u32], stop: u32, log: &mut Vec<u32>, stack: &mut Budget<'_>) -> u32 {
+    let arg_deps = kids
+        .iter()
+        .skip(1)
+        .map(|a| analyze_logged(a, log, stack))
+        .collect::<Vec<_>>();
+    let mut sum = 0;
+    for d in arg_deps.iter() {
+        if *d == stop {
+            return sum + 100;
+        }
+        sum += *d;
+    }
+    sum
+}
+
+/// `app` on `[a, b, c]`, then a write of `bump` through the budget: the depth
+/// and the first zero recorded, the result, the number of dependencies and
+/// the last one.
+pub fn drive_app(a: u32, b: u32, c: u32, bump: u32) -> (u32, u32, u32, usize, u32) {
+    let mut native = Native { depth: 5 };
+    let mut record = Record { first: None };
+    let mut deps = Vec::new();
+    deps.push(9);
+    let mut kids = Vec::new();
+    kids.push(a);
+    kids.push(b);
+    kids.push(c);
+    let r;
+    {
+        let mut budget = Budget { native: &mut native, record: &mut record };
+        r = app(&kids, &mut deps, &mut budget);
+        budget.native.depth += bump;
+    }
+    let first = match record.first {
+        Some(x) => x,
+        None => 99,
+    };
+    let n = deps.len();
+    (native.depth, first, r, n, deps[n - 1])
+}
+
+/// `app_logged` on `[a, b, c, d]`, then a write of `bump` through the budget:
+/// the depth, the first zero recorded, the result, the length of the log and
+/// its last entry.
+pub fn drive_app_logged(a: u32, b: u32, c: u32, d: u32, stop: u32, bump: u32) -> (u32, u32, u32, usize, u32) {
+    let mut native = Native { depth: 0 };
+    let mut record = Record { first: None };
+    let mut log = Vec::new();
+    let mut kids = Vec::new();
+    kids.push(a);
+    kids.push(b);
+    kids.push(c);
+    kids.push(d);
+    let r;
+    {
+        let mut budget = Budget { native: &mut native, record: &mut record };
+        r = app_logged(&kids, stop, &mut log, &mut budget);
+        budget.native.depth += bump;
+    }
+    let first = match record.first {
+        Some(x) => x,
+        None => 99,
+    };
+    let n = log.len();
+    let last = if n > 0 { log[n - 1] } else { 77 };
+    (native.depth, first, r, n, last)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn drives() {
+        for (a, b, c) in [(1u32, 2u32, 3u32), (0, 0, 4), (8, 5, 0), (3, 0, 0)] {
+            for bump in [0u32, 10] {
+                println!("app {} {} {} {} {:?}", a, b, c, bump, drive_app(a, b, c, bump));
+            }
+        }
+        for (a, b, c, d) in [(1u32, 2u32, 3u32, 4u32), (0, 0, 7, 0), (9, 4, 0, 6)] {
+            for (stop, bump) in [(4u32, 0u32), (8, 3), (1, 1)] {
+                println!(
+                    "app_logged {} {} {} {} {} {} {:?}",
+                    a, b, c, d, stop, bump,
+                    drive_app_logged(a, b, c, d, stop, bump)
+                );
+            }
+        }
+    }
+}
diff --git a/tests/src/loop-join-renamed-owned-region.rs b/tests/src/loop-join-renamed-owned-region.rs
new file mode 100644
index 0000000..c1211b0
--- /dev/null
+++ b/tests/src/loop-join-renamed-owned-region.rs
@@ -0,0 +1,121 @@
+//@ [!lean] skip
+//@ [lean] subdir=LoopJoinRenamedOwnedRegion
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::iter::adapters::map::Map
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! A loop over the pairs collected from `items.iter().map(|(_, e)| *e)`
+//! which indexes `items` again in a short-circuit condition guarding a
+//! `continue` (the shape of
+//! `chelis_types::infer::program::prebind_defsig_less_function_body_types`).
+//! At the loop entry, the reborrow of `items` has a nested abstraction for the
+//! region of the elements, and the abstraction of the `map` call still owns
+//! its own region. The join after the short-circuit condition merges the
+//! abstraction of the `map` call into the nested abstraction of the reborrow,
+//! which keeps the region of the `map` call. Joining the loop entry with that
+//! continue context then had two distinct abstractions owning that region: the
+//! collapse ended one of them, and the loan of `items` read as bottom in the
+//! next iteration ("There should be no bottoms in the value at *(items)", or,
+//! in the production body, "Could not match the contexts").
+
+pub struct Expr {
+    pub v: u32,
+}
+
+pub struct Collected<'a> {
+    pub env: Vec<(u32, &'a Expr)>,
+    pub origin: Vec<usize>,
+}
+
+fn collect<'a, I: Iterator<Item = &'a Expr>>(it: I) -> Collected<'a> {
+    let mut env = Vec::new();
+    let mut origin = Vec::new();
+    let mut i = 0;
+    for e in it {
+        env.push((e.v, e));
+        origin.push(i);
+        i += 1;
+    }
+    Collected { env, origin }
+}
+
+fn owns(e: &Expr) -> bool {
+    e.v % 2 == 0
+}
+
+fn resolve(e: &Expr, errors: &mut Vec<u32>) -> Result<u32, u32> {
+    if e.v > 10 {
+        errors.push(e.v);
+        Err(e.v)
+    } else {
+        Ok(e.v)
+    }
+}
+
+/// The sum of the resolved entries which are not declared and own their
+/// expression, and the indices of the entries which failed to resolve (their
+/// values are pushed to `errors`).
+pub fn prebind(
+    items: &[(Option<u32>, &Expr)],
+    declared: &Vec<u32>,
+    errors: &mut Vec<u32>,
+) -> (u32, Vec<usize>) {
+    let Collected { env, origin } = collect(items.iter().map(|(_, expr)| *expr));
+    let mut total = 0;
+    let mut failures = Vec::new();
+    let mut k = 0;
+    for (name, ty_expr) in env {
+        let idx = origin[k];
+        k += 1;
+        if declared.contains(&name) || !owns(items[idx].1) {
+            continue;
+        }
+        match resolve(ty_expr, errors) {
+            Ok(t) => total += t,
+            Err(_) => failures.push(idx),
+        }
+    }
+    (total, failures)
+}
+
+/// `prebind` on four entries with the values `a`, `b`, `c`, `d`, the
+/// declared value `declared0`, and an error log already holding one entry:
+/// the total, the number of failures, the first and the last failed index (9
+/// if none), the length of the error log given back and its last entry.
+pub fn drive_prebind(a: u32, b: u32, c: u32, d: u32, declared0: u32) -> (u32, usize, usize, usize, usize, u32) {
+    let ea = Expr { v: a };
+    let eb = Expr { v: b };
+    let ec = Expr { v: c };
+    let ed = Expr { v: d };
+    let mut items = Vec::new();
+    items.push((None, &ea));
+    items.push((Some(1), &eb));
+    items.push((None, &ec));
+    items.push((Some(3), &ed));
+    let mut declared = Vec::new();
+    declared.push(declared0);
+    let mut errors = Vec::new();
+    errors.push(1000);
+    let (total, failures) = prebind(&items, &declared, &mut errors);
+    let n = failures.len();
+    let first = if n > 0 { failures[0] } else { 9 };
+    let last = if n > 0 { failures[n - 1] } else { 9 };
+    let m = errors.len();
+    (total, n, first, last, m, errors[m - 1])
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn drives() {
+        for (a, b, c, d) in [(2u32, 4u32, 12u32, 14u32), (1, 6, 3, 8), (20, 3, 22, 24), (10, 10, 11, 7)] {
+            for declared0 in [4u32, 12, 99] {
+                println!(
+                    "prebind {} {} {} {} {} {:?}",
+                    a, b, c, d, declared0,
+                    drive_prebind(a, b, c, d, declared0)
+                );
+            }
+        }
+    }
+}
diff --git a/tests/src/loop-visitor-captured-shared-ref.rs b/tests/src/loop-visitor-captured-shared-ref.rs
new file mode 100644
index 0000000..c225bfc
--- /dev/null
+++ b/tests/src/loop-visitor-captured-shared-ref.rs
@@ -0,0 +1,138 @@
+//@ [!lean] skip
+//@ [lean] subdir=LoopVisitorCapturedSharedRef
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Loops calling a `&mut` visitor closure which captures a shared reference to
+//! a local shared reference (`&'a &'b u32`) next to a mutable borrow of a sink
+//! (the shape of `chelis_deep::literal_source::visit_binder_literal_uses`
+//! called by
+//! `chelis_types::infer::binder_literal::validate_binder_literal_adoption_in_program`).
+//! In the loop fixed point, the collapse merges the borrow of region `'b` held
+//! by the abstraction of the loop entry with the shared projection of the
+//! captured value held by the abstraction of the call: a plain shared borrow.
+//! The context matched with the fixed point at the end of the loop body is
+//! projected on the target before the collapse, and keeps the projection: both
+//! are the same ownership.
+
+pub struct Sink {
+    pub errors: Vec<u32>,
+    pub seen: u32,
+}
+
+fn below(limit: &&u32, x: u32) -> bool {
+    x < **limit
+}
+
+fn bonus(hint: &Option<&u32>) -> u32 {
+    match hint {
+        Some(h) => **h,
+        None => 0,
+    }
+}
+
+/// Visit the entries of `xs` from index 0 with an explicit stack, calling the
+/// visitor on the even entries and on the odd multiples of 3 (plus one).
+pub fn visit_uses<'a>(xs: &'a Vec<u32>, visitor: &mut impl FnMut(u32)) {
+    let mut stack: Vec<u32> = Vec::new();
+    stack.push(0);
+    while let Some(i) = stack.pop() {
+        if (i as usize) < xs.len() {
+            let x = xs[i as usize];
+            if x % 2 == 0 {
+                visitor(x);
+            } else if x % 3 == 0 {
+                visitor(x + 1);
+            }
+            stack.push(i + 1);
+        }
+    }
+}
+
+/// Record in the sink the visited entries below the limit (plus the hint).
+pub fn validate(xs: &Vec<u32>, limit: &u32, hint: Option<&u32>, sink: &mut Sink) {
+    visit_uses(xs, &mut |x| {
+        sink.seen += 1;
+        if below(&limit, x) {
+            sink.errors.push(x + bonus(&hint));
+        }
+    });
+}
+
+/// Visit the entries of `xs` from the last one, stopping at the first entry
+/// equal to `stop`; the visitor sees the others.
+pub fn visit_until<'a>(xs: &'a Vec<u32>, stop: u32, visitor: &mut impl FnMut(u32)) -> bool {
+    let mut stack: Vec<u32> = Vec::new();
+    let mut i = 0;
+    while i < xs.len() {
+        stack.push(xs[i]);
+        i += 1;
+    }
+    while let Some(x) = stack.pop() {
+        if x == stop {
+            return true;
+        }
+        visitor(x);
+    }
+    false
+}
+
+/// Count the entries below the limit seen before `stop`.
+pub fn count_until(xs: &Vec<u32>, limit: &u32, stop: u32, sink: &mut Sink) -> bool {
+    visit_until(xs, stop, &mut |x| {
+        if below(&limit, x) {
+            sink.seen += 1;
+        }
+    })
+}
+
+/// The number of visits, the number of recorded entries, the first and the
+/// last recorded entries (0 if none) of `validate` on `[a, b, c]`.
+pub fn drive_validate(a: u32, b: u32, c: u32, limit: u32, h: u32, with_hint: bool) -> (u32, usize, u32, u32) {
+    let mut xs = Vec::new();
+    xs.push(a);
+    xs.push(b);
+    xs.push(c);
+    let mut sink = Sink { errors: Vec::new(), seen: 0 };
+    let hint = if with_hint { Some(&h) } else { None };
+    validate(&xs, &limit, hint, &mut sink);
+    let n = sink.errors.len();
+    let first = if n > 0 { sink.errors[0] } else { 0 };
+    let last = if n > 0 { sink.errors[n - 1] } else { 0 };
+    (sink.seen, n, first, last)
+}
+
+/// Whether `stop` was found, and the count of `count_until` on `[a, b, c]`.
+pub fn drive_count_until(a: u32, b: u32, c: u32, limit: u32, stop: u32) -> (bool, u32) {
+    let mut xs = Vec::new();
+    xs.push(a);
+    xs.push(b);
+    xs.push(c);
+    let mut sink = Sink { errors: Vec::new(), seen: 0 };
+    let found = count_until(&xs, &limit, stop, &mut sink);
+    (found, sink.seen)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn drives() {
+        for (a, b, c) in [(2u32, 3u32, 4u32), (1, 9, 6), (5, 7, 11), (8, 0, 12)] {
+            for (limit, h, with_hint) in [(5u32, 10u32, true), (100, 1, false), (0, 3, true)] {
+                println!(
+                    "validate {} {} {} {} {} {} {:?}",
+                    a, b, c, limit, h, with_hint,
+                    drive_validate(a, b, c, limit, h, with_hint)
+                );
+            }
+            for (limit, stop) in [(5u32, 3u32), (100, 99), (7, 2)] {
+                println!(
+                    "count_until {} {} {} {} {} {:?}",
+                    a, b, c, limit, stop,
+                    drive_count_until(a, b, c, limit, stop)
+                );
+            }
+        }
+    }
+}
