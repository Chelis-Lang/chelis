+import NestedCollectionsAliasBranches.NestedCollectionsAliasBranches
+
+/-! Evaluate the model of `tests/src/nested-collections-alias-branches.rs` on the
+    inputs of its `native` test module and compare with the native results
+    (including the values given back through `&mut`: the number of remembered
+    bindings and the checksums of the substitution; the number and a checksum
+    of the validation errors). -/
+
+namespace nested_collections_alias_branches.checks
+open Aeneas Aeneas.Std Result
+
+def ok4 : Result (U32 × Usize × U64 × U64) → Option (Nat × Nat × Nat × Nat)
+  | ok (a, b, c, d) => some (a.val, b.val, c.val, d.val)
+  | _ => none
+
+-- refined: the then branch (the closure state is updated as a `Subst`)
+#guard ok4 (scenario 0#u32) == some (0, 1, 55793284, 37203)
+#guard ok4 (scenario 3#u32) == some (0, 1, 592489846, 37203)
+#guard ok4 (scenario 7#u32) == some (0, 2, 129308593, 39539648)
+
+-- unchanged: the else branch (the closure state is given back as is)
+#guard ok4 (scenario 1#u32) == some (0, 0, 129186401, 0)
+#guard ok4 (scenario 2#u32) == some (0, 0, 474254184, 0)
+#guard ok4 (scenario 5#u32) == some (0, 0, 129186401, 0)
+
+-- failures
+#guard ok4 (scenario 4#u32) == some (4, 0, 129186401, 0)
+#guard ok4 (scenario 6#u32) == some (2, 0, 129186401, 0)
+
+def ok2 : Result (Usize × U64) → Option (Nat × Nat)
+  | ok (a, b) => some (a.val, b.val)
+  | _ => none
+
+-- the validator: the errors given back as the closure state
+#guard ok2 (validate_scenario 0#u32) == some (1, 505)
+#guard ok2 (validate_scenario 1#u32) == some (3, 254461265)
+#guard ok2 (validate_scenario 2#u32) == some (4, 3530934)
+#guard ok2 (validate_scenario 3#u32) == some (2, 611858)
+#guard ok2 (validate_scenario 4#u32) == some (2, 9172618)
+#guard ok2 (validate_scenario 5#u32) == some (2, 1121105)
+#guard ok2 (validate_scenario 6#u32) == some (4, 11989388)
+#guard ok2 (validate_scenario 7#u32) == some (2, 430951)
+
+/-! The carriers and the aliases add no axioms. -/
+
