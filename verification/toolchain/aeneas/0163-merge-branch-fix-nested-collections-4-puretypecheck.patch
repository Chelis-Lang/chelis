+//@ [!lean] skip
+//@ [lean] subdir=NestedCollectionsAliasBranches
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::iter::adapters::map::Map --include core::option::{core::option::Option} --include core::result::{core::result::Result}
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Bodies which use a type recursive through a collection (the Lean backend
+//! stores the collection in a nested carrier and type-checks the bodies it
+//! updates) and closures whose only capture is a mutable borrow: the backends
+//! extract the closure state as an alias of the borrowed type, and the
+//! micro-passes substitute the one for the other, so the closure state meets
+//! positions of the borrowed type:
+//! - the branches of an `if` give back the substitution either as the closure
+//!   state (the branch which does not touch it) or as an update of `Subst`
+//!   whose base is the closure state (the shape of
+//!   chelis_types::unify::unify_preserving_owners, unify.rs:2669-2722);
+//! - a recursive validator passes `&mut |value, _| validate(value, errors)` to
+//!   a visitor of the expressions of a metadata map, then continues with the
+//!   errors given back as the closure state (let-bindings, loop arguments and
+//!   conditional visits; the shape of chelis_effects::validate_handler_expr,
+//!   chelis-effects lib.rs:947-989).
+//! `NestedCollectionsAliasBranches/Checks.lean` evaluates the model on the
+//! inputs of the `native` test module below and compares with the native
+//! results, including the values given back through `&mut`.
+use std::collections::BTreeMap;
+
+#[derive(Clone, PartialEq)]
+pub enum Dim {
+    Name(u32),
+    Var(u32),
+    Lit(u64),
+}
+
+#[derive(Clone, PartialEq)]
+pub enum Type {
+    Prim(u8),
+    Fn(Vec<Type>, Box<Type>),
+    Tensor(Vec<Dim>, u8),
+    Var(u32),
+    Tuple(Vec<Type>),
+}
+
+pub struct Subst {
+    types: BTreeMap<u32, Type>,
+    labels: BTreeMap<u32, u32>,
+    refined: Vec<(u32, Type)>,
+}
+
+impl Subst {
+    fn owner(&self, mut v: u32) -> u32 {
+        while let Some(Type::Var(next)) = self.types.get(&v) {
+            if *next == v {
+                break;
+            }
+            v = *next;
+        }
+        v
+    }
+
+    fn apply(&mut self, t: &Type) -> Type {
+        match t {
+            Type::Var(v) => {
+                let owner = self.owner(*v);
+                match self.types.get(&owner) {
+                    Some(t) => t.clone(),
+                    None => Type::Var(owner),
+                }
+            }
+            _ => t.clone(),
+        }
+    }
+
+    fn label(&mut self, v: u32) -> Option<u32> {
+        self.labels.get(&v).copied()
+    }
+
+    fn apply_dim(&mut self, d: &Dim) -> Dim {
+        match d {
+            Dim::Var(v) => match self.labels.get(v) {
+                Some(n) => Dim::Name(*n),
+                None => Dim::Var(*v),
+            },
+            _ => d.clone(),
+        }
+    }
+}
+
+fn unify_resolved(t1: &Type, t2: &Type, subst: &mut Subst) -> Result<(), u32> {
+    match (t1, t2) {
+        (Type::Var(v), _) => {
+            subst.types.insert(*v, t2.clone());
+            Ok(())
+        }
+        (_, Type::Var(v)) => {
+            subst.types.insert(*v, t1.clone());
+            Ok(())
+        }
+        (Type::Prim(a), Type::Prim(b)) => {
+            if a == b {
+                Ok(())
+            } else {
+                Err(1)
+            }
+        }
+        (Type::Tensor(d1, p1), Type::Tensor(d2, p2)) => {
+            if d1.len() == d2.len() && p1 == p2 {
+                Ok(())
+            } else {
+                Err(2)
+            }
+        }
+        (Type::Tuple(a), Type::Tuple(b)) => {
+            if a.len() == b.len() {
+                Ok(())
+            } else {
+                Err(3)
+            }
+        }
+        _ => Err(4),
+    }
+}
+
+/// Unify, then refine the named dimensions of the tensors bound to the
+/// variables of the operands with the labels of the other operand's
+/// dimension variables (and remember the previous bindings).
+pub fn unify_preserving_owners(t1: &Type, t2: &Type, subst: &mut Subst) -> Result<(), u32> {
+    let owner1 = if let Type::Var(v) = t1 {
+        Some(subst.owner(*v))
+    } else {
+        None
+    };
+    let owner2 = if let Type::Var(v) = t2 {
+        Some(subst.owner(*v))
+    } else {
+        None
+    };
+    let t1 = if matches!(t1, Type::Var(_)) {
+        subst.apply(t1)
+    } else {
+        t1.clone()
+    };
+    let t2 = if matches!(t2, Type::Var(_)) {
+        subst.apply(t2)
+    } else {
+        t2.clone()
+    };
+    let result = unify_resolved(&t1, &t2, subst);
+    if result.is_ok() {
+        for (owner, old, other) in [(owner1, &t1, &t2), (owner2, &t2, &t1)] {
+            if let (Some(owner), Type::Tensor(dims, prec), Type::Tensor(other_dims, _)) =
+                (owner, old, other)
+            {
+                if dims.len() == other_dims.len() {
+                    let refined: Vec<_> = dims
+                        .iter()
+                        .zip(other_dims)
+                        .map(|(d, other)| {
+                            if matches!(d, Dim::Name(_))
+                                && matches!(other, Dim::Var(v) if subst.label(*v).is_some())
+                            {
+                                subst.apply_dim(other)
+                            } else {
+                                d.clone()
+                            }
+                        })
+                        .collect();
+                    if &refined != dims {
+                        subst.refined.push((owner, old.clone()));
+                        subst.types.insert(owner, Type::Tensor(refined, *prec));
+                    }
+                }
+            }
+        }
+    }
+    result
+}
+
+fn dim_code(d: &Dim) -> u64 {
+    match d {
+        Dim::Name(n) => 1 + 4 * (*n as u64),
+        Dim::Var(v) => 2 + 4 * (*v as u64),
+        Dim::Lit(n) => 3 + 4 * (*n % 1_000_000),
+    }
+}
+
+/// A checksum of a type (order-sensitive).
+fn type_code(t: &Type) -> u64 {
+    match t {
+        Type::Prim(p) => 11 + *p as u64,
+        Type::Fn(args, ret) => {
+            let mut acc = 13u64;
+            for a in args.iter() {
+                acc = (acc * 31 + type_code(a)) % 1_000_000_007;
+            }
+            (acc * 37 + type_code(ret)) % 1_000_000_007
+        }
+        Type::Tensor(dims, p) => {
+            let mut acc = 17u64 + *p as u64;
+            for d in dims.iter() {
+                acc = (acc * 41 + dim_code(d)) % 1_000_000_007;
+            }
+            acc
+        }
+        Type::Var(v) => 19 + 7 * (*v as u64),
+        Type::Tuple(items) => {
+            let mut acc = 23u64;
+            for t in items.iter() {
+                acc = (acc * 43 + type_code(t)) % 1_000_000_007;
+            }
+            acc
+        }
+    }
+}
+
+/// A checksum of the bindings and of the remembered bindings.
+fn subst_code(subst: &Subst) -> (u64, u64) {
+    let mut types = 0u64;
+    for (v, t) in subst.types.iter() {
+        types = (types * 1009 + *v as u64 * 101 + type_code(t)) % 1_000_000_007;
+    }
+    let mut refined = 0u64;
+    for (v, t) in subst.refined.iter() {
+        refined = (refined * 1013 + *v as u64 * 103 + type_code(t)) % 1_000_000_007;
+    }
+    (types, refined)
+}
+
+fn tensor(dims: Vec<Dim>) -> Type {
+    Type::Tensor(dims, 4)
+}
+
+fn subst() -> Subst {
+    let mut types = BTreeMap::new();
+    // 1 -> 2 -> tensor[a, 3]: the owner of 1 is 2
+    types.insert(1, Type::Var(2));
+    types.insert(2, tensor(vec![Dim::Name(10), Dim::Lit(3)]));
+    types.insert(5, Type::Tuple(vec![Type::Prim(1), Type::Var(6)]));
+    types.insert(8, Type::Fn(vec![Type::Prim(2)], Box::new(Type::Var(9))));
+    types.insert(11, tensor(vec![Dim::Var(7), Dim::Name(12)]));
+    types.insert(13, tensor(vec![Dim::Name(14), Dim::Var(4)]));
+    let mut labels = BTreeMap::new();
+    labels.insert(7, 70);
+    labels.insert(4, 40);
+    Subst { types, labels, refined: Vec::new() }
+}
+
+/// Unify two operands of a scenario, then report the result (0 = ok), the
+/// number of remembered bindings and the checksums of the substitution given
+/// back through `&mut`.
+fn run(t1: Type, t2: Type) -> (u32, usize, u64, u64) {
+    let mut s = subst();
+    let result = match unify_preserving_owners(&t1, &t2, &mut s) {
+        Ok(()) => 0,
+        Err(e) => e,
+    };
+    let (types, refined) = subst_code(&s);
+    (result, s.refined.len(), types, refined)
+}
+
+/// Scenarios: 0 = the owner's tensor is refined by a labelled variable (then
+/// branch); 1 = the other variable has no label (else branch); 2 = both
+/// operands are variables; 3 = a tensor on the left, refined through the
+/// second operand's owner; 4 = the unification fails; 5 = tuples (no tensor);
+/// 6 = the dimension counts differ; 7 = both operands are variables bound to
+/// tensors, and both are refined.
+pub fn scenario(case: u32) -> (u32, usize, u64, u64) {
+    match case {
+        0 => run(Type::Var(1), tensor(vec![Dim::Var(7), Dim::Lit(3)])),
+        1 => run(Type::Var(1), tensor(vec![Dim::Var(6), Dim::Lit(3)])),
+        2 => run(Type::Var(1), Type::Var(3)),
+        3 => run(tensor(vec![Dim::Var(4), Dim::Var(7)]), Type::Var(1)),
+        4 => run(Type::Var(1), Type::Prim(2)),
+        5 => run(Type::Var(5), Type::Tuple(vec![Type::Prim(1), Type::Prim(3)])),
+        6 => run(Type::Var(1), tensor(vec![Dim::Var(7)])),
+        _ => run(Type::Var(13), Type::Var(11)),
+    }
+}
+
+/// The expressions of the validator: `Metadata` holds expressions, and the
+/// group is recursive through `Vec<Expr>`.
+pub struct Metadata {
+    values: Vec<Expr>,
+    roles: Vec<u8>,
+}
+
+pub struct List {
+    elements: Vec<Expr>,
+    info: Metadata,
+}
+
+pub struct MetaExpr {
+    expr: Expr,
+    metadata: Metadata,
+}
+
+pub enum Expr {
+    Atom(u32),
+    Node(u32, Box<Metadata>, Vec<Expr>),
+    List(List),
+    Map(Metadata),
+    Meta(Box<MetaExpr>),
+    Unknown(u32, Metadata, Vec<Expr>),
+}
+
+pub enum Carrier<'a> {
+    Decoded(u32, &'a Metadata, &'a [Expr]),
+    Structural(&'a [Expr]),
+    Map(&'a Metadata),
+    Atom(&'a u32),
+    MetaExpression(&'a MetaExpr),
+    Undecodable(u32, &'a Metadata, &'a [Expr]),
+    Malformed(&'a List),
+}
+
+impl Expr {
+    pub fn carrier(&self) -> Carrier<'_> {
+        match self {
+            Expr::Node(tag, meta, children) => Carrier::Decoded(*tag, meta, children),
+            Expr::List(list) => match list.elements.len() % 3 {
+                0 => Carrier::Structural(&list.elements),
+                1 => Carrier::Malformed(list),
+                _ => Carrier::Undecodable(0, &list.info, &list.elements),
+            },
+            Expr::Map(meta) => Carrier::Map(meta),
+            Expr::Atom(a) => Carrier::Atom(a),
+            Expr::Meta(m) => Carrier::MetaExpression(m),
+            Expr::Unknown(head, meta, children) => Carrier::Undecodable(*head, meta, children),
+        }
+    }
+}
+
+impl Metadata {
+    pub fn visit_expressions<'a>(&'a self, visit: &mut impl FnMut(&'a Expr, u8)) {
+        let mut i = 0;
+        while i < self.values.len() {
+            let role = if i < self.roles.len() { self.roles[i] } else { 0 };
+            visit(&self.values[i], role);
+            i += 1;
+        }
+    }
+}
+
+pub struct EffectError {
+    kind: u32,
+    suggestions: Vec<u32>,
+}
+
+fn kind_of(meta: &Metadata) -> Result<u32, &Expr> {
+    match meta.values.first() {
+        Some(Expr::Atom(a)) => Ok(*a),
+        Some(e) => Err(e),
+        None => Ok(0),
+    }
+}
+
+fn validate_kind(kind: Result<u32, &Expr>, kids: &[Expr], errors: &mut Vec<EffectError>) {
+    if kids.len() != 2 {
+        errors.push(EffectError { kind: 1, suggestions: vec![kids.len() as u32] });
+        return;
+    }
+    match kind {
+        Ok(k) => {
+            if k > 3 {
+                errors.push(EffectError { kind: k, suggestions: Vec::new() });
+            }
+        }
+        Err(_) => errors.push(EffectError { kind: 2, suggestions: vec![7, 8] }),
+    }
+}
+
+/// Validate the handlers of an expression and of the expressions of its
+/// metadata.
+pub fn validate_expr(expr: &Expr, errors: &mut Vec<EffectError>) {
+    match expr.carrier() {
+        Carrier::Decoded(tag, metadata, children) => {
+            if tag == 7 {
+                validate_kind(kind_of(metadata), children, errors);
+            }
+            metadata.visit_expressions(&mut |value, _| validate_expr(value, errors));
+            for kid in children {
+                validate_expr(kid, errors);
+            }
+        }
+        Carrier::Map(map) => {
+            map.visit_expressions(&mut |value, _| validate_expr(value, errors));
+        }
+        Carrier::Atom(_) => {}
+        Carrier::Structural(children) => {
+            for child in children {
+                validate_expr(child, errors);
+            }
+        }
+        Carrier::MetaExpression(meta) => {
+            validate_expr(&meta.expr, errors);
+            meta.metadata
+                .visit_expressions(&mut |value, _| validate_expr(value, errors));
+        }
+        Carrier::Undecodable(_, metadata, children) => {
+            if matches!(expr, Expr::List(_)) {
+                metadata.visit_expressions(&mut |value, _| validate_expr(value, errors));
+            }
+            for child in children {
+                validate_expr(child, errors);
+            }
+        }
+        Carrier::Malformed(list) => {
+            if list.elements.len() == 7 {
+                validate_kind(Ok(1), &list.elements, errors);
+            }
+            for child in &list.elements {
+                validate_expr(child, errors);
+            }
+        }
+    }
+}
+
+fn meta(values: Vec<Expr>) -> Metadata {
+    Metadata { values, roles: vec![1] }
+}
+
+fn node(tag: u32, values: Vec<Expr>, children: Vec<Expr>) -> Expr {
+    Expr::Node(tag, Box::new(meta(values)), children)
+}
+
+fn list(elements: Vec<Expr>, values: Vec<Expr>) -> Expr {
+    Expr::List(List { elements, info: meta(values) })
+}
+
+fn atoms(n: u32) -> Vec<Expr> {
+    let mut v = Vec::new();
+    let mut i = 0;
+    while i < n {
+        v.push(Expr::Atom(i));
+        i += 1;
+    }
+    v
+}
+
+/// The number of errors and a checksum of the errors (order-sensitive),
+/// given back through `&mut`, after validating `expr` from `n` errors.
+fn validate_run(expr: Expr, n: u32) -> (usize, u64) {
+    let mut errors = Vec::new();
+    let mut i = 0;
+    while i < n {
+        errors.push(EffectError { kind: 90 + i, suggestions: Vec::new() });
+        i += 1;
+    }
+    validate_expr(&expr, &mut errors);
+    let mut acc = 0u64;
+    for e in errors.iter() {
+        let mut s = 0u64;
+        for x in e.suggestions.iter() {
+            s = s * 31 + *x as u64;
+        }
+        acc = (acc * 1009 + e.kind as u64 * 101 + s) % 1_000_000_007;
+    }
+    (errors.len(), acc)
+}
+
+/// Validation scenarios: 0 = a handler node with a valid kind > 3; 1 = a
+/// handler with the wrong arity, nested in the metadata of another; 2 = a map
+/// whose expressions hold handlers (the closure is the only continuation);
+/// 3 = a metadata wrapper (a recursive call, then the visit); 4 = an unknown
+/// form (its metadata is not visited); 5 = a list with an undecodable head
+/// (its metadata is visited); 6 = malformed lists (7 elements); 7 = a kind
+/// which is not an atom.
+pub fn validate_scenario(case: u32) -> (usize, u64) {
+    match case {
+        0 => validate_run(node(7, vec![Expr::Atom(5)], atoms(2)), 0),
+        1 => validate_run(node(7, vec![node(7, Vec::new(), atoms(1))], atoms(3)), 1),
+        2 => validate_run(
+            Expr::Map(meta(vec![node(7, vec![Expr::Atom(9)], atoms(2)), node(7, Vec::new(), Vec::new())])),
+            2,
+        ),
+        3 => validate_run(
+            Expr::Meta(Box::new(MetaExpr {
+                expr: node(7, vec![Expr::Atom(6)], atoms(2)),
+                metadata: meta(vec![node(7, vec![Expr::Atom(4)], atoms(2)), Expr::Atom(3)]),
+            })),
+            0,
+        ),
+        4 => validate_run(
+            Expr::Unknown(3, meta(vec![node(7, Vec::new(), Vec::new())]), vec![node(7, vec![Expr::Atom(8)], atoms(2))]),
+            1,
+        ),
+        5 => validate_run(list(atoms(2), vec![node(7, vec![Expr::Atom(11)], atoms(2)), node(7, Vec::new(), atoms(5))]), 0),
+        6 => validate_run(list(atoms(7), Vec::new()), 3),
+        _ => validate_run(node(7, vec![node(1, Vec::new(), Vec::new())], vec![list(atoms(7), Vec::new()), Expr::Atom(1)]), 0),
+    }
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn refined() {
+        assert_eq!(scenario(0), (0, 1, 55793284, 37203));
+        assert_eq!(scenario(3), (0, 1, 592489846, 37203));
+        assert_eq!(scenario(7), (0, 2, 129308593, 39539648));
+    }
+
+    #[test]
+    fn unchanged() {
+        assert_eq!(scenario(1), (0, 0, 129186401, 0));
+        assert_eq!(scenario(2), (0, 0, 474254184, 0));
+        assert_eq!(scenario(5), (0, 0, 129186401, 0));
+    }
+
+    #[test]
+    fn validate() {
+        assert_eq!(validate_scenario(0), (1, 505));
+        assert_eq!(validate_scenario(1), (3, 254461265));
+        assert_eq!(validate_scenario(2), (4, 3530934));
+        assert_eq!(validate_scenario(3), (2, 611858));
+        assert_eq!(validate_scenario(4), (2, 9172618));
+        assert_eq!(validate_scenario(5), (2, 1121105));
+        assert_eq!(validate_scenario(6), (4, 11989388));
+        assert_eq!(validate_scenario(7), (2, 430951));
+    }
+
+    #[test]
+    fn failures() {
+        assert_eq!(scenario(4), (4, 0, 129186401, 0));
+        assert_eq!(scenario(6), (2, 0, 129186401, 0));
+    }
+}
