+import LoopExitSharedChildren.LoopExitSharedChildren
+
+/-! Evaluate the model of `tests/src/loop-exit-shared-children.rs` on the
+    inputs of its `native` test module and compare with the native results. -/
+
+namespace loop_exit_shared_children.checks
+open Aeneas Aeneas.Std Result
+
+def vec {α} (xs : List α) (h : xs.length ≤ Usize.max := by scalar_tac) :
+    alloc.vec.Vec α := ⟨xs, h⟩
+def sl {α} (xs : List α) (h : xs.length ≤ Usize.max := by scalar_tac) :
+    Slice α := ⟨xs, h⟩
+
+/-- `Ok n` is `inl n`, `Err i` is `inr i` -/
+def resD (r : Result (core.result.Result U32 U32)) : Option (Nat ⊕ Nat) :=
+  match r with
+  | ok (.Ok n) => some (.inl n.val)
+  | ok (.Err i) => some (.inr i.val)
+  | _ => none
+
+/-- `Ok ()` is `none`, `Err e` is `some (key_len, expected, shape)` -/
+def resE (r : Result (core.result.Result Unit MetadataError)) :
+    Option (Option (Nat × Nat × Nat)) :=
+  match r with
+  | ok (.Ok ()) => some none
+  | ok (.Err e) => some (some (e.key_len.val, e.expected.val, e.shape.val))
+  | _ => none
+
+def err (key_len expected shape : Nat) : Option (Option (Nat × Nat × Nat)) :=
+  some (some (key_len, expected, shape))
+
+-- native::duplicates
+#guard resD (first_duplicate (vec [])) == some (.inl 0)
+#guard resD (first_duplicate (vec [(toStr "a", View.Str (toStr "xy")), (toStr "b", View.True)])) == some (.inl 2)
+#guard resD (first_duplicate (vec [(toStr "a", View.Str (toStr "xy")), (toStr "b", View.Str (toStr "z")), (toStr "a", View.True)])) ==
+  some (.inr 2)
+#guard resD (first_duplicate (vec [(toStr "k", View.Name (toStr "n")), (toStr "k", View.Str (toStr "abc"))])) == some (.inr 1)
+
+-- native::entries
+#guard resE (check_entries (vec []) none (sl [])) == some none
+#guard resE (check_entries (vec [(toStr "doc", View.Str (toStr "d")), (toStr "ext", View.True)]) none (sl [])) == some none
+#guard resE (check_entries (vec [(toStr "doc", View.Str (toStr "d")), (toStr "doc", View.Str (toStr "e"))]) none (sl [])) == err 3 0 1
+#guard resE (check_entries (vec [(toStr "unknown", View.True)]) none (sl [])) == err 7 9 0
+#guard resE (check_entries (vec [(toStr "doc", View.True)]) none (sl [])) == err 3 1 0
+#guard resE (check_entries (vec [(toStr "opaque", View.True)]) (some .Def) (sl [])) == some none
+#guard resE (check_entries (vec [(toStr "opaque", View.Str (toStr "s"))]) (some .Def) (sl [])) == err 6 3 7
+#guard resE (check_entries (vec [(toStr "opaque", View.True)]) (some .Fn) (sl [])) == err 6 3 0
+#guard resE (check_entries (vec [(toStr "path", View.Str (toStr "m"))]) (some .Module) (sl [View.Name (toStr "m")])) == some none
+#guard resE (check_entries (vec [(toStr "path", View.Str (toStr "q"))]) (some .Module) (sl [View.Name (toStr "m")])) == err 4 2 1
+#guard resE (check_entries (vec [(toStr "path", View.Str (toStr "m"))]) (some .Module) (sl [])) == err 4 2 1
+
+end loop_exit_shared_children.checks
