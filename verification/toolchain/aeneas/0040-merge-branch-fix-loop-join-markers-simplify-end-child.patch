+//@ [!lean] skip
+//@ [lean] subdir=LoopExitSharedChildren
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::cmp
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Loops over the entries of a shared `Vec<(&str, View<'_>)>` which leave the
+//! loop from inside its body (`return`, several exits). Calling `next` on the
+//! slice iterator introduces child abstractions for the nested regions of the
+//! elements, which only hold shared borrows. At a loop exit their parent still
+//! holds loans, so they used to survive (in the joined break context, or in
+//! the context at a later exit only), and matching the contexts at the loop
+//! exits failed. An abstraction which only holds shared borrows gives nothing
+//! back: it ends independently of its parents.
+//! `LoopExitSharedChildren/Checks.lean` evaluates the model on the inputs of
+//! the `native` test module below and compares with the native results.
+#![allow(dead_code)]
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+pub enum Tag {
+    Def,
+    Module,
+    Fn,
+}
+
+#[derive(Clone, Copy)]
+pub enum View<'a> {
+    Name(&'a str),
+    Str(&'a str),
+    True,
+}
+
+impl<'a> View<'a> {
+    pub fn name(self) -> Option<&'a str> {
+        match self {
+            View::Name(v) => Some(v),
+            _ => None,
+        }
+    }
+    pub fn string(self) -> Option<&'a str> {
+        match self {
+            View::Str(v) => Some(v),
+            _ => None,
+        }
+    }
+}
+
+pub type Entries<'a> = Vec<(&'a str, View<'a>)>;
+
+/// The first repeated key (its index), or the total length of the values.
+pub fn first_duplicate(meta: &Entries<'_>) -> Result<u32, u32> {
+    let mut n = 0u32;
+    for (index, (key, v)) in meta.iter().enumerate() {
+        if meta[..index].iter().any(|(prior, _)| prior == key) {
+            return Err(index as u32);
+        }
+        let len = match v.string() {
+            Some(s) => s.len(),
+            None => 0,
+        };
+        n = n.wrapping_add(len as u32);
+    }
+    Ok(n)
+}
+
+#[derive(Clone, Copy)]
+pub enum Shape {
+    Str,
+    Name,
+    True,
+}
+
+#[derive(Clone, Copy)]
+pub enum Placement {
+    Any,
+    Tag(Tag),
+    Path,
+}
+
+pub struct Rule {
+    pub key: &'static str,
+    pub shape: Shape,
+    pub placement: Placement,
+    pub expected: u32,
+}
+
+pub static RULES: [Rule; 3] = [
+    Rule { key: "doc", shape: Shape::Str, placement: Placement::Any, expected: 1 },
+    Rule { key: "path", shape: Shape::Str, placement: Placement::Path, expected: 2 },
+    Rule { key: "opaque", shape: Shape::True, placement: Placement::Tag(Tag::Def), expected: 3 },
+];
+
+pub enum KeyClass {
+    Registered(&'static Rule),
+    Extension,
+    Forbidden,
+}
+
+pub fn classify(key: &str) -> KeyClass {
+    let mut i = 0;
+    while i < RULES.len() {
+        if RULES[i].key == key {
+            return KeyClass::Registered(&RULES[i]);
+        }
+        i += 1;
+    }
+    if key.len() > 5 { KeyClass::Forbidden } else { KeyClass::Extension }
+}
+
+pub fn shape_valid(shape: Shape, v: View<'_>) -> bool {
+    match shape {
+        Shape::Str => v.string().is_some(),
+        Shape::Name => v.name().is_some(),
+        Shape::True => matches!(v, View::True),
+    }
+}
+
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub struct MetadataError {
+    pub key_len: usize,
+    pub expected: u32,
+    pub shape: u32,
+}
+
+pub fn error(key: &str, v: View<'_>, expected: u32) -> MetadataError {
+    MetadataError { key_len: key.len(), expected, shape: if v.string().is_some() { 1 } else { 0 } }
+}
+
+/// The shape of `chelis_deep::metadata::check_entries`.
+pub fn check_entries(
+    meta: &Entries<'_>,
+    tag: Option<Tag>,
+    children: &[View<'_>],
+) -> Result<(), MetadataError> {
+    for (index, (key, v)) in meta.iter().enumerate() {
+        if meta[..index].iter().any(|(prior, _)| prior == key) {
+            return Err(error(key, *v, 0));
+        }
+        let rule = match classify(key) {
+            KeyClass::Extension => continue,
+            KeyClass::Forbidden => return Err(error(key, *v, 9)),
+            KeyClass::Registered(rule) => rule,
+        };
+        let placement = match rule.placement {
+            Placement::Any => true,
+            Placement::Tag(owner) => tag == Some(owner),
+            Placement::Path => {
+                matches!(tag, Some(Tag::Module))
+                    && match v.string() {
+                        Some(path) => match children.first() {
+                            Some(c) => match c.name() {
+                                Some(name) => path == name,
+                                None => false,
+                            },
+                            None => false,
+                        },
+                        None => false,
+                    }
+            }
+        };
+        if !placement || !shape_valid(rule.shape, *v) {
+            let mut e = error(key, *v, rule.expected);
+            if *key == "opaque" && tag == Some(Tag::Def) {
+                e.shape = 7;
+            }
+            return Err(e);
+        }
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    fn err(key_len: usize, expected: u32, shape: u32) -> Result<(), MetadataError> {
+        Err(MetadataError { key_len, expected, shape })
+    }
+
+    #[test]
+    fn duplicates() {
+        assert_eq!(first_duplicate(&vec![]), Ok(0));
+        assert_eq!(first_duplicate(&vec![("a", View::Str("xy")), ("b", View::True)]), Ok(2));
+        assert_eq!(
+            first_duplicate(&vec![("a", View::Str("xy")), ("b", View::Str("z")), ("a", View::True)]),
+            Err(2)
+        );
+        assert_eq!(
+            first_duplicate(&vec![("k", View::Name("n")), ("k", View::Str("abc"))]),
+            Err(1)
+        );
+    }
+
+    #[test]
+    fn entries() {
+        let kids = [View::Name("m")];
+        assert_eq!(check_entries(&vec![], None, &[]), Ok(()));
+        assert_eq!(check_entries(&vec![("doc", View::Str("d")), ("ext", View::True)], None, &[]), Ok(()));
+        assert_eq!(check_entries(&vec![("doc", View::Str("d")), ("doc", View::Str("e"))], None, &[]), err(3, 0, 1));
+        assert_eq!(check_entries(&vec![("unknown", View::True)], None, &[]), err(7, 9, 0));
+        assert_eq!(check_entries(&vec![("doc", View::True)], None, &[]), err(3, 1, 0));
+        assert_eq!(check_entries(&vec![("opaque", View::True)], Some(Tag::Def), &[]), Ok(()));
+        assert_eq!(check_entries(&vec![("opaque", View::Str("s"))], Some(Tag::Def), &[]), err(6, 3, 7));
+        assert_eq!(check_entries(&vec![("opaque", View::True)], Some(Tag::Fn), &[]), err(6, 3, 0));
+        assert_eq!(check_entries(&vec![("path", View::Str("m"))], Some(Tag::Module), &kids), Ok(()));
+        assert_eq!(check_entries(&vec![("path", View::Str("q"))], Some(Tag::Module), &kids), err(4, 2, 1));
+        assert_eq!(check_entries(&vec![("path", View::Str("m"))], Some(Tag::Module), &[]), err(4, 2, 1));
+    }
+}
