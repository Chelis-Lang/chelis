@@ -2482,6 +2482,39 @@ let abs_is_destructured (span : Meta.span) (ctx : eval_ctx) (abs : abs) : bool =
 
 exception FoundBorrowId of unique_borrow_id
 exception FoundAbsId of AbsId.id
+exception FoundSharedChildAbsId of AbsId.id
+
+(** Check whether an abstraction only holds shared borrows: no loans (ignored
+    or not), no mutable borrows and no symbolic projections.
+
+    Such an abstraction gives nothing back and consumes nothing when it ends
+    (the regions it owns have no backward function): ending it does not depend
+    on its parent abstractions. Example: the region abstractions of the nested
+    regions of a shared slice iterator, e.g., the regions ['b], ['c] of
+    [Iter<'a, (&'b str, View<'c>)>] once the iterator is dead. *)
+let abs_only_holds_shared_borrows (abs : abs) : bool =
+  let visitor =
+    object
+      inherit [_] iter_abs as super
+      method! visit_ty _ _ = ()
+      method! visit_abs_cont _ _ = ()
+      method! visit_ALoan _ _ = raise Found
+      method! visit_ASymbolic _ _ _ = raise Found
+
+      method! visit_aborrow_content env bc =
+        match bc with
+        | ASharedBorrow _ | AProjSharedBorrow _ | AEndedSharedBorrow ->
+            super#visit_aborrow_content env bc
+        | AMutBorrow _
+        | AIgnoredMutBorrow _
+        | AEndedMutBorrow _
+        | AEndedIgnoredMutBorrow _ -> raise Found
+    end
+  in
+  try
+    visitor#visit_abs () abs;
+    true
+  with Found -> false
 
 (** Check whether a loan projector has no remaining borrowers.
 
