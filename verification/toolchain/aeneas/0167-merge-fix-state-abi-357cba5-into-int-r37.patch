+  let func =
+    {
+      e =
+        Qualif
+          {
+            id = FunOrOp (Fun (Pure (ModelStateMerge name)));
+            generics = { pure_generics with types };
+          };
+      ty = mk_arrows (List.map (fun (e : texpr) -> e.ty) args) output.ty;
+    }
+  in
+  [%add_loc] mk_apps span func args
