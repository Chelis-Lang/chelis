+import NestedBorrowsFlatMapState.NestedBorrowsFlatMapState
+
+/-! Evaluate the model of `tests/src/nested-borrows-flat-map-state.rs` on the
+    inputs of its `native` test module and compare with the native results
+    (the writes of the closures moved into `flat_map`, `skip` and `chain`
+    through the nested borrows of their captures, two and three levels, read
+    after the call). -/
+
+namespace nested_borrows_flat_map_state.checks
+open Aeneas Aeneas.Std Result
+open nested_borrows_flat_map_state
+
+def u (x : Nat) : U32 := ⟨BitVec.ofNat _ x⟩
+def sl (xs : List Nat) (h : xs.length ≤ Usize.max := by scalar_tac) : Slice U32 :=
+  ⟨xs.map u, by simpa using h⟩
+def nats (v : alloc.vec.Vec U32) : List Nat := v.val.map (·.val)
+
+def max : Nat := 4294967295
+
+/-- `(deps, locals, grown, frames)` -/
+def runDrive (children : List Nat) (scale grown : Nat)
+    (h : children.length ≤ Usize.max := by scalar_tac) :
+    Option (List Nat × List Nat × Nat × Nat) :=
+  match drive (sl children h) (u scale) (u grown) with
+  | ok (d, l, g, f) => some (nats d, nats l, g.val, f.val)
+  | _ => none
+
+/-- `(values, locals, depth)` -/
+def runVec (children : List Nat) (depth : Nat)
+    (h : children.length ≤ Usize.max := by scalar_tac) :
+    Option (List Nat × List Nat × Nat) :=
+  match drive_vec (sl children h) (u depth) with
+  | ok (v, l, d) => some (nats v, nats l, d.val)
+  | _ => none
+
+/-- `(values, depth)` -/
+def runSkip (xs : List Nat) (depth : Nat)
+    (h : xs.length ≤ Usize.max := by scalar_tac) : Option (List Nat × Nat) :=
+  match drive_skip (sl xs h) (u depth) with
+  | ok (v, d) => some (nats v, d.val)
+  | _ => none
+
+/-- `(values, depth)` -/
+def runChain (xs ys : List Nat) (depth : Nat)
+    (hx : xs.length ≤ Usize.max := by scalar_tac)
+    (hy : ys.length ≤ Usize.max := by scalar_tac) : Option (List Nat × Nat) :=
+  match drive_chain (sl xs hx) (sl ys hy) (u depth) with
+  | ok (v, d) => some (nats v, d.val)
+  | _ => none
+
+/-- `(values, calls, n)` -/
+def runDrive3 (xs : List Nat) (n : Nat)
+    (h : xs.length ≤ Usize.max := by scalar_tac) :
+    Option (List Nat × Nat × Nat) :=
+  match drive3 (sl xs h) (u n) with
+  | ok (v, c, m) => some (nats v, c.val, m.val)
+  | _ => none
+
+-- drive_native
+#guard runDrive [1, 2, 3] 10 5 == some ([1, 2, 3, 10, 20, 30], [1, 2, 3], 11, 3)
+#guard runDrive [4, 4] 1 0 == some ([4], [4, 4], 8, 2)
+#guard runDrive [] 7 9 == some ([], [], 9, 0)
+#guard runDrive [max] 2 1 == some ([max - 1, max], [max], 0, 1)
+
+-- drive_vec_native
+#guard runVec [1, 2] 0 == some ([1, 101, 2, 102], [1, 2], 2)
+#guard runVec [] 40 == some ([], [], 40)
+#guard runVec [7, 8, 9] max == some ([7, 107, 8, 108, 9, 109], [7, 8, 9], 2)
+
+-- drive_skip_native
+#guard runSkip [1, 2, 3] 10 == some ([4, 6], 16)
+#guard runSkip [5] 0 == some ([], 5)
+#guard runSkip [] 3 == some ([], 3)
+
+-- drive3_native
+#guard runDrive3 [1, 2] 10 == some ([1, 2, 2, 3], 2, 13)
+#guard runDrive3 [] 7 == some ([], 0, 7)
+#guard runDrive3 [max, 3] 1 == some ([max, 0, 3, 4], 2, 3)
+
+-- drive_chain_native
+#guard runChain [1, 2] [3, 4] 10 == some ([1, 2, 6, 8], 17)
+#guard runChain [] [5] 0 == some ([10], 5)
+#guard runChain [9] [] 3 == some ([9], 3)
+
+end nested_borrows_flat_map_state.checks
