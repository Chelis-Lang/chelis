@@ -0,0 +1,211 @@
+//@ [!lean] skip
+//@ [lean] subdir=NestedBorrowsFlatMapState
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::iter::adapters::map::Map
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Iterator adapters whose model is a constructor with state
+//! (`ModelStateABI.ConstructorWithState`: `flat_map`, `skip`, `chain`) moving
+//! a closure which captures a mutable borrow of a struct holding mutable
+//! borrows (production: chelis-types `vmap_extent::union_children`,
+//! `children.iter().flat_map(|c| analyze_expr(c, locals, .., stack)).collect()`
+//! with `stack: &mut StackBudget<'_>`). The backward function of the inner
+//! region gives back, at level 1, the output of the adapter in which the
+//! closure is replaced with the value received for it
+//! (`ModelStateABI.constructor_state_update`, through the model type's
+//! recombination operation), and the closure gives back, at level 2 (three
+//! levels), the value its restoration lens reads in the output received. The
+//! writes of the closure through the inner borrows are observable after the
+//! call.
+
+use std::collections::BTreeSet;
+
+pub struct NativeServices {
+    pub grown: u32,
+}
+
+pub struct StackBailRecord {
+    pub frames: u32,
+}
+
+/// Two mutable borrows of the same region (production: `infer::stack`)
+pub struct StackBudget<'a> {
+    pub native: &'a mut NativeServices,
+    pub record: &'a mut StackBailRecord,
+}
+
+pub fn analyze(
+    child: &u32,
+    locals: &mut Vec<u32>,
+    scale: &u32,
+    stack: &mut StackBudget<'_>,
+) -> BTreeSet<u32> {
+    stack.native.grown = stack.native.grown.wrapping_add(*child);
+    stack.record.frames = stack.record.frames.wrapping_add(1);
+    locals.push(*child);
+    let mut deps = BTreeSet::new();
+    deps.insert(*child);
+    deps.insert(child.wrapping_mul(*scale));
+    deps
+}
+
+/// The production shape: `flat_map` then `collect` into a `BTreeSet`
+pub fn union_children(
+    children: &[u32],
+    locals: &mut Vec<u32>,
+    scale: &u32,
+    stack: &mut StackBudget<'_>,
+) -> BTreeSet<u32> {
+    children
+        .iter()
+        .flat_map(|child| analyze(child, locals, scale, stack))
+        .collect()
+}
+
+/// `(deps, locals, grown, frames)`: the caller reads the borrowed state after
+/// the call
+pub fn drive(children: &[u32], scale: u32, grown: u32) -> (Vec<u32>, Vec<u32>, u32, u32) {
+    let mut native = NativeServices { grown };
+    let mut record = StackBailRecord { frames: 0 };
+    let mut locals = Vec::new();
+    let deps = {
+        let mut stack = StackBudget { native: &mut native, record: &mut record };
+        union_children(children, &mut locals, &scale, &mut stack)
+    };
+    (deps.into_iter().collect(), locals, native.grown, record.frames)
+}
+
+pub struct Depth<'a> {
+    pub depth: &'a mut u32,
+}
+
+pub fn expand(child: &u32, locals: &mut Vec<u32>, stack: &mut Depth<'_>) -> Vec<u32> {
+    *stack.depth = stack.depth.wrapping_add(1);
+    locals.push(*child);
+    vec![*child, child.wrapping_add(100)]
+}
+
+/// `flat_map` into a `Vec`, with a struct holding one mutable borrow
+pub fn flat_vec(children: &[u32], locals: &mut Vec<u32>, stack: &mut Depth<'_>) -> Vec<u32> {
+    children.iter().flat_map(|child| expand(child, locals, stack)).collect()
+}
+
+pub fn drive_vec(children: &[u32], depth: u32) -> (Vec<u32>, Vec<u32>, u32) {
+    let mut d = depth;
+    let mut locals = Vec::new();
+    let v = {
+        let mut stack = Depth { depth: &mut d };
+        flat_vec(children, &mut locals, &mut stack)
+    };
+    (v, locals, d)
+}
+
+pub fn bump(x: &u32, stack: &mut Depth<'_>) -> u32 {
+    *stack.depth = stack.depth.wrapping_add(*x);
+    x.wrapping_mul(2)
+}
+
+/// `skip` moves a `Map` whose closure captures `&mut Depth<'_>`
+pub fn skip_map(xs: &[u32], stack: &mut Depth<'_>) -> Vec<u32> {
+    xs.iter().map(|x| bump(x, stack)).skip(1).collect()
+}
+
+/// `chain` moves a `Map` whose closure captures `&mut Depth<'_>` as its
+/// second iterator
+pub fn chain_map(xs: &[u32], ys: &[u32], stack: &mut Depth<'_>) -> Vec<u32> {
+    xs.iter().copied().chain(ys.iter().map(|y| bump(y, stack))).collect()
+}
+
+pub fn drive_skip(xs: &[u32], depth: u32) -> (Vec<u32>, u32) {
+    let mut d = depth;
+    let v = {
+        let mut stack = Depth { depth: &mut d };
+        skip_map(xs, &mut stack)
+    };
+    (v, d)
+}
+
+pub fn drive_chain(xs: &[u32], ys: &[u32], depth: u32) -> (Vec<u32>, u32) {
+    let mut d = depth;
+    let v = {
+        let mut stack = Depth { depth: &mut d };
+        chain_map(xs, ys, &mut stack)
+    };
+    (v, d)
+}
+
+pub struct Ctx<'b> {
+    pub n: &'b mut u32,
+    pub calls: u32,
+}
+
+pub struct Frame<'a, 'b> {
+    pub ctx: &'a mut Ctx<'b>,
+}
+
+pub fn expand3(x: &u32, f: &mut Frame<'_, '_>) -> Vec<u32> {
+    *f.ctx.n = f.ctx.n.wrapping_add(*x);
+    f.ctx.calls = f.ctx.calls.wrapping_add(1);
+    vec![*x, x.wrapping_add(1)]
+}
+
+/// Three levels: the closure captures `&mut Frame<'a, 'b>`, `Frame` holds
+/// `&'a mut Ctx<'b>`, `Ctx` holds `&'b mut u32`. The backward function of
+/// `'b` is staged; `flat_map` gives back the closure at level 2 with its
+/// restoration lens applied to the output it receives.
+pub fn flat3(xs: &[u32], f: &mut Frame<'_, '_>) -> Vec<u32> {
+    xs.iter().flat_map(|x| expand3(x, f)).collect()
+}
+
+/// `(values, calls, n)`
+pub fn drive3(xs: &[u32], n: u32) -> (Vec<u32>, u32, u32) {
+    let mut v = n;
+    let (r, calls) = {
+        let mut ctx = Ctx { n: &mut v, calls: 0 };
+        let r = {
+            let mut f = Frame { ctx: &mut ctx };
+            flat3(xs, &mut f)
+        };
+        (r, ctx.calls)
+    };
+    (r, calls, v)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn drive_native() {
+        assert_eq!(drive(&[1, 2, 3], 10, 5), (vec![1, 2, 3, 10, 20, 30], vec![1, 2, 3], 11, 3));
+        assert_eq!(drive(&[4, 4], 1, 0), (vec![4], vec![4, 4], 8, 2));
+        assert_eq!(drive(&[], 7, 9), (vec![], vec![], 9, 0));
+        assert_eq!(drive(&[u32::MAX], 2, 1), (vec![u32::MAX - 1, u32::MAX], vec![u32::MAX], 0, 1));
+    }
+
+    #[test]
+    fn drive_vec_native() {
+        assert_eq!(drive_vec(&[1, 2], 0), (vec![1, 101, 2, 102], vec![1, 2], 2));
+        assert_eq!(drive_vec(&[], 40), (vec![], vec![], 40));
+        assert_eq!(drive_vec(&[7, 8, 9], u32::MAX), (vec![7, 107, 8, 108, 9, 109], vec![7, 8, 9], 2));
+    }
+
+    #[test]
+    fn drive_skip_native() {
+        assert_eq!(drive_skip(&[1, 2, 3], 10), (vec![4, 6], 16));
+        assert_eq!(drive_skip(&[5], 0), (vec![], 5));
+        assert_eq!(drive_skip(&[], 3), (vec![], 3));
+    }
+
+    #[test]
+    fn drive3_native() {
+        assert_eq!(drive3(&[1, 2], 10), (vec![1, 2, 2, 3], 2, 13));
+        assert_eq!(drive3(&[], 7), (vec![], 0, 7));
+        assert_eq!(drive3(&[u32::MAX, 3], 1), (vec![u32::MAX, 0, 3, 4], 2, 3));
+    }
+
+    #[test]
+    fn drive_chain_native() {
+        assert_eq!(drive_chain(&[1, 2], &[3, 4], 10), (vec![1, 2, 6, 8], 17));
+        assert_eq!(drive_chain(&[], &[5], 0), (vec![10], 5));
+        assert_eq!(drive_chain(&[9], &[], 3), (vec![9], 3));
+    }
+}
