+(** Nested borrows: the recombination interface of the output of a model
+    constructor with state (the contract [ConstructorWithState indices]: its
+    output is an opaque model type, e.g. [FlatMap]), through which the values
+    of the inputs moved into the output at the levels > 0 are read and
+    written. The model type's recombination operation (its [stateMerge], see
+    [Pure.builtin_type_info.state_merge]) replaces the state of its type
+    parameters, and the model's restoration lens of a state input reads the
+    input back from the output. A state input is identified with the one
+    recombined type parameter of the output type whose type argument is the
+    input's type (before erasure), which no other state input may have: the
+    model moves the input unchanged into this parameter's position, the one
+    the lens reads. The type arguments of the other parameters must not hold
+    mutable borrows of the region group [keep_region]: the recombination
+    cannot update them. Returns the model type's information, its
+    recombination operation and parameters, and the parameter of each state
+    input (raises if an input has none). *)
+let constructor_state_interface span (ctx : Contexts.decls_ctx)
+    (keep_region : T.region -> bool) (indices : int list) (inputs : T.ty list)
+    output_ty =
+  let id, generics =
+    match output_ty with
+    | T.TAdt { id = T.TAdtId id; generics } -> (id, generics)
+    | _ ->
+        [%craise] span
+          "Model constructor recovery with state requires an output of a \
+           model type"
+  in
+  let decl = T.TypeDeclId.Map.find id ctx.type_ctx.type_decls in
+  let info, name, parameters =
+    match
+      ExtractBuiltin.NameMatcherMap.find_opt
+        (NameMatcher.ctx_from_crate ctx.crate)
+        decl.item_meta.name
+        (ExtractBuiltin.builtin_types_map ())
+    with
+    | Some ({ state_merge = Some (name, parameters); _ } as info) ->
+        (info, name, parameters)
+    | _ ->
+        [%craise] span
+          "Model constructor recovery with state requires a model output type \
+           with a recombination operation"
+  in
+  let has_mut =
+    TypesUtils.ty_has_mut_borrow_for_region_in_pred ctx.type_ctx.type_infos
+      keep_region
+  in
+  [%cassert] span
+    ((not (List.exists keep_region generics.regions))
+    && List.for_all
+         (fun (j, ty) -> List.mem j parameters || not (has_mut ty))
+         (List.mapi (fun j ty -> (j, ty)) generics.types))
+    "Model constructor recovery with state: the output holds mutable borrows \
+     outside the recombination interface of its model type";
+  let slot i =
+    let ty = List.nth inputs i in
+    [%cassert] span
+      (List.mem i indices
+      && List.for_all (fun j -> j = i || List.nth inputs j <> ty) indices)
+      "Model constructor recovery with state requires an input which is the \
+       only state input of its type";
+    match List.filter (fun p -> List.nth generics.types p = ty) parameters with
+    | [ p ] -> p
+    | _ ->
+        [%craise] span
+          "Model constructor recovery with state requires one recombined type \
+           parameter of the output holding each input moved into it"
+  in
+  (info, name, parameters, slot)
+
+(** Nested borrows: rebuild the output of a model constructor with state in
+    which the inputs [updates] (input index, new value) moved into the output
+    are replaced by new values, through the recombination operation of the
+    output type (see [constructor_state_interface]): the new value of an input
+    replaces, in the position of its type parameter, the input the model
+    moved there. Without updates, the output is unchanged. *)
+let constructor_state_update span (ctx : Contexts.decls_ctx) fresh
+    (keep_region : T.region -> bool) (indices : int list) (inputs : T.ty list)
+    output_ty (output : texpr) (updates : (int * texpr) list) : texpr =
+  let info, name, parameters, slot =
+    constructor_state_interface span ctx keep_region indices inputs output_ty
+  in
+  let slots = List.map (fun (i, value) -> (slot i, value)) updates in
+  if slots = [] then output
+  else
+  let pure_generics =
+    match output.ty with
+    | TAdt (_, generics) -> generics
+    | _ -> [%internal_error] span
+  in
+  let callbacks =
+    List.map
+      (fun p ->
+        let ty = List.nth pure_generics.types p in
+        let original = fresh (Some "original") ty in
+        let current = fresh (Some "current") ty in
+        let body =
+          match List.assoc_opt p slots with
+          | Some (value : texpr) ->
+              [%cassert] span (value.ty = ty)
+                "Model constructor recovery with state: an input gives back a \
+                 value of another shape than the one the output holds";
+              value
+          | None -> mk_texpr_from_fvar original
+        in
+        mk_closed_lambdas span
+          (List.map (mk_tpat_from_fvar None) [ original; current ])
+          body)
+      parameters
+  in
+  let types =
+    match info.keep_params with
+    | None -> pure_generics.types
+    | Some keep ->
+        [%sanity_check] span (List.length keep = List.length pure_generics.types);
+        List.filter_map
+          (fun (keep, ty) -> if keep then Some ty else None)
+          (List.combine keep pure_generics.types)
+  in
