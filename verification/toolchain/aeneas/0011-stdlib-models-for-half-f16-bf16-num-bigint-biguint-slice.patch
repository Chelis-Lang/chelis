+theorem and_7fff (a : Nat) : a &&& 0x7FFF = a % 32768 :=
+  Nat.and_two_pow_sub_one_eq_mod a 15
+
+theorem or_eq_zero (x y : Nat) : x ||| y = 0 ↔ x = 0 ∧ y = 0 := by
+  constructor
+  · intro h
+    constructor <;> apply Nat.eq_of_testBit_eq <;> intro i
+    · have := congrArg (fun n => n.testBit i) h
+      simp only [Nat.testBit_or, Nat.zero_testBit, Bool.or_eq_false_iff] at this
+      simp [this.1]
+    · have := congrArg (fun n => n.testBit i) h
+      simp only [Nat.testBit_or, Nat.zero_testBit, Bool.or_eq_false_iff] at this
+      simp [this.2]
+  · rintro ⟨rfl, rfl⟩; rfl
+
+theorem or_and_7fff (a b : Nat) :
+    ((a ||| b) &&& 0x7FFF == 0) = (a % 32768 == 0 && b % 32768 == 0) := by
+  rw [Nat.and_or_distrib_right, and_7fff, and_7fff]
+  apply Bool.eq_iff_iff.mpr
+  simp only [beq_iff_eq, Bool.and_eq_true, or_eq_zero]
+
+theorem and_8000 (a : Nat) : (a &&& 0x8000 != 0) = (a / 32768 % 2 == 1) := by
+  have key : a &&& 0x8000 = if a / 32768 % 2 = 1 then 32768 else 0 := by
+    apply Nat.eq_of_testBit_eq; intro i
+    rw [Nat.testBit_and, show (0x8000 : Nat) = 2 ^ 15 from rfl, Nat.testBit_two_pow]
+    by_cases hi : i = 15
+    · subst hi
+      split <;> simp_all [Nat.testBit_eq_decide_div_mod_eq]
+    · have : decide (15 = i) = false := by simp; omega
+      rw [this, Bool.and_false]
+      split
+      · rw [Nat.testBit_two_pow]; simp; omega
+      · simp
+  rw [key]; split <;> simp_all
+
+theorem sign_bit {a : Nat} (h : a < 65536) : (a / 32768 % 2 == 1) = decide (a ≥ 32768) := by
+  apply Bool.eq_iff_iff.mpr; simp only [beq_iff_eq, decide_eq_true_eq]; omega
+
+theorem compare_nat (a b : Nat) :
