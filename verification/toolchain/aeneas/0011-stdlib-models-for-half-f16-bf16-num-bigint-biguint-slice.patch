@@ -0,0 +1,610 @@
+import Aeneas.Std.Core.Core
+import Aeneas.Std.Float
+
+/-!
+# Models of the `half` 2.7.1 crate
+
+Every conversion below is a transliteration of the crate's software algorithm
+on raw bits (`src/binary16/arch.rs` `*_fallback`, `src/bfloat/convert.rs`),
+including its NaN payload rules and `bf16::from_f64`'s truncation of the low
+32 bits of the `f64` encoding. `Nat` arithmetic stands for the crate's `u32`/
+`u64` arithmetic: no intermediate value of these algorithms leaves the Rust
+integer range, and every `as u16` narrowing is written as `% 2 ^ 16`.
+
+On aarch64 targets with `fp16` (the Chelis build hosts), `f16::from_f32`,
+`f16::to_f32` and `f16::to_f64` dispatch to `FCVT`; the fixture
+`verification/crate_model_oracle` checks exhaustively that the hardware results
+equal these software algorithms bit for bit.
+
+The comparison impls are the crate's bit-level algorithms; the lemmas at the end
+of this file prove that they coincide with `BinaryFloat.eq/lt/le/partialCmp`.
+-/
+
+namespace Aeneas.Std
+
+namespace Half
+
+/-- `u16::leading_zeros` (half's `leading_zeros_u16`). -/
+def leadingZerosU16 (x : Nat) : Nat := if x = 0 then 16 else 15 - x.log2
+
+/-- `binary16/arch.rs::f32_to_f16_fallback`, from `u32` bits to `u16` bits. -/
+def f32ToF16 (x : Nat) : Nat :=
+  let sign := x &&& 0x8000_0000
+  let exp := x &&& 0x7F80_0000
+  let man := x &&& 0x007F_FFFF
+  if exp == 0x7F80_0000 then
+    let nanBit := if man == 0 then 0 else 0x0200
+    ((sign >>> 16) ||| 0x7C00 ||| nanBit ||| (man >>> 13)) % 2 ^ 16
+  else
+    let halfSign := sign >>> 16
+    let unbiasedExp : Int := ((exp >>> 23 : Nat) : Int) - 127
+    let halfExp := unbiasedExp + 15
+    if halfExp ≥ 0x1F then (halfSign ||| 0x7C00) % 2 ^ 16
+    else if halfExp ≤ 0 then
+      if 14 - halfExp > 24 then halfSign % 2 ^ 16
+      else
+        let man := man ||| 0x0080_0000
+        let halfMan := man >>> (14 - halfExp).toNat
+        let roundBit := 1 <<< (13 - halfExp).toNat
+        let halfMan :=
+          if man &&& roundBit != 0 && man &&& (3 * roundBit - 1) != 0 then halfMan + 1
+          else halfMan
+        (halfSign ||| halfMan) % 2 ^ 16
+    else
+      let halfExp := halfExp.toNat <<< 10
+      let halfMan := man >>> 13
+      let roundBit := 0x0000_1000
+      if man &&& roundBit != 0 && man &&& (3 * roundBit - 1) != 0 then
+        ((halfSign ||| halfExp ||| halfMan) + 1) % 2 ^ 16
+      else (halfSign ||| halfExp ||| halfMan) % 2 ^ 16
+
+/-- `binary16/arch.rs::f16_to_f32_fallback`, from `u16` bits to `u32` bits. -/
+def f16ToF32 (i : Nat) : Nat :=
+  if i &&& 0x7FFF == 0 then i <<< 16
+  else
+    let halfSign := i &&& 0x8000
+    let halfExp := i &&& 0x7C00
+    let halfMan := i &&& 0x03FF
+    if halfExp == 0x7C00 then
+      if halfMan == 0 then (halfSign <<< 16) ||| 0x7F80_0000
+      else (halfSign <<< 16) ||| 0x7FC0_0000 ||| (halfMan <<< 13)
+    else
+      let sign := halfSign <<< 16
+      let unbiasedExp : Int := ((halfExp >>> 10 : Nat) : Int) - 15
+      if halfExp == 0 then
+        let e := leadingZerosU16 halfMan - 6
+        let exp := (127 - 15 - e) <<< 23
+        let man := (halfMan <<< (14 + e)) &&& 0x7F_FFFF
+        sign ||| exp ||| man
+      else
+        let exp := (unbiasedExp + 127).toNat <<< 23
+        let man := (halfMan &&& 0x03FF) <<< 13
+        sign ||| exp ||| man
+
+/-- `binary16/arch.rs::f16_to_f64_fallback`, from `u16` bits to `u64` bits. -/
+def f16ToF64 (i : Nat) : Nat :=
+  if i &&& 0x7FFF == 0 then i <<< 48
+  else
+    let halfSign := i &&& 0x8000
+    let halfExp := i &&& 0x7C00
+    let halfMan := i &&& 0x03FF
+    if halfExp == 0x7C00 then
+      if halfMan == 0 then (halfSign <<< 48) ||| 0x7FF0_0000_0000_0000
+      else (halfSign <<< 48) ||| 0x7FF8_0000_0000_0000 ||| (halfMan <<< 42)
+    else
+      let sign := halfSign <<< 48
+      let unbiasedExp : Int := ((halfExp >>> 10 : Nat) : Int) - 15
+      if halfExp == 0 then
+        let e := leadingZerosU16 halfMan - 6
+        let exp := (1023 - 15 - e) <<< 52
+        let man := (halfMan <<< (43 + e)) &&& 0xF_FFFF_FFFF_FFFF
+        sign ||| exp ||| man
+      else
+        let exp := (unbiasedExp + 1023).toNat <<< 52
+        let man := (halfMan &&& 0x03FF) <<< 42
+        sign ||| exp ||| man
+
+/-- `bfloat/convert.rs::f32_to_bf16`, from `u32` bits to `u16` bits. The final
+    `u16` increment cannot overflow: a carry out of `0xFFFF` would need the NaN
+    encodings excluded by the first branch. -/
+def f32ToBf16 (x : Nat) : Nat :=
+  if x &&& 0x7FFF_FFFF > 0x7F80_0000 then ((x >>> 16) ||| 0x0040) % 2 ^ 16
+  else
+    let roundBit := 0x0000_8000
+    if x &&& roundBit != 0 && x &&& (3 * roundBit - 1) != 0 then (x >>> 16) % 2 ^ 16 + 1
+    else (x >>> 16) % 2 ^ 16
+
+/-- `bfloat/convert.rs::f64_to_bf16`, from `u64` bits to `u16` bits. Only the
+    high 32 bits take part in rounding; the low 32 bits only decide NaN-ness. -/
+def f64ToBf16 (val : Nat) : Nat :=
+  let x := (val >>> 32) % 2 ^ 32
+  let sign := x &&& 0x8000_0000
+  let exp := x &&& 0x7FF0_0000
+  let man := x &&& 0x000F_FFFF
+  if exp == 0x7FF0_0000 then
+    let nanBit := if man == 0 && val % 2 ^ 32 == 0 then 0 else 0x0040
+    ((sign >>> 16) ||| 0x7F80 ||| nanBit ||| (man >>> 13)) % 2 ^ 16
+  else
+    let halfSign := sign >>> 16
+    let unbiasedExp : Int := ((exp >>> 20 : Nat) : Int) - 1023
+    let halfExp := unbiasedExp + 127
+    if halfExp ≥ 0xFF then (halfSign ||| 0x7F80) % 2 ^ 16
+    else if halfExp ≤ 0 then
+      if 7 - halfExp > 21 then halfSign % 2 ^ 16
+      else
+        let man := man ||| 0x0010_0000
+        let halfMan := man >>> (14 - halfExp).toNat
+        let roundBit := 1 <<< (13 - halfExp).toNat
+        let halfMan :=
+          if man &&& roundBit != 0 && man &&& (3 * roundBit - 1) != 0 then halfMan + 1
+          else halfMan
+        (halfSign ||| halfMan) % 2 ^ 16
+    else
+      let halfExp := halfExp.toNat <<< 7
+      let halfMan := man >>> 13
+      let roundBit := 0x0000_1000
+      if man &&& roundBit != 0 && man &&& (3 * roundBit - 1) != 0 then
+        ((halfSign ||| halfExp ||| halfMan) + 1) % 2 ^ 16
+      else (halfSign ||| halfExp ||| halfMan) % 2 ^ 16
+
+/-- `bfloat/convert.rs::bf16_to_f32`, from `u16` bits to `u32` bits. -/
+def bf16ToF32 (i : Nat) : Nat :=
+  if i &&& 0x7FFF > 0x7F80 then (i ||| 0x0040) <<< 16 else i <<< 16
+
+/-- `bfloat/convert.rs::bf16_to_f64`, from `u16` bits to `u64` bits. -/
+def bf16ToF64 (i : Nat) : Nat :=
+  if i &&& 0x7FFF == 0 then i <<< 48
+  else
+    let halfSign := i &&& 0x8000
+    let halfExp := i &&& 0x7F80
+    let halfMan := i &&& 0x007F
+    if halfExp == 0x7F80 then
+      if halfMan == 0 then (halfSign <<< 48) ||| 0x7FF0_0000_0000_0000
+      else (halfSign <<< 48) ||| 0x7FF8_0000_0000_0000 ||| (halfMan <<< 45)
+    else
+      let sign := halfSign <<< 48
+      let unbiasedExp : Int := ((halfExp >>> 7 : Nat) : Int) - 127
+      if halfExp == 0 then
+        let e := leadingZerosU16 halfMan - 9
+        let exp := (1023 - 127 - e) <<< 52
+        let man := (halfMan <<< (46 + e)) &&& 0xF_FFFF_FFFF_FFFF
+        sign ||| exp ||| man
+      else
+        let exp := (unbiasedExp + 1023).toNat <<< 52
+        let man := (halfMan &&& 0x007F) <<< 45
+        sign ||| exp ||| man
+
+/-! The `PartialEq`/`PartialOrd` impls of `f16` and `bf16` are textually the
+same bit algorithm; only `is_nan`'s infinity encoding `inf` differs
+(`0x7C00` for `f16`, `0x7F80` for `bf16`). -/
+
+/-- `is_nan`: `self.0 & 0x7FFF > inf`. -/
+def isNaN (inf a : Nat) : Bool := a &&& 0x7FFF > inf
+
+/-- `PartialEq::eq`. -/
+def eq (inf a b : Nat) : Bool :=
+  if isNaN inf a || isNaN inf b then false
+  else a == b || (a ||| b) &&& 0x7FFF == 0
+
+/-- `PartialOrd::partial_cmp`. -/
+def partialCmp (inf a b : Nat) : Option Ordering :=
+  if isNaN inf a || isNaN inf b then none
+  else
+    let neg := a &&& 0x8000 != 0
+    let otherNeg := b &&& 0x8000 != 0
+    match neg, otherNeg with
+    | false, false => some (compare a b)
+    | false, true => if (a ||| b) &&& 0x7FFF == 0 then some .eq else some .gt
+    | true, false => if (a ||| b) &&& 0x7FFF == 0 then some .eq else some .lt
+    | true, true => some (compare b a)
+
+/-- `PartialOrd::lt`. -/
+def lt (inf a b : Nat) : Bool :=
+  if isNaN inf a || isNaN inf b then false
+  else
+    let neg := a &&& 0x8000 != 0
+    let otherNeg := b &&& 0x8000 != 0
+    match neg, otherNeg with
+    | false, false => a < b
+    | false, true => false
+    | true, false => (a ||| b) &&& 0x7FFF != 0
+    | true, true => a > b
+
+/-- `PartialOrd::le`. -/
+def le (inf a b : Nat) : Bool :=
+  if isNaN inf a || isNaN inf b then false
+  else
+    let neg := a &&& 0x8000 != 0
+    let otherNeg := b &&& 0x8000 != 0
+    match neg, otherNeg with
+    | false, false => a ≤ b
+    | false, true => (a ||| b) &&& 0x7FFF == 0
+    | true, false => true
+    | true, true => a ≥ b
+
+/-- `PartialOrd::gt`. -/
+def gt (inf a b : Nat) : Bool :=
+  if isNaN inf a || isNaN inf b then false
+  else
+    let neg := a &&& 0x8000 != 0
+    let otherNeg := b &&& 0x8000 != 0
+    match neg, otherNeg with
+    | false, false => a > b
+    | false, true => (a ||| b) &&& 0x7FFF != 0
+    | true, false => false
+    | true, true => a < b
+
+/-- `PartialOrd::ge`. -/
+def ge (inf a b : Nat) : Bool :=
+  if isNaN inf a || isNaN inf b then false
+  else
+    let neg := a &&& 0x8000 != 0
+    let otherNeg := b &&& 0x8000 != 0
+    match neg, otherNeg with
+    | false, false => a ≥ b
+    | false, true => true
+    | true, false => (a ||| b) &&& 0x7FFF == 0
+    | true, true => a ≤ b
+
+end Half
+
+/-! ## `half::binary16::f16` -/
+
+namespace F16
+
+/-- The infinity encoding used by `f16::is_nan`. -/
+def infBits : Nat := 0x7C00
+
+@[rust_fun "half::binary16::{half::binary16::f16}::from_f32"]
+def from_f32 (x : F32) : Result F16 := .ok (BinaryFloat.ofNat _ (Half.f32ToF16 x.bits.toNat))
+@[rust_fun "half::binary16::{half::binary16::f16}::to_f32"]
+def to_f32 (x : F16) : Result F32 := .ok (BinaryFloat.ofNat _ (Half.f16ToF32 x.bits.toNat))
+@[rust_fun "half::binary16::{half::binary16::f16}::to_f64"]
+def to_f64 (x : F16) : Result F64 := .ok (BinaryFloat.ofNat _ (Half.f16ToF64 x.bits.toNat))
+@[rust_fun "half::binary16::{half::binary16::f16}::is_nan"]
+def is_nan (x : F16) : Result Bool := .ok (Half.isNaN infBits x.bits.toNat)
+
