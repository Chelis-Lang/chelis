diff --git a/tests/src/nested-borrows-shared-capture.rs b/tests/src/nested-borrows-shared-capture.rs
new file mode 100644
index 0000000..094dd13
--- /dev/null
+++ b/tests/src/nested-borrows-shared-capture.rs
@@ -0,0 +1,155 @@
+//@ [!lean] skip
+//@ [lean] subdir=NestedBorrowsSharedCapture
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Four levels of nested mutable borrows through structures whose innermost
+//! structure also holds a shared reference (`C::d`). The shared reference is
+//! not a position of the backward function of the region of `C::r`, but the
+//! values of `C` given back at the levels of that function carry it: the `C`
+//! given back to `W::c` is the value its lender gets back, whose `d` is the
+//! one it holds when the region of `W::c` ends (a caller may have replaced
+//! it), not the one of a snapshot of the borrowed value.
+
+pub struct C<'a, 'x> {
+    pub r: &'a mut u32,
+    pub d: &'x u32,
+}
+
+pub struct W<'a, 'b, 'x> {
+    pub c: &'a mut C<'b, 'x>,
+}
+
+pub struct O<'a, 'b, 'c, 'x> {
+    pub w: &'a mut W<'b, 'c, 'x>,
+}
+
+pub fn add(o: &mut O<'_, '_, '_, '_>, v: u32) -> u32 {
+    *o.w.c.r = (*o.w.c.r).wrapping_add(v).wrapping_add(*o.w.c.d);
+    *o.w.c.r
+}
+
+pub fn add_twice(o: &mut O<'_, '_, '_, '_>, v: u32, d: u32) -> (u32, u32) {
+    let a = add(o, v);
+    let b = add(o, d);
+    (a, b)
+}
+
+pub fn via(w: &mut W<'_, '_, '_>, v: u32) -> (u32, u32) {
+    let mut o = O { w };
+    add_twice(&mut o, v, v)
+}
+
+/// The callee replaces the shared reference after the update.
+pub fn add_redirect<'x>(o: &mut O<'_, '_, '_, 'x>, k: &'x u32, v: u32) -> u32 {
+    let a = add(o, v);
+    o.w.c.d = k;
+    a
+}
+
+pub fn run_add(n: u32, k: u32, v: u32) -> (u32, u32) {
+    let mut n = n;
+    let mut c = C { r: &mut n, d: &k };
+    let mut w = W { c: &mut c };
+    let mut o = O { w: &mut w };
+    let a = add(&mut o, v);
+    (a, n)
+}
+
+pub fn run_add_twice(n: u32, k: u32, v: u32, d: u32) -> (u32, u32, u32) {
+    let mut n = n;
+    let mut c = C { r: &mut n, d: &k };
+    let mut w = W { c: &mut c };
+    let mut o = O { w: &mut w };
+    let (a, b) = add_twice(&mut o, v, d);
+    (a, b, n)
+}
+
+pub fn run_via(n: u32, k: u32, v: u32) -> (u32, u32, u32) {
+    let mut n = n;
+    let mut c = C { r: &mut n, d: &k };
+    let mut w = W { c: &mut c };
+    let (a, b) = via(&mut w, v);
+    (a, b, n)
+}
+
+/// The caller replaces the shared reference between two calls, through the
+/// structures it got back from the first one.
+pub fn run_swap_d(n: u32, k1: u32, k2: u32, v: u32) -> (u32, u32, u32) {
+    let mut n = n;
+    let mut c = C { r: &mut n, d: &k1 };
+    let mut w = W { c: &mut c };
+    let mut o = O { w: &mut w };
+    let a = add(&mut o, v);
+    o.w.c.d = &k2;
+    let b = add(&mut o, v);
+    (a, b, n)
+}
+
+/// The caller reads the shared reference which the callee left in `C`.
+pub fn run_redirect(n: u32, k1: u32, k2: u32, v: u32) -> (u32, u32, u32) {
+    let mut n = n;
+    let mut c = C { r: &mut n, d: &k1 };
+    let mut w = W { c: &mut c };
+    let mut o = O { w: &mut w };
+    let a = add_redirect(&mut o, &k2, v);
+    let b = add(&mut o, v);
+    let d = *c.d;
+    (a, b, d.wrapping_add(n))
+}
+
+/// The caller replaces the shared reference through the structure it got back,
+/// then reads it through its own borrow once the others ended.
+pub fn run_swap_read(n: u32, k1: u32, k2: u32, v: u32) -> (u32, u32, u32) {
+    let mut n = n;
+    let mut c = C { r: &mut n, d: &k1 };
+    let mut w = W { c: &mut c };
+    let a = {
+        let mut o = O { w: &mut w };
+        let a = add(&mut o, v);
+        o.w.c.d = &k2;
+        a
+    };
+    let d = *w.c.d;
+    let e = *c.d;
+    (a, d, e.wrapping_add(n))
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn run_add_native() {
+        assert_eq!(run_add(1, 10, 2), (13, 13));
+        assert_eq!(run_add(u32::MAX, 1, 1), (1, 1));
+    }
+
+    #[test]
+    fn run_add_twice_native() {
+        assert_eq!(run_add_twice(1, 10, 2, 3), (13, 26, 26));
+        assert_eq!(run_add_twice(u32::MAX, 1, 1, u32::MAX), (1, 1, 1));
+    }
+
+    #[test]
+    fn run_via_native() {
+        assert_eq!(run_via(1, 10, 2), (13, 25, 25));
+        assert_eq!(run_via(u32::MAX, u32::MAX, 2), (0, 1, 1));
+    }
+
+    #[test]
+    fn run_swap_d_native() {
+        assert_eq!(run_swap_d(1, 10, 100, 2), (13, 115, 115));
+        assert_eq!(run_swap_d(0, 1, u32::MAX, 1), (2, 2, 2));
+    }
+
+    #[test]
+    fn run_swap_read_native() {
+        assert_eq!(run_swap_read(1, 10, 100, 2), (13, 100, 113));
+        assert_eq!(run_swap_read(0, 1, u32::MAX, 1), (2, 4294967295, 1));
+    }
+
+    #[test]
+    fn run_redirect_native() {
+        assert_eq!(run_redirect(1, 10, 100, 2), (13, 115, 215));
+        assert_eq!(run_redirect(0, 1, u32::MAX, 1), (2, 2, 1));
+    }
+}
