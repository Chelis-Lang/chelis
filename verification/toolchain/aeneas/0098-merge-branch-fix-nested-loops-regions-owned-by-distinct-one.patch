diff --git a/tests/src/join-distinct-owned-region.rs b/tests/src/join-distinct-owned-region.rs
new file mode 100644
index 0000000..89e5eff
--- /dev/null
+++ b/tests/src/join-distinct-owned-region.rs
@@ -0,0 +1,231 @@
+//@ [!lean] skip
+//@ [lean] subdir=JoinDistinctOwnedRegion
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::option::{core::ops::try_trait::Try} --include core::option::{core::ops::try_trait::FromResidual}
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! A loop over a shared cursor pushing into `out: Vec<&Expr>` whose `Var` arm
+//! returns `Some(out)` or `None` after a match on `kids.first()`
+//! (chelis_ir::lower::collect_cons_chain). Every `return` is a loop exit which
+//! drops `out` after the loop, unless it was moved into the result. The inner
+//! `if` joins the branch which moved `out` into `Some(out)` with the one which
+//! still owns it: the join abstraction keeps the region of the `Vec::new`
+//! abstraction. The `_ => return None` arm of the match still has the original
+//! `Vec::new` abstraction owning that region. Joining both exits keeps two
+//! distinct abstractions owning the same region; the collapse ends the one of
+//! the dropped vector, which must not end the region of the joined result.
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+pub enum DeepTag {
+    Module,
+    Def,
+    App,
+    Let,
+    Var,
+}
+
+pub struct Span {
+    pub start: u32,
+    pub end: u32,
+}
+
+pub enum Atom {
+    Name(String),
+    Tag(DeepTag),
+    Int(i64),
+    Bool(bool),
+}
+
+pub struct Metadata {
+    pub storage: Option<Box<u32>>,
+}
+
+pub struct Node {
+    pub tag: DeepTag,
+    pub meta: Metadata,
+    pub children: Vec<Expr>,
+}
+
+pub enum Expr {
+    Atom(Atom, Span),
+    List(Vec<Expr>, Span),
+    Map(Metadata, Span),
+    Node(Box<Node>, Span),
+}
+
+pub enum ExprCarrier<'a> {
+    DecodedNode(DeepTag, &'a Metadata, &'a [Expr]),
+    StructuralList(&'a [Expr]),
+    Atom(&'a Atom),
+    MetadataMap(&'a Metadata),
+}
+
+impl Expr {
+    pub fn carrier(&self) -> ExprCarrier<'_> {
+        match self {
+            Expr::Atom(a, _) => ExprCarrier::Atom(a),
+            Expr::List(l, _) => ExprCarrier::StructuralList(l),
+            Expr::Map(m, _) => ExprCarrier::MetadataMap(m),
+            Expr::Node(n, _) => ExprCarrier::DecodedNode(n.tag, &n.meta, &n.children),
+        }
+    }
+}
+
+fn is_app_of_builtin(expr: &Expr, expected: &str) -> bool {
+    let kids = match expr.carrier() {
+        ExprCarrier::DecodedNode(DeepTag::Var, _, children) => children,
+        ExprCarrier::DecodedNode(_, _, _)
+        | ExprCarrier::StructuralList(_)
+        | ExprCarrier::Atom(_)
+        | ExprCarrier::MetadataMap(_) => return false,
+    };
+    matches!(
+        kids.first(),
+        Some(Expr::Atom(Atom::Name(name), _)) if name == expected
+    )
+}
+
+/// chelis_ir::lower::collect_cons_chain
+pub fn collect_cons_chain(expr: &Expr) -> Option<Vec<&Expr>> {
+    let mut out = Vec::new();
+    let mut cursor = expr;
+    loop {
+        let (tag, kids) = match cursor.carrier() {
+            ExprCarrier::DecodedNode(tag, _, children) => (tag, children),
+            ExprCarrier::StructuralList(_)
+            | ExprCarrier::Atom(_)
+            | ExprCarrier::MetadataMap(_) => return None,
+        };
+        match tag {
+            DeepTag::Var => {
+                let name = match kids.first() {
+                    Some(Expr::Atom(Atom::Name(s), _)) => s.as_str(),
+                    _ => return None,
+                };
+                if name == "Nil" {
+                    return Some(out);
+                }
+                return None;
+            }
+            DeepTag::App => {
+                let func = kids.first()?;
+                if !is_app_of_builtin(func, "Cons") {
+                    return None;
+                }
+                let head = kids.get(1)?;
+                let tail = kids.get(2)?;
+                out.push(head);
+                cursor = tail;
+            }
+            _ => return None,
+        }
+    }
+}
+
+/// (found, number of elements, sum of the integer elements)
+fn summary(r: Option<Vec<&Expr>>) -> (u8, u8, i64) {
+    match r {
+        None => (0, 0, 0),
+        Some(v) => {
+            let mut sum = 0;
+            let mut i = 0;
+            while i < v.len() {
+                if let Expr::Atom(Atom::Int(n), _) = v[i] {
+                    sum += *n;
+                }
+                i += 1;
+            }
+            (1, v.len() as u8, sum)
+        }
+    }
+}
+
+fn span() -> Span {
+    Span { start: 0, end: 0 }
+}
+
+fn node(tag: DeepTag, children: Vec<Expr>) -> Expr {
+    Expr::Node(
+        Box::new(Node {
+            tag,
+            meta: Metadata { storage: None },
+            children,
+        }),
+        span(),
+    )
+}
+
+fn ident(s: &str) -> Expr {
+    Expr::Atom(Atom::Name(String::from(s)), span())
+}
+
+fn var(s: &str) -> Expr {
+    node(DeepTag::Var, vec![ident(s)])
+}
+
+fn int(n: i64) -> Expr {
+    Expr::Atom(Atom::Int(n), span())
+}
+
+fn cons(head: Expr, tail: Expr) -> Expr {
+    node(DeepTag::App, vec![var("Cons"), head, tail])
+}
+
+/// 0: `Nil`, 1: `[3]`, 2: `[3, 4]`, 3: `Cons 3 Nix`, 4: `Cons 3 5`,
+/// 5: `Snoc 1 Nil`, 6: `Cons 1` (no tail), 7: a `Var` without a name,
+/// 8: a `Let`, 9: an atom, 10: `[3, 4, 5]` ending in a `Var` named by an
+/// integer.
+pub fn make(which: u8) -> Expr {
+    if which == 0 {
+        var("Nil")
+    } else if which == 1 {
+        cons(int(3), var("Nil"))
+    } else if which == 2 {
+        cons(int(3), cons(int(4), var("Nil")))
+    } else if which == 3 {
+        cons(int(3), var("Nix"))
+    } else if which == 4 {
+        cons(int(3), int(5))
+    } else if which == 5 {
+        node(DeepTag::App, vec![var("Snoc"), int(1), var("Nil")])
+    } else if which == 6 {
+        node(DeepTag::App, vec![var("Cons"), int(1)])
+    } else if which == 7 {
+        node(DeepTag::Var, Vec::new())
+    } else if which == 8 {
+        node(DeepTag::Let, vec![var("Nil")])
+    } else if which == 9 {
+        int(9)
+    } else {
+        cons(int(3), cons(int(4), cons(int(5), node(DeepTag::Var, vec![int(0)]))))
+    }
+}
+
+/// Collects, then writes through a mutable borrow of the expression (an `App`
+/// gets `Nil` as its last child, anything else becomes an `App`) and collects
+/// again.
+pub fn drive(which: u8) -> (u8, u8, i64, u8, u8, i64) {
+    let mut e = make(which);
+    let (f0, n0, s0) = summary(collect_cons_chain(&e));
+    let r = &mut e;
+    if let Expr::Node(n, _) = r {
+        if n.tag == DeepTag::App {
+            n.children.pop();
+            n.children.push(var("Nil"));
+        } else {
+            n.tag = DeepTag::App;
+        }
+    }
+    let (f1, n1, s1) = summary(collect_cons_chain(&e));
+    (f0, n0, s0, f1, n1, s1)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn drives() {
+        for which in 0u8..11 {
+            println!("{} {:?}", which, drive(which));
+        }
+    }
+}
diff --git a/tests/src/loop-closure-nested-shared-capture.rs b/tests/src/loop-closure-nested-shared-capture.rs
new file mode 100644
index 0000000..9e227c8
--- /dev/null
+++ b/tests/src/loop-closure-nested-shared-capture.rs
@@ -0,0 +1,216 @@
+//@ [!lean] skip
+//@ [lean] subdir=LoopClosureNestedSharedCapture
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Loops calling a `&mut` visitor closure which captures a shared borrow of
+//! another closure, itself capturing a shared borrow
+//! (chelis_ir::host::visit_semantic_expr_children called by
+//! analyze_tensor_helper_preflight_scoped). The regions of the visitor are the
+//! outer `'1` of `&'1 merge_child` and the inner `'2` of the `&'2 Vec` that
+//! `merge_child` captures. At the loop entry the borrow of the inner region
+//! lives in the shared loan of `merge_child` (behind the borrow of `'1`); in
+//! the loop state it is a shared reborrow held by the abstraction of `'2`:
+//! - the join of the loop entry with the loop state projects the value behind
+//!   the shared borrow of `'1` on `'2` (like the inputs of a function call);
+//! - a shared borrow of a join and the projected shared borrow of a function
+//!   call input are the same ownership when they borrow the same loan (loops
+//!   without early exits, `visit_all`).
+
+use std::convert::Infallible;
+
+pub struct List {
+    pub elements: Vec<u32>,
+}
+
+pub struct Node {
+    pub children: Vec<u32>,
+}
+
+pub enum Expr {
+    Atom(u32),
+    List(List),
+    Node(Box<Node>),
+    Bare(Vec<u32>),
+}
+
+fn children(list: &List) -> &[u32] {
+    if list.elements.len() > 2 {
+        &list.elements[2..]
+    } else {
+        &[]
+    }
+}
+
+fn tagged(list: &List) -> bool {
+    list.elements.len() > 1 && list.elements[0] == 0
+}
+
+/// Visits the children of `expr` in order, stopping at the first error
+/// (chelis_ir::host::visit_semantic_expr_children).
+fn visit_children<E>(expr: &Expr, mut visit: impl FnMut(&u32) -> Result<(), E>) -> Result<(), E> {
+    match expr {
+        Expr::Atom(_) => {}
+        Expr::List(list) => {
+            if tagged(list) {
+                for child in children(list) {
+                    visit(child)?;
+                }
+            } else {
+                for child in &list.elements {
+                    visit(child)?;
+                }
+            }
+        }
+        Expr::Node(node) => {
+            for child in &node.children {
+                visit(child)?;
+            }
+        }
+        Expr::Bare(elements) => {
+            let mut i = 0;
+            while i < elements.len() {
+                visit(&elements[i])?;
+                i += 1;
+            }
+        }
+    }
+    Ok(())
+}
+
+pub struct Facts {
+    pub hits: u32,
+    pub sum: u32,
+}
+
+/// The `_` arm of chelis_ir::host::analyze_tensor_helper_preflight_scoped: the
+/// visitor captures the facts, `merge_child` (which captures the summaries),
+/// the output, the node and the index.
+pub fn analyze(expr: &Expr, node: u32, summaries: &Vec<u32>, out: &mut Vec<u32>) -> Facts {
+    let mut facts = Facts { hits: 0, sum: 0 };
+    let merge_child =
+        |facts: &mut Facts, child: &u32, (parent, index): (u32, u32), out: &mut Vec<u32>| {
+            out.push(parent * 10 + index);
+            if (index as usize) < summaries.len() && summaries[index as usize] == *child {
+                facts.hits += 1;
+            }
+            facts.sum += *child;
+        };
+    let mut index = 0;
+    let Ok(()) = visit_children(expr, |child| -> Result<(), Infallible> {
+        merge_child(&mut facts, child, (node, index), out);
+        index += 1;
+        Ok(())
+    });
+    facts
+}
+
+/// Counts the children up to the first one above `limit` plus the number of
+/// summaries (an error of the visitor, which stops the loops).
+pub fn count_until(expr: &Expr, limit: u32, summaries: &Vec<u32>) -> (u32, u32) {
+    let mut count = 0;
+    let bound = |child: &u32| *child <= limit + summaries.len() as u32;
+    let r = visit_children(expr, |child| -> Result<(), u32> {
+        if bound(child) {
+            count += 1;
+            Ok(())
+        } else {
+            Err(*child)
+        }
+    });
+    match r {
+        Ok(()) => (count, 0),
+        Err(c) => (count, c),
+    }
+}
+
+/// Visits every child, without early exits.
+fn visit_all(expr: &Expr, mut visit: impl FnMut(&u32)) {
+    match expr {
+        Expr::Node(node) => {
+            for child in &node.children {
+                visit(child);
+            }
+        }
+        Expr::Bare(elements) => {
+            let mut i = 0;
+            while i < elements.len() {
+                visit(&elements[i]);
+                i += 1;
+            }
+        }
+        Expr::Atom(_) | Expr::List(_) => {}
+    }
+}
+
+/// Sums the children weighted by the number of summaries.
+pub fn tally(expr: &Expr, summaries: &Vec<u32>) -> u32 {
+    let mut total = 0;
+    let weigh_child = |total: &mut u32, child: &u32| {
+        *total += summaries.len() as u32 * *child;
+    };
+    visit_all(expr, |child| {
+        weigh_child(&mut total, child);
+    });
+    total
+}
+
+fn weigh(out: &Vec<u32>) -> u32 {
+    let mut w = 0;
+    let mut i = 0;
+    while i < out.len() {
+        w = w * 3 + out[i];
+        i += 1;
+    }
+    w
+}
+
+/// 0: an atom, 1: a tagged list, 2: an untagged list, 3: a node, 4: a bare
+/// list, 5: an empty node, 6: a bare list with a large element.
+pub fn make(which: u8) -> Expr {
+    if which == 0 {
+        Expr::Atom(7)
+    } else if which == 1 {
+        Expr::List(List { elements: vec![0, 9, 1, 5, 3] })
+    } else if which == 2 {
+        Expr::List(List { elements: vec![1, 2, 4] })
+    } else if which == 3 {
+        Expr::Node(Box::new(Node { children: vec![1, 2, 3, 4] }))
+    } else if which == 4 {
+        Expr::Bare(vec![2, 2, 3])
+    } else if which == 5 {
+        Expr::Node(Box::new(Node { children: Vec::new() }))
+    } else {
+        Expr::Bare(vec![1, 20, 2])
+    }
+}
+
+/// Analyzes, then writes through mutable borrows of the summaries and of the
+/// output, and analyzes again; then counts with a visitor which can fail and
+/// tallies with a visitor without early exits.
+pub fn drive(which: u8) -> (u32, u32, u32, u32, u32, u32, u32, u32) {
+    let e = make(which);
+    let mut summaries = vec![1, 2, 3];
+    let mut out = Vec::new();
+    let f0 = analyze(&e, 1, &summaries, &mut out);
+    let s = &mut summaries;
+    s[0] = 2;
+    s.push(4);
+    let o = &mut out;
+    o.push(7);
+    let f1 = analyze(&e, 2, &summaries, &mut out);
+    let (count, stop) = count_until(&e, 1, &summaries);
+    let t = tally(&e, &summaries);
+    (f0.hits, f0.sum, f1.hits, f1.sum, weigh(&out), count, stop, t)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn drives() {
+        for which in 0u8..7 {
+            println!("{} {:?}", which, drive(which));
+        }
+    }
+}
