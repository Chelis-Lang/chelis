+          match e with
+          | EAbs abs when not (AbsId.Set.mem abs.abs_id other_ids) ->
+              RegionId.Set.union abs.regions.owned owned
+          | _ -> owned)
+        RegionId.Set.empty ctx.env
+    in
+    let conflicts =
+      RegionId.Set.inter
+        (owned_by_own_abs ctx0 ctx1)
+        (owned_by_own_abs ctx1 ctx0)
+    in
+    if RegionId.Set.is_empty conflicts then ctx1
+    else
+      (* The regions mentioned by each symbolic value, in its type or in the
+         types of its projections *)
+      let symbolic_regions (ctx : eval_ctx) =
+        let regions = ref SymbolicValueId.Map.empty in
+        let add id ty =
+          regions :=
+            SymbolicValueId.Map.update id
+              (fun rids ->
+                Some
+                  (RegionId.Set.union (ty_regions ty)
+                     (Option.value rids ~default:RegionId.Set.empty)))
+              !regions
+        in
+        let visited = EvalueTbl.create 16 in
+        let visitor =
+          object
+            inherit [_] iter_env as super
+
+            method! visit_tevalue env value =
+              if not (EvalueTbl.mem visited value) then (
+                EvalueTbl.add visited value ();
+                super#visit_tevalue env value)
+
+            method! visit_symbolic_value _ (sv : symbolic_value) =
+              add sv.sv_id sv.sv_ty
+
+            method! visit_symbolic_proj _ (proj : symbolic_proj) =
+              add proj.sv_id proj.proj_ty
+
+            method! visit_esymbolic_proj _ (proj : esymbolic_proj) =
+              add proj.sv_id proj.proj_ty
+          end
+        in
+        visitor#visit_env () ctx.env;
+        !regions
+      in
+      let regions0 = symbolic_regions ctx0 in
+      let regions1 = symbolic_regions ctx1 in
+      let shared =
+        SymbolicValueId.Map.fold
+          (fun id rids0 shared ->
+            match SymbolicValueId.Map.find_opt id regions1 with
+            | Some rids1 ->
+                RegionId.Set.union shared (RegionId.Set.union rids0 rids1)
+            | None -> shared)
+          regions0 RegionId.Set.empty
+      in
+      refresh_regions (RegionId.Set.diff conflicts shared) ctx1
+  in
 
   let nabs = ref [] in
 
