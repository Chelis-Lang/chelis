+  (* A region can still be live in one branch after it ended in the other.
+     Keep these lifetimes distinct before taking the union of ended regions:
+     otherwise collapsing abstractions may choose the ended id as the
+     representative of a fresh, live loan. The live branch is renamed. *)
+  let refresh_conflicting_regions ended_regions (ctx : eval_ctx) =
+    refresh_regions (RegionId.Set.diff ended_regions ctx.ended_regions) ctx
+  in
   let ctx0 = refresh_conflicting_regions ctx1.ended_regions ctx0 in
   let ctx1 = refresh_conflicting_regions ctx0.ended_regions ctx1 in
+  (* Distinct abstractions of the two branches can own the same region: a
+     join in one branch merges the abstraction owning it into a join
+     abstraction which keeps its region (e.g., the abstraction of [Vec::new]
+     with the loans of a vector which one of the joined branches moved into
+     the result), while the other branch still has the original abstraction.
+     Both survive this join as distinct (marked) abstractions. If the collapse
+     then ends one of them (e.g., the other branch drops the vector), the
+     region is ended while the other one still owns it, and every value whose
+     type mentions it reads as partially bottom. Such lifetimes are unrelated
+     unless a symbolic value present in both branches mentions them (its
+     projections are then reconciled by the join): the right branch is
+     renamed for the unrelated ones only. *)
+  let ctx1 =
