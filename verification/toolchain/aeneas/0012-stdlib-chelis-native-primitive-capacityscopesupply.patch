+import Aeneas.Std.Scalar.Core
+
+/-!
+# Chelis native primitives (trusted base)
+
+Models of the crate-local native primitives of the Chelis semantic core. Each is
+an explicit state object whose native behavior (atomics, process-global
+counters, ...) is abstracted as an oracle: extracted entry points receive the
+state as a parameter, so correspondence theorems quantify over every native
+behavior. Native constructors (e.g. `CapacityScopeSupply::native`) are
+deliberately not modeled: an extracted call to one fails closed as an unknown
+external.
+-/
+
+namespace Aeneas.Std
+
+/-- `chelis_ir::capacity_key::CapacityScopeSupply`: a handle on the process-global
+    capacity-scope identity sequence. The model is an oracle of the identities the
+    counter hands to this invocation: `draw n` is the `n`-th identity drawn through
+    this handle, `none` when the native counter is exhausted. -/
+@[rust_type "chelis_ir::capacity_key::CapacityScopeSupply"]
+structure chelis_ir.capacity_key.CapacityScopeSupply where
+  draw : Nat → Option U64
+  taken : Nat
+
+/-- `CapacityScopeSupply::fresh_id`: the next identity of the oracle; exhaustion
+    is the native `.expect("capacity-scope identity space exhausted")` panic. -/
+@[rust_fun "chelis_ir::capacity_key::{chelis_ir::capacity_key::CapacityScopeSupply}::fresh_id"]
+def chelis_ir.capacity_key.CapacityScopeSupply.fresh_id
+    (s : chelis_ir.capacity_key.CapacityScopeSupply) :
+    Result (U64 × chelis_ir.capacity_key.CapacityScopeSupply) :=
+  match s.draw s.taken with
+  | some id => .ok (id, { s with taken := s.taken + 1 })
+  | none => .fail .panic
+
+end Aeneas.Std
