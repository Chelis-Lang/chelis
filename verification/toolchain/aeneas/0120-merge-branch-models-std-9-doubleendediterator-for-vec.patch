diff --git a/backends/lean/Aeneas/Std/VecIter.lean b/backends/lean/Aeneas/Std/VecIter.lean
index 38b6d2b..e43f725 100644
--- a/backends/lean/Aeneas/Std/VecIter.lean
+++ b/backends/lean/Aeneas/Std/VecIter.lean
@@ -112,6 +112,50 @@ def core.iter.traits.iterator.IteratorVecIntoIter (T : Type) :
   fused := true
 }
 
+/-- `DoubleEndedIterator for vec::IntoIter` (alloc vec/into_iter.rs, rustc 1.95):
+    `next_back` moves the last remaining element out. -/
+@[rust_fun
+  "alloc::vec::into_iter::{core::iter::traits::double_ended::DoubleEndedIterator<alloc::vec::into_iter::IntoIter<@T, @A>, @T>}::next_back"
+  (keepParams := [true, false])]
+def alloc.vec.into_iter.DoubleEndedIteratorIntoIter.next_back {T : Type}
+  (it : alloc.vec.into_iter.IntoIter T) :
+  Result ((Option T) × (alloc.vec.into_iter.IntoIter T)) :=
+  match it.val.getLast? with
+  | none => ok (none, it)
+  | some last => ok (some last, ⟨it.val.dropLast, by
+      simp only [List.length_dropLast]
+      exact Nat.le_trans (Nat.sub_le _ _) it.property⟩)
+
+/-- `advance_back_by` drops the last `min n len` elements and returns the
+    shortfall, `NonZero::new(n - step).map_or(Ok(()), Err)`. -/
+@[rust_fun
+  "alloc::vec::into_iter::{core::iter::traits::double_ended::DoubleEndedIterator<alloc::vec::into_iter::IntoIter<@T, @A>, @T>}::advance_back_by"
+  (keepParams := [true, false])]
+def alloc.vec.into_iter.DoubleEndedIteratorIntoIter.advance_back_by {T : Type}
+  (self : alloc.vec.into_iter.IntoIter T) (n : Usize) :
+  Result (core.result.Result Unit (core.num.nonzero.NonZero Usize) × alloc.vec.into_iter.IntoIter T) := do
+  let step := min n.val self.val.length
+  let it : alloc.vec.into_iter.IntoIter T := ⟨self.val.take (self.val.length - step), by
+    simp only [List.length_take]
+    exact Nat.le_trans (Nat.min_le_right _ _) self.property⟩
+  if h : n.val ≤ step then ok (.Ok (), it)
+  else
+    let left := Usize.ofNatCore (n.val - step) (by scalar_tac)
+    let left ← core.num.nonzero.NonZero.new_unchecked left
+    ok (.Err left, it)
+
+/-- The other methods are the trait's provided ones: `nth_back` through
+    `advance_back_by`, `rfold`/`try_rfold`/`rfind` repeated `next_back`. -/
+@[reducible, rust_trait_impl
+  "core::iter::traits::double_ended::DoubleEndedIterator<alloc::vec::into_iter::IntoIter<@T, @A>, @T>"
+  (keepParams := [true, false])]
+def core.iter.traits.double_ended.DoubleEndedIteratorVecIntoIter (T : Type) :
+  core.iter.traits.double_ended.DoubleEndedIterator (alloc.vec.into_iter.IntoIter T) T := {
+  iteratorInst := core.iter.traits.iterator.IteratorVecIntoIter T
+  next_back := alloc.vec.into_iter.DoubleEndedIteratorIntoIter.next_back
+  advance_back_by := alloc.vec.into_iter.DoubleEndedIteratorIntoIter.advance_back_by
+}
+
 /-- Recovery exposes only the actual unconsumed suffix. Yielded elements are
 moved out, so this is not full-state recovery for contained mutable ownership;
 the typed adapter must reject conversions requiring that recovery. -/
