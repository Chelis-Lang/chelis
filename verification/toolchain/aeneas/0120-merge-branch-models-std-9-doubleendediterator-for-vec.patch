--- a/src/PrePasses.ml
+++ b/src/PrePasses.ml
@@ -2045,6 +2045,71 @@ let resolve_modeled_defaults (crate : crate) : crate =
           | _ -> None)
         crate.fun_decls
     in
+    (* A provided-method copy whose trait declaration does not list the
+       method: Charon declares only the trait methods the crate demands, so no
+       crate code calls the method through a dictionary, and the copy has no
+       declaration to inherit through ([defaults] above). When no declaration
+       calls the copy either, it is dead: it is inherited like [defaults] if the
+       modeled trait provides the method, as a field with a default or as the
+       standalone model of the provided method. Charon's [reuses_default] also
+       holds for implementations of required methods; the model's provided
+       method is the evidence that the trait provides it. A called copy stays
+       (an unknown external, fail-closed). *)
+    let called =
+      let called = ref FunDeclId.Set.empty in
+      let visitor =
+        object
+          inherit [_] iter_crate
+
+          method! visit_fun_decl_id owner id =
+            if id <> owner then called := FunDeclId.Set.add id !called
+        end
+      in
+      FunDeclId.Map.iter
+        (fun id (f : fun_decl) -> visitor#visit_fun_decl id f)
+        crate.fun_decls;
+      !called
+    in
+    let unlisted_defaults =
+      FunDeclId.Map.filter_map
+        (fun fid (f : fun_decl) ->
+          match f.src with
+          | TraitImplItem (_, trait_ref, name, true)
+            when not (FunDeclId.Set.mem fid called) -> (
+              match TraitDeclId.Map.find_opt trait_ref.id modeled_traits with
+              | None -> None
+              | Some info ->
+                  let decl =
+                    TraitDeclId.Map.find trait_ref.id crate.trait_decls
+                  in
+                  let listed =
+                    List.exists
+                      (fun (m : trait_method binder) ->
+                        m.binder_value.name = name)
+                      decl.methods
+                  in
+                  let provided =
+                    match List.assoc_opt name info.methods with
+                    | Some method_info -> method_info.has_default
+                    | None ->
+                        let method_name =
+                          decl.item_meta.name
+                          @ [ PeIdent (name, Disambiguator.zero) ]
+                        in
+                        List.exists
+                          (fun (pattern, _) -> matches pattern method_name)
+                          (ExtractBuiltin.builtin_funs ())
+                  in
+                  if (not listed) && provided then Some () else None)
+          | _ -> None)
+        crate.fun_decls
+    in
+    let inherited_copy id =
+      FunDeclId.Map.mem id defaults || FunDeclId.Map.mem id unlisted_defaults
+    in
+    let no_inherited_copies =
+      FunDeclId.Map.is_empty defaults && FunDeclId.Map.is_empty unlisted_defaults
+    in
     let new_dictionary_uses = ref FunDeclId.Map.empty in
     (* The parent recorded in a method's source is metadata, but the same
          implementation can also occur in its body: recursive derived methods
@@ -2074,7 +2139,7 @@ let resolve_modeled_defaults (crate : crate) : crate =
         | _ -> ())
       crate.fun_decls;
     if
-      FunDeclId.Map.is_empty defaults
+      no_inherited_copies
       && FunDeclId.Map.is_empty !new_dictionary_uses
     then crate
     else
@@ -2235,28 +2300,28 @@ let resolve_modeled_defaults (crate : crate) : crate =
         else visitor#visit_crate None crate
       in
       let trait_impls =
-        if FunDeclId.Map.is_empty defaults then crate.trait_impls
+        if no_inherited_copies then crate.trait_impls
         else
           TraitImplId.Map.map
             (fun (impl : trait_impl) ->
               let methods =
                 List.filter
                   (fun (_, (m : fun_decl_ref binder)) ->
-                    not (FunDeclId.Map.mem m.binder_value.id defaults))
+                    not (inherited_copy m.binder_value.id))
                   impl.methods
               in
               { impl with methods })
             crate.trait_impls
       in
       let declarations =
-        if FunDeclId.Map.is_empty defaults then crate.declarations
+        if no_inherited_copies then crate.declarations
         else
           let filter =
             object
               inherit [_] filter_decl_id
 
               method! visit_fun_decl_id () id =
-                if FunDeclId.Map.mem id defaults then None else Some id
+                if inherited_copy id then None else Some id
             end
           in
           filter#visit_declaration_groups () crate.declarations
