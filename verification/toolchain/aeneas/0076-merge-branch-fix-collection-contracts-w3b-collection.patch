new file mode 100755
index 0000000..ce13559
--- /dev/null
+++ b/tests/separate-compilation/collection-facts.sh
@@ -0,0 +1,239 @@
+#!/usr/bin/env bash
+# Collection obligations across chunks (CollectionContracts, manifest facts).
+#
+# Usage: collection-facts.sh <charon> <aeneas> [<work directory>]
+#
+# Chunks of collection_facts.rs, extracted like the chunks of a workspace
+# (-canonical-names, -split-files, one -subdir per chunk, -abort-on-error):
+# - A (gather, Bag's FromIterator, first) writes, in each function's facts, its
+#   deferred collection obligations as clause paths: gather and Bag::from_iter
+#   require the iterator of their IntoIterator clause (its parent Iterator
+#   clause) to be reviewed; first has none.
+# - B keeps the functions of A opaque (their bodies are not in its LLBC, as in
+#   a later chunk) and reads A's manifest with -external:
+#   - calls that instantiate the obligations with a slice iterator are admitted
+#     (gather_slice, bag_slice), as is a call without obligations (first_slice);
+#   - a call with a crate iterator whose size_hint is an observable callback is
+#     rejected with E_UNSUPPORTED_COLLECTION (gather_hinted, bag_hinted), as it
+#     is within one chunk (A+B);
+#   - relay defers gather's obligation to its own clause: B's facts carry it
+#     to C, where relay_slice is admitted and relay_hinted rejected.
+# - With a manifest of A without collection facts (as written before them), a
+#   call to a function of A with trait clauses is rejected (gather, even with a
+#   reviewed source, and first), while a function without trait clauses is
+#   still usable (double).
+# - Collecting into Bag needs the reviewed facts of Bag::from_iter: without them
+#   (as for an opaque from_iter) bag_slice is rejected, as within one chunk
+#   with an opaque from_iter (ABOS).
+# - A declaration without a body in its own chunk (first, opaque in AO) calls
+#   no collector: its facts are empty and first_slice is admitted, as within
+#   one chunk. (AO is run without -warnings-as-errors, which rejects the
+#   unknown external itself.)
+# - Run for W<I> (A) collects behind a clause of the implementation, and
+#   go_run calls it through a generic dictionary: B builds the dictionary of
+#   W<_> and discharges run's obligation there (run_slice admitted, run_hinted
+#   rejected; without the facts of run, run_slice is rejected too).
+set -uo pipefail
+
+charon=$1
+aeneas=$2
+here=$(cd "$(dirname "$0")" && pwd)
+work=${3:-$(mktemp -d)}
+mkdir -p "$work"
+failures=0
+
+check() { # check <description> <command...>
+  local what=$1
+  shift
+  if "$@"; then
+    echo "ok: $what"
+  else
+    echo "FAILED: $what"
+    failures=$((failures + 1))
+  fi
+}
+
+absent() { # absent <grep arguments...>: the files exist and do not match
+  grep -q "$@"
+  [ $? -eq 1 ]
+}
+
+from_iter='collection_facts::{impl core::iter::traits::collect::FromIterator<u32> for collection_facts::Bag}'
+run_impl='collection_facts::{impl collection_facts::Run for collection_facts::W<_>}'
+run_fun='fun collection_facts::{collection_facts::Run for collection_facts::W<I>}::run'
+
+llbc() { # llbc <chunk> <charon options...>
+  local chunk=$1
+  shift
+  "$charon" rustc --preset=aeneas --mir=promoted --monomorphize-mut=except-types \
+    --remove-adt-clauses '--lift-associated-types=*' --error-on-warnings "$@" \
+    --dest-file "$work/$chunk.llbc" -- "$here/collection_facts.rs" \
+    --crate-name=collection_facts --crate-type=rlib --edition=2021 \
+    >"$work/$chunk.charon.log" 2>&1 ||
+    { echo "charon failed on chunk $chunk (see $work/$chunk.charon.log)"; exit 1; }
+}
+
+strict=(-warnings-as-errors)
+run() { # run <name> <chunk> <aeneas options...>; sets $status
+  local name=$1 chunk=$2
+  shift 2
+  rm -rf "${work:?}/$name" && mkdir -p "$work/$name"
+  "$aeneas" -backend lean -checks -abort-on-error ${strict[@]+"${strict[@]}"} -strict-joins \
+    -sequential -no-progress-bar -canonical-names -split-files -subdir "Chunk$chunk" \
+    -dest "$work/$name/lean" -emit-manifest "$work/$name/manifest.json" "$@" \
+    "$work/$chunk.llbc" >"$work/$name/log" 2>&1
+  status=$?
+}
+
+# The facts of the function whose manifest key is $2, in manifest $1.
+facts() {
+  python3 -c '
+import json, sys
+entries = json.load(open(sys.argv[1]))["entries"]
+facts = [e.get("facts") for e in entries if e["key"] == sys.argv[2]]
+print(json.dumps(facts[0].get("collection_obligations") if facts and facts[0] else "missing"))' "$1" "$2"
+}
+
+opaque_a=(--opaque collection_facts::gather --opaque collection_facts::first
+  --opaque collection_facts::double --opaque "$from_iter"
+  --opaque collection_facts::go_run --opaque "$run_impl")
+llbc A --start-from collection_facts::gather --start-from collection_facts::first \
+  --start-from collection_facts::double --start-from "$from_iter" \
+  --start-from collection_facts::go_run --start-from "$run_impl"
+llbc B "${opaque_a[@]}" --start-from collection_facts::gather_slice \
+  --start-from collection_facts::bag_slice --start-from collection_facts::first_slice \
+  --start-from collection_facts::relay
+llbc BGH "${opaque_a[@]}" --start-from collection_facts::gather_hinted
+llbc BBH "${opaque_a[@]}" --start-from collection_facts::bag_hinted
+llbc BF "${opaque_a[@]}" --start-from collection_facts::first_slice
+llbc BD "${opaque_a[@]}" --start-from collection_facts::twice
+llbc C "${opaque_a[@]}" --opaque collection_facts::relay \
+  --start-from collection_facts::relay_slice
+llbc CH "${opaque_a[@]}" --opaque collection_facts::relay \
+  --start-from collection_facts::relay_hinted
+llbc BR "${opaque_a[@]}" --start-from collection_facts::run_slice
+llbc BRH "${opaque_a[@]}" --start-from collection_facts::run_hinted
+llbc ABGH --start-from collection_facts::gather_hinted
+llbc AO --opaque collection_facts::first --start-from collection_facts::first
+llbc BBS "${opaque_a[@]}" --start-from collection_facts::bag_slice
+llbc ABOS --opaque "$from_iter" --start-from collection_facts::bag_slice
+
+run a A
+check "A exits with status 0" test "$status" -eq 0
+check "gather defers the iterator of its IntoIterator clause" \
+  test "$(facts "$work/a/manifest.json" "fun collection_facts::gather")" \
+  = '[{"into": false, "clause": 0, "parents": [0]}]'
+check "Bag::from_iter defers the iterator of its IntoIterator clause" \
+  test "$(facts "$work/a/manifest.json" \
+    "fun collection_facts::{core::iter::traits::collect::FromIterator<u32> for collection_facts::Bag}::from_iter")" \
+  = '[{"into": false, "clause": 0, "parents": [0]}]'
+check "first has no collection obligation" \
+  test "$(facts "$work/a/manifest.json" "fun collection_facts::first")" = '[]'
+check "double has no collection obligation" \
+  test "$(facts "$work/a/manifest.json" "fun collection_facts::double")" = '[]'
+check "run defers the iterator of its implementation's IntoIterator clause" \
+  test "$(facts "$work/a/manifest.json" "$run_fun")" \
+  = '[{"into": false, "clause": 0, "parents": [0]}]'
+check "go_run has no collection obligation" \
+  test "$(facts "$work/a/manifest.json" "fun collection_facts::go_run")" = '[]'
+
+run b B -external "$work/a/manifest.json"
+check "B (reviewed sources) exits with status 0" test "$status" -eq 0
+check "B does not emit gather" absent -rE '^def collection_facts\.gather$' "$work/b/lean"
+check "relay defers the obligation of gather to its own clause" \
+  test "$(facts "$work/b/manifest.json" "fun collection_facts::relay")" \
+  = '[{"into": false, "clause": 0, "parents": [0]}]'
+
+run c C -external "$work/a/manifest.json" -external "$work/b/manifest.json"
+check "relay_slice is admitted in C" test "$status" -eq 0
+run ch CH -external "$work/a/manifest.json" -external "$work/b/manifest.json"
+check "relay_hinted is rejected in C" test "$status" -ne 0
+check "relay_hinted is rejected by the collection contract" \
+  grep -q "E_UNSUPPORTED_COLLECTION" "$work/ch/log"
+
+run br BR -external "$work/a/manifest.json"
+check "run_slice (a reviewed source behind W's clause) is admitted" test "$status" -eq 0
+run brh BRH -external "$work/a/manifest.json"
+check "run_hinted is rejected where the dictionary of W<Hinted> is built" \
+  test "$status" -ne 0
+check "run_hinted is rejected by the collection contract" \
+  grep -q "E_UNSUPPORTED_COLLECTION" "$work/brh/log"
+python3 -c '
+import json, sys
+manifest = json.load(open(sys.argv[1]))
+for entry in manifest["entries"]:
+    if entry["key"] == sys.argv[3]:
+        entry["facts"].pop("collection_obligations")
+json.dump(manifest, open(sys.argv[2], "w"))' "$work/a/manifest.json" "$work/a-run.json" "$run_fun"
+run br-run BR -external "$work/a-run.json"
+check "run_slice without the facts of run is rejected" test "$status" -ne 0
+check "the rejection names the unknown obligations of run" \
+  grep -q "the collection obligations of collection_facts::{collection_facts::Run for collection_facts::W<I>}::run, owned by an earlier chunk, are unknown" \
+  "$work/br-run/log"
+
+run bgh BGH -external "$work/a/manifest.json"
+check "gather_hinted is rejected" test "$status" -ne 0
+check "gather_hinted is rejected by the collection contract" \
+  grep -q "E_UNSUPPORTED_COLLECTION" "$work/bgh/log"
+run bbh BBH -external "$work/a/manifest.json"
+check "bag_hinted is rejected" test "$status" -ne 0
+check "bag_hinted is rejected by the collection contract" \
+  grep -q "E_UNSUPPORTED_COLLECTION" "$work/bbh/log"
+run abgh ABGH
+check "gather_hinted is rejected within one chunk" test "$status" -ne 0
+check "gather_hinted is rejected by the collection contract within one chunk" \
+  grep -q "E_UNSUPPORTED_COLLECTION" "$work/abgh/log"
+
+# The manifest of A as written before the collection facts.
+python3 -c '
+import json, sys
+manifest = json.load(open(sys.argv[1]))
+for entry in manifest["entries"]:
+    if entry.get("facts"):
+        entry["facts"].pop("collection_obligations", None)
+json.dump(manifest, open(sys.argv[2], "w"))' "$work/a/manifest.json" "$work/a-old.json"
+run b-old B -external "$work/a-old.json"
+check "B with an A manifest without collection facts is rejected" test "$status" -ne 0
+check "the rejection names the unknown obligations of gather" \
+  grep -q "the collection obligations of collection_facts::gather, owned by an earlier chunk, are unknown" \
+  "$work/b-old/log"
+run bf-old BF -external "$work/a-old.json"
+check "first_slice (a trait clause, no collector) is rejected with the old manifest" \
+  test "$status" -ne 0
+check "the rejection names the unknown obligations of first" \
+  grep -q "the collection obligations of collection_facts::first, owned by an earlier chunk, are unknown" \
+  "$work/bf-old/log"
+run bd-old BD -external "$work/a-old.json"
+check "twice (no trait clause) is admitted with the old manifest" test "$status" -eq 0
+
+# The manifest of A without the facts of Bag::from_iter only.
+python3 -c '
+import json, sys
+manifest = json.load(open(sys.argv[1]))
+for entry in manifest["entries"]:
+    if entry["key"].endswith("for collection_facts::Bag}::from_iter") and entry.get("facts"):
+        entry["facts"].pop("collection_obligations")
+json.dump(manifest, open(sys.argv[2], "w"))' "$work/a/manifest.json" "$work/a-bag.json"
+run bbs-bag BBS -external "$work/a-bag.json"
+check "bag_slice without the facts of Bag::from_iter is rejected" test "$status" -ne 0
+check "the rejection names the unreviewed FromIterator" \
+  grep -q "opaque custom FromIterator implementation" "$work/bbs-bag/log"
+run abos ABOS
+check "bag_slice with an opaque Bag::from_iter is rejected within one chunk" test "$status" -ne 0
+check "the rejection names the opaque FromIterator within one chunk" \
+  grep -q "opaque custom FromIterator implementation" "$work/abos/log"
+
+strict=()
+run ao AO
+strict=(-warnings-as-errors)
+check "AO (first without a body) exits with status 0" test "$status" -eq 0
+check "first without a body has no collection obligation" \
+  test "$(facts "$work/ao/manifest.json" "fun collection_facts::first")" = '[]'
+run bf-ao BF -external "$work/ao/manifest.json"
+check "first_slice is admitted with first without a body in its chunk" test "$status" -eq 0
+
+if [ "$failures" -ne 0 ]; then
+  echo "$failures check(s) failed; outputs in $work"
+  exit 1
+fi
+echo "all checks passed"
diff --git a/tests/separate-compilation/collection_facts.rs b/tests/separate-compilation/collection_facts.rs
new file mode 100644
index 0000000..e122f1d
--- /dev/null
+++ b/tests/separate-compilation/collection_facts.rs
@@ -0,0 +1,142 @@
+//! Chunks of collection-facts.sh: chunk A owns the generic collectors `gather`
+//! and `Bag`'s FromIterator, whose collection obligations CollectionContracts
+//! defers to their callers; chunk B calls them with the bodies of A opaque, as
+//! in a workspace chunk, and chunk C calls B's `relay`, which defers `gather`'s
+//! obligation to its own clause. The obligations reach a later chunk only
+//! through the manifest facts of the earlier ones.
+
+/// An iterator whose size_hint is an observable callback: the value-only
+/// collectors must reject it.
+pub struct Hinted(pub bool);
+
+impl Iterator for Hinted {
+    type Item = u32;
+
+    fn next(&mut self) -> Option<u32> {
+        if self.0 {
+            None
+        } else {
+            self.0 = true;
+            Some(7)
+        }
+    }
+
+    fn size_hint(&self) -> (usize, Option<usize>) {
+        panic!("observable size_hint callback")
+    }
+}
+
+// Chunk A
+
+/// Collects its argument into a Vec: the collector's obligation is on `I`.
+pub fn gather<I: IntoIterator<Item = u32>>(items: I) -> Vec<u32> {
+    items.into_iter().collect()
+}
+
+pub struct Bag(pub Vec<u32>);
+
+impl FromIterator<u32> for Bag {
+    fn from_iter<I: IntoIterator<Item = u32>>(items: I) -> Self {
+        Bag(items.into_iter().collect())
+    }
+}
+
+/// No collector: nothing to defer, whatever `T`.
+pub fn first<T: Copy>(items: &[T]) -> Option<T> {
+    match items.first() {
+        Some(item) => Some(*item),
+        None => None,
+    }
+}
+
+/// No trait clause.
+pub fn double(x: u32) -> u32 {
+    x * 2
+}
+
+/// A collector behind a clause of an implementation, called through a
+/// generic dictionary (`go_run`): its obligation is discharged where the
+/// dictionary of `W<_>` is built.
+pub trait Run {
+    fn run(self) -> Vec<u32>;
+}
+
+pub struct W<I>(pub I);
+
+impl<I: IntoIterator<Item = u32>> Run for W<I> {
+    fn run(self) -> Vec<u32> {
+        self.0.into_iter().collect()
+    }
+}
+
+pub fn go_run<R: Run>(r: R) -> Vec<u32> {
+    r.run()
+}
+
+// Chunk B
+
+pub fn gather_slice(items: &[u32]) -> Vec<u32> {
+    gather(items.iter().copied())
+}
+
+pub fn bag_slice(items: &[u32]) -> Bag {
+    items.iter().copied().collect()
+}
+
+pub fn first_slice(items: &[u32]) -> Option<u32> {
+    first(items)
+}
+
+pub fn twice(x: u32) -> u32 {
+    double(x)
+}
+
+pub fn gather_hinted() -> Vec<u32> {
+    gather(Hinted(false))
+}
+
+pub fn bag_hinted() -> Bag {
+    Hinted(false).collect()
+}
+
+pub fn run_slice(items: &[u32]) -> Vec<u32> {
+    go_run(W(items.iter().copied()))
+}
+
+pub fn run_hinted() -> Vec<u32> {
+    go_run(W(Hinted(false)))
+}
+
+/// Defers the obligation of `gather` to its own clause.
+pub fn relay<I: IntoIterator<Item = u32>>(items: I) -> Vec<u32> {
+    gather(items)
+}
+
+// Chunk C
+
+pub fn relay_slice(items: &[u32]) -> Vec<u32> {
+    relay(items.iter().copied())
+}
+
+pub fn relay_hinted() -> Vec<u32> {
+    relay(Hinted(false))
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn collectors() {
+        assert_eq!(gather_slice(&[1, 2]), vec![1, 2]);
+        assert_eq!(bag_slice(&[3]).0, vec![3]);
+        assert_eq!(first_slice(&[4, 5]), Some(4));
+        assert_eq!(twice(3), 6);
+        assert_eq!(relay_slice(&[5, 6]), vec![5, 6]);
+        assert_eq!(run_slice(&[7, 8]), vec![7, 8]);
+        assert!(std::panic::catch_unwind(gather_hinted).is_err());
+        assert!(std::panic::catch_unwind(bag_hinted).is_err());
+        assert!(std::panic::catch_unwind(relay_hinted).is_err());
+        assert!(std::panic::catch_unwind(run_hinted).is_err());
+    }
+}
