+//! A trait method implementation that collects from an iterator given by a
+//! clause of its implementation (`W<I>`): a caller that dispatches through a
+//! generic dictionary (`go_run`) does not see the implementation, so the
+//! obligation is discharged where the dictionary of `W<Hinted>` is built
+//! (`hinted_impl`). `Hinted`'s size_hint panics natively, while the value model
+//! would return its items: rejected with E_UNSUPPORTED_COLLECTION.
+
+pub struct Hinted(pub bool);
+
+impl Iterator for Hinted {
+    type Item = u32;
+
+    fn next(&mut self) -> Option<u32> {
+        if self.0 {
+            None
+        } else {
+            self.0 = true;
+            Some(7)
+        }
+    }
+
+    fn size_hint(&self) -> (usize, Option<usize>) {
+        panic!("observable size_hint callback")
+    }
+}
+
+pub trait Run {
+    fn run(self) -> Vec<u32>;
+}
+
+pub struct W<I>(pub I);
+
+impl<I: IntoIterator<Item = u32>> Run for W<I> {
+    fn run(self) -> Vec<u32> {
+        self.0.into_iter().collect()
+    }
+}
+
+pub fn go_run<R: Run>(r: R) -> Vec<u32> {
+    r.run()
+}
+
+pub fn hinted_impl() -> Vec<u32> {
+    go_run(W(Hinted(false)))
+}
+
+#[cfg(test)]
+mod native {
+    #[test]
+    fn size_hint_panics() {
+        assert!(std::panic::catch_unwind(super::hinted_impl).is_err());
+    }
+}
