+//@ [lean] known-failure
+//@ [!lean] skip
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! A trait method implementation that collects from an iterator given by its
+//! own generic parameter defers that collection obligation to its callers, but
+//! a caller that dispatches through a generic dictionary (`call`) does not see
+//! the implementation: `hinted_method` collects from `Hinted`, whose size_hint
+//! panics natively, while the value model would return its items. The
+//! implementation is rejected with E_UNSUPPORTED_COLLECTION.
+
+pub struct Hinted(pub bool);
+
+impl Iterator for Hinted {
+    type Item = u32;
+
+    fn next(&mut self) -> Option<u32> {
+        if self.0 {
+            None
+        } else {
+            self.0 = true;
+            Some(7)
+        }
+    }
+
+    fn size_hint(&self) -> (usize, Option<usize>) {
+        panic!("observable size_hint callback")
+    }
+}
+
+pub trait Collector {
+    fn go<I: IntoIterator<Item = u32>>(items: I) -> Vec<u32>;
+}
+
+pub struct Plain;
+
+impl Collector for Plain {
+    fn go<I: IntoIterator<Item = u32>>(items: I) -> Vec<u32> {
+        items.into_iter().collect()
+    }
+}
+
+pub fn call<C: Collector>(items: Hinted) -> Vec<u32> {
+    C::go(items)
+}
+
+pub fn hinted_method() -> Vec<u32> {
+    call::<Plain>(Hinted(false))
+}
+
+#[cfg(test)]
+mod native {
+    #[test]
+    fn size_hint_panics() {
+        assert!(std::panic::catch_unwind(super::hinted_method).is_err());
+    }
+}
diff --git a/tests/src/collect-dispatch.rs b/tests/src/collect-dispatch.rs
new file mode 100644
index 0000000..9f70184
--- /dev/null
+++ b/tests/src/collect-dispatch.rs
@@ -0,0 +1,75 @@
+//@ [!lean] skip
+//@ [lean] subdir=CollectDispatch
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! The collection obligation of a trait method implementation on a clause of
+//! its implementation (`W<I>`) is discharged where the implementation's
+//! dictionary is built, since callers may dispatch through a generic
+//! dictionary (`go_run`): with a reviewed source (`slice_run`), deferred to
+//! the clause of a generic builder (`relay`), or built by an implementation's
+//! header (the associated type of `Source for Owned`, reached by projection in
+//! `via_source`). Rejected sources: collect-dispatch-impl.rs.
+
+pub trait Run {
+    fn run(self) -> Vec<u32>;
+}
+
+pub struct W<I>(pub I);
+
+impl<I: IntoIterator<Item = u32>> Run for W<I> {
+    fn run(self) -> Vec<u32> {
+        self.0.into_iter().collect()
+    }
+}
+
+pub fn go_run<R: Run>(r: R) -> Vec<u32> {
+    r.run()
+}
+
+pub fn slice_run(items: &[u32]) -> Vec<u32> {
+    go_run(W(items.iter().copied()))
+}
+
+pub fn relay<I: IntoIterator<Item = u32>>(items: I) -> Vec<u32> {
+    go_run(W(items))
+}
+
+pub fn relay_slice(items: &[u32]) -> Vec<u32> {
+    relay(items.iter().copied().map(|x| x + 1))
+}
+
+pub trait Source {
+    type Out: Run;
+    fn make(self) -> Self::Out;
+}
+
+pub struct Owned(pub Vec<u32>);
+
+impl Source for Owned {
+    type Out = W<std::vec::IntoIter<u32>>;
+
+    fn make(self) -> W<std::vec::IntoIter<u32>> {
+        W(self.0.into_iter())
+    }
+}
+
+pub fn via_source<S: Source>(source: S) -> Vec<u32> {
+    source.make().run()
+}
+
+pub fn owned_run(items: Vec<u32>) -> Vec<u32> {
+    via_source(Owned(items))
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn collected() {
+        assert_eq!(slice_run(&[3, 1, 2]), vec![3, 1, 2]);
+        assert_eq!(slice_run(&[]), Vec::<u32>::new());
+        assert_eq!(relay_slice(&[3, 1, 2]), vec![4, 2, 3]);
+        assert_eq!(owned_run(vec![5, 6]), vec![5, 6]);
+    }
+}
