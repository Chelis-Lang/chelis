+def ok4 : Result (U32 × U32 × U64 × Usize) → Option (Nat × Nat × Nat × Nat)
+  | ok (a, b, c, d) => some (a.val, b.val, c.val, d.val)
+  | _ => none
+
+def ok3 : Result (U32 × U64 × U64) → Option (Nat × Nat × Nat)
+  | ok (a, b, c) => some (a.val, b.val, c.val)
+  | _ => none
+
+def ok2 : Result (U32 × U64) → Option (Nat × Nat)
+  | ok (a, b) => some (a.val, b.val)
+  | _ => none
+
