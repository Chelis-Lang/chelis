   PrintPure.ty_to_string fmt false x
 
+(** Unfold the structures which the backends extract as aliases of their field
+    type: the tuple structures with exactly one field (see
+    [ExtractTypes.extract_type_decl_gen]; they are reducible in Lean). The
+    micro-passes rely on this identification: e.g.,
+    [PureMicroPassesGeneral.inline_useless_var_assignments] substitutes the
+    variable bound to the field of such a structure with the variable bound to
+    the structure (the uses keep the field type). A tuple structure is not
+    recursive, so the unfolding terminates. *)
+let unfold_tuple_struct_aliases (ctx : tc_ctx) (ty : ty) : ty =
+  let visitor =
+    object (self)
+      inherit [_] map_ty
+
+      method! visit_TAdt env id generics =
+        let generics = self#visit_generic_args env generics in
+        let unfolded =
+          match id with
+          | TAdtId def_id -> (
+              match TypeDeclId.Map.find_opt def_id ctx.type_decls with
+              | Some ({ kind = Struct [ _ ]; _ } as def)
+                when TypesUtils.type_decl_from_decl_id_is_tuple_struct
+                       ctx.decls_ctx.type_ctx.type_infos def_id -> (
+                  match
+                    type_decl_get_instantiated_fields_types def None generics
+                  with
+                  | [ field_ty ] -> Some (self#visit_ty env field_ty)
+                  | _ -> None)
+              | _ -> None)
+          | _ -> None
+        in
+        match unfolded with
+        | Some ty -> ty
+        | None -> TAdt (id, generics)
+    end
+  in
+  visitor#visit_ty () ty
+
+(** Are two types equal once the aliases of the tuple structures with one field
+    are unfolded? *)
+let equal_types_modulo_aliases (ctx : tc_ctx) (ty0 : ty) (ty1 : ty) : bool =
+  ty0 = ty1
+  || unfold_tuple_struct_aliases ctx ty0 = unfold_tuple_struct_aliases ctx ty1
+
 (** Check the type of a literal (string literals have the type [Str], which is
     not a literal type) *)
 let check_literal (span : Meta.span) (v : literal) (ty : ty) : unit =
@@ -170,10 +213,10 @@ let rec check_texpr (span : Meta.span) (ctx : tc_ctx) (e : texpr) : unit =
         [%silent_unwrap] span (Collections.List.nth_opt ctx.benv var.scope)
       in
       let ty = [%silent_unwrap] span (BVarId.Map.find_opt var.id tys) in
-      [%pure_type_check] span (ty = e.ty)
+      [%pure_type_check] span (equal_types_modulo_aliases ctx ty e.ty)
   | FVar fid ->
       let ty = [%silent_unwrap] span (FVarId.Map.find_opt fid ctx.fenv) in
-      [%pure_type_check] span (ty = e.ty)
+      [%pure_type_check] span (equal_types_modulo_aliases ctx ty e.ty)
   | CVar cg_id ->
       let ty = T.ConstGenericVarId.Map.find cg_id ctx.const_generics in
       [%pure_type_check] span (ty = e.ty)
