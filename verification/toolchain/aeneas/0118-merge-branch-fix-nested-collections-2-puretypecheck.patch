+//@ [!lean] skip
+//@ [lean] subdir=NestedCollectionsAliases
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::option::{core::option::Option}
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Bodies which use a type recursive through a collection (the Lean backend
+//! stores the collection in a nested carrier and type-checks the bodies it
+//! updates) together with a tuple structure with exactly one field, which the
+//! backends extract as an alias of the field type (the micro-passes then
+//! substitute the field with the structure):
+//! - a visitor over the children of an `Expr`, called with a closure which
+//!   captures, by reference, a closure whose state is one reference, plus
+//!   mutable state (the shape of the preflight analysis of
+//!   chelis_ir::host::analyze_tensor_helper_preflight_scoped);
+//! - the byte cost of an owner whose id is a newtype (the shape of
+//!   chelis_ir::ownership::verify::owner_byte_cost);
+//! - writes through `&mut` into the collections of the recursive type, after
+//!   loops and recursive calls.
+//! `NestedCollectionsAliases/Checks.lean` evaluates the model on the inputs of
+//! the `native` test module below and compares with the native results,
+//! including the values given back through the mutable borrows.
+use std::collections::BTreeMap;
+
+pub enum Expr {
+    Atom(u32),
+    List(Vec<Expr>),
+    Wrap(Box<Expr>),
+}
+
+fn visit_children<E>(expr: &Expr, mut visit: impl FnMut(&Expr) -> Result<(), E>) -> Result<(), E> {
+    match expr {
+        Expr::Atom(_) => {}
+        Expr::List(items) => {
+            for child in items {
+                visit(child)?;
+            }
+        }
+        Expr::Wrap(inner) => visit(inner)?,
+    }
+    Ok(())
+}
+
+fn leaf(expr: &Expr) -> u32 {
+    match expr {
+        Expr::Atom(n) => *n,
+        Expr::List(items) => items.len() as u32,
+        Expr::Wrap(_) => 7,
+    }
+}
+
+/// The closure `merge` captures only `weights` (one field); the visitor's
+/// closure captures `merge` by reference, `total`, `out` and `index`.
+pub fn analyze(expr: &Expr, weights: &BTreeMap<u32, u32>, out: &mut Vec<u32>) -> (u32, u32) {
+    let mut total = 0;
+    let merge = |total: &mut u32, child: &Expr, out: &mut Vec<u32>| {
+        let w = match weights.get(&leaf(child)) {
+            Some(w) => *w,
+            None => 1,
+        };
+        out.push(w);
+        *total += w;
+    };
+    let mut index = 0;
+    let Ok(()) = visit_children(expr, |child| -> Result<(), std::convert::Infallible> {
+        merge(&mut total, child, out);
+        index += 1;
+        Ok(())
+    });
+    (total, index)
+}
+
+/// Stops at the first child whose leaf is `stop`: the values given back
+/// through the captures are those of the visited prefix.
+pub fn analyze_until(expr: &Expr, stop: u32, out: &mut Vec<u32>) -> (Result<(), u32>, u32) {
+    let mut seen = 0;
+    let record = |out: &mut Vec<u32>, child: &Expr| {
+        out.push(leaf(child) + stop);
+    };
+    let result = visit_children(expr, |child| {
+        if leaf(child) == stop {
+            return Err(seen);
+        }
+        record(out, child);
+        seen += 1;
+        Ok(())
+    });
+    (result, seen)
+}
+
+#[derive(Clone, Copy, PartialEq, Eq, PartialOrd, Ord)]
+pub struct OwnerId(pub u32);
+
+pub enum Dim {
+    Lit(u64),
+    Named(u32, Option<u64>),
+}
+
+/// Recursive through `Vec<Self>`; `Tensor` holds a collection of another type.
+pub enum HostType {
+    Scalar(u32),
+    Tuple(Vec<HostType>),
+    Adt(u32, Vec<HostType>),
+    Tensor(Vec<Dim>, u64),
+}
+
+pub struct OwnerInfo {
+    pub ty: HostType,
+    pub heap: bool,
+}
+
+pub enum CostError {
+    Missing(u32),
+    Overflow(u32, u64),
+}
+
+pub enum ByteBound {
+    Unknown,
+    Exact(u64),
+}
+
+pub fn owner_byte_cost(
+    owners: &BTreeMap<OwnerId, OwnerInfo>,
+    owner: OwnerId,
+) -> Result<ByteBound, CostError> {
+    let info = owners.get(&owner).ok_or(CostError::Missing(owner.0))?;
+    let HostType::Tensor(dims, width) = &info.ty else {
+        return Ok(if info.heap {
+            ByteBound::Unknown
+        } else {
+            ByteBound::Exact(0)
+        });
+    };
+    let mut elements = 1u64;
+    for dim in dims {
+        let value = match dim {
+            Dim::Lit(value) | Dim::Named(_, Some(value)) => *value,
+            Dim::Named(_, None) => return Ok(ByteBound::Unknown),
+        };
+        elements = elements
+            .checked_mul(value)
+            .ok_or(CostError::Overflow(owner.0, value))?;
+    }
+    elements
+        .checked_mul(*width)
+        .map(ByteBound::Exact)
+        .ok_or(CostError::Overflow(owner.0, *width))
+}
+
+/// Writes through `&mut` into the collections of the recursive type: the
+/// dimensions of every tensor, and (recursively) the children of every tuple
+/// and ADT. Returns the number of updated dimensions.
+pub fn rename_dims(ty: &mut HostType, owner: OwnerId) -> u32 {
+    match ty {
+        HostType::Scalar(_) => 0,
+        HostType::Tuple(children) | HostType::Adt(_, children) => {
+            let mut count = 0;
+            for child in children {
+                count += rename_dims(child, owner);
+            }
+            count
+        }
+        HostType::Tensor(dims, _) => {
+            let mut count = 0;
+            for dim in dims {
+                if let Dim::Named(name, _) = dim {
+                    *name += owner.0;
+                    count += 1;
+                }
+            }
+            count
+        }
+    }
+}
+
+fn sample(n: u32) -> Expr {
+    Expr::List(vec![
+        Expr::Atom(n),
+        Expr::Wrap(Box::new(Expr::Atom(2))),
+        Expr::List(vec![Expr::Atom(1), Expr::Atom(n)]),
+        Expr::Atom(3),
+    ])
+}
+
+fn weights() -> BTreeMap<u32, u32> {
+    let mut weights = BTreeMap::new();
+    weights.insert(2, 20);
+    weights.insert(3, 300);
+    weights.insert(7, 7000);
+    weights
+}
+
+/// A checksum of a list of numbers (order-sensitive).
+fn checksum(values: &Vec<u32>) -> u64 {
+    let mut acc = 0u64;
+    for v in values.iter() {
+        acc = (acc * 10_007 + *v as u64) % 1_000_000_007;
+    }
+    acc
+}
+
+/// `analyze` on a list: the total, the number of visited children and the
+/// weights pushed to `out` (given back through the captures).
+pub fn analyze_scenario(n: u32) -> (u32, u32, u64, usize) {
+    let mut out = vec![5];
+    let (total, index) = analyze(&sample(n), &weights(), &mut out);
+    (total, index, checksum(&out), out.len())
+}
+
+/// `analyze` on a wrapped expression (the visitor's direct call).
+pub fn analyze_wrap_scenario(n: u32) -> (u32, u32, u64, usize) {
+    let mut out = Vec::new();
+    let (total, index) = analyze(&Expr::Wrap(Box::new(Expr::Atom(n))), &weights(), &mut out);
+    (total, index, checksum(&out), out.len())
+}
+
+/// `analyze_until` on a list: where it stopped, and what it recorded.
+pub fn analyze_until_scenario(stop: u32) -> (u32, u32, u64, usize) {
+    let mut out = vec![0];
+    let (result, seen) = analyze_until(&sample(4), stop, &mut out);
+    let stopped = match result {
+        Ok(()) => 99,
+        Err(at) => at,
+    };
+    (stopped, seen, checksum(&out), out.len())
+}
+
+fn owners(extent: u64) -> BTreeMap<OwnerId, OwnerInfo> {
+    let mut owners = BTreeMap::new();
+    owners.insert(
+        OwnerId(1),
+        OwnerInfo {
+            ty: HostType::Tensor(vec![Dim::Lit(3), Dim::Named(9, Some(extent))], 4),
+            heap: true,
+        },
+    );
+    owners.insert(
+        OwnerId(2),
+        OwnerInfo {
+            ty: HostType::Tensor(vec![Dim::Lit(extent), Dim::Named(8, None)], 8),
+            heap: true,
+        },
+    );
+    owners.insert(
+        OwnerId(3),
+        OwnerInfo {
+            ty: HostType::Tuple(vec![HostType::Scalar(1), HostType::Tuple(Vec::new())]),
+            heap: true,
+        },
+    );
+    owners.insert(OwnerId(4), OwnerInfo { ty: HostType::Scalar(0), heap: false });
+    owners
+}
+
+/// The byte cost of an owner: 0 = unknown, 1 = exact (with the bound),
+/// 2 = missing (with the owner), 3 = overflow (with the owner and the factor).
+pub fn owner_cost_scenario(owner: u32, extent: u64) -> (u32, u64, u64) {
+    match owner_byte_cost(&owners(extent), OwnerId(owner)) {
+        Ok(ByteBound::Unknown) => (0, 0, 0),
+        Ok(ByteBound::Exact(bytes)) => (1, bytes, 0),
+        Err(CostError::Missing(id)) => (2, id as u64, 0),
+        Err(CostError::Overflow(id, factor)) => (3, id as u64, factor),
+    }
+}
+
+fn dims_checksum(ty: &HostType) -> u64 {
+    match ty {
+        HostType::Scalar(n) => *n as u64,
+        HostType::Tuple(children) | HostType::Adt(_, children) => {
+            let mut acc = 7u64;
+            for child in children.iter() {
+                acc = (acc * 101 + dims_checksum(child)) % 1_000_000_007;
+            }
+            acc
+        }
+        HostType::Tensor(dims, width) => {
+            let mut acc = *width;
+            for dim in dims.iter() {
+                let code = match dim {
+                    Dim::Lit(v) => *v,
+                    Dim::Named(name, None) => 1_000 + *name as u64,
+                    Dim::Named(name, Some(v)) => 100_000 * *name as u64 + *v,
+                };
+                acc = (acc * 1_009 + code) % 1_000_000_007;
+            }
+            acc
+        }
+    }
+}
+
+/// `rename_dims` on a nested type: the count, and the renamed type.
+pub fn rename_scenario(owner: u32) -> (u32, u64) {
+    let mut ty = HostType::Tuple(vec![
+        HostType::Tensor(vec![Dim::Named(1, Some(2)), Dim::Lit(3), Dim::Named(4, None)], 2),
+        HostType::Adt(
+            5,
+            vec![
+                HostType::Scalar(6),
+                HostType::Tensor(vec![Dim::Named(7, None)], 4),
+            ],
+        ),
+        HostType::Tuple(Vec::new()),
+    ]);
+    let count = rename_dims(&mut ty, OwnerId(owner));
+    (count, dims_checksum(&ty))
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn analyze_lists() {
+        assert_eq!(analyze_scenario(3), (7620, 4, 137167999, 5));
+        assert_eq!(analyze_scenario(7), (14320, 4, 941467546, 5));
+        assert_eq!(analyze_wrap_scenario(2), (20, 1, 20, 1));
+        assert_eq!(analyze_wrap_scenario(5), (1, 1, 1, 1));
+    }
+
+    #[test]
+    fn analyze_until_stops() {
+        assert_eq!(analyze_until_scenario(4), (0, 0, 0, 1));
+        assert_eq!(analyze_until_scenario(3), (3, 3, 701080418, 4));
+        assert_eq!(analyze_until_scenario(1), (99, 4, 308467055, 5));
+    }
+
+    #[test]
+    fn owner_costs() {
+        assert_eq!(owner_cost_scenario(1, 5), (1, 60, 0));
+        assert_eq!(owner_cost_scenario(1, u64::MAX / 2), (3, 1, u64::MAX / 2));
+        assert_eq!(owner_cost_scenario(2, 5), (0, 0, 0));
+        assert_eq!(owner_cost_scenario(3, 5), (0, 0, 0));
+        assert_eq!(owner_cost_scenario(4, 5), (1, 0, 0));
+        assert_eq!(owner_cost_scenario(9, 5), (2, 9, 0));
+    }
+
+    #[test]
+    fn renames() {
+        assert_eq!(rename_scenario(10), (3, 282650872));
+        assert_eq!(rename_scenario(0), (3, 74245960));
+    }
+}
