+  some (3, 1, 9223372036854775807)
+#guard ok3 (owner_cost_scenario 2#u32 5#u64) == some (0, 0, 0)
+#guard ok3 (owner_cost_scenario 3#u32 5#u64) == some (0, 0, 0)
