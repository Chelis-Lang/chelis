@@ -0,0 +1,64 @@
+//@ [!lean] skip
+//@ [lean] recover-errors
+//@ [lean] subdir=DiagnosticRecoveryInstance
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Reporting that a declaration could not be translated must not raise. The
+//! messages of the recovery handlers give the name pattern of the declaration,
+//! and the name matcher fails its round-trip check on the names of the
+//! partially monomorphized instances of trait implementations, such as
+//! `{Tag<fn(u32) -> u32> for Wrap<I>}::<IterMut<'0, T0>, &'0 mut T1>` below
+//! (`--monomorphize-mut` instantiates the implementation at
+//! `Wrap<IterMut<'_, u32>>`). The trait argument of the implementation is a
+//! function pointer type, which is not supported: neither the implementation
+//! nor its instance is translated. The run reports every error, gives the
+//! reason instead of the name pattern of the instance, still emits `incr` and
+//! `incr_twice`, and exits with status 1 (before, the name matcher's
+//! `Assert_failure` escaped from the handler: status 2).
+
+pub trait Tag<F> {
+    fn tag(&mut self) -> u32;
+}
+
+pub struct Wrap<I> {
+    pub inner: I,
+}
+
+impl<I: Iterator> Tag<fn(u32) -> u32> for Wrap<I> {
+    fn tag(&mut self) -> u32 {
+        7
+    }
+}
+
+pub fn use_tag<T: Tag<fn(u32) -> u32>>(t: &mut T) -> u32 {
+    t.tag()
+}
+
+/// Its signature is not translated either.
+pub fn tag_slice(v: &mut [u32], _f: fn(u32) -> u32) -> u32 {
+    let mut w = Wrap { inner: v.iter_mut() };
+    use_tag(&mut w)
+}
+
+pub fn incr(x: u32) -> u32 {
+    x.wrapping_add(1)
+}
+
+pub fn incr_twice(x: u32) -> u32 {
+    incr(incr(x))
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn values() {
+        assert_eq!(incr(41), 42);
+        assert_eq!(incr(u32::MAX), 0);
+        assert_eq!(incr_twice(40), 42);
+        assert_eq!(incr_twice(u32::MAX), 1);
+        let mut v = [1u32, 2];
+        assert_eq!(tag_slice(&mut v, incr), 7);
+    }
+}
