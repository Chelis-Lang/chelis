+(** The name pattern of a declaration in a message which reports that its
+    translation failed ([pattern] computes it). Reporting an error must not
+    raise: when the pattern cannot be computed, we describe why instead. This
+    happens when the pattern is itself the subject of an error (a [CFailure],
+    which is already reported), and when the name matcher raises, e.g., on the
+    names of the partially monomorphized instances of trait implementations,
+    for which its round-trip check ([name_with_generics_to_pattern]) fails. *)
+let name_pattern_for_error_message (pattern : unit -> string) : string =
+  try pattern () with
+  | (Out_of_memory | Sys.Break) as e -> raise e
+  | Errors.CFailure _ ->
+      "(could not compute the name pattern due to a different error)"
+  | e ->
+      "(could not compute the name pattern: uncaught exception "
+      ^ Printexc.exn_slot_name e ^ ")"
