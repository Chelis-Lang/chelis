+//@ [!lean] skip
+//@ [lean] recover-errors
+//@ [lean] subdir=SpecializedTraitMethodAbi
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! The specializations of a modeled trait are folded into the model only if
+//! this keeps the backward functions of their methods. `sum_cloned` uses
+//! `Iterator::cloned`, so every translated `Iterator` implementation has a
+//! `cloned` method, and `bump_after` iterates over `Skip<IterMut<'a, u32>>`
+//! (the shape of `chelis_deep::authoring`), whose implementation of `Iterator`
+//! uses that of `IterMut<'a, u32>`. With `--monomorphize-mut`, the traits of
+//! these two implementations are specializations, e.g.
+//! `Iterator::<IterMut<'0, T0>, &'0 mut T1>`, whose `cloned` method is the
+//! method of another specialization, `Iterator::<IterMut<'0, T0>, T1>` (the
+//! item of the bound `Self: Iterator<Item = &'a T>` of `cloned`):
+//! `cloned::<IterMut<'0, T0>, ..>(self: IterMut<'0, T0>) -> Cloned<IterMut<'0,
+//! T0>>` gives back the borrows of `'0`. The model of `Iterator` adapts the
+//! methods it represents, not `cloned`, and the generic `Iterator::cloned`
+//! (`Self -> Cloned<Self>`) gives back nothing: folding the method changed the
+//! field of the record of the first specialization, which no longer matched the
+//! `cloned` methods of the implementations (the check of the backward functions
+//! of trait-implementation methods rejected both implementations). The method
+//! is now left specialized. The loop of `bump_after` over `Skip<IterMut<..>>`
+//! and the `cloned` methods of the implementations are not modeled: the run
+//! reports them as external definitions (exit status 1); it reported the two
+//! implementations as untranslatable, then raised an uncaught exception.
+//! `SpecializedTraitMethodAbi/Checks.lean` evaluates `sum_cloned` on the inputs
+//! of the `native` test module below.
+
+pub fn bump_after(v: &mut [u32], k: usize, d: u32) -> u32 {
+    let mut n = 0u32;
+    for x in v.iter_mut().skip(k) {
+        *x = x.wrapping_add(d);
+        n = n.wrapping_add(1);
+    }
+    n
+}
+
+pub fn sum_cloned(v: &[u32]) -> u32 {
+    let mut s = 0u32;
+    for x in v.iter().cloned() {
+        s = s.wrapping_add(x);
+    }
+    s
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn values() {
+        let mut v = [1u32, 2, 3, 4];
+        assert_eq!(bump_after(&mut v, 1, 10), 3);
+        assert_eq!(v, [1, 12, 13, 14]);
+        assert_eq!(bump_after(&mut v, 4, 10), 0);
+        assert_eq!(v, [1, 12, 13, 14]);
+        assert_eq!(sum_cloned(&[]), 0);
+        assert_eq!(sum_cloned(&[1, 2, 3]), 6);
+        assert_eq!(sum_cloned(&[u32::MAX, 2]), 1);
+    }
+}
