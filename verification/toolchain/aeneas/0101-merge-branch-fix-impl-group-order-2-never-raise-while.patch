index 0000000..94e6319
--- /dev/null
+++ b/tests/lean/SpecializedTraitMethodAbi/Checks.lean
@@ -0,0 +1,24 @@
+import SpecializedTraitMethodAbi.SpecializedTraitMethodAbi
+
+/-! Evaluate the model of `sum_cloned` (`tests/src/specialized-trait-method-abi.rs`)
+    on the inputs of the `native` test module and compare with the native
+    results. `bump_after` iterates over `Skip<IterMut<'_, u32>>`, whose `next`
+    is an external definition: it is not evaluated. -/
+
+namespace specialized_trait_method_abi.checks
+open Aeneas Aeneas.Std Result
+
+def u (n : Nat) : U32 := ⟨BitVec.ofNat _ n⟩
+
+def slice (xs : List Nat) : Slice U32 :=
+  let xs := xs.map u
+  if h : xs.length ≤ Usize.max then ⟨xs, h⟩ else ⟨[], by simp⟩
+
+def nat (r : Result U32) : Option Nat :=
+  match r with | ok v => some v.val | _ => none
+
+#guard nat (sum_cloned (slice [])) == some 0
+#guard nat (sum_cloned (slice [1, 2, 3])) == some 6
+#guard nat (sum_cloned (slice [4294967295, 2])) == some 1
+
+end specialized_trait_method_abi.checks
