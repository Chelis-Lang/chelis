-/-- `catch_native_unwind`: `o := true; let r := f self; o := false; r`. The
-    conversions `marker` and `message` apply only to an unexpected native unwind,
-    which is outside the modeled domain: the failure of `f` propagates. The grown
-    stack segment is not observable. -/
+/-- `catch_native_unwind`: `o := true; let r := f self state; o := false; r`.
+    The conversions `marker` and `message` apply only to an unexpected native
+    unwind, which is outside the modeled domain: the failure of `f` propagates.
+    The grown stack segment is not observable. `F : FnOnce(&mut Self, &mut S)` is
+    Charon's `FnOnce<(&mut LoweringRuntime, &mut S)>` specialization: the call
+    returns the closure's value, the runtime and the state it was lent. -/
 @[rust_fun
   "chelis_ir::lowering_runtime::{chelis_ir::lowering_runtime::LoweringRuntime}::catch_native_unwind"]
-def catch_native_unwind {T D F Marker Message : Type} (_cloneInst : core.clone.Clone D)
-    (fInst : core.ops.function.FnOnceMutArg F LoweringRuntime (core.result.Result T D))
+def catch_native_unwind {S T D F Marker Message : Type} (_cloneInst : core.clone.Clone D)
+    (fInst : core.ops.function.FnOnceMutArgMutArg F LoweringRuntime S (core.result.Result T D))
     (_markerInst : core.ops.function.FnOnce Marker Unit D)
     (_messageInst : core.ops.function.FnOnce Message (Option String) D)
-    (s : LoweringRuntime) (f : F) (_marker : Marker) (_message : Message) :
-    Result (core.result.Result T D × LoweringRuntime) := do
-  let (result, s) ← fInst.call_once f { s with o := true }
-  .ok (result, { s with o := false })
+    (s : LoweringRuntime) (state : S) (f : F) (_marker : Marker) (_message : Message) :
+    Result (core.result.Result T D × LoweringRuntime × S) := do
+  let (result, s, state) ← fInst.call_once f ({ s with o := true }, state)
+  .ok (result, { s with o := false }, state)
 
