diff --git a/tests/src/fn-once-mut-arg-mut-arg.rs b/tests/src/fn-once-mut-arg-mut-arg.rs
new file mode 100644
index 0000000..d3af805
--- /dev/null
+++ b/tests/src/fn-once-mut-arg-mut-arg.rs
@@ -0,0 +1,56 @@
+//@ [!lean] skip
+//@ [lean] subdir=FnOnceMutArgMutArg
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! A closure taking two mutable borrows, as the callback of
+//! `LoweringRuntime::catch_native_unwind` takes the runtime and the explicit
+//! state. Charon's `--monomorphize-mut` specializes `FnOnce<(&mut T, &mut U)>`,
+//! whose model `FnOnceMutArgMutArg` returns both borrowed arguments (and not
+//! the consumed closure).
+//! `FnOnceMutArgMutArg/Checks.lean` evaluates the model on the inputs of the
+//! `native` test module below and compares with the native results.
+
+pub fn apply_both<R>(x: &mut u32, y: &mut u64, f: impl FnOnce(&mut u32, &mut u64) -> R) -> R {
+    f(x, y)
+}
+
+/// A closure that writes both borrows, with a captured value.
+pub fn step(x: &mut u32, y: &mut u64, by: u32) -> bool {
+    apply_both(x, y, move |x, y| {
+        *x = x.wrapping_add(by);
+        *y = y.wrapping_mul(2);
+        *y > 10
+    })
+}
+
+/// The borrows passed on through a closure that takes them.
+pub fn forwarded(x: &mut u32, y: &mut u64) -> u32 {
+    apply_both(x, y, |x, y| {
+        apply_both(x, y, |x, y| {
+            *y = y.wrapping_add(1);
+            *x
+        })
+    })
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn step_writes_both() {
+        let (mut x, mut y) = (4, 3);
+        assert!(!step(&mut x, &mut y, 5));
+        assert_eq!((x, y), (9, 6));
+        let (mut x, mut y) = (u32::MAX, 6);
+        assert!(step(&mut x, &mut y, 2));
+        assert_eq!((x, y), (1, 12));
+    }
+
+    #[test]
+    fn forwarded_returns_both() {
+        let (mut x, mut y) = (7, u64::MAX);
+        assert_eq!(forwarded(&mut x, &mut y), 7);
+        assert_eq!((x, y), (7, 0));
+    }
+}
diff --git a/tests/src/modeled-instance-fail-closed.rs b/tests/src/modeled-instance-fail-closed.rs
new file mode 100644
index 0000000..1f55587
--- /dev/null
+++ b/tests/src/modeled-instance-fail-closed.rs
@@ -0,0 +1,25 @@
+//@ [lean] known-failure
+//@ [lean] no-check-output
+//@ [!lean] skip
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! `core::mem::swap` has a generic model. Swapping two mutable references
+//! makes Charon's `--monomorphize-mut` translate a partial-monomorphization
+//! instance `core::mem::swap::<&mut _>`, whose borrowed arguments carry nested
+//! backward continuations that the generic model's signature lacks. The name
+//! matcher ignores the instance shape, so the generic model used to be called
+//! with the wrong arguments; the instance now remains an unknown external.
+//! (No output check: the failure is reported after generation, next to the
+//! run's timing.)
+
+pub fn swap_targets<'a>(a: &mut &'a mut u32, b: &mut &'a mut u32) {
+    std::mem::swap(a, b);
+}
+
+pub fn swapped_writes(x: &mut u32, y: &mut u32) {
+    let mut a = x;
+    let mut b = y;
+    swap_targets(&mut a, &mut b);
+    *a = 1;
+    *b = 2;
+}
