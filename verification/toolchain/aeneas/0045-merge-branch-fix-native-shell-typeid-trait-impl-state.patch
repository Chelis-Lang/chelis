diff --git a/backends/lean/Aeneas/Std/Core/Any.lean b/backends/lean/Aeneas/Std/Core/Any.lean
new file mode 100644
index 0000000..74e9b58
--- /dev/null
+++ b/backends/lean/Aeneas/Std/Core/Any.lean
@@ -0,0 +1,15 @@
+import Aeneas.Std.Core.Core
+import Aeneas.Std.Scalar.Core
+
+namespace Aeneas.Std
+
+/-- `core::any::TypeId` (core/src/any.rs): at runtime the 128-bit hash of a type
+    (its array of pointers carries provenance only for const evaluation and Miri).
+    `Any::type_id` mentions it, so every crate with `Any` evidence retains the type.
+    No operation on it is modeled: a call to `Any::type_id` or to a comparison
+    fails closed as an unknown external. -/
+@[rust_type "core::any::TypeId" (body := .opaque)]
+structure core.any.TypeId where
+  hash : U128
+
+end Aeneas.Std
diff --git a/backends/lean/Aeneas/Std/Core/Ops.lean b/backends/lean/Aeneas/Std/Core/Ops.lean
index ee726db..5f0a15f 100644
--- a/backends/lean/Aeneas/Std/Core/Ops.lean
+++ b/backends/lean/Aeneas/Std/Core/Ops.lean
@@ -70,6 +70,15 @@ structure core.ops.function.FnOnceMutArgPair (Self : Type u) (T : Type v) (U : T
     (Output : Type x) where
   call_once : Self → (T × U) → Result (Output × T)
 
+/-- The specialization `FnOnce<(&'a mut T, &'b mut U)>` that Charon's
+    `--monomorphize-mut` creates for a closure taking two mutable borrows (e.g.
+    the runtime and the explicit state of a catch). Both borrowed arguments are
+    returned after the call; the consumed closure state is not. -/
+@[rust_trait "core::ops::function::FnOnce<@Self, (&'a mut @T, &'b mut @U), @Output>"]
+structure core.ops.function.FnOnceMutArgMutArg (Self : Type u) (T : Type v) (U : Type w)
+    (Output : Type x) where
+  call_once : Self → (T × U) → Result (Output × T × U)
+
 @[rust_trait "core::ops::function::FnMut" (parentClauses := ["FnOnceInst"])]
 structure core.ops.function.FnMut (Self : Type u) (Args : Type v) (Output : Type w) where
   FnOnceInst : core.ops.function.FnOnce Self Args Output
