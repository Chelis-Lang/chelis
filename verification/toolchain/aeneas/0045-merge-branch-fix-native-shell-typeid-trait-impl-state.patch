+(** A partial-monomorphization instance of a function (last name element
+    [PeInstantiated]) substitutes a mutability shape into the generic function:
+    its dictionaries are specialized records and the borrows inside its
+    arguments add backward continuations. The logical matcher ignores
+    [PeInstantiated] and would select the generic model with the wrong
+    arguments. So an instance is modeled only after PrePasses folds an
+    ABI-compatible instance to its generic function; otherwise it stays an
+    unknown external. *)
+let find_fun_info ctx name =
+  if backend () = Lean && is_trait_specialization name then None
+  else NameMatcherMap.find_opt ctx name (builtin_funs_map ())
+
+let mem_fun ctx name = Option.is_some (find_fun_info ctx name)
+
 type effect_info = { can_fail : bool }
 
 let mk_builtin_fun_effects () : (pattern * effect_info) list =
@@ -991,3 +1005,8 @@ let mk_builtin_fun_effects_map () =
   name_matcher_map_of_list (if_backend mk_builtin_fun_effects [])
 
 let builtin_fun_effects_map = mk_memoized mk_builtin_fun_effects_map
+
+(** The effects of a modeled function; an instance as in [find_fun_info]. *)
+let find_fun_effect_info ctx name =
+  if backend () = Lean && is_trait_specialization name then None
+  else NameMatcherMap.find_opt ctx name (builtin_fun_effects_map ())
