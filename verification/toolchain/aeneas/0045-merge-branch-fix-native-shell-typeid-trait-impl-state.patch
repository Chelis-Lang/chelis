diff --git a/tests/src/any-type-id.rs b/tests/src/any-type-id.rs
new file mode 100644
index 0000000..2d7459d
--- /dev/null
+++ b/tests/src/any-type-id.rs
@@ -0,0 +1,31 @@
+//@ [!lean] skip
+//@ [lean] subdir=AnyTypeId
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! `Any` evidence retains `core::any::TypeId` through the signature of
+//! `Any::type_id`, although nothing calls it: the type must have a model,
+//! not become an axiom (an unknown external).
+//! `AnyTypeId/Checks.lean` evaluates the model on the inputs of the `native`
+//! test module below and compares with the native results.
+use std::any::Any;
+
+/// A payload threaded through an `Any` bound, as raise sites do.
+pub fn pass_any<P: Any>(payload: P) -> P {
+    payload
+}
+
+pub fn tagged(code: u32, fatal: bool) -> (u32, bool) {
+    let code = pass_any(code);
+    (code.wrapping_add(1), pass_any(fatal))
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn tagged_passes_payloads() {
+        assert_eq!(tagged(4, true), (5, true));
+        assert_eq!(tagged(u32::MAX, false), (0, false));
+    }
+}
diff --git a/tests/src/captured-fn-once-mut.rs b/tests/src/captured-fn-once-mut.rs
new file mode 100644
index 0000000..542bfa0
--- /dev/null
+++ b/tests/src/captured-fn-once-mut.rs
@@ -0,0 +1,42 @@
+//@ [!lean] skip
+//@ [lean] subdir=CapturedFnOnceMut
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! A closure calling a captured generic `impl FnOnce(&mut T)`, as
+//! `LoweringRuntime::catch_lowering` wraps its callback. The closure implements
+//! the `FnOnce<(&mut T,)>` specialization (model `FnOnceMutArg`): the borrowed
+//! argument is returned, the consumed closure is not, although its capture is
+//! generic.
+//! `CapturedFnOnceMut/Checks.lean` evaluates the model on the inputs of the
+//! `native` test module below and compares with the native results.
+
+pub fn apply<R>(x: &mut u32, f: impl FnOnce(&mut u32) -> R) -> R {
+    f(x)
+}
+
+pub fn catching<R>(x: &mut u32, f: impl FnOnce(&mut u32) -> R) -> R {
+    apply(x, move |y| f(y))
+}
+
+/// `catching` with a closure that captures nothing.
+pub fn bump(x: &mut u32) -> u32 {
+    catching(x, |y| {
+        *y = y.wrapping_add(1);
+        *y
+    })
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn bump_increments() {
+        let mut x = 4;
+        assert_eq!(bump(&mut x), 5);
+        assert_eq!(x, 5);
+        let mut x = u32::MAX;
+        assert_eq!(bump(&mut x), 0);
+        assert_eq!(x, 0);
+    }
+}
