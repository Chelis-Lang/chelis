+import LoopStaticStrElementContinue.LoopStaticStrElementContinue
+open Aeneas Aeneas.Std Result
+
+/-! Evaluate the model of `tests/src/loop-static-str-element-continue.rs` on the
+    inputs of its `native` test module and compare with the native results
+    (rustc 1.98.0), including the dimensions given back through the mutable
+    borrow of `run_dims`, before and after the caller of `drive` writes through
+    it (adds 100 to the first, appends 7). -/
+
+namespace loop_static_str_element_continue.checks
+
+def u32' (n : Nat) : U32 := ⟨BitVec.ofNat _ n⟩
+
+def vec (xs : List Nat) (h : xs.length ≤ Usize.max := by scalar_tac) : alloc.vec.Vec U32 :=
+  ⟨xs.map u32', by simpa using h⟩
+
+def nats (v : alloc.vec.Vec U32) : List Nat := v.val.map (·.val)
+
+def res (r : core.result.Result U32 U32) : Except Nat Nat :=
+  match r with
+  | .Ok n => .ok n.val
+  | .Err e => .error e.val
+
+/-- `run` on the claims of `which` -/
+def runOn (which : U8) (values : List Nat) (h : values.length ≤ Usize.max := by scalar_tac) :
+    Option (Except Nat Nat) :=
+  match (do
+    let c ← claims which
+    run c (vec values h) : Result (core.result.Result U32 U32)) with
+  | ok r => some (res r)
+  | _ => none
+
+/-- `run_dims` on the sites of `which`: the result and the dimensions given
+    back -/
+def runDims (which : U8) (values dims : List Nat)
+    (hv : values.length ≤ Usize.max := by scalar_tac)
+    (hd : dims.length ≤ Usize.max := by scalar_tac) :
+    Option (Except Nat Nat × List Nat) :=
+  match (do
+    let s ← sites which
+    run_dims s (vec values hv) (vec dims hd) :
+      Result (core.result.Result U32 U32 × alloc.vec.Vec U32)) with
+  | ok (r, d) => some (res r, nats d)
+  | _ => none
+
+def driven (r : Result (U32 × alloc.vec.Vec U32 × alloc.vec.Vec U32)) :
+    Option (Nat × List Nat × List Nat) :=
+  match r with
+  | ok (x, b, a) => some (x.val, nats b, nats a)
+  | _ => none
+
+-- native::run_native
+#guard runOn 0#u8 [0, 1] == some (.ok 14)
+#guard runOn 1#u8 [] == some (.ok 13)
+#guard runOn 2#u8 [0] == some (.ok 0)
+#guard runOn 0#u8 [0, 1, 2, 3, 4] == some (.error 1)
+
+-- native::run_dims_native
+#guard runDims 0#u8 [0] [1, 1] == some (.ok 3, [3, 5, 6])
+#guard runDims 1#u8 [0] [1, 1] == some (.error 8, [1, 9])
+#guard runDims 2#u8 [0] [2] == some (.ok 0, [2])
+#guard runDims 0#u8 [0, 1, 2, 3, 4] [1, 1] == some (.error 1, [1, 1])
+
+-- native::drive_native
+#guard driven (drive 0#u8 (u32' 2)) == some (3, [3, 5, 6], [103, 5, 6, 7])
+#guard driven (drive 1#u8 (u32' 0)) == some (1008, [1, 9], [101, 9, 7])
+#guard driven (drive 2#u8 (u32' 3)) == some (0, [1, 1], [101, 1, 7])
+#guard driven (drive 0#u8 (u32' 5)) == some (1001, [1, 1], [101, 1, 7])
+
+end loop_static_str_element_continue.checks
