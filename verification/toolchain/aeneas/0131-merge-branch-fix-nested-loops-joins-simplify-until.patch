+//@ [!lean] skip
+//@ [lean] subdir=LoopStaticStrElementContinue
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! A loop over the shared elements of a vector whose items hold a `&'static
+//! str` (the loop over the local guard sites of a node in
+//! `chelis_ir::eval::eval_tensor_internal_with_result_claims`), where a call
+//! taking the element (`is_active(claim, ..)?`) can `continue` before a match on
+//! a field of the element whose arms `continue` too.
+//!
+//! Reading the element expands its `op` field into a shared borrow of a `str`
+//! whose loan sits in a dummy value. Where the shared loan of the element has
+//! already ended, its released payload is either transferred to the
+//! abstraction of the loop's region (the `str` borrow stays alive) or dropped by
+//! [eliminate_ended_shared_loans] (the `str` loan is left without borrowers).
+//! The simplification of the contexts of a join dropped the payloads after its
+//! fixed point, so the unborrowed `str` loan stayed in the contexts joined at
+//! the `continue`s, while matching those contexts with the join simplified
+//! them again and removed it: "Could not match the contexts". The
+//! simplification now iterates until eliminating the ended shared loans
+//! changes nothing.
+//!
+//! LoopStaticStrElementContinue/Checks.lean compares the model with the native
+//! results asserted in the native test module, including the dimensions given
+//! back through the mutable borrow, before and after the caller writes through
+//! it.
+
+pub enum Obs {
+    Carrier(u32),
+    Computed(u32),
+    Realized,
+}
+
+pub struct Claim {
+    pub claim: u32,
+    pub op: &'static str,
+    pub observed: Obs,
+}
+
+/// Err once there are more than 4 values; active when the claim is not 0
+fn is_active(claim: &Claim, values: &Vec<u32>) -> Result<bool, u32> {
+    if values.len() > 4 {
+        Err(claim.claim)
+    } else {
+        Ok(claim.claim != 0)
+    }
+}
+
+/// The sum of the observed extents of the active sites
+pub fn run(sites: &Vec<Claim>, values: &Vec<u32>) -> Result<u32, u32> {
+    let mut n = 0u32;
+    for claim in sites {
+        if !is_active(claim, values)? {
+            continue;
+        }
+        let observed = match &claim.observed {
+            Obs::Carrier(c) => *c,
+            Obs::Computed(c) => {
+                if *c == 0 {
+                    continue;
+                }
+                *c + 1
+            }
+            Obs::Realized => continue,
+        };
+        n += observed;
+    }
+    Ok(n)
+}
+
+/// Record the observed extent at `axis`, or append it; a claim whose
+/// operator is longer than 2 rejects an axis past the dimensions
+fn verdict(axis: usize, claim: &Claim, observed: u32, dims: &mut Vec<u32>) -> Result<(), u32> {
+    if axis < dims.len() {
+        dims[axis] = observed;
+        Ok(())
+    } else if claim.op.len() > 2 {
+        Err(claim.claim)
+    } else {
+        dims.push(observed);
+        Ok(())
+    }
+}
+
+/// The node loop's shape: pairs `(axis, claim)`, and a verdict which writes
+/// through `dims`; the number of verdicts
+pub fn run_dims(sites: &Vec<(usize, Claim)>, values: &Vec<u32>, dims: &mut Vec<u32>) -> Result<u32, u32> {
+    let mut n = 0u32;
+    for (axis, claim) in sites {
+        if !is_active(claim, values)? {
+            continue;
+        }
+        let observed = match &claim.observed {
+            Obs::Carrier(c) => *c,
+            Obs::Computed(c) => {
+                if *c == 0 {
+                    continue;
+                }
+                *c + 1
+            }
+            Obs::Realized => continue,
+        };
+        verdict(*axis, claim, observed, dims)?;
+        n += 1;
+    }
+    Ok(n)
+}
+
+fn claim(claim: u32, op: &'static str, observed: Obs) -> Claim {
+    Claim { claim, op, observed }
+}
+
+/// 0: every observation kind; 1: an inactive site, a zero computed extent,
+/// then a strict claim past the dimensions; 2: no site
+pub fn sites(which: u8) -> Vec<(usize, Claim)> {
+    let mut s = Vec::new();
+    if which == 0 {
+        s.push((0, claim(1, "==", Obs::Carrier(3))));
+        s.push((1, claim(2, "==", Obs::Computed(4))));
+        s.push((0, claim(3, "==", Obs::Realized)));
+        s.push((2, claim(4, "<=", Obs::Carrier(6))));
+        s.push((1, claim(5, "==", Obs::Computed(0))));
+    } else if which == 1 {
+        s.push((0, claim(0, "==", Obs::Carrier(8))));
+        s.push((1, claim(6, "==", Obs::Computed(0))));
+        s.push((1, claim(7, "==", Obs::Carrier(9))));
+        s.push((5, claim(8, "less", Obs::Computed(2))));
+        s.push((0, claim(9, "==", Obs::Carrier(1))));
+    }
+    s
+}
+
+/// The claims of [sites]
+pub fn claims(which: u8) -> Vec<Claim> {
+    let mut c = Vec::new();
+    for (_, cl) in sites(which) {
+        c.push(cl);
+    }
+    c
+}
+
+fn code(r: Result<u32, u32>) -> u32 {
+    match r {
+        Ok(n) => n,
+        Err(e) => 1000 + e,
+    }
+}
+
+/// Checks the sites of `which` against `nvalues` values with the dimensions
+/// `[1, 1]`, then writes through the borrow of the dimensions given back (adds
+/// 100 to the first, appends 7): the result, and the dimensions before and
+/// after the write
+pub fn drive(which: u8, nvalues: u32) -> (u32, Vec<u32>, Vec<u32>) {
+    let mut values = Vec::new();
+    let mut i = 0;
+    while i < nvalues {
+        values.push(i);
+        i += 1;
+    }
+    let mut dims = vec![1, 1];
+    let r = run_dims(&sites(which), &values, &mut dims);
+    let before = dims.clone();
+    let d = &mut dims;
+    d[0] += 100;
+    d.push(7);
+    (code(r), before, dims)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn run_native() {
+        assert_eq!(run(&claims(0), &vec![0, 1]), Ok(3 + 5 + 6));
+        assert_eq!(run(&claims(1), &vec![]), Ok(9 + 3 + 1));
+        assert_eq!(run(&claims(2), &vec![0]), Ok(0));
+        assert_eq!(run(&claims(0), &vec![0, 1, 2, 3, 4]), Err(1));
+    }
+
+    #[test]
+    fn run_dims_native() {
+        let mut dims = vec![1, 1];
+        assert_eq!(run_dims(&sites(0), &vec![0], &mut dims), Ok(3));
+        assert_eq!(dims, vec![3, 5, 6]);
+        let mut dims = vec![1, 1];
+        assert_eq!(run_dims(&sites(1), &vec![0], &mut dims), Err(8));
+        assert_eq!(dims, vec![1, 9]);
+        let mut dims = vec![2];
+        assert_eq!(run_dims(&sites(2), &vec![0], &mut dims), Ok(0));
+        assert_eq!(dims, vec![2]);
+        let mut dims = vec![1, 1];
+        assert_eq!(run_dims(&sites(0), &vec![0, 1, 2, 3, 4], &mut dims), Err(1));
+        assert_eq!(dims, vec![1, 1]);
+    }
+
+    #[test]
+    fn drive_native() {
+        assert_eq!(drive(0, 2), (3, vec![3, 5, 6], vec![103, 5, 6, 7]));
+        assert_eq!(drive(1, 0), (1008, vec![1, 9], vec![101, 9, 7]));
+        assert_eq!(drive(2, 3), (0, vec![1, 1], vec![101, 1, 7]));
+        assert_eq!(drive(0, 5), (1001, vec![1, 1], vec![101, 1, 7]));
+    }
+}
