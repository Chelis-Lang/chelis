+import FmtDebugStruct.FmtDebugStruct
+
+/-! Evaluate the model of `tests/src/fmt-debug-struct.rs` on the inputs of its `native` test module
+    and compare with the native results, including the string given back by `try_render`. -/
+namespace fmt_debug_struct.checks
+open Aeneas Aeneas.Std Result
+
+def vec {α : Type} (xs : List α) : alloc.vec.Vec α :=
+  if h : xs.length ≤ Usize.max then ⟨xs, h⟩ else ⟨[], by simp⟩
+def u32 (n : Nat) : U32 := ⟨BitVec.ofNat _ n⟩
+
+def text (r : Result String) : Option String :=
+  match r with | ok s => some s | _ => none
+
+def mkMeta (values : List Nat) (label : String) (slot content : Bool) : Option Metadata :=
+  match metadata (vec (values.map u32)) label slot content with | ok m => some m | _ => none
+
+def renderOf (m : Option Metadata) (pretty : Bool := false) : Option String :=
+  m.bind fun m => text (if pretty then render_pretty m else render m)
+
+#guard renderOf (mkMeta [1, 2] "x" true true) ==
+  some "Metadata { storage: Some(Storage { values: [1, 2], label: \"x\" }) }"
+#guard renderOf (mkMeta [] "" true false) == some "Metadata { storage: None }"
+#guard renderOf (mkMeta [] "" false true) == some "Metadata { storage: None }"
+#guard renderOf (mkMeta [1, 2] "x" true true) (pretty := true) ==
+  some "Metadata {\n    storage: Some(\n        Storage {\n            values: [\n                1,\n                2,\n            ],\n            label: \"x\",\n        },\n    ),\n}"
+
+def pairOf (pretty : Bool) : Option String :=
+  (mkMeta [3] "y" true true).bind fun right =>
+    text (render_pair { left := ⟨BitVec.ofInt _ (-7)⟩, right } pretty)
+
+#guard pairOf false ==
+  some "Pair { left: -7, right: Metadata { storage: Some(Storage { values: [3], label: \"y\" }) } }"
+#guard pairOf true ==
+  some "Pair {\n    left: -7,\n    right: Metadata {\n        storage: Some(\n            Storage {\n                values: [\n                    3,\n                ],\n                label: \"y\",\n            },\n        ),\n    },\n}"
+#guard text (render_empty false) == some "Empty"
+#guard text (render_empty true) == some "Empty"
+
+/-- The status of `write!` and the string given back. -/
+def tryRender (out : String) (first : Nat) (pretty : Bool) : Option (Bool × String) :=
+  match try_render out { first := ⟨BitVec.ofNat _ first⟩ } pretty with
+  | ok r => some r
+  | _ => none
+
+#guard tryRender "pre" 9 false == some (false, "pre<W { first: 9, bad: bad")
+#guard tryRender "" 0 true == some (false, "<W {\n    first: 0,\n    bad: bad")
+
+end fmt_debug_struct.checks
