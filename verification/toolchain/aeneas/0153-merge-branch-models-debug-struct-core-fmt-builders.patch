+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! The `DebugStruct` builder in a named local, its fields added by separate statements (the
+//! `&mut Self` which `field` returns is dropped each time). The production code chains the calls
+//! (`fmt-debug-struct.rs`); this form is rejected with a diagnostic instead of being extracted.
+use std::fmt;
+
+pub struct Named {
+    pub a: u8,
+    pub b: u8,
+}
+
+impl fmt::Debug for Named {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        let mut builder = f.debug_struct("Named");
+        builder.field("a", &self.a);
+        builder.field("b", &self.b);
+        builder.finish()
+    }
+}
+
+pub fn render(n: &Named) -> String {
+    format!("{n:?}")
+}
