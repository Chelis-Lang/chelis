+//@ [!lean] skip
+//@ [lean] subdir=FmtDebugStruct
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::option::{core::option::Option} --include core::option::{core::ops::try_trait::Try} --include core::option::{core::ops::try_trait::FromResidual} --include core::result::{core::result::Result}
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! The `DebugStruct` builder (`Formatter::debug_struct`, `field`, `finish`) as chelis-deep
+//! `annotations.rs` uses it for `Metadata`: calls chained on the builder which `field` returns,
+//! compact and pretty (`{:#?}`, nested through the pad adapter), without fields, and with a field
+//! whose
+//! `Debug` fails (the failure is the result, the text written before it stays, the later fields
+//! and the closing brace are not written). FmtDebugStruct/Checks.lean compares the model with the
+//! native results asserted in the native test module.
+use std::fmt::{self, Write as _};
+
+#[derive(Debug)]
+pub struct Storage {
+    pub values: Vec<u32>,
+    pub label: String,
+}
+
+pub struct Slot {
+    pub storage: Option<Storage>,
+}
+
+pub struct Metadata {
+    pub storage: Option<Box<Slot>>,
+}
+
+impl Metadata {
+    fn content(&self) -> Option<&Storage> {
+        self.storage.as_ref()?.storage.as_ref()
+    }
+}
+
+/// chelis-deep `annotations.rs`: the annotation content only.
+impl fmt::Debug for Metadata {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("Metadata")
+            .field("storage", &self.content())
+            .finish()
+    }
+}
+
+/// Two chained fields, the second one a `Metadata` (nested builders).
+pub struct Pair {
+    pub left: i32,
+    pub right: Metadata,
+}
+
+impl fmt::Debug for Pair {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("Pair").field("left", &self.left).field("right", &self.right).finish()
+    }
+}
+
+pub struct Empty;
+
+impl fmt::Debug for Empty {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("Empty").finish()
+    }
+}
+
+/// A value whose `Debug` writes a prefix, then fails.
+pub struct Failing;
+
+impl fmt::Debug for Failing {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.write_str("bad")?;
+        Err(fmt::Error)
+    }
+}
+
+pub struct WithFailing {
+    pub first: u8,
+}
+
+impl fmt::Debug for WithFailing {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("W")
+            .field("first", &self.first)
+            .field("bad", &Failing)
+            .field("last", &3u8)
+            .finish()
+    }
+}
+
+pub fn metadata(values: Vec<u32>, label: String, slot: bool, content: bool) -> Metadata {
+    Metadata {
+        storage: if slot {
+            Some(Box::new(Slot {
+                storage: if content { Some(Storage { values, label }) } else { None },
+            }))
+        } else {
+            None
+        },
+    }
+}
+
+pub fn render(m: &Metadata) -> String {
+    format!("{m:?}")
+}
+
+pub fn render_pretty(m: &Metadata) -> String {
+    format!("{m:#?}")
+}
+
+pub fn render_pair(p: &Pair, pretty: bool) -> String {
+    if pretty { format!("{p:#?}") } else { format!("{p:?}") }
+}
+
+pub fn render_empty(pretty: bool) -> String {
+    if pretty { format!("{:#?}", Empty) } else { format!("{:?}", Empty) }
+}
+
+/// The status of `write!` and the text written into a caller's string.
+pub fn try_render(out: &mut String, w: &WithFailing, pretty: bool) -> bool {
+    if pretty { write!(out, "<{w:#?}>").is_ok() } else { write!(out, "<{w:?}>").is_ok() }
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn debug_struct() {
+        let full = metadata(vec![1, 2], "x".to_string(), true, true);
+        assert_eq!(render(&full), "Metadata { storage: Some(Storage { values: [1, 2], label: \"x\" }) }");
+        assert_eq!(render(&metadata(vec![], String::new(), true, false)), "Metadata { storage: None }");
+        assert_eq!(render(&metadata(vec![], String::new(), false, true)), "Metadata { storage: None }");
+        assert_eq!(
+            render_pretty(&full),
+            "Metadata {\n    storage: Some(\n        Storage {\n            values: [\n                1,\n                2,\n            ],\n            label: \"x\",\n        },\n    ),\n}"
+        );
+        let pair = Pair { left: -7, right: metadata(vec![3], "y".to_string(), true, true) };
+        assert_eq!(
+            render_pair(&pair, false),
+            "Pair { left: -7, right: Metadata { storage: Some(Storage { values: [3], label: \"y\" }) } }"
+        );
+        assert_eq!(
+            render_pair(&pair, true),
+            "Pair {\n    left: -7,\n    right: Metadata {\n        storage: Some(\n            Storage {\n                values: [\n                    3,\n                ],\n                label: \"y\",\n            },\n        ),\n    },\n}"
+        );
+        assert_eq!(render_empty(false), "Empty");
+        assert_eq!(render_empty(true), "Empty");
+        let mut out = String::from("pre");
+        assert!(!try_render(&mut out, &WithFailing { first: 9 }, false));
+        assert_eq!(out, "pre<W { first: 9, bad: bad");
+        let mut out = String::new();
+        assert!(!try_render(&mut out, &WithFailing { first: 0 }, true));
+        assert_eq!(out, "<W {\n    first: 0,\n    bad: bad");
+    }
+}
