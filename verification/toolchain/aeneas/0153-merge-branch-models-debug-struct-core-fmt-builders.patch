+/-- `core::fmt::builders::DebugStruct<'a, 'b> { fmt: &'a mut Formatter<'b>, result: fmt::Result,
+    has_fields: bool }` (core/src/fmt/builders.rs, rustc 1.95): the borrowed formatter is held by
+    value, and `Formatter::debug_struct`'s lens gives it back from the final builder. -/
+@[rust_type "core::fmt::builders::DebugStruct" (mutRegions := #[0]) (body := .opaque)]
+structure DebugStruct where
+  fmt : Formatter
+  result : core.result.Result Unit Error
+  has_fields : Bool
+
+/-- `Formatter::debug_struct` = `builders::debug_struct_new(self, name)`:
+    `let result = fmt.write_str(name); DebugStruct { fmt, result, has_fields: false }`. -/
+@[rust_fun "core::fmt::{core::fmt::Formatter<'a>}::debug_struct"]
+def Formatter.debug_struct (fmt : Formatter) (name : Str) :
+    Result (DebugStruct × (DebugStruct → Formatter)) := do
+  let (result, fmt) ← fmt.write_str name
+  .ok ({ fmt, result, has_fields := false }, fun b => b.fmt)
+
+/-- `DebugStruct::field(name, value)` = `field_with(name, |f| value.fmt(f))`: unless the result is
+    already an error, `" { "` (the first field) or `", "`, the name, `": "` and the value; pretty
+    (`{:#?}`), `" {\n"` before the first field, then the name, `": "`, the value and `",\n"` through
+    a pad adapter (each line indented by four more spaces). The result is the first error; the
+    builder has fields from then on. The returned `&mut Self` is the builder itself: the value
+    given back to it is the value given back to `self` (`fun b => b`), and the staged backward
+    function of the lifetime `'a` (the formatter's borrow) passes the builder given back through
+    `self` (first stage) and the one given back through the returned reference (last stage) on as
+    the values of `self` for the caller of `self` and for the lender of `'a` (`fun s b => (s, b)`,
+    the whole builder being the state of `'a`). -/
+@[rust_fun "core::fmt::builders::{core::fmt::builders::DebugStruct<'a, 'b>}::field"]
+def DebugStruct.field (self : DebugStruct) (name : Str) (value : DebugValue) :
+    Result (DebugStruct × (DebugStruct → DebugStruct) ×
+      (DebugStruct → DebugStruct → DebugStruct × DebugStruct)) := do
+  let (result, fmt) ← match self.result with
+    | .Err e => .ok (.Err e, self.fmt)
+    | .Ok () =>
+      if self.fmt.options.bit 23 then
+        thenFormat (if self.has_fields then .ok (.Ok (), self.fmt) else self.fmt.append " {\n")
+          (fun f => f.indented (self.fmt.indent + 4) (fun f =>
+            thenFormat (f.write_str name) (fun f =>
+              thenFormat (f.append ": ") (fun f =>
+                thenFormat (debugValue value f) (fun f => f.append ",\n")))))
+      else
+        thenFormat (self.fmt.append (if self.has_fields then ", " else " { ")) (fun f =>
+          thenFormat (f.write_str name) (fun f =>
+            thenFormat (f.append ": ") (debugValue value)))
+  .ok ({ fmt, result, has_fields := true }, fun b => b, fun s b => (s, b))
+
+/-- `DebugStruct::finish`: with fields and no error, `"}"` (pretty) or `" }"`; the result, the
+    builder given back to `self`, and the backward function of `'a` (the builder is the state of
+    `'a`: what is given back through `'a` is given back unchanged). -/
+@[rust_fun "core::fmt::builders::{core::fmt::builders::DebugStruct<'a, 'b>}::finish"]
+def DebugStruct.finish (self : DebugStruct) :
+    Result (core.result.Result Unit Error × DebugStruct × (DebugStruct → DebugStruct)) := do
+  if self.has_fields then
+    match self.result with
+    | .Err e => .ok (.Err e, self, fun b => b)
+    | .Ok () =>
+      let (result, fmt) ← self.fmt.append (if self.fmt.options.bit 23 then "}" else " }")
+      .ok (result, { self with fmt, result }, fun b => b)
+  else .ok (self.result, self, fun b => b)
+
