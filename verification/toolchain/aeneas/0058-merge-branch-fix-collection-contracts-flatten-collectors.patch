diff --git a/backends/lean/Aeneas/Std/IteratorSources.lean b/backends/lean/Aeneas/Std/IteratorSources.lean
index 1654138..38336b9 100644
--- a/backends/lean/Aeneas/Std/IteratorSources.lean
+++ b/backends/lean/Aeneas/Std/IteratorSources.lean
@@ -417,4 +417,53 @@ def core.iter.traits.iterator.IteratorOptionIter (A : Type) :
   fused := true
 }
 
+/-- `option::IntoIter<A> { inner: Item<A> }` with `Item<A> { opt: Option<A> }`
+    (core/src/option.rs). Like `option::Iter`, its `Iterator` impl defines only
+    `next` (`self.inner.next()`, i.e. `opt.take()`) and the exact `size_hint`
+    `(len, Some(len))`; it is `TrustedLen`, `FusedIterator` and flatten's
+    `OneShot`, and not `TrustedRandomAccess`. -/
+@[rust_type "core::option::IntoIter" (body := .opaque)]
+structure core.option.IntoIter (A : Type) where
+  opt : Option A
+
+/-- `IntoIterator for Option<T>`: `IntoIter { inner: Item { opt: self } }`. The
+    source is moved into the iterator; recovery returns the remaining option. -/
+@[rust_fun
+  "core::option::{core::iter::traits::collect::IntoIterator<core::option::Option<@T>, @T, core::option::IntoIter<@T>>}::into_iter"]
+def core.option.IntoIteratorOption.into_iter {T : Type} (self : Option T) :
+    Result (core.option.IntoIter T × (core.option.IntoIter T → Option T)) :=
+  ok (⟨self⟩, fun it => it.opt)
+
+@[rust_fun
+  "core::option::{core::iter::traits::iterator::Iterator<core::option::IntoIter<@A>, @A>}::next"]
+def core.option.IteratorIntoIter.next {A : Type} (self : core.option.IntoIter A) :
+  Result (Option A × core.option.IntoIter A) :=
+  ok (self.opt, ⟨none⟩)
+
+@[rust_fun
+  "core::option::{core::iter::traits::iterator::Iterator<core::option::IntoIter<@A>, @A>}::size_hint"]
+def core.option.IteratorIntoIter.size_hint {A : Type} (self : core.option.IntoIter A) :
+  Result (Usize × Option Usize) :=
+  let len := if self.opt.isSome then 1#usize else 0#usize
+  ok (len, some len)
+
+@[reducible, rust_trait_impl
+  "core::iter::traits::iterator::Iterator<core::option::IntoIter<@A>, @A>"]
+def core.iter.traits.iterator.IteratorOptionIntoIter (A : Type) :
+  core.iter.traits.iterator.Iterator (core.option.IntoIter A) A := {
+  next := core.option.IteratorIntoIter.next
+  size_hint := core.option.IteratorIntoIter.size_hint
+  trusted_len := true
+  one_shot := true
+  fused := true
+}
+
+@[reducible, rust_trait_impl
+  "core::iter::traits::collect::IntoIterator<core::option::Option<@T>, @T, core::option::IntoIter<@T>>"]
+def core.iter.traits.collect.IntoIteratorOption (T : Type) :
+  core.iter.traits.collect.IntoIterator (Option T) T (core.option.IntoIter T) := {
+  iteratorInst := core.iter.traits.iterator.IteratorOptionIntoIter T
+  into_iter := core.option.IntoIteratorOption.into_iter
+}
+
 end Aeneas.Std
