+#guard nats (flatten_groups (sl [])) == some []
+#guard nats (flatten_owned (vec [uv [], uv [1], uv [2, 3]])) == some [1, 2, 3]
+#guard nats (flatten_options (vec [some (u 1), none, some (u 3)])) == some [1, 3]
+#guard nats (flatten_arrays (vec [arr2 1 2, arr2 3 4])) == some [1, 2, 3, 4]
+#guard (match count_groups (sl [uv [1, 2], uv [], uv [3]]) with | ok n => some n.val | _ => none)
