+++ b/backends/lean/Aeneas/Std/FlatMap.lean
@@ -380,4 +380,200 @@ def core.iter.traits.iterator.IteratorFlatMap
   fused := iterInst.fused
 }
 
+/-! `Flatten<I> { inner: FlattenCompat<I, <I::Item as IntoIterator>::IntoIter> }`
+    and `FlatMap<I, U, F> { inner: FlattenCompat<Map<I, F>, U::IntoIter> }`
+    (core flatten.rs, rustc 1.95) delegate every method to the same
+    FlattenCompat, whose outer is `Fuse<I>` for Flatten and `Fuse<Map<I, F>>` for
+    FlatMap. FlattenCompat calls on its outer only `next`, `size_hint`, `fold`,
+    `try_fold` and, in the OneShot `advance_by(0)`, `advance_by`, which neither
+    `Fuse` nor `Map` overrides (the inherited `advance_by(0)` returns at once);
+    `Map` forwards `next`, `size_hint`, `fold` and `try_fold` to `I` with `f`
+    applied to each item, and is `FusedIterator` exactly when `I` is. So
+    `Flatten<I>` is observationally `FlatMap<I, I::Item, id>`: the model runs
+    the FlatMap model (general and OneShot/ConstSizeIntoIterator
+    specializations, including its `size_hint`) with an identity mapper whose
+    state is `Unit`. Neither model has `next_back`, so `backiter` stays `None`
+    and a `rev` of either is not modeled. -/
+
+-- Charon lifts Flatten's parameters as I, I::Item, <I::Item as IntoIterator>::Item,
+-- and the inner IntoIter. Only I and IntoIter occur in this representation.
+structure core.iter.adapters.flatten.Flatten (I IntoIter : Type) where
+  iter : I
+  outerDone : Bool
+  inner : Option IntoIter
+  innerActive : Bool
+
+def core.iter.adapters.flatten.Flatten.recombine {I IntoIter : Type}
+    (mergeI : I → I → I)
+    (original current : core.iter.adapters.flatten.Flatten I IntoIter) :
+    core.iter.adapters.flatten.Flatten I IntoIter :=
+  { original with iter := mergeI original.iter current.iter }
+
+attribute [rust_type "core::iter::adapters::flatten::Flatten"
+  (keepParams := [true, false, false, true]) (body := .opaque)
+  (stateMerge := some ("Aeneas.Std.core.iter.adapters.flatten.Flatten.recombine", [0]))]
+  core.iter.adapters.flatten.Flatten
+
+namespace core.iter.adapters.flatten.Flatten
+
+def toFlatMap {I IntoIter : Type} (self : core.iter.adapters.flatten.Flatten I IntoIter) :
+    core.iter.adapters.flatten.FlatMap I Unit IntoIter :=
+  ⟨self.iter, (), self.outerDone, self.inner, self.innerActive⟩
+
+def ofFlatMap {I IntoIter : Type} (self : core.iter.adapters.flatten.FlatMap I Unit IntoIter) :
+    core.iter.adapters.flatten.Flatten I IntoIter :=
+  ⟨self.iter, self.outerDone, self.inner, self.innerActive⟩
+
+/-- The mapper of `Map<I, id>`: returns its argument, no state. -/
+def identity (T : Type) : core.ops.function.FnMut Unit T T := {
+  FnOnceInst := { call_once := fun _ item => ok (item, ()) }
+  call_mut := fun _ item => ok (item, ())
+}
+
+end core.iter.adapters.flatten.Flatten
+
+-- Lifted Rust parameters: Self, Self::Item, and the item and iterator of its
+-- IntoIterator. The outer iterator is restored from the adapter's final state.
+@[rust_fun "core::iter::traits::iterator::Iterator::flatten"]
+def core.iter.traits.iterator.Iterator.flatten.default
+  {Self OuterItem Item IntoIter : Type}
+  (_iterInst : core.iter.traits.iterator.Iterator Self OuterItem)
+  (_intoInst : core.iter.traits.collect.IntoIterator OuterItem Item IntoIter)
+  (self : Self) :
+  Result (core.iter.adapters.flatten.Flatten Self IntoIter ×
+    (core.iter.adapters.flatten.Flatten Self IntoIter → Self)) :=
+  ok (⟨self, false, none, false⟩, (·.iter))
+
+@[rust_fun
+  "core::iter::adapters::flatten::{core::iter::traits::iterator::Iterator<core::iter::adapters::flatten::Flatten<@I, @Clause0_Item, @Clause2_Item, @U>, @Clause2_Item>}::next"]
+def core.iter.adapters.flatten.IteratorFlatten.next
+  {I U OuterItem Item : Type}
+  (iterInst : core.iter.traits.iterator.Iterator I OuterItem)
+  (intoInst : core.iter.traits.collect.IntoIterator OuterItem Item U)
+  (_innerInst : core.iter.traits.iterator.Iterator U Item)
+  (self : core.iter.adapters.flatten.Flatten I U) :
+  Result (Option Item × core.iter.adapters.flatten.Flatten I U) := do
+  let (item, self) ← core.iter.adapters.flatten.IteratorFlatMap.next iterInst intoInst
+    (core.iter.adapters.flatten.Flatten.identity OuterItem) self.toFlatMap
+  ok (item, core.iter.adapters.flatten.Flatten.ofFlatMap self)
+
+@[rust_fun
+  "core::iter::adapters::flatten::{core::iter::traits::iterator::Iterator<core::iter::adapters::flatten::Flatten<@I, @Clause0_Item, @Clause2_Item, @U>, @Clause2_Item>}::size_hint"]
+def core.iter.adapters.flatten.IteratorFlatten.size_hint
+  {I U OuterItem Item : Type}
+  (iterInst : core.iter.traits.iterator.Iterator I OuterItem)
+  (intoInst : core.iter.traits.collect.IntoIterator OuterItem Item U)
+  (_innerInst : core.iter.traits.iterator.Iterator U Item)
+  (self : core.iter.adapters.flatten.Flatten I U) :
+  Result (Usize × Option Usize) :=
+  core.iter.adapters.flatten.IteratorFlatMap.size_hint iterInst intoInst
+    (core.iter.adapters.flatten.Flatten.identity OuterItem) self.toFlatMap
+
+@[rust_fun
+  "core::iter::adapters::flatten::{core::iter::traits::iterator::Iterator<core::iter::adapters::flatten::Flatten<@I, @Clause0_Item, @Clause2_Item, @U>, @Clause2_Item>}::fold"]
+def core.iter.adapters.flatten.IteratorFlatten.fold
+  {I U B G OuterItem Item : Type}
+  (iterInst : core.iter.traits.iterator.Iterator I OuterItem)
+  (intoInst : core.iter.traits.collect.IntoIterator OuterItem Item U)
+  (_innerInst : core.iter.traits.iterator.Iterator U Item)
+  (foldInst : core.ops.function.FnMut G (B × Item) B)
+  (self : core.iter.adapters.flatten.Flatten I U) (init : B) (g : G) :
+  Result (B × core.iter.adapters.flatten.Flatten I U × G) := do
+  let (acc, self, g) ← core.iter.adapters.flatten.IteratorFlatMap.fold iterInst intoInst
+    (core.iter.adapters.flatten.Flatten.identity OuterItem) foldInst self.toFlatMap init g
+  ok (acc, core.iter.adapters.flatten.Flatten.ofFlatMap self, g)
+
+@[rust_fun
+  "core::iter::adapters::flatten::{core::iter::traits::iterator::Iterator<core::iter::adapters::flatten::Flatten<@I, @Clause0_Item, @Clause2_Item, @U>, @Clause2_Item>}::try_fold"]
+def core.iter.adapters.flatten.IteratorFlatten.try_fold
+  {I U B G R OuterItem Item Residual : Type}
+  (iterInst : core.iter.traits.iterator.Iterator I OuterItem)
+  (intoInst : core.iter.traits.collect.IntoIterator OuterItem Item U)
+  (_innerInst : core.iter.traits.iterator.Iterator U Item)
+  (foldInst : core.ops.function.FnMut G (B × Item) R)
+  (tryInst : core.ops.try_trait.Try R B Residual)
+  (self : core.iter.adapters.flatten.Flatten I U) (init : B) (g : G) :
+  Result (R × core.iter.adapters.flatten.Flatten I U × G) := do
+  let (result, self, g) ← core.iter.adapters.flatten.IteratorFlatMap.try_fold iterInst
+    intoInst (core.iter.adapters.flatten.Flatten.identity OuterItem) foldInst tryInst
+    self.toFlatMap init g
+  ok (result, core.iter.adapters.flatten.Flatten.ofFlatMap self, g)
+
+@[rust_fun
+  "core::iter::adapters::flatten::{core::iter::traits::iterator::Iterator<core::iter::adapters::flatten::Flatten<@I, @Clause0_Item, @Clause2_Item, @U>, @Clause2_Item>}::count"]
+def core.iter.adapters.flatten.IteratorFlatten.count
+  {I U OuterItem Item : Type}
+  (iterInst : core.iter.traits.iterator.Iterator I OuterItem)
+  (intoInst : core.iter.traits.collect.IntoIterator OuterItem Item U)
+  (_innerInst : core.iter.traits.iterator.Iterator U Item)
+  (self : core.iter.adapters.flatten.Flatten I U) :
+  Result (Usize × core.iter.adapters.flatten.Flatten I U) := do
+  let (count, self) ← core.iter.adapters.flatten.IteratorFlatMap.count iterInst intoInst
+    (core.iter.adapters.flatten.Flatten.identity OuterItem) self.toFlatMap
+  ok (count, core.iter.adapters.flatten.Flatten.ofFlatMap self)
+
+@[rust_fun
+  "core::iter::adapters::flatten::{core::iter::traits::iterator::Iterator<core::iter::adapters::flatten::Flatten<@I, @Clause0_Item, @Clause2_Item, @U>, @Clause2_Item>}::advance_by"]
+def core.iter.adapters.flatten.IteratorFlatten.advance_by
+  {I U OuterItem Item : Type}
+  (iterInst : core.iter.traits.iterator.Iterator I OuterItem)
+  (intoInst : core.iter.traits.collect.IntoIterator OuterItem Item U)
+  (_innerInst : core.iter.traits.iterator.Iterator U Item)
+  (self : core.iter.adapters.flatten.Flatten I U) (n : Usize) :
+  Result (core.result.Result Unit (core.num.nonzero.NonZero Usize) ×
+    core.iter.adapters.flatten.Flatten I U) := do
+  let (result, self) ← core.iter.adapters.flatten.IteratorFlatMap.advance_by iterInst intoInst
+    (core.iter.adapters.flatten.Flatten.identity OuterItem) self.toFlatMap n
+  ok (result, core.iter.adapters.flatten.Flatten.ofFlatMap self)
+
+@[rust_fun
+  "core::iter::adapters::flatten::{core::iter::traits::iterator::Iterator<core::iter::adapters::flatten::Flatten<@I, @Clause0_Item, @Clause2_Item, @U>, @Clause2_Item>}::nth"]
+def core.iter.adapters.flatten.IteratorFlatten.nth
+  {I U OuterItem Item : Type}
+  (iterInst : core.iter.traits.iterator.Iterator I OuterItem)
+  (intoInst : core.iter.traits.collect.IntoIterator OuterItem Item U)
+  (innerInst : core.iter.traits.iterator.Iterator U Item)
+  (self : core.iter.adapters.flatten.Flatten I U) (n : Usize) :
+  Result (Option Item × core.iter.adapters.flatten.Flatten I U) := do
+  let (result, self) ←
+    core.iter.adapters.flatten.IteratorFlatten.advance_by iterInst intoInst innerInst self n
+  match result with
+  | .Err _ => ok (none, self)
+  | .Ok _ => core.iter.adapters.flatten.IteratorFlatten.next iterInst intoInst innerInst self
+
+@[rust_fun
+  "core::iter::adapters::flatten::{core::iter::traits::iterator::Iterator<core::iter::adapters::flatten::Flatten<@I, @Clause0_Item, @Clause2_Item, @U>, @Clause2_Item>}::any"]
+def core.iter.adapters.flatten.IteratorFlatten.any
+  {I U G OuterItem Item : Type}
+  (iterInst : core.iter.traits.iterator.Iterator I OuterItem)
+  (intoInst : core.iter.traits.collect.IntoIterator OuterItem Item U)
+  (innerInst : core.iter.traits.iterator.Iterator U Item)
+  (predInst : core.ops.function.FnMut G Item Bool)
+  (self : core.iter.adapters.flatten.Flatten I U) (predicate : G) :
+  Result (Bool × core.iter.adapters.flatten.Flatten I U × G) :=
