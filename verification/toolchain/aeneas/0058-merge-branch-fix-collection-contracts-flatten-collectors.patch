+  (intoInst : core.iter.traits.collect.IntoIterator OuterItem Item U)
+  (innerInst : core.iter.traits.iterator.Iterator U Item) :
+  core.iter.traits.iterator.Iterator (core.iter.adapters.flatten.Flatten I U) Item := {
+  next := core.iter.adapters.flatten.IteratorFlatten.next iterInst intoInst innerInst
+  advance_by := core.iter.adapters.flatten.IteratorFlatten.advance_by iterInst intoInst innerInst
+  nth := core.iter.adapters.flatten.IteratorFlatten.nth iterInst intoInst innerInst
+  fold := core.iter.adapters.flatten.IteratorFlatten.fold iterInst intoInst innerInst
+  try_fold := core.iter.adapters.flatten.IteratorFlatten.try_fold iterInst intoInst innerInst
+  count := core.iter.adapters.flatten.IteratorFlatten.count iterInst intoInst innerInst
+  any := core.iter.adapters.flatten.IteratorFlatten.any iterInst intoInst innerInst
