index 0000000..e62efd7
--- /dev/null
+++ b/tests/src/collect-flatten.rs
@@ -0,0 +1,151 @@
+//@ [!lean] skip
+//@ [lean] subdir=CollectFlatten
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::iter::adapters::map::Map --include core::iter::adapters::copied::Copied
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Collectors over Flatten (admitted by CollectionContracts) and the std
+//! size_hint of Flatten: front inner, fused outer, constant-size inner
+//! (arrays) and one-shot inner (Option) specializations.
+//! CollectFlatten/Checks.lean compares the model with the native results
+//! asserted in the native test module.
+use std::collections::{BTreeMap, BTreeSet};
+
+/// chelis-ir ownership/last_use.rs: `Copied<Flatten<option::IntoIter<&BTreeSet>>>`
+/// extending a Vec.
+pub fn extend_successors(
+    pending: &mut Vec<u32>,
+    successors: &BTreeMap<u32, BTreeSet<u32>>,
+    point: u32,
+) {
+    pending.extend(successors.get(&point).into_iter().flatten().copied());
+}
+
+pub fn extend_optional(pending: &mut Vec<u32>, group: Option<&Vec<u32>>) {
+    pending.extend(group.into_iter().flatten().copied());
+}
+
+pub fn flatten_groups(groups: &[Vec<u32>]) -> Vec<u32> {
+    groups.iter().flatten().copied().collect()
+}
+
+pub fn flatten_owned(groups: Vec<Vec<u32>>) -> Vec<u32> {
+    groups.into_iter().flatten().collect()
+}
+
+/// Option inners are OneShot: next pulls one item from each inner directly.
+pub fn flatten_options(items: Vec<Option<u32>>) -> Vec<u32> {
+    items.into_iter().flatten().collect()
+}
+
+/// Array inners have a constant size (ConstSizeIntoIterator).
+pub fn flatten_arrays(items: Vec<[u32; 2]>) -> Vec<u32> {
+    items.into_iter().flatten().collect()
+}
+
+pub type Hint = (usize, Option<usize>);
+
+/// Hints before the first next, after it, and after the second.
+pub fn hints_groups(groups: &[Vec<u32>]) -> (Hint, Hint, Hint) {
+    let mut iter = groups.iter().flatten();
+    let first = iter.size_hint();
+    let _ = iter.next();
+    let second = iter.size_hint();
+    let _ = iter.next();
+    (first, second, iter.size_hint())
+}
+
+pub fn hints_optional(group: Option<&Vec<u32>>) -> (Hint, Hint, Hint) {
+    let mut iter = group.into_iter().flatten();
+    let first = iter.size_hint();
+    let _ = iter.next();
+    let second = iter.size_hint();
+    let _ = iter.next();
+    (first, second, iter.size_hint())
+}
+
+pub fn hints_options(items: Vec<Option<u32>>) -> (Hint, Hint, Hint) {
+    let mut iter = items.into_iter().flatten();
+    let first = iter.size_hint();
+    let _ = iter.next();
+    let second = iter.size_hint();
+    let _ = iter.next();
+    (first, second, iter.size_hint())
+}
+
+pub fn hints_arrays(items: Vec<[u32; 2]>) -> (Hint, Hint, Hint) {
+    let mut iter = items.into_iter().flatten();
+    let first = iter.size_hint();
+    let _ = iter.next();
+    let second = iter.size_hint();
+    let _ = iter.next();
+    (first, second, iter.size_hint())
+}
+
+pub fn count_groups(groups: &[Vec<u32>]) -> usize {
+    groups.iter().flatten().count()
+}
+
+pub fn sum_groups(groups: &[Vec<u32>]) -> u32 {
+    groups.iter().flatten().fold(0, |acc, x| acc + *x)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    fn map(entries: &[(u32, &[u32])]) -> BTreeMap<u32, BTreeSet<u32>> {
+        entries.iter().map(|(k, vs)| (*k, vs.iter().copied().collect())).collect()
+    }
+
+    #[test]
+    fn collectors() {
+        let successors = map(&[(1, &[3, 2]), (2, &[])]);
+        let mut pending = vec![9];
+        extend_successors(&mut pending, &successors, 1);
+        assert_eq!(pending, vec![9, 2, 3]);
+        extend_successors(&mut pending, &successors, 2);
+        assert_eq!(pending, vec![9, 2, 3]);
+        extend_successors(&mut pending, &successors, 7);
+        assert_eq!(pending, vec![9, 2, 3]);
+        let mut pending = vec![];
+        extend_optional(&mut pending, Some(&vec![4, 5]));
+        assert_eq!(pending, vec![4, 5]);
+        extend_optional(&mut pending, None);
+        assert_eq!(pending, vec![4, 5]);
+        assert_eq!(flatten_groups(&[vec![1, 2], vec![], vec![3]]), vec![1, 2, 3]);
+        assert_eq!(flatten_groups(&[]), Vec::<u32>::new());
+        assert_eq!(flatten_owned(vec![vec![], vec![1], vec![2, 3]]), vec![1, 2, 3]);
+        assert_eq!(flatten_options(vec![Some(1), None, Some(3)]), vec![1, 3]);
+        assert_eq!(flatten_arrays(vec![[1, 2], [3, 4]]), vec![1, 2, 3, 4]);
+        assert_eq!(count_groups(&[vec![1, 2], vec![], vec![3]]), 3);
+        assert_eq!(sum_groups(&[vec![1, 2], vec![], vec![3]]), 6);
+    }
+
+    #[test]
+    fn hints() {
+        // General inner: no upper bound while the outer may yield more inners.
+        assert_eq!(
+            hints_groups(&[vec![1, 2, 3]]),
+            ((0, None), (2, Some(2)), (1, Some(1)))
+        );
+        assert_eq!(
+            hints_groups(&[vec![1, 2], vec![3]]),
+            ((0, None), (1, None), (0, None))
+        );
+        assert_eq!(hints_groups(&[]), ((0, Some(0)), (0, Some(0)), (0, Some(0))));
+        assert_eq!(
+            hints_optional(Some(&vec![1, 2])),
+            ((0, None), (1, Some(1)), (0, Some(0)))
+        );
+        assert_eq!(hints_optional(None), ((0, Some(0)), (0, Some(0)), (0, Some(0))));
+        // OneShot inner: (0, outer upper).
+        assert_eq!(
+            hints_options(vec![Some(1), None, Some(3)]),
+            ((0, Some(3)), (0, Some(2)), (0, Some(0)))
+        );
+        // Constant-size inner: exact.
+        assert_eq!(
+            hints_arrays(vec![[1, 2], [3, 4], [5, 6]]),
+            ((6, Some(6)), (5, Some(5)), (4, Some(4)))
+        );
+    }
+}
