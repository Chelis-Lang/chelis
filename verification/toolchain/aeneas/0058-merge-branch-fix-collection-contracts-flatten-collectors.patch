index 3d7183a..4d3a290 100644
--- a/tests/lean/CollectUserIteratorHint/Checks.lean
+++ b/tests/lean/CollectUserIteratorHint/Checks.lean
@@ -39,3 +39,26 @@ theorem successors_size_hint_total :
       simp [Successors.Insts.CoreIterTraitsIteratorIterator.size_hint,
         core.option.Option.is_some, lift, hz]⟩
 end collect_user_iterator_hint.checks
+
+/-! The obligations file names each proposition by the full name of its Prop
+    declaration, as `Name.toString` prints it (the acceptance closure audit
+    compares them verbatim): exactly the `size_hint_total` declarations of the
+    generated module. -/
+open Lean Elab Command in
+#eval show CommandElabM Unit from do
+  let dir := (System.FilePath.mk (← getFileName)).parent.getD "."
+  let json ← IO.ofExcept (Json.parse (← IO.FS.readFile (dir / "obligations.json")))
+  let entries ← IO.ofExcept (json.getObjValAs? (Array Json) "obligations")
+  let listed ← entries.mapM fun entry => IO.ofExcept (entry.getObjValAs? String "proposition")
+  let env ← getEnv
+  let declared := env.constants.fold (init := (#[] : Array String)) fun acc n info =>
+    match n with
+    | .str _ "size_hint_total" =>
+      if (`collect_user_iterator_hint).isPrefixOf n && info.type == .sort .zero then
+        acc.push n.toString
+      else acc
+    | _ => acc
+  let listed := listed.qsort (· < ·)
+  let declared := declared.qsort (· < ·)
+  unless listed == declared && listed.size == 2 do
+    throwError "obligation names {listed} differ from the Prop declarations {declared}"
