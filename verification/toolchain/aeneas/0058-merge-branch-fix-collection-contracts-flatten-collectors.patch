+#guard hints (hints_groups (sl [uv [1, 2, 3]])) == some ((0, none), (2, some 2), (1, some 1))
+#guard hints (hints_groups (sl [uv [1, 2], uv [3]])) == some ((0, none), (1, none), (0, none))
+#guard hints (hints_groups (sl [])) == some ((0, some 0), (0, some 0), (0, some 0))
