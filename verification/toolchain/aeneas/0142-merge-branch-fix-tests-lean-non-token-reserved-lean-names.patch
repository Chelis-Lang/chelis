+    the values given back by `record`, `PreparedDropout::theory` and
+    `Theory::override` (the callers read the updated fields after the calls). -/
+
+namespace lean_reserved_names.checks
+open Aeneas Aeneas.Std Result
+open lean_reserved_names (PreparedDropout)
+
+def u (x : Nat) : U32 := ⟨BitVec.ofNat _ x⟩
