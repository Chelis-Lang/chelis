+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn fields() {
+        let d = prepare(1);
+        assert_eq!(digest(&d), 3034827181);
+        assert_eq!(parameters(&d), 11);
+        let mut d = prepare(10);
+        assert_eq!(record(&mut d, 0x0f), 10);
+        assert_eq!((d.parameters, d.r#const, d.BuiltinFn), (0x0f, 30, 28));
+        assert_eq!(digest(&d), 1007958329);
+        assert_eq!(record_then_bump(&mut d, 3), 0x0f);
+        assert_eq!((d.parameters, d.r#const, d.prelude), (3, 33, 1019));
+        assert_eq!(d.simp(), 27);
+        assert_eq!(d.theory(0x40), 18);
+        assert_eq!((d.theory, d.reduce), (0x40, 27));
+    }
+
+    #[test]
+    fn functions() {
+        assert_eq!(constant, 5);
+        assert_eq!(simp(3), 8);
+        assert_eq!(r#const(3), 16);
+        assert_eq!(theory(3), 31);
+        assert_eq!(prelude(3), 30);
+        assert_eq!(universes(3), 15);
+        assert_eq!(using_well_founded(4), 18);
+        assert_eq!(reduce(4), true);
+        assert_eq!(reserve(4), false);
+        assert_eq!(r#override(3), 21);
+        assert_eq!(r#override(4), 4);
+        assert_eq!(begin(3), 22);
+        assert_eq!(axioms(3), 278);
+        assert_eq!(definition(3), 278);
+        assert_eq!(toStr(3), 280);
+        assert_eq!(Pi(3), 840);
+        assert_eq!(parameter(3), 861);
+        assert_eq!(constants(3), 930);
+        assert_eq!(precedence(3), 933);
+        assert_eq!(replacing(3), 233);
+        assert_eq!(opaque_defs(3), 234);
+    }
+
+    #[test]
+    fn types() {
+        assert_eq!(use_fn_items(&BuiltinFnOnce { raw: 4 }, 3), (15, 0x56, 9));
+        let r = mk_raw(4);
+        assert_eq!((r.prelude, r.Pi), (4, 5));
+        assert_eq!(reserved(&Reserved::parameters), 0);
+        assert_eq!(reserved(&Reserved::record(3)), 8);
+        assert_eq!(reserved(&Reserved::simp { raw: 3 }), 4);
+        assert_eq!(reserved(&Reserved::r#const), 2);
+        assert_eq!(reserved(&Reserved::Pi(3)), 9);
+        assert_eq!(reserved(&Reserved::BuiltinFn), 4);
+        assert_eq!(reserved(&Reserved::toStr { prelude: 3 }), 13);
+        assert_eq!(reserved(&mk_reserved(7)), 0);
+        assert_eq!(reserved(&mk_reserved(8)), 13);
+        assert_eq!(reserved(&mk_reserved(9)), 10);
+        assert_eq!(reserved(&mk_reserved(10)), 2);
+        assert_eq!(reserved(&mk_reserved(11)), 33);
+        assert_eq!(reserved(&mk_reserved(12)), 4);
+        assert_eq!(reserved(&mk_reserved(13)), 23);
+        let mut d = prepare(1);
+        assert_eq!(use_theory(&mut d, 3), (1, 15, 21, 15));
+        assert_eq!(d.r#override, 3);
+        assert_eq!(use_constant::<PreparedDropout>(4), 8);
+        assert_eq!(<PreparedDropout as Theory>::constant(4).constant, 14);
+    }
+}
