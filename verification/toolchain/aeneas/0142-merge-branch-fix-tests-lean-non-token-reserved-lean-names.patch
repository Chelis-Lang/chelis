diff --git a/tests/src/lean-reserved-names.rs b/tests/src/lean-reserved-names.rs
new file mode 100644
index 0000000..0f96739
--- /dev/null
+++ b/tests/src/lean-reserved-names.rs
@@ -0,0 +1,429 @@
+//@ [!lean] skip
+//@ [lean] subdir=LeanReservedNames
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Declarations named like the names which the generated Lean variables do
+//! not take but which are not Lean tokens (`parameters`, `record`, `raw`,
+//! `simp`, `const`, `constant`, `theory`, `prelude`, `BuiltinFn`, ...):
+//! structure fields (as chelis-types' `PreparedDropout::parameters`),
+//! functions, a global, types, enumeration variants, inherent and trait
+//! methods (as chelis-types' `ActivationElement::constant`), and locals. They
+//! parse as plain identifiers, so they are neither escaped nor reserved for
+//! declarations: registering them as keywords made every such field or trait
+//! method a name clash. `BuiltinFn` and `BuiltinFnMut` are user functions passed as
+//! `Fn`/`FnMut` arguments and `BuiltinFnOnce` a user type, while the model
+//! refers to Aeneas' builtin instances of the same names.
+//! `LeanReservedNames/Checks.lean` evaluates the model on the inputs of the
+//! `native` test module and compares with the native results, including the
+//! values given back through `&mut`.
+#![allow(non_snake_case, non_camel_case_types, non_upper_case_globals)]
+
+pub const constant: u32 = 5;
+
+pub struct PreparedDropout {
+    pub parameters: u32,
+    pub parameter: u32,
+    pub record: u32,
+    pub raw: u32,
+    pub simp: u32,
+    pub r#const: u32,
+    pub constant: u32,
+    pub constants: u32,
+    pub theory: u32,
+    pub prelude: u32,
+    pub universes: u32,
+    pub using_well_founded: u32,
+    pub reduce: u32,
+    pub reserve: u32,
+    pub r#override: u32,
+    pub begin: u32,
+    pub axioms: u32,
+    pub definition: u32,
+    pub toStr: u32,
+    pub Pi: u32,
+    pub BuiltinFn: u32,
+    pub BuiltinFnMut: u32,
+    pub BuiltinFnOnce: u32,
+    pub precedence: u32,
+    pub replacing: u32,
+    pub opaque_defs: u32,
+}
+
+/// Every field gets a distinct value: `seed + i` for the i-th field.
+pub fn prepare(seed: u32) -> PreparedDropout {
+    PreparedDropout {
+        parameters: seed,
+        parameter: seed.wrapping_add(1),
+        record: seed.wrapping_add(2),
+        raw: seed.wrapping_add(3),
+        simp: seed.wrapping_add(4),
+        r#const: seed.wrapping_add(5),
+        constant: seed.wrapping_add(6),
+        constants: seed.wrapping_add(7),
+        theory: seed.wrapping_add(8),
+        prelude: seed.wrapping_add(9),
+        universes: seed.wrapping_add(10),
+        using_well_founded: seed.wrapping_add(11),
+        reduce: seed.wrapping_add(12),
+        reserve: seed.wrapping_add(13),
+        r#override: seed.wrapping_add(14),
+        begin: seed.wrapping_add(15),
+        axioms: seed.wrapping_add(16),
+        definition: seed.wrapping_add(17),
+        toStr: seed.wrapping_add(18),
+        Pi: seed.wrapping_add(19),
+        BuiltinFn: seed.wrapping_add(20),
+        BuiltinFnMut: seed.wrapping_add(21),
+        BuiltinFnOnce: seed.wrapping_add(22),
+        precedence: seed.wrapping_add(23),
+        replacing: seed.wrapping_add(24),
+        opaque_defs: seed.wrapping_add(25),
+    }
+}
+
+/// Reads every field, each with its own weight.
+pub fn digest(d: &PreparedDropout) -> u32 {
+    let fields = [
+        d.parameters,
+        d.parameter,
+        d.record,
+        d.raw,
+        d.simp,
+        d.r#const,
+        d.constant,
+        d.constants,
+        d.theory,
+        d.prelude,
+        d.universes,
+        d.using_well_founded,
+        d.reduce,
+        d.reserve,
+        d.r#override,
+        d.begin,
+        d.axioms,
+        d.definition,
+        d.toStr,
+        d.Pi,
+        d.BuiltinFn,
+        d.BuiltinFnMut,
+        d.BuiltinFnOnce,
+        d.precedence,
+        d.replacing,
+        d.opaque_defs,
+    ];
+    let mut acc = 0u32;
+    let mut i = 0;
+    while i < 26 {
+        acc = acc.wrapping_mul(31).wrapping_add(fields[i]);
+        i += 1;
+    }
+    acc
+}
+
+/// Locals named after the reserved names.
+pub fn parameters(d: &PreparedDropout) -> u32 {
+    let parameters = d.parameters;
+    let record = d.record;
+    let simp = d.simp;
+    parameters.wrapping_mul(3).wrapping_add(record).wrapping_add(simp)
+}
+
+/// Writes through `d`: the caller sees the updated fields.
+pub fn record(d: &mut PreparedDropout, v: u32) -> u32 {
+    let old = d.parameters;
+    d.parameters = v;
+    d.r#const = d.r#const.wrapping_add(v);
+    d.BuiltinFn = d.toStr;
+    old
+}
+
+/// The caller writes through the value `record` gives back.
+pub fn record_then_bump(d: &mut PreparedDropout, v: u32) -> u32 {
+    let old = record(d, v);
+    d.prelude += 1000;
+    old
+}
+
+pub fn simp(x: u32) -> u32 {
+    x.wrapping_add(constant)
+}
+
+pub fn r#const(x: u32) -> u32 {
+    simp(x).wrapping_mul(2)
+}
+
+pub fn theory(x: u32) -> u32 {
+    r#const(x) ^ 0x0f
+}
+
+pub fn prelude(x: u32) -> u32 {
+    theory(x).wrapping_sub(1)
+}
+
+pub fn universes(x: u32) -> u32 {
+    prelude(x) >> 1
+}
+
+pub fn using_well_founded(n: u32) -> u32 {
+    let mut acc = 0u32;
+    let mut i = 0;
+    while i < n {
+        acc = acc.wrapping_add(universes(i));
+        i += 1;
+    }
+    acc
+}
+
+/// `reduce` and `reserve` are mutually recursive.
+pub fn reduce(n: u32) -> bool {
+    if n == 0 { true } else { reserve(n - 1) }
+}
+
+pub fn reserve(n: u32) -> bool {
+    if n == 0 { false } else { reduce(n - 1) }
+}
+
+pub fn r#override(x: u32) -> u32 {
+    if reduce(x) { x } else { x.wrapping_mul(7) }
+}
+
+pub fn begin(x: u32) -> u32 {
+    r#override(x).wrapping_add(1)
+}
+
+pub fn axioms(x: u32) -> u32 {
+    begin(x) | 0x100
+}
+
+pub fn definition(x: u32) -> u32 {
+    axioms(x) & 0x1ff
+}
+
+pub fn toStr(x: u32) -> u32 {
+    definition(x).wrapping_add(2)
+}
+
+pub fn Pi(x: u32) -> u32 {
+    toStr(x).wrapping_mul(3)
+}
+
+pub fn parameter(x: u32) -> u32 {
+    Pi(x).wrapping_add(parameters(&prepare(x)))
+}
+
+pub fn constants(x: u32) -> u32 {
+    parameter(x) ^ 0xff
+}
+
+pub fn precedence(x: u32) -> u32 {
+    constants(x).wrapping_add(3)
+}
+
+pub fn replacing(x: u32) -> u32 {
+    precedence(x) >> 2
+}
+
+pub fn opaque_defs(x: u32) -> u32 {
+    replacing(x).wrapping_add(1)
+}
+
+/// User functions named like Aeneas' builtin instances of `Fn`/`FnMut`,
+/// passed to generic functions (the model uses those builtin instances).
+pub fn BuiltinFn(x: u32) -> u32 {
+    x.wrapping_mul(5)
+}
+
+pub fn BuiltinFnMut(x: u32) -> u32 {
+    x ^ 0x55
+}
+
+/// A user type named like Aeneas' builtin instance of `FnOnce`.
+pub struct BuiltinFnOnce {
+    pub raw: u32,
+}
+
+pub fn apply<F: Fn(u32) -> u32>(f: F, x: u32) -> u32 {
+    f(x)
+}
+
+pub fn apply_mut<F: FnMut(u32) -> u32>(mut f: F, x: u32) -> u32 {
+    f(x)
+}
+
+pub fn apply_once<F: FnOnce(u32) -> u32>(f: F, x: u32) -> u32 {
+    f(x)
+}
+
+pub fn use_fn_items(o: &BuiltinFnOnce, x: u32) -> (u32, u32, u32) {
+    (apply(BuiltinFn, x), apply_mut(BuiltinFnMut, x), apply_once(simp, o.raw))
+}
+
+/// A type named like a reserved name, with reserved field names.
+pub struct raw {
+    pub prelude: u32,
+    pub Pi: u32,
+}
+
+pub fn mk_raw(x: u32) -> raw {
+    raw { prelude: x, Pi: x.wrapping_add(1) }
+}
+
+pub enum Reserved {
+    parameters,
+    record(u32),
+    simp { raw: u32 },
+    r#const,
+    Pi(u32),
+    BuiltinFn,
+    toStr { prelude: u32 },
+}
+
+pub fn reserved(r: &Reserved) -> u32 {
+    match r {
+        Reserved::parameters => 0,
+        Reserved::record(n) => simp(*n),
+        Reserved::simp { raw } => *raw + 1,
+        Reserved::r#const => 2,
+        Reserved::Pi(n) => n.wrapping_mul(3),
+        Reserved::BuiltinFn => 4,
+        Reserved::toStr { prelude } => prelude.wrapping_add(10),
+    }
+}
+
+pub fn mk_reserved(n: u32) -> Reserved {
+    match n % 7 {
+        0 => Reserved::parameters,
+        1 => Reserved::record(n),
+        2 => Reserved::simp { raw: n },
+        3 => Reserved::r#const,
+        4 => Reserved::Pi(n),
+        5 => Reserved::BuiltinFn,
+        _ => Reserved::toStr { prelude: n },
+    }
+}
+
+impl PreparedDropout {
+    /// An inherent method named like a field.
+    pub fn simp(&self) -> u32 {
+        self.simp.wrapping_add(self.raw)
+    }
+
+    /// Writes through `self`.
+    pub fn theory(&mut self, v: u32) -> u32 {
+        let old = self.theory;
+        self.theory = v;
+        self.reduce = self.simp();
+        old
+    }
+}
+
+pub trait Theory {
+    fn parameters(&self) -> u32;
+    fn simp(&self, x: u32) -> u32;
+    fn BuiltinFn(&self) -> u32;
+    fn r#override(&mut self, v: u32) -> u32;
+    /// A method without `self` (as chelis-types' `ActivationElement::constant`).
+    fn constant(value: u32) -> Self;
+}
+
+impl Theory for PreparedDropout {
+    fn parameters(&self) -> u32 {
+        self.parameters
+    }
+    fn simp(&self, x: u32) -> u32 {
+        self.simp.wrapping_mul(x)
+    }
+    fn BuiltinFn(&self) -> u32 {
+        self.BuiltinFn
+    }
+    /// Writes through `self`.
+    fn r#override(&mut self, v: u32) -> u32 {
+        let old = self.r#override;
+        self.r#override = v;
+        old
+    }
+    fn constant(value: u32) -> Self {
+        prepare(value.wrapping_mul(2))
+    }
+}
+
+pub fn use_theory<T: Theory>(t: &mut T, x: u32) -> (u32, u32, u32, u32) {
+    let old = t.r#override(x);
+    (t.parameters(), t.simp(x), t.BuiltinFn(), old)
+}
+
+pub fn use_constant<T: Theory>(x: u32) -> u32 {
+    T::constant(x).parameters()
+}
