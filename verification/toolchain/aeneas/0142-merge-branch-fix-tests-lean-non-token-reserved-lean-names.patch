+#guard (prep 10 (fun d => get (lean_reserved_names.record d (u 0x0f)) >>= fun (_, d) =>
+    get (lean_reserved_names.digest d))).map (·.val) == some 1007958329
+-- `record_then_bump` writes through the value `record` gives back
+#guard (prep 10 (fun d => get (lean_reserved_names.record d (u 0x0f)) >>= fun (_, d) =>
+    get (lean_reserved_names.record_then_bump d (u 3)))).map
+    (fun (o, (d : PreparedDropout)) => (o.val, d.parameters.val, d.const.val, d.prelude.val))
+  == some (0x0f, 3, 33, 1019)
+#guard (prep 10 (fun d => get (lean_reserved_names.record d (u 0x0f)) >>= fun (_, d) =>
+    get (lean_reserved_names.record_then_bump d (u 3)) >>= fun (_, d) =>
+    get (lean_reserved_names.PreparedDropout.impl.simp d))).map (·.val) == some 27
+-- `PreparedDropout::theory` returns the old `theory` and gives back the updated value
+#guard (prep 10 (fun d => get (lean_reserved_names.record d (u 0x0f)) >>= fun (_, d) =>
+    get (lean_reserved_names.record_then_bump d (u 3)) >>= fun (_, d) =>
+    get (lean_reserved_names.PreparedDropout.impl.theory d (u 0x40)))).map
+    (fun (o, (d : PreparedDropout)) => (o.val, d.theory.val, d.reduce.val))
