+
+-- native `fields`
+#guard (prep 1 (fun d => get (lean_reserved_names.digest d))).map (·.val) == some 3034827181
+#guard (prep 1 (fun d => get (lean_reserved_names.parameters d))).map (·.val) == some 11
+-- `record` returns the old `parameters` and gives back the updated value
+#guard (prep 10 (fun d => get (lean_reserved_names.record d (u 0x0f)))).map
+    (fun (o, (d : PreparedDropout)) => (o.val, d.parameters.val, d.const.val, d.BuiltinFn.val))
