+#guard n (lean_reserved_names.reserved (.Pi (u 3))) == some 9
+#guard n (lean_reserved_names.reserved .BuiltinFn) == some 4
+#guard n (lean_reserved_names.reserved (.toStr (u 3))) == some 13
