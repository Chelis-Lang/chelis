+import NestedBorrowsSameRegion.NestedBorrowsSameRegion
+
+/-! Evaluate the model of `tests/src/nested-borrows-same-region.rs` on the
+    inputs of its `native` test module and compare with the native results: the
+    returned values and the final value of the lender of the inner borrow (the
+    first component of the value given back for the outer borrow). -/
+
+namespace nested_borrows_same_region.checks
+open Aeneas Aeneas.Std Result
+
+def u (x : Nat) : U32 := ⟨BitVec.ofNat _ x⟩
+
+def max := 4294967295
+
+/-- `run_j`: the two returned values and the final value of `a` -/
+def jRun (a b : Nat) : Option (Nat × Nat × Nat) :=
+  match j (u a, u b) with
+  | ok ((r0, r1), (a', _)) => some (r0.val, r1.val, a'.val)
+  | _ => none
+
+/-- `run_m`: the returned value and the final value of `a` -/
+def mRun (a : Nat) : Option (Nat × Nat) :=
+  match m (u a) with
+  | ok (x, a') => some (x.val, a'.val)
+  | _ => none
+
+/-- `run_call_k`: the returned value and the final value of `a` -/
+def callKRun (a b : Nat) : Option (Nat × Nat) :=
+  match call_k (u a, u b) with
+  | ok (r, (a', _)) => some (r.val, a'.val)
+  | _ => none
+
+/-- `run_call_k_then`: the returned values and the final value of `a` -/
+def callKThenRun (a b : Nat) : Option (Nat × Nat × Nat) :=
+  match call_k_then (u a, u b) with
+  | ok ((r, t1), (a', _)) => some (r.val, t1.val, a'.val)
+  | _ => none
+
+#guard jRun 1 2 == some (3, 3, 3)
+#guard jRun max 2 == some (1, 3, 1)
+#guard jRun 7 max == some (6, 0, 6)
+
+#guard mRun 0 == some (1, 1)
+#guard mRun max == some (0, 0)
+
+#guard callKRun 1 2 == some (3, 3)
+#guard callKRun max 3 == some (2, 2)
+
+#guard callKThenRun 1 2 == some (3, 5, 3)
+#guard callKThenRun max 3 == some (2, 5, 2)
+
+end nested_borrows_same_region.checks
