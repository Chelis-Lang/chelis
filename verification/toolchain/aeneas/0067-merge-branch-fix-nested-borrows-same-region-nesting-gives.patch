+//@ [!lean] skip
+//@ [lean] subdir=NestedBorrowsSameRegion
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Same-region nesting: a mutable borrow of a region group whose borrowed
+//! value holds mutable borrows of the same group, e.g.
+//! `&'a mut (&'a mut u32, u32)`. The backward function gives back the borrowed
+//! value as a whole, the inner borrows as the values they hold when the region
+//! ends: their region ends with the outer borrow, so nothing is given back to
+//! them.
+
+pub fn j<'a>(s: &'a mut (&'a mut u32, u32)) -> (u32, u32) {
+    *s.0 = s.0.wrapping_add(s.1);
+    s.1 = s.1.wrapping_add(1);
+    (*s.0, s.1)
+}
+pub fn m<'a>(s: &'a mut &'a mut u32) -> u32 {
+    **s = s.wrapping_add(1);
+    **s
+}
+pub fn k<'a, 'b>(s: &'a mut (&'b mut u32, u32)) -> u32 {
+    *s.0 = s.0.wrapping_add(s.1);
+    *s.0
+}
+pub fn call_k<'a>(s: &'a mut (&'a mut u32, u32)) -> u32 {
+    k(s)
+}
+pub fn call_k_then<'a>(s: &'a mut (&'a mut u32, u32)) -> (u32, u32) {
+    let r = k(s);
+    s.1 = s.1.wrapping_add(r);
+    (r, s.1)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    fn run_j(a: u32, b: u32) -> (u32, u32, u32) {
+        let mut a = a;
+        let mut t = (&mut a, b);
+        let (r0, r1) = j(&mut t);
+        (r0, r1, a)
+    }
+    fn run_m(a: u32) -> (u32, u32) {
+        let mut a = a;
+        let mut r = &mut a;
+        let x = m(&mut r);
+        (x, a)
+    }
+    fn run_call_k(a: u32, b: u32) -> (u32, u32) {
+        let mut a = a;
+        let mut t = (&mut a, b);
+        let r = call_k(&mut t);
+        (r, a)
+    }
+    fn run_call_k_then(a: u32, b: u32) -> (u32, u32, u32) {
+        let mut a = a;
+        let mut t = (&mut a, b);
+        let (r, t1) = call_k_then(&mut t);
+        (r, t1, a)
+    }
+
+    #[test]
+    fn j_native() {
+        assert_eq!(run_j(1, 2), (3, 3, 3));
+        assert_eq!(run_j(u32::MAX, 2), (1, 3, 1));
+        assert_eq!(run_j(7, u32::MAX), (6, 0, 6));
+    }
+
+    #[test]
+    fn m_native() {
+        assert_eq!(run_m(0), (1, 1));
+        assert_eq!(run_m(u32::MAX), (0, 0));
+    }
+
+    #[test]
+    fn call_k_native() {
+        assert_eq!(run_call_k(1, 2), (3, 3));
+        assert_eq!(run_call_k(u32::MAX, 3), (2, 2));
+    }
+
+    #[test]
+    fn call_k_then_native() {
+        assert_eq!(run_call_k_then(1, 2), (3, 5, 3));
+        assert_eq!(run_call_k_then(u32::MAX, 3), (2, 5, 2));
+    }
+}
