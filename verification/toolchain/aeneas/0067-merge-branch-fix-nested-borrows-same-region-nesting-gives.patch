+(** The value held by the mutable borrow [bid] in a value, if it holds it. *)
+let find_mut_borrow_content (bid : V.BorrowId.id) (v : V.tvalue) :
+    V.tvalue option =
+  let found = ref None in
+  let visitor =
+    object
+      inherit [_] V.iter_tvalue as super
+
+      method! visit_VMutBorrow env bid' child =
+        if bid' = bid then found := Some child;
+        super#visit_VMutBorrow env bid' child
+    end
+  in
+  visitor#visit_tvalue () v;
+  !found
