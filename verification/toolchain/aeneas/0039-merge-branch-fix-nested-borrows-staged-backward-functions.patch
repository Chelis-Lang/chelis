+import NestedBorrowsFourLevels.NestedBorrowsFourLevels
+
+/-! Evaluate the model of `tests/src/nested-borrows-four-levels.rs` on the
+    inputs of its `native` test module and compare with the native results. -/
+
+namespace nested_borrows_four_levels.checks
+open Aeneas Aeneas.Std Result
+
+def u (x : Nat) : U32 := ⟨BitVec.ofNat _ x⟩
+
+def val {α β} (f : α → β) : Result α → Option β
+  | ok x => some (f x)
+  | _ => none
+
+def once (v : Nat) := val (·.val) (incr4_once (u v))
+def swap (v w : Nat) :=
+  val (fun (p : U32 × U32) => (p.1.val, p.2.val)) (incr4_swap (u v) (u w))
+
+#guard once 0 == some 1
+#guard once 41 == some 42
+#guard once 4294967295 == some 0
+#guard once 7 == some 8
+
+#guard swap 0 0 == some (0, 1)
+#guard swap 5 41 == some (5, 42)
+#guard swap 3 4294967295 == some (3, 0)
+
+end nested_borrows_four_levels.checks
