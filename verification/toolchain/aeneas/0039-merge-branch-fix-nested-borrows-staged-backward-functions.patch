+//@ [!lean] skip
+//@ [lean] subdir=NestedBorrowsFourLevels
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Four levels of nested mutable borrows: the region group of the innermost
+//! borrow of `incr4` is nested under three ignored mutable borrows, so that its
+//! backward function has four stages (see `Pure.back_sg_info.early`).
+
+pub fn incr4<'a, 'b, 'c, 'd>(x: &'a mut &'b mut &'c mut &'d mut u32) {
+    ****x = (****x).wrapping_add(1);
+}
+
+pub fn incr4_once(v: u32) -> u32 {
+    let mut v = v;
+    {
+        let mut r1 = &mut v;
+        let mut r2 = &mut r1;
+        let mut r3 = &mut r2;
+        incr4(&mut r3);
+    }
+    v
+}
+
+/// The same chain, whose innermost borrow is replaced before the call.
+pub fn incr4_swap(v: u32, w: u32) -> (u32, u32) {
+    let mut v = v;
+    let mut w = w;
+    {
+        let mut r1 = &mut v;
+        let mut r2 = &mut r1;
+        let mut r3 = &mut r2;
+        **r3 = &mut w;
+        incr4(&mut r3);
+    }
+    (v, w)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn incr4_once_native() {
+        assert_eq!(incr4_once(0), 1);
+        assert_eq!(incr4_once(41), 42);
+        assert_eq!(incr4_once(u32::MAX), 0);
+        assert_eq!(incr4_once(7), 8);
+    }
+
+    #[test]
+    fn incr4_swap_native() {
+        assert_eq!(incr4_swap(0, 0), (0, 1));
+        assert_eq!(incr4_swap(5, 41), (5, 42));
+        assert_eq!(incr4_swap(3, u32::MAX), (3, 0));
+    }
+}
