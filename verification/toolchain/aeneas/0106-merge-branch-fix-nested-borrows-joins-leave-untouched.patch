+(** Nested borrows: the level-1 outputs of a function-call abstraction held
+    inside the arguments of its continuation.
+
+    When an ancestor region of the call ends, the value it gives back for a
+    borrow projector of the call's output holds inner borrows of the region of
+    the abstraction: the loan projector of that output in the abstraction then
+    records them as [borrows] (see {!InterpBorrows.end_proj_loans_symbolic}).
+    The abstraction owns these borrows: they are outputs of its backward
+    function at level 1 (e.g., [Option::as_deref_mut] gives back, for the frame
+    given back through the returned reference, the inner borrows the caller
+    lent to it: [⌊s@40, borrows=[(s@46)]⌋]), while the loan projector itself is
+    an input at level 0. The value given back to a returned reference of a
+    call whose backward function is staged (an ended ignored mutable loan of
+    its output, see {!normalize_abs_for_join}) holds such outputs as well. We
+    return the symbolic values of these borrows, as the level-0 arguments of
+    the continuation hold them (the borrows under a shared borrow are not given
+    back: their loan projectors are ignored there). *)
+let abs_call_level_output_svs (abs : abs) : SymbolicValueId.Set.t =
+  match abs.cont with
+  | Some { input = Some { value = EApp (EFunCall _, (_ :: _ as args)); _ }; _ }
+    ->
+      let staged = List.length args >= 2 in
+      let svs = ref SymbolicValueId.Set.empty in
+      let visitor =
+        object (self)
+          inherit [_] iter_tevalue as super
+
+          method! visit_ESymbolic given_back pm proj =
+            (match proj with
+            | EProjLoans { borrows; _ } ->
+                List.iter
+                  (fun (_, (borrow : eproj)) ->
+                    match borrow with
+                    | EProjBorrows { proj; _ } ->
+                        svs := SymbolicValueId.Set.add proj.sv_id !svs
+                    | _ -> ())
+                  borrows
+            | EProjBorrows { proj; _ } when given_back ->
+                svs := SymbolicValueId.Set.add proj.sv_id !svs
+            | _ -> ());
+            super#visit_ESymbolic given_back pm proj
+
+          method! visit_EEndedIgnoredMutLoan given_back loan =
+            if staged then (
+              self#visit_tevalue given_back loan.child;
+              self#visit_tevalue true loan.given_back)
+            else super#visit_EEndedIgnoredMutLoan given_back loan
+        end
+      in
+      (* The arguments of level 0 come last (see [split_call_cont_level_outputs]) *)
+      List.iter
+        (visitor#visit_tevalue false)
+        (List.nth args (List.length args - 1));
+      !svs
+  | _ -> SymbolicValueId.Set.empty
+
