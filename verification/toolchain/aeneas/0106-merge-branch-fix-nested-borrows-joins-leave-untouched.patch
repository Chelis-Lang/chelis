+//! Loops over `Option::as_deref_mut` of the loop state
+//! `execution: Option<&'1 mut Frame<'2>>`, the reborrow given to a call, then
+//! a match with three arms or more (`matches!(x, A | B)`) at each iteration
+//! (the shape of `chelis_ir::eval`'s node loop). The collapse of the join of
+//! the first two arms normalizes the abstractions of the call which consumed
+//! the reborrow (untouched by the match); they must stay fixed when the third
+//! arm is joined.
+
+pub struct Frame<'a> {
+    pub steps: &'a [u32],
+    pub ctx: &'a mut u32,
+    pub pos: usize,
+}
+
+impl<'a> Frame<'a> {
+    pub fn advance(&mut self) -> u32 {
+        let s = self.steps[self.pos];
+        self.pos += 1;
+        *self.ctx = (*self.ctx).wrapping_add(s);
+        s
+    }
+}
+
+pub fn advance_or(execution: Option<&mut Frame<'_>>, d: u32) -> u32 {
+    match execution {
+        Some(f) => f.advance(),
+        None => d,
+    }
+}
+
+/// `matches!` with two patterns, then `continue` on one side.
+pub fn loop_matches_continue(mut execution: Option<&mut Frame<'_>>, n: u32) -> u32 {
+    let mut acc = 0u32;
+    let mut i = 0;
+    while i < n {
+        acc = acc.wrapping_add(advance_or(execution.as_deref_mut(), i));
+        if !matches!(i % 3, 0 | 1) {
+            i += 1;
+            continue;
+        }
+        acc = acc.wrapping_add(1);
+        i += 1;
+    }
+    acc
+}
+
+/// A match with three arms into a boolean, then an `if`.
+pub fn loop_match_arms(mut execution: Option<&mut Frame<'_>>, n: u32) -> u32 {
+    let mut acc = 0u32;
+    let mut i = 0;
+    while i < n {
+        acc = acc.wrapping_add(advance_or(execution.as_deref_mut(), i));
+        let b = match i % 3 {
+            0 | 1 => true,
+            _ => false,
+        };
+        if b {
+            acc = acc.wrapping_add(1);
+        }
+        i += 1;
+    }
+    acc
+}
+
+pub fn run_loop_matches_continue(f: &mut Frame<'_>, n: u32) -> u32 {
+    loop_matches_continue(Some(f), n)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    const STEPS: [u32; 5] = [3, 5, 7, 11, 13];
+
+    /// `run(Some(&mut frame), n)`: the result, the frame's `ctx` and `pos`
+    fn on_some(run: fn(Option<&mut Frame<'_>>, u32) -> u32, ctx: u32, pos: usize, n: u32) -> (u32, u32, usize) {
+        let mut c = ctx;
+        let mut f = Frame { steps: &STEPS, ctx: &mut c, pos };
+        let r = run(Some(&mut f), n);
+        let pos = f.pos;
+        (r, c, pos)
+    }
+
+    /// `run(Some(&mut frame), n)`, then the caller writes `ctx + w` through
+    /// the frame given back
+    fn on_some_write(run: fn(Option<&mut Frame<'_>>, u32) -> u32, ctx: u32, pos: usize, n: u32, w: u32) -> (u32, u32, usize) {
+        let mut c = ctx;
+        let mut f = Frame { steps: &STEPS, ctx: &mut c, pos };
+        let r = run(Some(&mut f), n);
+        *f.ctx = f.ctx.wrapping_add(w);
+        let pos = f.pos;
+        (r, c, pos)
+    }
+
+    /// `run(&mut frame, n)`, then the caller writes `ctx + w` through the frame
+    fn on_frame_write(run: fn(&mut Frame<'_>, u32) -> u32, ctx: u32, pos: usize, n: u32, w: u32) -> (u32, u32, usize) {
+        let mut c = ctx;
+        let mut f = Frame { steps: &STEPS, ctx: &mut c, pos };
+        let r = run(&mut f, n);
+        *f.ctx = f.ctx.wrapping_add(w);
+        let pos = f.pos;
+        (r, c, pos)
+    }
+
+    #[test]
+    fn loop_matches_continue_native() {
+        assert_eq!(on_some(loop_matches_continue, 10, 0, 0), (0, 10, 0));
+        assert_eq!(on_some(loop_matches_continue, 10, 0, 3), (17, 25, 3));
+        assert_eq!(on_some(loop_matches_continue, 10, 1, 4), (39, 46, 5));
+        assert_eq!(on_some(loop_matches_continue, u32::MAX - 4, 0, 2), (10, 3, 2));
+        assert_eq!(loop_matches_continue(None, 4), 9);
+    }
+
+    #[test]
+    fn loop_match_arms_native() {
+        assert_eq!(on_some(loop_match_arms, 10, 0, 0), (0, 10, 0));
+        assert_eq!(on_some(loop_match_arms, 10, 0, 3), (17, 25, 3));
+        assert_eq!(on_some(loop_match_arms, 10, 1, 4), (39, 46, 5));
+        assert_eq!(loop_match_arms(None, 4), 9);
+    }
+
+    #[test]
+    fn loop_matches_continue_write_back_native() {
+        assert_eq!(on_some_write(loop_matches_continue, 10, 0, 0, 100), (0, 110, 0));
+        assert_eq!(on_some_write(loop_matches_continue, 10, 0, 3, 100), (17, 125, 3));
+        assert_eq!(on_some_write(loop_matches_continue, u32::MAX - 4, 0, 2, 7), (10, 10, 2));
+        assert_eq!(on_frame_write(run_loop_matches_continue, 10, 1, 4, 1000), (39, 1046, 5));
+    }
+
+    #[test]
+    fn loop_match_arms_write_back_native() {
+        assert_eq!(on_some_write(loop_match_arms, 10, 0, 3, 100), (17, 125, 3));
+        assert_eq!(on_some_write(loop_match_arms, 10, 1, 4, u32::MAX), (39, 45, 5));
+    }
+}
