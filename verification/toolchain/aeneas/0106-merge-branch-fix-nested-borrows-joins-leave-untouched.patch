+-- loop_matches_continue_native
+#guard onSome loop_matches_continue 10 0 0 == some (0, 10, 0)
+#guard onSome loop_matches_continue 10 0 3 == some (17, 25, 3)
+#guard onSome loop_matches_continue 10 1 4 == some (39, 46, 5)
+#guard onSome loop_matches_continue (max - 4) 0 2 == some (10, 3, 2)
+#guard onNone loop_matches_continue 4 == some (9, true)
+
+-- loop_match_arms_native
+#guard onSome loop_match_arms 10 0 0 == some (0, 10, 0)
+#guard onSome loop_match_arms 10 0 3 == some (17, 25, 3)
+#guard onSome loop_match_arms 10 1 4 == some (39, 46, 5)
+#guard onNone loop_match_arms 4 == some (9, true)
+
+-- loop_matches_continue_write_back_native
+#guard onSomeWrite loop_matches_continue 10 0 0 100 == some (0, 110, 0)
+#guard onSomeWrite loop_matches_continue 10 0 3 100 == some (17, 125, 3)
+#guard onSomeWrite loop_matches_continue (max - 4) 0 2 7 == some (10, 10, 2)
+#guard onFrameWrite run_loop_matches_continue 10 1 4 1000 == some (39, 1046, 5)
+
+-- loop_match_arms_write_back_native
+#guard onSomeWrite loop_match_arms 10 0 3 100 == some (17, 125, 3)
+#guard onSomeWrite loop_match_arms 10 1 4 max == some (39, 45, 5)
+
+end nested_borrows_loop_match_join.checks
