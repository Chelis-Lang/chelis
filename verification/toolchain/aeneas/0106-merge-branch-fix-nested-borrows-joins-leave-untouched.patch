+        assert_eq!(on_some_write(loop_expect_break, 10, 0, 3, 100), (15, 125, 3));
+        assert_eq!(on_some_write(loop_expect_break, 10, 0, 4, 100), (26, 136, 4));
+        assert_eq!(on_some_write(loop_expect_break, 10, 2, 4, 1000), (18, 1028, 4));
+    }
+
+    /// `run(Some(&mut frame), n)` then the caller writes `ctx + w` through the
+    /// frame given back: the result, the frame's `ctx` and `pos`
+    fn on_some_try(
+        run: fn(Option<&mut Frame<'_>>, u32) -> Result<u32, u32>,
+        ctx: u32,
+        pos: usize,
+        n: u32,
+        w: u32,
+    ) -> (Result<u32, u32>, u32, usize) {
+        let mut c = ctx;
+        let mut f = Frame { steps: &STEPS, ctx: &mut c, pos };
+        let r = run(Some(&mut f), n);
+        *f.ctx = f.ctx.wrapping_add(w);
+        let pos = f.pos;
+        (r, c, pos)
+    }
+
+    #[test]
+    fn loop_expect_try_native() {
+        assert_eq!(on_some_try(loop_expect_try, 10, 0, 0, 0), (Ok(0), 10, 0));
+        assert_eq!(on_some_try(loop_expect_try, 10, 0, 3, 0), (Ok(8), 25, 3));
+        assert_eq!(on_some_try(loop_expect_try, 10, 0, 5, 0), (Ok(19), 36, 4));
+        assert_eq!(on_some_try(loop_expect_try, 10, 0, 6, 0), (Err(36), 36, 4));
+        assert_eq!(on_some_try(loop_expect_try, 10, 3, 2, 0), (Err(21), 21, 4));
+        assert_eq!(loop_expect_try(None, 2), Ok(3));
+        assert!(std::panic::catch_unwind(|| loop_expect_try(None, 3)).is_err());
+        assert_eq!(on_some_try(loop_expect_try, 10, 0, 5, 100), (Ok(19), 136, 4));
+        assert_eq!(on_some_try(loop_expect_try, 10, 0, 6, 1000), (Err(36), 1036, 4));
+    }
 }
