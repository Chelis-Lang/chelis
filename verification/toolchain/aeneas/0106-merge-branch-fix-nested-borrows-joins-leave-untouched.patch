+/-- A `Result<u32, u32>`: whether it is `Ok`, and its value -/
+def res (r : core.result.Result U32 U32) : Bool × Nat :=
+  match r with
+  | .Ok v => (true, v.val)
+  | .Err e => (false, e.val)
+
+/-- `run(Some(&mut frame), n)`; the caller writes `ctx + w` through the frame
+    given back, then gives it back -/
+def onSomeTry (run : Option Frame → U32 → Result (core.result.Result U32 U32 × Option Frame × (Option Frame → Option Frame)))
+    (ctx pos n w : Nat) : Option ((Bool × Nat) × Nat × Nat) :=
+  match run (some (frame ctx pos)) (u n) with
+  | ok (r, some f1, back) =>
+    match back (some { f1 with ctx := u (f1.ctx.val + w) }) with
+    | some f2 => some (res r, f2.ctx.val, f1.pos.val)
+    | none => none
+  | _ => none
+
+/-- `run(None, n)`: the result, and whether `None` is given back -/
+def onNoneTry (run : Option Frame → U32 → Result (core.result.Result U32 U32 × Option Frame × (Option Frame → Option Frame)))
+    (n : Nat) : Option ((Bool × Nat) × Bool) :=
+  match run none (u n) with
+  | ok (r, o, back) => some (res r, o.isNone && (back none).isNone)
+  | _ => none
