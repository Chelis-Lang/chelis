--- /dev/null
+++ b/tests/src/nested-borrows-loop-inner-loop.rs
@@ -0,0 +1,134 @@
+//@ [!lean] skip
+//@ [lean] subdir=NestedBorrowsLoopInnerLoop
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::option::{core::option::Option} --include core::ops::deref::{core::ops::deref::Deref} --include core::ops::deref::{core::ops::deref::DerefMut}
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Loops over `Option::as_deref_mut` of the loop state
+//! `execution: Option<&'1 mut Frame<'2>>`, the reborrow given to a call, then
+//! an inner loop which does not use the frame (the shape of
+//! `chelis_ir::eval`'s node loop over the guard sites of a node). The inner
+//! loop leaves the abstractions of the call and the loop abstraction of the
+//! outer loop unchanged: they stay outside of the inner loop abstraction.
+
+pub struct Frame<'a> {
+    pub steps: &'a [u32],
+    pub ctx: &'a mut u32,
+    pub pos: usize,
+}
+
+impl<'a> Frame<'a> {
+    pub fn advance(&mut self) -> u32 {
+        let s = self.steps[self.pos];
+        self.pos += 1;
+        *self.ctx = (*self.ctx).wrapping_add(s);
+        s
+    }
+}
+
+pub fn advance_or(execution: Option<&mut Frame<'_>>, d: u32) -> u32 {
+    match execution {
+        Some(f) => f.advance(),
+        None => d,
+    }
+}
+
+pub fn try_advance(execution: Option<&mut Frame<'_>>, d: u32) -> Result<u32, u32> {
+    match execution {
+        Some(f) => Ok(f.advance()),
+        None => {
+            if d > 100 {
+                Err(d)
+            } else {
+                Ok(d)
+            }
+        }
+    }
+}
+
+/// An inner loop after the call.
+pub fn loop_inner_loop(mut execution: Option<&mut Frame<'_>>, xs: &[u32], n: u32) -> u32 {
+    let mut acc = 0u32;
+    let mut i = 0;
+    while i < n {
+        let v = advance_or(execution.as_deref_mut(), i);
+        let mut j = 0;
+        while j < xs.len() {
+            acc = acc.wrapping_add(v.wrapping_mul(xs[j]));
+            j += 1;
+        }
+        i += 1;
+    }
+    acc
+}
+
+/// A fallible call, then an inner loop with `matches!` and `continue`.
+pub fn loop_inner_matches(mut execution: Option<&mut Frame<'_>>, xs: &[u32], n: u32) -> Result<u32, u32> {
+    let mut acc = 0u32;
+    let mut i = 0;
+    while i < n {
+        let v = try_advance(execution.as_deref_mut(), i)?;
+        let mut j = 0;
+        while j < xs.len() {
+            if !matches!(xs[j] % 3, 0 | 1) {
+                j += 1;
+                continue;
+            }
+            acc = acc.wrapping_add(v);
+            j += 1;
+        }
+        i += 1;
+    }
+    Ok(acc)
+}
+
+pub fn run_loop_inner_loop(f: &mut Frame<'_>, xs: &[u32], n: u32) -> u32 {
+    loop_inner_loop(Some(f), xs, n)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    const STEPS: [u32; 5] = [3, 5, 7, 11, 13];
+    const XS: [u32; 3] = [1, 2, 5];
+
+    /// `run(Some(&mut frame), xs, n)`: the result, the frame's `ctx` and `pos`;
+    /// the caller writes `ctx + w` through the frame given back
+    fn on_some_write<R>(run: fn(Option<&mut Frame<'_>>, &[u32], u32) -> R, ctx: u32, pos: usize, n: u32, w: u32) -> (R, u32, usize) {
+        let mut c = ctx;
+        let mut f = Frame { steps: &STEPS, ctx: &mut c, pos };
+        let r = run(Some(&mut f), &XS, n);
+        *f.ctx = f.ctx.wrapping_add(w);
+        let pos = f.pos;
+        (r, c, pos)
+    }
+
+    /// `run(&mut frame, xs, n)`, then the caller writes `ctx + w` through the frame
+    fn on_frame_write(run: fn(&mut Frame<'_>, &[u32], u32) -> u32, ctx: u32, pos: usize, n: u32, w: u32) -> (u32, u32, usize) {
+        let mut c = ctx;
+        let mut f = Frame { steps: &STEPS, ctx: &mut c, pos };
+        let r = run(&mut f, &XS, n);
+        *f.ctx = f.ctx.wrapping_add(w);
+        let pos = f.pos;
+        (r, c, pos)
+    }
+
+    #[test]
+    fn loop_inner_loop_native() {
+        assert_eq!(on_some_write(loop_inner_loop, 10, 0, 0, 0), (0, 10, 0));
+        assert_eq!(on_some_write(loop_inner_loop, 10, 0, 3, 0), (120, 25, 3));
+        assert_eq!(on_some_write(loop_inner_loop, 10, 1, 2, 100), (96, 122, 3));
+        assert_eq!(on_some_write(loop_inner_loop, u32::MAX - 4, 0, 2, 7), (64, 10, 2));
+        assert_eq!(loop_inner_loop(None, &XS, 3), 24);
+        assert_eq!(on_frame_write(run_loop_inner_loop, 10, 2, 3, 1000), (248, 1041, 5));
+    }
+
+    #[test]
+    fn loop_inner_matches_native() {
+        assert_eq!(on_some_write(loop_inner_matches, 10, 0, 0, 0), (Ok(0), 10, 0));
+        assert_eq!(on_some_write(loop_inner_matches, 10, 0, 3, 0), (Ok(15), 25, 3));
+        assert_eq!(on_some_write(loop_inner_matches, 10, 1, 2, 100), (Ok(12), 122, 3));
+        assert_eq!(on_some_write(loop_inner_matches, u32::MAX - 4, 2, 3, u32::MAX), (Ok(31), 25, 5));
+        assert_eq!(loop_inner_matches(None, &XS, 3), Ok(3));
+        assert_eq!(loop_inner_matches(None, &XS, 102), Err(101));
+    }
+}
