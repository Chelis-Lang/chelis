+#guard onSomeWrite plain loop_inner_loop 10 0 0 0 == some (.inl 0, 10, 0)
+#guard onSomeWrite plain loop_inner_loop 10 0 3 0 == some (.inl 120, 25, 3)
+#guard onSomeWrite plain loop_inner_loop 10 1 2 100 == some (.inl 96, 122, 3)
+#guard onSomeWrite plain loop_inner_loop (max - 4) 0 2 7 == some (.inl 64, 10, 2)
+#guard onNone plain loop_inner_loop 3 == some (.inl 24, true)
+#guard onFrameWrite run_loop_inner_loop 10 2 3 1000 == some (248, 1041, 5)
+
+-- loop_inner_matches_native
+#guard onSomeWrite res loop_inner_matches 10 0 0 0 == some (.inl 0, 10, 0)
+#guard onSomeWrite res loop_inner_matches 10 0 3 0 == some (.inl 15, 25, 3)
+#guard onSomeWrite res loop_inner_matches 10 1 2 100 == some (.inl 12, 122, 3)
+#guard onSomeWrite res loop_inner_matches (max - 4) 2 3 max == some (.inl 31, 25, 5)
+#guard onNone res loop_inner_matches 3 == some (.inl 3, true)
+#guard onNone res loop_inner_matches 102 == some (.inr 101, true)
+
+end nested_borrows_loop_inner_loop.checks
