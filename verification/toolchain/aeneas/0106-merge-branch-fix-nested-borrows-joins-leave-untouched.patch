+import NestedBorrowsLoopInnerLoop.NestedBorrowsLoopInnerLoop
+
+/-! Evaluate the model of `tests/src/nested-borrows-loop-inner-loop.rs` on the
+    inputs of its `native` test module and compare with the native results
+    `(result, ctx, pos)`: `pos` is the frame given back through the `&mut`
+    (the forward output), `ctx` the value of the frame's region given back by
+    the backward function of that region when the caller writes `ctx + w`
+    through the frame, then gives it back. -/
+
+namespace nested_borrows_loop_inner_loop.checks
+open Aeneas Aeneas.Std Result
+
+def u (x : Nat) : U32 := ⟨BitVec.ofNat _ x⟩
+def us (x : Nat) : Usize := ⟨BitVec.ofNat _ x⟩
+
+def max := 4294967295
+
+def sl (xs : List Nat) (h : xs.length ≤ Usize.max := by scalar_tac) : Slice U32 :=
+  ⟨xs.map u, by simpa using h⟩
+
+def frame (ctx pos : Nat) : Frame := { steps := sl [3, 5, 7, 11, 13], ctx := u ctx, pos := us pos }
+
+def xs : Slice U32 := sl [1, 2, 5]
+
+/-- `run(Some(&mut frame), xs, n)`; the caller writes `ctx + w` through the
+    frame given back, then gives it back -/
+def onSomeWrite {R : Type} (res : R → Option (Nat ⊕ Nat))
+    (run : Option Frame → Slice U32 → U32 → Result (R × Option Frame × (Option Frame → Option Frame)))
+    (ctx pos n w : Nat) : Option ((Nat ⊕ Nat) × Nat × Nat) :=
+  match run (some (frame ctx pos)) xs (u n) with
+  | ok (r, some f1, back) =>
+    match res r, back (some { f1 with ctx := u (f1.ctx.val + w) }) with
+    | some r, some f2 => some (r, f2.ctx.val, f1.pos.val)
+    | _, _ => none
+  | _ => none
+
+/-- `run(None, xs, n)`: the result, and whether `None` is given back -/
+def onNone {R : Type} (res : R → Option (Nat ⊕ Nat))
+    (run : Option Frame → Slice U32 → U32 → Result (R × Option Frame × (Option Frame → Option Frame)))
+    (n : Nat) : Option ((Nat ⊕ Nat) × Bool) :=
+  match run none xs (u n) with
+  | ok (r, o, back) => (res r).map fun r => (r, o.isNone && (back none).isNone)
+  | _ => none
+
+/-- `run(&mut frame, xs, n)`; the caller writes `ctx + w` through the frame,
+    then gives it back -/
+def onFrameWrite (run : Frame → Slice U32 → U32 → Result (U32 × Frame × (Frame → Frame)))
+    (ctx pos n w : Nat) : Option (Nat × Nat × Nat) :=
+  match run (frame ctx pos) xs (u n) with
+  | ok (r, f1, back) => some (r.val, (back { f1 with ctx := u (f1.ctx.val + w) }).ctx.val, f1.pos.val)
+  | _ => none
+
+/-- A plain result is `inl` -/
+def plain (r : U32) : Option (Nat ⊕ Nat) := some (.inl r.val)
+
+/-- `Ok v` is `inl v`, `Err e` is `inr e` -/
+def res (r : core.result.Result U32 U32) : Option (Nat ⊕ Nat) :=
+  match r with
+  | core.result.Result.Ok v => some (.inl v.val)
+  | core.result.Result.Err e => some (.inr e.val)
+
