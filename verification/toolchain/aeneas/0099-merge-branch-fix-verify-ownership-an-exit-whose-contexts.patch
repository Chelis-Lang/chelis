+import LoopExitIterationLoans.LoopExitIterationLoans
+
+/-! Evaluate the model of `tests/src/loop-exit-iteration-loans.rs` on the
+    inputs of its `native` test module and compare with the native results. For
+    `check_ids` and `check_ids_or`, the second component is the vector given
+    back through the `&mut` (the caller then pushes `push` through it, if any,
+    and reads it). -/
+
+namespace loop_exit_iteration_loans.checks
+open Aeneas Aeneas.Std Result
+
+def u (x : Nat) : U32 := ⟨BitVec.ofNat _ x⟩
+
+def U := 4294967295
+
+def vec (xs : List Nat) (h : xs.length ≤ Usize.max := by simp <;> scalar_tac) :
+    alloc.vec.Vec U32 :=
+  ⟨xs.map u, by simpa using h⟩
+
+def sl {α} (xs : List α) (h : xs.length ≤ Usize.max := by simp <;> scalar_tac) : Slice α := ⟨xs, h⟩
+
+/-- A block whose edges have the given ids -/
+def block (ids : List Nat) (h : ids.length ≤ Usize.max := by simp <;> scalar_tac) : Block :=
+  { edges := ⟨ids.map (fun i => { id := u i }), by simpa using h⟩ }
+
+def res (r : Result U32) : Option Nat :=
+  match r with
+  | ok x => some x.val
+  | _ => none
+
+def list (v : alloc.vec.Vec U32) : List Nat := v.val.map (·.val)
+
+/-- `run(&mut seen)`, then the caller pushes `push` (if any) through the
+    reference given back, then reads the vector -/
+def onSeen (run : alloc.vec.Vec U32 → Result (core.result.Result U32 U32 × alloc.vec.Vec U32))
+    (seen : List Nat) (push : Option Nat := none)
+    (h : seen.length ≤ Usize.max := by simp <;> scalar_tac) : Option (Except Nat Nat × List Nat) :=
+  match run (vec seen h) with
+  | ok (r, s1) =>
+    let r := match r with
+      | .Ok x => Except.ok x.val
+      | .Err e => Except.error e.val
+    match push with
+    | none => some (r, list s1)
+    | some v =>
+      match alloc.vec.Vec.push s1 (u v) with
+      | ok s2 => some (r, list s2)
+      | _ => none
+  | _ => none
+
+-- first_hit_native
+#guard res (first_hit (sl []) (u 5)) == some 0
+#guard res (first_hit (sl [vec [1, 2], vec [], vec [3]]) (u 5)) == some 0
+#guard res (first_hit (sl [vec [1, 2], vec [5, 9]]) (u 5)) == some 1
+#guard res (first_hit (sl [vec [1], vec [], vec [4, 7, 5]]) (u 5)) == some 7
+#guard res (first_hit (sl [vec [6]]) (u 5)) == some 6
+
+-- static_native
+#guard res (static_member (u 3)) == some 3
+#guard res (static_member (u 11)) == some 11
+#guard res (static_member (u 5)) == some 0
+#guard res (static_hit (sl [])) == some 0
+#guard res (static_hit (sl [vec [1, 2], vec [], vec [4]])) == some 0
+#guard res (static_hit (sl [vec [1], vec [2, 3, 9]])) == some 1
+#guard res (static_hit (sl [vec [4], vec [], vec [8, 3]])) == some 8
+
+-- check_ids_native
+#guard onSeen (check_ids (sl [])) [] == some (.ok 0, [])
+#guard onSeen (check_ids (sl [block [1, 2], block [], block [3]])) [] == some (.ok 3, [1, 2, 3])
+#guard onSeen (check_ids (sl [block [1], block [2, 1, 3]])) [7] (push := some 8)
+  == some (.error 1, [7, 1, 2, 8])
+#guard onSeen (check_ids (sl [block [1], block [U, 2]])) [] (push := some 8) == some (.error 0, [1, 8])
+#guard onSeen (check_ids (sl [block [1], block [2]])) [2] == some (.error 2, [2, 1])
+#guard onSeen (check_ids (sl [block [5, 6]])) [9] (push := some 4) == some (.ok 2, [9, 5, 6, 4])
+
+-- check_ids_or_native
+#guard onSeen (check_ids_or (sl [])) [] == some (.ok 0, [])
+#guard onSeen (check_ids_or (sl [block [1, 2], block [], block [3]])) [] == some (.ok 3, [1, 2, 3])
+#guard onSeen (check_ids_or (sl [block [1], block [2, 1, 3]])) [7] (push := some 8)
+  == some (.error 1, [7, 1, 2, 8])
+#guard onSeen (check_ids_or (sl [block [1], block [U, 2]])) [] (push := some 8)
+  == some (.error U, [1, 8])
+#guard onSeen (check_ids_or (sl [block [5, 6]])) [9] (push := some 4) == some (.ok 2, [9, 5, 6, 4])
+
+end loop_exit_iteration_loans.checks
