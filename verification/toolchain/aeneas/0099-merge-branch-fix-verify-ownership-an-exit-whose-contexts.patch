+//@ [!lean] skip
+//@ [lean] subdir=LoopExitIterationLoans
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! A loan created by an iteration of an inner loop, still alive at two exits
+//! of that loop, in the shape of chelis-ir's
+//! `ownership::verify::check_operation_ids`. Charon structures the returns out
+//! of the inner loop as breaks of that loop, followed by the code which ends
+//! the borrow after the loops, so both break contexts contain the same loan.
+//! Their join kept that loan as it is, while the evaluation which synthesizes
+//! the loop body creates it with fresh ids: matching the break context with the
+//! context at a break then failed ("Could not match the contexts"). The
+//! contexts at such an exit are now joined over two evaluations of the body.
+//!
+//! The loan is a borrow of a local declared before the loops (`first_hit`,
+//! `static_hit`), or the borrow of the local into which Charon inlines a
+//! promoted constant (`&EdgeId::UNASSIGNED` in `check_ids` and `check_ids_or`).
+//! The shared loans of a static read by the iteration are held by anonymous
+//! values: the exits of `static_member` keep a single evaluation (joining the
+//! contexts of two evaluations fails there: "Markers remain after ownership
+//! reduction"), while `static_hit` combines both kinds of loans.
+//!
+//! LoopExitIterationLoans/Checks.lean compares the model with the native
+//! results asserted in the native test module, including the vector given back
+//! through the `&mut` (`check_ids`, `check_ids_or`), to which the caller then
+//! pushes a value.
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+pub struct EdgeId(pub u32);
+
+impl EdgeId {
+    pub const UNASSIGNED: Self = Self(u32::MAX);
+}
+
+pub struct Edge {
+    pub id: EdgeId,
+}
+
+pub struct Block {
+    pub edges: Vec<Edge>,
+}
+
+/// A borrow of `a`, created by each inner iteration, alive at both returns.
+pub fn first_hit(xss: &[Vec<u32>], key: u32) -> u32 {
+    let mut a: u32;
+    for xs in xss {
+        for y in xs {
+            a = *y;
+            let x = &a;
+            if *x == key {
+                return 1;
+            }
+            if *x > key {
+                return *x;
+            }
+        }
+    }
+    0
+}
+
+static VALUES: &[u32] = &[3, 7, 11];
+
+/// A static read by every iteration, and two exits.
+pub fn static_member(number: u32) -> u32 {
+    let mut index = 0;
+    while index < VALUES.len() {
+        if number == VALUES[index] {
+            return number;
+        }
+        index += 1;
+    }
+    0
+}
+
+/// `first_hit` comparing with a static.
+pub fn static_hit(xss: &[Vec<u32>]) -> u32 {
+    let mut a: u32;
+    for xs in xss {
+        for y in xs {
+            a = *y;
+            let x = &a;
+            if *x == VALUES[0] {
+                return 1;
+            }
+            if *x > VALUES[1] {
+                return *x;
+            }
+        }
+    }
+    0
+}
+
+fn contains(xs: &Vec<u32>, x: u32) -> bool {
+    let mut i = 0;
+    while i < xs.len() {
+        if xs[i] == x {
+            return true;
+        }
+        i += 1;
+    }
+    false
+}
+
+/// `check_operation_ids`: a comparison with a promoted constant, then two
+/// returns; the ids seen are pushed to `seen`, which is given back.
+pub fn check_ids(blocks: &[Block], seen: &mut Vec<u32>) -> Result<u32, u32> {
+    let mut n = 0u32;
+    for block in blocks {
+        for edge in &block.edges {
+            if edge.id == EdgeId::UNASSIGNED {
+                return Err(0);
+            }
+            if contains(seen, edge.id.0) {
+                return Err(edge.id.0);
+            }
+            seen.push(edge.id.0);
+            n = n.wrapping_add(1);
+        }
+    }
+    Ok(n)
+}
+
+/// The same with both conditions in one `||`, and a single return.
+pub fn check_ids_or(blocks: &[Block], seen: &mut Vec<u32>) -> Result<u32, u32> {
+    let mut n = 0u32;
+    for block in blocks {
+        for edge in &block.edges {
+            if edge.id == EdgeId::UNASSIGNED || contains(seen, edge.id.0) {
+                return Err(edge.id.0);
+            }
+            seen.push(edge.id.0);
+            n = n.wrapping_add(1);
+        }
+    }
+    Ok(n)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    const U: u32 = u32::MAX;
+
+    fn blocks(ids: &[&[u32]]) -> Vec<Block> {
+        ids.iter()
+            .map(|b| Block {
+                edges: b.iter().map(|id| Edge { id: EdgeId(*id) }).collect(),
+            })
+            .collect()
+    }
+
+    /// `run(&mut seen)`, then the caller pushes `push` (if any) through the
+    /// reference given back, then reads the vector
+    fn on_seen<R>(
+        seen: &[u32],
+        push: Option<u32>,
+        run: impl FnOnce(&mut Vec<u32>) -> R,
+    ) -> (R, Vec<u32>) {
+        let mut s = seen.to_vec();
+        let r = {
+            let rs = &mut s;
+            let r = run(&mut *rs);
+            if let Some(v) = push {
+                rs.push(v);
+            }
+            r
+        };
+        (r, s)
+    }
+
+    #[test]
+    fn first_hit_native() {
+        assert_eq!(first_hit(&[], 5), 0);
+        assert_eq!(first_hit(&[vec![1, 2], vec![], vec![3]], 5), 0);
+        assert_eq!(first_hit(&[vec![1, 2], vec![5, 9]], 5), 1);
+        assert_eq!(first_hit(&[vec![1], vec![], vec![4, 7, 5]], 5), 7);
+        assert_eq!(first_hit(&[vec![6]], 5), 6);
+    }
+
+    #[test]
+    fn static_native() {
+        assert_eq!(static_member(3), 3);
+        assert_eq!(static_member(11), 11);
+        assert_eq!(static_member(5), 0);
+        assert_eq!(static_hit(&[]), 0);
+        assert_eq!(static_hit(&[vec![1, 2], vec![], vec![4]]), 0);
+        assert_eq!(static_hit(&[vec![1], vec![2, 3, 9]]), 1);
+        assert_eq!(static_hit(&[vec![4], vec![], vec![8, 3]]), 8);
+    }
+
+    #[test]
+    fn check_ids_native() {
+        assert_eq!(on_seen(&[], None, |s| check_ids(&blocks(&[]), s)), (Ok(0), vec![]));
+        assert_eq!(
+            on_seen(&[], None, |s| check_ids(&blocks(&[&[1, 2], &[], &[3]]), s)),
+            (Ok(3), vec![1, 2, 3])
+        );
+        assert_eq!(
+            on_seen(&[7], Some(8), |s| check_ids(&blocks(&[&[1], &[2, 1, 3]]), s)),
+            (Err(1), vec![7, 1, 2, 8])
+        );
+        assert_eq!(
+            on_seen(&[], Some(8), |s| check_ids(&blocks(&[&[1], &[U, 2]]), s)),
+            (Err(0), vec![1, 8])
+        );
+        assert_eq!(
+            on_seen(&[2], None, |s| check_ids(&blocks(&[&[1], &[2]]), s)),
+            (Err(2), vec![2, 1])
+        );
+        assert_eq!(
+            on_seen(&[9], Some(4), |s| check_ids(&blocks(&[&[5, 6]]), s)),
+            (Ok(2), vec![9, 5, 6, 4])
+        );
+    }
+
+    #[test]
+    fn check_ids_or_native() {
+        assert_eq!(on_seen(&[], None, |s| check_ids_or(&blocks(&[]), s)), (Ok(0), vec![]));
+        assert_eq!(
+            on_seen(&[], None, |s| check_ids_or(&blocks(&[&[1, 2], &[], &[3]]), s)),
+            (Ok(3), vec![1, 2, 3])
+        );
+        assert_eq!(
+            on_seen(&[7], Some(8), |s| check_ids_or(&blocks(&[&[1], &[2, 1, 3]]), s)),
+            (Err(1), vec![7, 1, 2, 8])
+        );
+        assert_eq!(
+            on_seen(&[], Some(8), |s| check_ids_or(&blocks(&[&[1], &[U, 2]]), s)),
+            (Err(U), vec![1, 8])
+        );
+        assert_eq!(
+            on_seen(&[9], Some(4), |s| check_ids_or(&blocks(&[&[5, 6]]), s)),
+            (Ok(2), vec![9, 5, 6, 4])
+        );
+    }
+}
