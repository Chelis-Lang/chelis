+        assert_eq!(option_arms(Some(5), None), 15 + 2 + (5 ^ 0x10) + 11);
+        assert_eq!(option_arms(None, Some((1, 2))), 1u32.wrapping_add(u32::MAX).wrapping_add(7).wrapping_add(2));
+        assert_eq!(shape_arms(&Shape::Pair(4, 5)), 13);
+        assert_eq!(shape_arms(&Shape::Triple(1, 2, 3)), 7);
+        assert_eq!(shape_arms(&Shape::Named { casesOn: 9, congr_simp: 4 }), 5);
+        assert_eq!(shape_arms(&Shape::Nothing), 5);
