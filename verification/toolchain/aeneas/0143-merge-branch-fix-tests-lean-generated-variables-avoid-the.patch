--- /dev/null
+++ b/tests/lean/LeanPatternNames/Scope.lean
@@ -0,0 +1,60 @@
+import Aeneas
+
+/-! The identifiers which are not plain pattern variables in the scope that the
+    generated Lean files open (`open Aeneas Aeneas.Std Result ControlFlow Error`,
+    then the crate namespace): the generated variables must not take them, see
+    the second group of `var_reserved_names` in `src/extract/ExtractBase.ml`.
+
+    For every Rust-like identifier that is the last component of a constant of
+    the environment, run the pattern-identifier resolution of Lean's pattern
+    elaboration (`Lean.Elab.PatternVar.processId`: `Lean.Elab.Term.resolveId?`
+    with kind "pattern"); an identifier is not a plain variable when the
+    resolution is ambiguous (an error: the definition becomes `sorry`), or
+    resolves to a constructor or to a `@[match_pattern]` constant (a constructor
+    pattern instead of a variable). Fails when the result differs from
+    `expected`, i.e. when a change of Aeneas' Lean library adds or removes such
+    an identifier: update `var_reserved_names` and `expected` together. -/
+
+open Aeneas Aeneas.Std Result ControlFlow Error
+
+namespace lean_pattern_names_scope
+
+/-- The second group of `var_reserved_names` (Lean). -/
+def expected : List String := [
+  "_sizeOf_1", "_sizeOf_inst", "Array", "and_or_imp", "bind", "casesOn", "congr_simp", "dite_false",
+  "dite_true", "hcongr_1", "imp_and_neg_imp_iff", "imp_iff_right_iff", "not_imp", "not_imp_self",
+  "panic", "rec", "trans", "arrayOutOfBounds", "assertionFailure", "cont", "div", "divisionByZero",
+  "done", "fail", "false", "integerOverflow", "isFalse", "isTrue", "maximumSizeExceeded", "none", "ok",
+  "some", "true", "undef", "ofColex", "ofLex", "rfl", "toColex", "toLex"]
+
+set_option linter.deprecated false in
+#eval show Lean.Elab.Command.CommandElabM Unit from do
+  let env ← Lean.getEnv
+  let isRustIdent (s : String) : Bool :=
+    match s.toList with
+    | [] => false
+    | c :: cs => (c.isAlpha || c == '_') && cs.all (fun c => c.isAlphanum || c == '_') && s != "_"
+  let mut cands : Std.HashSet String := {}
+  for (n, _) in env.constants.toList do
+    if let .str _ s := n then
+      if isRustIdent s then cands := cands.insert s
+  let mut found : Array String := #[]
+  for s in cands.toArray.qsort (· < ·) do
+    let stx := Lean.mkIdent (Lean.Name.mkSimple s)
+    let notVar ← Lean.Elab.Command.liftTermElabM do
+      try
+        match (← Lean.Elab.Term.resolveId? stx "pattern") with
+        | some (.const f _) =>
+          match (← Lean.getEnv).find? f with
+          | some (.ctorInfo _) => pure true
+          | some _ => pure (Lean.hasMatchPatternAttribute (← Lean.getEnv) f)
+          | none => pure true
+        | _ => pure false
+      catch _ => pure true
+    if notVar then found := found.push s
+  let added := found.filter (!expected.contains ·)
+  let removed := expected.filter (!found.contains ·)
+  unless added.isEmpty && removed.isEmpty do
+    throwError "the identifiers which are not plain pattern variables changed: added {added}, removed {removed}"
+
+end lean_pattern_names_scope
