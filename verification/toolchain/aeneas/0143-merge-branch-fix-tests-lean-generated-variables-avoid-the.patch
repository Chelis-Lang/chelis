diff --git a/tests/src/lean-pattern-names.rs b/tests/src/lean-pattern-names.rs
new file mode 100644
index 0000000..2927998
--- /dev/null
+++ b/tests/src/lean-pattern-names.rs
@@ -0,0 +1,367 @@
+//@ [!lean] skip
+//@ [lean] subdir=LeanPatternNames
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Locals named like the identifiers that are not plain pattern variables in
+//! the scope the generated Lean files open (`open Aeneas Aeneas.Std Result
+//! ControlFlow Error`, then the crate namespace): the ambiguous `bind` (as
+//! chelis_deep's `walk_children_mut`: `Some(bind)` printed `some bind` is an
+//! "ambiguous pattern"), `panic`, `Array`, `trans`, `rec`, `casesOn`, ..., the
+//! constructors `ok`, `fail`, `div`, `cont`, `done`, `some`, `none`, the
+//! `Error` constructors, `isTrue`/`isFalse`, and the `@[match_pattern]`
+//! functions `rfl`, `toLex`, ... The locals are bound in match arms, `if let`,
+//! destructuring `let`s, closure parameters, captures and loop states; the
+//! generated variables avoid those names. Also user types named `BuiltinClone`
+//! and `BuiltinCopy` next to derived `Clone`/`Copy` impls whose unit fields use
+//! Aeneas' builtin instances of the same names.
+//! `LeanPatternNames/Checks.lean` evaluates the model on the inputs of the
+//! `native` test module and compares with the native results, including the
+//! values given back through `&mut`.
+#![allow(non_snake_case, non_camel_case_types, non_upper_case_globals)]
+
+pub enum Shape {
+    Pair(u32, u32),
+    Triple(u32, u32, u32),
+    Named { casesOn: u32, congr_simp: u32 },
+    Nothing,
+}
+
+/// Option payloads bound in match arms and `if let`.
+pub fn option_arms(o: Option<u32>, p: Option<(u32, u32)>) -> u32 {
+    let a = match o {
+        Some(bind) => bind.wrapping_mul(3),
+        None => 1,
+    };
+    let b = if let Some((ok, fail)) = p { ok.wrapping_sub(fail) } else { 2 };
+    let c = match o {
+        Some(some) => some ^ 0x10,
+        None => 7,
+    };
+    let d = match p {
+        Some((none, panic)) => none.wrapping_mul(panic),
+        None => 11,
+    };
+    a.wrapping_add(b).wrapping_add(c).wrapping_add(d)
+}
+
+/// Enumeration payloads bound in match arms.
+pub fn shape_arms(s: &Shape) -> u32 {
+    match s {
+        Shape::Pair(div, cont) => div.wrapping_mul(2).wrapping_add(*cont),
+        Shape::Triple(done, Array, trans) => done.wrapping_add(Array.wrapping_mul(*trans)),
+        Shape::Named { casesOn, congr_simp } => casesOn.wrapping_sub(*congr_simp),
+        Shape::Nothing => 5,
+    }
+}
+
+/// Destructuring `let`s of tuples.
+pub fn let_tuples(t: (u32, u32, u32), u: (u32, u32, u32)) -> u32 {
+    let (rec, dite_true, dite_false) = t;
+    let (hcongr_1, and_or_imp, not_imp) = u;
+    let (not_imp_self, imp_iff_right_iff) = (rec ^ hcongr_1, dite_true.wrapping_add(and_or_imp));
+    let imp_and_neg_imp_iff = dite_false.wrapping_mul(not_imp);
+    not_imp_self
+        .wrapping_add(imp_iff_right_iff)
+        .wrapping_add(imp_and_neg_imp_iff)
+}
+
+pub fn apply2<F: Fn(u32, u32) -> u32>(f: F, x: u32, y: u32) -> u32 {
+    f(x, y)
+}
+
+/// Closure parameters and captures.
+pub fn closures(x: u32, y: u32) -> u32 {
+    let arrayOutOfBounds = x.wrapping_add(1);
+    let f = |assertionFailure: u32, divisionByZero: u32| {
+        assertionFailure.wrapping_mul(divisionByZero).wrapping_add(arrayOutOfBounds)
+    };
+    let g = |(integerOverflow, maximumSizeExceeded): (u32, u32)| integerOverflow ^ maximumSizeExceeded;
+    apply2(f, x, y).wrapping_add(g((x, y)))
+}
+
+/// Loop states.
+pub fn loops(n: u32) -> (u32, u32) {
+    let mut undef = 0u32;
+    let mut isTrue = 0u32;
+    let mut isFalse = 1u32;
+    while undef < n {
+        isTrue = isTrue.wrapping_add(undef);
+        isFalse = isFalse.wrapping_mul(3) ^ isTrue;
+        undef += 1;
+    }
+    (isTrue, isFalse)
+}
+
+/// Every name bound in a match arm (the position of `Some(bind)` in
+/// walk_children_mut).
+pub enum Wide {
+    A(u32, u32, u32, u32, u32, u32),
+    B(u32, u32, u32, u32, u32, u32),
+    C(u32, u32, u32, u32, u32, u32),
+    D(u32, u32, u32, u32, u32, u32),
+    E(u32, u32, u32, u32, u32, u32),
+    F { some: u32, none: u32, rfl: u32, toLex: u32, ofLex: u32 },
+}
+
+fn mix(acc: u32, x: u32) -> u32 {
+    acc.wrapping_mul(31).wrapping_add(x)
+}
+
+fn mix6(a: u32, b: u32, c: u32, d: u32, e: u32, f: u32) -> u32 {
+    mix(mix(mix(mix(mix(a, b), c), d), e), f)
+}
+
+pub fn wide(w: &Wide) -> u32 {
+    match w {
+        Wide::A(bind, ok, fail, panic, div, cont) => mix6(*bind, *ok, *fail, *panic, *div, *cont),
+        Wide::B(done, Array, trans, casesOn, congr_simp, rec) => {
+            mix6(*done, *Array, *trans, *casesOn, *congr_simp, *rec)
+        }
+        Wide::C(dite_true, dite_false, hcongr_1, and_or_imp, not_imp, not_imp_self) => {
+            mix6(*dite_true, *dite_false, *hcongr_1, *and_or_imp, *not_imp, *not_imp_self)
+        }
+        Wide::D(
+            imp_iff_right_iff,
+            imp_and_neg_imp_iff,
+            arrayOutOfBounds,
+            assertionFailure,
+            divisionByZero,
+            integerOverflow,
+        ) => mix6(
+            *imp_iff_right_iff,
+            *imp_and_neg_imp_iff,
+            *arrayOutOfBounds,
+            *assertionFailure,
+            *divisionByZero,
+            *integerOverflow,
+        ),
+        Wide::E(maximumSizeExceeded, undef, isTrue, isFalse, toColex, ofColex) => {
+            mix6(*maximumSizeExceeded, *undef, *isTrue, *isFalse, *toColex, *ofColex)
+        }
+        Wide::F { some, none, rfl, toLex, ofLex } => mix6(*some, *none, *rfl, *toLex, *ofLex, 7),
+    }
+}
+
+/// Writes through the arm bindings: the caller sees the updated payload.
+pub fn bump_wide(w: &mut Wide) -> u32 {
+    match w {
+        Wide::A(bind, ok, fail, panic, div, cont) => {
+            let old = *bind;
+            *bind = ok.wrapping_add(*fail);
+            *ok = *panic ^ *div;
+            *cont = old;
+            old
+        }
+        Wide::B(done, Array, trans, casesOn, congr_simp, rec) => {
+            let old = *done;
+            *done = Array.wrapping_mul(*trans);
+            *casesOn = *congr_simp;
+            *rec = rec.wrapping_add(old);
+            old
+        }
+        Wide::C(dite_true, dite_false, hcongr_1, and_or_imp, not_imp, not_imp_self) => {
+            let old = *dite_true;
+            *dite_true = *dite_false;
+            *dite_false = hcongr_1.wrapping_sub(*and_or_imp);
+            *not_imp = *not_imp_self;
+            old
+        }
+        Wide::D(
+            imp_iff_right_iff,
+            imp_and_neg_imp_iff,
+            arrayOutOfBounds,
+            assertionFailure,
+            divisionByZero,
+            integerOverflow,
+        ) => {
+            let old = *imp_iff_right_iff;
+            *imp_iff_right_iff = imp_and_neg_imp_iff.wrapping_add(*arrayOutOfBounds);
+            *assertionFailure = *divisionByZero ^ *integerOverflow;
+            old
+        }
+        Wide::E(maximumSizeExceeded, undef, isTrue, isFalse, toColex, ofColex) => {
+            let old = *maximumSizeExceeded;
+            *maximumSizeExceeded = undef.wrapping_mul(*isTrue);
+            *isFalse = *toColex;
+            *ofColex = old;
+            old
+        }
+        Wide::F { some, none, rfl, toLex, ofLex } => {
+            let old = *some;
+            *some = none.wrapping_add(*rfl);
+            *toLex = *ofLex;
+            old
+        }
+    }
+}
+
+/// Reads back what `bump_wide` wrote.
+pub fn wide_fields(w: &Wide) -> (u32, u32, u32, u32, u32, u32) {
+    match w {
+        Wide::A(a, b, c, d, e, f)
+        | Wide::B(a, b, c, d, e, f)
+        | Wide::C(a, b, c, d, e, f)
+        | Wide::D(a, b, c, d, e, f)
+        | Wide::E(a, b, c, d, e, f) => (*a, *b, *c, *d, *e, *f),
+        Wide::F { some: a, none: b, rfl: c, toLex: d, ofLex: e } => (*a, *b, *c, *d, *e, 0),
+    }
+}
+
+/// Values given back through `&mut`, bound under the reserved names.
+pub fn give_back(o: &mut Option<u32>, s: &mut Shape) -> u32 {
+    let old = match o {
+        Some(bind) => {
+            let ok = *bind;
+            *bind = ok.wrapping_add(100);
+            ok
+        }
+        None => {
+            *o = Some(1);
+            0
+        }
+    };
+    match s {
+        Shape::Pair(div, cont) => {
+            *div = div.wrapping_add(*cont);
+            *cont = 0;
+        }
+        Shape::Triple(done, Array, trans) => {
+            let panic = *done;
+            *done = *trans;
+            *trans = panic;
+            *Array = Array.wrapping_add(1);
+        }
+        Shape::Named { casesOn, congr_simp } => {
+            *casesOn = casesOn.wrapping_mul(2);
+            *congr_simp = 9;
+        }
+        Shape::Nothing => *s = Shape::Pair(old, 3),
+    }
+    old
+}
+
+/// Reads back what `give_back` wrote.
+pub fn shape_fields(s: &Shape) -> (u32, u32, u32) {
+    match s {
+        Shape::Pair(a, b) => (*a, *b, 0),
+        Shape::Triple(a, b, c) => (*a, *b, *c),
+        Shape::Named { casesOn, congr_simp } => (*casesOn, *congr_simp, 1),
+        Shape::Nothing => (0, 0, 2),
+    }
+}
+
+/// User types named like Aeneas' builtin `Clone`/`Copy` instances, which the
+/// derived `Clone` of `BuiltinClone` (for its unit field) and the callers of
+/// `dup` and `clone` on a unit value use.
+#[derive(Clone)]
+pub struct BuiltinClone {
+    pub unit: (),
+    pub v: u32,
+}
+
+#[derive(Clone, Copy)]
+pub struct BuiltinCopy {
+    pub unit: (),
+    pub w: u32,
+}
+
+pub fn dup<T: Copy>(x: T) -> (T, T) {
+    (x, x)
+}
+
+pub fn clone_all(b: &BuiltinClone, c: BuiltinCopy, u: ()) -> (u32, u32) {
+    let b2 = b.clone();
+    let ((), ()) = dup(u);
+    let () = u.clone();
+    let (d, e) = dup(c);
+    (b2.v.wrapping_add(d.w), e.w)
+}
