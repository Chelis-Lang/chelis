+
+    /// The `i`-th variant with the payload `k + 1`, `k + 2`, ...
+    fn mk(i: u32, k: u32) -> Wide {
+        let v = |j: u32| k.wrapping_add(j);
+        match i {
+            0 => Wide::A(v(1), v(2), v(3), v(4), v(5), v(6)),
+            1 => Wide::B(v(1), v(2), v(3), v(4), v(5), v(6)),
+            2 => Wide::C(v(1), v(2), v(3), v(4), v(5), v(6)),
+            3 => Wide::D(v(1), v(2), v(3), v(4), v(5), v(6)),
+            4 => Wide::E(v(1), v(2), v(3), v(4), v(5), v(6)),
+            _ => Wide::F { some: v(1), none: v(2), rfl: v(3), toLex: v(4), ofLex: v(5) },
+        }
+    }
+
+    #[test]
+    fn wide_arms() {
+        // (variant, k, wide, old value returned by bump_wide, payload given back by bump_wide)
+        let cases: [(u32, u32, u32, u32, (u32, u32, u32, u32, u32, u32)); 12] = [
+            (0, 0xa, 326404131, 11, (25, 1, 13, 14, 15, 11)),
+            (1, 0xa, 326404131, 11, (156, 12, 13, 15, 15, 27)),
+            (2, 0xa, 326404131, 11, (12, 4294967295, 13, 14, 16, 16)),
+            (3, 0xa, 326404131, 11, (25, 12, 13, 31, 15, 16)),
+            (4, 0xa, 326404131, 11, (156, 12, 13, 15, 15, 11)),
+            (5, 0xa, 326404122, 11, (25, 12, 13, 15, 15, 0)),
+            (0, 0xfffffff0, 3852201571, 4294967281, (4294967269, 1, 4294967283, 4294967284, 4294967285, 4294967281)),
+            (1, 0xfffffff0, 3852201571, 4294967281, (182, 4294967282, 4294967283, 4294967285, 4294967285, 4294967271)),
+            (2, 0xfffffff0, 3852201571, 4294967281, (4294967282, 4294967295, 4294967283, 4294967284, 4294967286, 4294967286)),
+            (3, 0xfffffff0, 3852201571, 4294967281, (4294967269, 4294967282, 4294967283, 3, 4294967285, 4294967286)),
+            (4, 0xfffffff0, 3852201571, 4294967281, (182, 4294967282, 4294967283, 4294967285, 4294967285, 4294967281)),
+            (5, 0xfffffff0, 3852201588, 4294967281, (4294967269, 4294967282, 4294967283, 4294967285, 4294967285, 0)),
