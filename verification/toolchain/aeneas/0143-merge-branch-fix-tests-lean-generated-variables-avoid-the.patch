+import LeanPatternNames.LeanPatternNames
+
+/-! Evaluate the model of `tests/src/lean-pattern-names.rs` on the inputs of
+    its `native` test module and compare with the native results, including
+    the option and the shape that `give_back` gives back through `&mut` (read
+    back with the model's `shape_fields`, as natively). -/
+
+namespace lean_pattern_names.checks
+open Aeneas Aeneas.Std Result
+open lean_pattern_names (Shape Wide)
+
+def u (x : Nat) : U32 := ⟨BitVec.ofNat _ x⟩
+
+def res {α β : Type} (f : α → β) : Result α → Option β
+  | ok v => some (f v)
+  | _ => none
+
+def n : Result U32 → Option Nat := res (·.val)
+
+def n2 : Result (U32 × U32) → Option (Nat × Nat) := res (fun (a, b) => (a.val, b.val))
+
+def get {α : Type} : Result α → Option α := res id
+
+def umax : Nat := 4294967295
+
+-- native `arms`
+#guard n (option_arms (some (u 4)) (some (u 10, u 3))) == some (12 + 7 + (4 ^^^ 0x10) + 30)
+#guard n (option_arms none none) == some (1 + 2 + 7 + 11)
+#guard n (option_arms (some (u 5)) none) == some (15 + 2 + (5 ^^^ 0x10) + 11)
+#guard n (option_arms none (some (u 1, u 2))) == some ((1 + umax + 7 + 2) % 2 ^ 32)
+#guard n (shape_arms (.Pair (u 4) (u 5))) == some 13
+#guard n (shape_arms (.Triple (u 1) (u 2) (u 3))) == some 7
+#guard n (shape_arms (.Named (u 9) (u 4))) == some 5
+#guard n (shape_arms .Nothing) == some 5
+
+-- native `lets`
+#guard n (let_tuples (u 1, u 2, u 3) (u 4, u 5, u 6)) == some ((1 ^^^ 4) + 7 + 18)
+#guard n (closures (u 3) (u 5)) == some (15 + 4 + (3 ^^^ 5))
+#guard n2 (loops (u 0)) == some (0, 1)
+#guard n2 (loops (u 4)) == some (6, 87)
+
+-- native `wide_arms`: `wide`, then `bump_wide` returns the old first payload and gives back the payload
+-- (read back with the model's `wide_fields`)
+/-- The `i`-th variant of `Wide` with the payload `k + 1`, `k + 2`, ... (native `mk`). -/
+def mk (i k : Nat) : Wide :=
+  let v (j : Nat) := u ((k + j) % 2 ^ 32)
+  match i with
+  | 0 => .A (v 1) (v 2) (v 3) (v 4) (v 5) (v 6)
+  | 1 => .B (v 1) (v 2) (v 3) (v 4) (v 5) (v 6)
+  | 2 => .C (v 1) (v 2) (v 3) (v 4) (v 5) (v 6)
+  | 3 => .D (v 1) (v 2) (v 3) (v 4) (v 5) (v 6)
+  | 4 => .E (v 1) (v 2) (v 3) (v 4) (v 5) (v 6)
+  | _ => .F (v 1) (v 2) (v 3) (v 4) (v 5)
+
+def wideCase (i k : Nat) : Option (Nat × Nat × Nat × Nat × Nat × Nat × Nat × Nat) :=
+  get (wide (mk i k)) >>= fun d =>
+    get (bump_wide (mk i k)) >>= fun (old, w) =>
+      get (wide_fields w) >>= fun (a, b, c, e, f, g) =>
+        some (d.val, old.val, a.val, b.val, c.val, e.val, f.val, g.val)
+
+#guard wideCase 0 10 == some (326404131, 11, (25, 1, 13, 14, 15, 11))
+#guard wideCase 1 10 == some (326404131, 11, (156, 12, 13, 15, 15, 27))
+#guard wideCase 2 10 == some (326404131, 11, (12, 4294967295, 13, 14, 16, 16))
+#guard wideCase 3 10 == some (326404131, 11, (25, 12, 13, 31, 15, 16))
+#guard wideCase 4 10 == some (326404131, 11, (156, 12, 13, 15, 15, 11))
+#guard wideCase 5 10 == some (326404122, 11, (25, 12, 13, 15, 15, 0))
+#guard wideCase 0 4294967280 == some (3852201571, 4294967281, (4294967269, 1, 4294967283, 4294967284, 4294967285, 4294967281))
+#guard wideCase 1 4294967280 == some (3852201571, 4294967281, (182, 4294967282, 4294967283, 4294967285, 4294967285, 4294967271))
+#guard wideCase 2 4294967280 == some (3852201571, 4294967281, (4294967282, 4294967295, 4294967283, 4294967284, 4294967286, 4294967286))
+#guard wideCase 3 4294967280 == some (3852201571, 4294967281, (4294967269, 4294967282, 4294967283, 3, 4294967285, 4294967286))
+#guard wideCase 4 4294967280 == some (3852201571, 4294967281, (182, 4294967282, 4294967283, 4294967285, 4294967285, 4294967281))
+#guard wideCase 5 4294967280 == some (3852201588, 4294967281, (4294967269, 4294967282, 4294967283, 4294967285, 4294967285, 0))
+
+-- native `given_back`: `give_back` returns the old payload and gives back the option and the shape
+def gb (o : Option U32) (s : Shape) : Option (Nat × Option Nat × Nat × Nat × Nat) :=
+  get (give_back o s) >>= fun (old, o', s') =>
+    get (shape_fields s') >>= fun (a, b, c) => some (old.val, o'.map (·.val), a.val, b.val, c.val)
+
+#guard gb (some (u 7)) (.Pair (u 4) (u 5)) == some (7, some 107, 9, 0, 0)
+#guard gb none .Nothing == some (0, some 1, 0, 3, 0)
+#guard gb (some (u 1)) (.Triple (u 1) (u 2) (u 3)) == some (1, some 101, 3, 3, 1)
+#guard gb (some (u 101)) (.Named (u 6) (u 1)) == some (101, some 201, 12, 9, 1)
+-- the chained calls of `given_back`, each on the option the previous call gave back
+#guard (get (give_back none .Nothing) >>= fun (_, o, _) =>
+    get (give_back o (.Triple (u 1) (u 2) (u 3))) >>= fun (_, o, _) =>
+    get (give_back o (.Named (u 6) (u 1)))).map (fun (old, o, _) => (old.val, o.map (·.val)))
+  == some (101, some 201)
+
+-- native `builtin_names`
+#guard n2 (clone_all { unit := (), v := u 3 } { unit := (), w := u 4 } ()) == some (7, 4)
+#guard n2 (clone_all { unit := (), v := u 10 } { unit := (), w := u umax } ()) == some (9, umax)
+
+end lean_pattern_names.checks
