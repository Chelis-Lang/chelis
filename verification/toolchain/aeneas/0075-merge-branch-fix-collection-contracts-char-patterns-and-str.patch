+/-- `str::rsplit_once` (core/src/str/mod.rs): `let (start, end) =
+    delimiter.into_searcher(self).next_match_back()?; Some((self[..start],
+    self[end..]))`, the text around the last match of the reverse searcher. Its
+    `for<'a> P::Searcher<'a>: ReverseSearcher<'a>` clause only states that the
+    searcher searches backwards: the model reads that match from
+    `Pattern.reverse_matches`. -/
+@[rust_fun "core::str::{str}::rsplit_once" (keepTraitClauses := [true, false])]
+def core.str.Str.rsplit_once {P : Type} (patInst : core.str.pattern.Pattern P)
+    (s : Str) (delimiter : P) : Result (Option (Str × Str)) :=
+  match patInst.reverse_matches with
+  | none => .fail .panic
+  | some search => do
+    match ← search delimiter s with
+    | [] => .ok none
+    | (start, stop) :: _ =>
+      .ok (some (core.str.iter.Split.piece s 0 start,
+        core.str.iter.Split.piece s stop s.val.length))
+
