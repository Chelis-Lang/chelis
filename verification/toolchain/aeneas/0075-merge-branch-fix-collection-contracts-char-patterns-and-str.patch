+/-- The successive `next_match_back` results of `StrSearcher::new(haystack,
+    needle)` as a `ReverseSearcher` (core str/pattern.rs, rustc 1.95). An empty
+    needle's `EmptyNeedle::next_back` alternates a match at the current end with
+    a reject of the char before it, from the end: an empty match at every char
+    boundary, from the last to the first. A nonempty needle's two-way
+    `next_back` finds the rightmost occurrence ending at or before the search
+    end, which then resumes at the start of that match: the rightmost
+    non-overlapping occurrences, i.e. the leftmost non-overlapping occurrences
+    of the reversed needle in the reversed haystack, mirrored. -/
+def core.str.pattern.StrSearcher.reverseMatches (haystack needle : Str) :
+    Result (List (Nat × Nat)) := do
+  let text ← Str.toString haystack
+  if needle.val.isEmpty then
+    .ok ((text.toList.scanl (fun pos char => pos + char.utf8Size) 0).reverse.map fun pos => (pos, pos))
+  else
+    let length := haystack.val.length
+    .ok ((core.str.pattern.StrSearcher.needleMatches needle.val.reverse haystack.val.reverse 0 0).map
+      fun (start, stop) => (length - stop, length - start))
+
