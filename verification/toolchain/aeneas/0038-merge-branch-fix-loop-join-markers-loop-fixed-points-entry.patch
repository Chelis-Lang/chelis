+//@ [!lean] skip
+//@ [lean] subdir=LoopEntrySharedPayload
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::cmp
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Loops which match on a shared input holding nested references. The loop
+//! entry reborrows the shared value in an abstraction whose nested regions
+//! belong to a child abstraction, and the loop body expands the reborrowed
+//! payload: the reborrow keeps its identifier through the joins while its
+//! payload is refreshed, so it is not a fixed abstraction of the loop.
+//! `LoopEntrySharedPayload/Checks.lean` evaluates the model on the inputs of
+//! the `native` test module below and compares with the native results.
+
+pub fn repeated_optional(shared: &Option<&u32>, rounds: usize) -> u32 {
+    let mut total = 0u32;
+    let mut i = 0;
+    while i < rounds {
+        match shared {
+            Some(value) => total = total.wrapping_add(**value),
+            None => total = total.wrapping_add(1),
+        }
+        i += 1;
+    }
+    total
+}
+
+pub struct Choice<'a> {
+    pub fallback: &'a u32,
+    pub preferred: Option<&'a u32>,
+}
+
+pub fn repeated_choice(choice: &Choice<'_>, rounds: u32) -> u32 {
+    let mut total = 0u32;
+    let mut i = 0;
+    while i < rounds {
+        let v = match choice.preferred {
+            Some(p) if *p > i => *p,
+            _ => *choice.fallback,
+        };
+        total = total.wrapping_add(v);
+        i += 1;
+    }
+    total
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn optional() {
+        assert_eq!(repeated_optional(&Some(&7), 4), 28);
+        assert_eq!(repeated_optional(&None, 4), 4);
+        assert_eq!(repeated_optional(&Some(&7), 0), 0);
+    }
+
+    #[test]
+    fn choice() {
+        let (f, p) = (3, 2);
+        assert_eq!(repeated_choice(&Choice { fallback: &f, preferred: Some(&p) }, 4), 10);
+        assert_eq!(repeated_choice(&Choice { fallback: &f, preferred: None }, 3), 9);
+        assert_eq!(repeated_choice(&Choice { fallback: &f, preferred: Some(&p) }, 0), 0);
+    }
+}
