+/-! Evaluate the model of `tests/src/loop-entry-shared-payload.rs` on the
+    inputs of its `native` test module and compare with the native results. -/
+
+namespace loop_entry_shared_payload.checks
+open Aeneas Aeneas.Std Result
+
+def u (n : Nat) : U32 := ⟨BitVec.ofNat _ n⟩
+def us (n : Nat) : Usize := ⟨BitVec.ofNat _ n⟩
+
+def resN (r : Result U32) : Option Nat :=
+  match r with
+  | ok v => some v.val
+  | _ => none
+
+#guard resN (repeated_optional (some (u 7)) (us 4)) == some 28
+#guard resN (repeated_optional none (us 4)) == some 4
+#guard resN (repeated_optional (some (u 7)) (us 0)) == some 0
+#guard resN (repeated_choice { fallback := u 3, preferred := some (u 2) } (u 4)) == some 10
+#guard resN (repeated_choice { fallback := u 3, preferred := none } (u 3)) == some 9
+#guard resN (repeated_choice { fallback := u 3, preferred := some (u 2) } (u 0)) == some 0
+
+end loop_entry_shared_payload.checks
