+import JoinStaticNested.JoinStaticNested
+
+/-! Evaluate the model of `tests/src/join-static-nested.rs` on the inputs of
+    its `native` test module and compare with the native results. -/
+
+namespace join_static_nested.checks
+open Aeneas Aeneas.Std Result
+
+def u (n : Nat) : U32 := ⟨BitVec.ofNat _ n⟩
+
+def us (xs : List Nat) (h : xs.length ≤ Usize.max := by simp; try scalar_tac) : Slice U32 :=
+  ⟨xs.map u, by simpa using h⟩
+
+def resB (r : Result Bool) : Option Bool :=
+  match r with
+  | ok b => some b
+  | _ => none
+
+def resN (r : Result U32) : Option Nat :=
+  match r with
+  | ok v => some v.val
+  | _ => none
+
+/-- `shape_of 0`, i.e. `Shape::Choices(&CHOICES)`. -/
+def early0 (k : Nat) : Result Bool := do
+  let s ← shape_of (u 0)
+  early_accept s (u k)
+
+def below0 (k : Nat) : Result U32 := do
+  let s ← shape_of (u 0)
+  score_below s (u k)
+
+#guard resB (early_accept Shape.Plain (u 3)) == some true
+#guard resB (early0 9) == some true
+#guard resB (early0 4) == some false
+#guard resB (early_accept Shape.Plain (u 1)) == some false
+#guard resN (total_weight (us [])) == some 0
+#guard resN (total_weight (us [5, 0, 7])) == some 8
+#guard resN (total_weight (us [2, 3])) == some 7
+#guard resN (below0 9) == some 1
+#guard resN (below0 5) == some 0
+#guard resN (score_below Shape.Plain (u 50)) == some 50
+#guard resN (score_below Shape.Plain (u 100)) == some 0
+
+end join_static_nested.checks
