+//@ [!lean] skip
+//@ [lean] subdir=LoopJoinClosures
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::iter::adapters::filter::Filter --include core::option::{core::option::Option} --include core::cmp
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Loops over slices of pairs holding references (nested regions), which call
+//! closures: a `filter` whose predicate calls another closure capturing a
+//! local (so the adapter holds `&'a F<'b>`), and a `find` on a second
+//! vector at every iteration (its shared borrow is reborrowed with nested
+//! regions at the loop entry).
+//! `LoopJoinClosures/Checks.lean` evaluates the model on the inputs of the
+//! `native` test module below and compares with the native results.
+
+/// Pushes the values whose key passes `relevant`: every value if
+/// `!metadata`, otherwise the values whose key is greater than 3.
+pub fn push_relevant<'a>(a: &Vec<(&'a u32, u32)>, metadata: bool, pending: &mut Vec<u32>) -> bool {
+    let relevant = |key: &u32| !metadata || *key > 3;
+    for (_key, value) in a.iter().filter(|(key, _)| relevant(key)) {
+        pending.push(*value);
+    }
+    true
+}
+
+/// Pairs the value of every entry of `a` with the value of the first entry of
+/// `b` which has an equal key; returns `false` (keeping the pairs pushed so
+/// far) at the first key of `a` missing from `b`.
+pub fn pair_entries<'a, 'b>(
+    a: &Vec<(&'a u32, u32)>,
+    b: &Vec<(&'b u32, u32)>,
+    pending: &mut Vec<(u32, u32)>,
+) -> bool {
+    for (key, value) in a.iter() {
+        let Some((_, other)) = b.iter().find(|(other_key, _)| other_key == key) else {
+            return false;
+        };
+        pending.push((*value, *other));
+    }
+    true
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn filter_closure() {
+        let (k1, k5, k7) = (1, 5, 7);
+        let a = vec![(&k1, 10), (&k5, 20), (&k7, 30)];
+        let mut pending = vec![0];
+        assert!(push_relevant(&a, true, &mut pending));
+        assert_eq!(pending, vec![0, 20, 30]);
+        let mut pending = vec![];
+        assert!(push_relevant(&a, false, &mut pending));
+        assert_eq!(pending, vec![10, 20, 30]);
+        let mut pending = vec![4];
+        assert!(push_relevant(&vec![], true, &mut pending));
+        assert_eq!(pending, vec![4]);
+    }
+
+    #[test]
+    fn find_closure() {
+        let (k1, k2, k3) = (1, 2, 3);
+        let a = vec![(&k2, 10), (&k1, 20)];
+        let b = vec![(&k1, 5), (&k2, 6), (&k1, 7)];
+        let mut pending = vec![];
+        assert!(pair_entries(&a, &b, &mut pending));
+        assert_eq!(pending, vec![(10, 6), (20, 5)]);
+        let a = vec![(&k1, 10), (&k3, 20), (&k2, 30)];
+        let mut pending = vec![(0, 0)];
+        assert!(!pair_entries(&a, &b, &mut pending));
+        assert_eq!(pending, vec![(0, 0), (10, 5)]);
+        let mut pending = vec![];
+        assert!(pair_entries(&vec![], &b, &mut pending));
+        assert_eq!(pending, vec![]);
+    }
+}
