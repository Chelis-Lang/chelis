+//@ [!lean] skip
+//@ [lean] subdir=JoinStaticNested
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::cmp
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Joins of values whose type has nested borrows which are all `'static`
+//! (an enum without region parameters holding a `&'static [&'static u32]`):
+//! a symbolic value joined with itself after a branch, symbolic values
+//! updated at every iteration of a loop, and distinct variants joined after a
+//! `match`.
+//! `JoinStaticNested/Checks.lean` evaluates the model on the inputs of the
+//! `native` test module below and compares with the native results.
+
+#[derive(Clone, Copy)]
+pub enum Shape {
+    Plain,
+    Choices(&'static [&'static u32]),
+}
+
+pub static CHOICES: [&u32; 2] = [&4, &9];
+
+pub fn shape_of(k: u32) -> Shape {
+    if k == 0 { Shape::Choices(&CHOICES) } else { Shape::Plain }
+}
+
+pub fn weight(s: Shape, k: u32) -> u32 {
+    match s {
+        Shape::Plain => k,
+        Shape::Choices(c) => *c[0],
+    }
+}
+
+/// `shape` is unchanged by the early-return branch.
+pub fn early_accept(shape: Shape, k: u32) -> bool {
+    if matches!(k, 0 | 3) {
+        return true;
+    }
+    match shape {
+        Shape::Plain => k > 1,
+        Shape::Choices(c) => *c[1] == k,
+    }
+}
+
+/// `shape` is a different symbolic value at every iteration.
+pub fn total_weight(keys: &[u32]) -> u32 {
+    let mut shape = shape_of(0);
+    let mut n = 0u32;
+    for k in keys {
+        n = n.wrapping_add(weight(shape, *k));
+        shape = shape_of(*k);
+    }
+    n
+}
+
+/// The arms of the `match` leave `shape` expanded to distinct variants.
+pub fn score_below(shape: Shape, k: u32) -> u32 {
+    let r = match shape {
+        Shape::Plain => k,
+        Shape::Choices(c) => {
+            if c.contains(&&k) {
+                1
+            } else {
+                0
+            }
+        }
+    };
+    if k < 100 { r } else { 0 }
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn static_nested() {
+        assert!(early_accept(Shape::Plain, 3));
+        assert!(early_accept(shape_of(0), 9));
+        assert!(!early_accept(shape_of(0), 4));
+        assert!(!early_accept(Shape::Plain, 1));
+        assert_eq!(total_weight(&[]), 0);
+        assert_eq!(total_weight(&[5, 0, 7]), 4 + 0 + 4);
+        assert_eq!(total_weight(&[2, 3]), 4 + 3);
+        assert_eq!(score_below(shape_of(0), 9), 1);
+        assert_eq!(score_below(shape_of(0), 5), 0);
+        assert_eq!(score_below(Shape::Plain, 50), 50);
+        assert_eq!(score_below(Shape::Plain, 100), 0);
+    }
+}
