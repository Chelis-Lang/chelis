+import LoopJoinClosures.LoopJoinClosures
+
+/-! Evaluate the model of `tests/src/loop-join-closures.rs` on the inputs of
+    its `native` test module and compare with the native results. -/
+
+namespace loop_join_closures.checks
+open Aeneas Aeneas.Std Result
+
+def u (n : Nat) : U32 := ⟨BitVec.ofNat _ n⟩
+
+def vec {α : Type} (xs : List α) (h : xs.length ≤ Usize.max := by simp; try scalar_tac) :
+    alloc.vec.Vec α :=
+  ⟨xs, h⟩
+
+/-- A vector of `(key, value)` pairs; the references to the keys are erased. -/
+def pairs (xs : List (Nat × Nat)) (h : xs.length ≤ Usize.max := by simp; try scalar_tac) :
+    alloc.vec.Vec (U32 × U32) :=
+  ⟨xs.map (fun (k, v) => (u k, u v)), by simpa using h⟩
+
+def res1 (r : Result (Bool × alloc.vec.Vec U32)) : Option (Bool × List Nat) :=
+  match r with
+  | ok (b, v) => some (b, v.val.map (·.val))
+  | _ => none
+
+def res2 (r : Result (Bool × alloc.vec.Vec (U32 × U32))) : Option (Bool × List (Nat × Nat)) :=
+  match r with
+  | ok (b, v) => some (b, v.val.map (fun (x, y) => (x.val, y.val)))
+  | _ => none
+
+-- native::filter_closure
+#guard res1 (push_relevant (pairs [(1, 10), (5, 20), (7, 30)]) true (vec [u 0]))
+  == some (true, [0, 20, 30])
+#guard res1 (push_relevant (pairs [(1, 10), (5, 20), (7, 30)]) false (vec []))
+  == some (true, [10, 20, 30])
+#guard res1 (push_relevant (pairs []) true (vec [u 4])) == some (true, [4])
+
+-- native::find_closure
+#guard res2 (pair_entries (pairs [(2, 10), (1, 20)]) (pairs [(1, 5), (2, 6), (1, 7)]) (vec []))
+  == some (true, [(10, 6), (20, 5)])
+#guard res2 (pair_entries (pairs [(1, 10), (3, 20), (2, 30)]) (pairs [(1, 5), (2, 6), (1, 7)])
+    (vec [(u 0, u 0)]))
+  == some (false, [(0, 0), (10, 5)])
+#guard res2 (pair_entries (pairs []) (pairs [(1, 5), (2, 6), (1, 7)]) (vec [])) == some (true, [])
+
+end loop_join_closures.checks
