+(** Nested borrows: the positions of a level in a symbolic value. The types of
+    the backward functions only keep the tuple fields which hold positions of
+    a level (see [SymbolicToPureTypes.translate_back_nested_ty]), while the
+    projectors over a symbolic value do not distinguish its fields: a symbolic
+    value is consumed or given back as a whole at a level (see
+    [aproj_to_consumed_aux] and [aproj_to_given_back_aux]). We restrict such a
+    value to the fields with positions at the boundaries of the backward
+    functions, and embed a restricted value into the original value. *)
+type nested_shape =
+  | NestedWhole  (** The whole value *)
+  | NestedFields of (T.ty * nested_shape option) list
+      (** A tuple, of which we keep the fields with a shape *)
+
+(** The shape of the positions at the relative [level] of a value of type [ty]
+    for the mutable borrows of [regions] (see [nested_shape]), mirroring
+    [SymbolicToPureTypes.translate_back_nested_ty]: [None] if it has none. *)
+let nested_value_shape (ctx : bs_ctx) (regions : T.RegionId.Set.t)
+    (level : abs_level) (ty : T.ty) : nested_shape option =
+  let keep_region = region_selected regions in
+  let has_mut = projection_selects_mutable ctx.decls_ctx regions in
+  let rec shape (current : abs_level) (ty : T.ty) : nested_shape option =
+    if level < current || not (has_mut ty) then None
+    else
+      match ty with
+      | T.TRef (r, _, RMut) when keep_region r ->
+          if current = level then Some NestedWhole else None
+      | T.TRef (_, rty, RMut) -> (
+          match (shape current rty, shape (current + 1) rty) with
+          | Some _, Some _ ->
+              [%craise] ctx.span
+                "Nested borrows: a symbolic value holds positions of the same \
+                 level in the value of an ignored mutable borrow and in the \
+                 value given back to it"
+          | Some s, None | None, Some s -> Some s
+          | None, None -> None)
+      | T.TRef (_, _, RShared) -> None
+      | T.TAdt { id = TTuple; generics } ->
+          let fields =
+            List.map (fun ty -> (ty, shape current ty)) generics.types
+          in
+          if List.for_all (fun (_, s) -> s = None) fields then None
+          else if List.for_all (fun (_, s) -> s = Some NestedWhole) fields then
+            Some NestedWhole
+          else Some (NestedFields fields)
+      | T.TAdt { id = TBuiltin TBox; generics = { types = [ ty ]; _ } } ->
+          shape current ty
+      | T.TAdt _ | T.TArray _ | T.TSlice _ -> (
+          (* One value of the ADT per view: a symbolic value is the value of
+             its single view (several views disagree with the signature) *)
+          match
+            back_adt_view_keys
+              (back_ty_paths_for_regions ctx.decls_ctx keep_region ty)
+              ~select:(fun _ -> true)
+              (level - current)
+          with
+          | [] -> None
+          | _ -> Some NestedWhole)
+      | _ -> None
+  in
+  shape 0 ty
+
