diff --git a/tests/src/nested-borrows-absent-level.rs b/tests/src/nested-borrows-absent-level.rs
new file mode 100644
index 0000000..1408a2e
--- /dev/null
+++ b/tests/src/nested-borrows-absent-level.rs
@@ -0,0 +1,87 @@
+//@ [!lean] skip
+//@ [lean] subdir=NestedBorrowsAbsentLevel
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Nested borrows whose positions are absent from a value: `count_into(None,
+//! n)` passes `Option<&'2 mut Frame<'3>>`, whose type has positions of `'3`
+//! at level 1 (the frame given back to `'2`), but `None` holds none, so the
+//! call abstraction has no sub-abstraction of level 1 and ends at level 0
+//! with the level-1 inputs of the backward function of `'3` still pending.
+//! They are the value itself, unchanged (`none`).
+
+pub struct Frame<'a> {
+    pub steps: &'a mut u32,
+    pub id: u32,
+}
+fn bump(frame: &mut Frame<'_>, n: u32) -> u32 {
+    *frame.steps = frame.steps.wrapping_add(n);
+    frame.id = frame.id.wrapping_add(1);
+    n.wrapping_mul(2)
+}
+pub fn count_into(execution: Option<&mut Frame<'_>>, n: u32) -> u32 {
+    match execution {
+        Some(frame) => bump(frame, n),
+        None => n,
+    }
+}
+pub fn drive_count(n: u32, some: bool) -> (u32, u32, u32) {
+    let mut s = 5u32;
+    let mut f = Frame { steps: &mut s, id: 1 };
+    let r = if some { count_into(Some(&mut f), n) } else { count_into(None, n) };
+    let id = f.id;
+    *f.steps = f.steps.wrapping_add(100);
+    (r, id, s)
+}
+pub fn drive_none(n: u32) -> (u32, u32) {
+    let mut s = 7u32;
+    let mut f = Frame { steps: &mut s, id: 3 };
+    let r = count_into(None, n);
+    *f.steps = f.steps.wrapping_add(r);
+    let id = f.id;
+    (id, s)
+}
+pub fn count_two(a: Option<&mut Frame<'_>>, b: Option<&mut Frame<'_>>, n: u32) -> u32 {
+    let x = count_into(a, n);
+    let y = count_into(b, n.wrapping_add(1));
+    x.wrapping_add(y)
+}
+pub fn drive_two(n: u32, which: u8) -> (u32, u32, u32, u32) {
+    let mut s = 5u32;
+    let mut t = 9u32;
+    let mut f = Frame { steps: &mut s, id: 1 };
+    let mut g = Frame { steps: &mut t, id: 2 };
+    let r = match which {
+        0 => count_two(None, None, n),
+        1 => count_two(Some(&mut f), None, n),
+        2 => count_two(None, Some(&mut g), n),
+        _ => count_two(Some(&mut f), Some(&mut g), n),
+    };
+    let (fi, gi) = (f.id, g.id);
+    (r, fi, gi, s.wrapping_add(t))
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn drive_count_native() {
+        assert_eq!(drive_count(3, false), (3, 1, 105));
+        assert_eq!(drive_count(3, true), (6, 2, 108));
+        assert_eq!(drive_count(7, true), (14, 2, 112));
+    }
+
+    #[test]
+    fn drive_none_native() {
+        assert_eq!(drive_none(0), (3, 7));
+        assert_eq!(drive_none(4), (3, 11));
+    }
+
+    #[test]
+    fn drive_two_native() {
+        assert_eq!(drive_two(1, 0), (3, 1, 2, 14));
+        assert_eq!(drive_two(1, 1), (4, 2, 2, 15));
+        assert_eq!(drive_two(1, 2), (5, 1, 3, 16));
+        assert_eq!(drive_two(6, 3), (26, 2, 3, 27));
+    }
+}
diff --git a/tests/src/nested-borrows-closure-outlives.rs b/tests/src/nested-borrows-closure-outlives.rs
new file mode 100644
index 0000000..78e5731
--- /dev/null
+++ b/tests/src/nested-borrows-closure-outlives.rs
@@ -0,0 +1,134 @@
+//@ [!lean] skip
+//@ [lean] subdir=NestedBorrowsClosureOutlives
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! A closure capturing a mutable borrow of a closure which captures mutable
+//! borrows (the `DimExpr::map_symbols` shapes of chelis-ir `dag.rs`): the
+//! callee receives `&'r mut Strict<'0, 'u, 'k> { resolve: &'0 mut Bind<'u, 'k> }`
+//! and the region `'u` of the innermost captured borrow is nested under two
+//! ignored mutable borrows. Closure types carry no outlives predicates: the
+//! ones implied by the types of their captured variables (`'u : '0`) are
+//! added before the translation, so that `'u` is a descendant of `'0` in the
+//! regions hierarchy and in the outlive projections of the values given back.
+
+#[derive(Clone)]
+pub enum D {
+    C(u32),
+    S(u32),
+    M(Box<D>, Box<D>),
+}
+
+impl D {
+    fn map_symbols<E>(
+        &self,
+        resolve: &mut impl FnMut(u32) -> Result<Option<u32>, E>,
+    ) -> Result<D, E> {
+        match self {
+            D::C(v) => Ok(D::C(*v)),
+            D::S(name) => Ok(match resolve(*name)? {
+                Some(x) => D::C(x),
+                None => self.clone(),
+            }),
+            D::M(l, r) => Ok(D::M(
+                Box::new(l.map_symbols(resolve)?),
+                Box::new(r.map_symbols(resolve)?),
+            )),
+        }
+    }
+
+    fn checksum(&self) -> u32 {
+        match self {
+            D::C(v) => *v,
+            D::S(name) => name.wrapping_add(1000),
+            D::M(l, r) => l.checksum().wrapping_mul(3).wrapping_add(r.checksum()),
+        }
+    }
+}
+
+/// `dag.rs` `BlasMatmul`: a closure forwarding to the caller's closure, passed
+/// by mutable reference to several calls, then the caller's closure is used
+/// again directly (the lender of the closure's captured borrow is reused).
+fn map_node<E>(
+    a: &D,
+    b: &D,
+    resolve: &mut impl FnMut(u32, bool) -> Result<Option<u32>, E>,
+) -> Result<(D, D, u32), E> {
+    let mut strict = |name: u32| resolve(name, true);
+    let a = a.map_symbols(&mut strict)?;
+    let b = b.map_symbols(&mut strict)?;
+    let extra = match resolve(7, false)? {
+        Some(x) => x,
+        None => 0,
+    };
+    Ok((a, b, extra))
+}
+
+/// The closure captures a mutable borrow (`uses`) and shared borrows
+/// (`k`, `v`): the shared captures are carriers of the values given back.
+fn bind_node(a: &D, b: &D, k: u32, v: u32, uses: &mut u32) -> Result<(D, D, u32), u32> {
+    map_node(a, b, &mut |s, strict| {
+        *uses = uses.wrapping_add(if strict { 1 } else { 100 });
+        if s == 0 {
+            Err(*uses)
+        } else if s == k {
+            Ok(Some(v))
+        } else {
+            Ok(None)
+        }
+    })
+}
+
+pub fn drive_map(k: u32, v: u32, fail: bool) -> (u32, u32, u32, u32) {
+    let a = D::M(Box::new(D::S(3)), Box::new(D::M(Box::new(D::C(5)), Box::new(D::S(4)))));
+    let b = if fail { D::S(0) } else { D::S(4) };
+    let mut uses = 1;
+    let r = bind_node(&a, &b, k, v, &mut uses);
+    // The lender of the closure's captured borrow is used after the call
+    uses = uses.wrapping_mul(2);
+    match r {
+        Ok((a, b, extra)) => (a.checksum(), b.checksum(), extra, uses),
+        Err(e) => (0, 0, e, uses),
+    }
+}
+
+/// The smallest shape: one call through a closure over a closure.
+fn m_call(x: u32, resolve: &mut impl FnMut(u32) -> u32) -> u32 {
+    resolve(x)
+}
+
+fn node_call(x: u32, resolve: &mut impl FnMut(u32, bool) -> u32) -> u32 {
+    let mut strict = |name: u32| resolve(name, true);
+    let a = m_call(x, &mut strict);
+    let b = m_call(a, &mut strict);
+    // The lender of `strict`'s captured borrow, used again
+    resolve(b, false)
+}
+
+pub fn drive_call(x: u32, k: u32) -> (u32, u32) {
+    let mut uses = 0u32;
+    let r = node_call(x, &mut |s, strict| {
+        uses = uses.wrapping_add(if strict { 1 } else { 10 });
+        if s == k { s.wrapping_mul(2) } else { s.wrapping_add(1) }
+    });
+    uses = uses.wrapping_add(1000);
+    (r, uses)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn drive_map_native() {
+        assert_eq!(drive_map(4, 9, false), (3033, 9, 0, 208));
+        assert_eq!(drive_map(3, 1, false), (1022, 1004, 0, 208));
+        assert_eq!(drive_map(4, 9, true), (0, 0, 4, 8));
+    }
+
+    #[test]
+    fn drive_call_native() {
+        assert_eq!(drive_call(1, 1), (4, 1012));
+        assert_eq!(drive_call(5, 6), (13, 1012));
+        assert_eq!(drive_call(3, 9), (6, 1012));
+    }
+}
diff --git a/tests/src/nested-borrows-tuple.rs b/tests/src/nested-borrows-tuple.rs
new file mode 100644
index 0000000..ae746be
--- /dev/null
+++ b/tests/src/nested-borrows-tuple.rs
@@ -0,0 +1,100 @@
+//@ [!lean] skip
+//@ [lean] subdir=NestedBorrowsTuple
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Nested borrows through tuples: a tuple under a mutable borrow holds
+//! positions of a region group at a nested level in some fields only, e.g.
+//! `&'a mut (&'b mut u32, u32)` at the level of the value given back to `'a`
+//! for `'b`. The backward functions only receive and give back those fields,
+//! while a symbolic tuple (e.g., an input passed on to another function) is a
+//! single value.
+
+pub fn g2(s: &mut (&mut u32, u32)) -> u32 {
+    *s.0 = s.0.wrapping_add(1);
+    s.1 = s.1.wrapping_add(1);
+    *s.0
+}
+pub fn call_g2(s: &mut (&mut u32, u32)) -> u32 {
+    g2(s)
+}
+pub fn use_g2(a: u32, b: u32) -> (u32, u32, u32) {
+    let mut a = a;
+    let mut t = (&mut a, b);
+    let r = call_g2(&mut t);
+    *t.0 = t.0.wrapping_add(100);
+    let t1 = t.1;
+    (r, t1, a)
+}
+pub fn h2(s: &mut (u32, &mut u32)) -> u32 {
+    *s.1 = s.1.wrapping_add(s.0);
+    s.0 = 3;
+    *s.1
+}
+pub fn call_h2(s: &mut (u32, &mut u32)) -> u32 {
+    h2(s)
+}
+pub fn use_h2(a: u32, b: u32) -> (u32, u32, u32) {
+    let mut b = b;
+    let mut t = (a, &mut b);
+    let r = call_h2(&mut t);
+    let t0 = t.0;
+    (r, t0, b)
+}
+pub fn g(s: &mut (&mut u32, &mut u32)) -> u32 {
+    *s.0 = s.0.wrapping_add(1);
+    *s.1 = s.1.wrapping_add(10);
+    *s.0
+}
+pub fn call_g(s: &mut (&mut u32, &mut u32)) -> u32 {
+    g(s)
+}
+pub fn use_g(a: u32, b: u32) -> (u32, u32, u32) {
+    let (mut a, mut b) = (a, b);
+    let r = call_g(&mut (&mut a, &mut b));
+    (r, a, b)
+}
+pub fn call1<R>(s: &mut (&mut u32, &mut u32), f: impl FnOnce(&mut (&mut u32, &mut u32)) -> R) -> R {
+    f(s)
+}
+pub fn use1(a: u32, b: u32) -> (u32, u32, u32) {
+    let (mut a, mut b) = (a, b);
+    let r = call1(&mut (&mut a, &mut b), |(x, y)| {
+        **x = x.wrapping_add(1);
+        **y = y.wrapping_add(10);
+        **x
+    });
+    (r, a, b)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn use_g2_native() {
+        assert_eq!(use_g2(0, 0), (1, 1, 101));
+        assert_eq!(use_g2(5, 7), (6, 8, 106));
+        assert_eq!(use_g2(u32::MAX, 3), (0, 4, 100));
+    }
+
+    #[test]
+    fn use_h2_native() {
+        assert_eq!(use_h2(0, 0), (0, 3, 0));
+        assert_eq!(use_h2(5, 7), (12, 3, 12));
+        assert_eq!(use_h2(u32::MAX, 3), (2, 3, 2));
+    }
+
+    #[test]
+    fn use_g_native() {
+        assert_eq!(use_g(0, 0), (1, 1, 10));
+        assert_eq!(use_g(5, 7), (6, 6, 17));
+        assert_eq!(use_g(u32::MAX, 3), (0, 0, 13));
+    }
+
+    #[test]
+    fn use1_native() {
+        assert_eq!(use1(0, 0), (1, 1, 10));
+        assert_eq!(use1(5, 7), (6, 6, 17));
+        assert_eq!(use1(u32::MAX, 3), (0, 0, 13));
+    }
+}
