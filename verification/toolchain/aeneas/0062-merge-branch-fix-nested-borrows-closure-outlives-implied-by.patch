+      | _ -> mk_adt_proj span e (T.FieldId.of_int i) (List.nth tys i))
+
+(** Restrict a whole value [e] to the positions of [shape] *)
+let rec restrict_nested_value (ctx : bs_ctx) (shape : nested_shape) (e : texpr)
+    : texpr =
+  match shape with
+  | NestedWhole -> e
