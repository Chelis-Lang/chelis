+  | ok (a, b) => some (a.val, b.val)
+  | _ => none
+
+def map (k v : Nat) (fail : Bool) := quad (drive_map (u k) (u v) fail)
+def call (x k : Nat) := pair (drive_call (u x) (u k))
+
+#guard map 4 9 false == some (3033, 9, 0, 208)
+#guard map 3 1 false == some (1022, 1004, 0, 208)
+#guard map 4 9 true == some (0, 0, 4, 8)
+
+#guard call 1 1 == some (4, 1012)
+#guard call 5 6 == some (13, 1012)
+#guard call 3 9 == some (6, 1012)
+
+end nested_borrows_closure_outlives.checks
