+
+/-! Evaluate the model of `tests/src/nested-borrows-absent-level.rs` on the
+    inputs of its `native` test module and compare with the native results. -/
+
+namespace nested_borrows_absent_level.checks
+open Aeneas Aeneas.Std Result
+
+def u (x : Nat) : U32 := ⟨BitVec.ofNat _ x⟩
+def u8 (x : Nat) : U8 := ⟨BitVec.ofNat _ x⟩
+
+def triple : Result (U32 × U32 × U32) → Option (Nat × Nat × Nat)
+  | ok (a, b, c) => some (a.val, b.val, c.val)
+  | _ => none
+
+def pair : Result (U32 × U32) → Option (Nat × Nat)
+  | ok (a, b) => some (a.val, b.val)
+  | _ => none
+
+def quad : Result (U32 × U32 × U32 × U32) → Option (Nat × Nat × Nat × Nat)
+  | ok (a, b, c, d) => some (a.val, b.val, c.val, d.val)
+  | _ => none
+
+def count (n : Nat) (s : Bool) := triple (drive_count (u n) s)
+def none1 (n : Nat) := pair (drive_none (u n))
+def two (n w : Nat) := quad (drive_two (u n) (u8 w))
+
+#guard count 3 false == some (3, 1, 105)
+#guard count 3 true == some (6, 2, 108)
+#guard count 7 true == some (14, 2, 112)
+
+#guard none1 0 == some (3, 7)
+#guard none1 4 == some (3, 11)
+
+#guard two 1 0 == some (3, 1, 2, 14)
+#guard two 1 1 == some (4, 2, 2, 15)
+#guard two 1 2 == some (5, 1, 3, 16)
+#guard two 6 3 == some (26, 2, 3, 27)
+
+end nested_borrows_absent_level.checks
