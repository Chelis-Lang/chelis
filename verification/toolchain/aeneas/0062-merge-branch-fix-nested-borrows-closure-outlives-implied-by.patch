+(** Closure types carry no outlives predicates, while rustc infers those of
+    the other structures from the types of their fields (for [struct W<'a, 'b>
+    { f : &'a mut C<'b> }]: ['b : 'a]). Well-formedness of a closure type
+    implies the same predicates for the types of its captured variables:
+    without them, the region of a borrow captured by a closure is not an
+    ancestor of the regions of the value it borrows, neither in the regions
+    hierarchy of a signature ([RegionsHierarchy]) nor in the outlive
+    projections of a value ([TypesAnalysis.compute_outlive_proj_ty]), so the
+    values borrowed through a captured borrow are never given back at their
+    level. We add them like rustc's inference: for every [&'r T] in the type
+    of a field, [T : 'r], and the (substituted) predicates of every ADT which
+    appears in the type of a field. A closure cannot capture itself, so the
+    recursion through the closures captured by a closure terminates.
+    Predicates which mention bound or erased regions are not added. *)
+let add_closure_implied_outlives (crate : crate) : crate =
+  let memo = ref TypeDeclId.Map.empty in
+  let supported_regions =
+    object
+      inherit [_] iter_ty
+
+      method! visit_region ok r =
+        match r with
+        | RVar (Free _) | RStatic -> ()
+        | _ -> ok := false
+    end
+  in
+  let is_supported (visit : bool ref -> unit) : bool =
+    let ok = ref true in
+    visit ok;
+    !ok
+  in
+  let rec predicates_of (id : TypeDeclId.id) : generic_params option =
+    match TypeDeclId.Map.find_opt id crate.type_decls with
+    | None -> None
+    | Some decl -> (
+        match (decl.src, decl.kind) with
+        | ClosureItem _, Struct fields -> (
+            match TypeDeclId.Map.find_opt id !memo with
+            | Some generics -> Some generics
+            | None ->
+                let generics = implied_generics decl.generics fields in
+                memo := TypeDeclId.Map.add id generics !memo;
+                Some generics)
+        | _ -> Some decl.generics)
+  and implied_generics (generics : generic_params) (fields : field list) :
+      generic_params =
+    let regions_outlive = ref (List.rev generics.regions_outlive) in
+    let types_outlive = ref (List.rev generics.types_outlive) in
+    let add_region_outlive (p : (region, region) outlives_pred) =
+      let r0, r1 = p in
+      let pred = { binder_regions = []; binder_value = p } in
+      if
+        is_supported (fun ok ->
+            supported_regions#visit_region ok r0;
+            supported_regions#visit_region ok r1)
+        && not (List.mem pred !regions_outlive)
+      then regions_outlive := pred :: !regions_outlive
+    in
+    let add_type_outlive (p : (ty, region) outlives_pred) =
+      let ty, r = p in
+      let pred = { binder_regions = []; binder_value = p } in
+      if
+        is_supported (fun ok ->
+            supported_regions#visit_ty ok ty;
+            supported_regions#visit_region ok r)
+        && not (List.mem pred !types_outlive)
+      then types_outlive := pred :: !types_outlive
+    in
+    let rec visit_ty (ty : ty) : unit =
+      match ty with
+      | TRef (r, pointee, _) ->
+          add_type_outlive (pointee, r);
+          visit_ty pointee
+      | TAdt { id; generics = args } ->
+          (match id with
+          | TAdtId id -> (
+              match
+                ( TypeDeclId.Map.find_opt id crate.type_decls,
+                  predicates_of id )
+              with
+              | Some decl, Some params ->
+                  let subst =
+                    [%add_loc] Substitute.make_subst_from_generics
+                      (Some decl.item_meta.span) decl.generics args Self
+                  in
+                  let params = Substitute.predicates_substitute subst params in
+                  List.iter
+                    (fun (p : _ region_binder) ->
+                      if p.binder_regions = [] then
+                        add_region_outlive p.binder_value)
+                    params.regions_outlive;
+                  List.iter
+                    (fun (p : _ region_binder) ->
+                      if p.binder_regions = [] then
+                        add_type_outlive p.binder_value)
+                    params.types_outlive
+              | _ -> ())
+          | TTuple | TBuiltin _ -> ());
+          List.iter visit_ty args.types
+      | TArray (ty, _) | TSlice ty | TRawPtr (ty, _) -> visit_ty ty
+      | TVar _ | TLiteral _ | TNever | TTraitType _ | TFnPtr _ | TFnDef _
+      | TDynTrait _ | TPtrMetadata _ | TError _ -> ()
+    in
+    List.iter (fun (f : field) -> visit_ty f.field_ty) fields;
+    {
+      generics with
+      regions_outlive = List.rev !regions_outlive;
+      types_outlive = List.rev !types_outlive;
+    }
+  in
+  let type_decls =
+    TypeDeclId.Map.map
+      (fun (decl : type_decl) ->
+        match (decl.src, decl.kind) with
+        | ClosureItem _, Struct _ -> (
+            match predicates_of decl.def_id with
+            | Some generics -> { decl with generics }
+            | None -> decl)
+        | _ -> decl)
+      crate.type_decls
+  in
+  { crate with type_decls }
+
 let apply_passes (crate : crate) : crate =
   (* Passes that apply to the whole crate *)
+  let crate = add_closure_implied_outlives crate in
   let crate = normalize_modeled_trait_specializations crate in
   (* Before [order_method_region_params]: an instance's shape binds the
      parameters in their original order *)
