+//@ [!lean] skip
+//@ [lean] subdir=NestedBorrowsJoinThenLoop
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::option::{core::option::Option} --include core::ops::deref::{core::ops::deref::Deref} --include core::ops::deref::{core::ops::deref::DerefMut}
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! A match on `execution.as_deref_mut()` (a reborrow of an optional frame
+//! whose field `ctx` borrows the caller), then a loop over the same reborrow:
+//! the loop abstraction of the frame's region is staged at level 1 (the first
+//! stage of `as_deref_mut` in the loop receives the inner borrows of the value
+//! given back to the loop state), and its continuation at the loop entry
+//! applies the continuation of the join before the loop, which is not staged
+//! (its branches applied the first stage of `as_deref_mut` to the values they
+//! give): it routes the values at level 1 unchanged.
+
+pub struct Frame<'a> {
+    pub steps: &'a [u32],
+    pub ctx: &'a mut u32,
+    pub pos: usize,
+}
+
+impl<'a> Frame<'a> {
+    pub fn advance(&mut self) -> u32 {
+        let s = self.steps[self.pos];
+        self.pos += 1;
+        *self.ctx = (*self.ctx).wrapping_add(s);
+        s
+    }
+}
+
+/// A join over a reborrow, then a loop advancing the frame
+pub fn join_then_loop(mut execution: Option<&mut Frame<'_>>, n: u32) -> u32 {
+    let mut acc = match execution.as_deref_mut() {
+        Some(f) => f.advance(),
+        None => 0,
+    };
+    let mut i = 1;
+    while i < n {
+        if let Some(f) = execution.as_deref_mut() {
+            acc = acc.wrapping_add(f.advance());
+        }
+        i += 1;
+    }
+    acc
+}
+
+/// The same, the frame written after the loop
+pub fn join_then_loop_write(mut execution: Option<&mut Frame<'_>>, n: u32) -> u32 {
+    let mut acc = match execution.as_deref_mut() {
+        Some(f) => f.advance(),
+        None => 0,
+    };
+    let mut i = 1;
+    while i < n {
+        if let Some(f) = execution.as_deref_mut() {
+            acc = acc.wrapping_add(f.advance());
+        }
+        i += 1;
+    }
+    if let Some(f) = execution {
+        *f.ctx = (*f.ctx).wrapping_add(100);
+    }
+    acc
+}
+
+pub fn run_join_then_loop(f: &mut Frame<'_>, some: bool, n: u32) -> u32 {
+    if some { join_then_loop(Some(f), n) } else { join_then_loop(None, n) }
+}
+
+pub fn run_join_then_loop_write(f: &mut Frame<'_>, some: bool, n: u32) -> u32 {
+    if some { join_then_loop_write(Some(f), n) } else { join_then_loop_write(None, n) }
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    /// `(result, ctx, pos)` after running `run` on a frame over `steps`, the
+    /// caller then setting the frame's `ctx` to `set` (if any)
+    fn on_frame<R>(
+        ctx: u32,
+        pos: usize,
+        set: Option<u32>,
+        run: impl FnOnce(&mut Frame<'_>) -> R,
+    ) -> (R, u32, usize) {
+        let steps = [3u32, 5, 7, 11];
+        let mut c = ctx;
+        let mut f = Frame { steps: &steps, ctx: &mut c, pos };
+        let r = run(&mut f);
+        if let Some(s) = set {
+            *f.ctx = s;
+        }
+        let pos = f.pos;
+        (r, c, pos)
+    }
+
+    #[test]
+    fn join_then_loop_native() {
+        let run = |some, n| move |f: &mut Frame<'_>| run_join_then_loop(f, some, n);
+        assert_eq!(on_frame(10, 0, None, run(true, 0)), (3, 13, 1));
+        assert_eq!(on_frame(10, 0, None, run(true, 1)), (3, 13, 1));
+        assert_eq!(on_frame(10, 0, None, run(true, 3)), (15, 25, 3));
+        assert_eq!(on_frame(10, 1, None, run(true, 3)), (23, 33, 4));
+        assert_eq!(on_frame(10, 1, None, run(false, 3)), (0, 10, 1));
+        assert_eq!(on_frame(10, 1, Some(99), run(true, 2)), (12, 99, 3));
+        assert_eq!(on_frame(u32::MAX, 0, None, run(true, 2)), (8, 7, 2));
+        assert_eq!(on_frame(10, 2, None, run(true, 2)), (18, 28, 4));
+    }
+
+    #[test]
+    #[should_panic]
+    fn join_then_loop_out_of_steps_panics() {
+        on_frame(10, 3, None, |f| run_join_then_loop(f, true, 2));
+    }
+
+    #[test]
+    #[should_panic]
+    fn join_then_loop_join_out_of_steps_panics() {
+        on_frame(10, 4, None, |f| run_join_then_loop(f, true, 1));
+    }
+
+    #[test]
+    fn join_then_loop_write_native() {
+        let run = |some, n| move |f: &mut Frame<'_>| run_join_then_loop_write(f, some, n);
+        assert_eq!(on_frame(10, 0, None, run(true, 0)), (3, 113, 1));
+        assert_eq!(on_frame(10, 0, None, run(true, 3)), (15, 125, 3));
+        assert_eq!(on_frame(10, 1, None, run(true, 3)), (23, 133, 4));
+        assert_eq!(on_frame(10, 1, None, run(false, 3)), (0, 10, 1));
+        assert_eq!(on_frame(10, 1, Some(99), run(true, 2)), (12, 99, 3));
+        assert_eq!(on_frame(u32::MAX, 0, None, run(true, 2)), (8, 107, 2));
+        assert_eq!(on_frame(10, 2, None, run(true, 2)), (18, 128, 4));
+    }
+}
