+import NestedBorrowsClosureSharedClosureArms.NestedBorrowsClosureSharedClosureArms
+
+/-! Evaluate the model of `tests/src/nested-borrows-closure-shared-closure-arms.rs`
+    on the inputs of its `native` test module and compare with the native
+    results: the result of `analyze`, and the `Out` given back by the call
+    (the facts pushed at every node, then a fact pushed by the caller through
+    the borrow given back, as their number and bit mask, and the sum of the
+    node numbers). -/
+
+namespace nested_borrows_closure_shared_closure_arms.checks
+open Aeneas Aeneas.Std Result
+
+def u (x : Nat) : U32 := ⟨BitVec.ofNat _ x⟩
+def u8 (x : Nat) : U8 := ⟨BitVec.ofNat _ x⟩
+def us (x : Nat) : Usize := ⟨BitVec.ofNat _ x⟩
+
+def runAnalyze (shape a b c s0 s1 node : Nat) : Option (Bool × Nat × Nat × Nat) :=
+  match run_analyze (u8 shape) (u a) (u b) (u c) (u s0) (u s1) (us node) with
+  | ok (r, facts, mask, nodes) => some (r, facts.val, mask.val, nodes.val)
+  | _ => none
+
+-- run_analyze_native
+#guard runAnalyze 0 5 0 0 5 7 3 == some (true, 2, 3, 3)
+#guard runAnalyze 0 6 0 0 5 7 3 == some (false, 2, 2, 3)
+#guard runAnalyze 1 1 2 3 2 9 0 == some (true, 4, 14, 1)
+#guard runAnalyze 1 1 2 3 8 9 4 == some (false, 4, 8, 13)
+#guard runAnalyze 2 1 2 3 3 9 0 == some (false, 5, 16, 3)
+#guard runAnalyze 2 1 2 3 2 1 10 == some (true, 5, 29, 43)
+#guard runAnalyze 2 4 5 6 7 8 1 == some (false, 5, 16, 7)
+#guard runAnalyze 3 1 2 3 1 2 6 == some (false, 2, 2, 6)
+#guard runAnalyze 3 1 2 3 9 9 0 == some (false, 2, 2, 0)
+
+end nested_borrows_closure_shared_closure_arms.checks
