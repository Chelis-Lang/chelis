+++ b/tests/src/nested-borrows-closure-state.rs
@@ -0,0 +1,109 @@
+//@ [!lean] skip
+//@ [lean] subdir=NestedBorrowsClosureState
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Closures forwarding `&mut impl FnMut(u32, u8)` (the `map_expressions` /
+//! `try_map_expressions` / `try_map_payloads` shapes of chelis_deep
+//! `annotations_transform.rs` and `authoring.rs`, with arguments by value):
+//! the closure of `try_map_expressions` captures `f: &'0 mut F`, whose type
+//! parameter `F` is instantiated with the closure of `map_expressions` (or
+//! `map_count`), which holds a borrow of the type parameter of the caller's
+//! closure. The canonical `FnMut` state of the closure of
+//! `try_map_expressions` recombines the closure given back to `'0` with the
+//! values given back to the borrows it holds, under which a type parameter
+//! lies (`map_count` counts its calls through such a borrow).
+
+pub struct M {
+    pub a: u32,
+    pub b: u32,
+}
+
+impl M {
+    pub fn try_map_payloads<E>(
+        &self,
+        f: &mut impl FnMut(u32, u8) -> Result<u32, E>,
+    ) -> Result<M, E> {
+        let a = f(self.a, 0)?;
+        let b = f(self.b, 1)?;
+        Ok(M { a, b })
+    }
+
+    pub fn try_map_expressions<E>(
+        &self,
+        f: &mut impl FnMut(u32, u8) -> Result<u32, E>,
+    ) -> Result<M, E> {
+        self.try_map_payloads(&mut |v, role| Ok(f(v, role)?.wrapping_add(1)))
+    }
+
+    pub fn map_expressions(&self, f: &mut impl FnMut(u32, u8) -> u32) -> Result<M, ()> {
+        self.try_map_expressions(&mut |v, role| Ok(f(v, role)))
+    }
+
+    pub fn map_count(&self, f: &mut impl FnMut(u32, u8) -> u32) -> (Result<M, ()>, u32) {
+        let mut n = 0u32;
+        let r = self.try_map_expressions(&mut |v, role| {
+            n = n.wrapping_add(1);
+            Ok(f(v, role))
+        });
+        (r, n)
+    }
+}
+
+pub fn use_map(a: u32, b: u32, d: u32) -> (u32, u32) {
+    let m = M { a, b };
+    let r = m.map_expressions(&mut |v, role| v.wrapping_add(d).wrapping_add(role as u32));
+    match r {
+        Ok(m) => (m.a, m.b),
+        Err(()) => (0, 0),
+    }
+}
+
+pub fn use_count(a: u32, b: u32, d: u32) -> (u32, u32, u32) {
+    let m = M { a, b };
+    let (r, n) = m.map_count(&mut |v, role| v.wrapping_mul(d).wrapping_add(role as u32));
+    match r {
+        Ok(m) => (m.a, m.b, n),
+        Err(()) => (0, 0, n),
+    }
+}
+
+pub fn use_try(a: u32, b: u32, limit: u32) -> (u32, u32, u32, bool) {
+    let m = M { a, b };
+    let mut seen = 0u32;
+    let r = m.try_map_expressions(&mut |v: u32, role: u8| {
+        seen = seen.wrapping_add(1);
+        if v > limit {
+            Err(role)
+        } else {
+            Ok(v.wrapping_mul(2))
+        }
+    });
+    match r {
+        Ok(m) => (m.a, m.b, seen, true),
+        Err(role) => (role as u32, 0, seen, false),
+    }
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn use_map_native() {
+        assert_eq!(use_map(1, 2, 10), (12, 14));
+        assert_eq!(use_map(u32::MAX, 0, 1), (1, 3));
+    }
+
+    #[test]
+    fn use_count_native() {
+        assert_eq!(use_count(3, 4, 5), (16, 22, 2));
+        assert_eq!(use_count(u32::MAX, 7, 2), (u32::MAX, 16, 2));
+    }
+
+    #[test]
+    fn use_try_native() {
+        assert_eq!(use_try(1, 2, 5), (3, 5, 2, true));
+        assert_eq!(use_try(1, 9, 5), (1, 0, 2, false));
+        assert_eq!(use_try(9, 1, 5), (0, 0, 1, false));
+    }
+}
