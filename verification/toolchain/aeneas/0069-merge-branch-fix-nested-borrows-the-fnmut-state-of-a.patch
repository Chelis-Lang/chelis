+import NestedBorrowsClosureState.NestedBorrowsClosureState
+
+/-! Evaluate the model of `tests/src/nested-borrows-closure-state.rs` on
+    the inputs of its `native` test module and compare with the native results. -/
+
+namespace nested_borrows_closure_state.checks
+open Aeneas Aeneas.Std Result
+
+def u (x : Nat) : U32 := ⟨BitVec.ofNat _ x⟩
+
+def max := 4294967295
+
+def useMap (a b d : Nat) : Option (Nat × Nat) :=
+  match use_map (u a) (u b) (u d) with
+  | ok (x, y) => some (x.val, y.val)
+  | _ => none
+
+def useCount (a b d : Nat) : Option (Nat × Nat × Nat) :=
+  match use_count (u a) (u b) (u d) with
+  | ok (x, y, n) => some (x.val, y.val, n.val)
+  | _ => none
+
+def useTry (a b limit : Nat) : Option (Nat × Nat × Nat × Bool) :=
+  match use_try (u a) (u b) (u limit) with
+  | ok (x, y, seen, ok') => some (x.val, y.val, seen.val, ok')
+  | _ => none
+
+#guard useMap 1 2 10 == some (12, 14)
+#guard useMap max 0 1 == some (1, 3)
+
+#guard useCount 3 4 5 == some (16, 22, 2)
+#guard useCount max 7 2 == some (max, 16, 2)
+
+#guard useTry 1 2 5 == some (3, 5, 2, true)
+#guard useTry 1 9 5 == some (1, 0, 2, false)
+#guard useTry 9 1 5 == some (0, 0, 1, false)
+
+end nested_borrows_closure_state.checks
