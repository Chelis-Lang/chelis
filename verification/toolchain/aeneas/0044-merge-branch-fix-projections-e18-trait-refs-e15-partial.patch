+(** The borrow projections which were ended at level [abs_level] in the input
+    of a continuation, with their paths from the root of the input.
+
+    Such a projection appears in the value given back to a mutable loan of the
+    input, one level deeper than the loan: its inner borrows are borrowed from
+    the abstraction. *)
+let cont_input_nested_borrows (abs_level : abs_level) (input : V.tevalue) :
+    (value_path_step list * V.ended_proj_borrow_meta) list =
+  let found = ref [] in
+  let rec visit level rev_path (v : V.tevalue) =
+    match v.value with
+    | V.EAdt { variant_id; fields; _ } ->
+        List.iteri
+          (fun i field -> visit level (PField (variant_id, i) :: rev_path) field)
+          fields
+    | V.ELoan (V.EEndedMutLoan { child; given_back; _ })
+    | V.ELoan (V.EEndedIgnoredMutLoan { child; given_back; _ }) ->
+        visit level (PDeref :: rev_path) child;
+        visit (level + 1) (PDeref :: rev_path) given_back
+    | V.ESymbolic (_, V.EEndedProjBorrows { mvalues; _ }) when level = abs_level
+      -> found := (List.rev rev_path, mvalues) :: !found
+    | _ -> ()
+  in
+  visit 0 [] input;
+  List.rev !found
+
+(** Whether a value given back by an abstraction carries mutable borrows of the
+    abstraction: the value given back for shared borrows is ignored. *)
+let gives_back_mut (ctx : bs_ctx) (abs : V.abs) (sv : V.symbolic_value) : bool
+    =
+  TypesUtils.ty_has_mut_borrow_for_region_in_set ctx.type_ctx.type_infos
+    abs.regions.owned sv.sv_ty
+
+(** The symbolic values given back by the mutable borrows of an abstraction
+    which were ended at level [abs_level]. *)
+let abs_ended_borrows_at_level (ctx : bs_ctx) (abs : V.abs)
+    (abs_level : abs_level) : V.symbolic_value list =
+  let found = ref [] in
+  let visitor =
+    object
+      inherit [_] InterpBorrowsCore.iter_tavalue_with_levels as super
+      method incr_level level = level + 1
+
+      method! visit_AEndedMutBorrow level meta child =
+        if level = abs_level then found := meta.given_back :: !found;
+        super#visit_AEndedMutBorrow level meta child
+
+      method! visit_aended_proj_borrows level proj =
+        if level = abs_level && gives_back_mut ctx abs proj.mvalues.given_back
+        then found := proj.mvalues.given_back :: !found;
+        super#visit_aended_proj_borrows level proj
+    end
+  in
+  List.iter (visitor#visit_tavalue 0) abs.avalues;
+  List.rev !found
+
+(** The mutable borrows of the input of a continuation abstraction which were
+    ended at level 1 (see [cont_input_nested_borrows]). *)
+let cont_input_nested_mut_borrows (ctx : bs_ctx) (abs : V.abs)
+    (input : V.tevalue) :
+    (value_path_step list * V.ended_proj_borrow_meta) list =
+  List.filter
+    (fun (_, (mvalues : V.ended_proj_borrow_meta)) ->
+      gives_back_mut ctx abs mvalues.given_back)
+    (cont_input_nested_borrows 1 input)
+
+(** The values given back at level 1 by a continuation abstraction (join, loop
+    or reborrow).
+
+    The continuation maps the value it lends back to the value it borrows (see
+    [abs_cont]): both have the same shape. Its level-1 loans are nested in its
+    borrow of the whole value: they consumed the current value of the inner
+    borrows of that value (see [abs_nested_loan_updates]). Its level-1 borrows
+    lie in the value given back to a mutable loan of its input, at some path:
+    the value given back for such a borrow is its carrier updated with the
+    current value found at the same path. *)
+let cont_nested_given_back_bindings (ctx : bs_ctx) (abs : V.abs) :
+    bs_ctx * (V.symbolic_value * tpat * texpr) list =
+  let span = ctx.span in
+  let input =
+    match abs.cont with
+    | Some { input = Some input; _ } -> input
+    | _ -> [%internal_error] span
+  in
+  let update_ty, update_regions, update =
+    match abs_nested_loan_updates ctx abs with
+    | [ (1, update) ] -> update
+    | _ ->
+        [%craise] span
+          "Nested borrows: the level-1 borrows of a join, loop or reborrow \
+           abstraction need exactly one current update"
+  in
+  let binding ctx (path, (mvalues : V.ended_proj_borrow_meta)) =
+    let carrier_ty = mvalues.given_back.sv_ty in
+    let carrier =
+      symbolic_value_to_texpr ctx { sv_id = mvalues.consumed; sv_ty = carrier_ty }
+    in
+    let leaf ty (e : texpr) =
+      [%unwrap_with_span] span
+        (recombine_nested_projection_exprs span ctx.decls_ctx abs.regions.owned
+           carrier_ty carrier
+           [ (ty, update_regions, e) ]
+           ctx.fresh_fvar_id)
+        "Nested reborrow has no authoritative current update"
+    in
+    let value =
+      project_along_path span ctx.decls_ctx ctx.fresh_fvar_id update_ty update
+        path leaf carrier
+    in
+    let ctx, var = fresh_var_for_symbolic_value mvalues.given_back ctx in
+    (ctx, (mvalues.given_back, mk_tpat_from_fvar None var, value))
+  in
+  List.fold_left_map binding ctx (cont_input_nested_mut_borrows ctx abs input)
