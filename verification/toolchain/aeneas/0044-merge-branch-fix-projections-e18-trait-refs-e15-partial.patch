+  let (r1, f1) ← outer (some (frame 0)) (u 10)
+  let f1 ← match f1 with | some f => ok f | none => fail .panic
+  let (r2, f2) ← outer (some f1) (u 1)
+  let f2 ← match f2 with | some f => ok f | none => fail .panic
+  ok (r1, f1.pos.val, r2, f2.pos.val)
+
+def checkThenStepTwice : Result (U32 × Nat × U32 × Nat) := do
+  let (r1, f1) ← check_then_step (some (frame 0)) (u 10)
+  let f1 ← match f1 with | some f => ok f | none => fail .panic
+  let (r2, f2) ← check_then_step (some f1) (u 1)
+  let f2 ← match f2 with | some f => ok f | none => fail .panic
+  ok (r1, f1.pos.val, r2, f2.pos.val)
+
+def res4 (r : Result (U32 × Nat × U32 × Nat)) : Option (Nat × Nat × Nat × Nat) :=
+  match r with
+  | ok (a, b, c, d) => some (a.val, b, c.val, d)
+  | _ => none
+
