@@ -0,0 +1,67 @@
+//@ [!lean] skip
+//@ [lean] subdir=SpecializedClosureClauses
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! A closure that captures `&mut S` keeps the trait clause of the generic
+//! callback it also captures, so `--monomorphize-mut` specializes the closure
+//! traits for it with a trait-clause parameter, e.g.
+//! `Fn::<with_state::closure<'_, S, R, F>[TraitClause@0], (&mut u32,), R>`.
+//! The call through such a clause (`f(x)` in `apply`) supplies the trait refs
+//! of the specialized declaration along with its types.
+//! The generated Lean does not compile yet (so it is not a lakefile target):
+//! the specialized `apply` binds its `Fn<closure[TraitClause@1]>` clause before
+//! the closure's own clause `TraitClause@1` (Charon's partial
+//! monomorphization appends merged clauses), and the `FnOnce`/`FnMut`
+//! implementations for the closure, which carries `&'0 mut S`, return the
+//! closure state in a different shape than the specialized declarations;
+//! the user closures' `FnMut<(&mut u32, S)>` `call_mut` also return the
+//! closure and the argument in the opposite order of the pair model.
+
+pub fn apply<R>(x: &mut u32, f: impl Fn(&mut u32) -> R) -> R {
+    f(x)
+}
+
+pub fn with_state<S: Copy, R>(x: &mut u32, state: &mut S, f: impl Fn(&mut u32, S) -> R) -> R {
+    apply(x, move |y| f(y, *state))
+}
+
+/// `with_state` with a factor read through the capture.
+pub fn scaled(x: &mut u32, k: &mut u32) -> u32 {
+    with_state(x, k, |x, k| {
+        *x = x.wrapping_mul(k);
+        *x
+    })
+}
+
+/// `with_state` at another instance, with a different result type.
+pub fn offset(x: &mut u32, base: &mut u64) -> u64 {
+    with_state(x, base, |x, base| {
+        *x = x.wrapping_add(1);
+        base.wrapping_add(*x as u64)
+    })
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn scaled_reads_the_capture() {
+        let (mut x, mut k) = (3, 7);
+        assert_eq!(scaled(&mut x, &mut k), 21);
+        assert_eq!((x, k), (21, 7));
+        let (mut x, mut k) = (0x8000_0001, 2);
+        assert_eq!(scaled(&mut x, &mut k), 2);
+        assert_eq!((x, k), (2, 2));
+    }
+
+    #[test]
+    fn offset_reads_the_capture() {
+        let (mut x, mut base) = (4, 100);
+        assert_eq!(offset(&mut x, &mut base), 105);
+        assert_eq!((x, base), (5, 100));
+        let (mut x, mut base) = (u32::MAX, u64::MAX);
+        assert_eq!(offset(&mut x, &mut base), u64::MAX);
+        assert_eq!((x, base), (0, u64::MAX));
+    }
+}
