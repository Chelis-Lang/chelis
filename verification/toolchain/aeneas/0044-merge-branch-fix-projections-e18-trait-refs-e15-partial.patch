+def noCounter (r : Result (U32 × Option Counter × (Option Counter → Option Counter))) :
+    Option (Nat × Bool) :=
+  match r with
+  | ok (v, c, back) => some (v.val, c.isNone && (back none).isNone)
+  | _ => none
+
+#guard noCounter (has_counter none (u 3)) == some (3, true)
+
+end option_mut_nested_region.checks
