index 0000000..c920670
--- /dev/null
+++ b/tests/src/option-mut-nested-region.rs
@@ -0,0 +1,130 @@
+//@ [!lean] skip
+//@ [lean] subdir=OptionMutNestedRegion
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! An optional mutable borrow of a struct which has its own lifetime
+//! (`Option<&mut Frame<'_>>`), matched, joined, inspected again and forwarded
+//! to a callee, as `chelis_ir::eval` threads its execution frame. The
+//! abstractions which reborrow or join such a value own the outer region
+//! only: they end at two levels.
+//! `OptionMutNestedRegion/Checks.lean` evaluates the model on the inputs of
+//! the `native` test module below and compares with the native results.
+
+/// A frame whose own lifetime only borrows shared data
+pub struct Frame<'a> {
+    steps: &'a [u32],
+    pos: usize,
+}
+
+impl<'a> Frame<'a> {
+    pub fn advance(&mut self) -> u32 {
+        let s = self.steps[self.pos];
+        self.pos += 1;
+        s
+    }
+}
+
+/// A frame whose own lifetime also borrows mutable state
+pub struct Counter<'a> {
+    steps: &'a [u32],
+    total: &'a mut u32,
+    pos: usize,
+}
+
+impl<'a> Counter<'a> {
+    pub fn advance(&mut self) -> u32 {
+        let s = self.steps[self.pos];
+        self.pos += 1;
+        *self.total += s;
+        s
+    }
+}
+
+pub fn step(execution: Option<&mut Frame<'_>>, n: u32) -> u32 {
+    match execution {
+        Some(f) => n + f.advance(),
+        None => n,
+    }
+}
+
+/// Advance the frame if there is one, join, then use what was observed
+pub fn step_then_check(execution: Option<&mut Frame<'_>>, n: u32) -> u32 {
+    let mut acc = n;
+    let stepped = match execution {
+        Some(f) => {
+            acc += f.advance();
+            true
+        }
+        None => false,
+    };
+    if stepped {
+        acc += 1;
+    }
+    acc
+}
+
+/// Join while the frame is live, then advance it
+pub fn check_then_step(execution: Option<&mut Frame<'_>>, n: u32) -> u32 {
+    let mut acc = n;
+    if n > 5 {
+        acc += 1;
+    } else {
+        acc += 2;
+    }
+    match execution {
+        Some(f) => acc + f.advance(),
+        None => acc,
+    }
+}
+
+/// Forward the optional frame, as `eval_tensor_internal` does
+pub fn outer(execution: Option<&mut Frame<'_>>, n: u32) -> u32 {
+    step_then_check(execution, n)
+}
+
+pub fn has_counter(execution: Option<&mut Counter<'_>>, n: u32) -> u32 {
+    if execution.is_some() {
+        n + 1
+    } else {
+        n
+    }
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn frames() {
+        let steps = [5, 7];
+        let mut frame = Frame { steps: &steps, pos: 0 };
+        assert_eq!(outer(Some(&mut frame), 10), 16);
+        assert_eq!(frame.pos, 1);
+        assert_eq!(outer(Some(&mut frame), 1), 9);
+        assert_eq!(frame.pos, 2);
+        assert_eq!(outer(None, 3), 3);
+        let mut frame = Frame { steps: &steps, pos: 1 };
+        assert_eq!(step(Some(&mut frame), 2), 9);
+        assert_eq!(frame.pos, 2);
+        assert_eq!(step(None, 4), 4);
+        let mut frame = Frame { steps: &steps, pos: 0 };
+        assert_eq!(check_then_step(Some(&mut frame), 10), 16);
+        assert_eq!(frame.pos, 1);
+        assert_eq!(check_then_step(Some(&mut frame), 1), 10);
+        assert_eq!(frame.pos, 2);
+        assert_eq!(check_then_step(None, 6), 7);
+    }
+
+    #[test]
+    fn counters() {
+        let steps = [5, 7];
+        let mut total = 100;
+        let mut counter = Counter { steps: &steps, total: &mut total, pos: 0 };
+        assert_eq!(has_counter(Some(&mut counter), 3), 4);
+        assert_eq!(counter.advance(), 5);
+        assert_eq!(has_counter(Some(&mut counter), 1), 2);
+        assert_eq!(counter.pos, 1);
+        assert_eq!(total, 105);
+        assert_eq!(has_counter(None, 3), 3);
+    }
+}
