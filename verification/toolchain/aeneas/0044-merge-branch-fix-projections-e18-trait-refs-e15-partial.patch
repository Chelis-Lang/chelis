+#guard withPos (outer none (u 3)) == some (3, none)
+#guard withPos (step (some (frame 1)) (u 2)) == some (9, some 2)
+#guard withPos (step none (u 4)) == some (4, none)
+#guard res4 checkThenStepTwice == some (16, 1, 10, 2)
