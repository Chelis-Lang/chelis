+import CharSwitch.CharSwitch
+
+/-! Evaluate the model of `tests/src/char-switch.rs` on the inputs of its
+    `native` test module and compare with the native results. -/
+
+namespace char_switch.checks
+open Aeneas Aeneas.Std Result
+
+def okU32 : Result U32 → Option Nat
+  | ok a => some a.val
+  | _ => none
+
+def vowels (s : String) : Option Nat :=
+  match Str.ofString s with
+  | ok s => okU32 (count_vowels s)
+  | _ => none
+
+#guard okU32 (classify 'a') == some 1
+#guard okU32 (classify 'c') == some 2
+#guard okU32 (classify '\'') == some 2
+#guard okU32 (classify '\\') == some 5
+#guard okU32 (classify '\n') == some 5
+#guard okU32 (classify 'é') == some 6
+#guard okU32 (classify '€') == some 6
+#guard okU32 (classify '😀') == some 4
+#guard okU32 (classify 'z') == some 3
+
+#guard vowels "education" == some 5
+#guard vowels "rhythm" == some 10
+#guard vowels "" == some 0
+#guard vowels "été" == some 0
+
+end char_switch.checks
