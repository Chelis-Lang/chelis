@@ -0,0 +1,53 @@
+//@ [!lean] skip
+//@ [lean] subdir=CharSwitch
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Matches on `char`, including grouped values and characters which are not
+//! printable ASCII. `CharSwitch/Checks.lean` evaluates the model on the
+//! inputs of the `native` test module below and compares with the native
+//! results.
+
+pub fn classify(c: char) -> u32 {
+    match c {
+        'a' => 1,
+        'b' | 'c' | '\'' => 2,
+        '\\' | '\n' => 5,
+        'é' | '€' => 6,
+        '😀' => 4,
+        _ => 3,
+    }
+}
+
+pub fn count_vowels(s: &str) -> u32 {
+    let mut n = 0u32;
+    for c in s.chars() {
+        match c {
+            'a' | 'e' | 'i' | 'o' | 'u' => n += 1,
+            'y' => n += 10,
+            _ => {}
+        }
+    }
+    n
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn chars() {
+        assert_eq!(classify('a'), 1);
+        assert_eq!(classify('c'), 2);
+        assert_eq!(classify('\''), 2);
+        assert_eq!(classify('\\'), 5);
+        assert_eq!(classify('\n'), 5);
+        assert_eq!(classify('é'), 6);
+        assert_eq!(classify('€'), 6);
+        assert_eq!(classify('😀'), 4);
+        assert_eq!(classify('z'), 3);
+        assert_eq!(count_vowels("education"), 5);
+        assert_eq!(count_vowels("rhythm"), 10);
+        assert_eq!(count_vowels(""), 0);
+        assert_eq!(count_vowels("été"), 0);
+    }
+}
diff --git a/tests/src/collect-adapters.rs b/tests/src/collect-adapters.rs
new file mode 100644
index 0000000..8b33afe
--- /dev/null
+++ b/tests/src/collect-adapters.rs
@@ -0,0 +1,47 @@
+//@ [!lean] skip
+//@ [lean] subdir=CollectAdapters
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::iter::adapters::map::Map --include core::iter::adapters::copied::Copied --include core::iter::adapters::rev::Rev
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Collectors over Chain, Rev and FlatMap (admitted by CollectionContracts).
+//! CollectAdapters/Checks.lean compares the model with the native results
+//! asserted in the native test module.
+
+pub fn chained(first: u32, rest: &[u32]) -> Vec<u32> {
+    std::iter::once(first).chain(rest.iter().map(|x| *x * 10)).collect()
+}
+
+pub fn chained_slices(a: &[u32], b: &[u32]) -> Vec<u32> {
+    a.iter().chain(b.iter()).copied().collect()
+}
+
+pub fn reversed_into(stack: &mut Vec<(u32, bool)>, xs: &[u32]) {
+    stack.extend(xs.iter().rev().map(|x| (*x, *x % 2 == 0)));
+}
+
+pub fn flat(groups: Vec<Vec<u32>>) -> Vec<u32> {
+    groups.into_iter().flat_map(|g| g.into_iter()).map(|x| x + 1).collect()
+}
+
+pub fn chain_result(a: &[u32], b: &[u32]) -> Result<Vec<u32>, u32> {
+    a.iter().chain(b.iter()).map(|x| if *x > 100 { Err(*x) } else { Ok(*x) }).collect()
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn adapters() {
+        assert_eq!(chained(7, &[1, 2]), vec![7, 10, 20]);
+        assert_eq!(chained(0, &[]), vec![0]);
+        assert_eq!(chained_slices(&[1, 2], &[3]), vec![1, 2, 3]);
+        assert_eq!(chained_slices(&[], &[]), Vec::<u32>::new());
+        let mut s = vec![(9u32, false)];
+        reversed_into(&mut s, &[1, 2, 3]);
+        assert_eq!(s, vec![(9, false), (3, false), (2, true), (1, false)]);
+        assert_eq!(flat(vec![vec![1, 2], vec![], vec![3]]), vec![2, 3, 4]);
+        assert_eq!(flat(vec![]), Vec::<u32>::new());
+        assert_eq!(chain_result(&[1, 2], &[3]), Ok(vec![1, 2, 3]));
+        assert_eq!(chain_result(&[1, 200], &[300]), Err(200));
+    }
+}
