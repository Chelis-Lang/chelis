+import ArrayOfBorrowsLoop.ArrayOfBorrowsLoop
+
+/-! Evaluate the model of `tests/src/array-of-borrows-loop.rs` on the inputs
+    of its `native` test module and compare with the native results. -/
+
+namespace array_of_borrows_loop.checks
+open Aeneas Aeneas.Std Result
+
+def run (x y z limit : Nat) : Option (Option (Nat × Nat)) :=
+  match first_larger ⟨BitVec.ofNat _ x⟩ ⟨BitVec.ofNat _ y⟩ ⟨BitVec.ofNat _ z⟩
+      ⟨BitVec.ofNat _ limit⟩ with
+  | ok r => some (r.map (fun (v, i) => (v.val, i.val)))
+  | _ => none
+
+#guard run 1 5 9 4 == some (some (5, 1))
+#guard run 7 5 9 4 == some (some (7, 0))
+#guard run 1 2 9 4 == some (some (9, 2))
+#guard run 1 2 3 4 == some none
+
+end array_of_borrows_loop.checks
