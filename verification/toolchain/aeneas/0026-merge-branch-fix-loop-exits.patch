+import NestedLoopExits.NestedLoopExits
+
+/-! Evaluate the model of `tests/src/nested-loop-exits.rs` on the inputs of
+    its `native` test module and compare with the native results. -/
+
+namespace nested_loop_exits.checks
+open Aeneas Aeneas.Std Result
+
+def sl (xs : List Nat) (h : xs.length ≤ Usize.max := by scalar_tac) : Slice U32 :=
+  ⟨xs.map (fun x => (⟨BitVec.ofNat _ x⟩ : U32)), by simpa using h⟩
+
+def u32 (x : Nat) : U32 := ⟨BitVec.ofNat _ x⟩
+
+def okBool : Result Bool → Option Bool
+  | ok b => some b
+  | _ => none
+
+def okPair : Result (U32 × U32) → Option (Nat × Nat)
+  | ok (a, b) => some (a.val, b.val)
+  | _ => none
+
+def okU32 : Result U32 → Option Nat
+  | ok a => some a.val
+  | _ => none
+
+-- Inner loop in tail position, early returns from both loops, inner continue
+#guard okBool (scan (sl [5, 4]) (sl [3, 2])) == some true
+#guard okBool (scan (sl [5, 0]) (sl [3])) == some false
+#guard okBool (scan (sl [9]) (sl [4, 200])) == some false
+#guard okBool (scan (sl []) (sl [1])) == some true
+#guard okBool (scan (sl [1, 7]) (sl [7, 1])) == some true
+
+-- Early return from an inner loop whose normal exit resumes the outer loop
+#guard okBool (all_small (sl [1, 2, 3]) (u32 5)) == some true
+#guard okBool (all_small (sl [1, 9, 3]) (u32 5)) == some false
+#guard okBool (all_small (sl []) (u32 0)) == some true
+#guard okBool (all_small (sl [0, 0, 2]) (u32 0)) == some false
+
+-- Worklist loop: `let else` continues of the outer loop, inner continues,
+-- early returns
+#guard okBool (walk (sl [4, 2, 1, 1]) 0#usize) == some true
+#guard okBool (walk (sl [3, 60]) 0#usize) == some true
+#guard okBool (walk (sl [2, 51]) 0#usize) == some false
+#guard okBool (walk (sl [3]) 0#usize) == some false
+#guard okBool (walk (sl [0, 5]) 1#usize) == some true
+#guard okBool (walk (sl [4, 51, 1, 1]) 0#usize) == some true
+#guard okBool (walk (sl [7, 1, 1, 1, 1]) 0#usize) == some true
+
+-- Labeled continue and break of the outer loop
+#guard okPair (labeled (sl [1, 2, 3]) (sl [4, 2, 5])) == some (54, 10)
+#guard okPair (labeled (sl [1, 2]) (sl [3, 2000, 4])) == some (3, 0)
+#guard okPair (labeled (sl []) (sl [1])) == some (0, 0)
+#guard okPair (labeled (sl [2, 2]) (sl [2])) == some (0, 20)
+
+-- The innermost of three loops continues the outermost one
+#guard okU32 (deep (sl [5, 1]) (u32 3)) == some 111
+#guard okU32 (deep (sl []) (u32 3)) == some 0
+#guard okU32 (deep (sl [9]) (u32 3)) == some 10
+#guard okU32 (deep (sl [0, 0]) (u32 1)) == some 200
+
+end nested_loop_exits.checks
