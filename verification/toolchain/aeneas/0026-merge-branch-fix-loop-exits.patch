+(** A switch over a [char] has no symbolic integer expansion. Test its values
+    in order with [==] instead: the scrutinee is a copyable [char], and the
+    branches are left in place (a group of values sets a flag, so its branch is
+    not duplicated). *)
+let expand_char_switches (_crate : crate) (f : fun_decl) : fun_decl =
+  match f.body with
+  | StructuredBody body ->
+      let new_locals = ref [] in
+      let _, gen =
+        LocalId.mk_stateful_generator_starting_at_id
+          (LocalId.of_int (List.length body.locals.locals))
+      in
+      let bool_ty = TLiteral TBool in
+      let fresh span : place =
+        let local = { index = gen (); local_ty = bool_ty; name = None; span } in
+        new_locals := local :: !new_locals;
+        { kind = PlaceLocal local.index; ty = bool_ty }
+      in
+      let mk span kind : statement =
+        { span; statement_id = StatementId.zero; kind; comments_before = [] }
+      in
+      let block span statements : block = { span; statements } in
+      let bool_const b : operand =
+        Constant { kind = CLiteral (VBool b); ty = bool_ty }
+      in
+      let rewrite (st : statement) : statement list =
+        match st.kind with
+        | Switch (SwitchInt (op, TChar, targets, otherwise)) ->
+            let span = st.span in
+            let op =
+              match op with
+              | Move p -> Copy p
+              | _ -> op
+            in
+            (* [dest := op == value] *)
+            let test (dest : place) (value : Values.literal) : statement =
+              mk span
+                (Assign
+                   ( dest,
+                     BinaryOp
+                       ( Eq,
+                         op,
+                         Constant { kind = CLiteral value; ty = TLiteral TChar }
+                       ) ))
+            in
+            let rec branches targets : statement list =
+              match targets with
+              | [] -> otherwise.statements
+              | ([ value ], target) :: targets ->
+                  let flag = fresh span in
+                  [
+                    test flag value;
+                    mk span
+                      (Switch
+                         (If (Move flag, target, block span (branches targets))));
+                  ]
+              | (values, target) :: targets ->
+                  let flag = fresh span in
+                  let set_flag value =
+                    let equal = fresh span in
+                    [
+                      test equal value;
+                      mk span
+                        (Switch
+                           (If
+                              ( Move equal,
+                                block span
+                                  [ mk span (Assign (flag, Use (bool_const true))) ],
+                                block span [] )));
+                    ]
+                  in
+                  (mk span (Assign (flag, Use (bool_const false)))
+                  :: List.concat_map set_flag values)
+                  @ [
+                      mk span
+                        (Switch
+                           (If (Move flag, target, block span (branches targets))));
+                    ]
+            in
+            branches targets
+        | _ -> [ st ]
+      in
+      let b = map_statement rewrite body.body in
+      if !new_locals = [] then f
+      else
+        {
+          f with
+          body =
+            StructuredBody
+              {
+                body with
+                body = b;
+                locals =
+                  {
+                    body.locals with
+                    locals = body.locals.locals @ List.rev !new_locals;
+                  };
+              };
+        }
+  | _ -> f
+
