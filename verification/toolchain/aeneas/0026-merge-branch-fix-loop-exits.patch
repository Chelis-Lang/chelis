+//@ [!lean] skip
+//@ [lean] subdir=ArrayOfBorrowsLoop
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! A loop over an array of shared borrows, returning one of them early: the
+//! region abstraction of the array iterator holds an array value.
+//! `ArrayOfBorrowsLoop/Checks.lean` compares the model with the native
+//! results of the `native` test module below.
+
+pub fn first_larger<'a>(x: &'a u32, y: &'a u32, z: &'a u32, limit: u32) -> Option<(&'a u32, usize)> {
+    let mut i = 0usize;
+    for v in [x, y, z] {
+        if *v > limit {
+            return Some((v, i));
+        }
+        i += 1;
+    }
+    None
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn arrays() {
+        assert_eq!(first_larger(&1, &5, &9, 4), Some((&5, 1)));
+        assert_eq!(first_larger(&7, &5, &9, 4), Some((&7, 0)));
+        assert_eq!(first_larger(&1, &2, &9, 4), Some((&9, 2)));
+        assert_eq!(first_larger(&1, &2, &3, 4), None);
+    }
+}
