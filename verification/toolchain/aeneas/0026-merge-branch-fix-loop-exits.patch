+//@ [!lean] skip
+//@ [lean] subdir=NestedLoopExits
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Inner loops which leave through an enclosing loop: `continue` and `break`
+//! to an outer loop, and early returns from an inner loop whose normal exit
+//! resumes the outer iteration. `NestedLoopExits/Checks.lean` evaluates the
+//! model on the inputs of the `native` test module below and compares with
+//! the native results.
+
+/// An inner `for` in tail position of a worklist loop, with early returns out
+/// of both loops, and an inner `continue`.
+pub fn scan(stack0: &[u32], kids: &[u32]) -> bool {
+    let mut stack: Vec<u32> = Vec::new();
+    for s in stack0 {
+        stack.push(*s);
+    }
+    while let Some(v) = stack.pop() {
+        if v == 1 {
+            continue;
+        }
+        if v == 0 {
+            return false;
+        }
+        for k in kids {
+            if *k == v {
+                continue;
+            }
+            if *k > 100 {
+                return false;
+            }
+            if *k < v && *k > 1 {
+                stack.push(*k);
+            }
+        }
+    }
+    true
+}
+
+/// An inner loop with an early return, whose normal exit resumes the outer
+/// loop.
+pub fn all_small(rows: &[u32], limit: u32) -> bool {
+    let mut i = 0usize;
+    while i < rows.len() {
+        let mut j = 0u32;
+        while j < rows[i] {
+            if j > limit {
+                return false;
+            }
+            j += 1;
+        }
+        i += 1;
+    }
+    true
+}
+
+pub enum Role {
+    Runtime,
+    Bypass,
+    Syntax,
+}
+
+fn role(tag: u32, i: usize) -> Role {
+    if tag == 3 && i == 0 {
+        Role::Bypass
+    } else if tag % 2 == 0 {
+        Role::Runtime
+    } else {
+        Role::Syntax
+    }
+}
+
+/// A worklist loop whose tail is an inner loop over children, with inner
+/// `continue`s, `let else` continues of the outer loop, and early returns.
+pub fn walk(tags: &[u32], root: usize) -> bool {
+    let mut stack = vec![(root, true)];
+    while let Some((v, runtime)) = stack.pop() {
+        if v >= tags.len() {
+            continue;
+        }
+        let tag = tags[v];
+        let Some(count) = tag.checked_sub(1) else {
+            continue;
+        };
+        if runtime && tag > 50 {
+            return false;
+        }
+        for i in 0..(count as usize % 3) {
+            match role(tag, i) {
+                Role::Runtime => {
+                    if tag == 7 && i == 1 {
+                        continue;
+                    }
+                    stack.push((v + i + 1, true));
+                }
+                Role::Bypass => {
+                    if v + 1 >= tags.len() {
+                        return false;
+                    }
+                    stack.push((v + 1, false));
+                }
+                Role::Syntax => {}
+            }
+        }
+    }
+    true
+}
+
+/// Labeled `continue` and `break` of the outer loop from an inner loop, with
+/// code after the inner loop and after the outer loop.
+pub fn labeled(rows: &[u32], cols: &[u32]) -> (u32, u32) {
+    let mut sum = 0u32;
+    let mut skipped = 0u32;
+    'rows: for r in rows {
+        for c in cols {
+            if *c == *r {
+                skipped = skipped.wrapping_add(1);
+                continue 'rows;
+            }
+            if *c > 1000 {
+                break 'rows;
+            }
+            sum = sum.wrapping_add(r.wrapping_mul(*c));
+        }
+        sum = sum.wrapping_add(1);
+    }
+    (sum, skipped.wrapping_mul(10))
+}
+
+/// Three nested loops: the innermost continues the outermost one.
+pub fn deep(xs: &[u32], n: u32) -> u32 {
+    let mut acc = 0u32;
+    'outer: for x in xs {
+        let mut i = 0u32;
+        while i < n {
+            let mut j = 0u32;
+            loop {
+                if j == *x {
+                    acc = acc.wrapping_add(100);
+                    continue 'outer;
+                }
+                if j >= i {
+                    break;
+                }
+                acc = acc.wrapping_add(1);
+                j += 1;
+            }
+            i += 1;
+        }
+        acc = acc.wrapping_add(7);
+    }
+    acc
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn nested_exits() {
+        assert!(scan(&[5, 4], &[3, 2]));
+        assert!(!scan(&[5, 0], &[3]));
+        assert!(!scan(&[9], &[4, 200]));
+        assert!(scan(&[], &[1]));
+        assert!(scan(&[1, 7], &[7, 1]));
+
+        assert!(all_small(&[1, 2, 3], 5));
+        assert!(!all_small(&[1, 9, 3], 5));
+        assert!(all_small(&[], 0));
+        assert!(!all_small(&[0, 0, 2], 0));
+
+        assert!(walk(&[4, 2, 1, 1], 0));
+        assert!(walk(&[3, 60], 0));
+        assert!(!walk(&[2, 51], 0));
+        assert!(!walk(&[3], 0));
+        assert!(walk(&[0, 5], 1));
+        assert!(walk(&[4, 51, 1, 1], 0));
+        assert!(walk(&[7, 1, 1, 1, 1], 0));
+
+        assert_eq!(labeled(&[1, 2, 3], &[4, 2, 5]), (54, 10));
+        assert_eq!(labeled(&[1, 2], &[3, 2000, 4]), (3, 0));
+        assert_eq!(labeled(&[], &[1]), (0, 0));
+        assert_eq!(labeled(&[2, 2], &[2]), (0, 20));
+
+        assert_eq!(deep(&[5, 1], 3), 111);
+        assert_eq!(deep(&[], 3), 0);
+        assert_eq!(deep(&[9], 3), 10);
+        assert_eq!(deep(&[0, 0], 1), 200);
+    }
+}
