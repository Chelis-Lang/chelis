+/-- The results of `hook_installation`, its hook entries `(u, o, installed)`, and the
+    final `o` and `installed`. -/
+def hooks : Option ((Nat × (Bool × Nat) × Nat × Nat) × List (Bool × Bool × Bool) × Bool × Bool) :=
+  match hook_installation runtime with
+  | ok ((first, caught, after, quiet), rt) =>
+    let caught := match caught with
+      | .Ok v => (true, v.val)
+      | .Err e => (false, e.val)
+    some ((first.val, caught, after.val, quiet.val), rt.hook, rt.o, rt.installed)
+  | _ => none
+
+/-- The raise codes that reach the previous hook. The raise order is `1, 2, 3, 4`. The
+    Chelis hook forwards a raise iff the hook is not installed or both flags are clear. -/
+def visible (hook : List (Bool × Bool × Bool)) : List Nat :=
+  ((hook.zip [1, 2, 3, 4]).filter fun ((u, o, i), _) => !(i && (u || o))).map (·.2)
+
+#guard hooks == some ((1, (false, 102), 3, 4),
+  [(false, true, false), (false, true, true), (false, false, true), (false, true, true)],
+  true, true)
+-- The native child process observes exactly the raises `1` and `3`.
+#guard (hooks.map fun (_, hook, _) => visible hook) == some [1, 3]
+
 end chelis_ir.checks
