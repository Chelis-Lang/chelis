+/// The hook installation of `catch_native_unwind`. It raises quietly before the
+/// first catch, raises in the catch, then raises without and with quiet output.
+pub fn hook_installation(runtime: &mut LoweringRuntime) -> (u32, Result<u32, u32>, u32, u32) {
+    let first = runtime.raise_fatal(1);
+    let caught = runtime.catch_lowering_with(&mut (), |runtime, _| Err(runtime.raise(2)));
+    let after = runtime.raise(3);
+    let quiet = runtime.raise_fatal(4);
+    (first, caught, after, quiet)
