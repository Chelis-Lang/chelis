+/-- `core::str::traits::FromStr`, whose associated type `Err` is lifted. -/
+@[rust_trait "core::str::traits::FromStr"]
+structure core.str.traits.FromStr (Self : Type) (Err : Type) where
+  from_str : Str → Result (core.result.Result Self Err)
+
+/-- `str::parse` (core/src/str/mod.rs): `FromStr::from_str(self)`. -/
+@[rust_fun "core::str::{str}::parse"]
+def core.str.Str.parse {F Err : Type} (fromStrInst : core.str.traits.FromStr F Err) (s : Str) :
+    Result (core.result.Result F Err) :=
+  fromStrInst.from_str s
+
+/-- `core::num::IntErrorKind` (core/src/num/error.rs). -/
+@[rust_type "core::num::error::IntErrorKind"]
+inductive core.num.error.IntErrorKind where
+  | Empty | InvalidDigit | PosOverflow | NegOverflow | Zero
+  deriving DecidableEq, Repr
+
+/-- `core::num::ParseIntError { kind: IntErrorKind }` (core/src/num/error.rs). -/
+@[rust_type "core::num::error::ParseIntError"]
+structure core.num.error.ParseIntError where
+  kind : core.num.error.IntErrorKind
+  deriving DecidableEq, Repr
+
+/-- The digits loop of `from_ascii_radix` at radix 10 (core/src/num/mod.rs, rustc 1.95): for
+    each byte, `result * 10` (checked), then the byte's digit value (`InvalidDigit` if it has
+    none, before the overflow of that step is reported), then `+ x` (`- x` for a negative
+    number), each step failing with `PosOverflow` (`NegOverflow`) outside `[min, max]`. The
+    unchecked loop used when no overflow is possible computes the same. -/
+def core.num.fromDecimalDigits (positive : Bool) (min max : Int) :
+    List U8 → Int → core.result.Result Int core.num.error.ParseIntError
+  | [], acc => .Ok acc
+  | c :: rest, acc =>
+    if 48 ≤ c.val ∧ c.val ≤ 57 then
+      let next := if positive then acc * 10 + (c.val - 48 : Nat) else acc * 10 - (c.val - 48 : Nat)
+      if next < min ∨ max < next then
+        .Err ⟨if positive then .PosOverflow else .NegOverflow⟩
+      else core.num.fromDecimalDigits positive min max rest next
+    else .Err ⟨.InvalidDigit⟩
+
+/-- `from_str_radix(src, 10)` = `from_ascii_radix(src.as_bytes(), 10)` (core/src/num/mod.rs,
+    rustc 1.95) for an integer type with range `[min, max]`: `Empty` for an empty string,
+    `InvalidDigit` for a lone sign, then an optional `+` (or `-` when `min < 0`) and the digits
+    (a `-` of an unsigned type is an invalid digit). -/
+def core.num.fromDecimal (min max : Int) (src : Str) :
+    core.result.Result Int core.num.error.ParseIntError :=
+  match src.val with
+  | [] => .Err ⟨.Empty⟩
+  | [c] =>
+    if c.val = 43 ∨ c.val = 45 then .Err ⟨.InvalidDigit⟩
+    else core.num.fromDecimalDigits true min max [c] 0
+  | c :: rest =>
+    if c.val = 43 then core.num.fromDecimalDigits true min max rest 0
+    else if c.val = 45 ∧ min < 0 then core.num.fromDecimalDigits false min max rest 0
+    else core.num.fromDecimalDigits true min max src.val 0
+
+def core.num.fromStrUScalar (ty : UScalarTy) (src : Str) :
+    Result (core.result.Result (UScalar ty) core.num.error.ParseIntError) :=
+  match core.num.fromDecimal 0 (UScalar.max ty) src with
+  | .Ok n => do .ok (.Ok (← UScalar.tryMk ty n.toNat))
+  | .Err e => .ok (.Err e)
+
+def core.num.fromStrIScalar (ty : IScalarTy) (src : Str) :
+    Result (core.result.Result (IScalar ty) core.num.error.ParseIntError) :=
+  match core.num.fromDecimal (IScalar.min ty) (IScalar.max ty) src with
+  | .Ok n => do .ok (.Ok (← IScalar.tryMk ty n))
+  | .Err e => .ok (.Err e)
+
