diff --git a/tests/src/vec-dedup-closure-state.rs b/tests/src/vec-dedup-closure-state.rs
new file mode 100644
index 0000000..d99cbd2
--- /dev/null
+++ b/tests/src/vec-dedup-closure-state.rs
@@ -0,0 +1,73 @@
+//@ [!lean] skip
+//@ [lean] subdir=VecDedupClosureState
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! `Vec::dedup_by_key` with a key closure capturing mutable borrows. Charon's
+//! `--monomorphize-mut` specializes its bound `F: FnMut(&mut T) -> K` at such a
+//! closure to a trait specific to the closure, whose `call_mut` has the
+//! closure's region-indexed ABI. The instance is the model's variant
+//! `dedup_by_key_with` applied to the dictionary of the instance's other bound
+//! (`K: PartialEq`) and to the closure's call recovered from this `call_mut`,
+//! which gives back the element the key may change, so the caller reads the
+//! final values of the captured borrows. `VecDedupClosureState/Checks.lean`
+//! evaluates the models on the inputs of the `native` test module below and
+//! compares with the native results.
+
+pub struct Tally {
+    pub calls: u32,
+    pub seen: Vec<u32>,
+}
+
+/// A captured counter; the key changes the elements (`key(current)`, then
+/// `key(previous kept)`), and the kept ones keep their changes.
+pub fn dedup_counting(values: &mut Vec<(u32, u32)>) -> u32 {
+    let mut calls = 0u32;
+    values.dedup_by_key(|v| {
+        calls += 1;
+        v.1 += 1;
+        v.0 / 10
+    });
+    calls
+}
+
+impl Tally {
+    /// Two fields of `self` captured mutably: every key call is counted and
+    /// logged.
+    pub fn dedup_logging(&mut self, values: &mut Vec<u32>) {
+        let seen = &mut self.seen;
+        let calls = &mut self.calls;
+        values.dedup_by_key(|v| {
+            *calls += 1;
+            seen.push(*v);
+            *v % 3
+        });
+    }
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn dedup_counting_gives_back_the_count_and_the_changes() {
+        let mut values = vec![(11, 0), (12, 0), (25, 0), (21, 0), (30, 0)];
+        assert_eq!(dedup_counting(&mut values), 8);
+        assert_eq!(values, vec![(11, 2), (25, 3), (30, 1)]);
+        let mut one = vec![(1, 0)];
+        assert_eq!(dedup_counting(&mut one), 0);
+        assert_eq!(one, vec![(1, 0)]);
+    }
+
+    #[test]
+    fn dedup_logging_gives_back_the_log() {
+        let mut tally = Tally { calls: 1, seen: vec![0] };
+        let mut values = vec![4, 7, 5, 2, 9];
+        tally.dedup_logging(&mut values);
+        assert_eq!(values, vec![4, 5, 9]);
+        assert_eq!(tally.calls, 9);
+        assert_eq!(tally.seen, vec![0, 7, 4, 5, 4, 2, 5, 9, 5]);
+        let mut empty = Vec::new();
+        tally.dedup_logging(&mut empty);
+        assert_eq!(tally.calls, 9);
+    }
+}
diff --git a/tests/src/vec-retain-closure-state.rs b/tests/src/vec-retain-closure-state.rs
new file mode 100644
index 0000000..a0657a2
--- /dev/null
+++ b/tests/src/vec-retain-closure-state.rs
@@ -0,0 +1,169 @@
+//@ [!lean] skip
+//@ [lean] subdir=VecRetainClosureState
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! `Vec::retain` with a closure capturing mutable borrows. Charon's
+//! `--monomorphize-mut` specializes its bound `F: FnMut(&T) -> bool` at such a
+//! closure to a trait specific to the closure, whose `call_mut` has the
+//! closure's region-indexed ABI. The instance is the model's variant
+//! `retain_with` applied to the closure's call recovered from this `call_mut`
+//! (the returned state recombines the values given back to the captured
+//! borrows; nothing is given back to the shared borrow of the element), so the
+//! caller reads the final values of the captured borrows. The first shape is
+//! that of `chelis_types::unify::Subst::take_operand_gates_on`. The slice
+//! iterator's `any` at such a closure is synthesized the same way
+//! (`any_with`), also inside a `retain` closure whose inner `any` closure
+//! reborrows a captured borrow (the shape of
+//! `chelis_types::infer::checked::InferenceProduct::cancel_shape_checks_for_failed_family_call`).
+//! `VecRetainClosureState/Checks.lean` evaluates the models on the inputs of
+//! the `native` test module below and compares with the native results.
+
+pub struct Ledger {
+    pub deferred: Vec<(u32, String)>,
+    pub rounds: u32,
+}
+
+impl Ledger {
+    /// Takes every entry suspended on `v`, leaving the rest in place: the
+    /// closure captures `taken` mutably and `v` by shared borrow, and clones
+    /// the taken payloads.
+    pub fn take_on(&mut self, v: u32) -> Vec<String> {
+        let ledger = &mut self.deferred;
+        let mut taken = Vec::new();
+        ledger.retain(|(tv, gate)| {
+            if *tv == v {
+                taken.push(gate.clone());
+                false
+            } else {
+                true
+            }
+        });
+        self.rounds += 1;
+        taken
+    }
+}
+
+impl Ledger {
+    /// Drops the checks mentioning a failed value: the `retain` closure
+    /// captures the round counter mutably, and its inner `any` closure
+    /// reborrows it and counts every probe.
+    pub fn cancel_failed(&mut self, checks: &mut Vec<Vec<u32>>, failed: &[u32]) {
+        let rounds = &mut self.rounds;
+        checks.retain(|check| {
+            !check.iter().any(|v| {
+                *rounds += 1;
+                failed.contains(v)
+            })
+        });
+    }
+}
+
+/// `Iter::any` with a closure capturing a counter: it stops at the first match.
+pub fn probe_until(values: &[u32], limit: u32) -> (bool, u32) {
+    let mut probes = 0u32;
+    let found = values.iter().any(|x| {
+        probes += 1;
+        *x > limit
+    });
+    (found, probes)
+}
+
+/// Counts the calls and the dropped elements (two captured mutable borrows).
+pub fn drop_odds(values: &mut Vec<u32>) -> (u32, u32) {
+    let mut calls = 0u32;
+    let mut dropped = 0u32;
+    values.retain(|x| {
+        calls += 1;
+        if *x % 2 == 0 {
+            true
+        } else {
+            dropped += 1;
+            false
+        }
+    });
+    (calls, dropped)
+}
+
+/// Keeps the first occurrence of every value: the closure captures the seen
+/// values mutably and reads them.
+pub fn dedup_unsorted(values: &mut Vec<u32>) {
+    let mut seen: Vec<u32> = Vec::new();
+    values.retain(|x| {
+        if seen.contains(x) {
+            false
+        } else {
+            seen.push(*x);
+            true
+        }
+    });
+}
+
+/// A closure capturing nothing mutable (the `FnMut` schema).
+pub fn keep_below(values: &mut Vec<u32>, limit: u32) {
+    values.retain(|x| *x < limit);
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn take_on_takes_the_suspended_entries() {
+        let mut ledger = Ledger {
+            deferred: vec![
+                (1, "a".to_string()),
+                (2, "b".to_string()),
+                (1, "c".to_string()),
+                (3, "d".to_string()),
+            ],
+            rounds: 4,
+        };
+        assert_eq!(ledger.take_on(1), vec!["a".to_string(), "c".to_string()]);
+        assert_eq!(ledger.deferred, vec![(2, "b".to_string()), (3, "d".to_string())]);
+        assert_eq!(ledger.rounds, 5);
+        assert_eq!(ledger.take_on(7), Vec::<String>::new());
+        assert_eq!(ledger.deferred, vec![(2, "b".to_string()), (3, "d".to_string())]);
+        assert_eq!(ledger.rounds, 6);
+    }
+
+    #[test]
+    fn cancel_failed_counts_the_probes() {
+        let mut ledger = Ledger { deferred: vec![(1, "a".to_string())], rounds: 4 };
+        let mut checks = vec![vec![1, 2], vec![3], vec![], vec![2, 3, 4]];
+        ledger.cancel_failed(&mut checks, &[3]);
+        assert_eq!(checks, vec![vec![1, 2], vec![]]);
+        assert_eq!(ledger.rounds, 9);
+        assert_eq!(ledger.deferred, vec![(1, "a".to_string())]);
+    }
+
+    #[test]
+    fn probe_until_stops_at_the_first_match() {
+        assert_eq!(probe_until(&[1, 5, 9, 2], 4), (true, 2));
+        assert_eq!(probe_until(&[1, 2], 4), (false, 2));
+        assert_eq!(probe_until(&[], 0), (false, 0));
+    }
+
+    #[test]
+    fn drop_odds_counts() {
+        let mut values = vec![1, 2, 3, 4, 6];
+        assert_eq!(drop_odds(&mut values), (5, 2));
+        assert_eq!(values, vec![2, 4, 6]);
+        let mut values = vec![];
+        assert_eq!(drop_odds(&mut values), (0, 0));
+        assert_eq!(values, Vec::<u32>::new());
+    }
+
+    #[test]
+    fn dedup_unsorted_keeps_first_occurrences() {
+        let mut values = vec![3, 1, 3, 2, 1, 4];
+        dedup_unsorted(&mut values);
+        assert_eq!(values, vec![3, 1, 2, 4]);
+    }
+
+    #[test]
+    fn keep_below_limits() {
+        let mut values = vec![0, 5, 12, 0, 7];
+        keep_below(&mut values, 6);
+        assert_eq!(values, vec![0, 5, 0]);
+    }
+}
