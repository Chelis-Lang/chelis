+/-- `dec2flt` (core/src/num/dec2flt/mod.rs): `Empty` for an empty string; an optional sign;
+    `Invalid` if nothing follows it or it is neither a decimal literal nor `inf`/`infinity`/
+    `nan`; else the decimal rounded to nearest, ties to even (the fast path, Eisel-Lemire and
+    the slow `parse_long_mantissa` path all compute this correctly rounded value), negated for
+    a `-`. `inf` and `nan` are `F::INFINITY` and `F::NAN` (the positive quiet NaN), negated
+    for a `-`. A decimal above `10^400` is infinite and one below `10^-400` is zero in every
+    format, so `round` is only applied between those bounds. -/
+def core.num.dec2flt.parseFloat (f : BinaryFormat) (src : Str) :
+    core.result.Result (BinaryFloat f) core.num.dec2flt.ParseFloatError :=
+  match src.val with
+  | [] => .Err ⟨.Empty⟩
+  | c :: rest =>
+    let negative := c.val = 45
+    let s := if c.val = 45 ∨ c.val = 43 then rest else c :: rest
+    if s.isEmpty then .Err ⟨.Invalid⟩
+    else
+      match core.num.dec2flt.parseNumber s with
+      | some (mantissa, exponent) =>
+        if mantissa = 0 then .Ok (BinaryFloat.zero f negative)
+        else
+          let k : Int := (Nat.toDigits 10 mantissa).length
+          if exponent + k - 1 > 400 then .Ok (BinaryFloat.infinity f negative)
+          else if exponent + k < -400 then .Ok (BinaryFloat.zero f negative)
+          else
+            .Ok (BinaryFloat.round f negative (mantissa * 10 ^ exponent.toNat)
+              (10 ^ (-exponent).toNat))
+      | none =>
+        match core.num.dec2flt.infNan s with
+        | some true => .Ok (BinaryFloat.infinity f negative)
+        | some false => .Ok (BinaryFloat.nan f negative)
+        | none => .Err ⟨.Invalid⟩
