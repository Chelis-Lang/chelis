+    case-insensitively (`register & 0xDFDF..` upper-cases exactly the letters). -/
+def core.num.dec2flt.infNan (s : List U8) : Option Bool :=
+  let upper := s.map fun (c : U8) => if 97 ≤ c.val ∧ c.val ≤ 122 then c.val - 32 else c.val
+  if upper = [73, 78, 70] ∨ upper = [73, 78, 70, 73, 78, 73, 84, 89] then some true
+  else if upper = [78, 65, 78] then some false
