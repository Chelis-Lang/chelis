+    item's key before comparing; `min_by(x, y)` keeps `x` iff `x.cmp(&y)` is `Less` or `Equal`,
+    so the first of equal minima is returned. The iterator's and the key closure's final
+    states are returned. -/
+@[rust_fun "core::iter::traits::iterator::Iterator::min_by_key"]
+def core.iter.traits.iterator.Iterator.min_by_key.default {Self Item B F : Type}
+    (iterInst : core.iter.traits.iterator.Iterator Self Item) (ordInst : core.cmp.Ord B)
+    (fnInst : core.ops.function.FnMut F Item B) (self : Self) (f : F) :
+    Result (Option Item × Self × F) := do
+  let (first, self) ← iterInst.next self
+  match first with
+  | none => ok (none, self, f)
+  | some first =>
+    let (k, f) ← fnInst.call_mut f first
+    let step := fun (f : F) (x : (B × Item) × Item) => do
+      let (ky, f) ← fnInst.call_mut f x.2
