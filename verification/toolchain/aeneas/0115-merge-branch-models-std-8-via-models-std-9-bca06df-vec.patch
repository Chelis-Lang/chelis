+import VecDedupClosureState.VecDedupClosureState
+
+/-! Evaluate the model of `tests/src/vec-dedup-closure-state.rs` on the inputs of
+    its `native` test module and compare with the native results, including the
+    values given back through the mutable borrows. -/
+
+namespace vec_dedup_closure_state.checks
+open Aeneas Aeneas.Std Result
+
+def u (n : Nat) : U32 := ⟨BitVec.ofNat _ n⟩
+
+def vec {α : Type} (xs : List α) : alloc.vec.Vec α :=
+  if h : xs.length ≤ Usize.max then ⟨xs, h⟩ else ⟨[], by simp⟩
+
+def nats (v : alloc.vec.Vec U32) : List Nat := v.val.map (·.val)
+
+/-- The captured count and the given-back vector, whose kept elements keep the key's
+    changes. -/
+def countingR (xs : List (Nat × Nat)) : Option (Nat × List (Nat × Nat)) :=
+  match dedup_counting (vec (xs.map fun (a, b) => (u a, u b))) with
+  | ok (calls, v) => some (calls.val, v.val.map fun (a, b) => (a.val, b.val))
+  | _ => none
+
+#guard countingR [(11, 0), (12, 0), (25, 0), (21, 0), (30, 0)] ==
+  some (8, [(11, 2), (25, 3), (30, 1)])
+#guard countingR [(1, 0)] == some (0, [(1, 0)])
+
+/-- Two fields of `self` captured mutably: the given-back tally and vector. -/
+def loggingR (calls : Nat) (seen xs : List Nat) : Option ((Nat × List Nat) × List Nat) :=
+  match Tally.dedup_logging { calls := u calls, seen := vec (seen.map u) } (vec (xs.map u)) with
+  | ok (t, v) => some ((t.calls.val, nats t.seen), nats v)
+  | _ => none
+
+#guard loggingR 1 [0] [4, 7, 5, 2, 9] == some ((9, [0, 7, 4, 5, 4, 2, 5, 9, 5]), [4, 5, 9])
+#guard loggingR 9 [0, 7, 4, 5, 4, 2, 5, 9, 5] [] ==
+  some ((9, [0, 7, 4, 5, 4, 2, 5, 9, 5]), [])
+
+end vec_dedup_closure_state.checks
