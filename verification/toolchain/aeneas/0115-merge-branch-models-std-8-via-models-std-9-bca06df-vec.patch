+import VecRetainClosureState.VecRetainClosureState
+
+/-! Evaluate the model of `tests/src/vec-retain-closure-state.rs` on the inputs of
+    its `native` test module and compare with the native results, including the
+    values given back through the mutable borrows. -/
+
+namespace vec_retain_closure_state.checks
+open Aeneas Aeneas.Std Result
+
+def u (n : Nat) : U32 := ⟨BitVec.ofNat _ n⟩
+
+def vec {α : Type} (xs : List α) : alloc.vec.Vec α :=
+  if h : xs.length ≤ Usize.max then ⟨xs, h⟩ else ⟨[], by simp⟩
+
+def nats (v : alloc.vec.Vec U32) : List Nat := v.val.map (·.val)
+
+def ledger (xs : List (Nat × String)) (rounds : Nat) : Ledger :=
+  { deferred := vec (xs.map fun (tv, g) => (u tv, g)), rounds := u rounds }
+
+def ledgerR (l : Ledger) : List (Nat × String) × Nat :=
+  (l.deferred.val.map fun (tv, g) => (tv.val, g), l.rounds.val)
+
+/-- The closure captures `taken` mutably (read after `retain`) and `v` by shared
+    borrow; the ledger and the round counter are given back through `&mut self`. -/
+def takeOnR : Option ((List String × List (Nat × String) × Nat) ×
+    (List String × List (Nat × String) × Nat)) :=
+  match Ledger.take_on (ledger [(1, "a"), (2, "b"), (1, "c"), (3, "d")] 4) (u 1) with
+  | ok (taken, l) =>
+    match Ledger.take_on l (u 7) with
+    | ok (taken', l') => some ((taken.val, ledgerR l), (taken'.val, ledgerR l'))
+    | _ => none
+  | _ => none
+
+#guard takeOnR == some ((["a", "c"], [(2, "b"), (3, "d")], 5), ([], [(2, "b"), (3, "d")], 6))
+
+def slice {α : Type} (xs : List α) : Slice α :=
+  if h : xs.length ≤ Usize.max then ⟨xs, h⟩ else ⟨[], by simp⟩
+
+/-- The `retain` closure captures the round counter mutably and its inner `any` closure
+    reborrows it: the kept checks, and the ledger given back through `&mut self`. -/
+def cancelR (checks : List (List Nat)) (failed : List Nat) :
+    Option (List (List Nat) × List (Nat × String) × Nat) :=
+  match Ledger.cancel_failed (ledger [(1, "a")] 4) (vec (checks.map fun c => vec (c.map u)))
+      (slice (failed.map u)) with
+  | ok (l, cs) => some (cs.val.map nats, ledgerR l)
+  | _ => none
+
+#guard cancelR [[1, 2], [3], [], [2, 3, 4]] [3] == some ([[1, 2], []], [(1, "a")], 9)
+
+/-- `Iter::any` with a captured counter, which stops at the first match. -/
+def probeR (xs : List Nat) (limit : Nat) : Option (Bool × Nat) :=
+  match probe_until (slice (xs.map u)) (u limit) with
+  | ok (found, probes) => some (found, probes.val)
+  | _ => none
+
+#guard probeR [1, 5, 9, 2] 4 == some (true, 2)
+#guard probeR [1, 2] 4 == some (false, 2)
+#guard probeR [] 0 == some (false, 0)
+
+/-- Two counters captured mutably, read after `retain`; the vector is given back. -/
+def dropOddsR (xs : List Nat) : Option ((Nat × Nat) × List Nat) :=
+  match drop_odds (vec (xs.map u)) with
+  | ok ((calls, dropped), v) => some ((calls.val, dropped.val), nats v)
+  | _ => none
+
+#guard dropOddsR [1, 2, 3, 4, 6] == some ((5, 2), [2, 4, 6])
+#guard dropOddsR [] == some ((0, 0), [])
+
+/-- A captured vector read and extended by the closure. -/
+def dedupUnsortedR (xs : List Nat) : Option (List Nat) :=
+  match dedup_unsorted (vec (xs.map u)) with
+  | ok v => some (nats v)
+  | _ => none
+
+#guard dedupUnsortedR [3, 1, 3, 2, 1, 4] == some [3, 1, 2, 4]
+
+/-- A closure capturing nothing mutable (the `FnMut` schema). -/
+def keepBelowR (xs : List Nat) (limit : Nat) : Option (List Nat) :=
+  match keep_below (vec (xs.map u)) (u limit) with
+  | ok v => some (nats v)
+  | _ => none
+
+#guard keepBelowR [0, 5, 12, 0, 7] 6 == some [0, 5, 0]
+
+end vec_retain_closure_state.checks
