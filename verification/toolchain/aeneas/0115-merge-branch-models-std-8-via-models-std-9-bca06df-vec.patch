+/-- `parse_number` (core/src/num/dec2flt/parse.rs) on the bytes after the sign: `digits [.
+    digits] [(e|E) [+|-] digits]`, with at least one mantissa digit, consuming everything: the
+    decimal `mantissa × 10^exponent` it denotes. -/
+def core.num.dec2flt.parseNumber (s : List U8) : Option (Nat × Int) :=
+  let (intValue, intCount, rest) := core.num.dec2flt.digits s 0 0
+  let (mantissa, fracCount, rest) :=
+    match rest with
+    | c :: r => if c.val = 46 then core.num.dec2flt.digits r intValue 0 else (intValue, 0, rest)
+    | [] => (intValue, 0, [])
+  if intCount + fracCount = 0 then none
+  else
+    match rest with
+    | [] => some (mantissa, -(fracCount : Int))
+    | c :: r =>
+      if c.val = 101 ∨ c.val = 69 then
+        let (negative, r) :=
+          match r with
+          | d :: r' => if d.val = 45 then (true, r') else if d.val = 43 then (false, r') else (false, r)
+          | [] => (false, [])
+        match r with
+        | d :: _ =>
+          if core.num.dec2flt.isDigit d then
+            let (e, r) := core.num.dec2flt.exponentDigits r 0
+            if r.isEmpty then some (mantissa, (if negative then -(e : Int) else e) - fracCount)
+            else none
+          else none
+        | [] => none
+      else none
