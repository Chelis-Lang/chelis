+      if (← ordInst.cmp x.1 x.2) = Ordering.gt then ok x.1 else ok x.2
+    let maxInst : core.ops.function.FnMut Unit (Item × Item) Item := {
+      FnOnceInst := { call_once := fun _ x => do ok (← step x, ()) }
+      call_mut := fun _ x => do ok (← step x, ())
