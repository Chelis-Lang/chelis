+def core.num.dec2flt.isDigit (c : U8) : Bool := 48 ≤ c.val && c.val ≤ 57
+
+/-- The leading decimal digits: their value from `acc` on, their count, and the rest. -/
+def core.num.dec2flt.digits : List U8 → Nat → Nat → Nat × Nat × List U8
+  | c :: rest, acc, n =>
+    if core.num.dec2flt.isDigit c then core.num.dec2flt.digits rest (acc * 10 + (c.val - 48)) (n + 1)
+    else (acc, n, c :: rest)
+  | [], acc, n => (acc, n, [])
+
+/-- The exponent digits of `parse_scientific` (core/src/num/dec2flt/parse.rs): each digit is
+    accumulated only while the exponent is below `0x10000` (the same saturation as the slow
+    path's `parse_decimal_seq`). -/
+def core.num.dec2flt.exponentDigits : List U8 → Nat → Nat × List U8
+  | c :: rest, acc =>
+    if core.num.dec2flt.isDigit c then
+      core.num.dec2flt.exponentDigits rest (if acc < 0x10000 then acc * 10 + (c.val - 48) else acc)
+    else (acc, c :: rest)
