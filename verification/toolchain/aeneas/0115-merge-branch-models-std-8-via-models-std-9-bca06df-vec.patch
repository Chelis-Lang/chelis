+@[rust_fun "core::iter::traits::iterator::Iterator::max"]
+def core.iter.traits.iterator.Iterator.max.default {Self Item : Type}
+    (iterInst : core.iter.traits.iterator.Iterator Self Item) (ordInst : core.cmp.Ord Item)
+    (self : Self) : Result (Option Item × Self) := do
+  let (first, self) ← iterInst.next self
