+(** {1 The loop body evaluated by the fixed-point iterations}
+
+    The fixed-point iterations of a loop
+    ({!InterpLoopsFixedPoint.compute_loop_entry_fixed_point}) keep only the
+    contexts which reach a [continue] of the loop. The contexts at its other
+    outcomes (its exits, the returns and the panics) are discarded, and the loop
+    body is evaluated again from the fixed point to compute them
+    ({!InterpLoopsFixedPoint.compute_loop_exit_contexts}, then the synthesis of
+    the loop body). The paths which cannot reach a [continue] of the loop are
+    thus evaluated by the iterations only to be discarded. This is costly when
+    the code after the loop is nested in its body, like the continuation of a
+    returning loop, which [PrePasses.update_loops] copies onto its breaks: the
+    loops nested in such continuations are evaluated a number of times
+    exponential in the nesting depth.
+
+    [fixed_point_body body] is the body evaluated by the iterations. It cuts
+    every path of [body] at the first position from which no [continue] of the
+    loop is reachable ({!fixed_point_cut}), and marks the loops nested in the
+    body ({!fixed_point_filtered_loop}) so that only the outcomes of them which
+    may reach such a [continue] (their own [break], the [continue]s of the loop)
+    are kept. The reachability is syntactic and over-approximates the control
+    flow: every statement may complete, except [return], [break], [continue],
+    panics and the switches whose branches cannot complete, and a nested loop
+    may complete if it contains a [break] to it.
+
+    The contexts at the [continue]s of the loop, in the same order, and thus the
+    fixed point, are the same as with [body]. The evaluation of a path depends
+    only on its context until it is joined with other paths
+    ({!InterpStatements.join_contexts_by_destination}): after a switch, the
+    paths with the same outcome (fall-through, or a [continue] or [break] of a
+    given loop), and in a match, the constructors selecting the same arm, before
+    evaluating the arm. A path which reaches a [continue] of the loop is never
+    cut nor dropped, and neither are the paths joined with it on the way, as
+    they continue from the same position: the joins leading to a [continue]
+    join the same contexts, and a nested loop on the way is evaluated as with
+    [body]. The joins of the other outcomes are not performed at all, as the
+    paths reaching them produce no outcome. Their only effect on the other
+    paths is on the ids they generate (the generators are shared): the ids
+    generated for the other paths are the same, up to a renaming which
+    preserves their order, and the translation only compares ids. This requires
+    [-strict-joins]: a join which fails then fails the translation, while a
+    recovered failure abandons all the joins of the switch, including those of
+    the [continue]s, so without it the iterations evaluate [body] unchanged. *)
+
+(** The statement ids of the markers of {!fixed_point_body} (the statement ids
+    of a body are nonnegative) *)
+let fixed_point_cut_id = LlbcAst.StatementId.of_int (-1)
+
+let fixed_point_filtered_loop_id = LlbcAst.StatementId.of_int (-2)
+
+(** Whether a statement of a {!fixed_point_body} cuts the path: its evaluation
+    produces no outcome *)
+let fixed_point_cut (st : LlbcAst.statement) : bool =
+  st.statement_id = fixed_point_cut_id
+
+(** Whether a statement of a {!fixed_point_body} is a nested loop whose
+    outcomes must be filtered with {!fixed_point_loop_outcomes} *)
+let fixed_point_filtered_loop (st : LlbcAst.statement) : bool =
+  st.statement_id = fixed_point_filtered_loop_id
+
+(** Keep the outcomes of a nested loop of a {!fixed_point_body} which may lead
+    to a [continue] of the loop: its own [break] (the fall-through after it) and
+    the [continue]s of the loop. The iterations discard the synthesized
+    expressions, so the continuation is never applied. *)
+let fixed_point_loop_outcomes (span : Meta.span)
+    ((resl, _) :
+      (eval_ctx * statement_eval_res) list * (SA.expr list -> SA.expr)) :
+    (eval_ctx * statement_eval_res) list * (SA.expr list -> SA.expr) =
+  ( List.filter
+      (fun (_, res) ->
+        match res with
+        | Unit | Continue 0 | Panic -> true
+        | Break _ | Continue _ | Return -> false)
+      resl,
+    fun _ -> [%internal_error] span )
+
+(** Whether a loop nested in the body contains a [continue] of the loop, and a
+    [break] of itself (the depth of a statement is the number of loops between
+    it and the body of the loop) *)
+let nested_loop_exits (body : LlbcAst.block) : bool * bool =
+  let continues = ref false in
+  let breaks = ref false in
+  let visitor =
+    object (self)
+      inherit [_] LlbcAst.iter_statement
+      method! visit_Loop depth body = self#visit_block (depth + 1) body
+      method! visit_Continue depth i = if i = depth then continues := true
+      method! visit_Break depth i = if i = depth - 1 then breaks := true
+    end
+  in
+  visitor#visit_block 1 body;
+  (!continues, !breaks)
+
+let fixed_point_body (body : LlbcAst.block) : LlbcAst.block =
+  let open LlbcAst in
+  let cut span : statement =
+    {
+      span;
+      statement_id = fixed_point_cut_id;
+      kind = Abort UndefinedBehavior;
+      comments_before = [];
+    }
+  in
+  (* [k]: whether the position after the statements reaches a [continue] of the
+     loop. Also returns whether the position before them reaches one. *)
+  let rec statements span (k : bool) (sts : statement list) :
+      statement list * bool =
+    match sts with
+    | [] -> ((if k then [] else [ cut span ]), k)
+    | st :: rest ->
+        let rest, k = statements span k rest in
+        let st, reaches = statement k st in
+        if reaches then (st :: rest, true) else ([ cut st.span ], false)
+  and block (k : bool) (b : block) : block * bool =
+    let sts, reaches = statements b.span k b.statements in
+    ({ b with statements = sts }, reaches)
+  and statement (k : bool) (st : statement) : statement * bool =
+    match st.kind with
+    | Continue 0 -> (st, true)
+    | Continue _ | Break _ | Return | Abort _ -> (st, false)
+    | Loop body ->
+        let continues, breaks = nested_loop_exits body in
+        ( { st with statement_id = fixed_point_filtered_loop_id },
+          continues || (breaks && k) )
+    | Switch switch ->
+        let reaches = ref false in
+        let branch (b : block) : block =
+          let b, r = block k b in
+          reaches := !reaches || r;
+          b
+        in
+        let switch =
+          match switch with
+          | If (op, b0, b1) ->
+              let b0 = branch b0 in
+              If (op, b0, branch b1)
+          | SwitchInt (op, ty, targets, otherwise) ->
+              let targets = List.map (fun (v, b) -> (v, branch b)) targets in
+              SwitchInt (op, ty, targets, branch otherwise)
+          | Match (p, targets, otherwise) ->
+              let targets = List.map (fun (v, b) -> (v, branch b)) targets in
+              Match (p, targets, Option.map branch otherwise)
+        in
+        ({ st with kind = Switch switch }, !reaches)
+    | Assign _
+    | SetDiscriminant _
+    | CopyNonOverlapping _
+    | StorageLive _
+    | StorageDead _
+    | PlaceMention _
+    | Drop _
+    | Assert _
+    | Call _
+    | Nop
+    | Error _ -> (st, k)
+  in
+  fst (block false body)
+
