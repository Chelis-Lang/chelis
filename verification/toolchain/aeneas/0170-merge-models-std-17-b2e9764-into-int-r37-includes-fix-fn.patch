+  | .Err e => ok (.Err e)
+
+/-- `impl Visitor for TagOrContentVisitor` (its value is the tag name `self.name`) one level above
+    the dictionaries of `ContentVisitor` of the knot family `X`: a string or bytes equal to the name
+    is `TagOrContent::Tag`; every other value is `ContentVisitor::new().visit_*(value)` of the same
+    level, as `TagOrContent::Content`. `expecting` is ``a type tag `{name}` or any other value``;
+    `visit_i128`/`visit_u128` are the provided ones. -/
+def tagOrContentVisitorStep {X : Fam} (seed : X.Seed ContentVisitor Content)
+    (v : X.Visitor ContentVisitor Content) : VisitorStep X Str TagOrContent :=
+  let cv := contentVisitorStep seed v
+  { expecting := fun name f =>
+      writeArgs f (cat [lit "a type tag `", strArg name, lit "` or any other value"])
+    visit_bool := fun e _ x => asContent (cv.visit_bool e ⟨⟩ x)
+    visit_i8 := fun e _ x => asContent (cv.visit_i8 e ⟨⟩ x)
+    visit_i16 := fun e _ x => asContent (cv.visit_i16 e ⟨⟩ x)
+    visit_i32 := fun e _ x => asContent (cv.visit_i32 e ⟨⟩ x)
+    visit_i64 := fun e _ x => asContent (cv.visit_i64 e ⟨⟩ x)
+    visit_u8 := fun e _ x => asContent (cv.visit_u8 e ⟨⟩ x)
+    visit_u16 := fun e _ x => asContent (cv.visit_u16 e ⟨⟩ x)
+    visit_u32 := fun e _ x => asContent (cv.visit_u32 e ⟨⟩ x)
+    visit_u64 := fun e _ x => asContent (cv.visit_u64 e ⟨⟩ x)
+    visit_f32 := fun e _ x => asContent (cv.visit_f32 e ⟨⟩ x)
+    visit_f64 := fun e _ x => asContent (cv.visit_f64 e ⟨⟩ x)
+    visit_char := fun e _ x => asContent (cv.visit_char e ⟨⟩ x)
+    visit_str := fun e name x =>
+      if x.val == name.val then ok (.Ok .Tag) else asContent (cv.visit_str e ⟨⟩ x)
+    visit_borrowed_str := fun e name x =>
+      if x.val == name.val then ok (.Ok .Tag) else asContent (cv.visit_borrowed_str e ⟨⟩ x)
+    visit_string := fun e name x => do
+      if (← Str.ofString x).val == name.val then ok (.Ok .Tag)
+      else asContent (cv.visit_string e ⟨⟩ x)
+    visit_bytes := fun e name x =>
+      if x.val == name.val then ok (.Ok .Tag) else asContent (cv.visit_bytes e ⟨⟩ x)
+    visit_borrowed_bytes := fun e name x =>
+      if x.val == name.val then ok (.Ok .Tag) else asContent (cv.visit_borrowed_bytes e ⟨⟩ x)
+    visit_byte_buf := fun e name x =>
+      if x.val == name.val then ok (.Ok .Tag) else asContent (cv.visit_byte_buf e ⟨⟩ x)
+    visit_unit := fun e _ => asContent (cv.visit_unit e ⟨⟩)
+    visit_none := fun e _ => asContent (cv.visit_none e ⟨⟩)
+    visit_some := fun inst _ de => asContent (cv.visit_some inst ⟨⟩ de)
+    visit_newtype_struct := fun inst _ de => asContent (cv.visit_newtype_struct inst ⟨⟩ de)
+    visit_seq := fun seq _ access => asContent (cv.visit_seq seq ⟨⟩ access)
+    visit_map := fun map _ access => asContent (cv.visit_map map ⟨⟩ access)
+    visit_enum := fun data _ access => asContent (cv.visit_enum data ⟨⟩ access) }
+
+/-- The dictionaries of `TagOrContentVisitor` at level `n` of the knot: `impl DeserializeSeed`
+    (`deserializer.deserialize_any(self)`: internally tagged enums need a self-describing format)
+    and `impl Visitor`. -/
+def tagOrContentAt : (n : Nat) → (DeAt n).Seed Str TagOrContent × (DeAt n).Visitor Str TagOrContent
+  | 0 => (PUnit.unit, PUnit.unit)
+  | n + 1 =>
+    let below := tagOrContentAt n
+    (⟨fun inst name de => inst.deserialize_any below.2 de name⟩,
+      tagOrContentVisitorStep (contentAt n).1 (contentAt n).2)
+
+/-- `TagOrContentVisitor::new(name)` as a seed of the Rust traits (`Ω`); its value is the name. -/
+def TagOrContentSeedΩ : SeedΩ Str TagOrContent := ⟨fun n => (tagOrContentAt n).1⟩
+
+/-- `pub struct TaggedContentVisitor<T> { tag_name, expecting, value: PhantomData<T> }` -/
+@[rust_type "serde::private::de::content::TaggedContentVisitor" (body := .opaque)]
+structure TaggedContentVisitor (T : Type) where
+  tag_name : Str
+  expecting : Str
+
+/-- `TaggedContentVisitor::new(name, expecting)` -/
+@[rust_fun
+  "serde::private::de::content::{serde::private::de::content::TaggedContentVisitor<@T>}::new"]
+def TaggedContentVisitor.new (T : Type) (name expecting : Str) :
+    Result (TaggedContentVisitor T) :=
+  ok ⟨name, expecting⟩
+
+/-- The `while let Some(k) = tri!(map.next_key_seed(TagOrContentVisitor::new(self.tag_name)))`
+    loop of `TaggedContentVisitor::visit_map`: the tag (a second one is
+    `Error::duplicate_field(tag_name)`, before its value is read) is `map.next_value()`, every other
+    entry is buffered (`map.next_value_seed(ContentVisitor::new())`, pushed with its key), until the
+    end or the first error. -/
+def taggedEntries {T M Error : Type} (tInst : serde_core.de.Deserialize T)
+    (map : serde_core.de.MapAccess M Error) (name : Str) (tag : Option T)
+    (vec : alloc.vec.Vec (Content × Content)) (access : M) :
+    Result (core.result.Result (Option T × alloc.vec.Vec (Content × Content)) Error) := do
+  let (r, access) ← map.next_key_seed TagOrContentSeedΩ access name
+  match r with
+  | .Err e => ok (.Err e)
+  | .Ok none => ok (.Ok (tag, vec))
+  | .Ok (some .Tag) =>
+    if tag.isSome then ok (.Err (← map.serde_coredeErrorInst.duplicate_field name))
+    else
+      let (r, access) ← map.next_value (Deserialize.wrap tInst) access
+      match r with
+      | .Err e => ok (.Err e)
+      | .Ok t => taggedEntries tInst map name (some t) vec access
+  | .Ok (some (.Content k)) =>
+    let (r, access) ← map.next_value_seed ContentSeedΩ access ⟨⟩
+    match r with
+    | .Err e => ok (.Err e)
+    | .Ok v => taggedEntries tInst map name tag (← alloc.vec.Vec.push vec (k, v)) access
+partial_fixpoint
+
+/-- `TaggedContentVisitor::visit_map`: the tag and the other entries (`taggedEntries`, the buffer's
+    capacity from `size_hint::cautious`); no tag is `Error::missing_field(tag_name)`, else
+    `(tag, Content::Map(entries))`. -/
+@[rust_fun
+  "serde::private::de::content::{serde_core::de::Visitor<'de, serde::private::de::content::TaggedContentVisitor<@T>, (@T, serde_core::private::content::Content<'de>)>}::visit_map"]
+def VisitorTaggedContentVisitor.visit_map {T M Error : Type}
+    (tInst : serde_core.de.Deserialize T) (map : serde_core.de.MapAccess M Error)
+    (self : TaggedContentVisitor T) (access : M) :
+    Result (core.result.Result (T × Content) Error) := do
+  let hint ← map.size_hint access
+  let vec := alloc.vec.Vec.with_capacity (Content × Content)
+    (serde_core.private.size_hint.cautious (2 * Content.size) hint)
+  match ← taggedEntries tInst map self.tag_name none vec access with
+  | .Err e => ok (.Err e)
+  | .Ok (none, _) => ok (.Err (← map.serde_coredeErrorInst.missing_field self.tag_name))
+  | .Ok (some tag, vec) => ok (.Ok (tag, .Map vec.toNested))
+
+/-- `TaggedContentVisitor::visit_seq`: the tag is the first element (`seq.next_element()`; none is
+    `Error::missing_field(tag_name)`), the rest of the sequence is buffered through
+    `ContentVisitor::new().deserialize(SeqAccessDeserializer::new(seq))` (a `Content::Seq`). -/
+@[rust_fun
+  "serde::private::de::content::{serde_core::de::Visitor<'de, serde::private::de::content::TaggedContentVisitor<@T>, (@T, serde_core::private::content::Content<'de>)>}::visit_seq"]
+def VisitorTaggedContentVisitor.visit_seq {T S Error : Type}
+    (tInst : serde_core.de.Deserialize T) (seq : serde_core.de.SeqAccess S Error)
+    (self : TaggedContentVisitor T) (access : S) :
+    Result (core.result.Result (T × Content) Error) := do
+  let (r, access) ← seq.next_element (Deserialize.wrap tInst) access
+  match r with
+  | .Err e => ok (.Err e)
+  | .Ok none => ok (.Err (← seq.serde_coredeErrorInst.missing_field self.tag_name))
+  | .Ok (some tag) =>
+    let rest ← serde_core.de.value.SeqAccessDeserializer.new access
+    match ← DeserializeSeedContentVisitor.deserialize
+        (serde_core.de.value.DeserializerSeqAccessDeserializer seq) ⟨⟩ rest with
+    | .Err e => ok (.Err e)
+    | .Ok c => ok (.Ok (tag, c))
+
+/-- `TaggedContentVisitor::expecting`: `fmt.write_str(self.expecting)`. -/
+@[rust_fun
+  "serde::private::de::content::{serde_core::de::Visitor<'de, serde::private::de::content::TaggedContentVisitor<@T>, (@T, serde_core::private::content::Content<'de>)>}::expecting"]
+def VisitorTaggedContentVisitor.expecting {T : Type} (_ : serde_core.de.Deserialize T)
+    (self : TaggedContentVisitor T) (formatter : core.fmt.Formatter) : core.fmt.Outcome :=
+  core.fmt.Formatter.write_str formatter self.expecting
+
+/-- `impl<'de, T: Deserialize<'de>> Visitor<'de> for TaggedContentVisitor<T>` (its value is
+    `(T, Content)`): `visit_seq`, `visit_map` and `expecting`; every other `visit_*` is the provided
+    one (`Error::invalid_type` with `expecting`). -/
+@[reducible, rust_trait_impl
+  "serde_core::de::Visitor<'de, serde::private::de::content::TaggedContentVisitor<@T>, (@T, serde_core::private::content::Content<'de>)>"]
+def VisitorTaggedContentVisitor {T : Type} (tInst : serde_core.de.Deserialize T) :
+    serde_core.de.Visitor (TaggedContentVisitor T) (T × Content) :=
+  { expecting := VisitorTaggedContentVisitor.expecting tInst
+    visit_seq := fun seq self access => VisitorTaggedContentVisitor.visit_seq tInst seq self access
+    visit_map := fun map self access => VisitorTaggedContentVisitor.visit_map tInst map self access }
+
+end serde.private.de.content
