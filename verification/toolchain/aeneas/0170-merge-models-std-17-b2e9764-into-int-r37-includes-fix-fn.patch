+/-- The call `d.bump(k)` through the instance of the trait object. -/
+def dynBump (d : D) (k : U32) : Option (U32 × D) :=
+  -- The trait object keeps its type and instance.
+  match d.inst.bump d.value k with
+  | ok (r, s) => some (r, ⟨d.self, d.inst, s⟩)
+  | _ => none
+
+/-- The call `d.get()` through the instance of the trait object. -/
+def dynGet (d : D) : Option U32 :=
+  -- Read the value.
+  match d.inst.get d.value with
+  | ok m => some m
+  | _ => none
+
+/-- The result of `shorten(&mut c).bump(k)`, then `c.n`. -/
+def shortenBump (n k : U32) : Option (U32 × U32) :=
+  -- Call the model.
+  match shorten (cell n) with
+  | ok (y, back) =>
+    -- Write through the returned borrow.
+    match dynBump y k with
+    | some (r, y1) => (dynGet (back y1)).map (r, ·)
+    -- The write failed.
+    | none => none
+  -- The model failed.
+  | _ => none
+
+/-- The result of `second(&mut c, &mut e).bump(k)`, then `(c.n, e.n)`. -/
+def secondBump (n0 n1 k : U32) : Option (U32 × U32 × U32) :=
+  -- Call the model.
+  match second (cell n0) (cell n1) with
+  | ok (y, back) =>
+    -- Write through the returned borrow.
+    match dynBump y k with
+    | some (r, y1) =>
+      -- Give the value back to the two owners.
+      match dynGet (back y1).1, dynGet (back y1).2 with
+      | some m0, some m1 => some (r, m0, m1)
+      -- A read failed.
+      | _, _ => none
+
+    -- The write failed.
+    | none => none
+  -- The model failed.
+  | _ => none
+
+/-- The calls `hold(t, &mut c)` and `d.bump(k)`. -/
+def holdBump (t n k : U32) : Option (U32 × U32 × U32) :=
+  -- Call the model.
+  match hold t (cell n) with
+  | ok ((tag, d), back) =>
+    -- Write through the returned borrow.
+    match dynBump d k with
+    | some (r, d1) => (dynGet (back d1)).map (tag, r, ·)
+    -- The write failed.
+    | none => none
+  -- The model failed.
+  | _ => none
+
+-- Native test shorten_is_the_identity.
+#guard shortenBump 7#u32 1#u32 == some (8#u32, 8#u32)
+-- Native test second_writes_its_owner_only.
+#guard secondBump 1#u32 20#u32 5#u32 == some (25#u32, 1#u32, 25#u32)
+-- Native test hold_writes_the_owner.
+#guard holdBump 4#u32 4294967295#u32 1#u32 == some (4#u32, 0#u32, 0#u32)
+
+end dyn_upcast_mut_borrow.checks
