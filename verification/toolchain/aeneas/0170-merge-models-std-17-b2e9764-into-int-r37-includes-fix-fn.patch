+
+/-! ### `ContentDeserializer` and its access types -/
+
+/-- `pub struct ContentDeserializer<'de, E> { content: Content<'de>, err: PhantomData<E> }` -/
+@[rust_type "serde::private::de::content::ContentDeserializer" (body := .opaque)]
+structure ContentDeserializer (E : Type) where
+  content : Content
+
+/-- `ContentDeserializer::new(content)` -/
+@[rust_fun "serde::private::de::content::{serde::private::de::content::ContentDeserializer<'de, @E>}::new"]
+def ContentDeserializer.new (E : Type) (content : Content) : Result (ContentDeserializer E) :=
+  ok ⟨content⟩
+
+/-- `content_unexpected(&content)`: the `Unexpected` of a content (`as u64`/`as i64`/`as f64`
+    widenings; an option is `Option`). -/
+def contentUnexpected : Content → Result serde_core.de.Unexpected
+  | .Bool b => ok (.Bool b)
+  | .U8 n => ok (.Unsigned (n.cast .U64))
+  | .U16 n => ok (.Unsigned (n.cast .U64))
+  | .U32 n => ok (.Unsigned (n.cast .U64))
+  | .U64 n => ok (.Unsigned n)
+  | .I8 n => ok (.Signed (n.cast .I64))
+  | .I16 n => ok (.Signed (n.cast .I64))
+  | .I32 n => ok (.Signed (n.cast .I64))
+  | .I64 n => ok (.Signed n)
+  | .F32 f => ok (.Float (F32.toF64 f))
+  | .F64 f => ok (.Float f)
+  | .Char c => ok (.Char c)
+  | .String s => do ok (.Str (← Str.ofString s))
+  | .Str s => ok (.Str s)
+  | .ByteBuf b => ok (.Bytes b)
+  | .Bytes b => ok (.Bytes b)
+  | .None | .Some _ => ok .Option
+  | .Unit => ok .Unit
+  | .Newtype _ => ok .NewtypeStruct
+  | .Seq _ => ok .Seq
+  | .Map _ => ok .Map
+
+/-- `&"..."` as a `&dyn Expected` (`impl Expected for &str`: `formatter.write_str(self)`). -/
+def expectedStr (s : String) : DynExpected := expectedOf (fun (_ : Unit) f => f.append s) ()
+
+/-- `struct ExpectedInSeq(usize)` / `ExpectedInMap(usize)` and their `Expected`: "1 element in
+    {what}", else "{n} elements in {what}". -/
+def expectedIn (what : String) (n : Nat) : DynExpected :=
+  ⟨Nat, ⟨fun n f =>
+    if n = 1 then f.append ("1 element in " ++ what)
+    else writeArgs f (cat [core.fmt.num.DisplayUsize.fmt ⟨BitVec.ofNat _ n⟩,
+      lit (" elements in " ++ what)])⟩, n⟩
+
+/-- `Err(Error::invalid_type(unexp, exp))` -/
+def invalidTypeErr {Value E : Type} (errInst : serde_core.de.Error E) (unexp : serde_core.de.Unexpected)
+    (exp : DynExpected) : Result (core.result.Result Value E) := do
+  ok (.Err (← errInst.invalid_type unexp exp))
+
+/-- A visit through a `&mut` access (`visitor.visit_seq(&mut seq_visitor)`, then
+    `seq_visitor.end()`): the visitor consumes the access, the caller reads its final state. The
+    access of `run k` gives at most `k` elements and diverges when asked for one more while elements
+    remain; the visitor is a function of what the access gives it, so `run k` is the Rust run when it
+    asks for at most `k` elements and diverges otherwise. The least `k ≤ len` whose run has a result
+    is the number of elements the Rust visit took: its result is the Rust result, and `len - k`
+    elements remain (`end`). No such `k` is the Rust divergence, or the nesting cutoff of the
+    enclosing level, which the enclosing `limitFrom` resolves. The search relies on the
+    cut-monotonicity invariant (`Serde/De.lean`): `consumedRun_ok`, `consumedRun_of_chain` and
+    `consumedRun_count` below give its consequences. -/
+def consumedRun {α : Type} (run : Nat → Result α) (k : Nat) : (fuel : Nat) → Result (α × Nat)
+  | 0 => do ok (← run k, k)
+  | fuel + 1 =>
+    match run k with
+    | .div => consumedRun run (k + 1) fuel
+    | .ok a => ok (a, k)
+    | .fail e => .fail e
+
+/-- A result `(a, j)` comes from the run with budget `j`. -/
+theorem consumedRun_ok {α : Type} {run : Nat → Result α} {k fuel : Nat} {a : α}
+    -- The result.
+    {j : Nat} (h : consumedRun run k fuel = ok (a, j)) :
+    -- The run with budget `j` gives `a`.
+    run j = ok a ∧ k ≤ j ∧ j ≤ k + fuel ∧
+    -- Every smaller budget diverges.
+    ∀ i, k ≤ i → i < j → run i = .div := by
+  -- Induction on the fuel.
+  induction fuel generalizing k with
+
+  | zero =>
+    simp only [consumedRun] at h
+    -- The last budget.
+    cases hr : run k with
+    | ok b =>
+      rw [hr] at h
+      cases h
+      -- The run with budget `k`.
+      exact ⟨hr, Nat.le_refl _, by omega, fun i h1 h2 => absurd h2 (by omega)⟩
+    -- No result.
+    | fail e =>
+      rw [hr] at h
+      cases h
+    -- No result.
+    | div =>
+      rw [hr] at h
+      cases h
+
+  | succ fuel ih =>
+    simp only [consumedRun] at h
+    split at h
+    -- The budget `k` diverges.
+    · rename_i hr
+      rcases ih h with ⟨h1, h2, h3, h4⟩
+      -- The bounds.
+      refine ⟨h1, by omega, by omega, ?_⟩
+      intro i hi hij
+      -- The budget `k` or a larger one.
+      by_cases hik : i = k
+      · rw [hik]
+        exact hr
+      · exact h4 i (by omega) hij
+
+    -- The budget `k` gives a value.
+    · rename_i b hr
+      cases h
+      -- The run with budget `k`.
+      exact ⟨hr, Nat.le_refl _, by omega, fun i h1 h2 => absurd h2 (by omega)⟩
+    -- The budget `k` fails.
+    · cases h
+
+/-- On a chain, a defined run within the fuel gives a result. -/
+theorem consumedRun_of_chain {α : Type} {run : Nat → Result α} (hc : IsChain run)
+    -- The budget `n` is in the range.
+    {k fuel n : Nat} (hkn : k ≤ n) (hn : n ≤ k + fuel)
+    -- Its run gives `a`.
+    {a : α} (h : run n = ok a) :
+    -- The result.
+    ∃ j, j ≤ n ∧ consumedRun run k fuel = ok (a, j) := by
+  -- Induction on the fuel.
+  induction fuel generalizing k with
+
+  | zero =>
+    -- The last budget.
+    rw [show k = n by omega]
+    exact ⟨n, Nat.le_refl _, by simp [consumedRun, h]⟩
+
+  | succ fuel ih =>
+    simp only [consumedRun]
+    -- The budget `k` diverges, gives a value or fails.
+    cases hr : run k with
+    | div =>
+      have hk : k ≠ n := by
+        -- The budget `n` gives a value.
+        intro e
+        rw [e, h] at hr
+        cases hr
+      -- The next budget.
+      exact ih (k := k + 1) (by omega) (by omega)
+
+    | ok b =>
+      rcases hc k n hkn with h' | h'
+      · rw [hr] at h'
+        cases h'
+      -- The chain gives the value.
+      · rw [hr, h] at h'
+        cases h'
+        exact ⟨k, hkn, rfl⟩
+
+    | fail e =>
+      rcases hc k n hkn with h' | h'
+      · rw [hr] at h'
+        cases h'
+      -- A failure is not a value.
+      · rw [hr, h] at h'
+        cases h'
+
+/-- The budget invariant of an access gives the count `c` of the elements of the visit. -/
+theorem consumedRun_count {α : Type} {run : Nat → Result α} {c len : Nat} {a : α}
+    -- The budgets below `c` diverge.
+    (hlt : ∀ i, i < c → run i = .div)
+
+    -- The budgets from `c` give `a`.
+    (hge : ∀ i, c ≤ i → run i = ok a) (hc : c ≤ len) :
+    -- The result.
+    consumedRun run 0 len = ok (a, c) := by
+  -- The runs form a chain.
+  have hchain : IsChain run := by
+    intro m n hmn
+    -- The budget `m` is below `c` or not.
+    by_cases hm : m < c
+    · exact Or.inl (hlt m hm)
+    -- Both budgets are from `c`.
+    · exact Or.inr (by rw [hge m (by omega), hge n (by omega)])
+
+  -- A result exists.
+  rcases consumedRun_of_chain hchain (fuel := len) (Nat.zero_le c) (by omega)
+    (hge c (Nat.le_refl c)) with ⟨j, _, h⟩
+  -- Its properties.
+  rcases consumedRun_ok h with ⟨h1, _, _, _⟩
+
+  -- Its budget is `c`.
+  have hj : j = c := by
+    by_cases hjc : j < c
+    -- A smaller budget diverges.
+    · rw [hlt j hjc] at h1
+      cases h1
+    · omega
+  -- The result.
+  rw [hj] at h
+  exact h
+
+/-- The format types of `ContentDeserializer<E>`: the deserializer (its content), the
+    `SeqDeserializer` and `MapDeserializer` a visitor borrows mutably (the remaining elements or
+    entries, the pending value, and the budget of `consumedRun`), `EnumDeserializer` (the variant and
+    its value) and `VariantDeserializer` (the value), all with error `E`. -/
+@[reducible] def ContentTypes (E : Type) : FormatTypes where
+  ιD := Unit
+  D := fun _ => ContentDeserializer E
+  DError := fun _ => E
+  ιS := Unit
+  S := fun _ => List Content × Nat
+  SError := fun _ => E
+  ιM := Unit
+  M := fun _ => List (Content × Content) × Option Content × Nat
+  MError := fun _ => E
+  ιE := Unit
+  E := fun _ => Content × Option Content
+  EError := fun _ => E
+  EVariant := fun _ => Option Content
+  ιV := Unit
+  V := fun _ => Option Content
+  VError := fun _ => E
+
+/-- `visit_content_seq(content, visitor)` (and `SeqDeserializer::deserialize_any`):
+    `visitor.visit_seq(&mut SeqDeserializer::new(content))?`, then `end()`: the remaining elements
+    are `Error::invalid_length(count + remaining, &ExpectedInSeq(count))`. -/
+def visitContentSeq {X : Fam} {E : Type} (errInst : serde_core.de.Error E) (sub : (ContentTypes E).Dicts X) {V Value : Type} (vis : VisitorStep X V Value) (v : V) (xs : List Content) :
+    Result (core.result.Result Value E) := do
+  let (r, count) ← consumedRun (fun k => vis.visit_seq (sub.seqs ()) v (xs, k)) 0 xs.length
+  match r with
+  | .Err e => ok (.Err e)
+  | .Ok value =>
+    if count = xs.length then ok (.Ok value)
+    else ok (.Err (← errInst.invalid_length ⟨BitVec.ofNat _ xs.length⟩ (expectedIn "sequence" count)))
+
+/-- `visit_content_map(content, visitor)` (and `MapDeserializer::deserialize_any`):
+    `visitor.visit_map(&mut MapDeserializer::new(content))?`, then `end()`: the remaining entries
+    are `Error::invalid_length(count + remaining, &ExpectedInMap(count))`. -/
+def visitContentMap {X : Fam} {E : Type} (errInst : serde_core.de.Error E) (sub : (ContentTypes E).Dicts X) {V Value : Type} (vis : VisitorStep X V Value) (v : V)
+    (kvs : List (Content × Content)) : Result (core.result.Result Value E) := do
+  let (r, count) ← consumedRun (fun k => vis.visit_map (sub.maps ()) v (kvs, none, k)) 0 kvs.length
+  match r with
+  | .Err e => ok (.Err e)
+  | .Ok value =>
+    if count = kvs.length then ok (.Ok value)
+    else ok (.Err (← errInst.invalid_length ⟨BitVec.ofNat _ kvs.length⟩ (expectedIn "map" count)))
+
+/-- `self.invalid_type(&visitor)`: `Error::invalid_type(content_unexpected(&self.content), &visitor)`. -/
+def invalidTypeOf {X : Fam} {E : Type} (errInst : serde_core.de.Error E) {V Value : Type} (vis : VisitorStep X V Value) (v : V) (c : Content) :
+    Result (core.result.Result Value E) := do
+  invalidTypeErr errInst (← contentUnexpected c) (expectedOf vis.expecting v)
+
+/-- `ContentDeserializer::deserialize_integer` -/
+def deserializeInteger {X : Fam} {E : Type} (errInst : serde_core.de.Error E) {V Value : Type} (vis : VisitorStep X V Value) (c : Content) (v : V) :
+    Result (core.result.Result Value E) :=
+  match c with
+  | .U8 x => vis.visit_u8 errInst v x
+  | .U16 x => vis.visit_u16 errInst v x
+  | .U32 x => vis.visit_u32 errInst v x
+  | .U64 x => vis.visit_u64 errInst v x
+  | .I8 x => vis.visit_i8 errInst v x
+  | .I16 x => vis.visit_i16 errInst v x
+  | .I32 x => vis.visit_i32 errInst v x
+  | .I64 x => vis.visit_i64 errInst v x
+  | _ => invalidTypeOf errInst vis v c
+
+/-- `ContentDeserializer::deserialize_float` -/
+def deserializeFloat {X : Fam} {E : Type} (errInst : serde_core.de.Error E) {V Value : Type} (vis : VisitorStep X V Value) (c : Content) (v : V) :
+    Result (core.result.Result Value E) :=
+  match c with
+  | .F32 x => vis.visit_f32 errInst v x
+  | .F64 x => vis.visit_f64 errInst v x
+  | _ => deserializeInteger errInst vis c v
+
+/-- `ContentDeserializer::deserialize_any` -/
+def deserializeAny {X : Fam} {E : Type} (errInst : serde_core.de.Error E) (sub : (ContentTypes E).Dicts X) {V Value : Type} (vis : VisitorStep X V Value) (c : Content) (v : V) :
+    Result (core.result.Result Value E) :=
+  match c with
+  | .Bool x => vis.visit_bool errInst v x
+  | .F32 x => vis.visit_f32 errInst v x
+  | .F64 x => vis.visit_f64 errInst v x
+  | .Char x => vis.visit_char errInst v x
+  | .String x => vis.visit_string errInst v x
+  | .Str x => vis.visit_borrowed_str errInst v x
+  | .ByteBuf x => vis.visit_byte_buf errInst v x
+  | .Bytes x => vis.visit_borrowed_bytes errInst v x
+  | .Unit => vis.visit_unit errInst v
+  | .None => vis.visit_none errInst v
+  | .Some x => vis.visit_some (sub.des ()) v ⟨x⟩
+  | .Newtype x => vis.visit_newtype_struct (sub.des ()) v ⟨x⟩
+  | .Seq x => visitContentSeq errInst sub vis v x.elems.toList
+  | .Map x => visitContentMap errInst sub vis v x.elems.toList
+  | _ => deserializeInteger errInst vis c v
+
+/-- `impl<'de, E: Error> Deserializer<'de> for ContentDeserializer<'de, E>` one level above `sub`
+    (serde's methods; `deserialize_i128`/`deserialize_u128` and `is_human_readable` are the
+    provided ones). -/
+def contentDeserializerStep {X : Fam} {E : Type} (errInst : serde_core.de.Error E) (sub : (ContentTypes E).Dicts X) : DeserializerF (Step X) (ContentDeserializer E) E :=
+  let str : {V Value : Type} → VisitorStep X V Value → ContentDeserializer E → V →
+      Result (core.result.Result Value E) := fun vis self v =>
+    match self.content with
+    | .String x => vis.visit_string errInst v x
+    | .Str x => vis.visit_borrowed_str errInst v x
+    | .ByteBuf x => vis.visit_byte_buf errInst v x
+    | .Bytes x => vis.visit_borrowed_bytes errInst v x
+    | c => invalidTypeOf errInst vis v c
+  let bytes : {V Value : Type} → VisitorStep X V Value → ContentDeserializer E → V →
+      Result (core.result.Result Value E) := fun vis self v =>
+    match self.content with
+    | .Seq x => visitContentSeq errInst sub vis v x.elems.toList
+    | _ => str vis self v
+  let seq : {V Value : Type} → VisitorStep X V Value → ContentDeserializer E → V →
+      Result (core.result.Result Value E) := fun vis self v =>
+    match self.content with
+    | .Seq x => visitContentSeq errInst sub vis v x.elems.toList
+    | c => invalidTypeOf errInst vis v c
+  let int : {V Value : Type} → VisitorStep X V Value → ContentDeserializer E → V →
+      Result (core.result.Result Value E) := fun vis self v => deserializeInteger errInst vis self.content v
+  let float : {V Value : Type} → VisitorStep X V Value → ContentDeserializer E → V →
+      Result (core.result.Result Value E) := fun vis self v => deserializeFloat errInst vis self.content v
+  let any : {V Value : Type} → VisitorStep X V Value → ContentDeserializer E → V →
+      Result (core.result.Result Value E) := fun vis self v => deserializeAny errInst sub vis self.content v
+  { serde_coredeErrorInst := errInst
+    deserialize_any := any
+    deserialize_bool := fun vis self v =>
+      match self.content with
+      | .Bool x => vis.visit_bool errInst v x
+      | c => invalidTypeOf errInst vis v c
+    deserialize_i8 := int, deserialize_i16 := int, deserialize_i32 := int, deserialize_i64 := int
+    deserialize_u8 := int, deserialize_u16 := int, deserialize_u32 := int, deserialize_u64 := int
+    deserialize_f32 := float, deserialize_f64 := float
+    deserialize_char := fun vis self v =>
+      match self.content with
+      | .Char x => vis.visit_char errInst v x
+      | .String x => vis.visit_string errInst v x
+      | .Str x => vis.visit_borrowed_str errInst v x
+      | c => invalidTypeOf errInst vis v c
+    deserialize_str := str, deserialize_string := str
+    deserialize_bytes := bytes, deserialize_byte_buf := bytes
+    deserialize_option := fun vis self v =>
+      match self.content with
+      | .None => vis.visit_none errInst v
+      | .Some x => vis.visit_some (sub.des ()) v ⟨x⟩
+      | .Unit => vis.visit_unit errInst v
+      | _ => vis.visit_some (sub.des ()) v self
+    deserialize_unit := fun vis self v =>
+      match self.content with
+      | .Unit => vis.visit_unit errInst v
+      | .Map x => if x.len = 0 then vis.visit_unit errInst v else invalidTypeOf errInst vis v self.content
+      | c => invalidTypeOf errInst vis v c
+    deserialize_unit_struct := fun vis self _ v =>
+      match self.content with
+      | .Map x => if x.len = 0 then vis.visit_unit errInst v else any vis self v
+      | .Seq x => if x.len = 0 then vis.visit_unit errInst v else any vis self v
+      | _ => any vis self v
+    deserialize_newtype_struct := fun vis self _ v =>
+      match self.content with
+      | .Newtype x => vis.visit_newtype_struct (sub.des ()) v ⟨x⟩
+      | _ => vis.visit_newtype_struct (sub.des ()) v self
+    deserialize_seq := seq
+    deserialize_tuple := fun vis self _ v => seq vis self v
+    deserialize_tuple_struct := fun vis self _ _ v => seq vis self v
+    deserialize_map := fun vis self v =>
+      match self.content with
+      | .Map x => visitContentMap errInst sub vis v x.elems.toList
+      | c => invalidTypeOf errInst vis v c
+    deserialize_struct := fun vis self _ _ v =>
+      match self.content with
+      | .Seq x => visitContentSeq errInst sub vis v x.elems.toList
+      | .Map x => visitContentMap errInst sub vis v x.elems.toList
+      | c => invalidTypeOf errInst vis v c
+    deserialize_enum := fun vis self _ _ v => do
+      match self.content with
+      | .Map x =>
+        match x.elems.toList with
+        | [(variant, value)] => vis.visit_enum (sub.enums ()) v (variant, some value)
+        | _ => ok (.Err (← errInst.invalid_value .Map (expectedStr "map with a single key")))
+      | .String s => vis.visit_enum (sub.enums ()) v (.String s, none)
+      | .Str s => vis.visit_enum (sub.enums ()) v (.Str s, none)
+      | c => invalidTypeErr errInst (← contentUnexpected c) (expectedStr "string or map")
+    deserialize_identifier := fun vis self v =>
+      match self.content with
+      | .String x => vis.visit_string errInst v x
+      | .Str x => vis.visit_borrowed_str errInst v x
+      | .ByteBuf x => vis.visit_byte_buf errInst v x
+      | .Bytes x => vis.visit_borrowed_bytes errInst v x
+      | .U8 x => vis.visit_u8 errInst v x
+      | .U64 x => vis.visit_u64 errInst v x
+      | c => invalidTypeOf errInst vis v c
+    deserialize_ignored_any := fun vis _ v => vis.visit_unit errInst v
+    __deserialize_content_v1 := fun _ self _ => ok (.Ok self.content) }
+
+/-- `impl SeqAccess for SeqDeserializer` (through `&mut`): the next element through
+    `seed.deserialize(ContentDeserializer::new(value))`; `size_hint` is the exact remaining length. -/
+def contentSeqStep {X : Fam} {E : Type} (errInst : serde_core.de.Error E) (sub : (ContentTypes E).Dicts X) : SeqAccessF (Step X) (List Content × Nat) E :=
+  { serde_coredeErrorInst := errInst
+    next_element_seed := fun seed st t =>
+      match st with
+      | ([], _) => ok (.Ok none, st)
+      | (_ :: _, 0) => .div
+      | (c :: rest, budget + 1) => do
+        match ← seed.deserialize (sub.des ()) t ⟨c⟩ with
+        | .Ok x => ok (.Ok (some x), (rest, budget))
+        | .Err e => ok (.Err e, (rest, budget))
+    size_hint := fun st => ok (some ⟨BitVec.ofNat _ st.1.length⟩) }
+
+/-- `impl MapAccess for MapDeserializer` (through `&mut`): `next_key_seed` keeps the entry's value
+    for `next_value_seed` (which panics without one: "MapAccess::next_value called before
+    next_key"), `next_entry_seed` deserializes the key then the value; `size_hint` is the exact
+    number of remaining entries. -/
+def contentMapStep {X : Fam} {E : Type} (errInst : serde_core.de.Error E) (sub : (ContentTypes E).Dicts X) : MapAccessF (Step X) (List (Content × Content) × Option Content × Nat) E :=
+  { serde_coredeErrorInst := errInst
+    next_key_seed := fun seed st k =>
+      match st with
+      | ([], _, _) => ok (.Ok none, st)
+      | (_ :: _, _, 0) => .div
+      | ((key, value) :: rest, _, budget + 1) => do
+        match ← seed.deserialize (sub.des ()) k ⟨key⟩ with
+        | .Ok x => ok (.Ok (some x), (rest, some value, budget))
+        | .Err e => ok (.Err e, (rest, some value, budget))
+    next_value_seed := fun seed st v =>
+      match st with
+      | (_, none, _) => .fail .panic
+      | (rest, some value, budget) => do
+        let r ← seed.deserialize (sub.des ()) v ⟨value⟩
+        ok (r, (rest, none, budget))
+    next_entry_seed := fun kseed vseed st k v =>
+      match st with
+      | ([], _, _) => ok (.Ok none, st)
+      | (_ :: _, _, 0) => .div
+      | ((key, value) :: rest, pending, budget + 1) => do
+        match ← kseed.deserialize (sub.des ()) k ⟨key⟩ with
+        | .Err e => ok (.Err e, (rest, pending, budget))
+        | .Ok key =>
+          match ← vseed.deserialize (sub.des ()) v ⟨value⟩ with
+          | .Err e => ok (.Err e, (rest, pending, budget))
+          | .Ok value => ok (.Ok (some (key, value)), (rest, pending, budget))
+    size_hint := fun st => ok (some ⟨BitVec.ofNat _ st.1.length⟩) }
+
+/-- `impl VariantAccess for VariantDeserializer`, `unitDe` being `impl Deserialize for ()` one level
+    above `sub`. -/
+def contentVariantStep {X : Fam} {E : Type} (errInst : serde_core.de.Error E) (sub : (ContentTypes E).Dicts X) (unitDe : (Step X).Deserialize Unit) :
+    VariantAccessF (Step X) (Option Content) E :=
+  { serde_coredeErrorInst := errInst
+    unit_variant := fun st =>
+      match st with
+      | some value => unitDe.deserialize (sub.des ()) ⟨value⟩
+      | none => ok (.Ok ())
+    newtype_variant_seed := fun seed st t => do
+      match st with
+      | some value => seed.deserialize (sub.des ()) t ⟨value⟩
+      | none => invalidTypeErr errInst .UnitVariant (expectedStr "newtype variant")
+    tuple_variant := fun vis st _ v => do
+      match st with
+      | some (.Seq x) => visitContentSeq errInst sub vis v x.elems.toList
+      | some other => invalidTypeErr errInst (← contentUnexpected other) (expectedStr "tuple variant")
+      | none => invalidTypeErr errInst .UnitVariant (expectedStr "tuple variant")
+    struct_variant := fun vis st _ v => do
+      match st with
+      | some (.Map x) => visitContentMap errInst sub vis v x.elems.toList
+      | some (.Seq x) => visitContentSeq errInst sub vis v x.elems.toList
+      | some other =>
+        invalidTypeErr errInst (← contentUnexpected other) (expectedStr "struct variant")
+      | none => invalidTypeErr errInst .UnitVariant (expectedStr "struct variant") }
+
+/-- `impl EnumAccess for EnumDeserializer`: `seed.deserialize(ContentDeserializer::new(variant))`,
+    with the variant's value in the `VariantDeserializer`. -/
+def contentEnumStep {X : Fam} {E : Type} (errInst : serde_core.de.Error E) (sub : (ContentTypes E).Dicts X) (unitDe : (Step X).Deserialize Unit) :
+    EnumAccessF (Step X) (Content × Option Content) E (Option Content) :=
+  { serde_coredeErrorInst := errInst
+    VariantAccessInst := contentVariantStep errInst sub unitDe
+    variant_seed := fun seed st v => do
+      match ← seed.deserialize (sub.des ()) v ⟨st.1⟩ with
+      | .Ok x => ok (.Ok (x, st.2))
+      | .Err e => ok (.Err e) }
+
+/-- The dictionaries of `ContentDeserializer<E>` and its access types at level `n` of the knot
+    (`unit_variant` calls `impl Deserialize for ()`, so they are built level by level). -/
+def contentDeAt {E : Type} (errInst : serde_core.de.Error E) : (n : Nat) → (ContentTypes E).Dicts (DeAt n)
+  | 0 => bottom (DeAt 0) (ContentTypes E)
+  | n + 1 =>
+    let sub := contentDeAt errInst n
+    let unitDe := (Deserialize.wrap serde_core.de.impls.DeserializeUnit).level (n + 1)
+    { des := fun _ => contentDeserializerStep errInst sub
+      seqs := fun _ => contentSeqStep errInst sub
+      maps := fun _ => contentMapStep errInst sub
+      enums := fun _ => contentEnumStep errInst sub unitDe
+      variants := fun _ => contentVariantStep errInst sub unitDe }
+
+/-- `impl<'de, E: Error> Deserializer<'de> for ContentDeserializer<'de, E>` as a Rust trait
+    dictionary: a content has no nesting bound, each method runs at the first level with a result. -/
+@[reducible, rust_trait_impl
+  "serde_core::de::Deserializer<'de, serde::private::de::content::ContentDeserializer<'de, @E>, @E>"]
+def DeserializerContentDeserializer {E : Type} (errInst : serde_core.de.Error E) : serde_core.de.Deserializer (ContentDeserializer E) E :=
+  FormatLevels.limit (contentDeAt errInst) () errInst
+
+/-- `ContentDeserializer::deserialize_any(self, visitor)` called directly (the derive's struct
+    variants): the dictionary's method with the wrapped visitor. -/
+@[rust_fun
+  "serde::private::de::content::{serde_core::de::Deserializer<'de, serde::private::de::content::ContentDeserializer<'de, @E>, @E>}::deserialize_any"]
+def DeserializerContentDeserializer.deserialize_any {E : Type} (errInst : serde_core.de.Error E) {V Value : Type}
+    (visInst : serde_core.de.Visitor V Value) (self : ContentDeserializer E) (visitor : V) :
+    Result (core.result.Result Value E) :=
+  (DeserializerContentDeserializer errInst).deserialize_any (Visitor.wrap visInst) self visitor
+
+end serde.private.de.content
+
+end Aeneas.Std
