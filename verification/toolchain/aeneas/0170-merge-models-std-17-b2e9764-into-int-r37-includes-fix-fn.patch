 namespace Aeneas.Std
 
+/-- `core::str::pattern::CharArraySearcher<'a, N>`, the searcher of a `[char; N]`
+    needle (a `MultiCharEqSearcher` over the haystack's `char_indices`). As for
+    `CharSearcher`, only its construction data are modeled. -/
+@[rust_type "core::str::pattern::CharArraySearcher" (body := .opaque)]
+structure core.str.pattern.CharArraySearcher (N : Usize) where
+  haystack : Str
+  needles : Array Char N
+
+/-- The successive `next_match` results of a `MultiCharEqSearcher` (core
+    str/pattern.rs, rustc 1.95): its `next` steps through `char_indices`, a
+    `Match` of the char's byte range when `char_eq.matches(c)` holds (`isNeedle`), else a
+    `Reject`, so `next_match` returns the byte ranges of the matching chars,
+    from the first. `next_back` steps through `char_indices` from the back:
+    `next_match_back` returns the same ranges from the last. -/
+def core.str.pattern.MultiCharEqSearcher.forwardMatches (haystack : Str)
+    (isNeedle : Char → Bool) : Result (List (Nat × Nat)) := do
+  let chars := (← Str.toString haystack).toList
+  let starts := chars.scanl (fun pos char => pos + char.utf8Size) 0
+  .ok ((chars.zip starts).filterMap fun (char, pos) =>
+    if isNeedle char then some (pos, pos + char.utf8Size) else none)
+
+/-- `impl Searcher for CharArraySearcher`, pattern.rs: `haystack` returns the
+    haystack of its `MultiCharEqSearcher`. -/
+@[rust_fun
+  "core::str::pattern::{core::str::pattern::Searcher<'a, core::str::pattern::CharArraySearcher<'a, @N>>}::haystack"]
+def core.str.pattern.SearcherCharArraySearcher.haystack {N : Usize}
+    (self : core.str.pattern.CharArraySearcher N) : Result Str :=
+  .ok self.haystack
+
+@[reducible, rust_trait_impl
+  "core::str::pattern::Searcher<'a, core::str::pattern::CharArraySearcher<'a, @N>>"]
+def core.str.pattern.SearcherCharArraySearcher (N : Usize) :
+    core.str.pattern.Searcher (core.str.pattern.CharArraySearcher N) := {
+  haystack := core.str.pattern.SearcherCharArraySearcher.haystack
+}
+
+@[reducible, rust_trait_impl
+  "core::str::pattern::ReverseSearcher<'a, core::str::pattern::CharArraySearcher<'a, @N>>"]
+def core.str.pattern.ReverseSearcherCharArraySearcher (N : Usize) :
+    core.str.pattern.ReverseSearcher (core.str.pattern.CharArraySearcher N) := {
+  searcherInst := core.str.pattern.SearcherCharArraySearcher N
+}
+
+/-- `impl Pattern for [char; N]`, pattern.rs: the methods of
+    `MultiCharEqPattern(self)`, whose searcher is `CharArraySearcher` and whose
+    `char_eq.matches(c)` is `self.contains(&c)`. Its `is_prefix_of` is
+    `Pattern`'s default, `matches!(self.into_searcher(haystack).next(),
+    SearchStep::Match(0, _))`: the haystack's first char is in the array. -/
+@[rust_fun "core::str::pattern::{core::str::pattern::Pattern<[char; @N]>}::is_prefix_of"]
+def core.str.pattern.PatternCharArray.is_prefix_of {N : Usize} (needles : Array Char N)
+    (haystack : Str) : Result Bool := do
+  match (← Str.toString haystack).toList with
+  | [] => .ok false
+  | char :: _ => .ok (needles.val.contains char)
+
+@[reducible, rust_trait_impl "core::str::pattern::Pattern<[char; @N]>"]
+def core.str.pattern.PatternCharArray (N : Usize) : core.str.pattern.Pattern (Array Char N) := {
+  is_prefix_of := core.str.pattern.PatternCharArray.is_prefix_of
+  forward_matches := some fun needles haystack =>
+    core.str.pattern.MultiCharEqSearcher.forwardMatches haystack (needles.val.contains ·)
+  reverse_matches := some fun needles haystack => do
+    .ok (← core.str.pattern.MultiCharEqSearcher.forwardMatches haystack
+      (needles.val.contains ·)).reverse
+}
+
