--- /dev/null
+++ b/tests/src/fn-items-nonfailing.rs
@@ -0,0 +1,97 @@
+//@ [!lean] skip
+//@ [lean] subdir=FnItemsNonfailing
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::option::{core::option::Option} --include core::result::{core::result::Result}
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Function items used as values (`FnOnce`/`FnMut` arguments) whose function cannot fail
+//! (models of `Vec::len`, `i64::checked_neg`, `From<bool> for u8`, `u32::wrapping_add`, and the
+//! builtin `Box::new`): the item denotes `fun x => ok (f x)` in the `Result`-returning view of the
+//! `Fn*` traits, as the chelis sites below use them. Local functions are fallible in the
+//! translation: their items are passed as they are. FnItemsNonfailing/Checks.lean compares the
+//! model with the native results asserted in the native test module.
+
+/// chelis-types `infer/declarations.rs`: `graph.iter().map(Vec::len).sum()`
+pub fn edge_count(graph: &Vec<Vec<usize>>) -> usize {
+    graph.iter().map(Vec::len).sum()
+}
+
+/// chelis-ir `lower.rs`: `rank_substitutions.get(name).map(Vec::len)`
+pub fn width(slot: Option<&Vec<u32>>) -> Option<usize> {
+    slot.map(Vec::len)
+}
+
+/// chelis-types `infer/app_tensor.rs`: `extract_int_for_dim(arg, stack).and_then(i64::checked_neg)`
+pub fn negated(value: Option<i64>) -> Option<i64> {
+    value.and_then(i64::checked_neg)
+}
+
+/// chelis-types `dtype_semantics/wire_codec.rs`: `values.into_iter().map(u8::from).collect()`
+pub fn bool_bytes(values: Vec<bool>) -> Vec<u8> {
+    values.into_iter().map(u8::from).collect()
+}
+
+/// A non-failing item of two arguments, held in a local and passed twice.
+pub fn wrapping_totals(xs: &[u32], ys: &[u32]) -> (u32, u32) {
+    let add = u32::wrapping_add;
+    (xs.iter().copied().fold(0, add), ys.iter().copied().fold(1, add))
+}
+
+/// A non-failing item held in a local and called directly (a call of the function).
+pub fn direct_lens(a: &Vec<u32>, b: &Vec<u32>) -> (usize, usize) {
+    let len = Vec::len;
+    (len(a), len(b))
+}
+
+/// chelis-ir `host.rs`: `staged_plan.map(Box::new)` (boxes are erased: `Box::new` is the identity)
+pub fn boxed(value: Option<u32>) -> Option<Box<u32>> {
+    value.map(Box::new)
+}
+
+/// chelis-ir `host.rs`: `resolve_host_expr(*expr).map(Box::new)`
+pub fn boxed_ok(value: Result<u32, u8>) -> Result<Box<u32>, u8> {
+    value.map(Box::new)
+}
+
+/// A local function (fallible in the translation) passed as an item.
+fn succ(x: &u8) -> u8 {
+    *x + 1
+}
+
+pub fn successors(xs: &[u8]) -> Vec<u8> {
+    xs.iter().map(succ).collect()
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn fn_items() {
+        assert_eq!(edge_count(&vec![vec![1, 2], vec![], vec![0, 1, 2]]), 5);
+        assert_eq!(edge_count(&vec![]), 0);
+        assert_eq!(width(Some(&vec![7, 8, 9])), Some(3));
+        assert_eq!(width(Some(&vec![])), Some(0));
+        assert_eq!(width(None), None);
+        assert_eq!(negated(Some(5)), Some(-5));
+        assert_eq!(negated(Some(-7)), Some(7));
+        assert_eq!(negated(Some(i64::MIN)), None);
+        assert_eq!(negated(None), None);
+        assert_eq!(bool_bytes(vec![true, false, true]), vec![1, 0, 1]);
+        assert_eq!(bool_bytes(vec![]), Vec::<u8>::new());
+        assert_eq!(wrapping_totals(&[1, 2, 3], &[u32::MAX, 5]), (6, 5));
+        assert_eq!(wrapping_totals(&[], &[]), (0, 1));
+        assert_eq!(direct_lens(&vec![4, 5], &vec![]), (2, 0));
+        assert_eq!(direct_lens(&vec![], &vec![1, 2, 3]), (0, 3));
+        assert_eq!(boxed(Some(3)), Some(Box::new(3)));
+        assert_eq!(boxed(None), None);
+        assert_eq!(boxed_ok(Ok(4)), Ok(Box::new(4)));
+        assert_eq!(boxed_ok(Err(9)), Err(9));
+        assert_eq!(successors(&[0, 41, 254]), vec![1, 42, 255]);
+        assert_eq!(successors(&[]), Vec::<u8>::new());
+    }
+
+    #[test]
+    #[should_panic]
+    fn successor_overflows() {
+        successors(&[1, 255]);
+    }
+}
