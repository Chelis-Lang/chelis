+#[cfg(test)]
+mod native {
+    //! The in-test format: an owned value tree, each variant visited with one `visit_*` method.
+    use super::*;
+    use serde::de;
+
+    #[derive(Clone, Debug)]
+    pub enum Value {
+        Bool(bool),
+        U8(u8),
+        U16(u16),
+        U32(u32),
+        U64(u64),
+        I8(i8),
+        I64(i64),
+        F32(f32),
+        F64(f64),
+        Char(char),
+        /// `visit_str` (a transient borrow)
+        Str(String),
+        /// `visit_borrowed_str`
+        BStr(&'static str),
+        /// `visit_bytes`
+        Bytes(Vec<u8>),
+        /// `visit_borrowed_bytes`
+        BBytes(&'static [u8]),
+        Unit,
+        Opt(Option<Box<Value>>),
+        Newtype(Box<Value>),
+        Seq(Vec<Value>),
+        Map(Vec<(Value, Value)>),
+    }
+    use Value::*;
+
+    #[derive(Debug, PartialEq)]
+    pub struct TestError(pub String);
+
+    impl fmt::Display for TestError {
+        fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+            f.write_str(&self.0)
+        }
+    }
+
+    impl std::error::Error for TestError {}
+
+    impl de::Error for TestError {
+        fn custom<T: fmt::Display>(msg: T) -> Self {
+            TestError(msg.to_string())
+        }
+    }
+
+    pub struct ValueDe(pub Value);
+    pub struct SeqDe(std::vec::IntoIter<Value>);
+    pub struct MapDe {
+        entries: std::vec::IntoIter<(Value, Value)>,
+        value: Option<Value>,
+    }
+
+    impl<'de> Deserializer<'de> for ValueDe {
+        type Error = TestError;
+
+        fn deserialize_any<V: Visitor<'de>>(self, visitor: V) -> Result<V::Value, TestError> {
+            match self.0 {
+                Bool(v) => visitor.visit_bool(v),
+                U8(v) => visitor.visit_u8(v),
+                U16(v) => visitor.visit_u16(v),
+                U32(v) => visitor.visit_u32(v),
+                U64(v) => visitor.visit_u64(v),
+                I8(v) => visitor.visit_i8(v),
+                I64(v) => visitor.visit_i64(v),
+                F32(v) => visitor.visit_f32(v),
+                F64(v) => visitor.visit_f64(v),
+                Char(v) => visitor.visit_char(v),
+                Str(s) => visitor.visit_str(&s),
+                BStr(s) => visitor.visit_borrowed_str(s),
+                Bytes(b) => visitor.visit_bytes(&b),
+                BBytes(b) => visitor.visit_borrowed_bytes(b),
+                Unit => visitor.visit_unit(),
+                Opt(None) => visitor.visit_none(),
+                Opt(Some(v)) => visitor.visit_some(ValueDe(*v)),
+                Newtype(v) => visitor.visit_newtype_struct(ValueDe(*v)),
+                Seq(items) => visitor.visit_seq(SeqDe(items.into_iter())),
+                Map(entries) => visitor.visit_map(MapDe { entries: entries.into_iter(), value: None }),
+            }
+        }
+
+        serde::forward_to_deserialize_any! {
+            bool i8 i16 i32 i64 i128 u8 u16 u32 u64 u128 f32 f64 char str string
+            bytes byte_buf option unit unit_struct newtype_struct seq tuple
+            tuple_struct map struct enum identifier ignored_any
+        }
+    }
+
+    impl<'de> SeqAccess<'de> for SeqDe {
+        type Error = TestError;
+        fn next_element_seed<T: DeserializeSeed<'de>>(
+            &mut self, seed: T,
+        ) -> Result<Option<T::Value>, TestError> {
+            match self.0.next() {
+                Some(v) => seed.deserialize(ValueDe(v)).map(Some),
+                None => Ok(None),
+            }
+        }
+    }
+
+    impl<'de> MapAccess<'de> for MapDe {
+        type Error = TestError;
+        fn next_key_seed<K: DeserializeSeed<'de>>(
+            &mut self, seed: K,
+        ) -> Result<Option<K::Value>, TestError> {
+            match self.entries.next() {
+                Some((k, v)) => {
+                    self.value = Some(v);
+                    seed.deserialize(ValueDe(k)).map(Some)
+                }
+                None => Ok(None),
+            }
+        }
+        fn next_value_seed<V: DeserializeSeed<'de>>(
+            &mut self, seed: V,
+        ) -> Result<V::Value, TestError> {
+            match self.value.take() {
+                Some(v) => seed.deserialize(ValueDe(v)),
+                None => Err(TestError("value missing".to_string())),
+            }
+        }
+    }
+
+    fn pr(v: Value, method: u8) -> Result<String, TestError> {
+        probe(ValueDe(v), method)
+    }
+
+    fn ok(s: &str) -> Result<String, TestError> {
+        Ok(s.to_string())
+    }
+
+    fn err<T>(msg: &str) -> Result<T, TestError> {
+        Err(TestError(msg.to_string()))
+    }
+
+    fn inv(what: &str) -> Result<String, TestError> {
+        err(&format!("invalid type: {what}, expected anything"))
+    }
+
+    fn some(v: Value) -> Value {
+        Opt(Some(Box::new(v)))
+    }
+
+    fn nt(v: Value) -> Value {
+        Newtype(Box::new(v))
+    }
+
+    #[test]
+    fn deserialize_any() {
+        for (v, d) in [
+            (Bool(false), "bool false"),
+            (U8(1), "u8 1"),
+            (U16(2), "u16 2"),
+            (U32(3), "u32 3"),
+            (U64(4), "u64 4"),
+            (I8(-5), "i8 -5"),
+            (I64(-6), "i64 -6"),
+            (F32(2.0), "f32 40000000"),
+            (F64(-0.5), "f64 bfe0000000000000"),
+            (Char('x'), "char x"),
+            (Str("t".to_string()), "string t"),
+            (BStr("b"), "borrowed_str b"),
+            (Bytes(vec![1, 2]), "byte_buf [1;2;]"),
+            (BBytes(&[3]), "borrowed_bytes [3;]"),
+            (Unit, "unit"),
+            (Opt(None), "none"),
+            (some(U8(1)), "some(u8 1)"),
+            (nt(BStr("n")), "newtype(borrowed_str n)"),
+            (Seq(vec![U8(1), Seq(vec![])]), "seq[u8 1;seq[];]"),
+            (Map(vec![(BStr("k"), some(Unit))]), "map{borrowed_str k: some(unit);}"),
+        ] {
+            assert_eq!(pr(v.clone(), 0), ok(d));
+            assert_eq!(probe_direct(ValueDe(v)), ok(d));
+        }
+    }
+
+    #[test]
+    fn scalar_methods() {
+        assert_eq!(pr(Bool(true), 1), ok("bool true"));
+        assert_eq!(pr(U8(1), 1), inv("integer `1`"));
+        for m in 2..=9 {
+            assert_eq!(pr(U16(5), m), ok("u16 5"));
+            assert_eq!(pr(I64(-1), m), ok("i64 -1"));
+            assert_eq!(pr(F64(1.5), m), inv("floating point `1.5`"));
+            assert_eq!(pr(Bool(true), m), inv("boolean `true`"));
+        }
+        for m in [10, 11] {
+            assert_eq!(pr(F32(1.0), m), ok("f32 3f800000"));
+            assert_eq!(pr(F64(1.0), m), ok("f64 3ff0000000000000"));
+            assert_eq!(pr(U32(9), m), ok("u32 9"));
+            assert_eq!(pr(I8(-9), m), ok("i8 -9"));
+            assert_eq!(pr(BStr("1"), m), inv("string \"1\""));
+        }
+        assert_eq!(pr(Char('é'), 12), ok("char é"));
+        assert_eq!(pr(Str("ab".to_string()), 12), ok("string ab"));
+        assert_eq!(pr(BStr("c"), 12), ok("borrowed_str c"));
+        assert_eq!(pr(U8(1), 12), inv("integer `1`"));
+        assert_eq!(pr(Bytes(vec![0x61]), 12), inv("byte array"));
+        assert_eq!(pr(Char('z'), 29), err("i128 is not supported"));
+        assert_eq!(pr(U8(1), 30), err("u128 is not supported"));
+        assert_eq!(pr(Unit, 31), ok("human readable true"));
+    }
+
+    #[test]
+    fn string_and_bytes_methods() {
+        for m in [13, 14, 15, 16] {
+            assert_eq!(pr(Str("s".to_string()), m), ok("string s"));
+            assert_eq!(pr(BStr("b"), m), ok("borrowed_str b"));
+            assert_eq!(pr(Bytes(vec![7]), m), ok("byte_buf [7;]"));
+            assert_eq!(pr(BBytes(&[8]), m), ok("borrowed_bytes [8;]"));
+            assert_eq!(pr(Char('c'), m), inv("character `c`"));
+            assert_eq!(pr(Unit, m), inv("unit value"));
+        }
+        assert_eq!(pr(Seq(vec![U8(1)]), 13), inv("sequence"));
+        assert_eq!(pr(Seq(vec![U8(1)]), 16), ok("seq[u8 1;]"));
+        assert_eq!(pr(Seq(vec![U8(1), U8(2)]), 15), ok("seq[u8 1;u8 2;]"));
+        assert_eq!(pr(Map(vec![]), 15), inv("map"));
+        assert_eq!(pr(BStr("x"), 27), ok("borrowed_str x"));
+        assert_eq!(pr(Bytes(vec![1]), 27), ok("byte_buf [1;]"));
+        assert_eq!(pr(U8(3), 27), ok("u8 3"));
+        assert_eq!(pr(U64(4), 27), ok("u64 4"));
+        assert_eq!(pr(U16(5), 27), inv("integer `5`"));
+        assert_eq!(pr(Char('c'), 27), inv("character `c`"));
+    }
+
+    #[test]
+    fn option_unit_newtype_methods() {
+        assert_eq!(pr(Opt(None), 17), ok("none"));
+        assert_eq!(pr(some(U8(1)), 17), ok("some(u8 1)"));
+        assert_eq!(pr(Unit, 17), ok("unit"));
+        assert_eq!(pr(U8(1), 17), ok("some(u8 1)"));
+        assert_eq!(pr(Seq(vec![]), 17), ok("some(seq[])"));
+        assert_eq!(pr(Unit, 18), ok("unit"));
+        assert_eq!(pr(Map(vec![]), 18), ok("unit"));
+        assert_eq!(pr(Map(vec![(U8(1), U8(2))]), 18), inv("map"));
+        assert_eq!(pr(Seq(vec![]), 18), inv("sequence"));
+        assert_eq!(pr(Opt(None), 18), inv("Option value"));
+        assert_eq!(pr(Map(vec![]), 19), ok("unit"));
+        assert_eq!(pr(Seq(vec![]), 19), ok("unit"));
+        assert_eq!(pr(U8(1), 19), ok("u8 1"));
+        assert_eq!(pr(Seq(vec![Unit]), 19), ok("seq[unit;]"));
+        assert_eq!(pr(nt(U8(1)), 20), ok("newtype(u8 1)"));
+        assert_eq!(pr(U8(1), 20), ok("newtype(u8 1)"));
+        assert_eq!(pr(nt(nt(Unit)), 20), ok("newtype(newtype(unit))"));
+        for v in [Bool(true), Seq(vec![]), Map(vec![(U8(1), U8(1))]), some(Unit)] {
+            assert_eq!(pr(v, 28), ok("unit"));
+        }
+    }
+
+    #[test]
+    fn seq_map_struct_methods() {
+        for m in [21, 22, 23] {
+            assert_eq!(pr(Seq(vec![U8(1), BStr("a")]), m), ok("seq[u8 1;borrowed_str a;]"));
+            assert_eq!(pr(Map(vec![]), m), inv("map"));
+            assert_eq!(pr(Bytes(vec![1]), m), inv("byte array"));
+        }
+        assert_eq!(pr(Map(vec![(U8(1), Seq(vec![]))]), 24), ok("map{u8 1: seq[];}"));
+        assert_eq!(pr(Seq(vec![]), 24), inv("sequence"));
+        assert_eq!(pr(Seq(vec![U8(1)]), 25), ok("seq[u8 1;]"));
+        assert_eq!(pr(Map(vec![(BStr("a"), U8(1))]), 25), ok("map{borrowed_str a: u8 1;}"));
+        assert_eq!(pr(Unit, 25), inv("unit value"));
+        // the visitor leaves elements or entries: `end` reports them
+        assert_eq!(pr(Seq(vec![U8(1)]), 32), ok("first u8 1"));
+        assert_eq!(pr(Seq(vec![]), 32), ok("empty"));
+        assert_eq!(pr(Seq(vec![U8(1), U8(2), U8(3)]), 32), err("invalid length 3, expected 1 element in sequence"));
+        assert_eq!(pr(Map(vec![(U8(1), U8(2))]), 33), ok("first u8 1: u8 2"));
+        assert_eq!(pr(Map(vec![(U8(1), U8(2)), (U8(3), U8(4))]), 33), err("invalid length 2, expected 1 element in map"));
+        assert_eq!(pr(Map(vec![(U8(1), U8(2)), (U8(3), U8(4)), (U8(5), U8(6))]), 34), err("invalid length 3, expected 1 element in map"));
+        assert_eq!(pr(Seq(vec![U8(1), U8(2)]), 34), err("invalid length 2, expected 1 element in sequence"));
+        assert_eq!(pr(Seq(vec![U8(1), U8(2)]), 33), err("invalid type: sequence, expected the first element"));
+    }
+
+    #[test]
+    fn enum_method() {
+        assert_eq!(pr(Map(vec![(BStr("A"), U8(1))]), 26), ok("enum borrowed_str A = u8 1"));
+        assert_eq!(pr(Map(vec![(U8(0), Unit)]), 26), ok("enum u8 0 = unit"));
+        assert_eq!(pr(Map(vec![]), 26), err("invalid value: map, expected map with a single key"));
+        assert_eq!(
+            pr(Map(vec![(BStr("A"), U8(1)), (BStr("B"), U8(2))]), 26),
+            err("invalid value: map, expected map with a single key")
+        );
+        assert_eq!(pr(BStr("A"), 26), err("invalid type: unit variant, expected newtype variant"));
+        assert_eq!(pr(Str("A".to_string()), 26), err("invalid type: unit variant, expected newtype variant"));
+        assert_eq!(pr(U8(1), 26), err("invalid type: integer `1`, expected string or map"));
+        assert_eq!(pr(Bytes(vec![65]), 26), err("invalid type: byte array, expected string or map"));
+    }
+
+    fn point(v: Value) -> Result<String, TestError> {
+        via_content::<Point, _>(ValueDe(v)).map(|p| format!("x {} y {:?}", p.x, p.y))
+    }
+
+    fn shape(v: Value) -> Result<String, TestError> {
+        via_content::<Shape, _>(ValueDe(v)).map(|s| match s {
+            Shape::Unit => "Unit".to_string(),
+            Shape::Tup(n, b) => format!("Tup {n} {b}"),
+            Shape::Rec { a } => format!("Rec {a}"),
+        })
+    }
+
+    fn e(k: &'static str, v: Value) -> (Value, Value) {
+        (BStr(k), v)
+    }
+
+    #[test]
+    fn derived_struct() {
+        assert_eq!(point(Map(vec![e("x", I64(-2)), e("y", some(U8(3)))])), ok("x -2 y Some(3)"));
+        assert_eq!(point(Map(vec![e("y", Opt(None)), e("x", U64(7))])), ok("x 7 y None"));
+        assert_eq!(point(Map(vec![e("x", U8(1))])), ok("x 1 y None"));
+        assert_eq!(point(Map(vec![(U8(0), U8(4)), (U64(1), U8(5))])), ok("x 4 y Some(5)"));
+        assert_eq!(point(Seq(vec![I8(-1), Unit])), ok("x -1 y None"));
+        assert_eq!(point(Map(vec![])), err("missing field `x`"));
+        assert_eq!(point(Map(vec![e("x", U8(1)), e("z", U8(0))])), err("unknown field `z`, expected `x` or `y`"));
+        assert_eq!(point(Map(vec![(U8(5), U8(0))])), err("invalid value: integer `5`, expected field index 0 <= i < 2"));
+        assert_eq!(point(Map(vec![e("x", U8(1)), e("x", U8(2))])), err("duplicate field `x`"));
+        assert_eq!(point(Map(vec![e("x", BStr("1"))])), err("invalid type: string \"1\", expected i32"));
+        assert_eq!(point(Map(vec![e("x", U64(3000000000))])), err("invalid value: integer `3000000000`, expected i32"));
+        assert_eq!(point(Map(vec![e("x", U8(1)), e("y", U16(256))])), err("invalid value: integer `256`, expected u8"));
+        assert_eq!(point(Seq(vec![U8(1)])), err("invalid length 1, expected struct Point with 2 elements"));
+        assert_eq!(point(Seq(vec![U8(1), Unit, U8(3)])), err("invalid length 3, expected 2 elements in sequence"));
+        assert_eq!(point(U8(1)), err("invalid type: integer `1`, expected struct Point"));
+    }
+
+    #[test]
+    fn derived_enum() {
+        assert_eq!(shape(BStr("Unit")), ok("Unit"));
+        assert_eq!(shape(Map(vec![e("Unit", Unit)])), ok("Unit"));
+        assert_eq!(shape(Map(vec![e("Unit", Map(vec![]))])), ok("Unit"));
+        assert_eq!(shape(Map(vec![e("Unit", U8(1))])), err("invalid type: integer `1`, expected unit"));
+        assert_eq!(shape(Map(vec![e("Tup", Seq(vec![U8(1), Bool(true)]))])), ok("Tup 1 true"));
+        assert_eq!(shape(Map(vec![e("Tup", Seq(vec![U8(1)]))])), err("invalid length 1, expected tuple variant Shape::Tup with 2 elements"));
+        assert_eq!(shape(Map(vec![e("Tup", Seq(vec![U8(1), Bool(true), U8(0)]))])), err("invalid length 3, expected 2 elements in sequence"));
+        assert_eq!(shape(Map(vec![e("Tup", U8(1))])), err("invalid type: integer `1`, expected tuple variant"));
+        assert_eq!(shape(BStr("Tup")), err("invalid type: unit variant, expected tuple variant"));
+        assert_eq!(shape(Map(vec![e("Rec", Map(vec![e("a", U64(7))]))])), ok("Rec 7"));
+        assert_eq!(shape(Map(vec![e("Rec", Seq(vec![U64(8)]))])), ok("Rec 8"));
+        assert_eq!(shape(Map(vec![e("Rec", U8(1))])), err("invalid type: integer `1`, expected struct variant"));
+        assert_eq!(shape(BStr("Rec")), err("invalid type: unit variant, expected struct variant"));
+        assert_eq!(
+            shape(Map(vec![e("Nope", Unit)])),
+            err("unknown variant `Nope`, expected one of `Unit`, `Tup`, `Rec`")
+        );
+        assert_eq!(shape(Map(vec![])), err("invalid value: map, expected map with a single key"));
+        assert_eq!(shape(U8(1)), err("invalid type: integer `1`, expected string or map"));
+        assert_eq!(shape(Map(vec![(U8(2), Map(vec![e("a", U64(1))]))])), ok("Rec 1"));
+    }
+
+    #[test]
+    fn derived_newtype_and_unit_structs() {
+        assert_eq!(via_content::<Wrapper, _>(ValueDe(nt(U32(7)))).map(|w| w.0), Ok(7));
+        assert_eq!(via_content::<Wrapper, _>(ValueDe(U8(7))).map(|w| w.0), Ok(7));
+        assert_eq!(
+            via_content::<Wrapper, _>(ValueDe(BStr("7"))).map(|w| w.0),
+            err("invalid type: string \"7\", expected u32")
+        );
+        for v in [Unit, Map(vec![]), Seq(vec![])] {
+            assert_eq!(via_content::<Marker, _>(ValueDe(v)).map(|_| 0), Ok(0));
+        }
+        assert_eq!(
+            via_content::<Marker, _>(ValueDe(U8(1))).map(|_| 0),
+            err("invalid type: integer `1`, expected unit struct Marker")
+        );
+    }
+
+    #[test]
+    fn library_impls() {
+        assert_eq!(ints(ValueDe(Seq(vec![U8(1), I64(-2)]))), Ok(vec![1, -2]));
+        assert_eq!(ints(ValueDe(Seq(vec![U64(300)]))), err("invalid value: integer `300`, expected i8"));
+        assert_eq!(pair(ValueDe(Seq(vec![U8(1), Bool(true)]))), Ok((1, true)));
+        assert_eq!(pair(ValueDe(Seq(vec![U8(1)]))), err("invalid length 1, expected a tuple of size 2"));
+        assert_eq!(
+            pair(ValueDe(Seq(vec![U8(1), Bool(true), U8(5)]))),
+            err("invalid length 3, expected 2 elements in sequence")
+        );
+        assert_eq!(
+            counts(ValueDe(Map(vec![e("b", U8(2)), e("a", U32(1))]))).map(|m| m.into_iter().collect::<Vec<_>>()),
+            Ok(vec![("a".to_string(), 1), ("b".to_string(), 2)])
+        );
+        assert_eq!(text(ValueDe(Bytes(vec![0x68, 0x69]))), Ok("hi".to_string()));
+        assert_eq!(text(ValueDe(Bytes(vec![0xff]))), err("invalid value: byte array, expected a string"));
+        assert_eq!(text(ValueDe(U8(1))), err("invalid type: integer `1`, expected a string"));
+        assert_eq!(byte(ValueDe(U64(256))), err("invalid value: integer `256`, expected u8"));
+        assert_eq!(byte(ValueDe(I8(-1))), err("invalid value: integer `-1`, expected u8"));
+        assert_eq!(float(ValueDe(U8(1))).map(f64::to_bits), Ok(0x3ff0000000000000));
+        assert_eq!(float(ValueDe(BStr("1"))), err("invalid type: string \"1\", expected f64"));
+        assert_eq!(flag(ValueDe(U8(1))), err("invalid type: integer `1`, expected a boolean"));
+        assert_eq!(maybe(ValueDe(Unit)), Ok(None));
+        assert_eq!(maybe(ValueDe(U8(4))), Ok(Some(4)));
+        assert_eq!(unit(ValueDe(Map(vec![]))), Ok(()));
+        assert_eq!(ignored(ValueDe(Seq(vec![U8(1)]))).map(|_| 0), Ok(0));
+    }
+}
