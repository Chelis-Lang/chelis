+
+/-- The dictionaries of `ContentVisitor` at level `n` of the knot: `impl DeserializeSeed` and
+    `impl Visitor`. -/
+def contentAt : (n : Nat) →
+    (DeAt n).Seed ContentVisitor Content × (DeAt n).Visitor ContentVisitor Content
