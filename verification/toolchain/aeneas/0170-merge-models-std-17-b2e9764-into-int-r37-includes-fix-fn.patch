+/-- `ContentVisitor::new()`: `ContentVisitor { value: PhantomData }`. -/
+@[rust_fun "serde::private::de::content::{serde::private::de::content::ContentVisitor<'de>}::new"]
+def ContentVisitor.new : Result ContentVisitor := ok ⟨⟩
+
