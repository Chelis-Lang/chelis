+def findOf (gs : Slice (alloc.vec.Vec U32)) (o : List Nat) (w : Nat) :
+    Option (List (Option Nat) × Option Nat × List Nat) :=
+  match pull_find gs (ops o) (u w) with
+  | ok (p, x, r) => some (opts p, x.map (·.val), nats r) | _ => none
+def rfindOf (gs : Slice (alloc.vec.Vec U32)) (o : List Nat) (w : Nat) :
+    Option (List (Option Nat) × Option Nat × List Nat) :=
+  match pull_rfind gs (ops o) (u w) with
+  | ok (p, x, r) => some (opts p, x.map (·.val), nats r) | _ => none
+
