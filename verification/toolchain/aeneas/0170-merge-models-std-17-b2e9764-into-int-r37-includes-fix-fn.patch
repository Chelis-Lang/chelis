+    `X`: `deserializer.__deserialize_content_v1(self)`. -/
+def contentSeedStep {X : Fam} (v : X.Visitor ContentVisitor Content) :
+    SeedStep X ContentVisitor Content :=
+  ⟨fun inst self de => inst.__deserialize_content_v1 v de self⟩
+
+/-- `while let Some(e) = tri!(visitor.next_element_seed(ContentVisitor::new())) { vec.push(e); }`,
+    then `vec`. -/
+def contentElements {X : Fam} {A Error : Type} (seq : SeqAccessF X A Error)
