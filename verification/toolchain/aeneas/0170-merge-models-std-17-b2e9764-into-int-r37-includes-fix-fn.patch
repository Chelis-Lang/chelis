+                None => Ok(None),
+            }
+        }
+        fn size_hint(&self) -> Option<usize> {
+            Some(self.0.len())
+        }
+    }
+
+    impl<'de> EnumAccess<'de> for BinEnum {
+        type Error = TestError;
+        type Variant = BinVariant;
+        fn variant_seed<V: DeserializeSeed<'de>>(
+            self, seed: V,
+        ) -> Result<(V::Value, BinVariant), TestError> {
+            let index: de::value::U32Deserializer<TestError> = self.0.into_deserializer();
+            seed.deserialize(index).map(|v| (v, BinVariant(self.1)))
+        }
+    }
+
+    impl<'de> VariantAccess<'de> for BinVariant {
+        type Error = TestError;
+        fn unit_variant(self) -> Result<(), TestError> {
+            fail("expected unit variant")
+        }
+        fn newtype_variant_seed<T: DeserializeSeed<'de>>(self, seed: T) -> Result<T::Value, TestError> {
+            seed.deserialize(BinDe(self.0))
+        }
+        fn tuple_variant<V: Visitor<'de>>(self, len: usize, visitor: V) -> Result<V::Value, TestError> {
+            BinDe(self.0).deserialize_tuple(len, visitor)
+        }
+        fn struct_variant<V: Visitor<'de>>(
+            self, fields: &'static [&'static str], visitor: V,
+        ) -> Result<V::Value, TestError> {
+            BinDe(self.0).deserialize_tuple(fields.len(), visitor)
+        }
+    }
+
+    fn scalar(b: Bits) -> String {
+        match b {
+            Bits::F64(v) => format!("f64 {:x}", v.to_bits()),
+            Bits::F32(v) => format!("f32 {:x}", v.to_bits()),
+            Bits::F16(v) => format!("f16 {v:x}"),
+            Bits::Bf16(v) => format!("bf16 {v:x}"),
+            Bits::I64(v) => format!("int64 {v}"),
+            Bits::I32(v) => format!("int32 {v}"),
+            Bits::I16(v) => format!("int16 {v}"),
+            Bits::I8(v) => format!("int8 {v}"),
+            Bits::Bool(v) => format!("bool {v}"),
+        }
+    }
+
+    fn storage(b: Buf) -> String {
+        fn hex<T: fmt::LowerHex>(v: &[T]) -> String {
+            v.iter().map(|x| format!("{x:x}")).collect::<Vec<_>>().join(",")
+        }
+        fn dec<T: fmt::Display>(v: &[T]) -> String {
+            v.iter().map(|x| format!("{x}")).collect::<Vec<_>>().join(",")
+        }
+        match b {
+            Buf::F64(v) => format!("f64 [{}]", hex(&v.iter().map(|x| x.to_bits()).collect::<Vec<_>>())),
+            Buf::F32(v) => format!("f32 [{}]", hex(&v.iter().map(|x| x.to_bits()).collect::<Vec<_>>())),
+            Buf::F16(v) => format!("f16 [{}]", hex(&v)),
+            Buf::Bf16(v) => format!("bf16 [{}]", hex(&v)),
+            Buf::I64(v) => format!("int64 [{}]", dec(&v)),
+            Buf::I32(v) => format!("int32 [{}]", dec(&v)),
+            Buf::I16(v) => format!("int16 [{}]", dec(&v)),
+            Buf::I8(v) => format!("int8 [{}]", dec(&v)),
+            Buf::Bool(v) => format!("bool [{}]", dec(&v)),
+        }
+    }
+
+    fn json_scalar(v: Json) -> Result<String, TestError> {
+        decode_scalar(JsonDe(v)).map(scalar)
+    }
+
+    fn json_storage(v: Json) -> Result<String, TestError> {
+        decode_storage(JsonDe(v)).map(storage)
+    }
+
+    fn bin_scalar(v: Bin) -> Result<String, TestError> {
+        decode_scalar(BinDe(v)).map(scalar)
+    }
+
+    fn bin_storage(v: Bin) -> Result<String, TestError> {
+        decode_storage(BinDe(v)).map(storage)
+    }
+
+    fn ok(s: &str) -> Result<String, TestError> {
+        Ok(s.to_string())
+    }
+
+    fn err(msg: &str) -> Result<String, TestError> {
+        Err(TestError(msg.to_string()))
+    }
+
+    use Json::{Arr, Obj};
+
+    fn obj(entries: Vec<(&'static str, Json)>) -> Json {
+        Obj(entries)
+    }
+
+    fn s(v: &'static str) -> Json {
+        Json::Str(v)
+    }
+
+    const ONE: &str = "3ff0000000000000";
+
+    #[test]
+    fn json_scalars() {
+        assert_eq!(json_scalar(obj(vec![("dtype", s("f64")), ("bits", s(ONE))])), ok("f64 3ff0000000000000"));
+        assert_eq!(json_scalar(obj(vec![("dtype", s("f32")), ("bits", s("bf800000"))])), ok("f32 bf800000"));
+        assert_eq!(json_scalar(obj(vec![("dtype", s("f16")), ("bits", s("7c01"))])), ok("f16 7c01"));
+        assert_eq!(json_scalar(obj(vec![("dtype", s("bf16")), ("bits", Json::Esc("ffff".to_string()))])), ok("bf16 ffff"));
+        assert_eq!(json_scalar(obj(vec![("dtype", s("int64")), ("value", Json::I64(i64::MIN))])), ok("int64 -9223372036854775808"));
+        assert_eq!(json_scalar(obj(vec![("dtype", s("int32")), ("value", Json::U64(2147483647))])), ok("int32 2147483647"));
+        assert_eq!(json_scalar(obj(vec![("dtype", s("int16")), ("value", Json::I64(-32768))])), ok("int16 -32768"));
+        assert_eq!(json_scalar(obj(vec![("dtype", s("int8")), ("value", Json::U64(127))])), ok("int8 127"));
+        assert_eq!(json_scalar(obj(vec![("dtype", s("bool")), ("value", Json::Bool(true))])), ok("bool true"));
+        // the payload before the tag
+        assert_eq!(json_scalar(obj(vec![("value", Json::I64(-1)), ("dtype", s("int8"))])), ok("int8 -1"));
+        assert_eq!(json_scalar(obj(vec![("bits", s("0000000000000001")), ("dtype", s("f64"))])), ok("f64 1"));
+    }
+
+    #[test]
+    fn json_scalar_sequence_form() {
+        // serde accepts the tag as the first element of a sequence, the fields in order after it
+        assert_eq!(json_scalar(Arr(vec![s("f64"), s(ONE)])), ok("f64 3ff0000000000000"));
+        assert_eq!(json_scalar(Arr(vec![s("int16"), Json::U64(7)])), ok("int16 7"));
+        assert_eq!(
+            json_scalar(Arr(vec![s("f64"), s(ONE), Json::U64(1)])),
+            err("invalid length 2, expected 1 element in sequence")
+        );
+        assert_eq!(
+            json_scalar(Arr(vec![s("f64")])),
+            err("invalid length 0, expected struct variant ScalarWire::F64 with 1 element")
+        );
+        assert_eq!(json_scalar(Arr(vec![])), err("missing field `dtype`"));
+    }
+
+    #[test]
+    fn json_scalar_errors() {
+        assert_eq!(
+            json_scalar(obj(vec![("dtype", s("f64")), ("bits", s(ONE)), ("dtype", s("f64"))])),
+            err("duplicate field `dtype`")
+        );
+        assert_eq!(
+            json_scalar(obj(vec![("dtype", s("f64")), ("bits", s(ONE)), ("extra", Json::Null)])),
+            err("unknown field `extra`, expected `bits`")
+        );
+        assert_eq!(
+            json_scalar(obj(vec![("dtype", s("int8")), ("value", Json::U64(1)), ("bits", s(ONE))])),
+            err("unknown field `bits`, expected `value`")
+        );
+        assert_eq!(
+            json_scalar(obj(vec![("dtype", s("f64")), ("bits", s(ONE)), ("bits", s(ONE))])),
+            err("duplicate field `bits`")
+        );
+        assert_eq!(json_scalar(obj(vec![("bits", s(ONE))])), err("missing field `dtype`"));
+        assert_eq!(json_scalar(obj(vec![("dtype", s("f64"))])), err("missing field `bits`"));
+        assert_eq!(
+            json_scalar(obj(vec![("dtype", s("f128")), ("bits", s(ONE))])),
+            err("unknown variant `f128`, expected one of `f64`, `f32`, `f16`, `bf16`, `int64`, `int32`, `int16`, `int8`, `bool`")
+        );
+        assert_eq!(
+            json_scalar(obj(vec![("dtype", Json::U64(0)), ("bits", s(ONE))])),
+            err("invalid type: integer `0`, expected variant identifier")
+        );
+        // wrong payload types
+        assert_eq!(
+            json_scalar(obj(vec![("dtype", s("bool")), ("value", Json::U64(1))])),
+            err("invalid type: integer `1`, expected a boolean")
+        );
+        assert_eq!(
+            json_scalar(obj(vec![("dtype", s("f64")), ("bits", Json::F64(1.0))])),
+            err("invalid type: floating point `1.0`, expected a string")
+        );
+        assert_eq!(
+            json_scalar(obj(vec![("dtype", s("int32")), ("value", s("1"))])),
+            err("invalid type: string \"1\", expected i32")
+        );
+        assert_eq!(
+            json_scalar(obj(vec![("dtype", s("int64")), ("value", Json::F64(1.5))])),
+            err("invalid type: floating point `1.5`, expected i64")
+        );
+        // integers out of range
+        assert_eq!(
+            json_scalar(obj(vec![("dtype", s("int8")), ("value", Json::U64(128))])),
+            err("invalid value: integer `128`, expected i8")
+        );
+        assert_eq!(
+            json_scalar(obj(vec![("dtype", s("int16")), ("value", Json::I64(-32769))])),
+            err("invalid value: integer `-32769`, expected i16")
+        );
+        assert_eq!(
+            json_scalar(obj(vec![("dtype", s("int64")), ("value", Json::U64(9223372036854775808))])),
+            err("invalid value: integer `9223372036854775808`, expected i64")
+        );
+        // HexBits of the wrong width or case
+        assert_eq!(
+            json_scalar(obj(vec![("dtype", s("f64")), ("bits", s("3ff0"))])),
+            err("stored IEEE bits require exactly 16 lowercase hexadecimal digits")
+        );
+        assert_eq!(
+            json_scalar(obj(vec![("dtype", s("f32")), ("bits", s(ONE))])),
+            err("stored IEEE bits require exactly 8 lowercase hexadecimal digits")
+        );
+        assert_eq!(
+            json_scalar(obj(vec![("dtype", s("f16")), ("bits", s("7C01"))])),
+            err("stored IEEE bits require exactly 4 lowercase hexadecimal digits")
+        );
+        assert_eq!(
+            json_scalar(obj(vec![("dtype", s("bf16")), ("bits", s("12g4"))])),
+            err("stored IEEE bits require exactly 4 lowercase hexadecimal digits")
+        );
+        // not a map or a sequence
+        assert_eq!(
+            json_scalar(s("f64")),
+            err("invalid type: string \"f64\", expected internally tagged enum ScalarWire")
+        );
+        assert_eq!(
+            json_scalar(Json::Null),
+            err("invalid type: unit value, expected internally tagged enum ScalarWire")
+        );
+    }
+
+    #[test]
+    fn json_storage_values() {
+        assert_eq!(
+            json_storage(obj(vec![("dtype", s("f64")), ("bits", Arr(vec![s(ONE), s("8000000000000000")]))])),
+            ok("f64 [3ff0000000000000,8000000000000000]")
+        );
+        assert_eq!(json_storage(obj(vec![("bits", Arr(vec![])), ("dtype", s("f32"))])), ok("f32 []"));
+        assert_eq!(
+            json_storage(obj(vec![("dtype", s("bf16")), ("bits", Arr(vec![s("3f80"), s("0001")]))])),
+            ok("bf16 [3f80,1]")
+        );
+        assert_eq!(
+            json_storage(obj(vec![("dtype", s("int8")), ("values", Arr(vec![Json::U64(1), Json::I64(-128)]))])),
+            ok("int8 [1,-128]")
+        );
+        assert_eq!(
+            json_storage(obj(vec![("dtype", s("bool")), ("values", Arr(vec![Json::Bool(true), Json::Bool(false)]))])),
+            ok("bool [1,0]")
+        );
+        assert_eq!(
+            json_storage(Arr(vec![s("int32"), Arr(vec![Json::I64(-5)])])),
+            ok("int32 [-5]")
+        );
+        assert_eq!(
+            json_storage(obj(vec![("dtype", s("int8")), ("values", Arr(vec![Json::U64(1), Json::U64(300)]))])),
+            err("invalid value: integer `300`, expected i8")
+        );
+        assert_eq!(
+            json_storage(obj(vec![("dtype", s("f16")), ("bits", Arr(vec![s("3c00"), s("3c0")]))])),
+            err("stored IEEE bits require exactly 4 lowercase hexadecimal digits")
+        );
+        assert_eq!(
+            json_storage(obj(vec![("dtype", s("f64")), ("bits", s(ONE))])),
+            err("invalid type: string \"3ff0000000000000\", expected a sequence")
+        );
+        assert_eq!(
+            json_storage(obj(vec![("dtype", s("int16")), ("values", Arr(vec![])), ("values", Arr(vec![]))])),
+            err("duplicate field `values`")
+        );
+        assert_eq!(
+            json_storage(obj(vec![("dtype", s("bool")), ("value", Arr(vec![]))])),
+            err("unknown field `value`, expected `values`")
+        );
+    }
+
+    #[test]
+    fn binary_values() {
+        use Bin::*;
+        let f = |index: u32, fields: Vec<Bin>| Variant(index, Box::new(Fields(fields)));
+        assert_eq!(bin_scalar(f(0, vec![Str(ONE.to_string())])), ok("f64 3ff0000000000000"));
+        assert_eq!(bin_scalar(f(3, vec![Str("7f80".to_string())])), ok("bf16 7f80"));
+        assert_eq!(bin_scalar(f(4, vec![I64(-2)])), ok("int64 -2"));
+        assert_eq!(bin_scalar(f(7, vec![I8(-7)])), ok("int8 -7"));
+        assert_eq!(bin_scalar(f(8, vec![Bool(false)])), ok("bool false"));
+        assert_eq!(
+            bin_storage(f(1, vec![Seq(vec![Str("3f800000".to_string()), Str("00000000".to_string())])])),
+            ok("f32 [3f800000,0]")
+        );
+        assert_eq!(bin_storage(f(5, vec![Seq(vec![I32(1), I32(-1)])])), ok("int32 [1,-1]"));
+        // the variant index out of range, the wrong kinds, the wrong width
+        assert_eq!(
+            bin_scalar(f(9, vec![Bool(true)])),
+            err("invalid value: integer `9`, expected variant index 0 <= i < 9")
+        );
+        assert_eq!(bin_scalar(f(4, vec![I32(1)])), err("expected i64"));
+        assert_eq!(bin_scalar(f(8, vec![])), err("invalid length 0, expected struct variant BinaryScalarWire::Bool with 1 element"));
+        assert_eq!(
+            bin_scalar(f(2, vec![Str("3c00a".to_string())])),
+            err("stored IEEE bits require exactly 4 lowercase hexadecimal digits")
+        );
+        assert_eq!(bin_scalar(Fields(vec![Str("f64".to_string())])), err("expected enum"));
+        assert_eq!(bin_storage(f(6, vec![Seq(vec![I16(1), I8(2)])])), err("expected i16"));
+    }
+}
