+#guard bool (ends_with_unit (toStr "10s")) == some true
+#guard bool (ends_with_unit (toStr "café")) == some true
+#guard bool (ends_with_unit (toStr "s1")) == some false
+#guard bool (ends_with_unit (toStr "")) == some false
+
+-- splits
+#guard strs (fields (toStr "a,b;c")) == some ["a", "b", "c"]
+#guard strs (fields (toStr "xéy,,z")) == some ["x", "y", "", "z"]
+#guard strs (fields (toStr "")) == some [""]
+#guard strs (fields (toStr ";")) == some ["", ""]
+#guard str (trim_signs (toStr "+-→5-")) == some "5-"
+#guard str (trim_signs (toStr "x+")) == some "x+"
+#guard str (trim_signs (toStr "--")) == some ""
+
+-- reverse searches
+#guard pos (last_sep (toStr "a,bécd")) == some (some 3)
+#guard pos (last_sep (toStr "a,b")) == some (some 1)
+#guard pos (last_sep (toStr "ab")) == some none
