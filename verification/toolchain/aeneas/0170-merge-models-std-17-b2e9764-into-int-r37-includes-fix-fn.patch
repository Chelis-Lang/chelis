+its `DeserializeSeed`, the elements and entries through `next_element_seed`/`next_entry_seed`), so its
+dictionaries are built level by level of the knot (`DeAt`), as `IgnoredAny`'s.
+-/
+
+namespace Aeneas.Std
+
+open Result
+
+namespace serde_core.private.size_hint
+
+/-- `pub fn cautious<Element>(hint: Option<usize>) -> usize` (serde_core `private/size_hint.rs`,
+    with `std`/`alloc`), `size` being `mem::size_of::<Element>()`: `0` for a zero-sized element,
+    else `min(hint.unwrap_or(0), 1024 * 1024 / size)`. Callers only use it as a capacity. -/
+def cautious (size : Nat) (hint : Option Usize) : Usize :=
+  if size = 0 then ⟨BitVec.ofNat _ 0⟩
+  else ⟨BitVec.ofNat _ (min ((hint.map (·.val)).getD 0) (1024 * 1024 / size))⟩
+
+end serde_core.private.size_hint
+
+/-- `mem::size_of::<Content<'de>>()` on the 64-bit targets: the largest variants (`String`,
+    `ByteBuf`, `Seq`, `Map`) hold 24 bytes, with the discriminant 32. -/
+def serde_core.private.content.Content.size : Nat := 32
+
+namespace serde.private.de.content
+
+open serde_core.de serde_core.private.content
+
+/-- `pub struct ContentVisitor<'de> { value: PhantomData<Content<'de>> }` -/
+@[rust_type "serde::private::de::content::ContentVisitor" (body := .opaque)]
