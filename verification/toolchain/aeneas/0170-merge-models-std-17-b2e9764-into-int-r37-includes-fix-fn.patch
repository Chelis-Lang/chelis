+/-- The knots of `ContentVisitor` are its level-wise construction. -/
+theorem DeserializeSeedContentVisitor.wrap_level (n : Nat) :
+    (DeserializeSeed.wrap DeserializeSeedContentVisitor).level n = (contentAt n).1 := by
