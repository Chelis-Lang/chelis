index 0000000..56a2afe
--- /dev/null
+++ b/tests/lean/ClosurePhantomParams/Checks.lean
@@ -0,0 +1,58 @@
+import ClosurePhantomParams.ClosurePhantomParams
+
+/-! Evaluate the model of `tests/src/closure-phantom-params.rs` on the inputs of
+    its `native` test module and compare with the native results. -/
+
+namespace closure_phantom_params.checks
+open Aeneas Aeneas.Std Result
+
+def vecOf {α : Type} (xs : List α) : alloc.vec.Vec α :=
+  if h : xs.length ≤ Usize.max then ⟨xs, h⟩ else ⟨[], by simp⟩
+
+def u8s (xs : List Nat) : alloc.vec.Vec U8 := vecOf (xs.map fun n => ⟨BitVec.ofNat _ n⟩)
+
+/-- The value `Err(e)` is `inl e`, and `Ok(v)` is `inr v`. -/
+def bitsOf (r : Result (core.result.Result (Option U64) U8)) :
+    Option (Sum Nat (Option Nat)) :=
+  -- A failure of the model is `none`.
+  match r with
+  | ok (.Ok v) => some (.inr (v.map (·.val)))
+  | ok (.Err e) => some (.inl e.val)
+  | _ => none
+
+-- Native test hex_bits: four digits.
+#guard bitsOf (f16_bits "3c00") == some (.inr (some 0x3c00))
+-- Native test hex_bits: four digits.
+#guard bitsOf (f16_bits "7c01") == some (.inr (some 0x7c01))
+-- Native test hex_bits: an uppercase digit.
+#guard bitsOf (f16_bits "7C01") == some (.inr none)
+
+-- Native test hex_bits: three digits.
+#guard bitsOf (f16_bits "3c0") == some (.inr none)
+-- Native test hex_bits: a letter which is not a digit.
+#guard bitsOf (f16_bits "12g4") == some (.inr none)
+-- Native test hex_bits: eight digits.
+#guard bitsOf (f32_bits "bf800000") == some (.inr (some 0xbf800000))
+
+-- Native test hex_bits: four digits for eight.
+#guard bitsOf (f32_bits "3c00") == some (.inr none)
+-- Native test hex_bits: the source fails.
+#guard bitsOf (f16_bits_missing 7#u8) == some (.inl 7)
+
+/-- A failure of the model is `none`. -/
+def boolOf (r : Result Bool) : Option Bool :=
