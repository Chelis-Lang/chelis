+#guard owned (rendered (toStr "1.5")) == some "1.5"
+#guard owned (rendered (toStr "1e10")) == some "1e10"
+#guard owned (rendered (toStr "inf")) == some "inf"
+#guard owned (rendered (toStr "NaN")) == some "NaN.0"
+#guard owned (rendered (toStr "-42")) == some "-42.0"
+#guard owned (rendered (toStr "")) == some ".0"
