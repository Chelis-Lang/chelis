+//! The production shape of `chelis-types`' `dtype_semantics/wire_codec.rs` (the `wire_enum!` macro,
+//! `HexBits<DIGITS>`, `ScalarWire`/`StorageWire` and the decoders of the stored values) through the
+//! library model of `serde_core` (`Aeneas/Std/Serde`): `#[derive(Deserialize)]` with
+//! `#[serde(tag = "dtype", deny_unknown_fields)]` (serde 1.0.228: `TaggedContentVisitor`, then
+//! `ContentDeserializer` and the derive's field visitors), and the externally tagged binary mirror.
+//!
+//! `decode` reads the internally tagged enum from a human-readable format and the externally
+//! tagged mirror from any other. `HexBits<DIGITS>` admits exactly `DIGITS` lowercase hexadecimal
+//! digits. The schema derives (`schemars`) and the encoders' `HexBits::from_bits` are not part of
+//! the decoding path; the rest of the macro is verbatim. `Bits`/`Buf` stand for the production
+//! `ScalarValue`/`TensorStorage` payloads (the half-precision values as their bits).
+//!
+//! `SerdeWireEnum/Checks.lean` runs `decode_scalar` and `decode_storage` against the two in-test
+//! formats of the `native` test module (a serde_json-like value tree, human-readable and
+//! self-describing; a binary-like tree, not human-readable, typed, enums by variant index), encoded
+//! as `FormatProgram`s, and compares with the native results.
+
+use serde::{Deserialize, Serialize};
+
+#[derive(Clone, Serialize)]
+#[serde(transparent)]
+struct HexBits<const DIGITS: usize>(String);
+
+impl<const DIGITS: usize> HexBits<DIGITS> {
+    fn bits(self) -> u64 {
+        // Constructors and Deserialize admit exactly the lowercase fixed-width
+        // grammar. Accumulation is an exact bit move, without a float conversion.
+        self.0.bytes().fold(0, |bits, digit| {
+            (bits << 4)
+                | u64::from(if digit <= b'9' {
+                    digit - b'0'
+                } else {
+                    digit - b'a' + 10
+                })
+        })
+    }
+}
+
+impl<'de, const DIGITS: usize> Deserialize<'de> for HexBits<DIGITS> {
+    fn deserialize<D: serde::Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+        let text = String::deserialize(deserializer)?;
+        if text.len() != DIGITS
+            || !text
+                .bytes()
+                .all(|digit| digit.is_ascii_digit() || (b'a'..=b'f').contains(&digit))
+        {
+            return Err(serde::de::Error::custom(format!(
+                "stored IEEE bits require exactly {DIGITS} lowercase hexadecimal digits"
+            )));
+        }
+        Ok(Self(text))
+    }
+}
+
+// Author each dtype/payload relationship once. The cache mirror changes only
+// the enclosing discriminant representation; it has no alternate numeric path.
+macro_rules! wire_enum {
+    ($wire:ident, $binary:ident { $($variant:ident ($dtype:literal) { $field:ident: $ty:ty }),* $(,)? }) => {
+        #[derive(Serialize, Deserialize)]
+        #[serde(tag = "dtype", deny_unknown_fields)]
+        enum $wire {
+            $(#[serde(rename = $dtype)] $variant { $field: $ty }),*
+        }
+
+        #[derive(Serialize, Deserialize)]
+        enum $binary {
+            $($variant { $field: $ty }),*
+        }
+
+        impl $wire {
+            fn encode<S: serde::Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
+                if serializer.is_human_readable() {
+                    self.serialize(serializer)
+                } else {
+                    let value = match self {
+                        $(Self::$variant { $field } => $binary::$variant { $field: $field.clone() }),*
+                    };
+                    value.serialize(serializer)
+                }
+            }
+
+            fn decode<'de, D: serde::Deserializer<'de>>(deserializer: D) -> Result<Self, D::Error> {
+                if deserializer.is_human_readable() {
+                    Self::deserialize(deserializer)
+                } else {
+                    Ok(match $binary::deserialize(deserializer)? {
+                        $($binary::$variant { $field } => Self::$variant { $field }),*
+                    })
+                }
+            }
+        }
+    };
+}
+
+wire_enum!(ScalarWire, BinaryScalarWire {
+    F64("f64") { bits: HexBits<16> },
+    F32("f32") { bits: HexBits<8> },
+    F16("f16") { bits: HexBits<4> },
+    Bf16("bf16") { bits: HexBits<4> },
+    I64("int64") { value: i64 },
+    I32("int32") { value: i32 },
+    I16("int16") { value: i16 },
+    I8("int8") { value: i8 },
+    Bool("bool") { value: bool },
+});
+
+wire_enum!(StorageWire, BinaryStorageWire {
+    F64("f64") { bits: Vec<HexBits<16>> },
+    F32("f32") { bits: Vec<HexBits<8>> },
+    F16("f16") { bits: Vec<HexBits<4>> },
+    Bf16("bf16") { bits: Vec<HexBits<4>> },
+    I64("int64") { values: Vec<i64> },
+    I32("int32") { values: Vec<i32> },
+    I16("int16") { values: Vec<i16> },
+    I8("int8") { values: Vec<i8> },
+    Bool("bool") { values: Vec<bool> },
+});
+
+/// A stored scalar (the production `ScalarValue`'s `Bits`; f16/bf16 as their bits).
+pub enum Bits {
+    F64(f64),
+    F32(f32),
+    F16(u16),
+    Bf16(u16),
+    I64(i64),
+    I32(i32),
+    I16(i16),
+    I8(i8),
+    Bool(bool),
+}
+
+/// A stored buffer (the production `TensorStorage`'s `Buf`; f16/bf16 as their bits).
+pub enum Buf {
+    F64(Vec<f64>),
+    F32(Vec<f32>),
+    F16(Vec<u16>),
+    Bf16(Vec<u16>),
+    I64(Vec<i64>),
+    I32(Vec<i32>),
+    I16(Vec<i16>),
+    I8(Vec<i8>),
+    Bool(Vec<u8>),
+}
+
+/// `impl Deserialize for ScalarValue` (production): `ScalarWire::decode`, then the payload.
+pub fn decode_scalar<'de, D: serde::Deserializer<'de>>(deserializer: D) -> Result<Bits, D::Error> {
+    let bits = match ScalarWire::decode(deserializer)? {
+        ScalarWire::F64 { bits } => Bits::F64(f64::from_bits(bits.bits())),
+        ScalarWire::F32 { bits } => Bits::F32(f32::from_bits(bits.bits() as u32)),
+        ScalarWire::F16 { bits } => Bits::F16(bits.bits() as u16),
+        ScalarWire::Bf16 { bits } => Bits::Bf16(bits.bits() as u16),
+        ScalarWire::I64 { value } => Bits::I64(value),
+        ScalarWire::I32 { value } => Bits::I32(value),
+        ScalarWire::I16 { value } => Bits::I16(value),
+        ScalarWire::I8 { value } => Bits::I8(value),
+        ScalarWire::Bool { value } => Bits::Bool(value),
+    };
+    Ok(bits)
+}
+
+/// `impl Deserialize for TensorStorage` (production): `StorageWire::decode`, then the payload.
+pub fn decode_storage<'de, D: serde::Deserializer<'de>>(deserializer: D) -> Result<Buf, D::Error> {
+    let buf = match StorageWire::decode(deserializer)? {
+        StorageWire::F64 { bits } => {
+            Buf::F64(bits.into_iter().map(|b| f64::from_bits(b.bits())).collect())
+        }
+        StorageWire::F32 { bits } => Buf::F32(
+            bits.into_iter()
+                .map(|b| f32::from_bits(b.bits() as u32))
+                .collect(),
+        ),
+        StorageWire::F16 { bits } => Buf::F16(bits.into_iter().map(|b| b.bits() as u16).collect()),
+        StorageWire::Bf16 { bits } => Buf::Bf16(bits.into_iter().map(|b| b.bits() as u16).collect()),
+        StorageWire::I64 { values } => Buf::I64(values),
+        StorageWire::I32 { values } => Buf::I32(values),
+        StorageWire::I16 { values } => Buf::I16(values),
+        StorageWire::I8 { values } => Buf::I8(values),
+        StorageWire::Bool { values } => Buf::Bool(values.into_iter().map(u8::from).collect()),
+    };
+    Ok(buf)
+}
+
+#[cfg(test)]
+mod native {
+    //! Two in-test formats: `Json`, a serde_json-like value tree (human-readable, self-describing:
+    //! `deserialize_any` visits the value; object keys and unescaped strings are borrowed; a
+    //! non-negative integer is a `u64`; `deserialize_str`/`string`/`identifier` accept only strings),
+    //! and `Bin`, a binary-like tree (not human-readable, no `deserialize_any`, every
+    //! `deserialize_*` reads its own kind, an enum is a variant index with its fields in order).
+    use super::*;
+    use serde::de::{
+        self, DeserializeSeed, Deserializer, EnumAccess, IntoDeserializer, MapAccess, SeqAccess,
+        VariantAccess, Visitor,
+    };
+    use std::fmt;
+
+    #[derive(Debug, PartialEq)]
+    pub struct TestError(pub String);
+
+    impl fmt::Display for TestError {
+        fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+            f.write_str(&self.0)
+        }
+    }
+
+    impl std::error::Error for TestError {}
+
+    impl de::Error for TestError {
+        fn custom<T: fmt::Display>(msg: T) -> Self {
+            TestError(msg.to_string())
+        }
+    }
+
+    fn fail<T>(msg: &str) -> Result<T, TestError> {
+        Err(TestError(msg.to_string()))
+    }
+
+    #[derive(Clone, Debug)]
+    pub enum Json {
+        Null,
+        Bool(bool),
+        U64(u64),
+        I64(i64),
+        F64(f64),
+        /// A string without escapes (`visit_borrowed_str`).
+        Str(&'static str),
+        /// A string with escapes (`visit_str` of the unescaped copy).
+        Esc(String),
+        Arr(Vec<Json>),
+        Obj(Vec<(&'static str, Json)>),
+    }
+
+    pub struct JsonDe(pub Json);
+    pub struct JsonSeq(std::vec::IntoIter<Json>);
+    pub struct JsonMap {
+        entries: std::vec::IntoIter<(&'static str, Json)>,
+        value: Option<Json>,
+    }
+
+    fn json_unexpected(v: &Json) -> de::Unexpected<'_> {
+        match v {
+            Json::Null => de::Unexpected::Unit,
+            Json::Bool(b) => de::Unexpected::Bool(*b),
+            Json::U64(n) => de::Unexpected::Unsigned(*n),
+            Json::I64(n) => de::Unexpected::Signed(*n),
+            Json::F64(f) => de::Unexpected::Float(*f),
+            Json::Str(s) => de::Unexpected::Str(s),
+            Json::Esc(s) => de::Unexpected::Str(s),
+            Json::Arr(_) => de::Unexpected::Seq,
+            Json::Obj(_) => de::Unexpected::Map,
+        }
+    }
+
+    impl<'de> Deserializer<'de> for JsonDe {
+        type Error = TestError;
+
+        fn deserialize_any<V: Visitor<'de>>(self, visitor: V) -> Result<V::Value, TestError> {
+            match self.0 {
+                Json::Null => visitor.visit_unit(),
+                Json::Bool(b) => visitor.visit_bool(b),
+                Json::U64(n) => visitor.visit_u64(n),
+                Json::I64(n) => visitor.visit_i64(n),
+                Json::F64(f) => visitor.visit_f64(f),
+                Json::Str(s) => visitor.visit_borrowed_str(s),
+                Json::Esc(s) => visitor.visit_str(&s),
+                Json::Arr(items) => visitor.visit_seq(JsonSeq(items.into_iter())),
+                Json::Obj(entries) => {
+                    visitor.visit_map(JsonMap { entries: entries.into_iter(), value: None })
+                }
+            }
+        }
+
+        fn deserialize_str<V: Visitor<'de>>(self, visitor: V) -> Result<V::Value, TestError> {
+            match self.0 {
+                Json::Str(s) => visitor.visit_borrowed_str(s),
+                Json::Esc(s) => visitor.visit_str(&s),
+                other => Err(de::Error::invalid_type(json_unexpected(&other), &visitor)),
+            }
+        }
+
+        fn deserialize_string<V: Visitor<'de>>(self, visitor: V) -> Result<V::Value, TestError> {
+            self.deserialize_str(visitor)
+        }
+
+        fn deserialize_identifier<V: Visitor<'de>>(self, visitor: V) -> Result<V::Value, TestError> {
+            self.deserialize_str(visitor)
+        }
+
+        fn deserialize_option<V: Visitor<'de>>(self, visitor: V) -> Result<V::Value, TestError> {
+            match self.0 {
+                Json::Null => visitor.visit_none(),
+                other => visitor.visit_some(JsonDe(other)),
+            }
+        }
+
+        serde::forward_to_deserialize_any! {
+            bool i8 i16 i32 i64 i128 u8 u16 u32 u64 u128 f32 f64 char
+            bytes byte_buf unit unit_struct newtype_struct seq tuple
+            tuple_struct map struct enum ignored_any
+        }
+    }
+
+    impl<'de> SeqAccess<'de> for JsonSeq {
+        type Error = TestError;
+        fn next_element_seed<T: DeserializeSeed<'de>>(
+            &mut self, seed: T,
+        ) -> Result<Option<T::Value>, TestError> {
+            match self.0.next() {
+                Some(v) => seed.deserialize(JsonDe(v)).map(Some),
+                None => Ok(None),
+            }
+        }
+        fn size_hint(&self) -> Option<usize> {
+            Some(self.0.len())
+        }
+    }
+
+    impl<'de> MapAccess<'de> for JsonMap {
+        type Error = TestError;
+        fn next_key_seed<K: DeserializeSeed<'de>>(
+            &mut self, seed: K,
+        ) -> Result<Option<K::Value>, TestError> {
+            match self.entries.next() {
+                Some((k, v)) => {
+                    self.value = Some(v);
+                    seed.deserialize(JsonDe(Json::Str(k))).map(Some)
+                }
+                None => Ok(None),
+            }
+        }
+        fn next_value_seed<V: DeserializeSeed<'de>>(
+            &mut self, seed: V,
+        ) -> Result<V::Value, TestError> {
+            match self.value.take() {
+                Some(v) => seed.deserialize(JsonDe(v)),
+                None => fail("value missing"),
+            }
+        }
+        fn size_hint(&self) -> Option<usize> {
+            Some(self.entries.len())
+        }
+    }
+
+    #[derive(Clone, Debug)]
+    pub enum Bin {
+        Bool(bool),
+        I8(i8),
+        I16(i16),
+        I32(i32),
+        I64(i64),
+        Str(String),
+        /// A sequence with its length (`Vec<T>`).
+        Seq(Vec<Bin>),
+        /// The fields of a struct or a struct variant, in order.
+        Fields(Vec<Bin>),
+        /// An enum: the variant index and its fields.
+        Variant(u32, Box<Bin>),
+    }
+
+    pub struct BinDe(pub Bin);
+    pub struct BinSeq(std::vec::IntoIter<Bin>);
+    pub struct BinEnum(u32, Bin);
+    pub struct BinVariant(Bin);
+
+    impl<'de> Deserializer<'de> for BinDe {
+        type Error = TestError;
+
+        fn is_human_readable(&self) -> bool {
+            false
+        }
+
+        fn deserialize_any<V: Visitor<'de>>(self, _visitor: V) -> Result<V::Value, TestError> {
+            fail("deserialize_any is not supported")
+        }
+
+        fn deserialize_bool<V: Visitor<'de>>(self, visitor: V) -> Result<V::Value, TestError> {
+            match self.0 {
+                Bin::Bool(b) => visitor.visit_bool(b),
+                _ => fail("expected bool"),
+            }
+        }
+
+        fn deserialize_i8<V: Visitor<'de>>(self, visitor: V) -> Result<V::Value, TestError> {
+            match self.0 {
+                Bin::I8(n) => visitor.visit_i8(n),
+                _ => fail("expected i8"),
+            }
+        }
+
+        fn deserialize_i16<V: Visitor<'de>>(self, visitor: V) -> Result<V::Value, TestError> {
+            match self.0 {
+                Bin::I16(n) => visitor.visit_i16(n),
+                _ => fail("expected i16"),
+            }
+        }
+
+        fn deserialize_i32<V: Visitor<'de>>(self, visitor: V) -> Result<V::Value, TestError> {
+            match self.0 {
+                Bin::I32(n) => visitor.visit_i32(n),
+                _ => fail("expected i32"),
+            }
+        }
+
+        fn deserialize_i64<V: Visitor<'de>>(self, visitor: V) -> Result<V::Value, TestError> {
+            match self.0 {
+                Bin::I64(n) => visitor.visit_i64(n),
+                _ => fail("expected i64"),
+            }
+        }
+
+        fn deserialize_string<V: Visitor<'de>>(self, visitor: V) -> Result<V::Value, TestError> {
+            match self.0 {
+                Bin::Str(s) => visitor.visit_string(s),
+                _ => fail("expected string"),
+            }
+        }
+
+        fn deserialize_seq<V: Visitor<'de>>(self, visitor: V) -> Result<V::Value, TestError> {
+            match self.0 {
+                Bin::Seq(items) => visitor.visit_seq(BinSeq(items.into_iter())),
+                _ => fail("expected sequence"),
+            }
+        }
+
+        fn deserialize_tuple<V: Visitor<'de>>(
+            self, _len: usize, visitor: V,
+        ) -> Result<V::Value, TestError> {
+            match self.0 {
+                Bin::Fields(items) => visitor.visit_seq(BinSeq(items.into_iter())),
+                _ => fail("expected fields"),
+            }
+        }
+
+        fn deserialize_enum<V: Visitor<'de>>(
+            self, _name: &'static str, _variants: &'static [&'static str], visitor: V,
+        ) -> Result<V::Value, TestError> {
+            match self.0 {
+                Bin::Variant(index, fields) => visitor.visit_enum(BinEnum(index, *fields)),
+                _ => fail("expected enum"),
+            }
+        }
+
+        serde::forward_to_deserialize_any! {
