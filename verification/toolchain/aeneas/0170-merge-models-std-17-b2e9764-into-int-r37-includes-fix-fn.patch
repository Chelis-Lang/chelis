diff --git a/tests/lean/BtreesetDebug/Checks.lean b/tests/lean/BtreesetDebug/Checks.lean
new file mode 100644
index 0000000..518c343
--- /dev/null
+++ b/tests/lean/BtreesetDebug/Checks.lean
@@ -0,0 +1,46 @@
+import BtreesetDebug.BtreesetDebug
+
+/-! Evaluate the model of `tests/src/btreeset-debug.rs` on the inputs of its `native` test module
+    and compare with the native results: `{:?}` and `{:#?}` of sets (`debug_set`), alone and as
+    fields of derived `Debug` impls. -/
+namespace btreeset_debug.checks
+open Aeneas Aeneas.Std Result
+
+def u32 (n : Nat) : U32 := ⟨BitVec.ofNat _ n⟩
+def vec {T : Type} (xs : List T) : alloc.vec.Vec T :=
+  if h : xs.length ≤ Usize.max then ⟨xs, h⟩ else ⟨[], by simp⟩
+def nums (xs : List Nat) : alloc.vec.Vec U32 := vec (xs.map u32)
+
+def text : Result String → Option String
+  | ok s => some s
+  | _ => none
+
+-- sets
+#guard text (render_set (nums [])) == some "{}"
+#guard text (render_set (nums [3, 1, 2, 3])) == some "{1, 2, 3}"
+#guard text (render_set (nums [7])) == some "{7}"
+
+-- scopes
+def scopeText (pretty : Bool) (depth : Nat) (vars : List Nat) (names : List String) :
+    Option String :=
+  match scope (u32 depth) (nums vars) (vec names) with
+  | ok s => text (if pretty then render_pretty s else render s)
+  | _ => none
+
+#guard scopeText false 2 [5, 1] ["b", "a\"q"] ==
+  some "Scope { depth: 2, vars: {1, 5}, names: {\"a\\\"q\", \"b\"} }"
+#guard scopeText true 2 [5, 1] ["b", "a\"q"] ==
+  some "Scope {\n    depth: 2,\n    vars: {\n        1,\n        5,\n    },\n    names: {\n        \"a\\\"q\",\n        \"b\",\n    },\n}"
+#guard scopeText false 0 [] [] == some "Scope { depth: 0, vars: {}, names: {} }"
+#guard scopeText true 0 [] [] == some "Scope {\n    depth: 0,\n    vars: {},\n    names: {},\n}"
+
+-- trees
+def treeText (vars leaves : List Nat) : Option String :=
+  match node (nums vars) (nums leaves) with
+  | ok t => text (render_tree t)
+  | _ => none
+
+#guard treeText [4, 2] [9, 8] == some "Node({2, 4}, [Leaf(9), Leaf(8)])"
+#guard treeText [] [] == some "Node({}, [])"
+
+end btreeset_debug.checks
