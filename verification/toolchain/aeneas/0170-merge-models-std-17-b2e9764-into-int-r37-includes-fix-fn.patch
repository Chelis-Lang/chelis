+    Option (List (Option Nat) × Option Nat × List Nat) :=
+  match pull_nth_back gs (ops o) (us n) with
+  | ok (p, x, r) => some (opts p, x.map (·.val), nats r) | _ => none
+
+#guard nthOf g [1] 2 == some ([some 6], some 3, [4, 5])
+#guard nthOf g [1, 0] 3 == some ([some 6, some 1], some 5, [])
+#guard nthOf g [1, 0] 4 == some ([some 6, some 1], none, [])
+#guard nthBackOf g [0] 2 == some ([some 1], some 4, [2, 3])
+#guard nthBackOf g [0, 1] 3 == some ([some 1, some 6], some 2, [])
+#guard nthBackOf g [1, 1, 1, 0] 0 == some ([some 6, some 5, some 4, some 1], some 3, [2])
+
