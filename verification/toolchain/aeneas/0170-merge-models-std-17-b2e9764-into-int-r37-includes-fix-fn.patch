@@ -0,0 +1,323 @@
+//! serde's buffered content (`serde::__private::de::Content` and `ContentVisitor`, serde 1.0.228)
+//! through the library model of `serde_core` (`Aeneas/Std/Serde/Content.lean`): the value
+//! `#[serde(tag = "..")]` and `#[serde(untagged)]` enums buffer before they deserialize a variant.
+//!
+//! `buffer` is `ContentVisitor`'s `DeserializeSeed` (`deserializer.__deserialize_content_v1(self)`,
+//! whose provided body is `deserialize_any`), `buffer_any` passes the visitor to `deserialize_any`
+//! itself. `ContentVisitor` keeps every scalar with its width, owns a transient `&str`/`&[u8]`
+//! (`String`, `ByteBuf`) and keeps a borrowed one (`Str`, `Bytes`), buffers the inner value of an
+//! option or a newtype, the elements of a sequence and the entries of a map with itself, and rejects
+//! an enum input; `i128`/`u128` are serde's provided `visit_i128`/`visit_u128` (an invalid type).
+//!
+//! `SerdeContent/Checks.lean` runs these functions against the in-test format of the `native` test
+//! module (a value tree), encoded as a `FormatProgram`, and compares the buffered content (through
+//! the same `describe` as the native tests) and the errors with the native results.
+
+use serde::__private228::de::{Content, ContentVisitor};
+use serde::de::{DeserializeSeed, Deserializer};
+
+/// `ContentVisitor::new().deserialize(deserializer)`
+pub fn buffer<'de, D: Deserializer<'de>>(deserializer: D) -> Result<Content<'de>, D::Error> {
+    ContentVisitor::new().deserialize(deserializer)
+}
+
+/// `deserializer.deserialize_any(ContentVisitor::new())`
+pub fn buffer_any<'de, D: Deserializer<'de>>(deserializer: D) -> Result<Content<'de>, D::Error> {
+    deserializer.deserialize_any(ContentVisitor::new())
+}
+
+#[cfg(test)]
+mod native {
+    //! The in-test format: an owned value tree, each variant visited with one `visit_*` method.
+    use super::*;
+    use serde::de::{self, MapAccess, SeqAccess, Visitor};
+    use std::fmt;
+
+    #[derive(Clone, Debug)]
+    pub enum Value {
+        Bool(bool),
+        U8(u8),
+        U16(u16),
+        U32(u32),
+        U64(u64),
+        U128(u128),
+        I8(i8),
+        I16(i16),
+        I32(i32),
+        I64(i64),
+        I128(i128),
+        F32(f32),
+        F64(f64),
+        Char(char),
+        /// `visit_str` (a transient borrow)
+        Str(String),
+        /// `visit_borrowed_str`
+        BStr(&'static str),
+        /// `visit_string`
+        OwnedStr(String),
+        /// `visit_bytes`
+        Bytes(Vec<u8>),
+        /// `visit_borrowed_bytes`
+        BBytes(&'static [u8]),
+        /// `visit_byte_buf`
+        ByteBuf(Vec<u8>),
+        Unit,
+        Opt(Option<Box<Value>>),
+        Newtype(Box<Value>),
+        Seq(Vec<Value>),
+        Map(Vec<(Value, Value)>),
+        /// `visit_enum` (a unit variant named by a `StrDeserializer`)
+        Enum(&'static str),
+        /// A value no visitor accepts: the format reports an error.
+        Bad,
+    }
+    use Value::*;
+
+    #[derive(Debug, PartialEq)]
+    pub struct TestError(pub String);
+
+    impl fmt::Display for TestError {
+        fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+            f.write_str(&self.0)
+        }
+    }
+
+    impl std::error::Error for TestError {}
+
+    impl de::Error for TestError {
+        fn custom<T: fmt::Display>(msg: T) -> Self {
+            TestError(msg.to_string())
+        }
+    }
+
+    pub struct ValueDe(pub Value);
+    pub struct SeqDe(std::vec::IntoIter<Value>);
+    pub struct MapDe {
+        entries: std::vec::IntoIter<(Value, Value)>,
+        value: Option<Value>,
+    }
+
+    impl<'de> Deserializer<'de> for ValueDe {
+        type Error = TestError;
+
+        fn deserialize_any<V: Visitor<'de>>(self, visitor: V) -> Result<V::Value, TestError> {
+            match self.0 {
+                Bool(v) => visitor.visit_bool(v),
+                U8(v) => visitor.visit_u8(v),
+                U16(v) => visitor.visit_u16(v),
+                U32(v) => visitor.visit_u32(v),
+                U64(v) => visitor.visit_u64(v),
+                U128(v) => visitor.visit_u128(v),
+                I8(v) => visitor.visit_i8(v),
+                I16(v) => visitor.visit_i16(v),
+                I32(v) => visitor.visit_i32(v),
+                I64(v) => visitor.visit_i64(v),
+                I128(v) => visitor.visit_i128(v),
+                F32(v) => visitor.visit_f32(v),
+                F64(v) => visitor.visit_f64(v),
+                Char(v) => visitor.visit_char(v),
+                Str(s) => visitor.visit_str(&s),
+                BStr(s) => visitor.visit_borrowed_str(s),
+                OwnedStr(s) => visitor.visit_string(s),
+                Bytes(b) => visitor.visit_bytes(&b),
+                BBytes(b) => visitor.visit_borrowed_bytes(b),
+                ByteBuf(b) => visitor.visit_byte_buf(b),
+                Unit => visitor.visit_unit(),
+                Opt(None) => visitor.visit_none(),
+                Opt(Some(v)) => visitor.visit_some(ValueDe(*v)),
+                Newtype(v) => visitor.visit_newtype_struct(ValueDe(*v)),
+                Seq(items) => visitor.visit_seq(SeqDe(items.into_iter())),
+                Map(entries) => visitor.visit_map(MapDe { entries: entries.into_iter(), value: None }),
+                Enum(name) => visitor.visit_enum(de::value::StrDeserializer::<TestError>::new(name)),
+                Bad => Err(TestError("bad value".to_string())),
+            }
+        }
+
+        serde::forward_to_deserialize_any! {
+            bool i8 i16 i32 i64 i128 u8 u16 u32 u64 u128 f32 f64 char str string
+            bytes byte_buf option unit unit_struct newtype_struct seq tuple
+            tuple_struct map struct enum identifier ignored_any
+        }
+    }
+
+    impl<'de> SeqAccess<'de> for SeqDe {
+        type Error = TestError;
+        fn next_element_seed<T: DeserializeSeed<'de>>(
+            &mut self, seed: T,
+        ) -> Result<Option<T::Value>, TestError> {
+            match self.0.next() {
+                Some(v) => seed.deserialize(ValueDe(v)).map(Some),
+                None => Ok(None),
+            }
+        }
+        fn size_hint(&self) -> Option<usize> {
+            Some(self.0.len())
+        }
+    }
+
+    impl<'de> MapAccess<'de> for MapDe {
+        type Error = TestError;
+        fn next_key_seed<K: DeserializeSeed<'de>>(
+            &mut self, seed: K,
+        ) -> Result<Option<K::Value>, TestError> {
+            match self.entries.next() {
+                Some((k, v)) => {
+                    self.value = Some(v);
+                    seed.deserialize(ValueDe(k)).map(Some)
+                }
+                None => Ok(None),
+            }
+        }
+        fn next_value_seed<V: DeserializeSeed<'de>>(
+            &mut self, seed: V,
+        ) -> Result<V::Value, TestError> {
+            match self.value.take() {
+                Some(v) => seed.deserialize(ValueDe(v)),
+                None => Err(TestError("value missing".to_string())),
+            }
+        }
+    }
+
+    /// A description of a buffered content: every variant with its payload (floats by their bits).
+    pub fn describe(c: &Content<'_>) -> String {
+        match c {
+            Content::Bool(b) => format!("Bool({b})"),
+            Content::U8(n) => format!("U8({n})"),
+            Content::U16(n) => format!("U16({n})"),
+            Content::U32(n) => format!("U32({n})"),
+            Content::U64(n) => format!("U64({n})"),
+            Content::I8(n) => format!("I8({n})"),
+            Content::I16(n) => format!("I16({n})"),
+            Content::I32(n) => format!("I32({n})"),
+            Content::I64(n) => format!("I64({n})"),
+            Content::F32(f) => format!("F32({:x})", f.to_bits()),
+            Content::F64(f) => format!("F64({:x})", f.to_bits()),
+            Content::Char(ch) => format!("Char({})", *ch as u32),
+            Content::String(s) => format!("String({s})"),
+            Content::Str(s) => format!("Str({s})"),
+            Content::ByteBuf(b) => format!("ByteBuf({b:?})"),
+            Content::Bytes(b) => format!("Bytes({b:?})"),
+            Content::None => "None".to_string(),
+            Content::Some(c) => format!("Some({})", describe(c)),
+            Content::Unit => "Unit".to_string(),
+            Content::Newtype(c) => format!("Newtype({})", describe(c)),
+            Content::Seq(v) => {
+                format!("Seq[{}]", v.iter().map(describe).collect::<Vec<_>>().join(", "))
+            }
+            Content::Map(v) => format!(
+                "Map{{{}}}",
+                v.iter()
+                    .map(|(k, v)| format!("{}: {}", describe(k), describe(v)))
+                    .collect::<Vec<_>>()
+                    .join(", ")
+            ),
+        }
+    }
+
+    fn de_buffer(v: Value) -> Result<String, TestError> {
+        buffer(ValueDe(v)).map(|c| describe(&c))
+    }
+
+    fn de_buffer_any(v: Value) -> Result<String, TestError> {
+        buffer_any(ValueDe(v)).map(|c| describe(&c))
+    }
+
+    fn ok(s: &str) -> Result<String, TestError> {
+        Ok(s.to_string())
+    }
+
+    fn err(msg: &str) -> Result<String, TestError> {
+        Err(TestError(msg.to_string()))
+    }
+
+    fn nested() -> Value {
+        Map(vec![
+            (BStr("k"), Seq(vec![U8(1), Opt(Some(Box::new(Str("s".to_string())))), Unit])),
+            (U64(2), Newtype(Box::new(Map(vec![(Bool(false), Seq(vec![]))])))),
+            (OwnedStr("e".to_string()), Map(vec![])),
+        ])
+    }
+
+    #[test]
+    fn content_size() {
+        // `size_hint::cautious::<Content>` divides the 1 MiB preallocation bound by this size.
+        assert_eq!(std::mem::size_of::<Content>(), 32);
+        assert_eq!(std::mem::size_of::<(Content, Content)>(), 64);
+    }
+
+    #[test]
+    fn scalars() {
+        for (v, d) in [
+            (Bool(true), "Bool(true)"),
+            (U8(200), "U8(200)"),
+            (U16(65535), "U16(65535)"),
+            (U32(7), "U32(7)"),
+            (U64(u64::MAX), "U64(18446744073709551615)"),
+            (I8(-128), "I8(-128)"),
+            (I16(-2), "I16(-2)"),
+            (I32(i32::MIN), "I32(-2147483648)"),
+            (I64(-9), "I64(-9)"),
+            (F32(1.5), "F32(3fc00000)"),
+            (F32(-0.0), "F32(80000000)"),
+            (F64(0.1), "F64(3fb999999999999a)"),
+            (F64(f64::from_bits(0x7ff8000000000001)), "F64(7ff8000000000001)"),
+            (Char('é'), "Char(233)"),
+            (Unit, "Unit"),
+            (Opt(None), "None"),
+        ] {
+            assert_eq!(de_buffer(v.clone()), ok(d));
+            assert_eq!(de_buffer_any(v), ok(d));
+        }
+    }
+
+    #[test]
+    fn strings_and_bytes() {
+        assert_eq!(de_buffer(Str("ab".to_string())), ok("String(ab)"));
+        assert_eq!(de_buffer(BStr("ab")), ok("Str(ab)"));
+        assert_eq!(de_buffer(OwnedStr("ab".to_string())), ok("String(ab)"));
+        assert_eq!(de_buffer(Bytes(vec![1, 2])), ok("ByteBuf([1, 2])"));
+        assert_eq!(de_buffer(BBytes(&[3])), ok("Bytes([3])"));
+        assert_eq!(de_buffer(ByteBuf(vec![])), ok("ByteBuf([])"));
+        assert_eq!(de_buffer_any(Str("é".to_string())), ok("String(é)"));
+        assert_eq!(de_buffer_any(BBytes(&[255, 0])), ok("Bytes([255, 0])"));
+    }
+
+    #[test]
+    fn nested_values() {
+        assert_eq!(de_buffer(Opt(Some(Box::new(U8(1))))), ok("Some(U8(1))"));
+        assert_eq!(de_buffer(Newtype(Box::new(BStr("n")))), ok("Newtype(Str(n))"));
+        assert_eq!(de_buffer(Seq(vec![])), ok("Seq[]"));
+        assert_eq!(de_buffer(Map(vec![])), ok("Map{}"));
+        assert_eq!(
+            de_buffer(Seq(vec![I8(-1), Seq(vec![U16(2)]), Opt(Some(Box::new(Opt(None))))])),
+            ok("Seq[I8(-1), Seq[U16(2)], Some(None)]")
+        );
+        assert_eq!(
+            de_buffer(nested()),
+            ok("Map{Str(k): Seq[U8(1), Some(String(s)), Unit], U64(2): Newtype(Map{Bool(false): Seq[]}), String(e): Map{}}")
+        );
+        assert_eq!(
+            de_buffer_any(Newtype(Box::new(nested()))),
+            ok("Newtype(Map{Str(k): Seq[U8(1), Some(String(s)), Unit], U64(2): Newtype(Map{Bool(false): Seq[]}), String(e): Map{}})")
+        );
+    }
+
+    #[test]
+    fn errors() {
+        let enum_input = "untagged and internally tagged enums do not support enum input";
+        assert_eq!(de_buffer(Enum("A")), err(enum_input));
+        assert_eq!(de_buffer_any(Seq(vec![U8(1), Enum("A")])), err(enum_input));
+        assert_eq!(de_buffer(I128(5)), err("invalid type: integer `5` as i128, expected any value"));
+        assert_eq!(
+            de_buffer(U128(u128::MAX)),
+            err("invalid type: integer `340282366920938463463374607431768211455` as u128, expected any value")
+        );
+        assert_eq!(de_buffer(Bad), err("bad value"));
+        assert_eq!(de_buffer(Seq(vec![U8(1), Bad, U8(2)])), err("bad value"));
+        assert_eq!(de_buffer(Map(vec![(Bad, U8(1))])), err("bad value"));
+        assert_eq!(de_buffer(Map(vec![(U8(1), U8(2)), (U8(3), Bad)])), err("bad value"));
+        assert_eq!(de_buffer(Opt(Some(Box::new(Seq(vec![Bad]))))), err("bad value"));
+        assert_eq!(de_buffer_any(Newtype(Box::new(Map(vec![(Unit, I128(-1))])))),
+            err("invalid type: integer `-1` as i128, expected any value"));
+    }
+}
