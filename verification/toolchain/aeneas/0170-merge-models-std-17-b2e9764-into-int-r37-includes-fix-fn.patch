+//! `Error::source` of `#[derive(thiserror::Error)]` types whose variants carry a `#[from]` or
+//! `#[source]` field (the shape of chelis-deep's parser, path and authoring errors): the derive
+//! returns `Some(field.as_dyn_error())`, a `&(dyn Error + 'a)` upcast to `&(dyn Error + 'static)`.
+//! The native tests below compare `source()` and the rendering of the returned trait object with
+//! the extracted functions (tests/lean/ThiserrorSource/Checks.lean).
+
+#[derive(Debug, thiserror::Error)]
+pub enum LexError {
+    #[error("bad char {0}")]
+    BadChar(u32),
+    #[error("unexpected end of input")]
+    Eof,
+}
+
+#[derive(Debug, thiserror::Error)]
+pub enum ParseError {
+    #[error("{0}")]
+    Lex(#[from] LexError),
+    #[error("missing close paren at {0}")]
+    Missing(u32),
+    #[error("wrapped at {code}")]
+    Wrapped {
+        code: u32,
+        #[source]
+        inner: LexError,
+    },
+}
+
+#[derive(Debug, thiserror::Error)]
+#[error("authoring failed: {message}")]
+pub struct AuthoringError {
+    pub message: String,
+    #[source]
+    pub cause: ParseError,
+}
+
+pub fn lex(code: u32) -> Result<u32, LexError> {
+    if code == 0 {
+        Err(LexError::Eof)
+    } else if code > 100 {
+        Err(LexError::BadChar(code))
+    } else {
+        Ok(code)
+    }
+}
+
+/// `?` converts a `LexError` through the derived `From` of the `#[from]` field.
+pub fn parse(code: u32) -> Result<u32, ParseError> {
+    let v = lex(code)?;
+    if v == 7 {
+        return Err(ParseError::Missing(v));
+    }
+    if v == 9 {
+        return Err(ParseError::Wrapped {
+            code: v,
+            inner: LexError::BadChar(v),
+        });
+    }
+    Ok(v + 1)
+}
+
+pub fn author(code: u32) -> Result<u32, AuthoringError> {
+    parse(code).map_err(|cause| AuthoringError {
+        message: String::from("step"),
+        cause,
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::error::Error;
+
+    fn source_text(e: &dyn Error) -> Option<String> {
+        e.source().map(|s| s.to_string())
+    }
+
+    #[test]
+    fn parse_error_sources() {
+        assert_eq!(
+            source_text(&ParseError::Lex(LexError::BadChar(200))),
+            Some("bad char 200".to_string())
+        );
+        assert_eq!(
+            source_text(&ParseError::Lex(LexError::Eof)),
+            Some("unexpected end of input".to_string())
+        );
+        assert_eq!(source_text(&ParseError::Missing(3)), None);
+        assert_eq!(
+            source_text(&ParseError::Wrapped {
+                code: 9,
+                inner: LexError::BadChar(9)
+            }),
+            Some("bad char 9".to_string())
+        );
+        assert_eq!(ParseError::Lex(LexError::BadChar(200)).to_string(), "bad char 200");
+        assert_eq!(ParseError::Wrapped { code: 9, inner: LexError::Eof }.to_string(), "wrapped at 9");
+    }
+
+    #[test]
+    fn lex_error_has_no_source() {
+        assert_eq!(source_text(&LexError::Eof), None);
+        assert_eq!(source_text(&LexError::BadChar(1)), None);
+    }
+
+    #[test]
+    fn authoring_error_sources() {
+        let e = author(0).unwrap_err();
+        assert_eq!(e.to_string(), "authoring failed: step");
+        assert_eq!(source_text(&e), Some("unexpected end of input".to_string()));
+        assert_eq!(source_text(&e.cause), Some("unexpected end of input".to_string()));
+        let e = author(7).unwrap_err();
+        assert_eq!(source_text(&e), Some("missing close paren at 7".to_string()));
+        assert_eq!(source_text(&e.cause), None);
+        let e = author(9).unwrap_err();
+        assert_eq!(source_text(&e), Some("wrapped at 9".to_string()));
+        assert_eq!(source_text(&e.cause), Some("bad char 9".to_string()));
+        assert_eq!(author(5).unwrap(), 6);
+    }
+
+    #[test]
+    fn from_conversion() {
+        assert!(matches!(parse(0), Err(ParseError::Lex(LexError::Eof))));
+        assert!(matches!(parse(150), Err(ParseError::Lex(LexError::BadChar(150)))));
+        assert!(matches!(parse(7), Err(ParseError::Missing(7))));
+        assert_eq!(parse(4).unwrap(), 5);
+    }
+}
