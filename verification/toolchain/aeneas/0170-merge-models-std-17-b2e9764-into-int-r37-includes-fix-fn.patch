+/-- `impl<'de> Visitor<'de> for ContentVisitor<'de>` -/
+@[reducible, rust_trait_impl
+  "serde_core::de::Visitor<'de, serde::private::de::content::ContentVisitor<'de>, serde_core::private::content::Content<'de>>"]
