+open Aeneas Aeneas.Std Result
+
+def vecOf {α : Type} (xs : List α) : alloc.vec.Vec α :=
+  if h : xs.length ≤ Usize.max then ⟨xs, h⟩ else ⟨[], by simp⟩
+def sliceOf {α : Type} (xs : List α) : Slice α :=
+  if h : xs.length ≤ Usize.max then ⟨xs, h⟩ else ⟨[], by simp⟩
+def usizes (xs : List Nat) : alloc.vec.Vec Usize := vecOf (xs.map fun n => ⟨BitVec.ofNat _ n⟩)
+def u32s (xs : List Nat) : List U32 := xs.map fun n => ⟨BitVec.ofNat _ n⟩
+def i64 (n : Int) : I64 := ⟨BitVec.ofInt _ n⟩
+
+def edgeCountOf (graph : List (List Nat)) : Option Nat :=
+  match edge_count (vecOf (graph.map usizes)) with
+  | ok n => some n.val
+  | _ => none
+
+#guard edgeCountOf [[1, 2], [], [0, 1, 2]] == some 5
+#guard edgeCountOf [] == some 0
+
+def widthOf (slot : Option (List Nat)) : Option (Option Nat) :=
+  match width (slot.map fun xs => vecOf (u32s xs)) with
+  | ok w => some (w.map (·.val))
+  | _ => none
+
+#guard widthOf (some [7, 8, 9]) == some (some 3)
+#guard widthOf (some []) == some (some 0)
+#guard widthOf none == some none
+
+def negatedOf (value : Option Int) : Option (Option Int) :=
+  match negated (value.map i64) with
+  | ok v => some (v.map (·.val))
+  | _ => none
+
+#guard negatedOf (some 5) == some (some (-5))
+#guard negatedOf (some (-7)) == some (some 7)
+#guard negatedOf (some (-9223372036854775808)) == some none
+#guard negatedOf none == some none
+
+def boolBytesOf (values : List Bool) : Option (List Nat) :=
+  match bool_bytes (vecOf values) with
+  | ok v => some (v.val.map (·.val))
+  | _ => none
+
+#guard boolBytesOf [true, false, true] == some [1, 0, 1]
+#guard boolBytesOf [] == some []
+
+def wrappingTotalsOf (xs ys : List Nat) : Option (Nat × Nat) :=
+  match wrapping_totals (sliceOf (u32s xs)) (sliceOf (u32s ys)) with
+  | ok (a, b) => some (a.val, b.val)
+  | _ => none
+
+#guard wrappingTotalsOf [1, 2, 3] [4294967295, 5] == some (6, 5)
+#guard wrappingTotalsOf [] [] == some (0, 1)
+
+def directLensOf (a b : List Nat) : Option (Nat × Nat) :=
+  match direct_lens (vecOf (u32s a)) (vecOf (u32s b)) with
+  | ok (m, n) => some (m.val, n.val)
+  | _ => none
+
+#guard directLensOf [4, 5] [] == some (2, 0)
+#guard directLensOf [] [1, 2, 3] == some (0, 3)
+
+def boxedOf (value : Option Nat) : Option (Option Nat) :=
+  match boxed (value.map fun n => ⟨BitVec.ofNat _ n⟩) with
+  | ok v => some (v.map (·.val))
+  | _ => none
+
+#guard boxedOf (some 3) == some (some 3)
+#guard boxedOf none == some none
+
+def boxedOkOf (value : Except Nat Nat) : Option (Except Nat Nat) :=
+  let value : core.result.Result U32 U8 := match value with
+    | .ok n => .Ok ⟨BitVec.ofNat _ n⟩
+    | .error e => .Err ⟨BitVec.ofNat _ e⟩
+  match boxed_ok value with
+  | ok (.Ok v) => some (.ok v.val)
+  | ok (.Err e) => some (.error e.val)
+  | _ => none
+
+#guard boxedOkOf (.ok 4) == some (.ok 4)
+#guard boxedOkOf (.error 9) == some (.error 9)
+
+def successorsOf (xs : List Nat) : Option (List Nat) :=
+  match successors (sliceOf (xs.map fun n => (⟨BitVec.ofNat _ n⟩ : U8))) with
+  | ok v => some (v.val.map (·.val))
+  | _ => none
