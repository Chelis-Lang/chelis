--- /dev/null
+++ b/tests/src/serde-content-deserializer/src/lib.rs
@@ -0,0 +1,737 @@
+//! serde's `ContentDeserializer` (serde 1.0.228 `private/de.rs`) through the library model of
+//! `serde_core` (`Aeneas/Std/Serde/Content.lean`): the deserializer over a buffered `Content` from
+//! which `#[derive(Deserialize)]` with `#[serde(tag = "..")]` (and `untagged`) reads a variant.
+//!
+//! `probe` buffers the input (`ContentVisitor`) and calls one `Deserializer` method of the
+//! `ContentDeserializer` through the trait (`dispatch`, generic in the deserializer), with `Probe3`,
+//! a visitor that describes every visit to three levels of nesting, or `ProbeFirst`,
+//! which reads only the first element of a sequence or the first entry of a map (the
+//! `ContentDeserializer` then reports the remaining ones: `SeqDeserializer::end`/`MapDeserializer::end`).
+//! `probe_direct` calls `deserialize_any` of the `ContentDeserializer` directly, as the derive does.
+//! `via_content` reads a `Deserialize` type from the buffer: the library's impls and the derives
+//! of a struct with `deny_unknown_fields`, an externally tagged enum with unit, tuple and struct
+//! variants (`EnumDeserializer`, `VariantDeserializer`; the derive of a newtype variant maps the
+//! result with `Result::map`, not modeled, so `Probe` reads the newtype variants), a newtype
+//! struct and a unit struct.
+//!
+//! `SerdeContentDeserializer/Checks.lean` runs these functions against the in-test format of the
+//! `native` test module (a value tree), encoded as a `FormatProgram`, and compares with the native
+//! results.
+
+use serde::__private228::de::{Content, ContentDeserializer, ContentVisitor};
+use serde::de::{DeserializeSeed, Deserializer, EnumAccess, MapAccess, SeqAccess, VariantAccess, Visitor};
+use serde::de::IgnoredAny;
+use serde::Deserialize;
+use std::collections::BTreeMap;
+use std::fmt;
+use std::marker::PhantomData;
+
+/// A seed or visitor made afresh (`Probe` reads its nested values with a fresh `N`).
+pub trait Fresh {
+    fn fresh() -> Self;
+}
+
+/// The end of the nesting: the value is read as `IgnoredAny` and described as `_`.
+pub struct Stop;
+
+impl Fresh for Stop {
+    fn fresh() -> Self {
+        Stop
+    }
+}
+
+impl<'de> DeserializeSeed<'de> for Stop {
+    type Value = String;
+    fn deserialize<D: Deserializer<'de>>(self, deserializer: D) -> Result<String, D::Error> {
+        let IgnoredAny = IgnoredAny::deserialize(deserializer)?;
+        Ok("_".to_string())
+    }
+}
+
+/// A visitor describing every visit; the nested values are read with a fresh `N` (a visitor that
+/// reads nested values with itself is a recursive group through serde's knot, which the
+/// extraction does not translate).
+pub struct Probe<N>(PhantomData<N>);
+
+impl<N> Fresh for Probe<N> {
+    fn fresh() -> Self {
+        Probe(PhantomData)
+    }
+}
+
+/// The nesting of `probe`: three described levels.
+pub type Probe3 = Probe<Probe<Probe<Stop>>>;
+
+impl<'de, N: Fresh + DeserializeSeed<'de, Value = String>> DeserializeSeed<'de> for Probe<N> {
+    type Value = String;
+    fn deserialize<D: Deserializer<'de>>(self, deserializer: D) -> Result<String, D::Error> {
+        deserializer.deserialize_any(self)
+    }
+}
+
+fn bytes_text(kind: &str, v: &[u8]) -> String {
+    let mut out = String::new();
+    out.push_str(kind);
+    out.push_str(" [");
+    for b in v.iter() {
+        out.push_str(&b.to_string());
+        out.push_str(";");
+    }
+    out.push_str("]");
+    out
+}
+
+impl<'de, N: Fresh + DeserializeSeed<'de, Value = String>> Visitor<'de> for Probe<N> {
+    type Value = String;
+
+    fn expecting(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        formatter.write_str("anything")
+    }
+
+    fn visit_bool<E: serde::de::Error>(self, v: bool) -> Result<String, E> {
+        Ok(format!("bool {v}"))
+    }
+    fn visit_i8<E: serde::de::Error>(self, v: i8) -> Result<String, E> {
+        Ok(format!("i8 {v}"))
+    }
+    fn visit_i16<E: serde::de::Error>(self, v: i16) -> Result<String, E> {
+        Ok(format!("i16 {v}"))
+    }
+    fn visit_i32<E: serde::de::Error>(self, v: i32) -> Result<String, E> {
+        Ok(format!("i32 {v}"))
+    }
+    fn visit_i64<E: serde::de::Error>(self, v: i64) -> Result<String, E> {
+        Ok(format!("i64 {v}"))
+    }
+    fn visit_u8<E: serde::de::Error>(self, v: u8) -> Result<String, E> {
+        Ok(format!("u8 {v}"))
+    }
+    fn visit_u16<E: serde::de::Error>(self, v: u16) -> Result<String, E> {
+        Ok(format!("u16 {v}"))
+    }
+    fn visit_u32<E: serde::de::Error>(self, v: u32) -> Result<String, E> {
+        Ok(format!("u32 {v}"))
+    }
+    fn visit_u64<E: serde::de::Error>(self, v: u64) -> Result<String, E> {
+        Ok(format!("u64 {v}"))
+    }
+    fn visit_f32<E: serde::de::Error>(self, v: f32) -> Result<String, E> {
+        Ok(format!("f32 {:x}", v.to_bits()))
+    }
+    fn visit_f64<E: serde::de::Error>(self, v: f64) -> Result<String, E> {
+        Ok(format!("f64 {:x}", v.to_bits()))
+    }
+    fn visit_char<E: serde::de::Error>(self, v: char) -> Result<String, E> {
+        Ok(format!("char {v}"))
+    }
+    fn visit_str<E: serde::de::Error>(self, v: &str) -> Result<String, E> {
+        Ok(format!("str {v}"))
+    }
+    fn visit_borrowed_str<E: serde::de::Error>(self, v: &'de str) -> Result<String, E> {
+        Ok(format!("borrowed_str {v}"))
+    }
+    fn visit_string<E: serde::de::Error>(self, v: String) -> Result<String, E> {
+        Ok(format!("string {v}"))
+    }
+    fn visit_bytes<E: serde::de::Error>(self, v: &[u8]) -> Result<String, E> {
+        Ok(bytes_text("bytes", v))
+    }
+    fn visit_borrowed_bytes<E: serde::de::Error>(self, v: &'de [u8]) -> Result<String, E> {
+        Ok(bytes_text("borrowed_bytes", v))
+    }
+    fn visit_byte_buf<E: serde::de::Error>(self, v: Vec<u8>) -> Result<String, E> {
+        Ok(bytes_text("byte_buf", &v))
+    }
+    fn visit_none<E: serde::de::Error>(self) -> Result<String, E> {
+        Ok("none".to_string())
+    }
+    fn visit_some<D: Deserializer<'de>>(self, deserializer: D) -> Result<String, D::Error> {
+        let inner = N::fresh().deserialize(deserializer)?;
+        Ok(format!("some({inner})"))
+    }
+    fn visit_unit<E: serde::de::Error>(self) -> Result<String, E> {
+        Ok("unit".to_string())
+    }
+    fn visit_newtype_struct<D: Deserializer<'de>>(self, deserializer: D) -> Result<String, D::Error> {
+        let inner = N::fresh().deserialize(deserializer)?;
+        Ok(format!("newtype({inner})"))
+    }
+    fn visit_seq<A: SeqAccess<'de>>(self, mut seq: A) -> Result<String, A::Error> {
+        let mut out = String::new();
+        out.push_str("seq[");
+        while let Some(x) = seq.next_element_seed(N::fresh())? {
+            out.push_str(&x);
+            out.push_str(";");
+        }
+        out.push_str("]");
+        Ok(out)
+    }
+    fn visit_map<A: MapAccess<'de>>(self, mut map: A) -> Result<String, A::Error> {
+        let mut out = String::new();
+        out.push_str("map{");
+        while let Some(k) = map.next_key_seed(N::fresh())? {
+            let v = map.next_value_seed(N::fresh())?;
+            out.push_str(&k);
+            out.push_str(": ");
+            out.push_str(&v);
+            out.push_str(";");
+        }
+        out.push_str("}");
+        Ok(out)
+    }
+    fn visit_enum<A: EnumAccess<'de>>(self, data: A) -> Result<String, A::Error> {
+        let (name, variant) = data.variant_seed(N::fresh())?;
+        let inner = variant.newtype_variant_seed(N::fresh())?;
+        Ok(format!("enum {name} = {inner}"))
+    }
+}
+
+/// A visitor reading only the first element of a sequence or the first entry of a map.
+pub struct ProbeFirst;
+
+impl<'de> Visitor<'de> for ProbeFirst {
+    type Value = String;
+
+    fn expecting(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        formatter.write_str("the first element")
+    }
+
+    fn visit_seq<A: SeqAccess<'de>>(self, mut seq: A) -> Result<String, A::Error> {
+        match seq.next_element_seed(Probe3::fresh())? {
+            Some(x) => Ok(format!("first {x}")),
+            None => Ok("empty".to_string()),
+        }
+    }
+
+    fn visit_map<A: MapAccess<'de>>(self, mut map: A) -> Result<String, A::Error> {
+        match map.next_key_seed(Probe3::fresh())? {
+            Some(k) => {
+                let v = map.next_value_seed(Probe3::fresh())?;
+                Ok(format!("first {k}: {v}"))
+            }
+            None => Ok("empty".to_string()),
+        }
+    }
+}
+
+/// One `Deserializer` method, through the trait.
+pub fn dispatch<'de, X: Deserializer<'de>>(x: X, method: u8) -> Result<String, X::Error> {
+    match method {
+        0 => x.deserialize_any(Probe3::fresh()),
+        1 => x.deserialize_bool(Probe3::fresh()),
+        2 => x.deserialize_i8(Probe3::fresh()),
+        3 => x.deserialize_i16(Probe3::fresh()),
+        4 => x.deserialize_i32(Probe3::fresh()),
+        5 => x.deserialize_i64(Probe3::fresh()),
+        6 => x.deserialize_u8(Probe3::fresh()),
+        7 => x.deserialize_u16(Probe3::fresh()),
+        8 => x.deserialize_u32(Probe3::fresh()),
+        9 => x.deserialize_u64(Probe3::fresh()),
+        10 => x.deserialize_f32(Probe3::fresh()),
+        11 => x.deserialize_f64(Probe3::fresh()),
+        12 => x.deserialize_char(Probe3::fresh()),
+        13 => x.deserialize_str(Probe3::fresh()),
+        14 => x.deserialize_string(Probe3::fresh()),
+        15 => x.deserialize_bytes(Probe3::fresh()),
+        16 => x.deserialize_byte_buf(Probe3::fresh()),
+        17 => x.deserialize_option(Probe3::fresh()),
+        18 => x.deserialize_unit(Probe3::fresh()),
+        19 => x.deserialize_unit_struct("U", Probe3::fresh()),
+        20 => x.deserialize_newtype_struct("N", Probe3::fresh()),
+        21 => x.deserialize_seq(Probe3::fresh()),
+        22 => x.deserialize_tuple(2, Probe3::fresh()),
+        23 => x.deserialize_tuple_struct("T", 2, Probe3::fresh()),
+        24 => x.deserialize_map(Probe3::fresh()),
+        25 => x.deserialize_struct("S", &["a"], Probe3::fresh()),
+        26 => x.deserialize_enum("E", &["A"], Probe3::fresh()),
+        27 => x.deserialize_identifier(Probe3::fresh()),
+        28 => x.deserialize_ignored_any(Probe3::fresh()),
+        29 => x.deserialize_i128(Probe3::fresh()),
+        30 => x.deserialize_u128(Probe3::fresh()),
+        31 => {
+            let readable = x.is_human_readable();
+            Ok(format!("human readable {readable}"))
+        }
+        32 => x.deserialize_seq(ProbeFirst),
+        33 => x.deserialize_map(ProbeFirst),
+        _ => x.deserialize_struct("S", &["a"], ProbeFirst),
+    }
+}
+
+/// Buffer the input, then call the method `method` of the `ContentDeserializer` over it.
+pub fn probe<'de, D: Deserializer<'de>>(deserializer: D, method: u8) -> Result<String, D::Error> {
+    let content: Content<'de> = ContentVisitor::new().deserialize(deserializer)?;
+    dispatch(ContentDeserializer::<D::Error>::new(content), method)
+}
+
+/// Buffer the input, then call `deserialize_any` of the `ContentDeserializer` directly.
+pub fn probe_direct<'de, D: Deserializer<'de>>(deserializer: D) -> Result<String, D::Error> {
+    let content: Content<'de> = ContentVisitor::new().deserialize(deserializer)?;
+    ContentDeserializer::<D::Error>::new(content).deserialize_any(Probe3::fresh())
+}
+
+/// Buffer the input, then deserialize `T` from the buffer.
+pub fn via_content<'de, T: Deserialize<'de>, D: Deserializer<'de>>(
+    deserializer: D,
+) -> Result<T, D::Error> {
+    let content: Content<'de> = ContentVisitor::new().deserialize(deserializer)?;
+    T::deserialize(ContentDeserializer::<D::Error>::new(content))
+}
+
+/// `via_content` at the library's impls.
+pub fn ints<'de, D: Deserializer<'de>>(d: D) -> Result<Vec<i8>, D::Error> {
+    via_content(d)
+}
+
+pub fn pair<'de, D: Deserializer<'de>>(d: D) -> Result<(u8, bool), D::Error> {
+    via_content(d)
+}
+
+pub fn counts<'de, D: Deserializer<'de>>(d: D) -> Result<BTreeMap<String, u32>, D::Error> {
+    via_content(d)
+}
+
+pub fn text<'de, D: Deserializer<'de>>(d: D) -> Result<String, D::Error> {
+    via_content(d)
+}
+
+pub fn byte<'de, D: Deserializer<'de>>(d: D) -> Result<u8, D::Error> {
+    via_content(d)
+}
+
+pub fn float<'de, D: Deserializer<'de>>(d: D) -> Result<f64, D::Error> {
+    via_content(d)
+}
+
+pub fn flag<'de, D: Deserializer<'de>>(d: D) -> Result<bool, D::Error> {
+    via_content(d)
+}
+
+pub fn maybe<'de, D: Deserializer<'de>>(d: D) -> Result<Option<u8>, D::Error> {
+    via_content(d)
+}
+
+pub fn unit<'de, D: Deserializer<'de>>(d: D) -> Result<(), D::Error> {
+    via_content(d)
+}
+
+pub fn ignored<'de, D: Deserializer<'de>>(d: D) -> Result<IgnoredAny, D::Error> {
+    via_content(d)
+}
