@@ -0,0 +1,397 @@
+import SerdeContentDeserializer.SerdeContentDeserializer
+
+/-! Run the extracted `probe`, `probe_direct`, `via_content` and its instances of
+    `tests/src/serde-content-deserializer` (serde's `ContentDeserializer` with its `SeqDeserializer`,
+    `MapDeserializer`, `EnumDeserializer` and `VariantDeserializer`, over a content buffered by
+    `ContentVisitor`) with the model of `Serde/Content.lean` against the in-test format of its
+    `native` test module (a value tree, with `ValueDe`/`SeqDe`/`MapDe`), encoded as a
+    `FormatProgram`, and compare with the native results. -/
+
+namespace serde_content_deserializer.checks
+open Aeneas Aeneas.Std Result
+
+/-- `native::Value` -/
+inductive TValue where
+  | bool (b : Bool)
+  | u8 (n : Nat)
+  | u16 (n : Nat)
+  | u32 (n : Nat)
+  | u64 (n : Nat)
+  | i8 (n : Int)
+  | i64 (n : Int)
+  | f32 (bits : Nat)
+  | f64 (bits : Nat)
+  | char (c : Char)
+  /-- `visit_str` -/
+  | str (s : String)
+  /-- `visit_borrowed_str` -/
+  | bstr (s : String)
+  /-- `visit_bytes` -/
+  | bytes (b : List Nat)
+  /-- `visit_borrowed_bytes` -/
+  | bbytes (b : List Nat)
+  | unit
+  | opt (v : Option TValue)
+  | newtype (v : TValue)
+  | seq (xs : List TValue)
+  | map (kvs : List (TValue × TValue))
+deriving Inhabited
+
+/-! ## `native::TestError(String)` -/
+
+/-- `impl Display for TestError`: `f.write_str(&self.0)`. -/
+def errDisplay : core.fmt.Display String := ⟨fun s f => f.append s⟩
+
+/-- `#[derive(Debug)]`: `TestError("..")`. -/
+def errDebug : core.fmt.Debug String :=
+  ⟨fun s f => f.debugTuple "TestError" [⟨String, core.fmt.DebugString, s⟩]⟩
+
+/-- `ToString::to_string` (a `Display` returning an error panics). -/
+def toString' {T : Type} (d : core.fmt.Display T) (x : T) : Result String := do
+  let (status, f) ← d.fmt x {}
+  match status with
+  | .Ok () => ok f.output
+  | .Err _ => fail .panic
+
+/-- `impl de::Error for TestError`: `TestError(msg.to_string())`. -/
+def deErr : serde_core.de.Error String :=
+  { coreerrorErrorInst := ⟨errDebug, errDisplay⟩, custom := fun d msg => toString' d msg }
+
+/-! ## `ValueDe`, `SeqDe`, `MapDe`, as a format program -/
+
+open serde_core.de in
+def deTypes : FormatTypes where
+  ιD := Unit
+  D := fun _ => TValue
+  DError := fun _ => String
+  ιS := Unit
+  S := fun _ => List TValue
+  SError := fun _ => String
+  ιM := Unit
+  M := fun _ => List (TValue × TValue) × Option TValue
+  MError := fun _ => String
+  ιE := Empty
+  E := fun _ => Unit
+  EError := fun _ => String
+  EVariant := fun _ => Unit
+  ιV := Empty
+  V := fun _ => Unit
+  VError := fun _ => String
+
+/-- The bytes of a `&[u8]`/`Vec<u8>`. -/
+def bytesOf (b : List Nat) : Result (Slice U8) :=
+  let l : List U8 := b.map fun n => ⟨BitVec.ofNat _ n⟩
+  if h : l.length ≤ Usize.max then ok ⟨l, h⟩ else fail .panic
+
+open serde_core.de in
+/-- `ValueDe::deserialize_any`. -/
+def deserializeAny {X : Fam} (sub : deTypes.Dicts X) {V Value : Type} (vis : VisitorStep X V Value)
+    (d : TValue) (v : V) : Result (core.result.Result Value String) :=
+  match d with
+  | .bool b => vis.visit_bool deErr v b
+  | .u8 n => vis.visit_u8 deErr v ⟨BitVec.ofNat _ n⟩
+  | .u16 n => vis.visit_u16 deErr v ⟨BitVec.ofNat _ n⟩
+  | .u32 n => vis.visit_u32 deErr v ⟨BitVec.ofNat _ n⟩
+  | .u64 n => vis.visit_u64 deErr v ⟨BitVec.ofNat _ n⟩
+  | .i8 n => vis.visit_i8 deErr v ⟨BitVec.ofInt _ n⟩
+  | .i64 n => vis.visit_i64 deErr v ⟨BitVec.ofInt _ n⟩
+  | .f32 bits => vis.visit_f32 deErr v ⟨BitVec.ofNat _ bits⟩
+  | .f64 bits => vis.visit_f64 deErr v ⟨BitVec.ofNat _ bits⟩
+  | .char c => vis.visit_char deErr v c
+  | .str s => Str.ofString s >>= fun x => vis.visit_str deErr v x
+  | .bstr s => Str.ofString s >>= fun x => vis.visit_borrowed_str deErr v x
+  | .bytes b => bytesOf b >>= fun x => vis.visit_bytes deErr v x
+  | .bbytes b => bytesOf b >>= fun x => vis.visit_borrowed_bytes deErr v x
+  | .unit => vis.visit_unit deErr v
+  | .opt none => vis.visit_none deErr v
+  | .opt (some x) => vis.visit_some (sub.des ()) v x
+  | .newtype x => vis.visit_newtype_struct (sub.des ()) v x
+  | .seq xs => vis.visit_seq (sub.seqs ()) v xs
+  | .map kvs => vis.visit_map (sub.maps ()) v (kvs, none)
+
+open serde_core.de in
+def deStep (X : Fam) (sub : deTypes.Dicts X) : deTypes.Dicts (Step X) where
+  des := fun _ =>
+    let any := @deserializeAny X sub
+    { serde_coredeErrorInst := deErr
+      deserialize_any := any
+      deserialize_bool := any, deserialize_i8 := any, deserialize_i16 := any
+      deserialize_i32 := any, deserialize_i64 := any, deserialize_i128 := any
+      deserialize_u8 := any, deserialize_u16 := any, deserialize_u32 := any
+      deserialize_u64 := any, deserialize_u128 := any, deserialize_f32 := any
+      deserialize_f64 := any, deserialize_char := any, deserialize_str := any
+      deserialize_string := any, deserialize_bytes := any, deserialize_byte_buf := any
+      deserialize_option := any, deserialize_unit := any
+      deserialize_unit_struct := fun vis d _ v => any vis d v
+      deserialize_newtype_struct := fun vis d _ v => any vis d v
+      deserialize_seq := any
+      deserialize_tuple := fun vis d _ v => any vis d v
+      deserialize_tuple_struct := fun vis d _ _ v => any vis d v
+      deserialize_map := any
+      deserialize_struct := fun vis d _ _ v => any vis d v
+      deserialize_enum := fun vis d _ _ v => any vis d v
+      deserialize_identifier := any
+      deserialize_ignored_any := any }
+  seqs := fun _ =>
+    { serde_coredeErrorInst := deErr
+      next_element_seed := fun seed xs t =>
+        match xs with
+        | [] => ok (.Ok none, [])
+        | x :: rest =>
+          seed.deserialize (sub.des ()) t x >>= fun r =>
+          match r with
+          | .Ok v => ok (.Ok (some v), rest)
+          | .Err e => ok (.Err e, rest) }
+  maps := fun _ =>
+    { serde_coredeErrorInst := deErr
+      next_key_seed := fun seed st k =>
+        match st.1 with
+        | [] => ok (.Ok none, st)
+        | (key, value) :: rest =>
+          seed.deserialize (sub.des ()) k key >>= fun r =>
+          match r with
+          | .Ok v => ok (.Ok (some v), (rest, some value))
+          | .Err e => ok (.Err e, (rest, some value))
+      next_value_seed := fun seed st v =>
+        match st.2 with
+        | none => ok (.Err "value missing", st)
+        | some value => do
+          let r ← seed.deserialize (sub.des ()) v value
+          ok (r, (st.1, none)) }
+  enums := fun i => nomatch i
+  variants := fun i => nomatch i
+
+open serde_core.de in
+def deFormat : FormatProgram deTypes where
+  base := bottom (DeAt 0) deTypes
+  step := deStep
+
+/-- `ValueDe` with nesting bound `n`. -/
+def valueDe (n : Nat) := deFormat.encode n ()
+
+/-! ## The extracted functions against the in-test format (the asserts of `native`) -/
+
+/-- A result of the native test helpers: `Ok`, `Err(TestError(..))`, or no result (a panic or
+    divergence of the model, or the nesting bound reached). -/
+inductive Out (α : Type) where
+  | ok (a : α)
+  | err (e : String)
+  | none
+deriving BEq, Repr
+
+def out {α : Type} : Result (core.result.Result α String) → Out α
+  | ok (.Ok a) => .ok a
+  | ok (.Err e) => .err e
+  | _ => .none
+
+def Out.map {α β : Type} (f : α → β) : Out α → Out β
+  | .ok a => .ok (f a)
+  | .err e => .err e
+  | .none => .none
+
+/-- The nesting bound of the encoded format (the tests need at most five levels). -/
+def bound : Nat := 12
+
+/-- `pr`: `probe(ValueDe(v), method)`. -/
+def pr (v : TValue) (m : Nat) : Out String := out (probe (valueDe bound) v ⟨BitVec.ofNat _ m⟩)
+
+/-- `inv(what)` -/
+def inv (what : String) : Out String := .err ("invalid type: " ++ what ++ ", expected anything")
+
+/-! `deserialize_any` (through the trait and directly) -/
+def anyCases : List (TValue × String) :=
+  [(.bool false, "bool false"), (.u8 1, "u8 1"), (.u16 2, "u16 2"), (.u32 3, "u32 3"),
+   (.u64 4, "u64 4"), (.i8 (-5), "i8 -5"), (.i64 (-6), "i64 -6"), (.f32 0x40000000, "f32 40000000"),
+   (.f64 0xbfe0000000000000, "f64 bfe0000000000000"), (.char 'x', "char x"),
+   (.str "t", "string t"), (.bstr "b", "borrowed_str b"), (.bytes [1, 2], "byte_buf [1;2;]"),
+   (.bbytes [3], "borrowed_bytes [3;]"), (.unit, "unit"), (.opt none, "none"),
+   (.opt (some (.u8 1)), "some(u8 1)"), (.newtype (.bstr "n"), "newtype(borrowed_str n)"),
+   (.seq [.u8 1, .seq []], "seq[u8 1;seq[];]"),
+   (.map [(.bstr "k", .opt (some .unit))], "map{borrowed_str k: some(unit);}")]
+#guard anyCases.all fun (v, d) =>
+  pr v 0 == .ok d && out (probe_direct (valueDe bound) v) == .ok d
+
+/-! `scalar_methods` -/
+#guard pr (.bool true) 1 == .ok "bool true"
+#guard pr (.u8 1) 1 == inv "integer `1`"
+#guard (List.range' 2 8).all fun m =>
+  pr (.u16 5) m == .ok "u16 5" && pr (.i64 (-1)) m == .ok "i64 -1" &&
+  pr (.f64 0x3ff8000000000000) m == inv "floating point `1.5`" &&
+  pr (.bool true) m == inv "boolean `true`"
+#guard [10, 11].all fun m =>
+  pr (.f32 0x3f800000) m == .ok "f32 3f800000" &&
+  pr (.f64 0x3ff0000000000000) m == .ok "f64 3ff0000000000000" &&
+  pr (.u32 9) m == .ok "u32 9" && pr (.i8 (-9)) m == .ok "i8 -9" &&
+  pr (.bstr "1") m == inv "string \"1\""
+#guard pr (.char 'é') 12 == .ok "char é"
+#guard pr (.str "ab") 12 == .ok "string ab"
+#guard pr (.bstr "c") 12 == .ok "borrowed_str c"
+#guard pr (.u8 1) 12 == inv "integer `1`"
+#guard pr (.bytes [0x61]) 12 == inv "byte array"
+#guard pr (.char 'z') 29 == .err "i128 is not supported"
+#guard pr (.u8 1) 30 == .err "u128 is not supported"
+#guard pr .unit 31 == .ok "human readable true"
+
+/-! `string_and_bytes_methods` -/
+#guard [13, 14, 15, 16].all fun m =>
+  pr (.str "s") m == .ok "string s" && pr (.bstr "b") m == .ok "borrowed_str b" &&
+  pr (.bytes [7]) m == .ok "byte_buf [7;]" && pr (.bbytes [8]) m == .ok "borrowed_bytes [8;]" &&
+  pr (.char 'c') m == inv "character `c`" && pr .unit m == inv "unit value"
+#guard pr (.seq [.u8 1]) 13 == inv "sequence"
+#guard pr (.seq [.u8 1]) 16 == .ok "seq[u8 1;]"
+#guard pr (.seq [.u8 1, .u8 2]) 15 == .ok "seq[u8 1;u8 2;]"
