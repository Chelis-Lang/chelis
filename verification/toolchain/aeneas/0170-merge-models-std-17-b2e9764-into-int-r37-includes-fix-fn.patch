+//! serde's `TaggedContentVisitor` (serde 1.0.228 `private/de.rs`) through the library model of
+//! `serde_core` (`Aeneas/Std/Serde/Content.lean`): the first step of `#[derive(Deserialize)]` with
+//! `#[serde(tag = "..")]`, which reads the tag and buffers the rest of the input.
+//!
+//! A map may carry the tag at any position: every key goes through serde's private
+//! `TagOrContentVisitor` (a string or bytes equal to the tag name is the tag, any other key is
+//! buffered with `ContentVisitor`); the tag's value is `T`, a second tag is `duplicate_field`, no tag
+//! is `missing_field`, the other entries are buffered in order as a `Content::Map`. A sequence
+//! carries the tag first, the rest is buffered through `SeqAccessDeserializer` as a `Content::Seq`.
+//! Any other input is serde's provided `invalid_type`.
+//!
+//! `buffer_rest` is that buffering of the rest of a sequence on its own.
+//!
+//! `Tag` has the form of the derive's variant identifier (`__Field`: `deserialize_identifier`, a
+//! variant index, the renamed names, `unknown_variant`); `tagged_name` reads the tag as a `String`.
+//!
+//! `SerdeTaggedContent/Checks.lean` runs these functions against the in-test format of the `native`
+//! test module (a value tree), encoded as a `FormatProgram`, and compares with the native results.
+
+use serde::__private228::de::{Content, ContentVisitor, TaggedContentVisitor};
+use serde::de::value::SeqAccessDeserializer;
+use serde::de::{self, Deserialize, DeserializeSeed, Deserializer, SeqAccess, Visitor};
+use std::fmt;
+
+/// The variant identifier of an internally tagged enum with the variants renamed "f64" and
+/// "int32" (the derive's `__Field`).
+pub enum Tag {
+    F64,
+    Int32,
+}
+
+const VARIANTS: &[&str] = &["f64", "int32"];
+
+struct TagVisitor;
+
+impl<'de> Visitor<'de> for TagVisitor {
+    type Value = Tag;
+
+    fn expecting(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        formatter.write_str("variant identifier")
+    }
+
+    fn visit_u64<E: de::Error>(self, value: u64) -> Result<Tag, E> {
+        match value {
+            0 => Ok(Tag::F64),
+            1 => Ok(Tag::Int32),
+            _ => Err(de::Error::invalid_value(
+                de::Unexpected::Unsigned(value),
+                &"variant index 0 <= i < 2",
+            )),
+        }
+    }
+
+    fn visit_str<E: de::Error>(self, value: &str) -> Result<Tag, E> {
+        match value {
+            "f64" => Ok(Tag::F64),
+            "int32" => Ok(Tag::Int32),
+            _ => Err(de::Error::unknown_variant(value, VARIANTS)),
+        }
+    }
+
+    fn visit_bytes<E: de::Error>(self, value: &[u8]) -> Result<Tag, E> {
+        match value {
+            b"f64" => Ok(Tag::F64),
+            b"int32" => Ok(Tag::Int32),
+            _ => {
+                let value = &serde::__private228::from_utf8_lossy(value);
+                Err(de::Error::unknown_variant(value, VARIANTS))
+            }
+        }
+    }
+}
+
+impl<'de> Deserialize<'de> for Tag {
+    fn deserialize<D: Deserializer<'de>>(deserializer: D) -> Result<Tag, D::Error> {
+        deserializer.deserialize_identifier(TagVisitor)
+    }
+}
+
+/// The tag `dtype` and the buffered rest, as the derive of an internally tagged enum reads them.
+pub fn tagged<'de, D: Deserializer<'de>>(deserializer: D) -> Result<(Tag, Content<'de>), D::Error> {
+    deserializer.deserialize_any(TaggedContentVisitor::<Tag>::new(
+        "dtype",
+        "internally tagged enum ScalarWire",
+    ))
+}
+
+/// The tag `kind` as a `String`, and the buffered rest.
+pub fn tagged_name<'de, D: Deserializer<'de>>(
+    deserializer: D,
+) -> Result<(String, Content<'de>), D::Error> {
+    deserializer.deserialize_any(TaggedContentVisitor::<String>::new(
+        "kind",
+        "internally tagged enum Named",
+    ))
+}
+
+/// The rest of a sequence buffered as `TaggedContentVisitor::visit_seq` does after the tag:
+/// `ContentVisitor::new().deserialize(SeqAccessDeserializer::new(seq))`.
+pub fn buffer_rest<'de, S: SeqAccess<'de>>(seq: S) -> Result<Content<'de>, S::Error> {
+    ContentVisitor::new().deserialize(SeqAccessDeserializer::new(seq))
+}
+
+#[cfg(test)]
+mod native {
+    //! The in-test format: an owned value tree, each variant visited with one `visit_*` method.
+    use super::*;
+    use serde::de::MapAccess;
+
+    #[derive(Clone, Debug)]
+    pub enum Value {
+        Bool(bool),
+        U8(u8),
+        U64(u64),
+        I64(i64),
+        /// `visit_str` (a transient borrow)
+        Str(String),
+        /// `visit_borrowed_str`
+        BStr(&'static str),
+        /// `visit_string`
+        OwnedStr(String),
+        /// `visit_bytes`
+        Bytes(Vec<u8>),
+        /// `visit_borrowed_bytes`
+        BBytes(&'static [u8]),
+        /// `visit_byte_buf`
+        ByteBuf(Vec<u8>),
+        Unit,
+        Opt(Option<Box<Value>>),
+        Seq(Vec<Value>),
+        Map(Vec<(Value, Value)>),
+        /// `visit_enum` (a unit variant named by a `StrDeserializer`)
+        Enum(&'static str),
+        /// A value no visitor accepts: the format reports an error.
+        Bad,
+    }
+    use Value::*;
+
+    #[derive(Debug, PartialEq)]
+    pub struct TestError(pub String);
+
+    impl fmt::Display for TestError {
+        fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+            f.write_str(&self.0)
+        }
+    }
+
+    impl std::error::Error for TestError {}
+
+    impl de::Error for TestError {
+        fn custom<T: fmt::Display>(msg: T) -> Self {
+            TestError(msg.to_string())
+        }
+    }
+
+    pub struct ValueDe(pub Value);
+    pub struct SeqDe(std::vec::IntoIter<Value>);
+    pub struct MapDe {
+        entries: std::vec::IntoIter<(Value, Value)>,
+        value: Option<Value>,
+    }
+
+    impl<'de> Deserializer<'de> for ValueDe {
+        type Error = TestError;
+
+        fn deserialize_any<V: Visitor<'de>>(self, visitor: V) -> Result<V::Value, TestError> {
+            match self.0 {
+                Bool(v) => visitor.visit_bool(v),
+                U8(v) => visitor.visit_u8(v),
+                U64(v) => visitor.visit_u64(v),
+                I64(v) => visitor.visit_i64(v),
+                Str(s) => visitor.visit_str(&s),
+                BStr(s) => visitor.visit_borrowed_str(s),
+                OwnedStr(s) => visitor.visit_string(s),
+                Bytes(b) => visitor.visit_bytes(&b),
+                BBytes(b) => visitor.visit_borrowed_bytes(b),
+                ByteBuf(b) => visitor.visit_byte_buf(b),
+                Unit => visitor.visit_unit(),
+                Opt(None) => visitor.visit_none(),
+                Opt(Some(v)) => visitor.visit_some(ValueDe(*v)),
+                Seq(items) => visitor.visit_seq(SeqDe(items.into_iter())),
+                Map(entries) => visitor.visit_map(MapDe { entries: entries.into_iter(), value: None }),
+                Enum(name) => visitor.visit_enum(de::value::StrDeserializer::<TestError>::new(name)),
+                Bad => Err(TestError("bad value".to_string())),
+            }
+        }
+
+        serde::forward_to_deserialize_any! {
+            bool i8 i16 i32 i64 i128 u8 u16 u32 u64 u128 f32 f64 char str string
+            bytes byte_buf option unit unit_struct newtype_struct seq tuple
+            tuple_struct map struct enum identifier ignored_any
+        }
+    }
+
+    impl<'de> SeqAccess<'de> for SeqDe {
+        type Error = TestError;
+        fn next_element_seed<T: DeserializeSeed<'de>>(
+            &mut self, seed: T,
+        ) -> Result<Option<T::Value>, TestError> {
+            match self.0.next() {
+                Some(v) => seed.deserialize(ValueDe(v)).map(Some),
+                None => Ok(None),
+            }
+        }
+        fn size_hint(&self) -> Option<usize> {
+            Some(self.0.len())
+        }
+    }
+
+    impl<'de> MapAccess<'de> for MapDe {
+        type Error = TestError;
+        fn next_key_seed<K: DeserializeSeed<'de>>(
+            &mut self, seed: K,
+        ) -> Result<Option<K::Value>, TestError> {
+            match self.entries.next() {
+                Some((k, v)) => {
+                    self.value = Some(v);
+                    seed.deserialize(ValueDe(k)).map(Some)
+                }
+                None => Ok(None),
+            }
+        }
+        fn next_value_seed<V: DeserializeSeed<'de>>(
+            &mut self, seed: V,
+        ) -> Result<V::Value, TestError> {
+            match self.value.take() {
+                Some(v) => seed.deserialize(ValueDe(v)),
+                None => Err(TestError("value missing".to_string())),
+            }
+        }
+        fn size_hint(&self) -> Option<usize> {
+            Some(self.entries.len())
+        }
+    }
+
+    /// A description of a buffered content: every variant with its payload.
+    pub fn describe(c: &Content<'_>) -> String {
+        match c {
+            Content::Bool(b) => format!("Bool({b})"),
+            Content::U8(n) => format!("U8({n})"),
+            Content::U16(n) => format!("U16({n})"),
+            Content::U32(n) => format!("U32({n})"),
+            Content::U64(n) => format!("U64({n})"),
+            Content::I8(n) => format!("I8({n})"),
+            Content::I16(n) => format!("I16({n})"),
+            Content::I32(n) => format!("I32({n})"),
+            Content::I64(n) => format!("I64({n})"),
+            Content::F32(f) => format!("F32({:x})", f.to_bits()),
+            Content::F64(f) => format!("F64({:x})", f.to_bits()),
+            Content::Char(ch) => format!("Char({})", *ch as u32),
+            Content::String(s) => format!("String({s})"),
+            Content::Str(s) => format!("Str({s})"),
+            Content::ByteBuf(b) => format!("ByteBuf({b:?})"),
+            Content::Bytes(b) => format!("Bytes({b:?})"),
+            Content::None => "None".to_string(),
+            Content::Some(c) => format!("Some({})", describe(c)),
+            Content::Unit => "Unit".to_string(),
+            Content::Newtype(c) => format!("Newtype({})", describe(c)),
+            Content::Seq(v) => {
+                format!("Seq[{}]", v.iter().map(describe).collect::<Vec<_>>().join(", "))
+            }
+            Content::Map(v) => format!(
+                "Map{{{}}}",
+                v.iter()
+                    .map(|(k, v)| format!("{}: {}", describe(k), describe(v)))
+                    .collect::<Vec<_>>()
+                    .join(", ")
+            ),
+        }
+    }
+
+    fn de_tagged(v: Value) -> Result<String, TestError> {
+        tagged(ValueDe(v)).map(|(tag, c)| {
+            let tag = match tag {
+                Tag::F64 => "f64",
+                Tag::Int32 => "int32",
+            };
+            format!("{tag} {}", describe(&c))
+        })
+    }
+
+    fn de_tagged_name(v: Value) -> Result<String, TestError> {
+        tagged_name(ValueDe(v)).map(|(tag, c)| format!("{tag} {}", describe(&c)))
+    }
+
+    fn ok(s: &str) -> Result<String, TestError> {
+        Ok(s.to_string())
+    }
+
+    fn err(msg: &str) -> Result<String, TestError> {
+        Err(TestError(msg.to_string()))
+    }
+
+    fn entry(k: &'static str, v: Value) -> (Value, Value) {
+        (BStr(k), v)
+    }
+
+    #[test]
+    fn tag_anywhere_in_a_map() {
+        assert_eq!(
+            de_tagged(Map(vec![entry("dtype", BStr("f64")), entry("bits", BStr("3ff0"))])),
+            ok("f64 Map{Str(bits): Str(3ff0)}")
+        );
+        assert_eq!(
+            de_tagged(Map(vec![entry("bits", BStr("3ff0")), entry("dtype", BStr("f64"))])),
+            ok("f64 Map{Str(bits): Str(3ff0)}")
+        );
+        assert_eq!(
+            de_tagged(Map(vec![
+                entry("value", I64(-3)),
+                entry("dtype", Str("int32".to_string())),
+                (Str("extra".to_string()), Seq(vec![U8(1), Unit])),
+                (U8(7), Opt(Some(Box::new(Bool(true))))),
+            ])),
+            ok("int32 Map{Str(value): I64(-3), String(extra): Seq[U8(1), Unit], U8(7): Some(Bool(true))}")
+        );
+        assert_eq!(de_tagged(Map(vec![entry("dtype", U64(1))])), ok("int32 Map{}"));
+        assert_eq!(de_tagged(Map(vec![entry("dtype", Bytes(b"f64".to_vec()))])), ok("f64 Map{}"));
+        assert_eq!(de_tagged(Map(vec![entry("dtype", BBytes(b"int32"))])), ok("int32 Map{}"));
+        assert_eq!(de_tagged(Map(vec![entry("dtype", OwnedStr("f64".to_string()))])), ok("f64 Map{}"));
+    }
+
+    #[test]
+    fn tag_key_forms() {
+        // The tag key given through visit_str, visit_string, visit_bytes, visit_borrowed_bytes and
+        // visit_byte_buf; a key differing in case or a non-string key is buffered.
+        for key in [
+            Str("dtype".to_string()),
+            OwnedStr("dtype".to_string()),
+            Bytes(b"dtype".to_vec()),
+            BBytes(b"dtype"),
+            ByteBuf(b"dtype".to_vec()),
+        ] {
+            assert_eq!(de_tagged(Map(vec![(key, BStr("f64"))])), ok("f64 Map{}"));
+        }
+        assert_eq!(
+            de_tagged(Map(vec![
+                entry("Dtype", U8(1)),
+                (Bytes(b"dtyp".to_vec()), U8(2)),
+                (BBytes(b"x"), U8(3)),
+                (ByteBuf(vec![0xff]), U8(4)),
+                entry("dtype", BStr("f64")),
+            ])),
+            ok("f64 Map{Str(Dtype): U8(1), ByteBuf([100, 116, 121, 112]): U8(2), Bytes([120]): U8(3), ByteBuf([255]): U8(4)}")
+        );
+    }
+
+    #[test]
+    fn map_errors() {
+        assert_eq!(
+            de_tagged(Map(vec![entry("dtype", BStr("f64")), entry("dtype", BStr("f64"))])),
+            err("duplicate field `dtype`")
+        );
+        assert_eq!(
+            de_tagged(Map(vec![entry("dtype", BStr("f64")), entry("bits", U8(0)), (Bytes(b"dtype".to_vec()), Bad)])),
+            err("duplicate field `dtype`")
+        );
+        assert_eq!(de_tagged(Map(vec![entry("bits", BStr("3ff0"))])), err("missing field `dtype`"));
+        assert_eq!(de_tagged(Map(vec![])), err("missing field `dtype`"));
+        assert_eq!(
+            de_tagged(Map(vec![entry("dtype", BStr("f16"))])),
+            err("unknown variant `f16`, expected `f64` or `int32`")
+        );
+        assert_eq!(
+            de_tagged(Map(vec![entry("dtype", Bytes(vec![0x66, 0xff]))])),
+            err("unknown variant `f\u{fffd}`, expected `f64` or `int32`")
+        );
+        assert_eq!(
+            de_tagged(Map(vec![entry("dtype", U64(2))])),
+            err("invalid value: integer `2`, expected variant index 0 <= i < 2")
+        );
+        assert_eq!(
+            de_tagged(Map(vec![entry("dtype", Bool(true))])),
+            err("invalid type: boolean `true`, expected variant identifier")
+        );
+        assert_eq!(de_tagged(Map(vec![entry("dtype", Bad)])), err("bad value"));
+        assert_eq!(de_tagged(Map(vec![entry("bits", Bad), entry("dtype", BStr("f64"))])), err("bad value"));
+        assert_eq!(de_tagged(Map(vec![(Bad, U8(1))])), err("bad value"));
+        assert_eq!(
+            de_tagged(Map(vec![entry("x", Enum("A")), entry("dtype", BStr("f64"))])),
+            err("untagged and internally tagged enums do not support enum input")
+        );
+    }
+
+    #[test]
+    fn sequence_form() {
+        assert_eq!(de_tagged(Seq(vec![BStr("f64"), BStr("3ff0")])), ok("f64 Seq[Str(3ff0)]"));
+        assert_eq!(
+            de_tagged(Seq(vec![U64(1), I64(-3), Seq(vec![]), Map(vec![entry("a", Unit)])])),
+            ok("int32 Seq[I64(-3), Seq[], Map{Str(a): Unit}]")
+        );
+        assert_eq!(de_tagged(Seq(vec![BStr("int32")])), ok("int32 Seq[]"));
+        assert_eq!(de_tagged(Seq(vec![])), err("missing field `dtype`"));
+        assert_eq!(
+            de_tagged(Seq(vec![BStr("bf16"), U8(1)])),
+            err("unknown variant `bf16`, expected `f64` or `int32`")
+        );
+        assert_eq!(de_tagged(Seq(vec![BStr("f64"), U8(1), Bad])), err("bad value"));
+        assert_eq!(
+            de_tagged(Seq(vec![BStr("f64"), Enum("B")])),
+            err("untagged and internally tagged enums do not support enum input")
+        );
+    }
+
+    #[test]
+    fn other_inputs() {
+        assert_eq!(de_tagged(U8(1)), err("invalid type: integer `1`, expected internally tagged enum ScalarWire"));
+        assert_eq!(de_tagged(BStr("f64")), err("invalid type: string \"f64\", expected internally tagged enum ScalarWire"));
+        assert_eq!(de_tagged(Unit), err("invalid type: unit value, expected internally tagged enum ScalarWire"));
+        assert_eq!(de_tagged(Opt(None)), err("invalid type: Option value, expected internally tagged enum ScalarWire"));
+        assert_eq!(de_tagged(Enum("f64")), err("invalid type: enum, expected internally tagged enum ScalarWire"));
+        assert_eq!(de_tagged(Bad), err("bad value"));
+    }
+
+    #[test]
+    fn rest_of_a_sequence() {
+        let rest = |items: Vec<Value>| buffer_rest(SeqDe(items.into_iter())).map(|c| describe(&c));
+        assert_eq!(rest(vec![]), ok("Seq[]"));
+        assert_eq!(rest(vec![BStr("a"), Seq(vec![U8(1)]), Opt(None)]), ok("Seq[Str(a), Seq[U8(1)], None]"));
+        assert_eq!(rest(vec![U8(1), Bad]), err("bad value"));
+    }
+
+    #[test]
+    fn string_tags() {
+        assert_eq!(
+            de_tagged_name(Map(vec![entry("a", U8(1)), entry("kind", BStr("anything"))])),
+            ok("anything Map{Str(a): U8(1)}")
+        );
+        assert_eq!(de_tagged_name(Seq(vec![OwnedStr("k".to_string()), Unit])), ok("k Seq[Unit]"));
+        assert_eq!(
+            de_tagged_name(Map(vec![entry("kind", U8(1))])),
+            err("invalid type: integer `1`, expected a string")
+        );
+        assert_eq!(
+            de_tagged_name(Map(vec![entry("dtype", BStr("f64"))])),
+            err("missing field `kind`")
+        );
+    }
+}
