index 0000000..1224835
--- /dev/null
+++ b/tests/lean/SerdeWireEnum/Checks.lean
@@ -0,0 +1,504 @@
+import SerdeWireEnum.SerdeWireEnum
+
+/-! Run the extracted `decode_scalar` and `decode_storage` of `tests/src/serde-wire-enum` (the
+    production `wire_enum!` shape of chelis-types' `wire_codec.rs`: `#[serde(tag = "dtype",
+    deny_unknown_fields)]` through serde's `TaggedContentVisitor`/`ContentDeserializer` models for a
+    human-readable format, the externally tagged mirror otherwise, and `HexBits<DIGITS>`) against
+    the two in-test formats of its `native` test module, encoded as `FormatProgram`s: `Json`, a
+    serde_json-like value tree (human-readable, self-describing), and `Bin`, a binary-like tree (not
+    human-readable, typed, enums by variant index). The results and the errors are compared with
+    the native ones through the native tests' `scalar`/`storage` renderings. -/
+
+namespace serde_wire_enum.checks
+open Aeneas Aeneas.Std Result
+
+/-! ## `native::TestError(String)` -/
+
+/-- `impl Display for TestError`: `f.write_str(&self.0)`. -/
+def errDisplay : core.fmt.Display String := ⟨fun s f => f.append s⟩
+
+/-- `#[derive(Debug)]`: `TestError("..")`. -/
+def errDebug : core.fmt.Debug String :=
+  ⟨fun s f => f.debugTuple "TestError" [⟨String, core.fmt.DebugString, s⟩]⟩
+
+/-- `ToString::to_string` (a `Display` returning an error panics). -/
+def toString' {T : Type} (d : core.fmt.Display T) (x : T) : Result String := do
+  let (status, f) ← d.fmt x {}
+  match status with
+  | .Ok () => ok f.output
+  | .Err _ => fail .panic
+
+/-- `impl de::Error for TestError`: `TestError(msg.to_string())`. -/
+def deErr : serde_core.de.Error String :=
+  { coreerrorErrorInst := ⟨errDebug, errDisplay⟩, custom := fun d msg => toString' d msg }
+
+/-- `fn fail(msg)`: `Err(TestError(msg.to_string()))`. -/
+def failWith {Value : Type} (msg : String) : Result (core.result.Result Value String) :=
+  ok (.Err msg)
+
+/-! ## `Json`: `JsonDe`, `JsonSeq`, `JsonMap`, as a format program -/
+
+/-- `native::Json` -/
+inductive Json where
+  | null
+  | bool (b : Bool)
+  | u64 (n : Nat)
+  | i64 (n : Int)
+  /-- A float, as its bits. -/
+  | f64 (bits : Nat)
+  /-- A string without escapes (`visit_borrowed_str`). -/
+  | str (s : String)
+  /-- A string with escapes (`visit_str` of the unescaped copy). -/
+  | esc (s : String)
+  | arr (xs : List Json)
+  | obj (kvs : List (String × Json))
+deriving Inhabited
+
+open serde_core.de in
+def jsonTypes : FormatTypes where
+  ιD := Unit
+  D := fun _ => Json
+  DError := fun _ => String
+  ιS := Unit
+  S := fun _ => List Json
+  SError := fun _ => String
+  ιM := Unit
+  M := fun _ => List (String × Json) × Option Json
+  MError := fun _ => String
+  ιE := Empty
+  E := fun _ => Unit
+  EError := fun _ => String
+  EVariant := fun _ => Unit
+  ιV := Empty
+  V := fun _ => Unit
+  VError := fun _ => String
+
+/-- `json_unexpected(&v)` -/
+def jsonUnexpected : Json → Result serde_core.de.Unexpected
+  | .null => ok .Unit
+  | .bool b => ok (.Bool b)
+  | .u64 n => ok (.Unsigned ⟨BitVec.ofNat _ n⟩)
+  | .i64 n => ok (.Signed ⟨BitVec.ofInt _ n⟩)
+  | .f64 bits => ok (.Float ⟨BitVec.ofNat _ bits⟩)
+  | .str s => Str.ofString s >>= fun x => ok (.Str x)
+  | .esc s => Str.ofString s >>= fun x => ok (.Str x)
+  | .arr _ => ok .Seq
+  | .obj _ => ok .Map
+
+open serde_core.de in
+/-- `JsonDe::deserialize_any`. -/
+def jsonAny {X : Fam} (sub : jsonTypes.Dicts X) {V Value : Type} (vis : VisitorStep X V Value)
+    (d : Json) (v : V) : Result (core.result.Result Value String) :=
+  match d with
+  | .null => vis.visit_unit deErr v
+  | .bool b => vis.visit_bool deErr v b
+  | .u64 n => vis.visit_u64 deErr v ⟨BitVec.ofNat _ n⟩
+  | .i64 n => vis.visit_i64 deErr v ⟨BitVec.ofInt _ n⟩
+  | .f64 bits => vis.visit_f64 deErr v ⟨BitVec.ofNat _ bits⟩
+  | .str s => Str.ofString s >>= fun x => vis.visit_borrowed_str deErr v x
+  | .esc s => Str.ofString s >>= fun x => vis.visit_str deErr v x
+  | .arr xs => vis.visit_seq (sub.seqs ()) v xs
+  | .obj kvs => vis.visit_map (sub.maps ()) v (kvs, none)
+
+open serde_core.de in
+/-- `JsonDe::deserialize_str` (also `string` and `identifier`): strings only, else
+    `Error::invalid_type(json_unexpected(&other), &visitor)`. -/
+def jsonStr {X : Fam} {V Value : Type} (vis : VisitorStep X V Value) (d : Json) (v : V) :
+    Result (core.result.Result Value String) :=
+  match d with
+  | .str s => Str.ofString s >>= fun x => vis.visit_borrowed_str deErr v x
+  | .esc s => Str.ofString s >>= fun x => vis.visit_str deErr v x
+  | other => jsonUnexpected other >>= fun u => invalidType vis.expecting deErr v u
+
+open serde_core.de in
+def jsonStep (X : Fam) (sub : jsonTypes.Dicts X) : jsonTypes.Dicts (Step X) where
+  des := fun _ =>
+    let any := @jsonAny X sub
+    { serde_coredeErrorInst := deErr
+      deserialize_any := any
+      deserialize_bool := any, deserialize_i8 := any, deserialize_i16 := any
+      deserialize_i32 := any, deserialize_i64 := any, deserialize_i128 := any
+      deserialize_u8 := any, deserialize_u16 := any, deserialize_u32 := any
+      deserialize_u64 := any, deserialize_u128 := any, deserialize_f32 := any
+      deserialize_f64 := any, deserialize_char := any
+      deserialize_str := @jsonStr X
+      deserialize_string := @jsonStr X
+      deserialize_bytes := any, deserialize_byte_buf := any
+      deserialize_option := fun vis d v =>
+        match d with
+        | .null => vis.visit_none deErr v
+        | other => vis.visit_some (sub.des ()) v other
+      deserialize_unit := any
+      deserialize_unit_struct := fun vis d _ v => any vis d v
+      deserialize_newtype_struct := fun vis d _ v => any vis d v
+      deserialize_seq := any
+      deserialize_tuple := fun vis d _ v => any vis d v
+      deserialize_tuple_struct := fun vis d _ _ v => any vis d v
+      deserialize_map := any
+      deserialize_struct := fun vis d _ _ v => any vis d v
+      deserialize_enum := fun vis d _ _ v => any vis d v
+      deserialize_identifier := @jsonStr X
+      deserialize_ignored_any := any }
+  seqs := fun _ =>
+    { serde_coredeErrorInst := deErr
+      next_element_seed := fun seed xs t =>
+        match xs with
+        | [] => ok (.Ok none, [])
+        | x :: rest =>
+          seed.deserialize (sub.des ()) t x >>= fun r =>
+          match r with
+          | .Ok v => ok (.Ok (some v), rest)
+          | .Err e => ok (.Err e, rest)
+      size_hint := fun xs => ok (some ⟨BitVec.ofNat _ xs.length⟩) }
+  maps := fun _ =>
+    { serde_coredeErrorInst := deErr
+      next_key_seed := fun seed st k =>
+        match st.1 with
+        | [] => ok (.Ok none, st)
+        | (key, value) :: rest =>
+          seed.deserialize (sub.des ()) k (.str key) >>= fun r =>
+          match r with
+          | .Ok v => ok (.Ok (some v), (rest, some value))
+          | .Err e => ok (.Err e, (rest, some value))
+      next_value_seed := fun seed st v =>
+        match st.2 with
+        | none => ok (.Err "value missing", st)
+        | some value => do
+          let r ← seed.deserialize (sub.des ()) v value
+          ok (r, (st.1, none))
+      size_hint := fun st => ok (some ⟨BitVec.ofNat _ st.1.length⟩) }
+  enums := fun i => nomatch i
+  variants := fun i => nomatch i
+
+open serde_core.de in
+def jsonFormat : FormatProgram jsonTypes where
+  base := bottom (DeAt 0) jsonTypes
+  step := jsonStep
+
+/-- `JsonDe` with nesting bound `n`. -/
+def jsonDe (n : Nat) := jsonFormat.encode n ()
+
+/-! ## `Bin`: `BinDe`, `BinSeq`, `BinEnum`, `BinVariant` (and serde's `U32Deserializer` of a
+    variant index), as a format program -/
+
+/-- `native::Bin` -/
+inductive Bin where
+  | bool (b : Bool)
+  | i8 (n : Int)
+  | i16 (n : Int)
+  | i32 (n : Int)
+  | i64 (n : Int)
+  | str (s : String)
+  /-- A sequence with its length (`Vec<T>`). -/
+  | seq (xs : List Bin)
+  /-- The fields of a struct or a struct variant, in order. -/
+  | fields (xs : List Bin)
+  /-- An enum: the variant index and its fields. -/
+  | variant (index : Nat) (fields : Bin)
+deriving Inhabited
+
+/-- The deserializers of the binary format: `BinDe` and the variant index's `U32Deserializer`. -/
+inductive BinD where
+  | bin
+  | index
+
+open serde_core.de in
+def binTypes : FormatTypes where
+  ιD := BinD
+  D := fun | .bin => Bin | .index => Nat
+  DError := fun _ => String
+  ιS := Unit
+  S := fun _ => List Bin
+  SError := fun _ => String
+  ιM := Empty
+  M := fun _ => Unit
+  MError := fun _ => String
+  ιE := Unit
+  E := fun _ => Nat × Bin
+  EError := fun _ => String
+  EVariant := fun _ => Bin
+  ιV := Empty
+  V := fun _ => Unit
+  VError := fun _ => String
+
+open serde_core.de in
+/-- `BinDe`: every `deserialize_*` reads its own kind; the others are `deserialize_any`, which is
+    not supported. -/
+def binDe {X : Fam} (sub : binTypes.Dicts X) : DeserializerF (Step X) Bin String :=
+  let any : {V Value : Type} → VisitorStep X V Value → Bin → V →
+      Result (core.result.Result Value String) :=
+    fun _ _ _ => failWith "deserialize_any is not supported"
+  { serde_coredeErrorInst := deErr
+    deserialize_any := any
+    deserialize_bool := fun vis d v =>
+      match d with | .bool b => vis.visit_bool deErr v b | _ => failWith "expected bool"
+    deserialize_i8 := fun vis d v =>
+      match d with | .i8 n => vis.visit_i8 deErr v ⟨BitVec.ofInt _ n⟩ | _ => failWith "expected i8"
+    deserialize_i16 := fun vis d v =>
+      match d with | .i16 n => vis.visit_i16 deErr v ⟨BitVec.ofInt _ n⟩ | _ => failWith "expected i16"
+    deserialize_i32 := fun vis d v =>
+      match d with | .i32 n => vis.visit_i32 deErr v ⟨BitVec.ofInt _ n⟩ | _ => failWith "expected i32"
+    deserialize_i64 := fun vis d v =>
+      match d with | .i64 n => vis.visit_i64 deErr v ⟨BitVec.ofInt _ n⟩ | _ => failWith "expected i64"
+    deserialize_i128 := any
+    deserialize_u8 := any, deserialize_u16 := any, deserialize_u32 := any
+    deserialize_u64 := any, deserialize_u128 := any, deserialize_f32 := any
+    deserialize_f64 := any, deserialize_char := any, deserialize_str := any
+    deserialize_string := fun vis d v =>
+      match d with | .str s => vis.visit_string deErr v s | _ => failWith "expected string"
+    deserialize_bytes := any, deserialize_byte_buf := any
+    deserialize_option := any, deserialize_unit := any
+    deserialize_unit_struct := fun vis d _ v => any vis d v
+    deserialize_newtype_struct := fun vis d _ v => any vis d v
+    deserialize_seq := fun vis d v =>
+      match d with | .seq xs => vis.visit_seq (sub.seqs ()) v xs | _ => failWith "expected sequence"
+    deserialize_tuple := fun vis d _ v =>
+      match d with | .fields xs => vis.visit_seq (sub.seqs ()) v xs | _ => failWith "expected fields"
+    deserialize_tuple_struct := fun vis d _ _ v => any vis d v
+    deserialize_map := any
+    deserialize_struct := fun vis d _ _ v => any vis d v
+    deserialize_enum := fun vis d _ _ v =>
+      match d with
+      | .variant index fields => vis.visit_enum (sub.enums ()) v (index, fields)
+      | _ => failWith "expected enum"
+    deserialize_identifier := any
+    deserialize_ignored_any := any
+    is_human_readable := fun _ => ok false }
+
+open serde_core.de in
+/-- serde's `U32Deserializer<TestError>` (`value.rs`, `primitive_deserializer!`): every method but
+    `deserialize_enum` is `deserialize_any`, `visitor.visit_u32(self.value)`. The index of a
+    variant is only read as an identifier, so its `deserialize_enum` (the index as a unit variant)
+    is not reached by the tests and is left as the bottom format's. -/
+def indexDe {X : Fam} : DeserializerF (Step X) Nat String :=
+  let any : {V Value : Type} → VisitorStep X V Value → Nat → V →
+      Result (core.result.Result Value String) :=
+    fun vis n v => vis.visit_u32 deErr v ⟨BitVec.ofNat _ n⟩
+  { serde_coredeErrorInst := deErr
+    deserialize_any := any
+    deserialize_bool := any, deserialize_i8 := any, deserialize_i16 := any
+    deserialize_i32 := any, deserialize_i64 := any, deserialize_i128 := any
+    deserialize_u8 := any, deserialize_u16 := any, deserialize_u32 := any
+    deserialize_u64 := any, deserialize_u128 := any, deserialize_f32 := any
+    deserialize_f64 := any, deserialize_char := any, deserialize_str := any
+    deserialize_string := any, deserialize_bytes := any, deserialize_byte_buf := any
+    deserialize_option := any, deserialize_unit := any
+    deserialize_unit_struct := fun vis d _ v => any vis d v
+    deserialize_newtype_struct := fun vis d _ v => any vis d v
+    deserialize_seq := any
+    deserialize_tuple := fun vis d _ v => any vis d v
+    deserialize_tuple_struct := fun vis d _ _ v => any vis d v
+    deserialize_map := any
+    deserialize_struct := fun vis d _ _ v => any vis d v
+    deserialize_enum := fun _ _ _ _ _ => .div
+    deserialize_identifier := any
+    deserialize_ignored_any := any }
+
+open serde_core.de in
+def binStep (X : Fam) (sub : binTypes.Dicts X) : binTypes.Dicts (Step X) where
+  des := fun | .bin => binDe sub | .index => indexDe
+  seqs := fun _ =>
+    { serde_coredeErrorInst := deErr
+      next_element_seed := fun seed xs t =>
+        match xs with
+        | [] => ok (.Ok none, [])
+        | x :: rest =>
+          seed.deserialize (sub.des .bin) t x >>= fun r =>
+          match r with
+          | .Ok v => ok (.Ok (some v), rest)
+          | .Err e => ok (.Err e, rest)
+      size_hint := fun xs => ok (some ⟨BitVec.ofNat _ xs.length⟩) }
+  maps := fun i => nomatch i
+  enums := fun _ =>
+    { serde_coredeErrorInst := deErr
+      /- `BinVariant(Bin)` -/
+      VariantAccessInst :=
+        { serde_coredeErrorInst := deErr
+          unit_variant := fun _ => failWith "expected unit variant"
+          newtype_variant_seed := fun seed f t => seed.deserialize (sub.des .bin) t f
+          tuple_variant := fun vis f len v => (binDe sub).deserialize_tuple vis f len v
+          struct_variant := fun vis f fields v =>
+            (binDe sub).deserialize_tuple vis f ⟨BitVec.ofNat _ fields.val.length⟩ v }
+      /- `seed.deserialize(self.0.into_deserializer()).map(|v| (v, BinVariant(self.1)))` -/
+      variant_seed := fun seed (index, fields) t =>
+        seed.deserialize (sub.des .index) t index >>= fun r =>
+        match r with
+        | .Ok v => ok (.Ok (v, fields))
+        | .Err e => ok (.Err e) }
+  variants := fun i => nomatch i
+
+open serde_core.de in
+def binFormat : FormatProgram binTypes where
+  base := bottom (DeAt 0) binTypes
+  step := binStep
+
+/-- `BinDe` with nesting bound `n`. -/
+def binDeAt (n : Nat) := binFormat.encode n .bin
+
+/-! ## `native::scalar` and `native::storage` -/
+
+def hex (n : Nat) : String := String.ofList (Nat.toDigits 16 n)
+
+def scalar : Bits → String
+  | .F64 v => s!"f64 {hex v.bits.toNat}"
+  | .F32 v => s!"f32 {hex v.bits.toNat}"
+  | .F16 v => s!"f16 {hex v.val}"
+  | .Bf16 v => s!"bf16 {hex v.val}"
+  | .I64 v => s!"int64 {v.val}"
+  | .I32 v => s!"int32 {v.val}"
+  | .I16 v => s!"int16 {v.val}"
+  | .I8 v => s!"int8 {v.val}"
+  | .Bool v => s!"bool {v}"
+
+def joined (xs : List String) : String := ",".intercalate xs
+
+def storage : Buf → String
+  | .F64 v => s!"f64 [{joined (v.val.map fun x => hex x.bits.toNat)}]"
