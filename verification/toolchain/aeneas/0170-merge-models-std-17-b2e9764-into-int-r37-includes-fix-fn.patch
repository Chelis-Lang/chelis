@@ -0,0 +1,333 @@
+import SerdeContent.SerdeContent
+
+/-! Run the extracted `buffer` and `buffer_any` of `tests/src/serde-content` (serde's `ContentVisitor`,
+    as a `DeserializeSeed` and as a `Visitor`) with the model of `Content`/`ContentVisitor` against
+    the in-test format of its `native` test module (a value tree, with `ValueDe`/`SeqDe`/`MapDe`),
+    encoded as a `FormatProgram`, and compare the buffered content (through the native tests'
+    `describe`) and the errors with the native results. -/
+
+namespace serde_content.checks
+open Aeneas Aeneas.Std Result
+open serde_core.private.content (Content)
+
+/-- `native::Value` -/
+inductive TValue where
+  | bool (b : Bool)
+  | u8 (n : Nat)
+  | u16 (n : Nat)
+  | u32 (n : Nat)
+  | u64 (n : Nat)
+  | u128 (n : Nat)
+  | i8 (n : Int)
+  | i16 (n : Int)
+  | i32 (n : Int)
+  | i64 (n : Int)
+  | i128 (n : Int)
+  | f32 (bits : Nat)
+  | f64 (bits : Nat)
+  | char (c : Char)
+  /-- `visit_str` -/
+  | str (s : String)
+  /-- `visit_borrowed_str` -/
+  | bstr (s : String)
+  /-- `visit_string` -/
+  | ownedStr (s : String)
+  /-- `visit_bytes` -/
+  | bytes (b : List Nat)
+  /-- `visit_borrowed_bytes` -/
+  | bbytes (b : List Nat)
+  /-- `visit_byte_buf` -/
+  | byteBuf (b : List Nat)
+  | unit
+  | opt (v : Option TValue)
+  | newtype (v : TValue)
+  | seq (xs : List TValue)
+  | map (kvs : List (TValue × TValue))
+  /-- `visit_enum` with a `StrDeserializer` -/
+  | enumV (variant : String)
+  | bad
+deriving Inhabited
+
+/-! ## `native::TestError(String)` -/
+
+/-- `impl Display for TestError`: `f.write_str(&self.0)`. -/
+def errDisplay : core.fmt.Display String := ⟨fun s f => f.append s⟩
+
+/-- `#[derive(Debug)]`: `TestError("..")`. -/
+def errDebug : core.fmt.Debug String :=
+  ⟨fun s f => f.debugTuple "TestError" [⟨String, core.fmt.DebugString, s⟩]⟩
+
+/-- `ToString::to_string` (a `Display` returning an error panics). -/
+def toString' {T : Type} (d : core.fmt.Display T) (x : T) : Result String := do
+  let (status, f) ← d.fmt x {}
+  match status with
+  | .Ok () => ok f.output
+  | .Err _ => fail .panic
+
+/-- `impl de::Error for TestError`: `TestError(msg.to_string())`. -/
+def deErr : serde_core.de.Error String :=
+  { coreerrorErrorInst := ⟨errDebug, errDisplay⟩, custom := fun d msg => toString' d msg }
+
+/-! ## `ValueDe`, `SeqDe`, `MapDe`, as a format program -/
+
+open serde_core.de in
+def deTypes : FormatTypes where
+  ιD := Unit
+  D := fun _ => TValue
+  DError := fun _ => String
+  ιS := Unit
+  S := fun _ => List TValue
+  SError := fun _ => String
+  ιM := Unit
+  M := fun _ => List (TValue × TValue) × Option TValue
+  MError := fun _ => String
+  ιE := Unit
+  E := fun _ => String
+  EError := fun _ => String
+  EVariant := fun _ => Unit
+  ιV := Empty
+  V := fun _ => Unit
+  VError := fun _ => String
+
+/-- The bytes of a `&[u8]`/`Vec<u8>`. -/
+def bytesOf (b : List Nat) : Result (Slice U8) :=
+  let l : List U8 := b.map fun n => ⟨BitVec.ofNat _ n⟩
+  if h : l.length ≤ Usize.max then ok ⟨l, h⟩ else fail .panic
+
+open serde_core.de in
+/-- `ValueDe::deserialize_any`. -/
+def deserializeAny {X : Fam} (sub : deTypes.Dicts X) {V Value : Type} (vis : VisitorStep X V Value)
+    (d : TValue) (v : V) : Result (core.result.Result Value String) :=
+  match d with
+  | .bool b => vis.visit_bool deErr v b
+  | .u8 n => vis.visit_u8 deErr v ⟨BitVec.ofNat _ n⟩
+  | .u16 n => vis.visit_u16 deErr v ⟨BitVec.ofNat _ n⟩
+  | .u32 n => vis.visit_u32 deErr v ⟨BitVec.ofNat _ n⟩
+  | .u64 n => vis.visit_u64 deErr v ⟨BitVec.ofNat _ n⟩
+  | .u128 n => vis.visit_u128 deErr v ⟨BitVec.ofNat _ n⟩
+  | .i8 n => vis.visit_i8 deErr v ⟨BitVec.ofInt _ n⟩
+  | .i16 n => vis.visit_i16 deErr v ⟨BitVec.ofInt _ n⟩
+  | .i32 n => vis.visit_i32 deErr v ⟨BitVec.ofInt _ n⟩
+  | .i64 n => vis.visit_i64 deErr v ⟨BitVec.ofInt _ n⟩
+  | .i128 n => vis.visit_i128 deErr v ⟨BitVec.ofInt _ n⟩
+  | .f32 bits => vis.visit_f32 deErr v ⟨BitVec.ofNat _ bits⟩
+  | .f64 bits => vis.visit_f64 deErr v ⟨BitVec.ofNat _ bits⟩
+  | .char c => vis.visit_char deErr v c
+  | .str s => Str.ofString s >>= fun x => vis.visit_str deErr v x
+  | .bstr s => Str.ofString s >>= fun x => vis.visit_borrowed_str deErr v x
+  | .ownedStr s => vis.visit_string deErr v s
+  | .bytes b => bytesOf b >>= fun x => vis.visit_bytes deErr v x
+  | .bbytes b => bytesOf b >>= fun x => vis.visit_borrowed_bytes deErr v x
+  | .byteBuf b => bytesOf b >>= fun x => vis.visit_byte_buf deErr v x
+  | .unit => vis.visit_unit deErr v
+  | .opt none => vis.visit_none deErr v
+  | .opt (some x) => vis.visit_some (sub.des ()) v x
+  | .newtype x => vis.visit_newtype_struct (sub.des ()) v x
+  | .seq xs => vis.visit_seq (sub.seqs ()) v xs
+  | .map kvs => vis.visit_map (sub.maps ()) v (kvs, none)
+  | .enumV variant => vis.visit_enum (sub.enums ()) v variant
+  | .bad => ok (.Err "bad value")
+
+open serde_core.de in
+def deStep (X : Fam) (sub : deTypes.Dicts X) : deTypes.Dicts (Step X) where
+  des := fun _ =>
+    let any := @deserializeAny X sub
+    { serde_coredeErrorInst := deErr
+      deserialize_any := any
+      deserialize_bool := any, deserialize_i8 := any, deserialize_i16 := any
+      deserialize_i32 := any, deserialize_i64 := any, deserialize_i128 := any
+      deserialize_u8 := any, deserialize_u16 := any, deserialize_u32 := any
+      deserialize_u64 := any, deserialize_u128 := any, deserialize_f32 := any
+      deserialize_f64 := any, deserialize_char := any, deserialize_str := any
+      deserialize_string := any, deserialize_bytes := any, deserialize_byte_buf := any
+      deserialize_option := any, deserialize_unit := any
+      deserialize_unit_struct := fun vis d _ v => any vis d v
+      deserialize_newtype_struct := fun vis d _ v => any vis d v
+      deserialize_seq := any
+      deserialize_tuple := fun vis d _ v => any vis d v
+      deserialize_tuple_struct := fun vis d _ _ v => any vis d v
+      deserialize_map := any
+      deserialize_struct := fun vis d _ _ v => any vis d v
+      deserialize_enum := fun vis d _ _ v => any vis d v
+      deserialize_identifier := any
+      deserialize_ignored_any := any }
+  seqs := fun _ =>
+    { serde_coredeErrorInst := deErr
+      next_element_seed := fun seed xs t =>
+        match xs with
+        | [] => ok (.Ok none, [])
+        | x :: rest =>
+          seed.deserialize (sub.des ()) t x >>= fun r =>
+          match r with
+          | .Ok v => ok (.Ok (some v), rest)
+          | .Err e => ok (.Err e, rest)
+      size_hint := fun xs => ok (some ⟨BitVec.ofNat _ xs.length⟩) }
+  maps := fun _ =>
+    { serde_coredeErrorInst := deErr
+      next_key_seed := fun seed st k =>
+        match st.1 with
+        | [] => ok (.Ok none, st)
+        | (key, value) :: rest =>
+          seed.deserialize (sub.des ()) k key >>= fun r =>
+          match r with
+          | .Ok v => ok (.Ok (some v), (rest, some value))
+          | .Err e => ok (.Err e, (rest, some value))
+      next_value_seed := fun seed st v =>
+        match st.2 with
+        | none => ok (.Err "value missing", st)
+        | some value => do
+          let r ← seed.deserialize (sub.des ()) v value
+          ok (r, (st.1, none)) }
+  /- `StrDeserializer<TestError>` as an `EnumAccess`: `ContentVisitor::visit_enum` rejects the enum
+     before reading it, so only its error dictionary is reached (the guards below show it). -/
+  enums := fun _ =>
+    { serde_coredeErrorInst := deErr
+      VariantAccessInst := ((bottom (Step X) deTypes).enums ()).VariantAccessInst
+      variant_seed := fun _ _ _ => .div }
+  variants := fun i => nomatch i
+
+open serde_core.de in
+def deFormat : FormatProgram deTypes where
+  base := bottom (DeAt 0) deTypes
+  step := deStep
+
+/-- `ValueDe` with nesting bound `n`. -/
+def valueDe (n : Nat) := deFormat.encode n ()
+
+/-! ## `native::describe` -/
+
+def hex (n : Nat) : String := String.ofList (Nat.toDigits 16 n)
+
+/-- `{:?}` of a `[u8]`. -/
+def bytesDebug (b : List U8) : String :=
+  "[" ++ ", ".intercalate (b.map fun x => toString x.val) ++ "]"
+
+def strText (s : Str) : String :=
+  match Str.toString s with
+  | .ok t => t
+  | _ => "<invalid>"
+
+partial def describe : Content → String
+  | .Bool b => s!"Bool({b})"
+  | .U8 n => s!"U8({n.val})"
+  | .U16 n => s!"U16({n.val})"
+  | .U32 n => s!"U32({n.val})"
+  | .U64 n => s!"U64({n.val})"
+  | .I8 n => s!"I8({n.val})"
+  | .I16 n => s!"I16({n.val})"
+  | .I32 n => s!"I32({n.val})"
+  | .I64 n => s!"I64({n.val})"
+  | .F32 f => s!"F32({hex f.bits.toNat})"
+  | .F64 f => s!"F64({hex f.bits.toNat})"
+  | .Char c => s!"Char({c.toNat})"
+  | .String s => s!"String({s})"
+  | .Str s => s!"Str({strText s})"
+  | .ByteBuf b => s!"ByteBuf({bytesDebug b.val})"
+  | .Bytes b => s!"Bytes({bytesDebug b.val})"
+  | .None => "None"
+  | .Some c => s!"Some({describe c})"
+  | .Unit => "Unit"
+  | .Newtype c => s!"Newtype({describe c})"
+  | .Seq v => "Seq[" ++ ", ".intercalate (v.elems.toList.map describe) ++ "]"
+  | .Map v => "Map{" ++ ", ".intercalate
+      (v.elems.toList.map fun (k, x) => describe k ++ ": " ++ describe x) ++ "}"
+
+/-! ## The extracted functions against the in-test format (the asserts of `native`) -/
+
+/-- A result of the native test helpers: `Ok`, `Err(TestError(..))`, or no result (a panic or
+    divergence of the model, or the nesting bound reached). -/
+inductive Out (α : Type) where
+  | ok (a : α)
+  | err (e : String)
+  | none
+deriving BEq, Repr
+
+def out {α : Type} : Result (core.result.Result α String) → Out α
+  | ok (.Ok a) => .ok a
+  | ok (.Err e) => .err e
+  | _ => .none
+
+def Out.map {α β : Type} (f : α → β) : Out α → Out β
+  | .ok a => .ok (f a)
+  | .err e => .err e
+  | .none => .none
+
+/-- The nesting bound of the encoded format (the tests need at most seven levels). -/
+def bound : Nat := 12
+
+/-- `de_buffer`: `buffer(ValueDe(v)).map(|c| describe(&c))`. -/
+def deBuffer (v : TValue) : Out String := (out (buffer (valueDe bound) v)).map describe
+
+/-- `de_buffer_any`: `buffer_any(ValueDe(v)).map(|c| describe(&c))`. -/
+def deBufferAny (v : TValue) : Out String := (out (buffer_any (valueDe bound) v)).map describe
+
+/-- `nested()` -/
+def nested : TValue :=
+  .map [(.bstr "k", .seq [.u8 1, .opt (some (.str "s")), .unit]),
+        (.u64 2, .newtype (.map [(.bool false, .seq [])])),
+        (.ownedStr "e", .map [])]
+
+/-! `scalars` -/
+def scalarCases : List (TValue × String) :=
+  [(.bool true, "Bool(true)"), (.u8 200, "U8(200)"), (.u16 65535, "U16(65535)"),
+   (.u32 7, "U32(7)"), (.u64 18446744073709551615, "U64(18446744073709551615)"),
+   (.i8 (-128), "I8(-128)"), (.i16 (-2), "I16(-2)"), (.i32 (-2147483648), "I32(-2147483648)"),
+   (.i64 (-9), "I64(-9)"), (.f32 0x3fc00000, "F32(3fc00000)"), (.f32 0x80000000, "F32(80000000)"),
+   (.f64 0x3fb999999999999a, "F64(3fb999999999999a)"),
+   (.f64 0x7ff8000000000001, "F64(7ff8000000000001)"), (.char 'é', "Char(233)"),
+   (.unit, "Unit"), (.opt none, "None")]
+
+#guard scalarCases.all fun (v, d) => deBuffer v == .ok d && deBufferAny v == .ok d
+
+/-! `strings_and_bytes` -/
+#guard deBuffer (.str "ab") == .ok "String(ab)"
+#guard deBuffer (.bstr "ab") == .ok "Str(ab)"
+#guard deBuffer (.ownedStr "ab") == .ok "String(ab)"
+#guard deBuffer (.bytes [1, 2]) == .ok "ByteBuf([1, 2])"
+#guard deBuffer (.bbytes [3]) == .ok "Bytes([3])"
+#guard deBuffer (.byteBuf []) == .ok "ByteBuf([])"
+#guard deBufferAny (.str "é") == .ok "String(é)"
+#guard deBufferAny (.bbytes [255, 0]) == .ok "Bytes([255, 0])"
+
+/-! `nested_values` -/
+#guard deBuffer (.opt (some (.u8 1))) == .ok "Some(U8(1))"
+#guard deBuffer (.newtype (.bstr "n")) == .ok "Newtype(Str(n))"
+#guard deBuffer (.seq []) == .ok "Seq[]"
+#guard deBuffer (.map []) == .ok "Map{}"
+#guard deBuffer (.seq [.i8 (-1), .seq [.u16 2], .opt (some (.opt none))]) ==
+  .ok "Seq[I8(-1), Seq[U16(2)], Some(None)]"
+#guard deBuffer nested ==
+  .ok "Map{Str(k): Seq[U8(1), Some(String(s)), Unit], U64(2): Newtype(Map{Bool(false): Seq[]}), String(e): Map{}}"
+#guard deBufferAny (.newtype nested) ==
+  .ok "Newtype(Map{Str(k): Seq[U8(1), Some(String(s)), Unit], U64(2): Newtype(Map{Bool(false): Seq[]}), String(e): Map{}})"
+
+/-! `errors` -/
+def enumInput : String := "untagged and internally tagged enums do not support enum input"
+#guard deBuffer (.enumV "A") == .err enumInput
+#guard deBufferAny (.seq [.u8 1, .enumV "A"]) == .err enumInput
+#guard deBuffer (.i128 5) == .err "invalid type: integer `5` as i128, expected any value"
+#guard deBuffer (.u128 340282366920938463463374607431768211455) ==
+  .err "invalid type: integer `340282366920938463463374607431768211455` as u128, expected any value"
+#guard deBuffer .bad == .err "bad value"
+#guard deBuffer (.seq [.u8 1, .bad, .u8 2]) == .err "bad value"
+#guard deBuffer (.map [(.bad, .u8 1)]) == .err "bad value"
+#guard deBuffer (.map [(.u8 1, .u8 2), (.u8 3, .bad)]) == .err "bad value"
+#guard deBuffer (.opt (some (.seq [.bad]))) == .err "bad value"
+#guard deBufferAny (.newtype (.map [(.unit, .i128 (-1))])) ==
+  .err "invalid type: integer `-1` as i128, expected any value"
+
+/-! The nesting bound is explicit: below the nesting depth of a value there is no result. -/
+#guard (out (buffer (valueDe 0) (.u8 1))).map describe == .none
+#guard (out (buffer (valueDe 1) (.u8 1))).map describe == .ok "U8(1)"
+#guard (out (buffer (valueDe 6) nested)).map describe == .none
+#guard (out (buffer (valueDe 7) nested)).map describe ==
+  .ok "Map{Str(k): Seq[U8(1), Some(String(s)), Unit], U64(2): Newtype(Map{Bool(false): Seq[]}), String(e): Map{}}"
+
+/-! The knot of `ContentVisitor`'s `DeserializeSeed` is its level-wise construction (`rfl`); the
+    standard axioms come from the `partial_fixpoint` loops over the elements and entries. -/
+/-- info: 'Aeneas.Std.serde.private.de.content.DeserializeSeedContentVisitor.wrap_level' depends on axioms: [propext,
+ Classical.choice,
+ Quot.sound] -/
+#guard_msgs in #print axioms serde.private.de.content.DeserializeSeedContentVisitor.wrap_level
+
+end serde_content.checks
