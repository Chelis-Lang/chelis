+import FlattenNextBack.FlattenNextBack
+
+/-! Evaluate the model of `tests/src/flatten-next-back.rs` on the inputs of its `native` test
+    module and compare with the native results, including the iterator given back by `pull_ops`
+    (every consumer continues it) and the call counter given back by `flat_map_pull`. -/
+namespace flatten_next_back.checks
+open Aeneas Aeneas.Std Result
+
+def u (x : Nat) : U32 := ⟨BitVec.ofNat _ x⟩
+def u8 (x : Nat) : U8 := ⟨BitVec.ofNat _ x⟩
+def us (n : Nat) : Usize := ⟨BitVec.ofNat _ n⟩
+def vec {α} (xs : List α) (h : xs.length ≤ Usize.max := by scalar_tac) : alloc.vec.Vec α := ⟨xs, h⟩
+def uv (xs : List Nat) (h : xs.length ≤ Usize.max := by scalar_tac) : alloc.vec.Vec U32 :=
+  ⟨xs.map u, by simpa using h⟩
+def sl {α} (xs : List α) (h : xs.length ≤ Usize.max := by scalar_tac) : Slice α := ⟨xs, h⟩
+def ops (xs : List Nat) : Slice U8 :=
+  if h : xs.length ≤ Usize.max then ⟨xs.map u8, by simpa using h⟩ else ⟨[], by simp⟩
+def arr2 (x y : Nat) : Array U32 2#usize := ⟨[u x, u y], by simp⟩
+def nats (v : alloc.vec.Vec U32) : List Nat := v.val.map (·.val)
+def opts (v : alloc.vec.Vec (Option U32)) : List (Option Nat) := v.val.map (·.map (·.val))
+def hint (h : Usize × Option Usize) : Nat × Option Nat := (h.1.val, h.2.map (·.val))
+
+/-- `vec![vec![1, 2], vec![], vec![3], vec![4, 5, 6]]` -/
+def g : Slice (alloc.vec.Vec U32) := sl [uv [1, 2], uv [], uv [3], uv [4, 5, 6]]
+
+-- constructor_for_shape: Env::lookup_constructors(name).rev()
+def bindings : alloc.vec.Vec Binding :=
+  vec [⟨u 10, u 2⟩, ⟨u 11, u 0⟩, ⟨u 12, u 2⟩, ⟨u 13, u 1⟩]
+def shapeOf (b : Option (alloc.vec.Vec Binding)) (want : Nat) : Option (Option Nat) :=
+  match constructor_for_shape b (u want) with | ok r => some (r.map (·.val)) | _ => none
+
+#guard shapeOf (some bindings) 2 == some (some 12)
+#guard shapeOf (some bindings) 0 == some (some 11)
+#guard shapeOf (some bindings) 7 == some (some 13)
+#guard shapeOf none 2 == some none
+#guard shapeOf (some (vec [])) 2 == some none
+
+-- folds
+def foldOf (gs : Slice (alloc.vec.Vec U32)) (o : List Nat) : Option (List (Option Nat) × List Nat) :=
+  match pull_fold gs (ops o) with | ok (p, r) => some (opts p, nats r) | _ => none
+def rfoldOf (gs : Slice (alloc.vec.Vec U32)) (o : List Nat) : Option (List (Option Nat) × List Nat) :=
+  match pull_rfold gs (ops o) with | ok (p, r) => some (opts p, nats r) | _ => none
+
+#guard foldOf g [] == some ([], [1, 2, 3, 4, 5, 6])
+#guard foldOf g [0, 1] == some ([some 1, some 6], [2, 3, 4, 5])
+#guard foldOf g [1, 0, 1, 1, 0] == some ([some 6, some 1, some 5, some 4, some 2], [3])
+#guard foldOf g [1, 1, 1, 1, 1, 1, 1, 0]
+  == some ([some 6, some 5, some 4, some 3, some 2, some 1, none, none], [])
+#guard rfoldOf g [0, 1] == some ([some 1, some 6], [5, 4, 3, 2])
+#guard rfoldOf g [0, 0, 0, 1] == some ([some 1, some 2, some 3, some 6], [5, 4])
+#guard rfoldOf g [1, 1, 1, 0] == some ([some 6, some 5, some 4, some 1], [3, 2])
+
+-- counts and hints
+#guard (match pull_count g (ops [0, 1, 1]) with | ok (p, n) => some (opts p, n.val) | _ => none)
+  == some ([some 1, some 6, some 5], 3)
+def hintOf (gs : Slice (alloc.vec.Vec U32)) (o : List Nat) :
+    Option (List (Option Nat) × (Nat × Option Nat)) :=
+  match pull_hint gs (ops o) with | ok (p, h) => some (opts p, hint h) | _ => none
+
+#guard hintOf g [] == some ([], (0, none))
+#guard hintOf g [0, 1] == some ([some 1, some 6], (3, none))
+#guard hintOf g [0, 1, 1, 1] == some ([some 1, some 6, some 5, some 4], (1, none))
+#guard hintOf g [0, 1, 1, 1, 1] == some ([some 1, some 6, some 5, some 4, some 3], (1, none))
+#guard hintOf (sl [uv [1, 2, 3], uv [4, 5, 6]]) [0, 1] == some ([some 1, some 6], (4, some 4))
+
+-- nth (advance_by), nth_back (advance_back_by)
+def nthOf (gs : Slice (alloc.vec.Vec U32)) (o : List Nat) (n : Nat) :
+    Option (List (Option Nat) × Option Nat × List Nat) :=
+  match pull_nth gs (ops o) (us n) with
+  | ok (p, x, r) => some (opts p, x.map (·.val), nats r) | _ => none
