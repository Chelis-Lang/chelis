+/-! ## Formats without a nesting bound
+
+A format that serde builds inside a data-side implementation (`ContentDeserializer`,
+`SeqAccessDeserializer`) is a Rust trait dictionary (`Ω`): it has no nesting bound of its own. Its
+runs are those of its levels: at a level too small for the nested calls a run reaches the
+diverging dictionaries of level `0` (`bottom`, `bottomData`), which no data-side code can observe,
+and every large enough level gives the same result. `limitFrom` takes the first level with a
+result.
+
+### The cut-monotonicity invariant
+
+`limitFrom` and `consumedRun` (`Serde/Content.lean`) take the first defined run of a search. A
+defined run gives the native result only under two conditions on the data side.
+
+- Strictness. Every data-side dictionary that a format receives is strict in `.div`. If a callee
+  gives `.div`, the caller gives `.div`. Aeneas-extracted code obeys this (monadic `do`, the
+  strict `loop`). The data-side models of this library bind with `←` and obey it too.
+- Cut. The level-`m` version of a dictionary is the same code, cut at depth `m`. The cut
+  dictionaries (`bottom`, `bottomError`, `bottomVisitor`, `bottomData`) diverge in every method.
+  The access with budget `k` of `consumedRun` is the same access, cut after `k` elements.
+
+Then the runs at increasing levels or budgets form a chain in the flat order (`IsChain`). For
+`m ≤ n`, the run `m` diverges or gives the result of the run `n`. Thus a defined run gives the
+result of every larger level, which is the native result. Only `limitFrom`, `consumedRun` and
+`loop` match on `.div`. A data-side model must not match on `.div`, because such a match can
+break strictness.
+
+The lemmas below and after `consumedRun` prove the consequences from `IsChain`. `IsChain` itself
+is the invariant of the library constructions (`Visitor.wrap`, `Deserialize.wrap`,
+`DeserializeSeed.wrap`, `embed`, `lvl`, `contentAt`, `tagOrContentAt`). It is not a theorem here.
+The levels of a dictionary have different types, and a proof needs a relation between the
+levels. -/
+
+/-- The first result of `f n`, `f (n + 1)`, ...: diverges when every level does. -/
+def limitFrom {α : Type} (f : Nat → Result α) (n : Nat) : Result α :=
+  match f n with
+  | .div => limitFrom f (n + 1)
+  | r => r
+partial_fixpoint
+
+/-- The values of `f` form a chain in the flat order. -/
+def IsChain {α : Type} (f : Nat → Result α) : Prop :=
+  -- A defined value stays.
+  ∀ m n, m ≤ n → f m = .div ∨ f m = f n
+
+/-- A defined level is the result. -/
+theorem limitFrom_of_ne_div {α : Type} (f : Nat → Result α) (n : Nat)
+    -- The level gives a result.
+    (h : f n ≠ .div) : limitFrom f n = f n := by
+  -- Unfold one step.
+  rw [limitFrom.eq_def]
+  split
+  · contradiction
+  · rfl
+
+/-- A diverging level goes one level up. -/
+theorem limitFrom_of_div {α : Type} (f : Nat → Result α) (n : Nat)
+    -- The level diverges.
+    (h : f n = .div) : limitFrom f n = limitFrom f (n + 1) := by
+  -- Unfold one step.
+  rw [limitFrom.eq_def, h]
+
+/-- On a chain, the result is every defined level. -/
+theorem limitFrom_eq_of_chain {α : Type} {f : Nat → Result α}
+    -- The chain.
+    (hc : IsChain f) {k n : Nat} (hkn : k ≤ n)
+    -- A level with a result.
+    (hn : f n ≠ .div) : limitFrom f k = f n := by
+  -- Induction on the distance.
+  induction hd : n - k generalizing k with
+
+  | zero =>
+    -- The level is the start.
+    rw [show k = n by omega]
+    exact limitFrom_of_ne_div f n hn
+
+  | succ d ih =>
+    -- The start diverges or not.
+    by_cases hk : f k = .div
+    · rw [limitFrom_of_div f k hk]
+      exact ih (by omega) (by omega)
+
+    -- The chain gives the value.
+    · rw [limitFrom_of_ne_div f k hk]
+      rcases hc k n hkn with h' | h'
+      · exact absurd h' hk
+      · exact h'
+
+/-- A defined result is the value of a level, also without a chain. -/
+theorem limitFrom_defined {α : Type} (f : Nat → Result α) (k : Nat)
+    -- The result does not diverge.
+    (h : limitFrom f k ≠ .div) :
+    ∃ n, k ≤ n ∧ f n = limitFrom f k := by
+  -- Fixpoint induction.
+  suffices key : ∀ k,
+      -- The result diverges or is a level.
+      limitFrom f k = .div ∨ ∃ n, k ≤ n ∧ f n = limitFrom f k by
+
+    -- Use the property at the start.
+    rcases key k with h' | h'
+    · exact absurd h' h
+    · exact h'
+
+  -- The motive.
+  refine limitFrom.fixpoint_induct f
+    (fun g => ∀ k, g k = .div ∨ ∃ n, k ≤ n ∧ f n = g k) ?_ ?_
+
+  -- The property is admissible.
+  · refine Lean.Order.admissible_pi_apply
+      (fun k r => r = .div ∨ ∃ n, k ≤ n ∧ f n = r) ?_
+    -- The property holds at the bottom.
+    intro k
+    exact Lean.Order.admissible_flatOrder (b := Result.div) _ (Or.inl rfl)
+
+  -- One step.
+  · intro g ih k
+    dsimp only
+    split
+    -- The level diverges.
+    · rcases ih (k + 1) with h' | ⟨n, hn, h'⟩
+      · exact Or.inl h'
+      -- A later level.
+      · exact Or.inr ⟨n, by omega, h'⟩
+    -- The level gives the result.
+    · exact Or.inr ⟨k, Nat.le_refl k, rfl⟩
+
+/-- A visitor whose methods diverge. -/
+def bottomVisitor (X : Fam) (V Value : Type) : VisitorStep X V Value :=
+  { expecting := fun _ _ => .div
+    visit_bool := fun _ _ _ => .div, visit_i64 := fun _ _ _ => .div
+    visit_i8 := fun _ _ _ => .div, visit_i16 := fun _ _ _ => .div
+    visit_i32 := fun _ _ _ => .div, visit_i128 := fun _ _ _ => .div
+    visit_u64 := fun _ _ _ => .div, visit_u8 := fun _ _ _ => .div
+    visit_u16 := fun _ _ _ => .div, visit_u32 := fun _ _ _ => .div
+    visit_u128 := fun _ _ _ => .div, visit_f64 := fun _ _ _ => .div
+    visit_f32 := fun _ _ _ => .div, visit_str := fun _ _ _ => .div
+    visit_char := fun _ _ _ => .div, visit_borrowed_str := fun _ _ _ => .div
+    visit_string := fun _ _ _ => .div, visit_bytes := fun _ _ _ => .div
+    visit_borrowed_bytes := fun _ _ _ => .div, visit_byte_buf := fun _ _ _ => .div
+    visit_none := fun _ _ => .div, visit_some := fun _ _ _ => .div
+    visit_unit := fun _ _ => .div, visit_newtype_struct := fun _ _ _ => .div
+    visit_seq := fun _ _ _ => .div, visit_map := fun _ _ _ => .div
+    visit_enum := fun _ _ _ => .div }
+
+/-- The data side above level `0`: dictionaries whose methods diverge. -/
+def bottomData (X : Fam) : Fam.Hom (DeAt 0) (Step X) where
+  deserialize := fun _ => ⟨fun _ _ => .div⟩
+  seed := fun _ => ⟨fun _ _ _ => .div⟩
+  visitor := fun {V Value} _ => bottomVisitor X V Value
+
+/-- A data-side dictionary of level `n` at level `m`: the same dictionary with the levels of its
+    nested formats adjusted, cut below level `n` (the dictionaries it builds for nested values
+    diverge `n` levels down). -/
+def lvl : (n m : Nat) → Fam.Hom (DeAt n) (DeAt m)
+  | _, 0 => ⟨fun _ => PUnit.unit, fun _ => PUnit.unit, fun _ => PUnit.unit⟩
+  | 0, _ + 1 => bottomData _
+  | n + 1, m + 1 => (lvl n m).step
+
+/-- A data-side dictionary of level `n` at every level. -/
+def embed (n : Nat) : Fam.Hom (DeAt n) Ω where
+  deserialize := fun d => ⟨fun m => (lvl n m).deserialize d⟩
+  seed := fun d => ⟨fun m => (lvl n m).seed d⟩
+  visitor := fun d => ⟨fun m => (lvl n m).visitor d⟩
+
+/-- The dictionaries of a Rust format at every level of the knot (a `FormatProgram`'s `level`, or
+    dictionaries built level by level because the format itself calls data-side implementations,
+    e.g. `ContentDeserializer`'s `unit_variant`). -/
+abbrev FormatLevels (τ : FormatTypes) := (n : Nat) → τ.Dicts (DeAt n)
+
+/-- The deserializer `i` of a format as a Rust trait dictionary: each method runs at the first
+    level (from `1`) with a result. The error dictionary is the format's (level `0` is `bottom`). -/
+def FormatLevels.limit {τ : FormatTypes} (lv : FormatLevels τ) (i : τ.ιD)
+    (errInst : serde_core.de.Error (τ.DError i)) :
+    serde_core.de.Deserializer (τ.D i) (τ.DError i) :=
+  let enc := fun n => ((lv n).des i).map (proj n)
+  { serde_coredeErrorInst := errInst
+    deserialize_any := fun v self x => limitFrom (fun n => (enc n).deserialize_any v self x) 1
+    deserialize_bool := fun v self x => limitFrom (fun n => (enc n).deserialize_bool v self x) 1
+    deserialize_i8 := fun v self x => limitFrom (fun n => (enc n).deserialize_i8 v self x) 1
+    deserialize_i16 := fun v self x => limitFrom (fun n => (enc n).deserialize_i16 v self x) 1
+    deserialize_i32 := fun v self x => limitFrom (fun n => (enc n).deserialize_i32 v self x) 1
+    deserialize_i64 := fun v self x => limitFrom (fun n => (enc n).deserialize_i64 v self x) 1
+    deserialize_i128 := fun v self x => limitFrom (fun n => (enc n).deserialize_i128 v self x) 1
+    deserialize_u8 := fun v self x => limitFrom (fun n => (enc n).deserialize_u8 v self x) 1
+    deserialize_u16 := fun v self x => limitFrom (fun n => (enc n).deserialize_u16 v self x) 1
+    deserialize_u32 := fun v self x => limitFrom (fun n => (enc n).deserialize_u32 v self x) 1
+    deserialize_u64 := fun v self x => limitFrom (fun n => (enc n).deserialize_u64 v self x) 1
+    deserialize_u128 := fun v self x => limitFrom (fun n => (enc n).deserialize_u128 v self x) 1
+    deserialize_f32 := fun v self x => limitFrom (fun n => (enc n).deserialize_f32 v self x) 1
+    deserialize_f64 := fun v self x => limitFrom (fun n => (enc n).deserialize_f64 v self x) 1
+    deserialize_char := fun v self x => limitFrom (fun n => (enc n).deserialize_char v self x) 1
+    deserialize_str := fun v self x => limitFrom (fun n => (enc n).deserialize_str v self x) 1
+    deserialize_string := fun v self x =>
+      limitFrom (fun n => (enc n).deserialize_string v self x) 1
+    deserialize_bytes := fun v self x => limitFrom (fun n => (enc n).deserialize_bytes v self x) 1
+    deserialize_byte_buf := fun v self x =>
+      limitFrom (fun n => (enc n).deserialize_byte_buf v self x) 1
+    deserialize_option := fun v self x =>
+      limitFrom (fun n => (enc n).deserialize_option v self x) 1
+    deserialize_unit := fun v self x => limitFrom (fun n => (enc n).deserialize_unit v self x) 1
+    deserialize_unit_struct := fun v self name x =>
+      limitFrom (fun n => (enc n).deserialize_unit_struct v self name x) 1
+    deserialize_newtype_struct := fun v self name x =>
+      limitFrom (fun n => (enc n).deserialize_newtype_struct v self name x) 1
+    deserialize_seq := fun v self x => limitFrom (fun n => (enc n).deserialize_seq v self x) 1
+    deserialize_tuple := fun v self len x =>
+      limitFrom (fun n => (enc n).deserialize_tuple v self len x) 1
+    deserialize_tuple_struct := fun v self name len x =>
+      limitFrom (fun n => (enc n).deserialize_tuple_struct v self name len x) 1
+    deserialize_map := fun v self x => limitFrom (fun n => (enc n).deserialize_map v self x) 1
+    deserialize_struct := fun v self name fields x =>
+      limitFrom (fun n => (enc n).deserialize_struct v self name fields x) 1
+    deserialize_enum := fun v self name variants x =>
+      limitFrom (fun n => (enc n).deserialize_enum v self name variants x) 1
+    deserialize_identifier := fun v self x =>
+      limitFrom (fun n => (enc n).deserialize_identifier v self x) 1
+    deserialize_ignored_any := fun v self x =>
+      limitFrom (fun n => (enc n).deserialize_ignored_any v self x) 1
+    is_human_readable := fun self => limitFrom (fun n => (enc n).is_human_readable self) 1
+    __deserialize_content_v1 := fun v self x =>
+      limitFrom (fun n => (enc n).__deserialize_content_v1 v self x) 1 }
+
 end serde_core.de
 
 end Aeneas.Std
