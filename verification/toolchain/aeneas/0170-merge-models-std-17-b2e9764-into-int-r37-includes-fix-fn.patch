index 0000000..a0e37bb
--- /dev/null
+++ b/tests/src/str-char-array-pattern.rs
@@ -0,0 +1,95 @@
+//@ [!lean] skip
+//@ [lean] subdir=StrCharArrayPattern
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! `[char; N]` string patterns (core `Pattern for [char; N]`, searcher `CharArraySearcher`: a
+//! char matches when the array contains it), as chelis-types uses one
+//! (`infer/expr_pattern.rs` LiteralPatternAtom::rendered: a printed float gets a `.0` suffix
+//! unless it contains one of `.eEni`), through the forward (`contains`, `starts_with`, `split`,
+//! `trim_start_matches`) and reverse (`rfind`, `ends_with`, `rsplit_once`) pattern consumers,
+//! with multi-byte chars. StrCharArrayPattern/Checks.lean compares the model with the native
+//! results asserted in the native test module.
+
+/// `LiteralPatternAtom::rendered` for a printed float.
+pub fn rendered(printed: &str) -> String {
+    if printed.contains(['.', 'e', 'E', 'n', 'i']) {
+        printed.to_string()
+    } else {
+        let mut out = printed.to_string();
+        out.push_str(".0");
+        out
+    }
+}
+
+pub fn starts_with_sign(s: &str) -> bool {
+    s.starts_with(['+', '-', '→'])
+}
+
+pub fn ends_with_unit(s: &str) -> bool {
+    s.ends_with(['s', 'é'])
+}
+
+pub fn fields(s: &str) -> Vec<&str> {
+    s.split([',', ';', 'é']).collect()
+}
+
+pub fn trim_signs(s: &str) -> &str {
+    s.trim_start_matches(['+', '-', '→'])
+}
+
+pub fn last_sep(s: &str) -> Option<usize> {
+    s.rfind([',', 'é'])
+}
+
+pub fn split_last(s: &str) -> Option<(&str, &str)> {
+    s.rsplit_once([',', 'é'])
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn renders() {
+        assert_eq!(rendered("1"), "1.0");
+        assert_eq!(rendered("1.5"), "1.5");
+        assert_eq!(rendered("1e10"), "1e10");
+        assert_eq!(rendered("inf"), "inf");
+        assert_eq!(rendered("NaN"), "NaN.0");
+        assert_eq!(rendered("-42"), "-42.0");
+        assert_eq!(rendered(""), ".0");
+    }
+
+    #[test]
+    fn prefixes_and_suffixes() {
+        assert!(starts_with_sign("-1"));
+        assert!(starts_with_sign("→x"));
+        assert!(!starts_with_sign("1-"));
+        assert!(!starts_with_sign(""));
+        assert!(ends_with_unit("10s"));
+        assert!(ends_with_unit("café"));
+        assert!(!ends_with_unit("s1"));
+        assert!(!ends_with_unit(""));
+    }
+
+    #[test]
+    fn splits() {
+        assert_eq!(fields("a,b;c"), vec!["a", "b", "c"]);
+        assert_eq!(fields("xéy,,z"), vec!["x", "y", "", "z"]);
+        assert_eq!(fields(""), vec![""]);
+        assert_eq!(fields(";"), vec!["", ""]);
+        assert_eq!(trim_signs("+-→5-"), "5-");
+        assert_eq!(trim_signs("x+"), "x+");
+        assert_eq!(trim_signs("--"), "");
+    }
+
+    #[test]
+    fn reverse() {
+        assert_eq!(last_sep("a,bécd"), Some(3));
+        assert_eq!(last_sep("a,b"), Some(1));
+        assert_eq!(last_sep("ab"), None);
+        assert_eq!(split_last("k,v"), Some(("k", "v")));
+        assert_eq!(split_last("a,bé"), Some(("a,b", "")));
+        assert_eq!(split_last("ab"), None);
+    }
+}
