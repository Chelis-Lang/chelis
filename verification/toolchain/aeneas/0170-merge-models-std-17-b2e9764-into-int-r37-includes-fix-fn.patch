+
+/-! Evaluate the model of `tests/src/thiserror-source` on the inputs of its native test module and
+    compare with the native results: `Error::source` of the derived impls (`Some(field.as_dyn_error())`
+    for a `#[from]` or `#[source]` field, the provided `None` otherwise) and the rendering of the
+    returned trait object through its `Display` dictionary (`source().map(|s| s.to_string())`). -/
+namespace thiserror_source.checks
+open Aeneas Aeneas.Std Result
+
+def u32 (n : Nat) : U32 := ⟨BitVec.ofNat _ n⟩
+
+/-- `ToString::to_string` (a `Display` returning an error panics). -/
+def toString' {T : Type} (d : core.fmt.Display T) (x : T) : Result String := do
+  let (status, f) ← d.fmt x {}
+  match status with
+  | .Ok () => ok f.output
+  | .Err _ => fail .panic
+
+/-- `source().map(|s| s.to_string())`: the trait object is rendered with its own dictionary, as
+    the call through the `dyn Error` vtable does. -/
+def sourceText (src : Result (Option (Dyn (fun _dyn => core.error.Error _dyn)))) :
+    Option (Option String) :=
+  match src with
+  | ok none => some none
+  | ok (some d) =>
+    match toString' d.inst.fmtDisplayInst d.value with
+    | ok s => some (some s)
+    | _ => none
+  | _ => none
+
+def parseSource (e : ParseError) : Option (Option String) :=
+  sourceText (ParseError.Insts.CoreErrorError.source e)
+
+def lexSource (e : LexError) : Option (Option String) :=
+  sourceText (core.error.Error.source.default LexError.Insts.CoreErrorError e)
+
+def authoringSource (e : AuthoringError) : Option (Option String) :=
+  sourceText (AuthoringError.Insts.CoreErrorError.source e)
+
+def text {T : Type} (d : core.fmt.Display T) (x : T) : Option String :=
+  match toString' d x with | ok s => some s | _ => none
+
+-- parse_error_sources
+#guard parseSource (.Lex (.BadChar (u32 200))) == some (some "bad char 200")
+#guard parseSource (.Lex .Eof) == some (some "unexpected end of input")
+#guard parseSource (.Missing (u32 3)) == some none
+#guard parseSource (.Wrapped (u32 9) (.BadChar (u32 9))) == some (some "bad char 9")
+#guard text ParseError.Insts.CoreFmtDisplay (.Lex (.BadChar (u32 200))) == some "bad char 200"
+#guard text ParseError.Insts.CoreFmtDisplay (.Wrapped (u32 9) .Eof) == some "wrapped at 9"
+
+-- lex_error_has_no_source
+#guard lexSource .Eof == some none
+#guard lexSource (.BadChar (u32 1)) == some none
+
+/-- `author(code).unwrap_err()`: the error's text, its source's text and its cause's source's
+    text. -/
+def authorErr (code : Nat) : Option (String × Option String × Option String) :=
+  match author (u32 code) with
+  | ok (.Err e) => do
+    let t ← text AuthoringError.Insts.CoreFmtDisplay e
+    let s ← authoringSource e
+    let c ← parseSource e.cause
+    some (t, s, c)
+  | _ => none
+
+-- authoring_error_sources
+#guard authorErr 0 ==
+  some ("authoring failed: step", some "unexpected end of input", some "unexpected end of input")
+#guard authorErr 7 == some ("authoring failed: step", some "missing close paren at 7", none)
+#guard authorErr 9 == some ("authoring failed: step", some "wrapped at 9", some "bad char 9")
+#guard (match author (u32 5) with | ok (.Ok v) => v.val == 6 | _ => false)
+
+/-- The variant and payloads of `parse(code)`'s error, or the value. -/
+def parseOf (code : Nat) : Option String :=
+  match parse (u32 code) with
+  | ok (.Ok v) => some s!"Ok({v.val})"
+  | ok (.Err (.Lex .Eof)) => some "Lex(Eof)"
+  | ok (.Err (.Lex (.BadChar c))) => some s!"Lex(BadChar({c.val}))"
+  | ok (.Err (.Missing c)) => some s!"Missing({c.val})"
+  | ok (.Err (.Wrapped c _)) => some s!"Wrapped({c.val})"
+  | _ => none
