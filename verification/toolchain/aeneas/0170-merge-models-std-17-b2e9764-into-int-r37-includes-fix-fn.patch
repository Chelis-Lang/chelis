diff --git a/tests/src/btreeset-debug.rs b/tests/src/btreeset-debug.rs
new file mode 100644
index 0000000..34a5085
--- /dev/null
+++ b/tests/src/btreeset-debug.rs
@@ -0,0 +1,110 @@
+//@ [!lean] skip
+//@ [lean] subdir=BtreesetDebug
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::option::{core::option::Option}
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! `impl Debug for BTreeSet` (`f.debug_set().entries(self.iter()).finish()`), as the derived
+//! `Debug` of chelis-types structures holding sets uses it: the elements in order between braces,
+//! one per indented line with `{:#?}`. BtreesetDebug/Checks.lean compares the model with the
+//! native results asserted in the native test module.
+use std::collections::BTreeSet;
+
+#[derive(Debug)]
+pub struct Scope {
+    pub depth: u32,
+    pub vars: BTreeSet<u32>,
+    pub names: BTreeSet<String>,
+}
+
+#[derive(Debug)]
+pub enum Tree {
+    Leaf(u32),
+    Node(BTreeSet<u32>, Vec<Tree>),
+}
+
+pub fn scope(depth: u32, vars: Vec<u32>, names: Vec<String>) -> Scope {
+    let mut set = BTreeSet::new();
+    for v in vars {
+        set.insert(v);
+    }
+    let mut named = BTreeSet::new();
+    for n in names {
+        named.insert(n);
+    }
+    Scope {
+        depth,
+        vars: set,
+        names: named,
+    }
+}
+
+pub fn render(s: &Scope) -> String {
+    format!("{:?}", s)
+}
+
+pub fn render_pretty(s: &Scope) -> String {
+    format!("{:#?}", s)
+}
+
+pub fn render_set(vars: Vec<u32>) -> String {
+    let mut set = BTreeSet::new();
+    for v in vars {
+        set.insert(v);
+    }
+    format!("{:?}", set)
+}
+
+pub fn render_tree(t: &Tree) -> String {
+    format!("{:?}", t)
+}
+
+pub fn node(vars: Vec<u32>, leaves: Vec<u32>) -> Tree {
+    let mut set = BTreeSet::new();
+    for v in vars {
+        set.insert(v);
+    }
+    let mut children = Vec::new();
+    for l in leaves {
+        children.push(Tree::Leaf(l));
+    }
+    Tree::Node(set, children)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn sets() {
+        assert_eq!(render_set(vec![]), "{}");
+        assert_eq!(render_set(vec![3, 1, 2, 3]), "{1, 2, 3}");
+        assert_eq!(render_set(vec![7]), "{7}");
+    }
+
+    #[test]
+    fn scopes() {
+        let s = scope(2, vec![5, 1], vec!["b".to_string(), "a\"q".to_string()]);
+        assert_eq!(
+            render(&s),
+            "Scope { depth: 2, vars: {1, 5}, names: {\"a\\\"q\", \"b\"} }"
+        );
+        assert_eq!(
+            render_pretty(&s),
+            "Scope {\n    depth: 2,\n    vars: {\n        1,\n        5,\n    },\n    names: {\n        \"a\\\"q\",\n        \"b\",\n    },\n}"
+        );
+        let e = scope(0, vec![], vec![]);
+        assert_eq!(render(&e), "Scope { depth: 0, vars: {}, names: {} }");
+        assert_eq!(
+            render_pretty(&e),
+            "Scope {\n    depth: 0,\n    vars: {},\n    names: {},\n}"
+        );
+    }
+
+    #[test]
+    fn trees() {
+        assert_eq!(
+            render_tree(&node(vec![4, 2], vec![9, 8])),
+            "Node({2, 4}, [Leaf(9), Leaf(8)])"
+        );
+        assert_eq!(render_tree(&node(vec![], vec![])), "Node({}, [])");
+    }
+}
diff --git a/tests/src/closure-phantom-params.rs b/tests/src/closure-phantom-params.rs
new file mode 100644
index 0000000..3807326
--- /dev/null
+++ b/tests/src/closure-phantom-params.rs
@@ -0,0 +1,130 @@
+//@ [!lean] skip
+//@ [lean] subdir=ClosurePhantomParams
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::option::{core::option::Option}
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+
+//! A closure without captures inherits the generics of its parent. Its state
+//! type uses none of them, and Lean extracts it as a reducible alias of Unit.
+//! An example is the const generic `DIGITS` of
+//! `impl<const DIGITS: usize> HexBits<DIGITS>`, as in the `HexBits` of
+//! chelis-types' wire_codec.rs.
+//!
+//! In `HexBits::parse`, the parent also has a lifetime parameter and a trait
+//! clause, as `Deserialize::deserialize`. Then the `call_once` of the closure
+//! gives the state `()` to its `call_mut`. Lean cannot infer `DIGITS` from
+//! `()`, and the generated module did not compile. The value is now
+//! `show (closure DIGITS ..) from ()`.
+//!
+//! `tests/lean/ClosurePhantomParams/Checks.lean` evaluates the model on the
+//! inputs of the `native` test module below.
+
+/// A source of text, as `serde::Deserializer<'de>`.
+pub trait Source<'de> {
+    type Error;
+    fn text(self) -> Result<String, Self::Error>;
+}
+
+/// A source which gives its text.
+pub struct Text(pub String);
+
+impl<'de> Source<'de> for Text {
+    type Error = u8;
+    fn text(self) -> Result<String, u8> {
+        Ok(self.0)
+    }
+}
+
+/// A source which fails.
+pub struct Missing(pub u8);
+
+impl<'de> Source<'de> for Missing {
+    type Error = u8;
+    fn text(self) -> Result<String, u8> {
+        Err(self.0)
+    }
+}
+
+pub struct HexBits<const DIGITS: usize>(String);
+
+impl<const DIGITS: usize> HexBits<DIGITS> {
+    /// Exactly `DIGITS` lowercase hexadecimal digits, as the `Deserialize` of
+    /// the production `HexBits`.
+    pub fn parse<'de, S: Source<'de>>(source: S) -> Result<Option<Self>, S::Error> {
+        let text = source.text()?;
+        if text.len() != DIGITS
+            || !text
+                .bytes()
+                .all(|digit| digit.is_ascii_digit() || (b'a'..=b'f').contains(&digit))
+        {
+            return Ok(None);
+        }
+        Ok(Some(Self(text)))
+    }
+
+    pub fn bits(self) -> u64 {
+        self.0.bytes().fold(0, |bits, digit| {
+            (bits << 4)
+                | u64::from(if digit <= b'9' {
+                    digit - b'0'
+                } else {
+                    digit - b'a' + 10
+                })
+        })
+    }
+}
+
+pub fn f16_bits(text: String) -> Result<Option<u64>, u8> {
+    Ok(HexBits::<4>::parse(Text(text))?.map(HexBits::bits))
+}
+
+pub fn f32_bits(text: String) -> Result<Option<u64>, u8> {
+    Ok(HexBits::<8>::parse(Text(text))?.map(HexBits::bits))
+}
+
+pub fn f16_bits_missing(code: u8) -> Result<Option<u64>, u8> {
+    Ok(HexBits::<4>::parse(Missing(code))?.map(HexBits::bits))
+}
+
+pub struct Tagged<T> {
+    pub tag: T,
+    pub weights: Vec<u8>,
+}
+
+impl<T> Tagged<T> {
+    pub fn all_positive(&self) -> bool {
+        self.weights.iter().all(|w| *w > 0)
+    }
+}
+
+pub fn positive_bool(tag: bool, weights: Vec<u8>) -> bool {
+    Tagged { tag, weights }.all_positive()
+}
+
+pub fn positive_u32(tag: u32, weights: Vec<u8>) -> bool {
+    Tagged { tag, weights }.all_positive()
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn hex_bits() {
+        assert_eq!(f16_bits("3c00".to_string()), Ok(Some(0x3c00)));
+        assert_eq!(f16_bits("7c01".to_string()), Ok(Some(0x7c01)));
+        assert_eq!(f16_bits("7C01".to_string()), Ok(None));
+        assert_eq!(f16_bits("3c0".to_string()), Ok(None));
+        assert_eq!(f16_bits("12g4".to_string()), Ok(None));
+        assert_eq!(f32_bits("bf800000".to_string()), Ok(Some(0xbf800000)));
+        assert_eq!(f32_bits("3c00".to_string()), Ok(None));
+        assert_eq!(f16_bits_missing(7), Err(7));
+    }
+
+    #[test]
+    fn tagged() {
+        assert!(positive_bool(true, vec![1, 2]));
+        assert!(!positive_bool(false, vec![1, 0]));
+        assert!(positive_u32(7, vec![]));
+        assert!(!positive_u32(7, vec![0]));
+    }
+}
diff --git a/tests/src/dyn-upcast-mut-borrow.rs b/tests/src/dyn-upcast-mut-borrow.rs
new file mode 100644
index 0000000..1c75299
--- /dev/null
+++ b/tests/src/dyn-upcast-mut-borrow.rs
@@ -0,0 +1,82 @@
+//@ [!lean] skip
+//@ [lean] subdir=DynUpcastMutBorrow
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+
+//! An unsized cast between two trait-object types which differ only by the
+//! (erased) region bound of the trait object, applied to a mutable borrow.
+//! An example is `&'a mut (dyn Counter + 'static)` to
+//! `&'a mut (dyn Counter + 'a)`. The cast changes no vtable and no type. The
+//! interpreter treats it as the identity on the moved borrow, as a `Use` of
+//! the operand. A value written through the upcast borrow must reach the owner
+//! of the trait object, and only that owner. `DynUpcastMutBorrow/Checks.lean`
+//! evaluates the model on the inputs of the `native` test module below.
+
+pub trait Counter {
+    fn bump(&mut self, k: u32) -> u32;
+    fn get(&self) -> u32;
+}
+
+pub struct Cell {
+    pub n: u32,
+}
+
+impl Counter for Cell {
+    fn bump(&mut self, k: u32) -> u32 {
+        self.n = self.n.wrapping_add(k);
+        self.n
+    }
+
+    fn get(&self) -> u32 {
+        self.n
+    }
+}
+
+/// The upcast alone: the result is the operand.
+pub fn shorten<'a>(x: &'a mut (dyn Counter + 'static)) -> &'a mut (dyn Counter + 'a) {
+    x
+}
+
+/// The upcast of the second of two borrows: the write-back reaches that owner
+/// only.
+pub fn second<'a>(
+    x: &'a mut (dyn Counter + 'static),
+    y: &'a mut (dyn Counter + 'static),
+) -> &'a mut (dyn Counter + 'a) {
+    let _ = x;
+    y
+}
+
+/// The upcast borrow returned in a tuple, after another component.
+pub fn hold<'a>(tag: u32, x: &'a mut (dyn Counter + 'static)) -> (u32, &'a mut (dyn Counter + 'a)) {
+    (tag, x)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn shorten_is_the_identity() {
+        let mut c = Cell { n: 7 };
+        assert_eq!(shorten(&mut c).bump(1), 8);
+        assert_eq!(c.n, 8);
+    }
+
+    #[test]
+    fn second_writes_its_owner_only() {
+        let mut c = Cell { n: 1 };
+        let mut e = Cell { n: 20 };
+        assert_eq!(second(&mut c, &mut e).bump(5), 25);
+        assert_eq!((c.n, e.n), (1, 25));
+    }
+
+    #[test]
+    fn hold_writes_the_owner() {
+        let mut c = Cell { n: u32::MAX };
+        let (tag, d) = hold(4, &mut c);
+        assert_eq!(tag, 4);
+        assert_eq!(d.bump(1), 0);
+        assert_eq!(c.n, 0);
+    }
+}
diff --git a/tests/src/flatten-next-back.rs b/tests/src/flatten-next-back.rs
new file mode 100644
index 0000000..d212a60
--- /dev/null
+++ b/tests/src/flatten-next-back.rs
@@ -0,0 +1,263 @@
+//@ [!lean] skip
+//@ [lean] subdir=FlattenNextBack
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::option::{core::option::Option}
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! `DoubleEndedIterator` of `Flatten` and `FlatMap` (core `FlattenCompat`: a front inner, the
+//! fused outer, a back inner) as chelis-types uses it (`Env::lookup_constructors(name).rev()` in
+//! `infer/common.rs` constructor_for_shape: `Option<&Vec<_>>::into_iter().flatten().map(..)`
+//! walked from the back). Mixed `next`/`next_back` pulls through a borrowed iterator (given back
+//! to the caller) are followed by each consumer of both directions: every one of them consumes
+//! the front inner, then the outer, then the back inner (the back ones in the opposite order).
+//! `FlatMap` shows the mapper's calls; `Option` inners are `OneShot` (front and back unused);
+//! `&[T; N]` inners have a constant size (`size_hint`). FlattenNextBack/Checks.lean compares the
+//! model with the native results asserted in the native test module.
+
+use std::iter::Flatten;
+use std::slice::Iter;
+
+pub struct Binding {
+    pub owner: u32,
+    pub fields: u32,
+}
+
+/// `Env::lookup_constructors`: every candidate in declaration order.
+pub fn lookup(bindings: Option<&Vec<Binding>>) -> impl DoubleEndedIterator<Item = (u32, u32)> + '_ {
+    bindings.into_iter().flatten().map(|binding| (binding.owner, binding.fields))
+}
+
+/// `constructor_for_shape`: the latest candidate whose shape matches, else the latest one.
+pub fn constructor_for_shape(bindings: Option<&Vec<Binding>>, want: u32) -> Option<u32> {
+    let mut fallback = None;
+    for (owner, fields) in lookup(bindings).rev() {
+        fallback.get_or_insert(owner);
+        if fields == want {
+            return Some(owner);
+        }
+    }
+    fallback
+}
+
+/// Pulls from the front (op 0) or the back (any other op) of a borrowed iterator.
+pub fn pull_ops(it: &mut Flatten<Iter<'_, Vec<u32>>>, ops: &[u8]) -> Vec<Option<u32>> {
+    let mut pulled = Vec::new();
+    for op in ops {
+        let item = if *op == 0 { it.next() } else { it.next_back() };
+        pulled.push(item.copied());
+    }
+    pulled
+}
+
+/// The rest in order (`fold`).
+pub fn pull_fold(groups: &[Vec<u32>], ops: &[u8]) -> (Vec<Option<u32>>, Vec<u32>) {
+    let mut it = groups.iter().flatten();
+    let pulled = pull_ops(&mut it, ops);
+    let rest = it.fold(Vec::new(), |mut acc, x| {
+        acc.push(*x);
+        acc
+    });
+    (pulled, rest)
+}
+
+/// The rest from the back (`rfold`).
+pub fn pull_rfold(groups: &[Vec<u32>], ops: &[u8]) -> (Vec<Option<u32>>, Vec<u32>) {
+    let mut it = groups.iter().flatten();
+    let pulled = pull_ops(&mut it, ops);
+    let rest = it.rfold(Vec::new(), |mut acc, x| {
+        acc.push(*x);
+        acc
+    });
+    (pulled, rest)
+}
+
+pub fn pull_count(groups: &[Vec<u32>], ops: &[u8]) -> (Vec<Option<u32>>, usize) {
+    let mut it = groups.iter().flatten();
+    let pulled = pull_ops(&mut it, ops);
+    (pulled, it.count())
+}
+
+pub fn pull_hint(groups: &[Vec<u32>], ops: &[u8]) -> (Vec<Option<u32>>, (usize, Option<usize>)) {
+    let mut it = groups.iter().flatten();
+    let pulled = pull_ops(&mut it, ops);
+    (pulled, it.size_hint())
+}
+
+/// Collects the rest in order with `next`.
+pub fn drain(it: &mut Flatten<Iter<'_, Vec<u32>>>) -> Vec<u32> {
+    let mut rest = Vec::new();
+    while let Some(x) = it.next() {
+        rest.push(*x);
+    }
+    rest
+}
+
+/// `nth` (`advance_by`), then the rest.
+pub fn pull_nth(groups: &[Vec<u32>], ops: &[u8], n: usize) -> (Vec<Option<u32>>, Option<u32>, Vec<u32>) {
+    let mut it = groups.iter().flatten();
+    let pulled = pull_ops(&mut it, ops);
+    let nth = it.nth(n).copied();
+    (pulled, nth, drain(&mut it))
+}
+
+/// `nth_back` (`advance_back_by`), then the rest.
+pub fn pull_nth_back(groups: &[Vec<u32>], ops: &[u8], n: usize) -> (Vec<Option<u32>>, Option<u32>, Vec<u32>) {
+    let mut it = groups.iter().flatten();
+    let pulled = pull_ops(&mut it, ops);
+    let nth = it.nth_back(n).copied();
+    (pulled, nth, drain(&mut it))
+}
+
+/// `find` (`try_fold`), then the rest.
+pub fn pull_find(groups: &[Vec<u32>], ops: &[u8], want: u32) -> (Vec<Option<u32>>, Option<u32>, Vec<u32>) {
+    let mut it = groups.iter().flatten();
+    let pulled = pull_ops(&mut it, ops);
+    let found = it.find(|x| **x >= want).copied();
+    (pulled, found, drain(&mut it))
+}
+
+/// `rfind` (`try_rfold`), then the rest.
+pub fn pull_rfind(groups: &[Vec<u32>], ops: &[u8], want: u32) -> (Vec<Option<u32>>, Option<u32>, Vec<u32>) {
+    let mut it = groups.iter().flatten();
+    let pulled = pull_ops(&mut it, ops);
+    let found = it.rfind(|x| **x >= want).copied();
+    (pulled, found, drain(&mut it))
+}
+
+/// `FlatMap` whose mapper counts its calls: pulls, then the rest from the back (`rfold`).
+pub fn flat_map_pull(groups: &[Vec<u32>], ops: &[u8], calls: &mut u32) -> (Vec<Option<u32>>, Vec<u32>) {
+    let mut it = groups.iter().flat_map(|g| {
+        *calls += 1;
+        g.iter()
+    });
+    let mut pulled = Vec::new();
+    for op in ops {
+        let item = if *op == 0 { it.next() } else { it.next_back() };
+        pulled.push(item.copied());
+    }
+    let rest = it.rfold(Vec::new(), |mut acc, x| {
+        acc.push(*x);
+        acc
+    });
+    (pulled, rest)
+}
+
+/// `Option` inners (`OneShot`): pulls, then the rest from the back (`rev().collect`).
+pub fn options_pull(items: Vec<Option<u32>>, ops: &[u8]) -> (Vec<Option<u32>>, Vec<u32>) {
+    let mut it = items.into_iter().flatten();
+    let mut pulled = Vec::new();
+    for op in ops {
+        pulled.push(if *op == 0 { it.next() } else { it.next_back() });
+    }
+    (pulled, it.rev().collect())
+}
+
+/// `&[T; 2]` inners (constant size): pulls, then `size_hint` and the rest.
+pub fn pairs_pull(pairs: &[[u32; 2]], ops: &[u8]) -> (Vec<Option<u32>>, (usize, Option<usize>), Vec<u32>) {
+    let mut it = pairs.iter().flatten();
+    let mut pulled = Vec::new();
+    for op in ops {
+        let item = if *op == 0 { it.next() } else { it.next_back() };
+        pulled.push(item.copied());
+    }
+    let hint = it.size_hint();
+    (pulled, hint, it.copied().collect())
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    fn groups() -> Vec<Vec<u32>> {
+        vec![vec![1, 2], vec![], vec![3], vec![4, 5, 6]]
+    }
+
+    #[test]
+    fn constructors() {
+        let b = |owner, fields| Binding { owner, fields };
+        let bindings = vec![b(10, 2), b(11, 0), b(12, 2), b(13, 1)];
+        assert_eq!(constructor_for_shape(Some(&bindings), 2), Some(12));
+        assert_eq!(constructor_for_shape(Some(&bindings), 0), Some(11));
+        assert_eq!(constructor_for_shape(Some(&bindings), 7), Some(13));
+        assert_eq!(constructor_for_shape(None, 2), None);
+        assert_eq!(constructor_for_shape(Some(&vec![]), 2), None);
+    }
+
+    #[test]
+    fn folds() {
+        let g = groups();
+        assert_eq!(pull_fold(&g, &[]), (vec![], vec![1, 2, 3, 4, 5, 6]));
+        assert_eq!(pull_fold(&g, &[0, 1]), (vec![Some(1), Some(6)], vec![2, 3, 4, 5]));
+        assert_eq!(pull_fold(&g, &[1, 0, 1, 1, 0]), (vec![Some(6), Some(1), Some(5), Some(4), Some(2)], vec![3]));
+        assert_eq!(
+            pull_fold(&g, &[1, 1, 1, 1, 1, 1, 1, 0]),
+            (vec![Some(6), Some(5), Some(4), Some(3), Some(2), Some(1), None, None], vec![])
+        );
+        assert_eq!(pull_rfold(&g, &[0, 1]), (vec![Some(1), Some(6)], vec![5, 4, 3, 2]));
+        assert_eq!(pull_rfold(&g, &[0, 0, 0, 1]), (vec![Some(1), Some(2), Some(3), Some(6)], vec![5, 4]));
+        assert_eq!(pull_rfold(&g, &[1, 1, 1, 0]), (vec![Some(6), Some(5), Some(4), Some(1)], vec![3, 2]));
+    }
+
+    #[test]
+    fn counts_and_hints() {
+        let g = groups();
+        assert_eq!(pull_count(&g, &[0, 1, 1]), (vec![Some(1), Some(6), Some(5)], 3));
+        assert_eq!(pull_hint(&g, &[]), (vec![], (0, None)));
+        assert_eq!(pull_hint(&g, &[0, 1]), (vec![Some(1), Some(6)], (3, None)));
+        assert_eq!(pull_hint(&g, &[0, 1, 1, 1]), (vec![Some(1), Some(6), Some(5), Some(4)], (1, None)));
+        assert_eq!(pull_hint(&g, &[0, 1, 1, 1, 1]), (vec![Some(1), Some(6), Some(5), Some(4), Some(3)], (1, None)));
+        let two = vec![vec![1, 2, 3], vec![4, 5, 6]];
+        assert_eq!(pull_hint(&two, &[0, 1]), (vec![Some(1), Some(6)], (4, Some(4))));
+    }
+
+    #[test]
+    fn nths() {
+        let g = groups();
+        assert_eq!(pull_nth(&g, &[1], 2), (vec![Some(6)], Some(3), vec![4, 5]));
+        assert_eq!(pull_nth(&g, &[1, 0], 3), (vec![Some(6), Some(1)], Some(5), vec![]));
+        assert_eq!(pull_nth(&g, &[1, 0], 4), (vec![Some(6), Some(1)], None, vec![]));
+        assert_eq!(pull_nth_back(&g, &[0], 2), (vec![Some(1)], Some(4), vec![2, 3]));
+        assert_eq!(pull_nth_back(&g, &[0, 1], 3), (vec![Some(1), Some(6)], Some(2), vec![]));
+        assert_eq!(pull_nth_back(&g, &[1, 1, 1, 0], 0), (vec![Some(6), Some(5), Some(4), Some(1)], Some(3), vec![2]));
+    }
+
+    #[test]
+    fn finds() {
+        let g = groups();
+        assert_eq!(pull_find(&g, &[1], 4), (vec![Some(6)], Some(4), vec![5]));
+        assert_eq!(pull_find(&g, &[1, 1], 6), (vec![Some(6), Some(5)], None, vec![]));
+        assert_eq!(pull_find(&g, &[0, 1, 1, 1], 2), (vec![Some(1), Some(6), Some(5), Some(4)], Some(2), vec![3]));
+        assert_eq!(pull_rfind(&g, &[0], 3), (vec![Some(1)], Some(6), vec![2, 3, 4, 5]));
+        assert_eq!(pull_rfind(&g, &[0, 0, 1], 0), (vec![Some(1), Some(2), Some(6)], Some(5), vec![3, 4]));
+        assert_eq!(pull_rfind(&g, &[1, 1, 1, 0], 2), (vec![Some(6), Some(5), Some(4), Some(1)], Some(3), vec![2]));
+        assert_eq!(pull_rfind(&g, &[1, 1, 1, 0], 7), (vec![Some(6), Some(5), Some(4), Some(1)], None, vec![]));
+    }
+
+    #[test]
+    fn flat_maps() {
+        let g = groups();
+        let mut calls = 0;
+        assert_eq!(flat_map_pull(&g, &[0, 1], &mut calls), (vec![Some(1), Some(6)], vec![5, 4, 3, 2]));
+        assert_eq!(calls, 4);
+        let mut calls = 100;
+        assert_eq!(flat_map_pull(&g, &[1, 1, 1, 1, 0], &mut calls), (vec![Some(6), Some(5), Some(4), Some(3), Some(1)], vec![2]));
+        assert_eq!(calls, 104);
+        let mut calls = 0;
+        assert_eq!(flat_map_pull(&g, &[1], &mut calls), (vec![Some(6)], vec![5, 4, 3, 2, 1]));
+        assert_eq!(calls, 4);
+    }
+
+    #[test]
+    fn one_shots() {
+        let items = vec![Some(1), None, Some(2), Some(3), None, Some(4)];
+        assert_eq!(options_pull(items.clone(), &[1, 0, 1]), (vec![Some(4), Some(1), Some(3)], vec![2]));
+        assert_eq!(options_pull(items.clone(), &[0, 0, 0, 0, 0]), (vec![Some(1), Some(2), Some(3), Some(4), None], vec![]));
+        assert_eq!(options_pull(items, &[]), (vec![], vec![4, 3, 2, 1]));
+    }
+
+    #[test]
+    fn pairs() {
+        let pairs = [[1, 2], [3, 4], [5, 6]];
+        assert_eq!(pairs_pull(&pairs, &[]), (vec![], (6, Some(6)), vec![1, 2, 3, 4, 5, 6]));
+        assert_eq!(pairs_pull(&pairs, &[0, 1]), (vec![Some(1), Some(6)], (4, Some(4)), vec![2, 3, 4, 5]));
+        assert_eq!(pairs_pull(&pairs, &[1, 1, 1]), (vec![Some(6), Some(5), Some(4)], (3, Some(3)), vec![1, 2, 3]));
+    }
+}
