+    visit_i8 := fun _ _ x => ok (.Ok (.I8 x))
+    visit_i16 := fun _ _ x => ok (.Ok (.I16 x))
+    visit_i32 := fun _ _ x => ok (.Ok (.I32 x))
+    visit_i64 := fun _ _ x => ok (.Ok (.I64 x))
+    visit_u8 := fun _ _ x => ok (.Ok (.U8 x))
+    visit_u16 := fun _ _ x => ok (.Ok (.U16 x))
+    visit_u32 := fun _ _ x => ok (.Ok (.U32 x))
+    visit_u64 := fun _ _ x => ok (.Ok (.U64 x))
+    visit_f32 := fun _ _ x => ok (.Ok (.F32 x))
+    visit_f64 := fun _ _ x => ok (.Ok (.F64 x))
+    visit_char := fun _ _ x => ok (.Ok (.Char x))
+    visit_str := fun _ _ x => do ok (.Ok (.String (← Str.toString x)))
+    visit_borrowed_str := fun _ _ x => ok (.Ok (.Str x))
+    visit_string := fun _ _ x => ok (.Ok (.String x))
+    visit_bytes := fun _ _ x => ok (.Ok (.ByteBuf (alloc.slice.Slice.into_vec x)))
+    visit_borrowed_bytes := fun _ _ x => ok (.Ok (.Bytes x))
+    visit_byte_buf := fun _ _ x => ok (.Ok (.ByteBuf x))
+    visit_unit := fun _ _ => ok (.Ok .Unit)
+    visit_none := fun _ _ => ok (.Ok .None)
+    visit_some := fun inst _ de => do
+      match ← (contentSeedStep v).deserialize inst ⟨⟩ de with
+      | .Err e => ok (.Err e)
+      | .Ok c => ok (.Ok (.Some c))
+    visit_newtype_struct := fun inst _ de => do
+      match ← (contentSeedStep v).deserialize inst ⟨⟩ de with
+      | .Err e => ok (.Err e)
+      | .Ok c => ok (.Ok (.Newtype c))
