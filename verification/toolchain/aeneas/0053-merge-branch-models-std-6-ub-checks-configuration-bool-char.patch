   --
@@ -213,6 +218,28 @@ namespace Test
   #assert read_discriminant Foo3.Variant1 = 3#isize
   #assert read_discriminant Foo3.Variant2 = 4#isize
 
+  /- Two types with the same last name component: each instance is named after its
+     declaration (an anonymous instance would be `instDiscriminantSameIsize` for both). -/
+  namespace A
+  inductive Same where
+  | X
+  | Y
+  end A
+
+  namespace B
+  inductive Same where
+  | X
+  | Y
+  end B
