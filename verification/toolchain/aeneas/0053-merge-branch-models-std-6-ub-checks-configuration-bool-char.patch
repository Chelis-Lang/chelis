+//@ [!lean] skip
+//@ [lean] subdir=PrimitiveOrder
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::cmp --include {core::cmp::PartialOrd} --include {core::cmp::Ord}
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Core's primitive orderings. `impl Ord for bool`'s `cmp` switches on a
+//! signed difference (a negative literal pattern) and its impossible arm is
+//! `unreachable_unchecked`, guarded by the `ub_checks` build configuration
+//! (base: 'Unsupported operation: ub_checks<bool>'); its `min`/`max` are the
+//! non-short-circuiting `&`/`|` (base: 'Invalid inputs for binop'). `char`
+//! comparisons are primitive MIR comparisons and `Ord for char` is
+//! `three_way_compare`. `tests/lean/PrimitiveOrder/Checks.lean` evaluates the
+//! model on the inputs of the `native` test module below.
+use std::cmp::Ordering;
+
+pub fn bool_cmp(a: bool, b: bool) -> Ordering {
+    a.cmp(&b)
+}
+
+pub fn bool_min_max(a: bool, b: bool) -> (bool, bool) {
+    (a.min(b), a.max(b))
+}
+
+pub fn bool_bits(a: bool, b: bool) -> (bool, bool, bool) {
+    (a & b, a | b, a ^ b)
+}
+
+pub fn char_order(a: char, b: char) -> (bool, bool, bool, bool) {
+    (a < b, a <= b, a > b, a >= b)
+}
+
+pub fn char_cmp(a: char, b: char) -> Ordering {
+    a.cmp(&b)
+}
+
+pub fn sign(x: i32) -> u32 {
+    match x {
+        -1 => 0,
+        0 => 1,
+        1 => 2,
+        _ => 3,
+    }
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn orders() {
+        assert_eq!(bool_cmp(false, true), Ordering::Less);
+        assert_eq!(bool_cmp(true, false), Ordering::Greater);
+        assert_eq!(bool_cmp(true, true), Ordering::Equal);
+        assert_eq!(bool_min_max(false, true), (false, true));
+        assert_eq!(bool_bits(true, false), (false, true, true));
+        assert_eq!(bool_bits(true, true), (true, true, false));
+        assert_eq!(char_order('a', 'b'), (true, true, false, false));
+        assert_eq!(char_order('é', 'e'), (false, false, true, true));
+        assert_eq!(char_cmp('b', 'a'), Ordering::Greater);
+        assert_eq!(char_cmp('x', 'x'), Ordering::Equal);
+        assert_eq!(sign(-1), 0);
+        assert_eq!(sign(0), 1);
+        assert_eq!(sign(1), 2);
+        assert_eq!(sign(-2), 3);
+        assert_eq!(sign(i32::MIN), 3);
+    }
+}
