diff --git a/tests/src/closure-uncaptured-generics.rs b/tests/src/closure-uncaptured-generics.rs
new file mode 100644
index 0000000..d8b8638
--- /dev/null
+++ b/tests/src/closure-uncaptured-generics.rs
@@ -0,0 +1,67 @@
+//@ [!lean] skip
+//@ [lean] subdir=ClosureUncapturedGenerics
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::option::{core::option::Option}
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! A closure inherits all the generics of its parent function but only holds
+//! values of the types it captures. In `map_symbols`, generic over the
+//! `FnMut` resolver, the closure `|| self.clone()` captures `&Self` only;
+//! `bind` instantiates the resolver with a closure capturing `&mut u32`.
+//! Base: the type of `|| self.clone()` was considered to hold that mutable
+//! borrow, so the by-value `FnOnce` call in `Option::unwrap_or_else` had to
+//! give it back ('Generic call requires a region-dependent state ABI', core
+//! option.rs:1061; production: chelis-ir dag.rs `DimExpr::map_symbols`).
+//! `tests/lean/ClosureUncapturedGenerics/Checks.lean` evaluates the model on
+//! the inputs of the `native` test module below.
+#[derive(Clone, PartialEq, Debug)]
+pub enum DimExpr {
+    Concrete(usize),
+    Sym(u32),
+}
+
+impl DimExpr {
+    fn map_symbols<E>(
+        &self,
+        resolve: &mut impl FnMut(u32) -> Result<Option<usize>, E>,
+    ) -> Result<Self, E> {
+        match self {
+            Self::Concrete(v) => Ok(Self::Concrete(*v)),
+            Self::Sym(name) => Ok(resolve(*name)?
+                .map(Self::Concrete)
+                .unwrap_or_else(|| self.clone())),
+        }
+    }
+}
+
+/// Resolves the even symbols to their half and rejects the symbol 0,
+/// counting the lookups.
+pub fn bind(e: &DimExpr, count: &mut u32) -> Result<DimExpr, ()> {
+    e.map_symbols(&mut |name: u32| {
+        *count += 1;
+        if name == 0 {
+            Err(())
+        } else if name % 2 == 0 {
+            Ok(Some((name / 2) as usize))
+        } else {
+            Ok(None)
+        }
+    })
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    fn run(e: DimExpr, count: u32) -> (Result<DimExpr, ()>, u32) {
+        let mut count = count;
+        let r = bind(&e, &mut count);
+        (r, count)
+    }
+
+    #[test]
+    fn binds() {
+        assert_eq!(run(DimExpr::Concrete(5), 0), (Ok(DimExpr::Concrete(5)), 0));
+        assert_eq!(run(DimExpr::Sym(4), 0), (Ok(DimExpr::Concrete(2)), 1));
+        assert_eq!(run(DimExpr::Sym(3), 1), (Ok(DimExpr::Sym(3)), 2));
+        assert_eq!(run(DimExpr::Sym(0), 7), (Err(()), 8));
+    }
+}
