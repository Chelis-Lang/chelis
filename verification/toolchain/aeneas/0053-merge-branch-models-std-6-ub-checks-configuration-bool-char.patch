+def decode : Result (core.result.Result DimExpr Unit × U32) → Option (String × Nat)
+  | ok (.Ok (.Concrete v), count) => some (s!"Concrete {v.val}", count.val)
+  | ok (.Ok (.Sym n), count) => some (s!"Sym {n.val}", count.val)
+  | ok (.Err _, count) => some ("Err", count.val)
+  | _ => none
