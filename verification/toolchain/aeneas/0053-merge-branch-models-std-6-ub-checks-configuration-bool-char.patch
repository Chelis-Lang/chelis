diff --git a/backends/lean/Aeneas/Std/Core/Core.lean b/backends/lean/Aeneas/Std/Core/Core.lean
index abccefe..8dd56ee 100644
--- a/backends/lean/Aeneas/Std/Core/Core.lean
+++ b/backends/lean/Aeneas/Std/Core/Core.lean
@@ -22,6 +22,21 @@ def Bool.le (x y : Bool) : Bool := !x || y
 def Bool.ge (x y : Bool) : Bool := x || !y
 def Bool.gt (x y : Bool) : Bool := x && !y
 
+/-! Rust's non-short-circuiting logical operators on `bool` (MIR `BitAnd`,
+    `BitOr`, `BitXor`; e.g. `impl Ord for bool`'s `min` is `self & other` and
+    its `max` is `self | other`): both operands are evaluated. -/
+def Bool.bitand (x y : Bool) : Bool := x && y
+def Bool.bitor (x y : Bool) : Bool := x || y
+def Bool.bitxor (x y : Bool) : Bool := x != y
+
+/-! Rust's primitive ordered comparisons of `char` (MIR `Lt`/`Le`/`Ge`/`Gt`,
+    `impl PartialOrd for char`): the order of the Unicode scalar values, which
+    Lean's `Char` order (`Char.val : UInt32`) is. -/
+def Char.lt (x y : Char) : Bool := decide (x.val < y.val)
+def Char.le (x y : Char) : Bool := decide (x.val ≤ y.val)
+def Char.ge (x y : Char) : Bool := decide (y.val ≤ x.val)
+def Char.gt (x y : Char) : Bool := decide (y.val < x.val)
+
 namespace core
 
 @[rust_type "core::convert::Infallible"]
@@ -50,6 +65,29 @@ def convert.FromBox (T : Type) : convert.From T T := {
 @[simp, step_simps, rust_fun "core::hint::must_use" -canFail]
 def hint.must_use {T : Type} (value : T) : T := value
 
+/-- `core::intrinsics::ub_checks` (read by `core::ub_checks::check_language_ub`
+    and `check_library_ub`): whether the build runs the library's UB
+    precondition checks, `cfg!(ub_checks)`. It follows `debug_assertions`, so
+    native tests and debug builds run with the checks and release builds
+    without them. Aeneas translates the MIR `NullaryOp(UbChecks)` to this
+    constant.
+
+    This is a configuration parameter, not a modeled value. It is opaque: no
+    proof can depend on its value, so every theorem about extracted code holds
+    for both configurations. Compiled evaluation (`#eval`, `#guard`) uses the
+    default `false`; such evidence never counts as proof. Trust boundary:
+    verification/trusted_base.json. -/
+opaque intrinsics.ub_checks : Bool
+
+/-- The precondition check of `core::hint::unreachable_unchecked`
+    (core/src/hint.rs): `assert_unsafe_precondition!(check_language_ub,
+    "hint::unreachable_unchecked must never be reached", () => false)` defines
+    it with the condition `false`, so it always calls `panic_nounwind`, which
+    aborts. It only runs when `ub_checks` holds; otherwise the next statement
+    is the undefined behavior of `intrinsics::unreachable`. -/
+@[rust_fun "core::hint::unreachable_unchecked::precondition_check"]
+def hint.unreachable_unchecked.precondition_check : Result Unit := fail .panic
+
 @[simp, step_simps, rust_fun "core::bool::{bool}::then_some" -canFail]
 def bool.then_some {T : Type} (condition : Bool) (value : T) :
     Option T × (Option T → T) :=
