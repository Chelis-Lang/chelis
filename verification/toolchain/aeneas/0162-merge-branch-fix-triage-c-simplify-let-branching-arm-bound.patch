diff --git a/tests/src/dyn-error-source.rs b/tests/src/dyn-error-source.rs
new file mode 100644
index 0000000..07ae9a4
--- /dev/null
+++ b/tests/src/dyn-error-source.rs
@@ -0,0 +1,74 @@
+//@ [!lean] skip
+//@ [lean] subdir=DynErrorSource
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! The `Error::source` which `thiserror` derives for a `#[from]` field:
+//! `AsDynError::as_dyn_error` returns `&(dyn Error + 'a)`, which `source`
+//! returns as `&(dyn Error + 'static)`. The unsized cast between the two trait
+//! objects changes only an (erased) region: it is the identity, including the
+//! borrow of the field, but the interpreter used to reject it because the value
+//! holds a borrow ("Unsized cast between dynamic traits: unimplemented case").
+//! `DynErrorSource/Checks.lean` evaluates the model on the inputs of the
+//! `native` test module below.
+
+use std::error::Error;
+use std::fmt;
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Inner(pub u32);
+
+impl fmt::Display for Inner {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(f, "inner {}", self.0)
+    }
+}
+
+impl Error for Inner {}
+
+/// `thiserror`'s `AsDynError`.
+pub trait AsDynError<'a> {
+    fn as_dyn_error(&self) -> &(dyn Error + 'a);
+}
+
+impl<'a, T: Error + 'a> AsDynError<'a> for T {
+    fn as_dyn_error(&self) -> &(dyn Error + 'a) {
+        self
+    }
+}
+
+#[derive(Debug)]
+pub enum Outer {
+    Wrapped(Inner),
+    Plain,
+}
+
+impl fmt::Display for Outer {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        write!(f, "outer")
+    }
+}
+
+/// As derived by `thiserror` for `Wrapped(#[from] Inner)`.
+impl Error for Outer {
+    fn source(&self) -> Option<&(dyn Error + 'static)> {
+        match self {
+            Outer::Wrapped(source) => Some(source.as_dyn_error()),
+            Outer::Plain => None,
+        }
+    }
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn wrapped_has_a_source() {
+        assert!(Outer::Wrapped(Inner(3)).source().is_some());
+    }
+
+    #[test]
+    fn plain_has_no_source() {
+        assert!(Outer::Plain.source().is_none());
+    }
+}
diff --git a/tests/src/let-branching-arm-vars.rs b/tests/src/let-branching-arm-vars.rs
new file mode 100644
index 0000000..ac78c44
--- /dev/null
+++ b/tests/src/let-branching-arm-vars.rs
@@ -0,0 +1,94 @@
+//@ [!lean] skip
+//@ [lean] subdir=LetBranchingArmVars
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::option::{core::ops::try_trait::Try} --include core::option::{core::ops::try_trait::FromResidual}
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! A `?` on a match whose arms are all `Some(..)` or panics (the shape of
+//! `chelis_types::TypeVarRestriction::intersect`). The joined match binds the
+//! family in the pattern of its only non-failing arm; `simplify_let_branching`
+//! used to lift that arm's bound value out of the match, leaving dangling
+//! variables (the `-checks` sanity check of `PureUtils` stopped the
+//! translation). A value which refers to a variable bound inside the bound
+//! expression is not a possible output of the let-binding.
+//! `LetBranchingArmVars/Checks.lean` evaluates the model on the inputs of the
+//! `native` test module below, including the panicking ones.
+
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+pub enum R {
+    AF,
+    AI,
+    AN,
+    FV,
+    IV,
+    NV,
+    Other,
+}
+
+impl R {
+    fn fam(self) -> Self {
+        match self {
+            R::FV => R::AF,
+            R::IV => R::AI,
+            R::NV => R::AN,
+            x => x,
+        }
+    }
+
+    fn is_value(self) -> bool {
+        matches!(self, R::FV | R::IV | R::NV)
+    }
+
+    fn for_value(self) -> Self {
+        match self.fam() {
+            R::AF => R::FV,
+            R::AI => R::IV,
+            R::AN => R::NV,
+            _ => unreachable!("not a family"),
+        }
+    }
+
+    /// The restriction admitting the types admitted by both, if any.
+    pub fn intersect(self, other: R) -> Option<R> {
+        use R::{AF, AI, AN};
+        let family = match (self.fam(), other.fam()) {
+            (AF, AF) => Some(AF),
+            (AI, AI) => Some(AI),
+            (AN, AN) => Some(AN),
+            (AN, AF) | (AF, AN) => Some(AF),
+            (AN, AI) | (AI, AN) => Some(AI),
+            (AF, AI) | (AI, AF) => None,
+            _ => unreachable!("not a family"),
+        }?;
+        Some(if self.is_value() && other.is_value() {
+            family.for_value()
+        } else {
+            family
+        })
+    }
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn intersect_of_families() {
+        assert_eq!(R::AF.intersect(R::AN), Some(R::AF));
+        assert_eq!(R::AN.intersect(R::AI), Some(R::AI));
+        assert_eq!(R::IV.intersect(R::AI), Some(R::AI));
+        assert_eq!(R::AF.intersect(R::AI), None);
+        assert_eq!(R::FV.intersect(R::IV), None);
+    }
+
+    #[test]
+    fn intersect_of_values_is_a_value() {
+        assert_eq!(R::FV.intersect(R::NV), Some(R::FV));
+        assert_eq!(R::NV.intersect(R::NV), Some(R::NV));
+        assert_eq!(R::IV.intersect(R::NV), Some(R::IV));
+    }
+
+    #[test]
+    #[should_panic]
+    fn intersect_of_other_panics() {
+        let _ = R::Other.intersect(R::AF);
+    }
+}
diff --git a/tests/src/slice-pattern-enum-loop.rs b/tests/src/slice-pattern-enum-loop.rs
new file mode 100644
index 0000000..a10ef1e
--- /dev/null
+++ b/tests/src/slice-pattern-enum-loop.rs
@@ -0,0 +1,82 @@
+//@ [!lean] skip
+//@ [lean] subdir=SlicePatternEnumLoop
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Slice patterns with enum element patterns in a loop body, with an early
+//! return in the fallback arm (the shapes of `chelis_types::Subst::resolve_rvar`
+//! and `chelis_deep::canonical_type_syntax`). The pattern tests the variant of
+//! the element through a first `@SliceIndexShared`, then binds its field through
+//! a second one; `share_repeated_shared_indexing` reuses the first result, but
+//! the storage markers before the fallback arm's `return` used to invalidate it
+//! after the match, and the interpreter could not expand the second element
+//! ("Not allowed to expand enumerations with several variants"). The writes of
+//! a branch which returns, aborts, breaks or continues do not reach the
+//! statements after the match. `SlicePatternEnumLoop/Checks.lean` evaluates the
+//! models on the inputs of the `native` test module below.
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum D {
+    Rank(u32),
+    Lit(u64),
+}
+
+/// Follows a single-rank table `n` times; 7 if it is not a single rank.
+pub fn resolve(v: &Vec<D>, n: u32) -> u32 {
+    let mut current = 0;
+    for _ in 0..n {
+        match v.as_slice() {
+            [D::Rank(next)] => current = *next,
+            _ => return 7,
+        }
+    }
+    current
+}
+
+/// Follows the chain of single ranks from `start` (at most `table.len() + 1`
+/// steps): a missing entry or a fixed point is the rank itself, any other entry
+/// is the result.
+pub fn resolve_chain(table: &[Vec<D>], start: usize) -> Vec<D> {
+    let mut current = start;
+    for _ in 0..table.len() + 1 {
+        match table.get(current) {
+            None => return vec![D::Rank(current as u32)],
+            Some(bound) => match bound.as_slice() {
+                [D::Rank(next)] if *next as usize != current => current = *next as usize,
+                [D::Rank(_)] => return vec![D::Rank(current as u32)],
+                _ => return bound.clone(),
+            },
+        }
+    }
+    vec![D::Rank(current as u32)]
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn resolve_follows_a_single_rank() {
+        assert_eq!(resolve(&vec![D::Rank(4)], 3), 4);
+        assert_eq!(resolve(&vec![D::Rank(4)], 0), 0);
+        assert_eq!(resolve(&vec![D::Lit(1)], 2), 7);
+        assert_eq!(resolve(&vec![D::Rank(1), D::Rank(2)], 1), 7);
+        assert_eq!(resolve(&vec![], 1), 7);
+    }
+
+    #[test]
+    fn resolve_chain_stops_at_a_non_rank() {
+        let table = vec![vec![D::Rank(1)], vec![D::Rank(2)], vec![D::Lit(9)]];
+        assert_eq!(resolve_chain(&table, 0), vec![D::Lit(9)]);
+        assert_eq!(resolve_chain(&table, 5), vec![D::Rank(5)]);
+    }
+
+    #[test]
+    fn resolve_chain_stops_at_a_fixed_point_or_a_cycle() {
+        let table = vec![vec![D::Rank(0)], vec![D::Rank(0)]];
+        assert_eq!(resolve_chain(&table, 1), vec![D::Rank(0)]);
+        let table = vec![vec![D::Rank(1)], vec![D::Rank(0)]];
+        assert_eq!(resolve_chain(&table, 0), vec![D::Rank(1)]);
+        let table = vec![vec![D::Rank(1)], vec![D::Rank(3)]];
+        assert_eq!(resolve_chain(&table, 0), vec![D::Rank(3)]);
+    }
+}
diff --git a/tests/src/slice-pattern-mut.rs b/tests/src/slice-pattern-mut.rs
new file mode 100644
index 0000000..55d8c1e
--- /dev/null
+++ b/tests/src/slice-pattern-mut.rs
@@ -0,0 +1,136 @@
+//@ [!lean] skip
+//@ [lean] subdir=SlicePatternMut
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Slice patterns on mutable slices (the shapes of
+//! `chelis_deep::identity::try_inherit_extensions` and
+//! `annotations_transform`). The length check reads the metadata of the
+//! mutable slice reference (`PtrMetadata`, or a raw pointer `&raw const *p`
+//! whose metadata is read, once per copy of the match arm made by the
+//! control-flow reconstruction): the length of the current value of the slice.
+//! The rest `rest @ ..` of a pattern on a mutable slice is the builtin
+//! `@SliceSubSliceMut`, whose backward function writes the given-back
+//! subslice back into the slice. (Patterns with several mutable bindings, or
+//! with enum element patterns, on a mutable slice are not supported yet: each
+//! binding borrows the whole slice.) `SlicePatternMut/Checks.lean` evaluates the
+//! models on the inputs of the `native` test module below, including the
+//! slices after the writes.
+
+/// The second of exactly two elements.
+pub fn second_mut(s: &mut [u32]) -> Option<&mut u32> {
+    match s {
+        [_, x] => Some(x),
+        _ => None,
+    }
+}
+
+/// Increments the second of exactly two elements.
+pub fn bump_second(s: &mut [u32]) {
+    if let Some(x) = second_mut(s) {
+        *x += 1;
+    }
+}
+
+/// A slice pattern with a guard on the slice of a vector: the control-flow
+/// reconstruction duplicates the length reads of the fallback arms.
+pub fn bump_guarded(v: &mut Vec<u32>, limit: u32) -> u32 {
+    let s: &mut [u32] = v;
+    match s {
+        [_, x] if *x < limit => {
+            *x += 1;
+            *x
+        }
+        [x, ..] => {
+            *x += 2;
+            *x
+        }
+        [] => 0,
+    }
+}
+
+/// Adds 100 to the first element of the rest after the first element, and
+/// returns the length of the rest.
+pub fn bump_rest(s: &mut [u32]) -> u32 {
+    match s {
+        [_, rest @ ..] => {
+            if let [r, ..] = rest {
+                *r += 100;
+            }
+            rest.len() as u32
+        }
+        [] => 0,
+    }
+}
+
+/// Writes through the middle of `[_, mid @ .., _]`; returns its length.
+pub fn bump_middle(s: &mut [u32]) -> u32 {
+    match s {
+        [_, mid @ .., _] => {
+            let n = mid.len() as u32;
+            if let [.., m] = mid {
+                *m += 100;
+            }
+            n
+        }
+        _ => 0,
+    }
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn bump_second_of_two() {
+        let mut v = [1, 2];
+        bump_second(&mut v);
+        assert_eq!(v, [1, 3]);
+        let mut v = [1, 2, 3];
+        bump_second(&mut v);
+        assert_eq!(v, [1, 2, 3]);
+        let mut v = [1];
+        bump_second(&mut v);
+        assert_eq!(v, [1]);
+    }
+
+    #[test]
+    fn bump_guarded_follows_the_guard() {
+        let mut v = vec![1, 2];
+        assert_eq!(bump_guarded(&mut v, 5), 3);
+        assert_eq!(v, vec![1, 3]);
+        let mut v = vec![1, 7];
+        assert_eq!(bump_guarded(&mut v, 5), 3);
+        assert_eq!(v, vec![3, 7]);
+        let mut v = vec![4, 5, 6];
+        assert_eq!(bump_guarded(&mut v, 5), 6);
+        assert_eq!(v, vec![6, 5, 6]);
+        let mut v: Vec<u32> = vec![];
+        assert_eq!(bump_guarded(&mut v, 5), 0);
+        assert_eq!(v, vec![]);
+    }
+
+    #[test]
+    fn bump_rest_writes_through_the_rest() {
+        let mut v = [1, 2, 3];
+        assert_eq!(bump_rest(&mut v), 2);
+        assert_eq!(v, [1, 102, 3]);
+        let mut v = [5];
+        assert_eq!(bump_rest(&mut v), 0);
+        assert_eq!(v, [5]);
+        let mut v: [u32; 0] = [];
+        assert_eq!(bump_rest(&mut v), 0);
+    }
+
+    #[test]
+    fn bump_middle_writes_through_the_middle() {
+        let mut v = [1, 2, 3, 4];
+        assert_eq!(bump_middle(&mut v), 2);
+        assert_eq!(v, [1, 2, 103, 4]);
+        let mut v = [1, 2];
+        assert_eq!(bump_middle(&mut v), 0);
+        assert_eq!(v, [1, 2]);
+        let mut v = [1];
+        assert_eq!(bump_middle(&mut v), 0);
+        assert_eq!(v, [1]);
+    }
+}
