+(** Read the length of a mutable slice before the reborrow which follows it.
+
+    The rest [rest @ ..] of a slice pattern on a mutable slice reborrows the
+    slice, then reads its length for the end of the subslice:
+    {[
+      r := &mut ( *p) with_metadata(..);
+      n := len( *p);    // or: n := copy p.metadata
+      rest := @SliceSubSliceMut(move r, from, n - k);
+    ]}
+    The length is the metadata of the reference [p], which the reborrow does
+    not change; the interpreter, however, reads it from the slice, which is
+    then lent to [r]: the read would end [r]. Read the length before the
+    reborrow (with the storage markers in between, which may be [n]'s). *)
+let read_lengths_before_reborrows (_crate : crate) (f : fun_decl) : fun_decl =
+  match f.body with
+  | StructuredBody body ->
+      let reborrow (st : statement) =
+        match st.kind with
+        | Assign
+            ( { kind = PlaceLocal r; _ },
+              RvRef
+                ( {
+                    kind = PlaceProjection ({ kind = PlaceLocal p; _ }, Deref);
+                    _;
+                  },
+                  (BMut | BTwoPhaseMut),
+                  _ ) ) -> Some (r, p)
+        | _ -> None
+      in
+      let length_read p (st : statement) =
+        match st.kind with
+        | Assign
+            ( { kind = PlaceLocal n; _ },
+              ( Len
+                  ( {
+                      kind =
+                        PlaceProjection ({ kind = PlaceLocal p'; _ }, Deref);
+                      _;
+                    },
+                    _,
+                    None )
+              | Use
+                  (Copy
+                     {
+                       kind =
+                         PlaceProjection ({ kind = PlaceLocal p'; _ }, PtrMetadata);
+                       _;
+                     }) ) )
+          when p' = p -> Some n
+        | _ -> None
+      in
+      let visitor =
+        object
+          inherit [_] map_statement as super
+
+          method! visit_block env b =
+            let b = super#visit_block env b in
+            let rec go (sts : statement list) =
+              match sts with
+              | st :: rest -> (
+                  match reborrow st with
+                  | None -> st :: go rest
+                  | Some (r, p) -> (
+                      let rec split lives = function
+                        | ({ kind = StorageLive id; _ } as live) :: rest
+                          when id <> r && id <> p -> split (live :: lives) rest
+                        | next :: rest -> Some (List.rev lives, next, rest)
+                        | [] -> None
+                      in
+                      match split [] rest with
+                      | Some (lives, next, rest') -> (
+                          match length_read p next with
+                          | Some n when n <> r && n <> p ->
+                              lives @ (next :: go (st :: rest'))
+                          | _ -> st :: go rest)
+                      | None -> st :: go rest))
+              | [] -> []
+            in
+            { b with statements = go b.statements }
+        end
+      in
+      let b = visitor#visit_block () body.body in
+      { f with body = StructuredBody { body with body = b } }
+  | _ -> f
