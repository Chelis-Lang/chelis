+import SlicePatternMut.SlicePatternMut
+
+/-! Evaluate the models of `tests/src/slice-pattern-mut.rs` on the inputs of its
+    `native` test module and compare with the native results, including the
+    slices after the writes. -/
+
+namespace slice_pattern_mut.checks
+open Aeneas Aeneas.Std Result
+
+def u32s (xs : List Nat) : List U32 := xs.map (fun x => ⟨BitVec.ofNat _ x⟩)
+
+def sl (xs : List Nat) (h : xs.length ≤ Usize.max := by scalar_tac) : Slice U32 :=
+  ⟨u32s xs, by simpa [u32s] using h⟩
+
+def vec (xs : List Nat) (h : xs.length ≤ Usize.max := by scalar_tac) : alloc.vec.Vec U32 :=
+  ⟨u32s xs, by simpa [u32s] using h⟩
+
+def nats (xs : List U32) : List Nat := xs.map (·.val)
+
+def bumpSecondR (xs : List Nat) (h : xs.length ≤ Usize.max := by scalar_tac) :
+    Option (List Nat) :=
+  match bump_second (sl xs h) with
+  | ok s => some (nats s.val)
+  | _ => none
+
+#guard bumpSecondR [1, 2] == some [1, 3]
+#guard bumpSecondR [1, 2, 3] == some [1, 2, 3]
+#guard bumpSecondR [1] == some [1]
+
+def bumpGuardedR (xs : List Nat) (limit : Nat) (h : xs.length ≤ Usize.max := by scalar_tac) :
+    Option (Nat × List Nat) :=
+  match bump_guarded (vec xs h) ⟨BitVec.ofNat _ limit⟩ with
+  | ok (r, v) => some (r.val, nats v.val)
+  | _ => none
+
+#guard bumpGuardedR [1, 2] 5 == some (3, [1, 3])
+#guard bumpGuardedR [1, 7] 5 == some (3, [3, 7])
+#guard bumpGuardedR [4, 5, 6] 5 == some (6, [6, 5, 6])
+#guard bumpGuardedR [] 5 == some (0, [])
+
+def withSlice (f : Slice U32 → Result (U32 × Slice U32)) (xs : List Nat)
+    (h : xs.length ≤ Usize.max := by scalar_tac) : Option (Nat × List Nat) :=
+  match f (sl xs h) with
+  | ok (r, s) => some (r.val, nats s.val)
+  | _ => none
+
+#guard withSlice bump_rest [1, 2, 3] == some (2, [1, 102, 3])
+#guard withSlice bump_rest [5] == some (0, [5])
+#guard withSlice bump_rest [] == some (0, [])
+
+#guard withSlice bump_middle [1, 2, 3, 4] == some (2, [1, 2, 103, 4])
+#guard withSlice bump_middle [1, 2] == some (0, [1, 2])
+#guard withSlice bump_middle [1] == some (0, [1])
+
+end slice_pattern_mut.checks
