diff --git a/tests/src/untranslated-trait-impl.rs b/tests/src/untranslated-trait-impl.rs
new file mode 100644
index 0000000..aa4706b
--- /dev/null
+++ b/tests/src/untranslated-trait-impl.rs
@@ -0,0 +1,44 @@
+//@ [!lean] skip
+//@ [lean] recover-errors
+//@ [lean] subdir=UntranslatedTraitImpl
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! References to a trait declaration and an implementation whose translation
+//! failed (a method signature with a function pointer type, which is not
+//! supported): the run reports the errors of the declaration and of the
+//! implementation, then one "Could not find" error per reference (in `generic`
+//! and `via_dict`), still emits `incr`, and exits with status 1. The
+//! declaration and the implementation are not exported: before, their export
+//! raised internal errors (the declaration's structure with a placeholder for
+//! the method's field, Extract.ml; the implementation, Translate.ml) and the
+//! reference to the implementation an uncaught `Not_found`
+//! (ExtractBase.ctx_get_reference). The partial output, which refers to the
+//! missing declarations, is not committed.
+
+pub trait Shape {
+    fn get(&self) -> u32;
+    fn apply(&self, f: fn(u32) -> u32) -> u32;
+}
+
+pub struct S(pub u32);
+
+impl Shape for S {
+    fn get(&self) -> u32 {
+        self.0
+    }
+    fn apply(&self, f: fn(u32) -> u32) -> u32 {
+        f(self.0)
+    }
+}
+
+pub fn generic<T: Shape>(t: &T) -> u32 {
+    t.get()
+}
+
+pub fn via_dict(s: &S) -> u32 {
+    generic(s)
+}
+
+pub fn incr(x: u32) -> u32 {
+    x.wrapping_add(1)
+}
