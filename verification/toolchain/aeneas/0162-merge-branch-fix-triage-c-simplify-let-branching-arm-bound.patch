+import LetBranchingArmVars.LetBranchingArmVars
+
+/-! Evaluate the model of `tests/src/let-branching-arm-vars.rs` on the inputs of
+    its `native` test module and compare with the native results, including
+    the panicking input. -/
+
+namespace let_branching_arm_vars.checks
+open Aeneas Aeneas.Std Result
+
+def code : R → Nat
+  | .AF => 0 | .AI => 1 | .AN => 2 | .FV => 3 | .IV => 4 | .NV => 5 | .Other => 6
+
+/-- `some (some c)`: `Some(r)` with code `c`; `some none`: `None`; `none`: a panic -/
+def intersectR (a b : R) : Option (Option Nat) :=
+  match R.intersect a b with
+  | ok r => some (r.map code)
+  | _ => none
+
+#guard intersectR .AF .AN == some (some (code .AF))
+#guard intersectR .AN .AI == some (some (code .AI))
+#guard intersectR .IV .AI == some (some (code .AI))
+#guard intersectR .AF .AI == some none
+#guard intersectR .FV .IV == some none
+
+#guard intersectR .FV .NV == some (some (code .FV))
+#guard intersectR .NV .NV == some (some (code .NV))
+#guard intersectR .IV .NV == some (some (code .IV))
+
+-- `R::Other.intersect(R::AF)` panics (`unreachable!`)
+#guard intersectR .Other .AF == none
+
+end let_branching_arm_vars.checks
