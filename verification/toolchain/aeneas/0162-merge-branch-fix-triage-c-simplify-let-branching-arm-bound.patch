 def IScalar.cast_fromBool (ty : IScalarTy) (x : Bool) : IScalar ty :=
   if x then ⟨ 1#ty.numBits ⟩ else ⟨ 0#ty.numBits ⟩
 
+/-- `x as char` for a `u8` `x`, the only integer type which Rust casts to `char`: every `u8` value
+    is a Unicode scalar value, so `Char.ofNat` never falls back to `'\0'`. -/
+def UScalar.cast_toChar (x : U8) : Char := Char.ofNat x.val
+
+/-- `c as uN` for a `char` `c`: its code point (at most `0x10FFFF`), truncated to the target type -/
+def UScalar.cast_fromChar (ty : UScalarTy) (c : Char) : UScalar ty :=
+  ⟨ BitVec.ofNat ty.numBits c.toNat ⟩
+
+/-- `c as iN` for a `char` `c`: its code point, truncated to the target type -/
+def IScalar.cast_fromChar (ty : IScalarTy) (c : Char) : IScalar ty :=
+  ⟨ BitVec.ofNat ty.numBits c.toNat ⟩
+
+section
+  /-! The char casts on examples at the truncation boundaries. -/
+  local macro:max x:term:max noWs "i8" : term => `(I8.ofInt $x (by decide))
+  local macro:max x:term:max noWs "u8" : term => `(U8.ofNat $x (by decide))
+  local macro:max x:term:max noWs "u16" : term => `(U16.ofNat $x (by decide))
+  local macro:max x:term:max noWs "u32" : term => `(U32.ofNat $x (by decide))
+
+  #assert UScalar.cast_toChar 97u8 = 'a'                   -- assert_eq!(97u8 as char, 'a');
+  #assert UScalar.cast_toChar 255u8 = 'ÿ'                  -- assert_eq!(255u8 as char, 'ÿ');
+  #assert UScalar.cast_fromChar .U32 'é' = 233u32          -- assert_eq!('é' as u32, 233);
+  #assert UScalar.cast_fromChar .U32 (Char.ofNat 0x10FFFF) = 0x10FFFFu32 -- char::MAX as u32
+  #assert UScalar.cast_fromChar .U8 'Ā' = 0u8              -- assert_eq!('Ā' as u8, 0);
+  #assert UScalar.cast_fromChar .U16 '😀' = 0xF600u16      -- assert_eq!('😀' as u16, 0xF600);
+  #assert IScalar.cast_fromChar .I8 'ÿ' = (-1)i8           -- assert_eq!('ÿ' as i8, -1);
+end
+
