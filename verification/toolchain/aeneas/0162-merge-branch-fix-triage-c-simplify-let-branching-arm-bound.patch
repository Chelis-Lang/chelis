+/-- The mutable subslice `s[start..end_]` (builtin `@SliceSubSliceMut`, e.g. the
+    rest `rest @ ..` of a slice pattern on a mutable slice), and the backward
+    function which writes the given-back subslice back into `s` from `start`
+    on. In Rust the given-back subslice has the length of the subslice;
+    `setSlice!` keeps the length of `s` for any given-back value. -/
+def Slice.subslice_mut {α : Type u} (s : Slice α) (start end_ : Usize) :
+  Result (Slice α × (Slice α → Slice α)) := do
+  let ns ← Slice.subslice_shared s start end_
+  ok (ns, fun ns' => ⟨ s.val.setSlice! start.val ns'.val, by scalar_tac ⟩)
+
+@[step]
+theorem Slice.subslice_mut_spec {α : Type u} (s : Slice α) (start end_ : Usize)
+  (h0 : start.val ≤ end_.val) (h1 : end_.val ≤ s.val.length) :
+  subslice_mut s start end_ ⦃ p =>
+    p.1.val = s.val.slice start.val end_.val ∧
+    ∀ ns', (p.2 ns').val = s.val.setSlice! start.val ns'.val ⦄ := by
+  simp_all only [subslice_mut, subslice_shared, length, and_self, ite_true, bind_tc_ok,
+    spec_ok, implies_true]
+
