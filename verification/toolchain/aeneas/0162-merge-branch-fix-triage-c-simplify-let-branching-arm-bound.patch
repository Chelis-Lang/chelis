+    alloc.vec.Vec D :=
+  ⟨xs.map dec, by simpa using h⟩
+
+def resolveR (xs : List (Nat ⊕ Nat)) (n : Nat) (h : xs.length ≤ Usize.max := by scalar_tac) :
+    Option Nat :=
+  match resolve (vec xs h) ⟨BitVec.ofNat _ n⟩ with
+  | ok r => some r.val
+  | _ => none
+
+#guard resolveR [.inl 4] 3 == some 4
+#guard resolveR [.inl 4] 0 == some 0
+#guard resolveR [.inr 1] 2 == some 7
+#guard resolveR [.inl 1, .inl 2] 1 == some 7
+#guard resolveR [] 1 == some 7
+
+def table (rows : List (List (Nat ⊕ Nat))) (h : rows.length ≤ Usize.max := by scalar_tac)
+    (hr : ∀ r ∈ rows, r.length ≤ Usize.max := by scalar_tac) : Slice (alloc.vec.Vec D) :=
+  ⟨rows.attach.map (fun ⟨r, hm⟩ => vec r (hr r hm)), by simpa using h⟩
+
