+#!/usr/bin/env bash
+# Partially monomorphized copies of a foreign trait with different method
+# subsets across chunks (SeparateCompilation manifest `members`).
+#
+# Usage: trait-method-subsets.sh <charon> <aeneas> [<work directory>]
+#
+# Chunks of trait_method_subsets.rs, extracted like the chunks of a workspace
+# (-canonical-names, -split-files, one -subdir per chunk, -abort-on-error;
+# without -warnings-as-errors, which rejects the specialized adapter methods
+# that have no model, unknown externals unrelated to this test). Charon keeps,
+# in the copies `Iterator::<IterMut<'_, T0>, &'_ mut T1>` of the trait and of
+# its implementation for IterMut, the methods which the chunk uses:
+# - A (the owner) emits them with next, enumerate and take; its manifest
+#   records, for the trait declaration, the digest of its interface without the
+#   methods and the digest of each method's signature, and for the
+#   implementation the digest of its interface without the methods and the
+#   methods it defines.
+# - B (next and enumerate) with -external <manifest of A> is admitted: its
+#   copies keep a subset of A's methods, with the same interface otherwise and
+#   the same signatures; B does not emit the declaration and refers to A's
+#   instance (Lean checks these references when the chunks are compiled
+#   together).
+# - The other way round (B the owner), A is admitted as before: the view of an
+#   external declaration keeps the owner's fields (next and enumerate), and A
+#   calls take directly, not through the dictionary.
+# - B is rejected when A's manifest differs in the signature of a method B
+#   uses, in the interface without the methods (declaration or
+#   implementation), or has no member digests (a manifest written before
+#   them): only equal interfaces are admitted then.
+set -uo pipefail
+
+charon=$1
+aeneas=$2
+here=$(cd "$(dirname "$0")" && pwd)
+work=${3:-$(mktemp -d)}
+mkdir -p "$work"
+failures=0
+
+check() { # check <description> <command...>
+  local what=$1
+  shift
+  if "$@"; then
+    echo "ok: $what"
+  else
+    echo "FAILED: $what"
+    failures=$((failures + 1))
+  fi
+}
+absent() { # absent <grep arguments...>: the files exist and do not match
+  grep -q "$@"
+  [ $? -eq 1 ]
+}
+
+llbc() { # llbc <chunk> <charon options...>
+  local chunk=$1
+  shift
+  "$charon" rustc --preset=aeneas --mir=promoted --monomorphize-mut=except-types \
+    --remove-adt-clauses '--lift-associated-types=*' --error-on-warnings \
+    --include core::iter::adapters::enumerate::Enumerate \
+    --include core::iter::adapters::take::Take "$@" \
+    --dest-file "$work/$chunk.llbc" -- "$here/trait_method_subsets.rs" \
+    --crate-name=trait_method_subsets --crate-type=rlib --edition=2021 \
+    >"$work/$chunk.charon.log" 2>&1 ||
+    { echo "charon failed on chunk $chunk (see $work/$chunk.charon.log)"; exit 1; }
+}
+
+run() { # run <name> <chunk> <aeneas options...>; sets $status
+  local name=$1 chunk=$2
+  shift 2
+  rm -rf "${work:?}/$name" && mkdir -p "$work/$name"
+  "$aeneas" -backend lean -checks -abort-on-error -strict-joins \
+    -sequential -no-progress-bar -canonical-names -split-files -subdir "Chunk$chunk" \
+    -dest "$work/$name/lean" -emit-manifest "$work/$name/manifest.json" "$@" \
+    "$work/$chunk.llbc" >"$work/$name/log" 2>&1
+  status=$?
+}
+
+decl='trait_decl core::iter::traits::iterator::Iterator::<core::slice::iter::IterMut<0, T0>, &0 mut (T1)>[]'
+impl='trait_impl core::slice::iter::{core::iter::traits::iterator::Iterator::<core::slice::iter::IterMut<0, T0>, &0 mut (T1)><'"'"'a, T> for T}'
+
+# field <manifest> <key> <python expression on the entry e>: print it as JSON
+field() {
+  python3 -c '
+import json, sys
+entries = [e for e in json.load(open(sys.argv[1]))["entries"] if e["key"] == sys.argv[2]]
+e = entries[0] if entries else None
+print(json.dumps(eval(sys.argv[3])) if e else "missing")' "$1" "$2" "$3"
+}
+
+# tamper <in> <out> <key> <python statement on the entry e>
+tamper() {
+  python3 -c '
+import json, sys
+manifest = json.load(open(sys.argv[1]))
+for e in manifest["entries"]:
+    if e["key"] == sys.argv[3]:
+        exec(sys.argv[4])
+json.dump(manifest, open(sys.argv[2], "w"))' "$1" "$2" "$3" "$4"
+}
+
+llbc A --start-from trait_method_subsets::number_all \
+  --start-from trait_method_subsets::bump_first
+llbc B --opaque trait_method_subsets::number_all --opaque trait_method_subsets::bump_first \
+  --start-from trait_method_subsets::double_even
+llbc B0 --start-from trait_method_subsets::double_even
+llbc A1 --opaque trait_method_subsets::double_even \
+  --start-from trait_method_subsets::number_all --start-from trait_method_subsets::bump_first
+
+run a A
+check "A exits with status 0" test "$status" -eq 0
+check "A's copy of the trait has next, enumerate and take" \
+  test "$(field "$work/a/manifest.json" "$decl" 'e["methods"]')" = '["next", "enumerate", "take"]'
+check "A records a signature digest per method of the trait" \
+  test "$(field "$work/a/manifest.json" "$decl" 'len(e["members"]["method_fingerprints"])')" = 3
+check "A records the methods of the implementation" \
+  test "$(field "$work/a/manifest.json" "$impl" 'e["methods"]')" = '["next", "enumerate", "take"]'
+check "A records the interface of the implementation without its methods" \
+  test "$(field "$work/a/manifest.json" "$impl" 'len(e["members"]["header"])')" = 32
+
+run b B -external "$work/a/manifest.json"
+check "B (a subset of A's methods) exits with status 0" test "$status" -eq 0
+decl_name=$(field "$work/a/manifest.json" "$decl" 'e["names"][0]' | tr -d '"')
+impl_name=$(field "$work/a/manifest.json" "$impl" 'e["names"][0]' | tr -d '"')
+check "B does not emit A's copy of the trait" \
+  absent -rqxF "  $decl_name" "$work/b/lean/ChunkB"
+check "B refers to A's implementation" \
+  grep -qF "_root_.$impl_name" "$work/b/lean/ChunkB/Funs.lean"
+
+run b0 B0
+check "B0 (B as the owner) exits with status 0" test "$status" -eq 0
+run a1 A1 -external "$work/b0/manifest.json"
+check "A after B (B the owner) exits with status 0" test "$status" -eq 0
+check "A after B does not emit B's copy of the trait" \
+  absent -rqxF "  $(field "$work/b0/manifest.json" "$decl" 'e["names"][0]' | tr -d '"')" \
+  "$work/a1/lean/ChunkA1"
+
+tamper "$work/a/manifest.json" "$work/a-sig.json" "$decl" \
+  'e["members"]["method_fingerprints"][e["methods"].index("enumerate")] = "0" * 32'
+run b-sig B -external "$work/a-sig.json"
+check "B is rejected when the signature of enumerate differs" test "$status" -ne 0
+check "the rejection names the trait's interface" \
+  grep -qF "the interface of [$decl] in this chunk differs" "$work/b-sig/log"
+
+tamper "$work/a/manifest.json" "$work/a-take.json" "$decl" \
+  'e["members"]["method_fingerprints"][e["methods"].index("take")] = "0" * 32'
+run b-take B -external "$work/a-take.json"
+check "B is admitted when only the signature of take (not a field of B's view) differs" \
+  test "$status" -eq 0
+
+tamper "$work/a/manifest.json" "$work/a-header.json" "$decl" 'e["members"]["header"] = "0" * 32'
+run b-header B -external "$work/a-header.json"
+check "B is rejected when the trait's interface without the methods differs" \
+  test "$status" -ne 0
+check "the rejection names the trait's interface (header)" \
+  grep -qF "the interface of [$decl] in this chunk differs" "$work/b-header/log"
+
+tamper "$work/a/manifest.json" "$work/a-impl.json" "$impl" 'e["members"]["header"] = "0" * 32'
+run b-impl B -external "$work/a-impl.json"
+check "B is rejected when the implementation's interface without the methods differs" \
+  test "$status" -ne 0
+check "the rejection names the implementation's interface" \
+  grep -qF "the interface of [$impl] in this chunk differs" "$work/b-impl/log"
+
+python3 -c '
+import json, sys
+manifest = json.load(open(sys.argv[1]))
+for e in manifest["entries"]:
+    e.pop("members", None)
+json.dump(manifest, open(sys.argv[2], "w"))' "$work/a/manifest.json" "$work/a-old.json"
+run b-old B -external "$work/a-old.json"
+check "B is rejected with a manifest of A without member digests" test "$status" -ne 0
+check "the rejection names the trait's interface (no member digests)" \
+  grep -qF "the interface of [$decl] in this chunk differs" "$work/b-old/log"
+
+if [ "$failures" -ne 0 ]; then
+  echo "$failures check(s) failed; outputs in $work"
+  exit 1
+fi
+echo "all checks passed"
diff --git a/tests/separate-compilation/trait_method_subsets.rs b/tests/separate-compilation/trait_method_subsets.rs
new file mode 100644
index 0000000..6cd825e
--- /dev/null
+++ b/tests/separate-compilation/trait_method_subsets.rs
@@ -0,0 +1,38 @@
+//! Chunks of trait-method-subsets.sh. With `--monomorphize-mut`, Charon makes a
+//! partially monomorphized copy of `Iterator` for the mutable slice iterator
+//! (`Iterator::<IterMut<'_, T0>, &'_ mut T1>`) and of its implementation, with
+//! only the methods which the chunk uses: `next`, `enumerate` and `take` in
+//! chunk A, `next` and `enumerate` in chunk B.
+
+// Chunk A
+
+/// Adds its position to every element (`enumerate`).
+pub fn number_all(v: &mut Vec<u32>) {
+    for (i, x) in v.iter_mut().enumerate() {
+        *x += i as u32;
+    }
+}
+
+/// Increments the first `n` elements (`take`) and returns how many there were.
+pub fn bump_first(v: &mut Vec<u32>, n: usize) -> u32 {
+    let mut k = 0;
+    for x in v.iter_mut().take(n) {
+        *x += 1;
+        k += 1;
+    }
+    k
+}
+
+// Chunk B: a subset of the methods of A (`enumerate`)
+
+/// Doubles the elements at even positions and returns their sum.
+pub fn double_even(v: &mut Vec<u32>) -> u32 {
+    let mut sum = 0;
+    for (i, x) in v.iter_mut().enumerate() {
+        if i % 2 == 0 {
+            *x *= 2;
+            sum += *x;
+        }
+    }
+    sum
+}
diff --git a/tests/src/char-casts.rs b/tests/src/char-casts.rs
new file mode 100644
index 0000000..d0dfae5
--- /dev/null
+++ b/tests/src/char-casts.rs
@@ -0,0 +1,69 @@
+//@ [!lean] skip
+//@ [lean] subdir=CharCasts
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Casts from `u8` to `char` (the byte of an escape in a lexer's error, the
+//! shape of `chelis_deep::lexer::lex_string`) and from `char` to the integer
+//! types (the code point, truncated to the target type). The extraction had no
+//! case for them. `CharCasts/Checks.lean` evaluates the models on the inputs of
+//! the `native` test module below.
+
+/// The character of a byte.
+pub fn byte_char(b: u8) -> char {
+    b as char
+}
+
+/// A constant byte as a character (a cast of a constant operand).
+pub fn letter_a() -> char {
+    97u8 as char
+}
+
+/// The code point of a character.
+pub fn code_point(c: char) -> u32 {
+    c as u32
+}
+
+/// The code point truncated to the unsigned and signed 8-bit and 16-bit types.
+pub fn truncated(c: char) -> (u8, i8, u16, i16) {
+    (c as u8, c as i8, c as u16, c as i16)
+}
+
+/// A constant character as a byte and as a code point.
+pub fn letter_codes() -> (u8, u64) {
+    ('z' as u8, 'z' as u64)
+}
+
+/// The escape of an invalid byte, as a lexer reports it.
+pub fn describe_escape(b: u8) -> Option<char> {
+    match b {
+        b'n' => None,
+        other => Some(other as char),
+    }
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn byte_to_char() {
+        assert_eq!(byte_char(97), 'a');
+        assert_eq!(byte_char(0), '\0');
+        assert_eq!(byte_char(255), 'ÿ');
+        assert_eq!(letter_a(), 'a');
+        assert_eq!(describe_escape(b'n'), None);
+        assert_eq!(describe_escape(b'q'), Some('q'));
+    }
+
+    #[test]
+    fn char_to_integers() {
+        assert_eq!(code_point('a'), 97);
+        assert_eq!(code_point('é'), 233);
+        assert_eq!(code_point(char::MAX), 0x10FFFF);
+        assert_eq!(truncated('a'), (97, 97, 97, 97));
+        assert_eq!(truncated('ÿ'), (255, -1, 255, 255));
+        assert_eq!(truncated('Ā'), (0, 0, 256, 256));
+        assert_eq!(truncated('😀'), (0, 0, 0xF600, -2560));
+        assert_eq!(letter_codes(), (122, 122));
+    }
+}
