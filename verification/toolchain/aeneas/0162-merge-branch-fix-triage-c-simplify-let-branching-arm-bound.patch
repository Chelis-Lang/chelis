+import CharCasts.CharCasts
+
+/-! Evaluate the models of `tests/src/char-casts.rs` on the inputs of its
+    `native` test module and compare with the native results. -/
+
+namespace char_casts.checks
+open Aeneas Aeneas.Std Result
+
+def u8 (n : Nat) : U8 := ⟨BitVec.ofNat _ n⟩
+
+def res {α : Type} (r : Result α) : Option α :=
+  match r with
+  | ok x => some x
+  | _ => none
+
+#guard res (byte_char (u8 97)) == some 'a'
+#guard res (byte_char (u8 0)) == some (Char.ofNat 0)
+#guard res (byte_char (u8 255)) == some 'ÿ'
+#guard res letter_a == some 'a'
+#guard res (describe_escape (u8 110)) == some none
+#guard res (describe_escape (u8 113)) == some (some 'q')
+
+#guard (res (code_point 'a')).map (·.val) == some 97
+#guard (res (code_point 'é')).map (·.val) == some 233
+#guard (res (code_point (Char.ofNat 0x10FFFF))).map (·.val) == some 0x10FFFF
+
+/-- The unsigned results as naturals, the signed ones as integers -/
+def truncatedR (c : Char) : Option (Nat × Int × Nat × Int) :=
+  (res (truncated c)).map fun (a, b, d, e) => (a.val, b.val, d.val, e.val)
+
+#guard truncatedR 'a' == some (97, 97, 97, 97)
+#guard truncatedR 'ÿ' == some (255, -1, 255, 255)
+#guard truncatedR 'Ā' == some (0, 0, 256, 256)
+#guard truncatedR '😀' == some (0, 0, 0xF600, -2560)
+#guard (res letter_codes).map (fun (a, b) => (a.val, b.val)) == some (122, 122)
+
+end char_casts.checks
