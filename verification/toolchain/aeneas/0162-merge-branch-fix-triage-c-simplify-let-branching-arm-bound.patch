+/-- `Rank(n)` as `.inl n`, `Lit(n)` as `.inr n` -/
+def enc : D → Nat ⊕ Nat
+  | .Rank n => .inl n.val
+  | .Lit n => .inr n.val
+
+def dec : Nat ⊕ Nat → D
+  | .inl n => .Rank ⟨BitVec.ofNat _ n⟩
+  | .inr n => .Lit ⟨BitVec.ofNat _ n⟩
+
