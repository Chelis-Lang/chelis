+    (h : rows.length ≤ Usize.max := by scalar_tac)
+    (hr : ∀ r ∈ rows, r.length ≤ Usize.max := by simp; scalar_tac) :
+    Option (List (Nat ⊕ Nat)) :=
+  match resolve_chain (table rows h hr) ⟨BitVec.ofNat _ start⟩ with
+  | ok v => some (v.val.map enc)
+  | _ => none
+
+#guard resolveChainR [[.inl 1], [.inl 2], [.inr 9]] 0 == some [.inr 9]
+#guard resolveChainR [[.inl 1], [.inl 2], [.inr 9]] 5 == some [.inl 5]
+
+#guard resolveChainR [[.inl 0], [.inl 0]] 1 == some [.inl 0]
+#guard resolveChainR [[.inl 1], [.inl 0]] 0 == some [.inl 1]
+#guard resolveChainR [[.inl 1], [.inl 3]] 0 == some [.inl 3]
