+                    if not (List.mem id !opaque) then opaque := id :: !opaque;
+                    []
                 | _ -> [])
             | _ -> []
           in
@@ -1019,10 +1025,30 @@ let constructor_input span (ctx : Contexts.decls_ctx) input_ty output_ty output
   in
   match find [] output_ty output with
   | [ value ] -> value
-  | _ ->
+  | found ->
+      let fmt = Print.Contexts.decls_ctx_to_fmt_env ctx in
+      let opaque =
+        List.rev_map
+          (fun id ->
+            Print.name_to_string fmt
+              (T.TypeDeclId.Map.find id ctx.type_ctx.type_decls).item_meta.name)
+          !opaque
+      in
       [%craise] span
-        "Model constructor recovery requires one structurally identified \
-         source input"
+        ("Model constructor recovery requires one structurally identified \
+          source input: the input of type "
+        ^ Print.ty_to_string fmt input_ty
+        ^ " is found at "
+        ^ string_of_int (List.length found)
+        ^ " positions of the output of type "
+        ^ Print.ty_to_string fmt output_ty
+        ^
+        if opaque = [] then ""
+        else
+          " (the fields of the opaque types "
+          ^ String.concat ", " opaque
+          ^ " are unknown: extract their declarations with Charon's --include)"
+        )
 
