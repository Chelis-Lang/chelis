 let constructor_input span (ctx : Contexts.decls_ctx) input_ty output_ty output
     =
+  (* The declarations of the opaque types met on the way: their fields are
+     unknown *)
+  let opaque = ref [] in
   let rec find seen ty e =
     if ty = input_ty then [ e ]
     else if List.mem ty seen then []
@@ -1000,6 +1003,9 @@ let constructor_input span (ctx : Contexts.decls_ctx) input_ty output_ty output
