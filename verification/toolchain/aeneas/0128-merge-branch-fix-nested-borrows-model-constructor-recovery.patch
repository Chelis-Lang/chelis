+/// A closure capturing a mutable borrow, moved into `map` and consumed by
+/// `collect`: the counter is given back to the caller by the closure's final
+/// state (identified in the `Map` of the model by the declaration of `Map`,
+/// which is extracted)
+pub fn number(t: &Tree, next: &mut u32) -> Wire {
+    match t {
+        Tree::Leaf(n) => {
+            *next = next.wrapping_mul(3).wrapping_add(*n);
+            Wire::Leaf(*next)
+        }
+        Tree::Node(v) => Wire::List(v.iter().map(|c| number(c, next)).collect()),
+        Tree::Named(v) => Wire::Map(v.iter().map(|(k, c)| (*k + *next, number(c, next))).collect()),
+    }
+}
+
+/// The digest of the numbered tree and the counter given back
+pub fn sample_number(a: u32, b: u32, start: u32) -> (u64, u32) {
+    let mut next = start;
+    let w = number(&sample(a, b), &mut next);
+    (w.digest(), next)
+}
