+//! A closure capturing a mutable borrow, moved into `map` and consumed by
+//! `collect`. The value given back to the borrow is the closure's final state,
+//! which the model of the adapter constructor carries in its output: Aeneas
+//! identifies the closure's position in the output from the declaration of
+//! `Map`. Without `--include core::iter::adapters::map::Map`, `Map` is opaque
+//! and the model's field names are not evidence, so the function is rejected
+//! with an error naming the opaque declaration. The production extraction
+//! includes the adapters (`ITERATOR_ADAPTERS` of `verification/extract.py`);
+//! `number` of `recursive-adapter-closures.rs` is the same closure with `Map`
+//! included, inside a recursive function.
+
+pub fn step(x: u32, next: &mut u32) -> u32 {
+    *next = next.wrapping_add(x);
+    *next
+}
+
+pub fn prefix_sums(v: &Vec<u32>, next: &mut u32) -> Vec<u32> {
+    v.iter().map(|x| step(*x, next)).collect()
+}
