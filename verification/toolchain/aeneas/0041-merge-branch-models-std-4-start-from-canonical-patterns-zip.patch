+(** Split a start-from option into its patterns, at the commas outside
+    brackets ([split_patterns] in charon/src/options.rs). *)
+let split_patterns (list : string) : string list =
+  let depth = ref 0 in
+  let start = ref 0 in
+  let parts = ref [] in
+  String.iteri
+    (fun i c ->
+      match c with
+      | '<' | '{' | '(' | '[' -> incr depth
+      | '>' | '}' | ')' | ']' -> depth := max 0 (!depth - 1)
+      | ',' when !depth = 0 ->
+          parts := String.sub list !start (i - !start) :: !parts;
+          start := i + 1
+      | _ -> ())
+    list;
+  parts := String.sub list !start (String.length list - !start) :: !parts;
+  List.filter (fun p -> p <> "") (List.rev_map String.trim !parts)
+
+(** The start-from selections of the options Charon recorded, or [Error] with
+    a pattern that does not parse. Without any, Charon starts from the local
+    crate: [[]]. *)
+let of_options (options : cli_options) : (t list, string) result =
+  let patterns =
+    List.concat_map split_patterns
+      (options.start_from @ options.start_from_if_exists)
+  in
+  let rec parse_all acc = function
+    | [] -> Ok (List.rev acc)
+    | p :: ps -> (
+        match parse p with
+        | Some pat -> parse_all (Pattern pat :: acc) ps
+        | None -> Error p)
+  in
+  Result.map
+    (fun patterns ->
+      patterns
+      @ (match options.start_from_attribute with
+        | Some attr -> [ Attribute attr ]
+        | None -> [])
+      @ if options.start_from_pub then [ Pub ] else [])
+    (parse_all [] patterns)
