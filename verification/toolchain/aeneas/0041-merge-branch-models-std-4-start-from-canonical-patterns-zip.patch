+let builtin_name (b : builtin_ty) : name =
+  let path =
+    match b with
+    | TBox -> [ "alloc"; "boxed"; "Box" ]
+    | TStr -> [ "Str" ]
+  in
+  List.map (fun s -> PeIdent (s, Disambiguator.zero)) path
