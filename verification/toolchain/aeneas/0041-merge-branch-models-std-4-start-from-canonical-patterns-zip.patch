+        opt (fun () ->
+            tag "<";
+            space0 ();
+            let args =
+              separated_list0
+                (fun () ->
+                  tag ",";
+                  space0 ())
+                (fun () ->
+                  let ty = pat_ty () in
+                  space0 ();
+                  ty)
+            in
+            tag ">";
+            args)
+      in
+      Ident (ident, Option.value generics ~default:[], d)
+  and pat_ty () : pat_ty =
+    alt
+      [
+        (fun () ->
+          tag "&";
+          space0 ();
+          let kind =
+            match
+              opt (fun () ->
+                  tag "mut";
+                  space0 ())
+            with
+            | Some () -> RMut
+            | None -> RShared
+          in
