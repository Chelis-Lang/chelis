index 0000000..f847403
--- /dev/null
+++ b/src/llbc/StartFrom.ml
@@ -0,0 +1,414 @@
+(** The items Charon started the translation from.
+
+    Charon records its start-from options in the LLBC ([--start-from] and
+    [--start-from-file], [--start-from-if-exists], [--start-from-attribute],
+    [--start-from-pub]), but not the items they selected. We select them again
+    on the translated crate, with Charon's own pattern language: the syntax of
+    charon/src/name_matcher/parser.rs and the name matching of
+    [Pattern::matches] and [StartFrom::matches] (charon/src/name_matcher/mod.rs,
+    charon/src/options.rs). This is not the syntax of charon-ml's
+    [NameMatcher]: Charon's canonical patterns (e.g. the roots of
+    [CHARON_CALLGRAPH]) use impl elements [{impl a::T}] and
+    [{impl a::Tr<u8> for a::T}], disambiguated identifiers [_#1] and
+    [closure#12], and plain identifiers match every disambiguator.
+
+    Charon resolves a pattern without disambiguators as a rustc path first,
+    which follows re-exports; names do not. A pattern that designates an item
+    through a re-export selects nothing here. *)
+
+open Types
+open LlbcAst
+
+type pat_elem =
+  | Ident of string * pat_ty list * int option
+      (** A name, its generic arguments (for a trait, the implemented type
+          first) and its disambiguator: [None] matches every disambiguator. *)
+  | Impl of pattern
+      (** An inherent impl (the pattern of its type) or a trait impl (the
+          pattern of the trait, the implemented type as first argument). *)
+  | Glob  (** [_] or [*] *)
+
+and pat_ty =
+  | Pat of pattern
+  | Ref of ref_kind * pat_ty
+  | Var  (** [@]: a type parameter *)
+
+and pattern = pat_elem list
+
+type t = Pattern of pattern | Attribute of string | Pub
+
+(** The identifiers Charon gives to unnamed path elements ([SPECIAL_IDENTS]). *)
+let special_idents =
+  [
+    "{use}";
+    "{const}";
+    "{promoted_const}";
+    "{vtable}";
+    "{vtable_method}";
+    "{vtable_drop_shim}";
+    "{vtable_drop_preshim}";
+    "{vtable_method_preshim}";
+  ]
+
+(** A recoverable parse error: the next alternative is tried (nom's [Error]). *)
+exception Backtrack
+
+(** An unrecoverable parse error (nom's [Failure], after [cut]). *)
+exception Cut
+
+(** Parse a pattern like [Pattern::parse]; [None] if it is not one. *)
+let parse (s : string) : pattern option =
+  let n = String.length s in
+  let pos = ref 0 in
+  let tag (t : string) : unit =
+    let l = String.length t in
+    if !pos + l <= n && String.sub s !pos l = t then pos := !pos + l
+    else raise Backtrack
+  in
+  let is_space c = c = ' ' || c = '\t' || c = '\n' || c = '\r' in
+  let is_digit c = c >= '0' && c <= '9' in
+  (* Rust's [char::is_alphanumeric] or ['_']; every non-ASCII byte is part of
+     a UTF-8 character, which we accept like a letter. *)
+  let is_ident c =
+    (c >= 'a' && c <= 'z')
+    || (c >= 'A' && c <= 'Z')
+    || is_digit c || c = '_' || Char.code c >= 128
+  in
+  let take_while (f : char -> bool) : string =
+    let start = !pos in
+    while !pos < n && f s.[!pos] do
+      incr pos
+    done;
+    String.sub s start (!pos - start)
+  in
+  let take_while1 f =
+    let x = take_while f in
+    if x = "" then raise Backtrack else x
+  in
+  let space0 () = ignore (take_while is_space) in
+  let space1 () = ignore (take_while1 is_space) in
+  let opt p =
+    let start = !pos in
+    try Some (p ())
+    with Backtrack ->
+      pos := start;
+      None
+  in
+  let rec alt ps =
+    match ps with
+    | [] -> raise Backtrack
+    | p :: ps -> (
+        let start = !pos in
+        try p ()
+        with Backtrack ->
+          pos := start;
+          alt ps)
+  in
+  let cut p = try p () with Backtrack -> raise Cut in
+  (* [separated_list0] *)
+  let separated_list0 sep elem =
+    match opt elem with
+    | None -> []
+    | Some first ->
+        let rec rest acc =
+          match
+            opt (fun () ->
+                sep ();
+                elem ())
+          with
+          | Some e -> rest (e :: acc)
+          | None -> List.rev acc
+        in
+        rest [ first ]
+  in
+  (* An optional [#N] suffix *)
+  let disambiguator () : int option =
+    opt (fun () ->
+        tag "#";
+        match int_of_string_opt (take_while1 is_digit) with
+        | Some d -> d
+        | None -> raise Backtrack)
+  in
+  let rec pattern () : pattern =
+    separated_list0
+      (fun () ->
+        tag "::";
+        space0 ())
+      pat_elem
+  and pat_elem () : pat_elem = alt [ glob; special_ident; impl_elem; simple_elem ]
+  and glob () =
+    tag "*";
+    Glob
+  and special_ident () =
+    tag "{";
+    let ident =
+      take_while1 (fun c -> c = '_' || (is_ident c && Char.code c < 128))
+    in
+    tag "}";
+    let name = "{" ^ ident ^ "}" in
+    if not (List.mem name special_idents) then raise Backtrack;
+    let d = disambiguator () in
+    space0 ();
+    Ident (name, [], d)
+  and impl_elem () =
+    tag "{";
+    space0 ();
+    cut (fun () ->
+        ignore
+          (opt (fun () ->
+               tag "impl";
+               cut space1));
+        let pat = pattern () in
+        space0 ();
+        let for_ty =
+          opt (fun () ->
+              tag "for";
+              space1 ();
+              let ty = pat_ty () in
+              space0 ();
+              ty)
+        in
+        tag "}";
+        match for_ty with
+        | None -> Impl pat
+        | Some ty -> (
+            (* The implemented type is the first argument of the trait. *)
+            match List.rev pat with
+            | Ident (name, generics, d) :: rest ->
+                Impl (List.rev (Ident (name, ty :: generics, d) :: rest))
+            | _ -> raise Cut))
+  and simple_elem () =
+    let ident = take_while is_ident in
+    let d = disambiguator () in
+    space0 ();
+    if ident = "_" && d = None then Glob
+    else
