+    a prefix of it. The arguments are those of the last name element. *)
+let rec matches_name (crate : crate) (p : pattern) (name : name)
+    (args : generic_args option) : bool =
+  let name, args =
+    match List.rev name with
+    | PeInstantiated binder :: rest -> (List.rev rest, Some binder.binder_value)
+    | _ -> (name, args)
+  in
+  (* A pattern that starts with an impl matches it anywhere: from the
+     rightmost impl of the name. *)
+  let name =
+    match p with
+    | Impl _ :: _ ->
+        let rec from_last_impl found = function
+          | [] -> found
+          | (PeImpl _ :: _ as rest) -> from_last_impl rest (List.tl rest)
+          | _ :: rest -> from_last_impl found rest
+        in
+        from_last_impl name name
+    | _ -> name
+  in
+  let rec go (p : pattern) (name : name) =
+    match (p, name) with
+    | [], _ -> true
+    | _ :: _, [] -> false
+    | [ pe ], [ ne ] -> matches_elem crate pe ne args
+    | pe :: p, ne :: name -> matches_elem crate pe ne None && go p name
+  in
+  go p name
+
+and matches_elem (crate : crate) (pe : pat_elem) (ne : path_elem)
+    (args : generic_args option) : bool =
+  match (pe, ne) with
+  | Glob, _ -> true
+  | Ident (pid, generics, d), PeIdent (id, ed) ->
+      (pid = id || (pid = "crate" && id = crate.name))
+      && (match d with
+         | None -> true
+         | Some d -> d = Disambiguator.to_int ed)
+      && matches_generics crate generics args
+  | Impl p, PeImpl (ImplElemTy ty) -> matches_ty crate p ty.binder_value
+  | Impl p, PeImpl (ImplElemTrait impl_id) -> (
+      match TraitImplId.Map.find_opt impl_id crate.trait_impls with
+      | None -> false
+      | Some timpl -> (
+          match
+            TraitDeclId.Map.find_opt timpl.impl_trait.id crate.trait_decls
+          with
+          | None -> false
+          | Some tdecl ->
+              let tname = tdecl.item_meta.name in
+              (* An instantiated trait's name carries its arguments. *)
+              let args =
+                match List.rev tname with
+                | PeInstantiated _ :: _ -> None
+                | _ -> Some timpl.impl_trait.generics
+              in
+              matches_name crate p tname args))
+  | _ -> false
+
+and matches_generics (crate : crate) (pats : pat_ty list)
+    (args : generic_args option) : bool =
+  match args with
+  | None -> true
+  | Some _ when pats = [] -> true
+  | Some g ->
+      (* Patterns do not mention regions. Charon matched the patterns before
+         [--lift-associated-types] appended type parameters to the items that
+         need associated types (e.g. [Fn<Args>] became [Fn<Args, Output>]):
+         then the pattern's types spell out a prefix of the types. *)
+      let nconsts = List.length g.const_generics in
+      let ntype_pats = List.length pats - nconsts in
+      let ntypes = List.length g.types in
+      (ntype_pats = ntypes
+      || crate.options.lift_associated_types <> []
+         && 0 <= ntype_pats && ntype_pats < ntypes)
+      &&
+      let type_pats, const_pats = Collections.List.split_at pats ntype_pats in
+      let types, _ = Collections.List.split_at g.types ntype_pats in
+      List.for_all2 (matches_pat_ty crate) type_pats types
+      (* Charon only implements the glob pattern for constants. *)
+      && List.for_all (fun pat -> pat = Pat [ Glob ]) const_pats
+
+and matches_ty (crate : crate) (p : pattern) (ty : ty) : bool =
+  p = [ Glob ]
+  ||
+  let ident s = [ PeIdent (s, Disambiguator.zero) ] in
+  match ty with
+  | TAdt { id = TAdtId id; generics } -> (
+      match TypeDeclId.Map.find_opt id crate.type_decls with
+      | Some d -> matches_name crate p d.item_meta.name (Some generics)
+      | None -> false)
+  | TAdt { id = TBuiltin b; generics } ->
+      matches_name crate p (builtin_name b) (Some generics)
+  | TAdt { id = TTuple; generics } -> (
+      (* Tuples are [Tuple<A, B, ..>], with every argument spelled out. *)
+      match p with
+      | [ Ident ("Tuple", pats, None) ] ->
+          List.length pats = List.length generics.types
+          && List.for_all2 (matches_pat_ty crate) pats generics.types
+      | _ -> false)
+  | TArray (ty, len) ->
+      matches_name crate p (ident "Array")
+        (Some { TypesUtils.empty_generic_args with types = [ ty ]; const_generics = [ len ] })
+  | TSlice ty ->
+      matches_name crate p (ident "Slice")
+        (Some { TypesUtils.empty_generic_args with types = [ ty ] })
+  | TLiteral lit ->
+      matches_name crate p
+        (ident (Charon.Print.literal_type_to_string lit))
+        (Some TypesUtils.empty_generic_args)
+  | _ -> false
+
+and matches_pat_ty (crate : crate) (pt : pat_ty) (ty : ty) : bool =
+  match (pt, ty) with
+  | Pat p, _ -> matches_ty crate p ty
+  | Ref (kind, pt), TRef (_, ty, kind') -> kind = kind' && matches_pat_ty crate pt ty
+  | Var, TVar _ -> true
+  | _ -> false
+
+(** [StartFrom::matches]: whether the selection selects the item (or an item
+    it is named under). *)
+let matches (crate : crate) (selection : t) (meta : item_meta) : bool =
+  match selection with
+  | Pattern p -> matches_name crate p meta.name None
+  | Attribute attr ->
+      List.exists
+        (function
+          | Meta.AttrUnknown raw -> raw.path = attr
+          | _ -> false)
+        meta.attr_info.attributes
+  | Pub -> meta.attr_info.public
