@@ -0,0 +1,207 @@
+//@ [!lean] skip
+//@ [lean] subdir=LoopReturnOptionMutArg
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! A loop which can return early, then an `Option<&mut _>` argument, live
+//! across the loop, moved into a callee which writes through it (the shape of
+//! `chelis_ir::grad::grad_dag_checked_impl`, whose `execution:
+//! Option<&mut ExecutionMetadata>` is passed to `grad_dag_result` after the
+//! loop over the forward nodes). At the join of the two returns, the call
+//! abstraction of the callee has ended (it only kept the reborrow of the
+//! argument alive) and gave its value back to the loan projector of the
+//! reborrow introduced at the loop entrance, which is merged with the other
+//! return's reborrow: the value given back by the callee is the input of the
+//! merged continuation, like the given-back value of an ended mutable loan.
+//! The controls (no early return, the option written inline after the loop, a
+//! plain `&mut`) have the same results.
+//!
+//! LoopReturnOptionMutArg/Checks.lean compares the model, including the values
+//! given back to the arguments, with the native results asserted in the
+//! native test module.
+
+pub struct Meta {
+    pub n: u64,
+}
+
+pub enum Op {
+    A,
+    B,
+    C,
+}
+
+pub struct Node {
+    pub op: Op,
+    pub id: usize,
+}
+
+fn finish(m: Option<&mut u64>) -> u32 {
+    if let Some(m) = m {
+        *m = 0;
+        return 2;
+    }
+    0
+}
+
+/// A `while` loop with an early return, then the option given to `finish`
+pub fn check_while(n: usize, m: Option<&mut u64>) -> u32 {
+    let mut i = 0;
+    while i < n {
+        if i == 3 {
+            return 1;
+        }
+        i += 1;
+    }
+    finish(m)
+}
+
+fn finish_meta(m: Option<&mut Meta>) -> u32 {
+    if let Some(m) = m {
+        m.n = 0;
+    }
+    0
+}
+
+/// A `for` loop over a slice with an early return
+pub fn check_for(xs: &[bool], m: Option<&mut Meta>) -> u32 {
+    for x in xs {
+        if *x {
+            return 1;
+        }
+    }
+    finish_meta(m)
+}
+
+fn finish_nodes(nodes: &[Node], m: Option<&mut Meta>) -> Result<usize, u32> {
+    if let Some(m) = m {
+        m.n = m.n.wrapping_add(1);
+    }
+    Ok(nodes.len())
+}
+
+/// A `continue` and two early returns in a match (closer to the production
+/// function)
+pub fn check_nodes(nodes: &[Node], live: &[bool], m: Option<&mut Meta>) -> Result<usize, u32> {
+    for node in nodes {
+        if !live[node.id] {
+            continue;
+        }
+        match node.op {
+            Op::A => return Err(1),
+            Op::B => {}
+            Op::C => return Err(3),
+        }
+    }
+    finish_nodes(nodes, m)
+}
+
+/// Control: no early return
+pub fn check_no_return(n: usize, m: Option<&mut u64>) -> u32 {
+    let mut i = 0;
+    while i < n {
+        i += 1;
+    }
+    finish(m)
+}
+
+/// Control: the option is written after the loop instead of given to a callee
+pub fn check_inline(n: usize, m: Option<&mut u64>) -> u32 {
+    let mut i = 0;
+    while i < n {
+        if i == 3 {
+            return 1;
+        }
+        i += 1;
+    }
+    if let Some(m) = m {
+        *m = 0;
+        return 2;
+    }
+    0
+}
+
+fn finish_plain(m: &mut u64) -> u32 {
+    *m = 0;
+    2
+}
+
+/// Control: a plain mutable borrow given to the callee
+pub fn check_plain(n: usize, m: &mut u64) -> u32 {
+    let mut i = 0;
+    while i < n {
+        if i == 3 {
+            return 1;
+        }
+        i += 1;
+    }
+    finish_plain(m)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn check_while_native() {
+        let mut m = 7u64;
+        assert_eq!(check_while(2, Some(&mut m)), 2);
+        assert_eq!(m, 0);
+        let mut m = 7u64;
+        assert_eq!(check_while(5, Some(&mut m)), 1);
+        assert_eq!(m, 7);
+        let mut m = 7u64;
+        assert_eq!(check_while(3, Some(&mut m)), 2);
+        assert_eq!(m, 0);
+        assert_eq!(check_while(2, None), 0);
+        assert_eq!(check_while(4, None), 1);
+    }
+
+    #[test]
+    fn check_for_native() {
+        let mut m = Meta { n: 9 };
+        assert_eq!(check_for(&[false, false], Some(&mut m)), 0);
+        assert_eq!(m.n, 0);
+        let mut m = Meta { n: 9 };
+        assert_eq!(check_for(&[false, true], Some(&mut m)), 1);
+        assert_eq!(m.n, 9);
+        assert_eq!(check_for(&[], None), 0);
+    }
+
+    #[test]
+    fn check_nodes_native() {
+        let nodes = [Node { op: Op::B, id: 0 }, Node { op: Op::A, id: 1 }, Node { op: Op::C, id: 2 }];
+        let mut m = Meta { n: 4 };
+        assert_eq!(check_nodes(&nodes, &[true, false, false], Some(&mut m)), Ok(3));
+        assert_eq!(m.n, 5);
+        let mut m = Meta { n: 4 };
+        assert_eq!(check_nodes(&nodes, &[true, true, false], Some(&mut m)), Err(1));
+        assert_eq!(m.n, 4);
+        let mut m = Meta { n: 4 };
+        assert_eq!(check_nodes(&nodes, &[false, false, true], Some(&mut m)), Err(3));
+        assert_eq!(m.n, 4);
+        let mut m = Meta { n: u64::MAX };
+        assert_eq!(check_nodes(&nodes[..1], &[true], Some(&mut m)), Ok(1));
+        assert_eq!(m.n, 0);
+        assert_eq!(check_nodes(&nodes, &[false, false, false], None), Ok(3));
+    }
+
+    #[test]
+    fn controls_native() {
+        let mut m = 7u64;
+        assert_eq!(check_no_return(5, Some(&mut m)), 2);
+        assert_eq!(m, 0);
+        assert_eq!(check_no_return(5, None), 0);
+        let mut m = 7u64;
+        assert_eq!(check_inline(2, Some(&mut m)), 2);
+        assert_eq!(m, 0);
+        let mut m = 7u64;
+        assert_eq!(check_inline(5, Some(&mut m)), 1);
+        assert_eq!(m, 7);
+        assert_eq!(check_inline(2, None), 0);
+        let mut m = 7u64;
+        assert_eq!(check_plain(2, &mut m), 2);
+        assert_eq!(m, 0);
+        let mut m = 7u64;
+        assert_eq!(check_plain(5, &mut m), 1);
+        assert_eq!(m, 7);
+    }
+}
