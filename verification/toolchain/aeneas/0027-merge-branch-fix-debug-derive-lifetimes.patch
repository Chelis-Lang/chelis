+import StaticRefs.StaticRefs
+
+/-! Evaluate the model of `tests/src/static-refs.rs` on the inputs of its
+    `native` test module and compare with the native results. -/
+
+namespace static_refs.checks
+open Aeneas Aeneas.Std Result
+
+def u (n : Nat) : U32 := ⟨BitVec.ofNat _ n⟩
+
+def us (xs : List Nat) (h : xs.length ≤ Usize.max := by simp; try scalar_tac) : Slice U32 :=
+  ⟨xs.map u, by simpa using h⟩
+
+def strs (xs : List Str) (h : xs.length ≤ Usize.max := by simp; try scalar_tac) :
+    Slice Str :=
+  ⟨xs, h⟩
+
+def res (r : Result U32) : Option Nat :=
+  match r with
+  | ok v => some v.val
+  | _ => none
+
+def resB (r : Result Bool) : Option Bool :=
+  match r with
+  | ok b => some b
+  | _ => none
+
+def resR (r : Result (core.result.Result U32 U32)) : Option (Sum Nat Nat) :=
+  match r with
+  | ok (.Ok v) => some (.inl v.val)
+  | ok (.Err e) => some (.inr e.val)
+  | _ => none
+
+-- statics
+#guard resB (is_op (toStr "+")) == some true
+#guard resB (is_op (toStr "or")) == some true
+#guard resB (is_op (toStr "xor")) == some false
+#guard res second_limit == some 20
+#guard res pair_sum == some 15
+
+-- loops
+#guard resR (check_all (toStr "*") (us [1, 2, 3])) == some (.inl 6)
+#guard resR (check_all (toStr "*") (us [])) == some (.inl 0)
+#guard resR (check_all (toStr "and") (us [4, 11, 2])) == some (.inr 11)
+#guard resR (check_all (toStr "sqrt") (us [1])) == some (.inr 0)
+#guard res (count_small (us [0, 1, 3, 5, 2, 2, 11, 10])) == some 5
+#guard res (count_small (us [])) == some 0
+#guard res (count_ops (strs [toStr "+", toStr "x", toStr "*", toStr "and"])) == some 2
+#guard res (count_ops (strs [])) == some 0
+
+end static_refs.checks
