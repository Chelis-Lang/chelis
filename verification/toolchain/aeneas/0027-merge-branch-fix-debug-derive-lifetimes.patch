@@ -0,0 +1,47 @@
+//@ [!lean] skip
+//@ [lean] subdir=DebugLifetimes
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Derived `Debug` for types holding references (the fields are unsized to
+//! `&dyn Debug` while they borrow from the formatted value), as in
+//! `chelis_deep::literal_source`. `DebugLifetimes/Checks.lean` evaluates the
+//! model of the `fmt` methods and compares with the `native` test module.
+
+#[derive(Debug, Clone, Copy)]
+pub struct Source<'a> {
+    literal: &'a u32,
+    numeric: Option<&'a u32>,
+}
+
+#[derive(Debug, Clone, Copy)]
+pub enum Use<'a> {
+    Plain { binder: &'a str, source: Option<Source<'a>> },
+    Pair(&'a u32, bool),
+    Other,
+}
+
+pub fn source<'a>(literal: &'a u32, numeric: Option<&'a u32>) -> Source<'a> {
+    Source { literal, numeric }
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn debug() {
+        let (a, b) = (3u32, 5u32);
+        assert_eq!(format!("{:?}", source(&a, None)), "Source { literal: 3, numeric: None }");
+        assert_eq!(
+            format!("{:?}", source(&a, Some(&b))),
+            "Source { literal: 3, numeric: Some(5) }"
+        );
+        assert_eq!(
+            format!("{:?}", Use::Plain { binder: "x", source: Some(source(&a, Some(&b))) }),
+            "Plain { binder: \"x\", source: Some(Source { literal: 3, numeric: Some(5) }) }"
+        );
+        assert_eq!(format!("{:?}", Use::Plain { binder: "y", source: None }), "Plain { binder: \"y\", source: None }");
+        assert_eq!(format!("{:?}", Use::Pair(&b, true)), "Pair(5, true)");
+        assert_eq!(format!("{:?}", Use::Other), "Other");
+    }
+}
