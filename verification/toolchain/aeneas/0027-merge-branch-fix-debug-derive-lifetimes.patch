+import DebugLifetimes.DebugLifetimes
+
+/-! Evaluate the model of the derived `fmt` methods of
+    `tests/src/debug-lifetimes.rs` and compare with the strings of its `native`
+    test module. -/
+
+namespace debug_lifetimes.checks
+open Aeneas Aeneas.Std Result
+
+def u (n : Nat) : U32 := ⟨BitVec.ofNat _ n⟩
+
+def out (r : Result ((core.result.Result Unit core.fmt.Error) × core.fmt.Formatter)) :
+    Option String :=
+  match r with
+  | ok (.Ok (), f) => some f.output
+  | _ => none
+
+def src (a : Nat) (b : Option Nat) : Source := { literal := u a, numeric := b.map u }
+
+#guard out (Source.Insts.CoreFmtDebug.fmt (src 3 none) {}) ==
+  some "Source { literal: 3, numeric: None }"
+#guard out (Source.Insts.CoreFmtDebug.fmt (src 3 (some 5)) {}) ==
+  some "Source { literal: 3, numeric: Some(5) }"
+#guard out (Use.Insts.CoreFmtDebug.fmt (.Plain (toStr "x") (some (src 3 (some 5)))) {}) ==
+  some "Plain { binder: \"x\", source: Some(Source { literal: 3, numeric: Some(5) }) }"
+#guard out (Use.Insts.CoreFmtDebug.fmt (.Plain (toStr "y") none) {}) ==
+  some "Plain { binder: \"y\", source: None }"
+#guard out (Use.Insts.CoreFmtDebug.fmt (.Pair (u 5) true) {}) == some "Pair(5, true)"
+#guard out (Use.Insts.CoreFmtDebug.fmt .Other {}) == some "Other"
+
+end debug_lifetimes.checks
