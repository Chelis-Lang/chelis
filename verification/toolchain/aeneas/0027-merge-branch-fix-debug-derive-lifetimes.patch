+(** Read the length of a matched slice directly.
+
+    The length check of a slice pattern on a place which is not a local (e.g.
+    [match c { A(x, [y]) => ... }]) creates a raw pointer to the matched slice
+    only to read its metadata:
+    {[
+      r := &raw const ( *p) with_metadata(m);
+      n := copy r.metadata;
+    ]}
+    The metadata of this pointer is [m]. When the raw pointer has no other use,
+    read [m] directly ([n := m]) and drop the raw pointer. *)
+let read_raw_pointer_metadata (_crate : crate) (f : fun_decl) : fun_decl =
+  match f.body with
+  | StructuredBody body ->
+      let counts = ref LocalId.Map.empty in
+      let occurrences =
+        object
+          inherit [_] iter_statement as super
+
+          (* Occurrences in places (not in storage markers) *)
+          method! visit_place env p =
+            match p.kind with
+            | PlaceLocal id ->
+                counts :=
+                  LocalId.Map.add id
+                    (1
+                    + Option.value (LocalId.Map.find_opt id !counts) ~default:0
+                    )
+                    !counts
+            | _ -> super#visit_place env p
+        end
+      in
+      occurrences#visit_block () body.body;
+      (* Only the definition and the metadata read *)
+      let single_use id = LocalId.Map.find_opt id !counts = Some 2 in
+      let visitor =
+        object
+          inherit [_] map_statement as super
+
+          method! visit_block env b =
+            let b = super#visit_block env b in
+            let rec go (sts : statement list) =
+              match sts with
+              | ({
+                   kind = Assign ({ kind = PlaceLocal r; _ }, RawPtr (_, _, m));
+                   _;
+                 } as st)
+                :: rest
+                when single_use r -> (
+                  let rec split lives = function
+                    | ({ kind = StorageLive id; _ } as live) :: rest
+                      when id <> r -> split (live :: lives) rest
+                    | next :: rest -> Some (List.rev lives, next, rest)
+                    | [] -> None
+                  in
+                  match split [] rest with
+                  | Some
+                      ( lives,
+                        ({
+                           kind =
+                             Assign
+                               ( dest,
+                                 Use
+                                   ( Copy
+                                       {
+                                         kind =
+                                           PlaceProjection
+                                             ( { kind = PlaceLocal r'; _ },
+                                               PtrMetadata );
+                                         _;
+                                       }
+                                   | Move
+                                       {
+                                         kind =
+                                           PlaceProjection
+                                             ( { kind = PlaceLocal r'; _ },
+                                               PtrMetadata );
+                                         _;
+                                       } ) );
+                           _;
+                         } as next),
+                        rest' )
+                    when r = r' ->
+                      lives
+                      @ {
+                          next with
+                          kind = Assign (dest, Use m);
+                          comments_before =
+                            st.comments_before @ next.comments_before;
+                        }
+                        :: go rest'
+                  | _ -> st :: go rest)
+              | st :: rest -> st :: go rest
+              | [] -> []
+            in
+            { b with statements = go b.statements }
+        end
+      in
+      let b = visitor#visit_block () body.body in
+      { f with body = StructuredBody { body with body = b } }
+  | _ -> f
+
