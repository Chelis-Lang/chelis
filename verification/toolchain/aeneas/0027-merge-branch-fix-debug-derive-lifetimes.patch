diff --git a/tests/src/static-refs.rs b/tests/src/static-refs.rs
new file mode 100644
index 0000000..d0d7236
--- /dev/null
+++ b/tests/src/static-refs.rs
@@ -0,0 +1,94 @@
+//@ [!lean] skip
+//@ [lean] subdir=StaticRefs
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Globals whose types contain shared `'static` references (constant
+//! references to static data), used before loops.
+//! `StaticRefs/Checks.lean` evaluates the model on the inputs of the `native`
+//! test module below and compares with the native results.
+
+pub const ARITH_OPS: &[&str] = &["+", "-", "*"];
+pub const BOOL_OPS: &[&str] = &["and", "or"];
+pub static LIMITS: [&u32; 2] = [&10, &20];
+pub const PAIR: (&u32, u32) = (&7, 8);
+pub const SMALL: &[u32] = &[1, 2, 3];
+
+pub fn is_op(name: &str) -> bool {
+    ARITH_OPS.contains(&name) || BOOL_OPS.contains(&name)
+}
+
+pub fn second_limit() -> u32 {
+    *LIMITS[1]
+}
+
+pub fn pair_sum() -> u32 {
+    *PAIR.0 + PAIR.1
+}
+
+/// A static access followed by a loop with early exits.
+pub fn check_all(name: &str, args: &[u32]) -> Result<u32, u32> {
+    if !is_op(name) {
+        return Err(0);
+    }
+    let limit = *LIMITS[0];
+    let mut sum = 0;
+    for a in args {
+        if *a > limit {
+            return Err(*a);
+        }
+        sum += *a;
+    }
+    Ok(sum)
+}
+
+pub static LIMIT: &u32 = &10;
+
+/// Static accesses in a loop.
+pub fn count_small(xs: &[u32]) -> u32 {
+    let mut n = 0;
+    let mut i = 0;
+    while i < xs.len() {
+        if SMALL.contains(&xs[i]) || xs[i] > *LIMIT {
+            n += 1;
+        }
+        i += 1;
+    }
+    n
+}
+
+/// Static string references compared in a loop.
+pub fn count_ops(names: &[&str]) -> u32 {
+    let mut n = 0;
+    for name in names {
+        if ARITH_OPS.contains(name) {
+            n += 1;
+        }
+    }
+    n
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn statics() {
+        assert!(is_op("+"));
+        assert!(is_op("or"));
+        assert!(!is_op("xor"));
+        assert_eq!(second_limit(), 20);
+        assert_eq!(pair_sum(), 15);
+    }
+
+    #[test]
+    fn loops() {
+        assert_eq!(check_all("*", &[1, 2, 3]), Ok(6));
+        assert_eq!(check_all("*", &[]), Ok(0));
+        assert_eq!(check_all("and", &[4, 11, 2]), Err(11));
+        assert_eq!(check_all("sqrt", &[1]), Err(0));
+        assert_eq!(count_small(&[0, 1, 3, 5, 2, 2, 11, 10]), 5);
+        assert_eq!(count_small(&[]), 0);
+        assert_eq!(count_ops(&["+", "x", "*", "and"]), 2);
+        assert_eq!(count_ops(&[]), 0);
+    }
+}
