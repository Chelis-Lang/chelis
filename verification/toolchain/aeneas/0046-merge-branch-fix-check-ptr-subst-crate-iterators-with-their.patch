+import CollectUserIteratorHint.CollectUserIteratorHint
+
+/-! Evaluate the model of `tests/src/collect-user-iterator-hint.rs` on the inputs
+    of its `native` test module and compare with the native results, and prove
+    the collection obligations listed in obligations.json. -/
+namespace collect_user_iterator_hint.checks
+open Aeneas Aeneas.Std Result
+def u (x : Nat) : U32 := ⟨BitVec.ofNat _ x⟩
+def vec {α} (xs : List α) (h : xs.length ≤ Usize.max := by scalar_tac) : alloc.vec.Vec α := ⟨xs, h⟩
+def sl {α} (xs : List α) (h : xs.length ≤ Usize.max := by scalar_tac) : Slice α := ⟨xs, h⟩
+def nats (r : Result (alloc.vec.Vec U32)) : Option (List Nat) :=
+  match r with | ok v => some (v.val.map (·.val)) | _ => none
+#guard nats (countdowns (u 3)) == some [1, 0, 0]
+def arms : Slice (alloc.vec.Vec U32) := sl [vec [u 10, u 11], vec [], vec [u 12]]
+#guard nats (successor_arms (sl [u 2, u 0, u 1]) false arms) == some [12, 10, 11]
+#guard nats (successor_arms (sl [u 1, u 2, u 0]) true arms) == some [12]
+
+theorem countdown_size_hint_total :
+    Countdown.Insts.CoreIterTraitsIteratorIteratorU32.size_hint_total :=
+  fun _ => ⟨_, rfl⟩
+
+theorem successors_size_hint_total :
+    Successors.Insts.CoreIterTraitsIteratorIterator.size_hint_total := by
+  intro E A inst h s
+  cases s with
+  | Arms arms =>
+    obtain ⟨r, hr⟩ := h arms
+    exact ⟨r, by simp [Successors.Insts.CoreIterTraitsIteratorIterator.size_hint, hr]⟩
+  | Fixed first second =>
+    have bit : ∀ b : Bool, (core.convert.num.FromUsizeBool.from b).val ≤ 1 := by
+      intro b; cases b <;> simp [core.convert.num.FromUsizeBool.from]
+    have := bit first.isSome
+    have := bit second.isSome
+    have hmax : (core.convert.num.FromUsizeBool.from first.isSome).val +
+        (core.convert.num.FromUsizeBool.from second.isSome).val ≤ UScalar.max .Usize := by
+      scalar_tac
+    obtain ⟨z, hz, -⟩ := WP.spec_imp_exists (UScalar.add_spec hmax)
+    exact ⟨(z, some z), by
+      simp [Successors.Insts.CoreIterTraitsIteratorIterator.size_hint,
+        core.option.Option.is_some, lift, hz]⟩
+end collect_user_iterator_hint.checks
