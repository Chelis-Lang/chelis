+//@ [!lean] skip
+//@ [lean] subdir=CollectUserIteratorPanickingHint
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors -emit-collection-obligations tests/lean/CollectUserIteratorPanickingHint/obligations.json
+//! A crate-local iterator whose own `size_hint` can panic. Native collection
+//! calls it once the vector is full, so `countdowns(5)` panics natively while
+//! the next-driven value model returns the items: the admission is only sound
+//! through the obligation `size_hint_total` (listed in obligations.json), and
+//! CollectUserIteratorPanickingHint/Checks.lean proves that obligation false.
+
+pub struct Countdown(pub u32);
+
+impl Iterator for Countdown {
+    type Item = u32;
+
+    fn next(&mut self) -> Option<u32> {
+        if self.0 == 0 {
+            None
+        } else {
+            self.0 -= 1;
+            Some(self.0)
+        }
+    }
+
+    /// Divides by zero once the countdown is exhausted.
+    fn size_hint(&self) -> (usize, Option<usize>) {
+        (0, Some((10 / self.0) as usize))
+    }
+}
+
+pub fn countdowns(n: u32) -> Vec<u32> {
+    Countdown(n).collect()
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn collects_before_the_hint_panics() {
+        assert_eq!(countdowns(3), vec![2, 1, 0]);
+    }
+
+    #[test]
+    #[should_panic(expected = "attempt to divide by zero")]
+    fn full_vector_calls_the_panicking_hint() {
+        countdowns(5);
+    }
+}
