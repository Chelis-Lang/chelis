diff --git a/tests/src/nested-borrows-model-state.rs b/tests/src/nested-borrows-model-state.rs
new file mode 100644
index 0000000..820216a
--- /dev/null
+++ b/tests/src/nested-borrows-model-state.rs
@@ -0,0 +1,141 @@
+//@ [!lean] skip
+//@ [lean] subdir=NestedBorrowsModelState
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::iter::adapters::map::Map
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Closures capturing closures which capture mutable borrows, called through
+//! the canonical `FnMut` model. The state of such a closure nests mutable
+//! borrows, so the backward functions of its innermost region are staged (see
+//! `Pure.back_sg_info.early`):
+//! - the `FnMut` instance of a closure recovers the canonical state from the
+//!   stages of its `call_mut` (`ModelStateABI.adapt_dictionary_method`), with
+//!   up to four stages;
+//! - a call through the model gives back, at the levels > 0 of a stage, the
+//!   values the stage receives (`ModelStateABI.adapt_canonical_call`);
+//! - the `map` constructor, which moves such a closure into its output, gives
+//!   back the values of each level of the closure from the output it receives
+//!   in the same stage (one view of the closure per stage).
+
+fn apply<F: FnMut(u32) -> u32>(f: &mut F, x: u32) -> u32 {
+    f(x)
+}
+
+/// Two calls through `&mut F` on a closure capturing a closure which captures
+/// a mutable borrow (three levels: two stages).
+pub fn via_generic(n: u32) -> (u32, u32) {
+    let mut calls = n;
+    let mut c = |x: u32| {
+        calls = calls.wrapping_add(1);
+        x.wrapping_mul(2)
+    };
+    let mut w = |x: u32| c(x).wrapping_add(1);
+    let a = apply(&mut w, 1);
+    let b = apply(&mut w, 2);
+    (a.wrapping_add(b), calls)
+}
+
+fn apply2<F: FnMut(u32) -> u32>(g: &mut &mut F, v: u32) -> u32 {
+    let a = (**g)(v);
+    (**g)(a)
+}
+
+/// The same closure through `&mut &mut F` (four levels: four stages).
+pub fn use_apply2(v: u32) -> (u32, u32) {
+    let mut calls = 0u32;
+    let mut c = |x: u32| {
+        calls = calls.wrapping_add(x);
+        x.wrapping_mul(2)
+    };
+    let mut w = |x: u32| c(x).wrapping_add(1);
+    let r = {
+        let mut wr = &mut w;
+        apply2(&mut wr, v)
+    };
+    (r, calls)
+}
+
+fn apply_owned<F: FnMut(u32) -> u32>(mut f: F, x: u32) -> u32 {
+    let a = f(x);
+    a.wrapping_add(f(a))
+}
+
+/// A closure capturing a closure which captures a closure which captures a
+/// mutable borrow, moved into a generic function: the `FnMut` instance of the
+/// outer closure recovers its state from four stages.
+pub fn via_owned(n: u32) -> (u32, u32) {
+    let mut calls = n;
+    let mut c = |x: u32| {
+        calls = calls.wrapping_add(x);
+        x.wrapping_mul(2)
+    };
+    let mut w = |x: u32| c(x).wrapping_add(1);
+    let o = |x: u32| w(x).wrapping_add(3);
+    let a = apply_owned(o, 5);
+    (a, calls)
+}
+
+/// The same closures, called directly.
+pub fn once(n: u32) -> (u32, u32) {
+    let mut calls = n;
+    let mut c = |x: u32| {
+        calls = calls.wrapping_add(1);
+        x.wrapping_mul(2)
+    };
+    let mut w = |x: u32| c(x).wrapping_add(1);
+    let mut o = |x: u32| w(x).wrapping_add(3);
+    let a = o(1);
+    let b = o(a);
+    (a.wrapping_add(b), calls)
+}
+
+/// A closure capturing a closure which captures a mutable borrow, moved into
+/// `Map` (four levels in the signature of `map`: four stages).
+pub fn map_chain(xs: &[u32], n: u32) -> (Vec<u32>, u32) {
+    let mut calls = n;
+    let mut c = |x: u32| {
+        calls = calls.wrapping_add(1);
+        x.wrapping_mul(2)
+    };
+    let mut w = |x: u32| c(x).wrapping_add(1);
+    let v: Vec<u32> = xs.iter().map(|x| w(*x)).collect();
+    (v, calls)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn via_generic_native() {
+        assert_eq!(via_generic(0), (8, 2));
+        assert_eq!(via_generic(40), (8, 42));
+        assert_eq!(via_generic(u32::MAX), (8, 1));
+    }
+
+    #[test]
+    fn use_apply2_native() {
+        assert_eq!(use_apply2(0), (3, 1));
+        assert_eq!(use_apply2(5), (23, 16));
+        assert_eq!(use_apply2(u32::MAX), (u32::MAX, u32::MAX - 1));
+    }
+
+    #[test]
+    fn via_owned_native() {
+        assert_eq!(via_owned(0), (46, 19));
+        assert_eq!(via_owned(23), (46, 42));
+        assert_eq!(via_owned(u32::MAX), (46, 18));
+    }
+
+    #[test]
+    fn once_native() {
+        assert_eq!(once(0), (22, 2));
+        assert_eq!(once(40), (22, 42));
+        assert_eq!(once(u32::MAX), (22, 1));
+    }
+
+    #[test]
+    fn map_chain_native() {
+        assert_eq!(map_chain(&[1, 2, 3], 0), (vec![3, 5, 7], 3));
+        assert_eq!(map_chain(&[], 40), (vec![], 40));
+        assert_eq!(map_chain(&[u32::MAX, 20], u32::MAX), (vec![u32::MAX, 41], 1));
+    }
+}
diff --git a/tests/src/nested-borrows-returned.rs b/tests/src/nested-borrows-returned.rs
new file mode 100644
index 0000000..09b057a
--- /dev/null
+++ b/tests/src/nested-borrows-returned.rs
@@ -0,0 +1,142 @@
+//@ [!lean] skip
+//@ [lean] subdir=NestedBorrowsReturned
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! A function returning a reborrow of a structure which holds mutable borrows
+//! of an inner region, through two levels of ignored mutable borrows: the
+//! backward function of the inner region is staged (see
+//! `Pure.back_sg_info.early`), and the return abstraction of its body has
+//! positions at level 1 (the value given back to the returned reborrow).
+
+pub struct Runtime {
+    pub raised: u32,
+}
+
+pub struct Native {
+    pub polls: u32,
+}
+
+pub struct LowerCtx<'p> {
+    pub runtime: &'p mut Runtime,
+    pub native: &'p mut Native,
+    pub depth: u32,
+}
+
+impl<'p> LowerCtx<'p> {
+    pub fn step(&mut self, x: u32) -> u32 {
+        self.runtime.raised = self.runtime.raised.wrapping_add(x);
+        self.native.polls = self.native.polls.wrapping_add(1);
+        x.wrapping_add(self.depth)
+    }
+}
+
+pub struct W<'a, 'p> {
+    pub c: &'a mut LowerCtx<'p>,
+}
+
+pub fn step_through<'b, 'a, 'p>(w: &'b mut W<'a, 'p>, x: u32) -> u32 {
+    w.c.step(x)
+}
+
+/// The value given back to the returned reborrow is the context of `w`.
+pub fn ctx_of<'b, 'a, 'p>(w: &'b mut W<'a, 'p>) -> &'b mut LowerCtx<'p> {
+    &mut *w.c
+}
+
+/// The returned context is put in a new wrapper.
+pub fn drive_returned(raised: u32, x: u32) -> (u32, u32, u32) {
+    let mut rt = Runtime { raised };
+    let mut nv = Native { polls: 0 };
+    let r = {
+        let mut cx = LowerCtx { runtime: &mut rt, native: &mut nv, depth: 2 };
+        let mut w = W { c: &mut cx };
+        let a = step_through(&mut w, x);
+        let c = ctx_of(&mut w);
+        let mut w2 = W { c };
+        step_through(&mut w2, a)
+    };
+    (r, rt.raised, nv.polls)
+}
+
+/// The caller updates the returned context directly.
+pub fn drive_direct(raised: u32, x: u32, depth: u32) -> (u32, u32, u32) {
+    let mut rt = Runtime { raised };
+    let mut nv = Native { polls: 0 };
+    let r = {
+        let mut cx = LowerCtx { runtime: &mut rt, native: &mut nv, depth: 1 };
+        let mut w = W { c: &mut cx };
+        let c = ctx_of(&mut w);
+        c.depth = depth;
+        c.runtime.raised = c.runtime.raised.wrapping_mul(2);
+        c.step(x)
+    };
+    (r, rt.raised, nv.polls)
+}
+
+/// The returned context is put in a wrapper, which is dropped; `w` is used
+/// again (the wrapper is a value given back which the caller dropped, see
+/// `nested-borrows-dropped.rs`).
+pub fn drive_returned_reuse(raised: u32, x: u32) -> (u32, u32, u32) {
+    let mut rt = Runtime { raised };
+    let mut nv = Native { polls: 0 };
+    let r = {
+        let mut cx = LowerCtx { runtime: &mut rt, native: &mut nv, depth: 2 };
+        let mut w = W { c: &mut cx };
+        let a = step_through(&mut w, x);
+        let c = ctx_of(&mut w);
+        let mut w2 = W { c };
+        let b = step_through(&mut w2, a);
+        b.wrapping_add(step_through(&mut w, b))
+    };
+    (r, rt.raised, nv.polls)
+}
+
+/// Two levels: the returned reborrow of the context.
+pub fn reborrow<'a, 'p>(c: &'a mut LowerCtx<'p>) -> &'a mut LowerCtx<'p> {
+    c
+}
+
+/// The returned reborrow is used and dropped, then the lender is updated
+/// directly and through a call.
+pub fn reborrow_then_lender(raised: u32, x: u32) -> (u32, u32, u32) {
+    let mut rt = Runtime { raised };
+    let mut nv = Native { polls: 0 };
+    let r = {
+        let mut cx = LowerCtx { runtime: &mut rt, native: &mut nv, depth: 1 };
+        let a = reborrow(&mut cx).step(x);
+        cx.runtime.raised = cx.runtime.raised.wrapping_mul(2);
+        cx.step(a)
+    };
+    (r, rt.raised, nv.polls)
+}
