+import NestedBorrowsAudit.NestedBorrowsAudit
+
+/-! Evaluate the model of `tests/src/nested-borrows-audit.rs` on the inputs
+    of its `native` test module and compare with the native results. -/
+
+namespace nested_borrows_audit.checks
+open Aeneas Aeneas.Std Result
+
+def u (x : Nat) : U32 := ⟨BitVec.ofNat _ x⟩
+
+def val {α β} (f : α → β) : Result α → Option β
+  | ok x => some (f x)
+  | _ => none
+
+def pair := fun (p : U32 × U32) => (p.1.val, p.2.val)
+def triple := fun (p : U32 × U32 × U32) => (p.1.val, p.2.1.val, p.2.2.val)
+
+def bumpUpdateBetween (n : Nat) := val triple (bump_update_between (u n))
+def bumpUpdateLender (n : Nat) := val pair (bump_update_lender (u n))
+def bumpOwnedOnce (n : Nat) := val pair (bump_owned_once (u n))
+def wrapperReused (r x : Nat) := val pair (wrapper_reused (u r) (u x))
+
+#guard bumpUpdateBetween 0 == some (1, 4, 14)
+#guard bumpUpdateBetween 4294967295 == some (0, 1, 11)
+#guard bumpUpdateLender 1 == some (2, 10)
+#guard bumpOwnedOnce 0 == some (3, 2)
+#guard bumpOwnedOnce 4294967295 == some (1, 1)
+#guard wrapperReused 0 1 == some (21, 12)
+#guard wrapperReused 10 0 == some (18, 19)
+
+end nested_borrows_audit.checks
