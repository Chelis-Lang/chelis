+        assert_eq!(drive_returned(0, 1), (5, 4, 2));
+        assert_eq!(drive_returned(10, 5), (9, 22, 2));
+        assert_eq!(drive_returned(u32::MAX, u32::MAX), (3, u32::MAX, 2));
+    }
