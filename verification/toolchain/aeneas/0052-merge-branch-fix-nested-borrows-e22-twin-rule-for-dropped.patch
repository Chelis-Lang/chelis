+import NestedBorrowsReturned.NestedBorrowsReturned
+
+/-! Evaluate the model of `tests/src/nested-borrows-returned.rs` on the inputs
+    of its `native` test module and compare with the native results. -/
+
+namespace nested_borrows_returned.checks
+open Aeneas Aeneas.Std Result
+
+def u (x : Nat) : U32 := ⟨BitVec.ofNat _ x⟩
+
+def triple : Result (U32 × U32 × U32) → Option (Nat × Nat × Nat)
+  | ok (a, b, c) => some (a.val, b.val, c.val)
+  | _ => none
+
+def returned (raised x : Nat) := triple (drive_returned (u raised) (u x))
+def direct (raised x depth : Nat) :=
+  triple (drive_direct (u raised) (u x) (u depth))
+def returnedReuse (raised x : Nat) := triple (drive_returned_reuse (u raised) (u x))
+def reborrowThenLender (raised x : Nat) :=
+  triple (reborrow_then_lender (u raised) (u x))
+
+#guard returned 0 1 == some (5, 4, 2)
+#guard returned 10 5 == some (9, 22, 2)
+#guard returned 4294967295 4294967295 == some (3, 4294967295, 2)
+
+#guard direct 3 4 5 == some (9, 10, 1)
+#guard direct 0 0 0 == some (0, 0, 1)
+#guard direct 4294967295 2 4294967295 == some (1, 0, 1)
+
+#guard returnedReuse 0 1 == some (12, 9, 3)
+#guard returnedReuse 5 0 == some (10, 11, 3)
+
+#guard reborrowThenLender 0 1 == some (3, 4, 2)
+#guard reborrowThenLender 5 2 == some (4, 17, 2)
+
+end nested_borrows_returned.checks
