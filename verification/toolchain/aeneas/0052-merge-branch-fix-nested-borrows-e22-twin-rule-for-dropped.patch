+//@ [!lean] skip
+//@ [lean] subdir=NestedBorrowsAudit
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Native comparisons for the rules which select the values of the stages of
+//! staged backward functions (see `.work/diag/nb/DESIGN-4LEVELS.md`, section
+//! 5): each function would expose a stage which receives a snapshot of a
+//! value instead of its final value.
+
+/// Four levels for the region of `C::r`.
+pub struct C<'a> {
+    pub r: &'a mut u32,
+}
+
+pub struct W<'a, 'b> {
+    pub c: &'a mut C<'b>,
+}
+
+pub struct O<'a, 'b, 'c> {
+    pub w: &'a mut W<'b, 'c>,
+}
+
+/// Carriers of ancestor given-back values (section 5.3): the backward function
+/// of the region of `C::r` receives the structures given back to the ancestor
+/// regions.
+pub fn bump(o: &mut O<'_, '_, '_>) -> u32 {
+    *o.w.c.r = (*o.w.c.r).wrapping_add(1);
+    *o.w.c.r
+}
+
+/// Two calls; the caller updates the innermost value through the structures
+/// between them and after them.
+pub fn bump_update_between(n: u32) -> (u32, u32, u32) {
+    let mut n = n;
+    let (a, b) = {
+        let mut c = C { r: &mut n };
+        let mut w = W { c: &mut c };
+        let mut o = O { w: &mut w };
+        let a = bump(&mut o);
+        *o.w.c.r = (*o.w.c.r).wrapping_mul(3);
+        let b = bump(&mut o);
+        *o.w.c.r = (*o.w.c.r).wrapping_add(10);
+        (a, b)
+    };
+    (a, b, n)
+}
+
+/// The caller updates the innermost value through the inner structure `c`
+/// (the lender of `W::c`) after the call.
+pub fn bump_update_lender(n: u32) -> (u32, u32) {
+    let mut n = n;
+    let a = {
+        let mut c = C { r: &mut n };
+        let a = {
+            let mut w = W { c: &mut c };
+            let mut o = O { w: &mut w };
+            bump(&mut o)
+        };
+        *c.r = (*c.r).wrapping_mul(5);
+        a
+    };
+    (a, n)
+}
+
+/// Ancestor values in the stages of ancestor calls (section 5.5): `O` is
+/// received by value, and the callee calls `bump` twice on it.
+pub fn bump_owned(o: O<'_, '_, '_>) -> u32 {
+    let mut o = o;
+    let a = bump(&mut o);
+    a.wrapping_add(bump(&mut o))
+}
+
+pub fn bump_owned_once(n: u32) -> (u32, u32) {
+    let mut n = n;
+    let a = {
+        let mut c = C { r: &mut n };
+        let mut w = W { c: &mut c };
+        bump_owned(O { w: &mut w })
+    };
+    (a, n)
+}
+
+/// Three levels through a wrapper of a context.
+pub struct Runtime {
+    pub raised: u32,
+}
+
+pub struct LowerCtx<'p> {
+    pub runtime: &'p mut Runtime,
+    pub depth: u32,
+}
+
+pub struct Wr<'a, 'p> {
+    pub c: &'a mut LowerCtx<'p>,
+}
+
+pub fn step(c: &mut LowerCtx<'_>, x: u32) -> u32 {
+    c.runtime.raised = c.runtime.raised.wrapping_add(x);
+    x.wrapping_add(c.depth)
+}
+
+pub fn step_through<'b, 'a, 'p>(w: &'b mut Wr<'a, 'p>, x: u32) -> u32 {
+    step(w.c, x)
+}
+
+/// Three levels: a wrapper around the context is passed to two calls, then
+/// its borrow is used directly.
+pub fn wrapper_reused(raised: u32, x: u32) -> (u32, u32) {
+    let mut rt = Runtime { raised };
+    let r = {
+        let mut cx = LowerCtx { runtime: &mut rt, depth: 3 };
+        let mut w = Wr { c: &mut cx };
+        let a = step_through(&mut w, x);
+        let b = step_through(&mut w, a);
+        let c = step(w.c, b);
+        a.wrapping_add(b).wrapping_add(c)
+    };
+    (r, rt.raised)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn bump_native() {
+        assert_eq!(bump_update_between(0), (1, 4, 14));
+        assert_eq!(bump_update_between(u32::MAX), (0, 1, 11));
+        assert_eq!(bump_update_lender(1), (2, 10));
+        assert_eq!(bump_owned_once(0), (3, 2));
+        assert_eq!(bump_owned_once(u32::MAX), (1, 1));
+    }
+
+    #[test]
+    fn wrapper_reused_native() {
+        assert_eq!(wrapper_reused(0, 1), (21, 12));
+        assert_eq!(wrapper_reused(10, 0), (18, 19));
+    }
+}
