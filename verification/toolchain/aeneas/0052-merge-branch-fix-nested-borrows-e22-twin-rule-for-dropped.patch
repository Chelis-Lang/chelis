+    }
+
+    #[test]
+    fn reborrow_native() {
+        assert_eq!(reborrow_then_lender(0, 1), (3, 4, 2));
+        assert_eq!(reborrow_then_lender(5, 2), (4, 17, 2));
+    }
+}
