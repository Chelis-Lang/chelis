@@ -0,0 +1,155 @@
+//@ [!lean] skip
+//@ [lean] subdir=NestedBorrowsDropped
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! A caller drops a value given back to it which holds an ignored mutable
+//! borrow (a wrapper around a reborrow), then keeps using the lender of that
+//! borrow. The later stages of the staged backward function of the call which
+//! gave the wrapper back receive, on the positions under the dropped borrow,
+//! the values given back to its lender (the borrow ends without update), not
+//! the value of the wrapper when it was dropped.
+
+pub struct Runtime {
+    pub raised: u32,
+}
+
+pub struct Native {
+    pub polls: u32,
+}
+
+pub struct LowerCtx<'p> {
+    pub runtime: &'p mut Runtime,
+    pub native: &'p mut Native,
+    pub depth: u32,
+}
+
+impl<'p> LowerCtx<'p> {
+    pub fn step(&mut self, x: u32) -> u32 {
+        self.runtime.raised = self.runtime.raised.wrapping_add(x);
+        self.native.polls = self.native.polls.wrapping_add(1);
+        x.wrapping_add(self.depth)
+    }
+}
+
+pub struct W<'a, 'p> {
+    pub c: &'a mut LowerCtx<'p>,
+}
+
+/// Three levels for the region `'p`.
+pub fn step_through<'b, 'a, 'p>(w: &'b mut W<'a, 'p>, x: u32) -> u32 {
+    w.c.step(x)
+}
+
+/// The wrapper `w2` reborrows `*w.c`; it is dropped after the second call and
+/// `w` is used again.
+pub fn drive_local(raised: u32, x: u32) -> (u32, u32, u32) {
+    let mut rt = Runtime { raised };
+    let mut nv = Native { polls: 0 };
+    let r = {
+        let mut cx = LowerCtx { runtime: &mut rt, native: &mut nv, depth: 2 };
+        let mut w = W { c: &mut cx };
+        let a = step_through(&mut w, x);
+        let mut w2 = W { c: &mut *w.c };
+        let b = step_through(&mut w2, a);
+        b.wrapping_add(step_through(&mut w, b))
+    };
+    (r, rt.raised, nv.polls)
+}
+
+/// The lender is updated directly (not through a call) after the drop.
+pub fn drive_direct(raised: u32, x: u32) -> (u32, u32, u32) {
+    let mut rt = Runtime { raised };
+    let mut nv = Native { polls: 0 };
+    let r = {
+        let mut cx = LowerCtx { runtime: &mut rt, native: &mut nv, depth: 3 };
+        let mut w = W { c: &mut cx };
+        let mut w2 = W { c: &mut *w.c };
+        let a = step_through(&mut w2, x);
+        w.c.runtime.raised = w.c.runtime.raised.wrapping_add(100);
+        w.c.native.polls = w.c.native.polls.wrapping_add(10);
+        a
+    };
+    (r, rt.raised, nv.polls)
+}
+
+/// Two wrappers of the same lender, both dropped, the lender used last.
+pub fn drive_two_wrappers(raised: u32, x: u32) -> (u32, u32, u32) {
+    let mut rt = Runtime { raised };
+    let mut nv = Native { polls: 0 };
+    let r = {
+        let mut cx = LowerCtx { runtime: &mut rt, native: &mut nv, depth: 1 };
+        let mut w = W { c: &mut cx };
+        let mut w2 = W { c: &mut *w.c };
+        let a = step_through(&mut w2, x);
+        let mut w3 = W { c: &mut *w.c };
+        let b = step_through(&mut w3, a);
+        let d = step_through(&mut w, b);
+        a.wrapping_add(b).wrapping_add(d)
+    };
+    (r, rt.raised, nv.polls)
+}
+
+/// Four levels for the innermost borrow.
+pub fn incr4<'a, 'b, 'c, 'd>(x: &'a mut &'b mut &'c mut &'d mut u32) {
+    ****x = (****x).wrapping_add(1);
+}
+
+/// The wrapper `r3b` reborrows `*r3`; it is dropped and `r3` is used again.
+pub fn incr4_reuse(v: u32) -> u32 {
+    let mut v = v;
+    {
+        let mut r1 = &mut v;
+        let mut r2 = &mut r1;
+        let mut r3 = &mut r2;
+        incr4(&mut r3);
+        let mut r3b = &mut *r3;
+        incr4(&mut r3b);
+        incr4(&mut r3);
+    }
+    v
+}
+
+/// The lender is updated directly after the drop.
+pub fn incr4_reuse_direct(v: u32, d: u32) -> u32 {
+    let mut v = v;
+    {
+        let mut r1 = &mut v;
+        let mut r2 = &mut r1;
+        let mut r3 = &mut r2;
+        let mut r3b = &mut *r3;
+        incr4(&mut r3b);
+        ***r3 = (***r3).wrapping_add(d);
+    }
+    v
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn drive_local_native() {
+        assert_eq!(drive_local(0, 1), (12, 9, 3));
+        assert_eq!(drive_local(5, 0), (10, 11, 3));
+        assert_eq!(drive_local(u32::MAX, 3), (16, 14, 3));
+    }
+
+    #[test]
+    fn drive_direct_native() {
+        assert_eq!(drive_direct(0, 1), (4, 101, 11));
+        assert_eq!(drive_direct(u32::MAX, 0), (3, 99, 11));
+    }
+
+    #[test]
+    fn drive_two_wrappers_native() {
+        assert_eq!(drive_two_wrappers(0, 1), (9, 6, 3));
+        assert_eq!(drive_two_wrappers(10, 0), (6, 13, 3));
+    }
+
+    #[test]
+    fn incr4_reuse_native() {
+        assert_eq!(incr4_reuse(0), 3);
+        assert_eq!(incr4_reuse(u32::MAX - 1), 1);
+        assert_eq!(incr4_reuse_direct(1, 10), 12);
+        assert_eq!(incr4_reuse_direct(u32::MAX, 5), 5);
+    }
+}
