+/-- `core::str::Lines<'a>` (core/src/str/iter.rs, rustc 1.95) is
+    `Map<SplitInclusive<'a, char>, LinesMap>` over `'\n'`. The model keeps
+    the split's unsearched remainder `haystack[start..end]` and its `finished`
+    flag; the byte `0x0A` is exactly the encoding of `'\n'` in UTF-8. -/
+@[rust_type "core::str::iter::Lines" (body := .opaque)]
+structure core.str.iter.Lines where
+  rest : Str
+  finished : Bool
+
+/-- `str::lines` (core/src/str/mod.rs): `Lines(self.split_inclusive('\n').map(LinesMap))`. -/
+@[rust_fun "core::str::{str}::lines"]
+def core.str.Str.lines (s : Str) : Result core.str.iter.Lines :=
+  .ok { rest := s, finished := false }
+
+/-- `LinesMap` (core/src/str/mod.rs): strip one trailing `'\n'`, and then, only
+    if there was one, one `'\r'` before it. A lone trailing `'\r'` stays. -/
+def core.str.iter.Lines.strip (line : List U8) : List U8 :=
+  if line.getLast?.map (·.val) = some 0x0A then
+    if line.dropLast.getLast?.map (·.val) = some 0x0D then line.dropLast.dropLast
+    else line.dropLast
+  else line
+
+theorem core.str.iter.Lines.strip_length (line : List U8) :
+    (core.str.iter.Lines.strip line).length ≤ line.length := by
+  unfold core.str.iter.Lines.strip
+  split
+  · split <;> simp only [List.length_dropLast] <;> omega
+  · exact Nat.le_refl _
+
+/-- A sub-list of a string view is a string view. -/
+def core.str.iter.Lines.view (s : Str) (bytes : List U8) (h : bytes.length ≤ s.val.length) :
+    Str :=
+  ⟨bytes, Nat.le_trans h s.property⟩
+
+/-- `Lines::next` = `SplitInternal::next_inclusive` then `LinesMap`
+    (core/src/str/iter.rs): the text up to and including the next `'\n'`;
+    at the last match, `get_end` yields the unterminated remainder only if it
+    is nonempty (`allow_trailing_empty` is false), and finishes. -/
+@[rust_fun
+  "core::str::iter::{core::iter::traits::iterator::Iterator<core::str::iter::Lines<'a>, &'a str>}::next"]
+def core.str.iter.IteratorLines.next (self : core.str.iter.Lines) :
+    Result (Option Str × core.str.iter.Lines) :=
+  if self.finished then .ok (none, self)
+  else
+    match self.rest.val.findIdx? (fun byte => byte.val = 0x0A) with
+    | some index =>
+      let line := self.rest.val.take (index + 1)
+      .ok (some (core.str.iter.Lines.view self.rest (core.str.iter.Lines.strip line)
+          (Nat.le_trans (core.str.iter.Lines.strip_length line) (List.length_take_le' _ _))),
+        { rest := core.str.iter.Lines.view self.rest (self.rest.val.drop (index + 1))
+            (by simp only [List.length_drop]; omega),
+          finished := false })
+    | none =>
+      let finished := { self with finished := true }
+      if self.rest.val.isEmpty then .ok (none, finished)
+      else
+        .ok (some (core.str.iter.Lines.view self.rest (core.str.iter.Lines.strip self.rest.val)
+            (core.str.iter.Lines.strip_length self.rest.val)), finished)
