+/-! ## `chelis_ir::lowering_runtime`
+
+The trusted primitive boundary of lowering (`crates/chelis-ir/src/lowering_runtime.rs`).
+Each model below implements the primitive's `/// Model:` line. The shell-only items
+(`with_native_lowering_runtime`, `install_chelis_panic_hook`, the process hook, the
+thread-local and process-global state) are deliberately unmodeled: an extracted
+reference to one fails closed as an unknown external. -/
+
+/-- `chelis_ir::lowering_runtime::LoweringRuntime`: the handle names this thread's
+    lowering state, which the model threads explicitly.
+    * `u`, `o`: the speculation and quiet-output flags.
+    * `hook`: the `(u, o)` flags at every raise, oldest first. The process hook's
+      observable behavior depends only on them: when neither is set it forwards to
+      the previous hook, which prints the same `Box<dyn Any>` description for both
+      payload types. The payload type itself is static: `observe_raise` has exactly
+      two monomorphic callers (`raise_unrepresentable` with `UnrepresentableDag`,
+      `raise_lowering_diagnostic` with `LowerDiagnostic`).
+    * `builds`: the persistent summary-probe count.
+    * `nextPreflightFrame`: this thread's next tensor-helper preflight frame id.
+    * `hostVar n`: the `n`-th id this thread draws from the process-global host
+      inference-variable supply (other threads may draw in between);
+      `hostVarsTaken` counts the draws.
+    * `profileEnv n`: whether `CHELIS_PROFILE_COMPILE_CONTEXT_DETAIL` equals `1` at
+      the `n`-th read (the environment is process-global and mutable);
+      `profileEnvReads` counts the reads.
+    * `profileMarks`: the number of profiling clocks of this thread; a mark `m`
+      names a clock iff `1 ≤ m ≤ profileMarks`. Clock readings only reach stderr. -/
+@[rust_type "chelis_ir::lowering_runtime::LoweringRuntime" (body := .opaque)]
+structure chelis_ir.lowering_runtime.LoweringRuntime where
+  u : Bool
+  o : Bool
+  hook : List (Bool × Bool)
+  builds : U64
+  nextPreflightFrame : U64
+  hostVar : Nat → U32
+  hostVarsTaken : Nat
+  profileEnv : Nat → Bool
+  profileEnvReads : Nat
+  profileMarks : Usize
+
+namespace chelis_ir.lowering_runtime
+
+/-- `resume_native_unwind`: the unwind leaves the enclosing native entry, outside
+    the modeled domain. -/
+@[rust_fun "chelis_ir::lowering_runtime::resume_native_unwind"]
+def resume_native_unwind {P : Type} (_anyInst : core.any.Any P) (_payload : P) :
+    Result Never :=
+  .fail .panic
+
+/-- `scoped`: `let t := enter s; let r := body s; exit s t; r`. A native unwind
+    out of `body` (after which `exit` also runs) is outside the modeled domain:
+    the failure of `body` propagates. -/
+@[rust_fun "chelis_ir::lowering_runtime::scoped"]
+def «scoped» {S T R Enter Exit Body : Type}
+    (enterInst : core.ops.function.FnOnceMutArg Enter S T)
+    (exitInst : core.ops.function.FnOnceMutArgPair Exit S T Unit)
+    (bodyInst : core.ops.function.FnOnceMutArg Body S R)
+    (state : S) (enter : Enter) (exit : Exit) (body : Body) : Result (R × S) := do
+  let (token, state) ← enterInst.call_once enter state
+  let (result, state) ← bodyInst.call_once body state
+  let ((), state) ← exitInst.call_once exit (state, token)
+  .ok (result, state)
+
+/-- `grow_stack_if_needed`: `f state`. The stack segment `f` runs on is not
+    observable (a failed segment allocation aborts the process, like any
+    allocation failure). -/
+@[rust_fun "chelis_ir::lowering_runtime::grow_stack_if_needed"]
+def grow_stack_if_needed {S R F : Type} (fInst : core.ops.function.FnOnceMutArg F S R)
+    (state : S) (_redZone _stackSize : Usize) (f : F) : Result (R × S) :=
+  fInst.call_once f state
+
+namespace LoweringRuntime
+
+/-- `unrepresentable_panic_suppressed`: read `u`. -/
+@[rust_fun
+  "chelis_ir::lowering_runtime::{chelis_ir::lowering_runtime::LoweringRuntime}::unrepresentable_panic_suppressed"]
+def unrepresentable_panic_suppressed (s : LoweringRuntime) : Result (Bool × LoweringRuntime) :=
+  .ok (s.u, s)
+
+/-- `set_unrepresentable_panic_suppressed`: `u := value`. -/
+@[rust_fun
+  "chelis_ir::lowering_runtime::{chelis_ir::lowering_runtime::LoweringRuntime}::set_unrepresentable_panic_suppressed"]
+def set_unrepresentable_panic_suppressed (s : LoweringRuntime) (value : Bool) :
+    Result LoweringRuntime :=
+  .ok { s with u := value }
+
+/-- `set_output_suppressed`: `o := value`. -/
+@[rust_fun
+  "chelis_ir::lowering_runtime::{chelis_ir::lowering_runtime::LoweringRuntime}::set_output_suppressed"]
+def set_output_suppressed (s : LoweringRuntime) (value : Bool) : Result LoweringRuntime :=
+  .ok { s with o := value }
+
+/-- `observe_raise`: append the current `(u, o)` to the hook trace and return the
+    payload (see `LoweringRuntime` for why the payload type is not recorded). -/
+@[rust_fun
+  "chelis_ir::lowering_runtime::{chelis_ir::lowering_runtime::LoweringRuntime}::observe_raise"]
+def observe_raise {P : Type} (_anyInst : core.any.Any P) (s : LoweringRuntime) (payload : P) :
+    Result (P × LoweringRuntime) :=
+  .ok (payload, { s with hook := s.hook ++ [(s.u, s.o)] })
+
+/-- `catch_native_unwind`: `o := true; let r := f self; o := false; r`. The
+    conversions `marker` and `message` apply only to an unexpected native unwind,
+    which is outside the modeled domain: the failure of `f` propagates. The grown
+    stack segment is not observable. -/
+@[rust_fun
+  "chelis_ir::lowering_runtime::{chelis_ir::lowering_runtime::LoweringRuntime}::catch_native_unwind"]
+def catch_native_unwind {T D F Marker Message : Type} (_cloneInst : core.clone.Clone D)
+    (fInst : core.ops.function.FnOnceMutArg F LoweringRuntime (core.result.Result T D))
+    (_markerInst : core.ops.function.FnOnce Marker Unit D)
+    (_messageInst : core.ops.function.FnOnce Message (Option String) D)
+    (s : LoweringRuntime) (f : F) (_marker : Marker) (_message : Message) :
+    Result (core.result.Result T D × LoweringRuntime) := do
+  let (result, s) ← fInst.call_once f { s with o := true }
+  .ok (result, { s with o := false })
+
+/-- `fresh_host_inference_var`: the next element of this thread's draws from the
+    process-global supply. -/
+@[rust_fun
+  "chelis_ir::lowering_runtime::{chelis_ir::lowering_runtime::LoweringRuntime}::fresh_host_inference_var"]
+def fresh_host_inference_var (s : LoweringRuntime) : Result (U32 × LoweringRuntime) :=
+  .ok (s.hostVar s.hostVarsTaken, { s with hostVarsTaken := s.hostVarsTaken + 1 })
+
+/-- `record_summary_probe_build`: `builds := min(builds + 1, u64::MAX)`. -/
+@[rust_fun
+  "chelis_ir::lowering_runtime::{chelis_ir::lowering_runtime::LoweringRuntime}::record_summary_probe_build"]
+def record_summary_probe_build (s : LoweringRuntime) : Result LoweringRuntime :=
+  .ok { s with builds := UScalar.saturating_add s.builds 1#u64 }
+
+/-- `summary_probe_builds`: read `builds`. -/
+@[rust_fun
+  "chelis_ir::lowering_runtime::{chelis_ir::lowering_runtime::LoweringRuntime}::summary_probe_builds"]
+def summary_probe_builds (s : LoweringRuntime) : Result (U64 × LoweringRuntime) :=
+  .ok (s.builds, s)
+
+/-- `reset_summary_probe_builds`: `builds := 0`. -/
+@[rust_fun
+  "chelis_ir::lowering_runtime::{chelis_ir::lowering_runtime::LoweringRuntime}::reset_summary_probe_builds"]
+def reset_summary_probe_builds (s : LoweringRuntime) : Result LoweringRuntime :=
+  .ok { s with builds := 0#u64 }
+
+/-- `fresh_preflight_frame`: return the next frame id and advance it, wrapping at
+    `u64::MAX`. -/
+@[rust_fun
+  "chelis_ir::lowering_runtime::{chelis_ir::lowering_runtime::LoweringRuntime}::fresh_preflight_frame"]
+def fresh_preflight_frame (s : LoweringRuntime) : Result (U64 × LoweringRuntime) :=
+  .ok (s.nextPreflightFrame,
+    { s with nextPreflightFrame := UScalar.wrapping_add s.nextPreflightFrame 1#u64 })
+
+/-- The private `profile_mark`: push one clock and return the new clock count.
+    The push fails like `Vec::push` beyond `usize::MAX` elements. -/
+def profile_mark (s : LoweringRuntime) : Result (Usize × LoweringRuntime) :=
+  if s.profileMarks.val < Usize.max then
+    let marks := UScalar.wrapping_add s.profileMarks 1#usize
+    .ok (marks, { s with profileMarks := marks })
+  else .fail .maximumSizeExceeded
+
+/-- `detail_profile_start`: read the environment; when it enables the detailed
+    profile, push a clock and return its mark, otherwise return `0`. -/
+@[rust_fun
+  "chelis_ir::lowering_runtime::{chelis_ir::lowering_runtime::LoweringRuntime}::detail_profile_start"]
+def detail_profile_start (s : LoweringRuntime) : Result (Usize × LoweringRuntime) :=
+  let enabled := s.profileEnv s.profileEnvReads
+  let s := { s with profileEnvReads := s.profileEnvReads + 1 }
+  if enabled then profile_mark s else .ok (0#usize, s)
+
+/-- `detail_profile_phase`: restarts the clock `mark` names and reports it on
+    stderr; neither is modeled state (the clock count does not change). -/
+@[rust_fun
+  "chelis_ir::lowering_runtime::{chelis_ir::lowering_runtime::LoweringRuntime}::detail_profile_phase"]
+def detail_profile_phase (s : LoweringRuntime) (_mark : Usize) (_label : Str) :
+    Result LoweringRuntime :=
+  .ok s
+
+/-- `detail_profile_declaration_start`: `0` for mark `0`, otherwise push a clock and
+    return its mark. -/
+@[rust_fun
+  "chelis_ir::lowering_runtime::{chelis_ir::lowering_runtime::LoweringRuntime}::detail_profile_declaration_start"]
+def detail_profile_declaration_start (s : LoweringRuntime) (mark : Usize) :
+    Result (Usize × LoweringRuntime) :=
+  if mark = 0#usize then .ok (0#usize, s) else profile_mark s
+
+/-- `detail_profile_declaration`: when `start` names a clock of this thread
+    (`profile_restart(start)` is `Some`), `*last_dag_size := dag_total`; the
+    elapsed time and node counts only reach stderr. -/
+@[rust_fun
+  "chelis_ir::lowering_runtime::{chelis_ir::lowering_runtime::LoweringRuntime}::detail_profile_declaration"]
+def detail_profile_declaration (s : LoweringRuntime) (start lastDagSize dagTotal : Usize)
+    (_name : Str) : Result (LoweringRuntime × Usize) :=
+  if start ≠ 0#usize ∧ start.val ≤ s.profileMarks.val then .ok (s, dagTotal)
+  else .ok (s, lastDagSize)
+
+/-- `report_internal`: one line on stderr, which is not modeled state. -/
+@[rust_fun
+  "chelis_ir::lowering_runtime::{chelis_ir::lowering_runtime::LoweringRuntime}::report_internal"]
+def report_internal (s : LoweringRuntime) (_line : Str) : Result LoweringRuntime :=
+  .ok s
+
+end LoweringRuntime
+
+end chelis_ir.lowering_runtime
+
 end Aeneas.Std
