+@[rust_fun
+  "core::str::iter::{core::iter::traits::iterator::Iterator<core::str::iter::Lines<'a>, &'a str>}::size_hint"]
+def core.str.iter.IteratorLines.size_hint (_self : core.str.iter.Lines) :
+    Result (Usize × Option Usize) :=
+  .ok (0#usize, none)
+
+/-- `Lines` overrides `next`, `size_hint` and `last` (as `next_back`, unmodeled);
+    `fold` and the other consumers are `Iterator`'s next-driven defaults.
+    `impl FusedIterator for Lines`. -/
+@[reducible, rust_trait_impl
+  "core::iter::traits::iterator::Iterator<core::str::iter::Lines<'a>, &'a str>"]
+def core.iter.traits.iterator.IteratorLines :
+  core.iter.traits.iterator.Iterator core.str.iter.Lines Str := {
+  next := core.str.iter.IteratorLines.next
+  size_hint := core.str.iter.IteratorLines.size_hint
+  fused := true
+}
