+#guard afterZeroR [5, 6] == some (.inl [])
+#guard afterZeroR [5, 0, 6, 200, 7] == some (.inr 200)
+#guard afterZeroR [300, 0, 6] == some (.inr 300)
+
+/-- `inl` (the number of keys, the value of key 3), `inr` the error. -/
