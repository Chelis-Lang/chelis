--- /dev/null
+++ b/tests/src/from-iter-loop-consumed.rs
@@ -0,0 +1,27 @@
+//@ [lean] known-failure
+//@ [!lean] skip
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! A custom `FromIterator` whose `from_iter` consumes its generic iterator
+//! inside its loop: with the `return` in the loop, the code after the loop
+//! (`iter.collect()`) is translated in the loop's break path. The final state
+//! of the iterator is then a value of the loop body, which the loop does not
+//! output (compare `from-iter-loop-state.rs`, where the loop outputs the
+//! iterator). The model of `from_iter` must return that state, so the
+//! function is rejected with an explicit error.
+
+pub struct AfterZero(pub Vec<u32>);
+
+impl FromIterator<u32> for AfterZero {
+    fn from_iter<I: IntoIterator<Item = u32>>(iter: I) -> Self {
+        let mut iter = iter.into_iter();
+        loop {
+            match iter.next() {
+                Some(0) => break,
+                Some(_) => {}
+                None => return AfterZero(Vec::new()),
+            }
+        }
+        AfterZero(iter.collect())
+    }
+}
diff --git a/tests/src/from-iter-loop-state.rs b/tests/src/from-iter-loop-state.rs
new file mode 100644
index 0000000..b299b18
--- /dev/null
+++ b/tests/src/from-iter-loop-state.rs
@@ -0,0 +1,131 @@
+//@ [!lean] skip
+//@ [lean] subdir=FromIterLoopState
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Custom `FromIterator` impls whose `from_iter` loops over the consumed
+//! generic iterator (`while iter.next().is_some()`, `loop`/`match`, and
+//! `for x in iter`). Their model returns the final state of that iterator next
+//! to the collection: collecting a `Result` reads the residual of the
+//! `GenericShunt` from it. The final state leaves the loop through the loop's
+//! output, since the loop only updates the iterator through `next(&mut iter)`.
+//! `AfterZero` consumes the iterator after its loop, on one of two paths. The
+//! map is the shape of `chelis_unord::UnordMap` (a `BTreeMap` behind a
+//! struct). `FromIterLoopState/Checks.lean` evaluates the models on the inputs
+//! of the `native` test module below and compares with the native results.
+use std::collections::BTreeMap;
+
+/// The size hints seen before every `next`, and after the last one.
+pub struct Hints(pub Vec<(usize, Option<usize>)>);
+
+impl FromIterator<u32> for Hints {
+    fn from_iter<I: IntoIterator<Item = u32>>(iter: I) -> Self {
+        let mut iter = iter.into_iter();
+        let mut hints = vec![iter.size_hint()];
+        while iter.next().is_some() {
+            hints.push(iter.size_hint());
+        }
+        Hints(hints)
+    }
+}
+
+pub fn shunt_hints(xs: &[u32]) -> Result<Vec<(usize, Option<usize>)>, u32> {
+    let hints = xs
+        .iter()
+        .map(|x| if *x == 0 { Err(0) } else { Ok(*x) })
+        .collect::<Result<Hints, u32>>()?;
+    Ok(hints.0)
+}
+
+pub fn plain_hints(xs: &[u32]) -> Vec<(usize, Option<usize>)> {
+    xs.iter().copied().collect::<Hints>().0
+}
+
+/// The items after the first zero; none if there is no zero.
+pub struct AfterZero(pub Vec<u32>);
+
+impl FromIterator<u32> for AfterZero {
+    fn from_iter<I: IntoIterator<Item = u32>>(iter: I) -> Self {
+        let mut iter = iter.into_iter();
+        let mut found = false;
+        loop {
+            match iter.next() {
+                Some(0) => {
+                    found = true;
+                    break;
+                }
+                Some(_) => {}
+                None => break,
+            }
+        }
+        if found {
+            AfterZero(iter.collect())
+        } else {
+            AfterZero(Vec::new())
+        }
+    }
+}
+
+/// Every item above 100 is an error.
+pub fn after_zero(xs: &[u32]) -> Result<Vec<u32>, u32> {
+    let rest = xs
+        .iter()
+        .map(|x| if *x > 100 { Err(*x) } else { Ok(*x) })
+        .collect::<Result<AfterZero, u32>>()?;
+    Ok(rest.0)
+}
+
+/// A map whose iteration order is not observable, like `chelis_unord::UnordMap`.
+pub struct Map<K, V> {
+    inner: BTreeMap<K, V>,
+}
+
+impl<K: Ord, V> FromIterator<(K, V)> for Map<K, V> {
+    fn from_iter<T: IntoIterator<Item = (K, V)>>(iter: T) -> Self {
+        let mut inner = BTreeMap::new();
+        for (key, value) in iter {
+            inner.insert(key, value);
+        }
+        Map { inner }
+    }
+}
+
+/// Doubles every key below the limit; the first key at or above it is the error.
+pub fn doubled(xs: &[u32], limit: u32) -> Result<(usize, Option<u32>), u32> {
+    let map = xs
+        .iter()
+        .map(|x| if *x < limit { Ok((*x, *x * 2)) } else { Err(*x) })
+        .collect::<Result<Map<u32, u32>, u32>>()?;
+    let three = match map.inner.get(&3) {
+        Some(value) => Some(*value),
+        None => None,
+    };
+    Ok((map.inner.len(), three))
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn hints() {
+        assert_eq!(shunt_hints(&[4, 5]), Ok(vec![(0, Some(2)), (0, Some(1)), (0, Some(0))]));
+        assert_eq!(shunt_hints(&[4, 0, 5]), Err(0));
+        assert_eq!(shunt_hints(&[]), Ok(vec![(0, Some(0))]));
+        assert_eq!(plain_hints(&[7, 8]), vec![(2, Some(2)), (1, Some(1)), (0, Some(0))]);
+    }
+
+    #[test]
+    fn after_zeros() {
+        assert_eq!(after_zero(&[5, 0, 6, 0, 7]), Ok(vec![6, 0, 7]));
+        assert_eq!(after_zero(&[5, 6]), Ok(vec![]));
+        assert_eq!(after_zero(&[5, 0, 6, 200, 7]), Err(200));
+        assert_eq!(after_zero(&[300, 0, 6]), Err(300));
+    }
+
+    #[test]
+    fn maps() {
+        assert_eq!(doubled(&[3, 1, 3], 10), Ok((2, Some(6))));
+        assert_eq!(doubled(&[1, 2], 10), Ok((2, None)));
+        assert_eq!(doubled(&[3, 12, 1, 15], 10), Err(12));
+    }
+}
diff --git a/tests/src/iter-mut-find.rs b/tests/src/iter-mut-find.rs
