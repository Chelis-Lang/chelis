diff --git a/backends/lean/Aeneas/Std/Core/Ops.lean b/backends/lean/Aeneas/Std/Core/Ops.lean
index a6bbc3a..052e5d4 100644
--- a/backends/lean/Aeneas/Std/Core/Ops.lean
+++ b/backends/lean/Aeneas/Std/Core/Ops.lean
@@ -79,6 +79,25 @@ structure core.ops.function.FnOnceMutArgMutArg (Self : Type u) (T : Type v) (U :
     (Output : Type x) where
   call_once : Self → (T × U) → Result (Output × T × U)
 
+/-- The specialization `FnOnce<(&'a &'b mut T,)>` that Charon's
+    `--monomorphize-mut` creates for a closure reading a mutable borrow through
+    a shared one (e.g. the predicate of `find` on a mutable slice iterator).
+    Nothing is given back through the shared borrow; the consumed closure state
+    is not returned. -/
+@[rust_trait "core::ops::function::FnOnce<@Self, (&'a &'b mut @T), @Output>"]
+structure core.ops.function.FnOnceSharedMutArg (Self : Type u) (T : Type v)
+    (Output : Type w) where
+  call_once : Self → T → Result Output
+
+/-- The specialization `FnMut<(&'a &'b mut T,)>` (see `FnOnceSharedMutArg`):
+    the call returns the closure state. -/
+@[rust_trait "core::ops::function::FnMut<@Self, (&'a &'b mut @T), @Output>"
+  (parentClauses := ["FnOnceInst"])]
+structure core.ops.function.FnMutSharedMutArg (Self : Type u) (T : Type v)
+    (Output : Type w) where
+  FnOnceInst : core.ops.function.FnOnceSharedMutArg Self T Output
+  call_mut : Self → T → Result (Output × Self)
+
 /-! ### Closure specializations at borrowing states
 
 A partial-monomorphization instance of a modeled function which threads a state
diff --git a/backends/lean/Aeneas/Std/SliceIter.lean b/backends/lean/Aeneas/Std/SliceIter.lean
index bd59adb..b3ac1af 100644
--- a/backends/lean/Aeneas/Std/SliceIter.lean
+++ b/backends/lean/Aeneas/Std/SliceIter.lean
@@ -53,6 +53,28 @@ def core.slice.iter.IteratorIterMut.next
     ok (some x, it, back)
   else ok (none, it, fun it _ => it)
 
+/-- `find` on a mutable slice iterator. core/src/slice/iter/macros.rs overrides
+    `Iterator::find` by a `next` loop: `while let Some(x) = self.next() { if
+    predicate(&x) { return Some(x); } } None`. The predicate only reads the
+    items, so the result is that of the `next` call which lent the found item
+    (or the exhausted one): the item, the iterator past it and the lens writing
+    it back. The consumed predicate state is not returned. -/
+@[rust_fun
+  "core::slice::iter::{core::iter::traits::iterator::Iterator<core::slice::iter::IterMut<'a, @T>, &'a mut @T>}::find"]
+def core.slice.iter.IteratorIterMut.find {T P : Type}
+    (fnInst : core.ops.function.FnMutSharedMutArg P T Bool)
+    (it : core.slice.iter.IterMut T) (predicate : P) :
+    Result ((Option T) × (core.slice.iter.IterMut T) ×
+            (core.slice.iter.IterMut T → Option T → core.slice.iter.IterMut T)) := do
+  let (item, it, back) ← core.slice.iter.IteratorIterMut.next it
+  match item with
+  | none => ok (none, it, back)
+  | some x =>
+    let (found, predicate) ← fnInst.call_mut predicate x
+    if found then ok (some x, it, back)
+    else core.slice.iter.IteratorIterMut.find fnInst it predicate
+partial_fixpoint
+
 @[rust_fun "core::slice::{[@T]}::iter_mut"]
 def core.slice.Slice.iter_mut {T : Type} (slice : Slice T) :
   Result ((core.slice.iter.IterMut T) × (core.slice.iter.IterMut T → Slice T)) :=
