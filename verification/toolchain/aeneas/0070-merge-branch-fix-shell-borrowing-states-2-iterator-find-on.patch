+/-! Evaluate the model of `tests/src/from-iter-loop-state.rs` on the inputs of its
+    `native` test module and compare with the native results. Collecting a
+    `Result` reads the residual from the final state of the `GenericShunt`, which
+    the custom `from_iter` returns after its loop. -/
+
+namespace from_iter_loop_state.checks
+open Aeneas Aeneas.Std Result
+
+def u (n : Nat) : U32 := ⟨BitVec.ofNat _ n⟩
+
+def slice (xs : List Nat) : Slice U32 :=
+  let xs := xs.map u
+  if h : xs.length ≤ Usize.max then ⟨xs, h⟩ else ⟨[], by simp⟩
+
+def hintList (v : alloc.vec.Vec (Usize × Option Usize)) : List (Nat × Option Nat) :=
+  v.val.map fun (lo, hi) => (lo.val, hi.map (·.val))
+
+/-- `inl` the hints, `inr` the error. -/
+def shuntR (xs : List Nat) : Option (List (Nat × Option Nat) ⊕ Nat) :=
+  match shunt_hints (slice xs) with
+  | ok (core.result.Result.Ok v) => some (.inl (hintList v))
+  | ok (core.result.Result.Err e) => some (.inr e.val)
+  | _ => none
+
+#guard shuntR [4, 5] == some (.inl [(0, some 2), (0, some 1), (0, some 0)])
+#guard shuntR [4, 0, 5] == some (.inr 0)
+#guard shuntR [] == some (.inl [(0, some 0)])
+
+def plainR (xs : List Nat) : Option (List (Nat × Option Nat)) :=
+  match plain_hints (slice xs) with
+  | ok v => some (hintList v)
+  | _ => none
+
+#guard plainR [7, 8] == some [(2, some 2), (1, some 1), (0, some 0)]
+
+/-- `inl` the items after the first zero, `inr` the error. -/
+def afterZeroR (xs : List Nat) : Option (List Nat ⊕ Nat) :=
+  match after_zero (slice xs) with
+  | ok (core.result.Result.Ok v) => some (.inl (v.val.map (·.val)))
+  | ok (core.result.Result.Err e) => some (.inr e.val)
+  | _ => none
+
