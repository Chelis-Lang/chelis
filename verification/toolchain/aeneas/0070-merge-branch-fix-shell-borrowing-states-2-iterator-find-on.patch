+++ b/tests/src/iter-mut-find.rs
@@ -0,0 +1,112 @@
+//@ [!lean] skip
+//@ [lean] subdir=IterMutFind
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! `Iterator::find` on a mutable slice iterator. Charon's `--monomorphize-mut`
+//! specializes `find` at the predicate bound `FnMut<(&&'a mut T,)>`; the model
+//! (`core.slice.iter.IteratorIterMut.find`) is a lending state like `next`: the
+//! found item, the advanced iterator and the lens which writes the item back.
+//! The shapes are those of `chelis_ir::axis_sources` (update a found group or
+//! push a new one) and `chelis_ir::eval` (fold symbolic dimensions per name).
+//! `IterMutFind/Checks.lean` evaluates the models on the inputs of the `native`
+//! test module below and compares with the native results.
+
+/// Increments the count of `key` if present.
+pub fn bump(values: &mut Vec<(u32, u32)>, key: u32) -> bool {
+    match values.iter_mut().find(|(existing, _)| *existing == key) {
+        Some((_, count)) => {
+            *count += 1;
+            true
+        }
+        None => false,
+    }
+}
+
+/// Appends `entry` to the group of `claim`, or starts a new group.
+pub fn group(grouped: &mut Vec<(u32, Vec<u32>)>, claim: u32, entry: u32) {
+    match grouped.iter_mut().find(|(existing, _)| *existing == claim) {
+        Some((_, members)) => members.push(entry),
+        None => grouped.push((claim, vec![entry])),
+    }
+}
+
+/// One value per name; `None` once two values of a name disagree.
+pub fn fold(per_scope: Vec<(u32, u64)>) -> Vec<(u32, Option<u64>)> {
+    let mut folded: Vec<(u32, Option<u64>)> = Vec::new();
+    for (name, value) in per_scope {
+        match folded.iter_mut().find(|(existing, _)| *existing == name) {
+            Some((_, resolved)) => {
+                if *resolved != Some(value) {
+                    *resolved = None;
+                }
+            }
+            None => folded.push((name, Some(value))),
+        }
+    }
+    folded
+}
+
+/// `find` resumes after the item it found: the second search starts past the
+/// first match, and both matches are updated through the same iterator.
+pub fn bump_twice(values: &mut [u32], key: u32) -> (bool, bool) {
+    let mut it = values.iter_mut();
+    let first = match it.find(|x| **x == key) {
+        Some(x) => {
+            *x += 1;
+            true
+        }
+        None => false,
+    };
+    let second = match it.find(|x| **x == key) {
+        Some(x) => {
+            *x += 10;
+            true
+        }
+        None => false,
+    };
+    (first, second)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn bump_updates_the_first_match() {
+        let mut values = vec![(1, 0), (2, 5), (2, 7)];
+        assert!(bump(&mut values, 2));
+        assert_eq!(values, vec![(1, 0), (2, 6), (2, 7)]);
+        assert!(!bump(&mut values, 3));
+        assert_eq!(values, vec![(1, 0), (2, 6), (2, 7)]);
+    }
+
+    #[test]
+    fn group_appends_or_pushes() {
+        let mut grouped = vec![(4, vec![1]), (5, vec![])];
+        group(&mut grouped, 5, 9);
+        group(&mut grouped, 6, 3);
+        group(&mut grouped, 4, 2);
+        assert_eq!(grouped, vec![(4, vec![1, 2]), (5, vec![9]), (6, vec![3])]);
+    }
+
+    #[test]
+    fn fold_resolves_per_name() {
+        assert_eq!(
+            fold(vec![(1, 8), (2, 3), (1, 8), (2, 4), (3, 0)]),
+            vec![(1, Some(8)), (2, None), (3, Some(0))]
+        );
+    }
+
+    #[test]
+    fn bump_twice_updates_both_matches() {
+        let mut values = [7, 1, 7, 7];
+        assert_eq!(bump_twice(&mut values, 7), (true, true));
+        assert_eq!(values, [8, 1, 17, 7]);
+        let mut values = [1, 7, 2];
+        assert_eq!(bump_twice(&mut values, 7), (true, false));
+        assert_eq!(values, [1, 8, 2]);
+        let mut values = [1, 2];
+        assert_eq!(bump_twice(&mut values, 7), (false, false));
+        assert_eq!(values, [1, 2]);
+    }
+}
