+def bumpR (xs : List (Nat × Nat)) (key : Nat) : Option (Bool × List (Nat × Nat)) :=
+  match bump (vec (xs.map fun (a, b) => (u a, u b))) (u key) with
+  | ok (found, v) => some (found, v.val.map fun (a, b) => (a.val, b.val))
+  | _ => none
+
+#guard bumpR [(1, 0), (2, 5), (2, 7)] 2 == some (true, [(1, 0), (2, 6), (2, 7)])
+#guard bumpR [(1, 0), (2, 6), (2, 7)] 3 == some (false, [(1, 0), (2, 6), (2, 7)])
+
+def groups (v : alloc.vec.Vec (U32 × alloc.vec.Vec U32)) : List (Nat × List Nat) :=
+  v.val.map fun (c, m) => (c.val, m.val.map (·.val))
+
+def groupR : Option (List (Nat × List Nat)) :=
+  match (do
+    let g ← group (vec [(u 4, vec [u 1]), (u 5, vec [])]) (u 5) (u 9)
+    let g ← group g (u 6) (u 3)
+    group g (u 4) (u 2)) with
+  | ok g => some (groups g)
+  | _ => none
