new file mode 100644
index 0000000..d8a7405
--- /dev/null
+++ b/backends/lean/Aeneas/Std/LawfulIterator.lean
@@ -0,0 +1,85 @@
+import Aeneas.Std.VecIter
+import Aeneas.Std.ArrayIter
+import Aeneas.Std.BTreeMap
+import Aeneas.Std.BTreeSet
+import Aeneas.Std.IteratorSources
+
+/-!
+# Lawful iterator dictionaries
+
+Rust's collectors pick their consumer by specialization on the concrete
+iterator type: `Vec`'s `FromIterator` and `Extend` use `next` (with `size_hint`
+for capacity), `for_each` (= `fold`) under `TrustedLen`, or `try_fold` for
+in-place collection; `BTreeMap`/`BTreeSet` collect into a `Vec` first and
+extend through `for_each`. The collection models consume through `next` (or
+the dictionary's `fold`) and never call `size_hint`, so capacity hints cannot
+affect a model's value.
+
+A dictionary is *lawful* when every consumer path equals the left fold of its
+`next`: then each native specialization computes the model's value and
+callback schedule. Aeneas' collection admission (`CollectionContracts`)
+accepts a generic collector only by deferring its iterator dictionary to the
+callers, and discharges it only with reviewed iterators; correspondence
+theorems about a concrete call assume or prove `LawfulIterator` of the
+instance.
+-/
+
+namespace Aeneas.Std
+
+structure core.iter.traits.iterator.LawfulIterator {I Item : Type}
+    (it : core.iter.traits.iterator.Iterator I Item) : Prop where
+  fold_eq : ∀ {B F : Type} (fnInst : core.ops.function.FnMut F (B × Item) B)
+    (s : I) (init : B) (f : F),
+    it.fold fnInst s init f = core.iter.traits.iterator.foldFromNext it.next fnInst s init f
+  try_fold_eq : ∀ {B F R Residual : Type}
+    (fnInst : core.ops.function.FnMut F (B × Item) R)
+    (tryInst : core.ops.try_trait.Try R B Residual) (s : I) (init : B) (f : F),
+    it.try_fold fnInst tryInst s init f =
+      core.iter.traits.iterator.tryFoldFromNext it.next fnInst tryInst s init f
+
+namespace core.iter.traits.iterator.LawfulIterator
+
+/-- Dictionaries that keep the provided `fold`/`try_fold` are lawful. -/
+theorem of_defaults {I Item : Type} (next : I → Result (Option Item × I)) :
+    core.iter.traits.iterator.LawfulIterator
+      ({ next } : core.iter.traits.iterator.Iterator I Item) :=
+  ⟨fun _ _ _ _ => rfl, fun _ _ _ _ _ => rfl⟩
+
+theorem vecIntoIter (T : Type) :
+    core.iter.traits.iterator.LawfulIterator
+      (core.iter.traits.iterator.IteratorVecIntoIter T) :=
+  ⟨fun _ _ _ _ => rfl, fun _ _ _ _ _ => rfl⟩
+
+theorem arrayIntoIter (T : Type) (N : Usize) :
+    core.iter.traits.iterator.LawfulIterator
+      (core.iter.traits.iterator.IteratorArrayIntoIter T N) :=
+  ⟨fun _ _ _ _ => rfl, fun _ _ _ _ _ => rfl⟩
+
+theorem btreeIter (K V : Type) :
+    core.iter.traits.iterator.LawfulIterator
+      (core.iter.traits.iterator.IteratorBTreeIter K V) :=
+  ⟨fun _ _ _ _ => rfl, fun _ _ _ _ _ => rfl⟩
+
+theorem btreeIntoIter (K V : Type) :
+    core.iter.traits.iterator.LawfulIterator
+      (core.iter.traits.iterator.IteratorBTreeIntoIter K V) :=
+  ⟨fun _ _ _ _ => rfl, fun _ _ _ _ _ => rfl⟩
+
+theorem btreeSetIntoIter (T : Type) :
+    core.iter.traits.iterator.LawfulIterator
+      (core.iter.traits.iterator.IteratorBTreeSetIntoIter T) :=
+  ⟨fun _ _ _ _ => rfl, fun _ _ _ _ _ => rfl⟩
+
+theorem btreeSetIter (T : Type) :
+    core.iter.traits.iterator.LawfulIterator
+      (core.iter.traits.iterator.IteratorBTreeSetIter T) :=
+  ⟨fun _ _ _ _ => rfl, fun _ _ _ _ _ => rfl⟩
+
+theorem once (T : Type) :
+    core.iter.traits.iterator.LawfulIterator
+      (core.iter.traits.iterator.IteratorOnce T) :=
+  ⟨fun _ _ _ _ => rfl, fun _ _ _ _ _ => rfl⟩
+
+end core.iter.traits.iterator.LawfulIterator
+
+end Aeneas.Std
