diff --git a/tests/src/nested-borrows-join-snapshot-model.rs b/tests/src/nested-borrows-join-snapshot-model.rs
new file mode 100644
index 0000000..2f64d0d
--- /dev/null
+++ b/tests/src/nested-borrows-join-snapshot-model.rs
@@ -0,0 +1,173 @@
+//@ [!lean] skip
+//@ [lean] subdir=NestedBorrowsJoinSnapshotModel
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::iter::adapters::map::Map --include core::iter::adapters::skip::Skip
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! A join after collecting `xs.iter().map(|x| f(x, sink))`, the closure
+//! capturing a mutable borrow of a context which holds mutable borrows: in the
+//! branches which do not use the context, the borrow of the closure is still
+//! live at the join, so the continuation of the join abstraction of the inner
+//! region applies the first stage of the staged backward function of
+//! `Iterator::map` in the snapshot of the join (the shapes of
+//! `chelis_types::deep_type::recovery::recover_tensor` and of
+//! `chelis_types::infer::vmap_extent::analyze_app`). Nothing records a nested
+//! loan update to recombine its output with. The backward function of `map`
+//! is synthesized by the model-state ABI and its last stage reads only the
+//! inputs of its first stage (the closure given back at the inner level): the
+//! snapshot computes the output of the in-order application.
+//!
+//! The callers write through the context after the call: the values given
+//! back after the join are those of the native program.
+
+pub struct Sink<'s> {
+    pub errors: &'s mut Vec<u32>,
+}
+
+fn dim(errors: &mut Sink<'_>, c: &u32) -> Result<u32, u32> {
+    if *c > 10 {
+        errors.errors.push(*c);
+        Err(*c)
+    } else {
+        Ok(*c + 1)
+    }
+}
+
+/// The `recover_tensor` shape: a write through the sink in one branch.
+pub fn recover(errors: &mut Sink<'_>, children: &[u32], p: u32) -> (u32, u32) {
+    let dims: Vec<Result<u32, u32>> = children.iter().map(|c| dim(errors, c)).collect();
+    let q = if p > 3 {
+        errors.errors.push(p);
+        p
+    } else {
+        p
+    };
+    (q, dims.len() as u32)
+}
+
+/// A write through the sink after the join.
+pub fn recover_then_write(errors: &mut Sink<'_>, children: &[u32], p: u32) -> u32 {
+    let dims: Vec<Result<u32, u32>> = children.iter().map(|c| dim(errors, c)).collect();
+    if p > 3 {
+        errors.errors.push(p);
+    }
+    errors.errors.push(90 + dims.len() as u32);
+    dims.len() as u32
+}
+
+/// A second closure over the sink after the join.
+pub fn recover_twice(errors: &mut Sink<'_>, children: &[u32], p: u32) -> u32 {
+    let d1: Vec<Result<u32, u32>> = children.iter().map(|c| dim(errors, c)).collect();
+    if p > 3 {
+        errors.errors.push(p);
+    }
+    let d2: Vec<Result<u32, u32>> = children.iter().map(|c| dim(errors, c)).collect();
+    (d1.len() + 10 * d2.len()) as u32
+}
+
+/// `(result, errors, first error, last error)`; the caller writes through the
+/// sink after the call.
+pub fn run_recover(which: u32, a: u32, b: u32, p: u32) -> (u32, u32, u32, u32) {
+    let mut v = Vec::new();
+    v.push(7);
+    let children = [a, b, 12];
+    let mut sink = Sink { errors: &mut v };
+    let r = if which == 1 {
+        let (q, n) = recover(&mut sink, &children, p);
+        q + 10 * n
+    } else if which == 2 {
+        recover_then_write(&mut sink, &children, p)
+    } else {
+        recover_twice(&mut sink, &children, p)
+    };
+    sink.errors.push(200 + r);
+    let len = v.len() as u32;
+    let first = v[1];
+    let last = v[v.len() - 2];
+    (r, len, first, last)
+}
+
+pub struct Native {
+    pub depth: u32,
+}
+
+pub struct Record {
+    pub first: Option<u32>,
+}
+
+pub struct Budget<'a> {
+    pub native: &'a mut Native,
+    pub record: &'a mut Record,
+}
+
+fn analyze(e: &u32, stack: &mut Budget<'_>) -> u32 {
+    stack.native.depth += 1;
+    if *e == 0 {
+        stack.record.first = Some(stack.native.depth);
+    }
+    *e
+}
+
+/// The `analyze_app` shape: `if let Some(x) = arg_deps.first() { loop }`.
+pub fn app(kids: &[u32], deps: &mut Vec<u32>, stack: &mut Budget<'_>, shape: bool) -> u32 {
+    let arg_deps = kids.iter().skip(1).map(|a| analyze(a, stack)).collect::<Vec<_>>();
+    if shape {
+        return 1;
+    }
+    if let Some(x) = arg_deps.first() {
+        for d in arg_deps.iter() {
+            deps.push(*d + *x);
+        }
+    }
+    arg_deps.len() as u32
+}
+
+/// `(result, deps, sum of deps, depth, first)`; the caller writes through the
+/// budget after the call.
+pub fn run_app(a: u32, b: u32, c: u32, n: usize, shape: bool) -> (u32, u32, u32, u32, u32) {
+    let kids = [a, b, c];
+    let mut deps = Vec::new();
+    deps.push(1);
+    let mut native = Native { depth: 3 };
+    let mut record = Record { first: None };
+    let mut stack = Budget { native: &mut native, record: &mut record };
+    let r = app(&kids[..n], &mut deps, &mut stack, shape);
+    stack.native.depth += 100;
+    let mut sum = 0;
+    for d in deps.iter() {
+        sum += *d;
+    }
+    let first = match record.first {
+        Some(f) => f,
+        None => 99,
+    };
+    (r, deps.len() as u32, sum, native.depth, first)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn recover_native() {
+        assert_eq!(run_recover(1, 1, 2, 1), (31, 3, 12, 12));
+        assert_eq!(run_recover(1, 1, 2, 5), (35, 4, 12, 5));
+        assert_eq!(run_recover(1, 11, 2, 1), (31, 4, 11, 12));
+        assert_eq!(run_recover(1, 11, 13, 5), (35, 6, 11, 5));
+        assert_eq!(run_recover(1, 1, 13, 4), (34, 5, 13, 4));
+        assert_eq!(run_recover(2, 1, 2, 1), (3, 4, 12, 93));
+        assert_eq!(run_recover(2, 1, 2, 5), (3, 5, 12, 93));
+        assert_eq!(run_recover(2, 11, 13, 5), (3, 7, 11, 93));
+        assert_eq!(run_recover(3, 1, 2, 1), (33, 4, 12, 12));
+        assert_eq!(run_recover(3, 11, 2, 1), (33, 6, 11, 12));
+        assert_eq!(run_recover(3, 11, 13, 5), (33, 9, 11, 12));
+    }
+
+    #[test]
+    fn app_native() {
+        assert_eq!(run_app(5, 2, 0, 3, false), (2, 3, 7, 105, 5));
+        assert_eq!(run_app(5, 0, 4, 3, false), (2, 3, 5, 105, 4));
+        assert_eq!(run_app(5, 2, 0, 3, true), (1, 1, 1, 105, 5));
+        assert_eq!(run_app(5, 2, 0, 1, false), (0, 1, 1, 103, 99));
+        assert_eq!(run_app(5, 7, 0, 2, false), (1, 2, 15, 104, 99));
+        assert_eq!(run_app(5, 0, 0, 3, false), (2, 3, 1, 105, 5));
+    }
+}
