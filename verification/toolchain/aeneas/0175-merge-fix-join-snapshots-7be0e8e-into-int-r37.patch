+++ b/tests/lean/NestedBorrowsJoinSnapshotModel/Checks.lean
@@ -0,0 +1,47 @@
+import NestedBorrowsJoinSnapshotModel.NestedBorrowsJoinSnapshotModel
+
+/-! Evaluate the model of `tests/src/nested-borrows-join-snapshot-model.rs` on
+    the inputs of its `native` test module and compare with the native results
+    (the sink and the budget given back after the join, then written by the
+    caller). -/
+
+namespace nested_borrows_join_snapshot_model.checks
+open Aeneas Aeneas.Std Result
+open nested_borrows_join_snapshot_model
+
+def u (x : Nat) : U32 := ⟨BitVec.ofNat _ x⟩
+
+/-- `(result, errors, first error, last error)` -/
+def runRecover (which a b p : Nat) : Option (Nat × Nat × Nat × Nat) :=
+  match run_recover (u which) (u a) (u b) (u p) with
+  | ok (r, len, first, last) => some (r.val, len.val, first.val, last.val)
+  | _ => none
+
+/-- `(result, deps, sum of deps, depth, first)` -/
+def runApp (a b c n : Nat) (shape : Bool) : Option (Nat × Nat × Nat × Nat × Nat) :=
+  match run_app (u a) (u b) (u c) ⟨BitVec.ofNat _ n⟩ shape with
+  | ok (r, len, sum, depth, first) => some (r.val, len.val, sum.val, depth.val, first.val)
+  | _ => none
+
+-- recover_native
+#guard runRecover 1 1 2 1 == some (31, 3, 12, 12)
+#guard runRecover 1 1 2 5 == some (35, 4, 12, 5)
+#guard runRecover 1 11 2 1 == some (31, 4, 11, 12)
+#guard runRecover 1 11 13 5 == some (35, 6, 11, 5)
+#guard runRecover 1 1 13 4 == some (34, 5, 13, 4)
+#guard runRecover 2 1 2 1 == some (3, 4, 12, 93)
+#guard runRecover 2 1 2 5 == some (3, 5, 12, 93)
+#guard runRecover 2 11 13 5 == some (3, 7, 11, 93)
+#guard runRecover 3 1 2 1 == some (33, 4, 12, 12)
+#guard runRecover 3 11 2 1 == some (33, 6, 11, 12)
+#guard runRecover 3 11 13 5 == some (33, 9, 11, 12)
+
+-- app_native
+#guard runApp 5 2 0 3 false == some (2, 3, 7, 105, 5)
+#guard runApp 5 0 4 3 false == some (2, 3, 5, 105, 4)
+#guard runApp 5 2 0 3 true == some (1, 1, 1, 105, 5)
+#guard runApp 5 2 0 1 false == some (0, 1, 1, 103, 99)
+#guard runApp 5 7 0 2 false == some (1, 2, 15, 104, 99)
+#guard runApp 5 0 0 3 false == some (2, 3, 1, 105, 5)
+
+end nested_borrows_join_snapshot_model.checks
