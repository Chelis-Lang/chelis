+  let i ← stack.native.depth + 100#u32
+  let s1 := _root_.Aeneas.Std.alloc.vec.Vec.deref deps1
+  let iter ← _root_.Aeneas.Std.core.slice.Slice.iter s1
+  let (sum, back) ←
+    _root_.nested_borrows_join_snapshot_model.run_app_loop app_back iter i
+      stack.record 0#u32
+  let (native, record1) := back
+  let first ←
+    match record1.first with
+    | none => _root_.Aeneas.Std.Result.ok 99#u32
+    | some f => _root_.Aeneas.Std.Result.ok f
+  let i1 := _root_.Aeneas.Std.alloc.vec.Vec.len deps1
+  let i2 ← lift (_root_.Aeneas.Std.UScalar.cast .U32 i1)
+  _root_.Aeneas.Std.Result.ok (r, i2, sum, native.depth, first)
+
+end nested_borrows_join_snapshot_model
