@@ -0,0 +1,76 @@
+//@ [lean] known-failure
+//@ [!lean] skip
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::iter::adapters::map::Map
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! The join of `nested-borrows-join-snapshot-model` (`recover`), with the
+//! closure first moved into a struct by a translated function (`make`). The
+//! staged backward function of `make` is translated from its body: its last
+//! stage gives back the closure it finds in the `Apply` it receives, which the
+//! in-order application computes from the output of the first stage and the
+//! snapshot of the join computes from the values at the join. The
+//! continuation of the join abstraction of the inner region is used without
+//! recombination (no nested loan update is recorded), so the translation must
+//! fail: without the check, the model gives back the vector as at the join
+//! (the pushes after the `collect`, in the function and in its caller, are
+//! lost).
+
+pub struct Sink<'s> {
+    pub errors: &'s mut Vec<u32>,
+}
+
+fn dim(errors: &mut Sink<'_>, c: &u32) -> Result<u32, u32> {
+    if *c > 10 {
+        errors.errors.push(*c);
+        Err(*c)
+    } else {
+        Ok(*c + 1)
+    }
+}
+
+pub struct Apply<I, F> {
+    pub iter: I,
+    pub f: F,
+}
+
+fn make<I, F>(iter: I, f: F) -> Apply<I, F> {
+    Apply { iter, f }
+}
+
+pub fn recover(errors: &mut Sink<'_>, children: &[u32], p: u32) -> u32 {
+    let a = make(children.iter(), |c: &u32| dim(errors, c));
+    let dims: Vec<Result<u32, u32>> = a.iter.map(a.f).collect();
+    let q = if p > 3 {
+        errors.errors.push(p);
+        p + 1
+    } else {
+        p
+    };
+    q + 10 * dims.len() as u32
+}
+
+/// `(result, errors, first error, last error)`; the caller writes through the
+/// sink after the call.
+pub fn run_recover(a: u32, b: u32, p: u32) -> (u32, u32, u32, u32) {
+    let mut v = Vec::new();
+    v.push(7);
+    let children = [a, b, 12];
+    let mut sink = Sink { errors: &mut v };
+    let r = recover(&mut sink, &children, p);
+    sink.errors.push(200 + r);
+    let len = v.len() as u32;
+    let first = v[1];
+    let last = v[v.len() - 2];
+    (r, len, first, last)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn recover_native() {
+        assert_eq!(run_recover(1, 2, 1), (31, 3, 12, 12));
+        assert_eq!(run_recover(1, 2, 5), (36, 4, 12, 5));
+        assert_eq!(run_recover(11, 13, 5), (36, 6, 11, 5));
+    }
+}
