@@ -0,0 +1,60 @@
+//@ [!lean] skip
+//@ [lean] subdir=SharedReborrowInnerShared
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! A caller lends `&x` to a callee, then matches on `x`, whose payload holds
+//! shared borrows (`Option<&mut Frame<'_>>` with `steps: &[u32]`, as the
+//! `Option<&mut ExecutionFrame<'_>>` of `chelis_ir::eval`). The region
+//! abstraction of the callee reborrows the payload as a shared value; when
+//! the expansion of the payload reaches the shared borrow `steps`, the value
+//! behind it (`[u32]`) holds no region of the abstraction: the reborrow
+//! projects nothing there.
+//! `SharedReborrowInnerShared/Checks.lean` evaluates the model on the inputs
+//! of the `native` test module below and compares with the native results.
+
+pub struct Frame<'a> {
+    steps: &'a [u32],
+    pos: usize,
+}
+
+fn peek(_x: &Option<&mut Frame<'_>>) -> u32 {
+    7
+}
+
+/// Lend the option to a callee, then expand it and update its payload
+pub fn peek_then_advance(x: Option<&mut Frame<'_>>) -> u32 {
+    let n = peek(&x);
+    if let Some(v) = x {
+        v.pos += 1;
+    }
+    n
+}
+
+/// Same, reading the shared payload after the update
+pub fn peek_then_step(x: Option<&mut Frame<'_>>) -> u32 {
+    let n = peek(&x);
+    match x {
+        Some(v) => {
+            v.pos += 1;
+            v.steps[v.pos] + n
+        }
+        None => n,
+    }
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn frames() {
+        let steps = [3, 5, 7];
+        let mut frame = Frame { steps: &steps, pos: 0 };
+        assert_eq!(peek_then_advance(Some(&mut frame)), 7);
+        assert_eq!(frame.pos, 1);
+        assert_eq!(peek_then_advance(None), 7);
+        assert_eq!(peek_then_step(Some(&mut frame)), 14);
+        assert_eq!(frame.pos, 2);
+        assert_eq!(peek_then_step(None), 7);
+    }
+}
