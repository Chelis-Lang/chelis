+import SpecializedClosureClauses.SpecializedClosureClauses
+
+/-! Evaluate the model of `tests/src/specialized-closure-clauses.rs` on the
+    inputs of its `native` test module and compare with the native results:
+    the result, then the values of `x` and of the captured state after the
+    call. -/
+
+namespace specialized_closure_clauses.checks
+open Aeneas Aeneas.Std Result
+
+def u32 (n : Nat) : U32 := ⟨BitVec.ofNat _ n⟩
+def u64 (n : Nat) : U64 := ⟨BitVec.ofNat _ n⟩
+
+def vals {A B C : Type} (fa : A → Nat) (fb : B → Nat) (fc : C → Nat)
+    (r : Result (A × B × C)) : Option (Nat × Nat × Nat) :=
+  match r with
+  | ok (a, b, c) => some (fa a, fb b, fc c)
+  | _ => none
+
+def scaledVals (x k : Nat) : Option (Nat × Nat × Nat) :=
+  vals (·.val) (·.val) (·.val) (scaled (u32 x) (u32 k))
+
+def offsetVals (x base : Nat) : Option (Nat × Nat × Nat) :=
+  vals (·.val) (·.val) (·.val) (offset (u32 x) (u64 base))
+
+#guard scaledVals 3 7 == some (21, 21, 7)
+#guard scaledVals 0x80000001 2 == some (2, 2, 2)
+#guard offsetVals 4 100 == some (105, 5, 100)
+#guard offsetVals 0xFFFFFFFF 0xFFFFFFFFFFFFFFFF ==
+  some (0xFFFFFFFFFFFFFFFF, 0, 0xFFFFFFFFFFFFFFFF)
+
+end specialized_closure_clauses.checks
