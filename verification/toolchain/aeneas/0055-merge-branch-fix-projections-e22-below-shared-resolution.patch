diff --git a/tests/src/shared-borrow-of-mut-output.rs b/tests/src/shared-borrow-of-mut-output.rs
new file mode 100644
index 0000000..c00060a
--- /dev/null
+++ b/tests/src/shared-borrow-of-mut-output.rs
@@ -0,0 +1,53 @@
+//@ [!lean] skip
+//@ [lean] subdir=SharedBorrowOfMutOutput
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! A function returning a shared borrow of a mutable borrow,
+//! `Option<&'a &'b mut Frame<'_>>`, as `Option::as_ref` does on the
+//! `Option<&mut ExecutionFrame<'_>>` of `chelis_ir::eval`. The region `'b` is
+//! frozen below `'a`: the backward function of `'b` receives the final value
+//! of the frame (unchanged), and gives nothing back.
+//! `SharedBorrowOfMutOutput/Checks.lean` evaluates the model on the inputs of
+//! the `native` test module below and compares with the native results.
+
+pub struct Frame<'a> {
+    steps: &'a [u32],
+    pos: usize,
+}
+
+pub fn wrap<'a, 'b, 'c>(f: &'a &'b mut Frame<'c>) -> Option<&'a &'b mut Frame<'c>> {
+    Some(f)
+}
+
+/// Read the frame through the frozen borrow
+pub fn pos_of(f: &mut Frame<'_>) -> usize {
+    let r = &f;
+    match wrap(r) {
+        Some(g) => g.pos + g.steps.len(),
+        None => 0,
+    }
+}
+
+/// Read the frame through the frozen borrow, then advance it
+pub fn pos_then_advance(f: &mut Frame<'_>) -> usize {
+    let p = pos_of(f);
+    f.pos += 1;
+    p
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn frames() {
+        let steps = [1, 2, 3];
+        let mut frame = Frame { steps: &steps, pos: 1 };
+        assert_eq!(pos_of(&mut frame), 4);
+        assert_eq!(frame.pos, 1);
+        assert_eq!(pos_then_advance(&mut frame), 4);
+        assert_eq!(frame.pos, 2);
+        assert_eq!(pos_then_advance(&mut frame), 5);
+        assert_eq!(frame.pos, 3);
+    }
+}
diff --git a/tests/src/shared-payload-mut-join.rs b/tests/src/shared-payload-mut-join.rs
new file mode 100644
index 0000000..34aa621
--- /dev/null
+++ b/tests/src/shared-payload-mut-join.rs
@@ -0,0 +1,89 @@
+//@ [!lean] skip
+//@ [lean] subdir=SharedPayloadMutJoin
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::option::{core::option::Option}
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Shared borrows of values holding mutable borrows, as `Option::as_ref` on
+//! the `Option<&mut ExecutionFrame<'_>>` of `chelis_ir::eval`:
+//! - a join below the shared borrow copies the shared payload
+//!   (`Option<&'1 mut Frame<'2>>`): the loans of the mutable borrows of the
+//!   copy are frozen, and ending them gives nothing back;
+//! - a caller which lends `&x` to a callee, then matches on `x`, expands the
+//!   payload that the callee's region abstraction reborrows.
+//! `SharedPayloadMutJoin/Checks.lean` evaluates the model on the inputs of the
+//! `native` test module below and compares with the native results.
+
+pub struct Frame<'a> {
+    steps: &'a [u32],
+    ctx: &'a mut u32,
+    pos: usize,
+}
+
+/// A frame without mutable borrows inside
+pub struct View<'a> {
+    steps: &'a [u32],
+    pos: usize,
+}
+
+/// Match on the shared borrow, then join
+pub fn current_step(execution: &Option<&mut Frame<'_>>) -> u32 {
+    match execution {
+        Some(frame) => frame.steps[frame.pos] + *frame.ctx,
+        None => 0,
+    }
+}
+
+/// `Option::as_ref` (whose body joins below the shared borrow), then read
+pub fn current_view_as_ref(view: &Option<&mut View<'_>>) -> u32 {
+    match view.as_ref() {
+        Some(v) => v.steps[v.pos] + 1,
+        None => 0,
+    }
+}
+
+fn peek(_x: &Option<&mut u32>) -> u32 {
+    7
+}
+
+/// Lend the option to a callee, then expand it and update its payload
+pub fn peek_then_add(x: Option<&mut u32>) -> u32 {
+    let n = peek(&x);
+    if let Some(v) = x {
+        *v += n;
+    }
+    n
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn frames() {
+        let steps = [3, 5, 7];
+        let mut ctx = 1;
+        let mut frame = Frame { steps: &steps, ctx: &mut ctx, pos: 1 };
+        assert_eq!(current_step(&Some(&mut frame)), 6);
+        assert_eq!(current_step(&None), 0);
+        frame.pos = 2;
+        *frame.ctx = 4;
+        assert_eq!(current_step(&Some(&mut frame)), 11);
+    }
+
+    #[test]
+    fn views() {
+        let steps = [3, 5, 7];
+        let mut view = View { steps: &steps, pos: 1 };
+        assert_eq!(current_view_as_ref(&Some(&mut view)), 6);
+        view.pos = 2;
+        assert_eq!(current_view_as_ref(&Some(&mut view)), 8);
+        assert_eq!(current_view_as_ref(&None), 0);
+    }
+
+    #[test]
+    fn peeks() {
+        let mut v = 5;
+        assert_eq!(peek_then_add(Some(&mut v)), 7);
+        assert_eq!(v, 12);
+        assert_eq!(peek_then_add(None), 7);
+    }
+}
diff --git a/tests/src/shared-reborrow-inner-shared.rs b/tests/src/shared-reborrow-inner-shared.rs
