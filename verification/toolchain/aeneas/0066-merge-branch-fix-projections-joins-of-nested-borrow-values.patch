@@ -0,0 +1,58 @@
+//@ [!lean] skip
+//@ [lean] subdir=JoinNestedBorrowMoved
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::option::{core::option::Option}
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! A match on `Option::as_ref` of an optional frame which holds a mutable
+//! borrow itself (`Option<&'a mut Frame<'b>>`, as the
+//! `Option<&mut ExecutionFrame<'_>>` of `chelis_ir::eval`, whose frame holds
+//! `context: &mut _`), then an update of the frame, as in
+//! `eval_tensor_internal_with_result_claims`. After the match, the scrutinee
+//! is `None` in one branch and `Some(⊥)` in the other (the payload was moved
+//! into the binding): its join has type `Option<&&mut Frame<'_>>` (nested
+//! borrows) but holds no borrow.
+//! `JoinNestedBorrowMoved/Checks.lean` evaluates the model on the inputs of
+//! the `native` test module below and compares with the native results.
+
+pub struct Frame<'a> {
+    steps: &'a [u32],
+    ctx: &'a mut u32,
+    pos: usize,
+}
+
+impl Frame<'_> {
+    pub fn steps(&self) -> &[u32] {
+        self.steps
+    }
+}
+
+/// Read the frame through `as_ref`, then update it
+pub fn order_then_advance(execution: Option<&mut Frame<'_>>, n: u32) -> u32 {
+    let order = match execution.as_ref() {
+        Some(frame) => frame.steps()[frame.pos],
+        None => n,
+    };
+    if let Some(frame) = execution {
+        frame.pos += 1;
+        *frame.ctx += order;
+    }
+    order
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn frames() {
+        let steps = [3, 5, 7];
+        let mut ctx = 1;
+        let mut frame = Frame { steps: &steps, ctx: &mut ctx, pos: 0 };
+        assert_eq!(order_then_advance(Some(&mut frame), 9), 3);
+        assert_eq!((frame.pos, *frame.ctx), (1, 4));
+        assert_eq!(order_then_advance(Some(&mut frame), 9), 5);
+        assert_eq!((frame.pos, *frame.ctx), (2, 9));
+        assert_eq!(order_then_advance(None, 9), 9);
+        assert_eq!((frame.pos, *frame.ctx), (2, 9));
+        assert_eq!(ctx, 9);
+    }
+}
diff --git a/tests/src/join-nested-loan-update.rs b/tests/src/join-nested-loan-update.rs
