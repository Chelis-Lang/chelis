@@ -0,0 +1,48 @@
+import JoinNestedBorrowMoved.JoinNestedBorrowMoved
+
+/-! Evaluate the model of `tests/src/join-nested-borrow-moved.rs` on the inputs
+    of its `native` test module and compare with the native results. -/
+
+namespace join_nested_borrow_moved.checks
+open Aeneas Aeneas.Std Result
+
+def u (n : Nat) : U32 := ⟨BitVec.ofNat _ n⟩
+
+def steps : Slice U32 := ⟨[u 3, u 5, u 7], by simp; scalar_tac⟩
+
+def frame (pos ctx : Nat) : Frame := { steps, ctx := u ctx, pos := ⟨BitVec.ofNat _ pos⟩ }
+
+/-- One call: the result, then the position and context of the frame given
+    back when the borrow of the frame ends. -/
+def call (execution : Option Frame) (n : Nat) : Option (Nat × Option (Nat × Nat)) :=
+  match order_then_advance execution (u n) with
+  | ok (r, execution', _) => some (r.val, execution'.map fun f => (f.pos.val, f.ctx.val))
+  | _ => none
+
+#guard call (some (frame 0 1)) 9 == some (3, some (1, 4))
+#guard call (some (frame 1 4)) 9 == some (5, some (2, 9))
+#guard call none 9 == some (9, none)
+
+/-- The native test: two calls on `Some(&mut frame)`, then one on `None`. For
+    each call, the result and the position and context of the frame after it;
+    then the final value of `ctx` once the borrow of the frames' context ends
+    (the backward functions of the two calls, innermost first). -/
+def native : Option (List Nat) :=
+  match order_then_advance (some (frame 0 1)) (u 9) with
+  | ok (a, some f1, back1) =>
+    match order_then_advance (some f1) (u 9) with
+    | ok (b, some f2, back2) =>
+      match order_then_advance none (u 9) with
+      | ok (c, none, _) =>
+        match back1 (back2 (some f2)) with
+        | some f =>
+          some [a.val, f1.pos.val, f1.ctx.val, b.val, f2.pos.val, f2.ctx.val, c.val,
+            f2.pos.val, f2.ctx.val, f.ctx.val]
+        | none => none
+      | _ => none
+    | _ => none
+  | _ => none
+
+#guard native == some [3, 1, 4, 5, 2, 9, 9, 2, 9, 9]
+
+end join_nested_borrow_moved.checks
