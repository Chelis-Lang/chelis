@@ -0,0 +1,133 @@
+//@ [!lean] skip
+//@ [lean] subdir=JoinNestedLoanUpdate
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! A join (or a loop) of an optional frame which holds a mutable borrow
+//! itself (`Option<&'a mut Frame<'b>>`, as the `Option<&mut ExecutionFrame<'_>>`
+//! of `chelis_ir::eval`), then an update through the inner borrow of the joined
+//! value.
+//!
+//! The join abstraction of `'b` lends the inner borrows of the joined frame.
+//! When the joined option is matched, the frame given back to its outer borrow
+//! holds the inner borrow of the frame: the abstraction owns it at level 1,
+//! below the application of the join (or loop) continuation to the value it
+//! consumes. Ending it gives back the current value of the inner borrow, which
+//! the nested loans of the abstraction consume, and which the continuation
+//! then gives back for the input.
+//! `JoinNestedLoanUpdate/Checks.lean` evaluates the model on the inputs of the
+//! `native` test module below and compares with the native results.
+
+pub struct Frame<'a> {
+    pub steps: &'a mut u32,
+    pub id: u32,
+}
+
+/// Join, then update the inner borrow
+pub fn clear_then_double(mut execution: Option<&mut Frame<'_>>, n: u32) -> u32 {
+    if n > 3 {
+        execution = None;
+    }
+    if let Some(frame) = execution {
+        *frame.steps *= 2;
+    }
+    n
+}
+
+/// Join, then update the inner borrow and the frame
+pub fn clear_then_step(mut execution: Option<&mut Frame<'_>>, n: u32) -> u32 {
+    if n > 3 {
+        execution = None;
+    }
+    match execution {
+        Some(frame) => {
+            *frame.steps += n;
+            frame.id += 1;
+            frame.id
+        }
+        None => 0,
+    }
+}
+
+/// Loop, then update the inner borrow of the loop state
+pub fn clear_in_loop(mut execution: Option<&mut Frame<'_>>, n: u32) -> u32 {
+    let mut i = 0;
+    while i < n {
+        if i == 3 {
+            execution = None;
+        }
+        i += 1;
+    }
+    if let Some(frame) = execution {
+        *frame.steps += 1;
+    }
+    i
+}
+
+/// Join of the optional frame with `None` in another variable
+pub fn pick_then_step(execution: Option<&mut Frame<'_>>, c: bool, n: u32) -> u32 {
+    let r = if c { execution } else { None };
+    match r {
+        Some(frame) => {
+            *frame.steps += n;
+            frame.id += 1;
+            frame.id
+        }
+        None => n,
+    }
+}
+
+/// Callers: the value returned, the id and the steps seen after the call
+pub fn drive_double(n: u32) -> (u32, u32) {
+    let mut s = 5u32;
+    let mut f = Frame { steps: &mut s, id: 1 };
+    let r = clear_then_double(Some(&mut f), n);
+    let id = f.id;
+    (r * 10 + id, s)
+}
+
+pub fn drive_step(n: u32) -> (u32, u32) {
+    let mut s = 5u32;
+    let mut f = Frame { steps: &mut s, id: 1 };
+    let r = clear_then_step(Some(&mut f), n);
+    let id = f.id;
+    (r * 10 + id, s)
+}
+
+pub fn drive_loop(n: u32) -> (u32, u32) {
+    let mut s = 5u32;
+    let mut f = Frame { steps: &mut s, id: 1 };
+    let r = clear_in_loop(Some(&mut f), n);
+    let id = f.id;
+    (r * 10 + id, s)
+}
+
+pub fn drive_pick(c: bool, n: u32) -> (u32, u32) {
+    let mut s = 5u32;
+    let mut f = Frame { steps: &mut s, id: 1 };
+    let r = pick_then_step(Some(&mut f), c, n);
+    let id = f.id;
+    (r * 10 + id, s)
+}
+
+pub fn drive_none(n: u32) -> u32 {
+    clear_then_double(None, n) + clear_then_step(None, n) + clear_in_loop(None, n)
+        + pick_then_step(None, true, n)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn drives() {
+        assert_eq!(drive_double(2), (21, 10));
+        assert_eq!(drive_double(4), (41, 5));
+        assert_eq!(drive_step(3), (22, 8));
+        assert_eq!(drive_step(7), (1, 5));
+        assert_eq!(drive_loop(2), (21, 6));
+        assert_eq!(drive_loop(5), (51, 5));
+        assert_eq!(drive_pick(true, 3), (22, 8));
+        assert_eq!(drive_pick(false, 3), (31, 5));
+        assert_eq!(drive_none(2), 6);
+    }
+}
