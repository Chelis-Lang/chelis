+//! A closure which captures a closure which captures mutable borrows, passed
+//! by mutable reference, then the captured closure used again in a loop
+//! (production: chelis_deep authoring `walk_children`,
+//! `meta.visit_syntax(&mut |key, value| f(value, scope, ..))` followed by
+//! `for child in children { f(child, scope, ..) }`). The call abstraction of
+//! the region of the innermost borrows holds values at level 2: the borrows
+//! of its own level-1 loans, which the loop's join could not destructure
+//! ('Nested continuation depth 2').
+
+pub struct Expr {
+    pub children: Vec<Expr>,
+    pub meta: Vec<Expr>,
+    pub n: u32,
+}
+
+impl Expr {
+    pub fn visit_syntax(&self, f: &mut impl FnMut(u32, &Expr)) {
+        for value in self.meta.iter() {
+            f(value.n, value)
+        }
+    }
+}
+
+/// The production shape
+pub fn walk_children<F>(expr: &Expr, scope: &mut u32, mut f: F)
+where
+    F: FnMut(&Expr, &mut u32),
+{
+    expr.visit_syntax(&mut |_key, value| {
+        f(value, scope);
+    });
+    for child in expr.children.iter() {
+        f(child, scope);
+    }
+}
+
+/// The captured closure captures two mutable borrows
+pub fn count(expr: &Expr, scope: &mut u32, total: &mut u32, visits: &mut u32) {
+    walk_children(expr, scope, |child, scope| {
+        *scope = scope.wrapping_add(1);
+        *total = total.wrapping_add(child.n);
+        *visits = visits.wrapping_add(1);
+    });
+}
+
+/// The visit of the node itself in a single step (no loop in the visitor), then
+/// a `while` loop over the children
+pub fn walk_first<F>(expr: &Expr, mut f: F)
+where
+    F: FnMut(&Expr),
+{
+    visit_one(expr, &mut |value| f(value));
+    let mut i = 0;
+    while i < expr.children.len() {
+        f(&expr.children[i]);
+        i += 1;
+    }
+}
+
+pub fn visit_one(e: &Expr, f: &mut impl FnMut(&Expr)) {
+    f(e)
+}
+
+pub fn sum_first(expr: &Expr, total: &mut u32) {
+    walk_first(expr, |child| *total = total.wrapping_add(child.n * 10))
+}
+
+/// The visit under a join (`if let`), as in production
+pub fn walk_opt<F>(expr: &Expr, extra: &Option<Box<Expr>>, scope: &mut u32, mut f: F)
+where
+    F: FnMut(&Expr, &mut u32),
+{
+    if let Some(meta) = extra {
+        meta.visit_syntax(&mut |_key, value| {
+            f(value, scope);
+        });
+    }
+    for child in expr.children.iter() {
+        f(child, scope);
+    }
+}
+
+pub fn count_opt(expr: &Expr, extra: &Option<Box<Expr>>, scope: &mut u32, total: &mut u32) {
+    walk_opt(expr, extra, scope, |child, scope| {
+        *scope = scope.wrapping_add(2);
+        *total = total.wrapping_add(child.n);
+    });
+}
+
+pub fn leaf(n: u32) -> Expr {
+    Expr { children: Vec::new(), meta: Vec::new(), n }
+}
+
+pub fn mk(n: u32, meta: u32, children: u32) -> Expr {
+    let mut e = Expr { children: Vec::new(), meta: Vec::new(), n };
+    let mut i = 0;
+    while i < meta {
+        e.meta.push(leaf(100 + i));
+        i += 1;
+    }
+    let mut i = 0;
+    while i < children {
+        e.children.push(leaf(i + 1));
+        i += 1;
+    }
+    e
+}
+
+/// `(scope, total, visits)`; the caller writes through the borrows after the
+/// call
+pub fn run_count(meta: u32, children: u32, scope0: u32) -> (u32, u32, u32) {
+    let e = mk(0, meta, children);
+    let mut scope = scope0;
+    let mut total = 0;
+    let mut visits = 0;
+    {
+        let t = &mut total;
+        let v = &mut visits;
+        count(&e, &mut scope, &mut *t, &mut *v);
+        *t += 1000;
+        *v += 1;
+    }
+    (scope, total, visits)
+}
+
+pub fn run_sum_first(n: u32, children: u32, start: u32) -> u32 {
+    let e = mk(n, 0, children);
+    let mut total = start;
+    sum_first(&e, &mut total);
+    total
+}
+
+/// `(scope, total)`; the caller writes through the total after the call
+pub fn run_count_opt(meta: u32, some: bool, children: u32) -> (u32, u32) {
+    let e = mk(0, 0, children);
+    let extra = if some { Some(Box::new(mk(0, meta, 0))) } else { None };
+    let mut scope = 1;
+    let mut total = 0;
+    {
+        let t = &mut total;
+        count_opt(&e, &extra, &mut scope, &mut *t);
+        *t += 500;
+    }
+    (scope, total)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn count_native() {
+        assert_eq!(run_count(0, 0, 5), (5, 1000, 1));
+        assert_eq!(run_count(2, 3, 0), (5, 1207, 6));
+        assert_eq!(run_count(1, 0, 7), (8, 1100, 2));
+        assert_eq!(run_count(0, 4, 1), (5, 1010, 5));
+    }
+
+    #[test]
+    fn sum_first_native() {
+        assert_eq!(run_sum_first(0, 0, 3), 3);
+        assert_eq!(run_sum_first(4, 2, 0), 70);
+        assert_eq!(run_sum_first(1, 3, 1), 71);
+    }
+
+    #[test]
+    fn count_opt_native() {
+        assert_eq!(run_count_opt(2, true, 3), (11, 707));
+        assert_eq!(run_count_opt(2, false, 3), (7, 506));
+        assert_eq!(run_count_opt(1, true, 0), (3, 600));
+        assert_eq!(run_count_opt(0, true, 0), (1, 500));
+    }
+}
