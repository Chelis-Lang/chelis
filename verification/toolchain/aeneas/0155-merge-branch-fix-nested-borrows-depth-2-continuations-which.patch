+import NestedBorrowsDepth2SelfFed.NestedBorrowsDepth2SelfFed
+
+/-! Evaluate the model of `tests/src/nested-borrows-depth2-self-fed.rs` on the
+    inputs of its `native` test module and compare with the native results
+    (including the values given back to the caller's borrows, which it writes
+    through after the call). -/
+
+namespace nested_borrows_depth2_self_fed.checks
+open Aeneas Aeneas.Std Result
+open nested_borrows_depth2_self_fed
+
+def u (x : Nat) : U32 := ⟨BitVec.ofNat _ x⟩
+
+/-- `(scope, total, visits)` -/
+def runCount (nmeta children scope0 : Nat) : Option (Nat × Nat × Nat) :=
+  match run_count (u nmeta) (u children) (u scope0) with
+  | ok (s, t, v) => some (s.val, t.val, v.val)
+  | _ => none
+
+def runSumFirst (n children start : Nat) : Option Nat :=
+  match run_sum_first (u n) (u children) (u start) with
+  | ok r => some r.val
+  | _ => none
+
+/-- `(scope, total)` -/
+def runCountOpt (nmeta : Nat) (isSome : Bool) (children : Nat) : Option (Nat × Nat) :=
+  match run_count_opt (u nmeta) isSome (u children) with
+  | ok (s, t) => some (s.val, t.val)
+  | _ => none
+
+-- count_native
+#guard runCount 0 0 5 == some (5, 1000, 1)
+#guard runCount 2 3 0 == some (5, 1207, 6)
+#guard runCount 1 0 7 == some (8, 1100, 2)
+#guard runCount 0 4 1 == some (5, 1010, 5)
+
+-- sum_first_native
+#guard runSumFirst 0 0 3 == some 3
+#guard runSumFirst 4 2 0 == some 70
+#guard runSumFirst 1 3 1 == some 71
+
+-- count_opt_native
+#guard runCountOpt 2 true 3 == some (11, 707)
+#guard runCountOpt 2 false 3 == some (7, 506)
+#guard runCountOpt 1 true 0 == some (3, 600)
+#guard runCountOpt 0 true 0 == some (1, 500)
+
+end nested_borrows_depth2_self_fed.checks
