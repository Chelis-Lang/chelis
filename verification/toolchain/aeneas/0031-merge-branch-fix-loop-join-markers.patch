@@ -0,0 +1,181 @@
+//@ [!lean] skip
+//@ [lean] subdir=LoopJoinBorrows
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Loops whose joins involve borrows created inside the body: a shared
+//! borrow into a slice (or array) of references, read through a temporary
+//! which is dead at the `continue`; a reference copied out of a component of
+//! an element of a slice of tuples (so that the element is only partially
+//! reborrowed); and a closure capturing both a shared and a mutable
+//! reference, called at every iteration.
+//! `LoopJoinBorrows/Checks.lean` evaluates the model on the inputs of the
+//! `native` test module below and compares with the native results.
+
+/// Counts the iterations `i < n` where `i > *lim[0]`.
+pub fn slice_of_refs(lim: &[&u32], n: u32) -> u32 {
+    let mut c = 0;
+    let mut i = 0;
+    while i < n {
+        if i > *lim[0] {
+            c += 1;
+        }
+        i += 1;
+    }
+    c
+}
+
+pub fn array_of_refs(lim: &[&u32; 2], n: u32) -> u32 {
+    let mut c = 0;
+    let mut i = 0;
+    while i < n {
+        if i > *lim[1] {
+            c += 1;
+        }
+        i += 1;
+    }
+    c
+}
+
+/// Reads `*a[k].1` for the last `k < n` (or `*dflt` when `n == 0`): the
+/// reference is copied out of a component of an element of the slice.
+pub fn last_second<'a>(a: &[(&'a u32, &'a u32)], n: usize, dflt: &'a u32) -> u32 {
+    let mut out = dflt;
+    let mut i = 0;
+    while i < n {
+        out = a[i].1;
+        i += 1;
+    }
+    *out
+}
+
+/// Same as [last_second], writing through a mutable reference.
+pub fn store_second<'a>(a: &[(&'a u32, &'a u32)], n: usize, out: &mut &'a u32) {
+    let mut i = 0;
+    while i < n {
+        *out = a[i].1;
+        i += 1;
+    }
+}
+
+pub fn store_second_state(x: u32, y: u32, n: usize) -> u32 {
+    let (a, b, c) = (1u32, x, y);
+    let v = [(&a, &b), (&a, &c)];
+    let mut out = &a;
+    store_second(&v, n, &mut out);
+    *out
+}
+
+/// The last `Some` second component of the elements (0 if there is none).
+pub fn last_some<'a>(a: &[(&'a u32, Option<&'a u32>)]) -> u32 {
+    let mut out: Option<&'a u32> = None;
+    for (_, v) in a.iter() {
+        if v.is_some() {
+            out = *v;
+        }
+    }
+    match out {
+        Some(x) => *x,
+        None => 0,
+    }
+}
+
+/// Copies the second components into `out`.
+pub fn push_seconds<'a>(a: &[(&'a u32, Option<&'a u32>)], out: &mut Vec<Option<&'a u32>>) {
+    for (_, v) in a.iter() {
+        out.push(*v);
+    }
+}
+
+/// Sums the `Some` components collected by [push_seconds].
+pub fn push_seconds_sum(x: u32, y: u32) -> u32 {
+    let (a, b, c) = (1u32, x, y);
+    let v = [(&a, Some(&b)), (&a, None), (&a, Some(&c))];
+    let mut out = Vec::new();
+    push_seconds(&v, &mut out);
+    let mut s = 0;
+    let mut i = 0;
+    while i < out.len() {
+        if let Some(r) = out[i] {
+            s += *r;
+        }
+        i += 1;
+    }
+    s
+}
+
+pub struct Counter {
+    pub count: u32,
+    pub total: u32,
+}
+
+impl Counter {
+    pub fn bump(&mut self, by: u32) {
+        self.count += 1;
+        self.total += by;
+    }
+}
+
+/// Calls `f` `n` times, returning its last result.
+pub fn apply<T, F: FnMut(&mut T) -> u32>(x: &mut T, n: u32, mut f: F) -> u32 {
+    let mut last = 0;
+    let mut i = 0;
+    while i < n {
+        last = f(x);
+        i += 1;
+    }
+    last
+}
+
+/// The closure captures `by` by shared reference and `calls` by mutable
+/// reference.
+pub fn bump_many(c: &mut Counter, n: u32, by: u32) -> u32 {
+    let mut calls = 0u32;
+    apply(c, n, |c: &mut Counter| {
+        c.bump(by);
+        calls += 1;
+        calls
+    })
+}
+
+/// Returns `(bump_many result, count, total)`.
+pub fn bump_many_state(count: u32, total: u32, n: u32, by: u32) -> (u32, u32, u32) {
+    let mut c = Counter { count, total };
+    let r = bump_many(&mut c, n, by);
+    (r, c.count, c.total)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn refs() {
+        assert_eq!(slice_of_refs(&[&3, &9], 7), 3);
+        assert_eq!(slice_of_refs(&[&0], 0), 0);
+        assert_eq!(slice_of_refs(&[&10], 5), 0);
+        assert_eq!(array_of_refs(&[&3, &1], 7), 5);
+        assert_eq!(array_of_refs(&[&0, &6], 6), 0);
+    }
+
+    #[test]
+    fn tuple_components() {
+        assert_eq!(last_second(&[(&1, &5), (&2, &7)], 2, &9), 7);
+        assert_eq!(last_second(&[(&1, &5), (&2, &7)], 1, &9), 5);
+        assert_eq!(last_second(&[(&1, &5)], 0, &9), 9);
+        assert_eq!(store_second_state(4, 8, 0), 1);
+        assert_eq!(store_second_state(4, 8, 1), 4);
+        assert_eq!(store_second_state(4, 8, 2), 8);
+        assert_eq!(last_some(&[(&1, Some(&3)), (&2, None)]), 3);
+        assert_eq!(last_some(&[(&1, None), (&1, Some(&6))]), 6);
+        assert_eq!(last_some(&[]), 0);
+        assert_eq!(push_seconds_sum(4, 8), 12);
+        assert_eq!(push_seconds_sum(0, 0), 0);
+    }
+
+    #[test]
+    fn closures() {
+        assert_eq!(bump_many_state(0, 0, 3, 5), (3, 3, 15));
+        assert_eq!(bump_many_state(2, 7, 0, 5), (0, 2, 7));
+        assert_eq!(bump_many_state(1, 1, 4, 2), (4, 5, 9));
+    }
+}
