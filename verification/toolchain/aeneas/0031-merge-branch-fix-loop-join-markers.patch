+import LoopJoinBorrows.LoopJoinBorrows
+
+/-! Evaluate the model of `tests/src/loop-join-borrows.rs` on the inputs of its
+    `native` test module and compare with the native results. -/
+
+namespace loop_join_borrows.checks
+open Aeneas Aeneas.Std Result
+
+def u (n : Nat) : U32 := ⟨BitVec.ofNat _ n⟩
+
+def us (xs : List Nat) (h : xs.length ≤ Usize.max := by simp; try scalar_tac) : Slice U32 :=
+  ⟨xs.map u, by simpa using h⟩
+
+def arr2 (x y : Nat) : Array U32 2#usize := ⟨[u x, u y], by simp⟩
+
+/-- A slice of pairs; the references of the Rust elements are erased. -/
+def pairs {α : Type} (xs : List (Nat × α))
+    (h : xs.length ≤ Usize.max := by simp; try scalar_tac) : Slice (U32 × α) :=
+  ⟨xs.map (fun (x, y) => (u x, y)), by simpa using h⟩
+
+def res (r : Result U32) : Option Nat :=
+  match r with
+  | ok v => some v.val
+  | _ => none
+
+def res3 (r : Result (U32 × U32 × U32)) : Option (Nat × Nat × Nat) :=
+  match r with
+  | ok (a, b, c) => some (a.val, b.val, c.val)
+  | _ => none
+
+#guard res (slice_of_refs (us [3, 9]) (u 7)) == some 3
+#guard res (slice_of_refs (us [0]) (u 0)) == some 0
+#guard res (slice_of_refs (us [10]) (u 5)) == some 0
+#guard res (array_of_refs (arr2 3 1) (u 7)) == some 5
+#guard res (array_of_refs (arr2 0 6) (u 6)) == some 0
+
+#guard res (last_second (pairs [(1, u 5), (2, u 7)]) 2#usize (u 9)) == some 7
+#guard res (last_second (pairs [(1, u 5), (2, u 7)]) 1#usize (u 9)) == some 5
+#guard res (last_second (pairs [(1, u 5)]) 0#usize (u 9)) == some 9
+#guard res (store_second_state (u 4) (u 8) 0#usize) == some 1
+#guard res (store_second_state (u 4) (u 8) 1#usize) == some 4
+#guard res (store_second_state (u 4) (u 8) 2#usize) == some 8
+#guard res (last_some (pairs [(1, some (u 3)), (2, none)])) == some 3
+#guard res (last_some (pairs [(1, none), (1, some (u 6))])) == some 6
+#guard res (last_some (pairs ([] : List (Nat × Option U32)))) == some 0
+#guard res (push_seconds_sum (u 4) (u 8)) == some 12
+#guard res (push_seconds_sum (u 0) (u 0)) == some 0
+
+#guard res3 (bump_many_state (u 0) (u 0) (u 3) (u 5)) == some (3, 3, 15)
+#guard res3 (bump_many_state (u 2) (u 7) (u 0) (u 5)) == some (0, 2, 7)
+#guard res3 (bump_many_state (u 1) (u 1) (u 4) (u 2)) == some (4, 5, 9)
+
+end loop_join_borrows.checks
