+          (_root_.Aeneas.Std.core.ops.index.IndexSlice
+          (_root_.Aeneas.Std.core.slice.index.SliceIndexRangeFromUsizeSlice
+          _root_.Aeneas.Std.Str))
+          (_root_.Aeneas.Std.Array.make 3#usize [
+            _root_.Aeneas.Std.toStr "ab", _root_.Aeneas.Std.toStr "cde",
+            _root_.Aeneas.Std.toStr "fghi"
+            ]) { start := 2#usize }
+      _root_.static_shared_projection.run
+        (_root_.Aeneas.Std.Array.make 3#usize [ 7#u32, 11#u32, 13#u32 ]) s s1
+        which
+    else
+      let s ←
+        _root_.Aeneas.Std.core.array.Array.index
+          (_root_.Aeneas.Std.core.ops.index.IndexSlice
+          (_root_.Aeneas.Std.core.slice.index.SliceIndexRangeFromUsizeSlice
+          _root_.Aeneas.Std.U32))
+          (_root_.Aeneas.Std.Array.make 3#usize [ 7#u32, 11#u32, 13#u32 ])
+          { start := 3#usize }
+      let s1 ←
+        _root_.Aeneas.Std.core.array.Array.index
+          (_root_.Aeneas.Std.core.ops.index.IndexSlice
+          (_root_.Aeneas.Std.core.slice.index.SliceIndexRangeFromUsizeSlice
+          _root_.Aeneas.Std.Str))
