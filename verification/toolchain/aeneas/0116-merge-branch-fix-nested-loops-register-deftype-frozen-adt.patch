+import FrozenAdtRegions.FrozenAdtRegions
+open Aeneas Aeneas.Std Result
+
+/-! Evaluate the model of `tests/src/frozen-adt-regions.rs` on the inputs of
+    its `native` test module and compare with the native results
+    (rustc 1.97.1). The driver calls the `&self` methods whose closures capture
+    `&self` (given to `Option::or_else`, `and_then`, `is_some_and`) and a
+    function taking a struct which holds `&Checker`, writes through the mutable
+    borrow of the checker between the calls (directly and through `&mut self`),
+    and observes the borrowed counter after the checker is gone. -/
+
+namespace frozen_adt_regions.checks
+
+def val8 (r : Result (U32 × U32 × U32 × U32 × U32 × U32 × U32 × U32)) :
+    Option (Nat × Nat × Nat × Nat × Nat × Nat × Nat × Nat) :=
+  match r with
+  | ok (a, b, c, d, e, f, g, h) =>
+      some (a.val, b.val, c.val, d.val, e.val, f.val, g.val, h.val)
+  | _ => none
+
+-- native::drives
+#guard val8 (drive 0#u8) == some (12, 0, 24, 4, 17, 26, 35, 32)
+#guard val8 (drive 1#u8) == some (10, 1, 1000, 4, 16, 25, 32, 31)
+#guard val8 (drive 2#u8) == some (13, 2, 42, 5, 20, 29, 39, 35)
+
+end frozen_adt_regions.checks
