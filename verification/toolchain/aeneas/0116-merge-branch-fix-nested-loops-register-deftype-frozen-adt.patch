+#guard val3 (drive 0#usize) == some (6, 6, 21)
+#guard str (spelling 0#usize) == some "module"
+#guard val3 (drive 1#usize) == some (6, 12, 21)
+#guard str (spelling 1#usize) == some "import"
+#guard val3 (drive 2#usize) == some (3, 15, 21)
+#guard str (spelling 2#usize) == some "def"
+-- Out of bounds: the Rust indexing panics.
+#guard val3 (drive 3#usize) == none
+
+end global_init_loop.checks
