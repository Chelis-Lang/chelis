diff --git a/tests/src/frozen-adt-regions.rs b/tests/src/frozen-adt-regions.rs
new file mode 100644
index 0000000..4910adb
--- /dev/null
+++ b/tests/src/frozen-adt-regions.rs
@@ -0,0 +1,91 @@
+//@ [!lean] skip
+//@ [lean] subdir=FrozenAdtRegions
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::option::{core::option::Option}
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Mutable borrows frozen below the shared borrows of an ADT: a closure
+//! capturing `&self` of a context holding a mutable borrow
+//! (`chelis_types::linearity::Checker<'n> { native: &'n mut _, .. }`), given to
+//! the `Option` combinators (`or_else`, `and_then`, `is_some_and`), and a
+//! struct holding a shared borrow of such a context (`View<'a, 'n>`).
+//! The region `'n` of the closure state and of `View` is only used below a
+//! shared borrow: it is frozen, and a value of these types gives nothing back
+//! to it (like `&'a Checker<'n>`), in the signatures and in the bodies.
+//! `FrozenAdtRegions/Checks.lean` evaluates the model on the inputs of the
+//! `native` test module below and compares with the native results.
+
+pub struct Checker<'n> {
+    pub native: &'n mut u32,
+    pub top: Vec<u32>,
+}
+
+pub struct View<'a, 'n> {
+    pub c: &'a Checker<'n>,
+    pub bias: u32,
+}
+
+impl<'n> Checker<'n> {
+    pub fn pick(&self, k: Option<u32>) -> u32 {
+        match k.or_else(|| Some(*self.native + self.top.len() as u32)) {
+            Some(x) => x,
+            None => 0,
+        }
+    }
+
+    pub fn lookup(&self, k: Option<usize>) -> Option<u32> {
+        k.and_then(|i| self.top.get(i).map(|v| *v + *self.native))
+    }
+
+    pub fn above(&self, k: Option<u32>) -> bool {
+        k.is_some_and(|x| x > *self.native)
+    }
+
+    pub fn bump(&mut self, d: u32) {
+        *self.native += d;
+    }
+}
+
+pub fn read_view(v: View<'_, '_>) -> u32 {
+    *v.c.native + v.c.top.len() as u32 + v.bias
+}
+
+/// Calls the closures and `read_view`, writes through the mutable borrow
+/// between the calls (directly and through `&mut self`), and observes the
+/// borrowed counter after the checker is gone.
+pub fn drive(which: u8) -> (u32, u32, u32, u32, u32, u32, u32, u32) {
+    let mut ctr = 10;
+    let top = match which {
+        0 => vec![3, 12],
+        1 => vec![],
+        _ => vec![11, 30, 5],
+    };
+    let mut c = Checker { native: &mut ctr, top };
+    let p0 = c.pick(None);
+    let p1 = c.pick(Some(which as u32));
+    *c.native += 2;
+    let l0 = match c.lookup(Some(1)) {
+        Some(x) => x,
+        None => 1000,
+    };
+    c.bump(3);
+    let a0 = c.above(Some(13 + 2 * which as u32)) as u32
+        + 2 * c.above(None) as u32
+        + 4 * c.above(Some(20)) as u32;
+    let v0 = read_view(View { c: &c, bias: which as u32 });
+    *c.native += v0;
+    let f0 = v0 + c.pick(Some(9));
+    c.top.push(f0);
+    let p2 = c.pick(None);
+    (p0, p1, l0, a0, v0, f0, p2, ctr)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn drives() {
+        for which in 0u8..3 {
+            println!("{} {:?}", which, drive(which));
+        }
+    }
+}
diff --git a/tests/src/global-init-loop.rs b/tests/src/global-init-loop.rs
new file mode 100644
index 0000000..83bc825
--- /dev/null
+++ b/tests/src/global-init-loop.rs
@@ -0,0 +1,96 @@
+//@ [!lean] skip
+//@ [lean] subdir=GlobalInitLoop
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Globals whose initializer contains a loop (the shape of `chelis_deep`'s
+//! `DeepTag::ALL_STRS`: an array of `'static` strings filled by a `while` loop
+//! in a `const` block). The functions introduced for the loops are extracted
+//! before the global, which calls them; the global is fallible even when its
+//! loop can only diverge (`SPIN`).
+//! `GlobalInitLoop/Checks.lean` evaluates the model on the inputs of the
+//! `native` test module below and compares with the native results.
+
+#[derive(Clone, Copy)]
+pub enum Tag {
+    Module,
+    Import,
+    Def,
+}
+
+impl Tag {
+    pub const COUNT: usize = 3;
+
+    pub const ALL: [Self; Self::COUNT] = [Self::Module, Self::Import, Self::Def];
+
+    pub const fn as_str(self) -> &'static str {
+        match self {
+            Self::Module => "module",
+            Self::Import => "import",
+            Self::Def => "def",
+        }
+    }
+
+    /// The spellings, index-aligned with [`Self::ALL`].
+    pub const ALL_STRS: [&'static str; Self::COUNT] = {
+        let mut strs = [""; Self::COUNT];
+        let mut i = 0;
+        while i < Self::COUNT {
+            strs[i] = Self::ALL[i].as_str();
+            i += 1;
+        }
+        strs
+    };
+
+    /// Nested loops: the sums of the prefixes of the spelling lengths.
+    pub const PREFIX_LENS: [usize; Self::COUNT] = {
+        let mut out = [0; Self::COUNT];
+        let mut i = 0;
+        while i < Self::COUNT {
+            let mut j = 0;
+            while j <= i {
+                out[i] += Self::ALL_STRS[j].len();
+                j += 1;
+            }
+            i += 1;
+        }
+        out
+    };
+
+    /// A loop which can not fail (it can only diverge).
+    pub const SPIN: u32 = {
+        let mut x: u32 = 7;
+        let mut n: u32 = 0;
+        while x != 0 {
+            x = x.wrapping_sub(1);
+            n = n.wrapping_add(3);
+        }
+        n
+    };
+}
+
+pub fn spelling(i: usize) -> &'static str {
+    Tag::ALL_STRS[i]
+}
+
+pub fn drive(i: usize) -> (usize, usize, u32) {
+    let s = spelling(i);
+    (s.len(), Tag::PREFIX_LENS[i], Tag::SPIN)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn drives() {
+        for i in 0usize..3 {
+            println!("{} {:?} {:?}", i, drive(i), spelling(i));
+        }
+    }
+
+    #[test]
+    #[should_panic]
+    fn out_of_bounds() {
+        drive(3);
+    }
+}
diff --git a/tests/src/join-shared-payload-mut-borrow.rs b/tests/src/join-shared-payload-mut-borrow.rs
new file mode 100644
index 0000000..9b7c5c5
--- /dev/null
+++ b/tests/src/join-shared-payload-mut-borrow.rs
@@ -0,0 +1,88 @@
+//@ [!lean] skip
+//@ [lean] subdir=JoinSharedPayloadMutBorrow
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! A join after `matches!` in a `&self` method of a struct holding a mutable
+//! borrow (chelis_types::linearity::Checker<'n>::arg_is_borrowed): the joined
+//! abstractions hold the shared payload of `&self`, whose field `native` is a
+//! mutable borrow. Marking the payload for the join must accept it: it is only
+//! read through the loan, and its loan is in another abstraction.
+//! `JoinSharedPayloadMutBorrow/Checks.lean` evaluates the model on the inputs
+//! of the `native` test module below and compares with the native results.
+
+pub enum Ty {
+    Ref(u32),
+    Int,
+}
+
+pub struct Param {
+    pub display_type: Ty,
+}
+
+pub struct Meta {
+    pub params: Vec<Param>,
+}
+
+pub struct Checker<'n> {
+    pub native: &'n mut u32,
+    pub functions: Vec<(u32, Meta)>,
+}
+
+impl<'n> Checker<'n> {
+    fn get(&self, name: u32) -> Option<&Meta> {
+        for (k, m) in self.functions.iter() {
+            if *k == name {
+                return Some(m);
+            }
+        }
+        None
+    }
+
+    pub fn arg_is_borrowed(&self, func: Option<u32>, idx: usize) -> bool {
+        if let Some(callee) = func {
+            if let Some(meta) = self.get(callee) {
+                if let Some(param) = meta.params.get(idx) {
+                    if matches!(param.display_type, Ty::Ref(_)) {
+                        return true;
+                    }
+                }
+            }
+        }
+        *self.native > 3
+    }
+}
+
+fn mk_meta(tys: Vec<Ty>) -> Meta {
+    Meta { params: tys.into_iter().map(|display_type| Param { display_type }).collect() }
+}
+
+/// Queries the checker, writes through its mutable borrow between the queries
+/// and after pushing a function, and observes the borrowed counter after the
+/// checker is gone.
+pub fn drive(which: u8) -> (u32, u32, u32, u32, u32) {
+    let mut ctr = which as u32 * 2;
+    let functions = vec![(1, mk_meta(vec![Ty::Int, Ty::Ref(3)])), (2, mk_meta(vec![]))];
+    let mut c = Checker { native: &mut ctr, functions };
+    let b0 = c.arg_is_borrowed(Some(1), 1) as u32;
+    let b1 = c.arg_is_borrowed(Some(1), 0) as u32
+        + 2 * c.arg_is_borrowed(None, 0) as u32
+        + 4 * c.arg_is_borrowed(Some(2), 0) as u32;
+    *c.native += 3;
+    let b2 = c.arg_is_borrowed(Some(1), 0) as u32 + 2 * c.arg_is_borrowed(Some(9), 1) as u32;
+    c.functions.push((9, mk_meta(vec![Ty::Int, Ty::Ref(0)])));
+    let b3 = c.arg_is_borrowed(Some(9), 1) as u32 + 2 * c.arg_is_borrowed(Some(9), 2) as u32;
+    *c.native += b3 + b2;
+    (b0, b1, b2, b3, ctr)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn drives() {
+        for which in 0u8..4 {
+            println!("{} {:?}", which, drive(which));
+        }
+    }
+}
diff --git a/tests/src/loop-index-mut-nested.rs b/tests/src/loop-index-mut-nested.rs
new file mode 100644
index 0000000..6baaac7
--- /dev/null
+++ b/tests/src/loop-index-mut-nested.rs
@@ -0,0 +1,87 @@
+//@ [!lean] skip
+//@ [lean] subdir=LoopIndexMutNested
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! A loop writing a reference into an array of references through
+//! `index_mut` (`strs[i] = s`, the shape of `chelis_deep`'s `ALL_STRS`
+//! initialization): the borrow returned by `index_mut` (`&'3 mut &'4 u32`) is
+//! dead at the `continue`, but still keeps the abstractions of the call alive,
+//! whose abstraction of `'4` holds the pending loans of the array given back.
+//! Dropping the dead borrow at the `continue` gives the array back (with the
+//! new reference) before the loop join. The array is a local initialized by a
+//! call, an input moved into the loop, or behind a mutable borrow given back
+//! to the caller.
+//! `LoopIndexMutNested/Checks.lean` evaluates the model on the inputs of the
+//! `native` test module below and compares with the native results.
+
+pub fn fill<'a>(n: usize, s: &'a u32, t: &'a u32) -> [&'a u32; 3] {
+    let mut strs = [t; 3];
+    let mut i = 0;
+    while i < n && i < 3 {
+        strs[i] = s;
+        i += 1;
+    }
+    strs
+}
+
+pub fn fill_arr<'a>(n: usize, s: &'a u32, mut strs: [&'a u32; 3]) -> [&'a u32; 3] {
+    let mut i = 0;
+    while i < n && i < 3 {
+        strs[i] = s;
+        i += 1;
+    }
+    strs
+}
+
+pub fn fill_mut<'a>(strs: &mut [&'a u32; 3], s: &'a u32, n: usize) -> usize {
+    let mut i = 0;
+    while i < n && i < 3 {
+        strs[i] = s;
+        i += 1;
+    }
+    i
+}
+
+const NAMES: [&str; 3] = ["x", "yy", "zzz"];
+
+pub fn all_strs(k: usize) -> [&'static str; 4] {
+    let mut out = [""; 4];
+    let mut i = 0;
+    while i < 4 && i <= k {
+        out[i] = NAMES[i % 3];
+        i += 1;
+    }
+    out
+}
+
+pub fn drive(n: usize) -> (u32, u32, u32, u32, u32, u32, u32, usize, usize) {
+    let a = 5;
+    let b = 7;
+    let c = 11;
+    let f = fill(n, &a, &c);
+    let f0 = *f[0] + 100 * *f[1] + 10000 * *f[2];
+    let g = fill_arr(n, &b, [&a, &a, &c]);
+    let g0 = *g[0];
+    let g1 = *g[1];
+    let g2 = *g[2];
+    let mut m = [&c, &a, &c];
+    let k = fill_mut(&mut m, &b, n + 1);
+    let m0 = *m[0];
+    let m1 = *m[1];
+    let m2 = *m[2];
+    let strs = all_strs(n);
+    let l = strs[0].len() + 10 * strs[1].len() + 100 * strs[2].len() + 1000 * strs[3].len();
+    (f0, g0, g1, g2, m0, m1, m2, k, l)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn drives() {
+        for n in 0usize..5 {
+            println!("{} {:?}", n, drive(n));
+        }
+    }
+}
diff --git a/tests/src/loop-shared-loan-two-borrows.rs b/tests/src/loop-shared-loan-two-borrows.rs
new file mode 100644
index 0000000..57aea22
--- /dev/null
+++ b/tests/src/loop-shared-loan-two-borrows.rs
@@ -0,0 +1,97 @@
+//@ [!lean] skip
+//@ [lean] subdir=LoopSharedLoanTwoBorrows
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! A loop whose continue context holds a shared loan borrowed by two locals
+//! (chelis_types::adt::AdtRegistry::register_deftype: `for field_expr in
+//! vchildren` binds the `Option<&Expr>` of `next` and `field_expr` to the same
+//! loan), with an early return (`?`) through a resolver holding a shared
+//! reference. Joining the fixed point with a continue context pairs the two
+//! borrows of the loan with the two borrows of the other context's loan: they
+//! must borrow one joined loan, not two.
+//! `LoopSharedLoanTwoBorrows/Checks.lean` evaluates the model on the inputs of
+//! the `native` test module below and compares with the native results.
+
+pub struct Resolver<'r> {
+    pub headers: &'r u32,
+    pub next: u32,
+}
+
+pub enum Expr {
+    Atom(u32),
+    Node(u32, Vec<Expr>),
+}
+
+impl<'r> Resolver<'r> {
+    pub fn resolve(&mut self, vg: &mut u32, e: &Expr) -> Result<u32, u32> {
+        match e {
+            Expr::Atom(a) => {
+                *vg += 1;
+                self.next += 1;
+                Ok(*a + *self.headers)
+            }
+            Expr::Node(t, _) => Err(*t),
+        }
+    }
+}
+
+pub fn register(headers: &u32, vg: &mut u32, children: &[Expr]) -> Result<u32, u32> {
+    let mut resolver = Resolver { headers, next: 0 };
+    let mut n = 0;
+    for variant_expr in children {
+        let vchildren = match variant_expr {
+            Expr::Node(_, c) => c,
+            Expr::Atom(_) => break,
+        };
+        for field_expr in vchildren {
+            match field_expr {
+                Expr::Node(8, f) => {
+                    n += resolver.resolve(vg, &f[1])?;
+                }
+                _ => {
+                    n += resolver.resolve(vg, field_expr)?;
+                }
+            }
+        }
+    }
+    Ok(n * 100 + resolver.next)
+}
+
+fn field(a: u32, b: u32) -> Expr {
+    Expr::Node(8, vec![Expr::Atom(a), Expr::Atom(b)])
+}
+
+/// Registers, writes through the counter given back, registers again.
+pub fn drive(which: u8) -> (u32, u32, u32, u32) {
+    let headers = 3;
+    let mut vg = 10;
+    let children = match which {
+        0 => vec![Expr::Node(1, vec![Expr::Atom(1), field(0, 5)]), Expr::Node(2, vec![Expr::Atom(2)])],
+        1 => vec![Expr::Node(1, vec![Expr::Atom(1), Expr::Node(9, vec![])]), Expr::Node(2, vec![Expr::Atom(2)])],
+        2 => vec![Expr::Node(1, vec![field(0, 4)]), Expr::Atom(7), Expr::Node(2, vec![Expr::Atom(2)])],
+        _ => vec![Expr::Atom(0), Expr::Node(3, vec![field(1, 1), Expr::Atom(6)])],
+    };
+    let (r0, e0) = match register(&headers, &mut vg, &children) {
+        Ok(r) => (r, 0),
+        Err(e) => (0, e),
+    };
+    let v = &mut vg;
+    *v += 100;
+    let r1 = match register(&headers, &mut vg, &children[1..]) {
+        Ok(r) => r,
+        Err(e) => 1000 + e,
+    };
+    (r0, e0, r1, vg)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn drives() {
+        for which in 0u8..4 {
+            println!("{} {:?}", which, drive(which));
+        }
+    }
+}
