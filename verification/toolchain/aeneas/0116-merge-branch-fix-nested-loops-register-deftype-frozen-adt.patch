+//@ [lean] subdir=StaticSharedProjection
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::option::{core::option::Option}
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Shared borrows of values holding `'static` references given to generic
+//! functions (`<[T]>::len`, indexing, `iter().copied()`, `first()`, a `for`
+//! loop over `&Vec<(u32, &'static str)>`: the production shapes of
+//! `chelis_types::deep_type::nearest_dtype` and `sites_loop`). The generic
+//! parameter is instantiated with a fresh region (`T = &'2 u32`), and the call
+//! abstraction projects the shared payload over positions which are `'static`
+//! in the value: the static borrows have no lender, and the abstraction holds
+//! none of them.
+//! `StaticSharedProjection/Checks.lean` evaluates the model on the inputs of
+//! the `native` test module below and compares with the native results.
+
+pub fn len_static(xs: &[&'static u32]) -> usize {
+    xs.len()
+}
+
+pub fn index_static(xs: &[&'static u32], i: usize) -> &'static u32 {
+    xs[i]
+}
+
+pub fn index_array(xs: &[&'static u32; 3]) -> &'static u32 {
+    xs[1]
+}
+
+pub fn first_copied(names: &[&'static str]) -> Option<&'static str> {
+    names.iter().copied().next()
+}
+
+pub fn first_len(names: &[&'static str]) -> usize {
+    match names.first().copied() {
+        Some(n) => n.len(),
+        None => 100,
+    }
+}
+
+pub fn sites_loop(sites: &Vec<(u32, &'static str)>) -> usize {
+    let mut s = 0;
+    for claim in sites {
+        s += claim.1.len() + claim.0 as usize;
+    }
+    s
+}
+
+/// Reads the slice of static references and writes through a mutable borrow.
+pub fn accumulate(xs: &[&'static u32], acc: &mut u32) -> usize {
+    let mut i = 0;
+    while i < xs.len() {
+        *acc += *xs[i];
+        i += 1;
+    }
+    xs.len()
+}
+
+fn run(
+    three: &[&'static u32; 3],
+    nums: &[&'static u32],
+    names: &[&'static str],
+    which: u8,
+) -> (usize, u32, u32, usize, usize, usize, usize, u32) {
+    let mut sites = vec![(1, "x"), (2, "yz")];
+    if which > 0 {
+        sites.push((which as u32, "uvw"));
+    }
+    let l = len_static(nums);
+    let i0 = if l > 0 { *index_static(nums, l - 1) } else { 0 };
+    let a1 = *index_array(three);
+    let f = match first_copied(names) {
+        Some(n) => n.len(),
+        None => 50,
+    };
+    let fl = first_len(names);
+    let s = sites_loop(&sites);
+    let mut acc = which as u32;
+    let n = accumulate(nums, &mut acc);
+    (l, i0, a1, f, fl, s, n, acc)
+}
+
+pub fn drive(which: u8) -> (usize, u32, u32, usize, usize, usize, usize, u32) {
+    let three: [&'static u32; 3] = [&7, &11, &13];
+    let all_names: [&'static str; 3] = ["ab", "cde", "fghi"];
+    if which == 0 {
+        run(&three, &three[..], &all_names[..2], which)
+    } else if which == 1 {
+        run(&three, &three[1..], &all_names[2..], which)
+    } else {
+        run(&three, &three[3..], &all_names[3..], which)
+    }
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn drives() {
+        for which in 0u8..3 {
+            println!("{} {:?}", which, drive(which));
+        }
+    }
+}
