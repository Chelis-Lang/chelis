+//@ [!lean] skip
+//@ [lean] subdir=SliceElementRegions
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Shared borrows stored in a slice or an array which is borrowed mutably
+//! (`&'a mut [&'b u32]`): the region of the elements outlives the region of
+//! the outer borrow, as it does for the type arguments of an ADT
+//! (`&'a mut Vec<&'b u32>`). The regions hierarchy used to ignore the
+//! elements of arrays and slices, so a call returning `()` ended the
+//! abstraction of the element region with the call and the caller lost the
+//! borrows given back in the slice ("Can not end a borrow because the value
+//! to give back contains bottom"; `dead_loads.sort_unstable(); dead_loads.dedup()`
+//! over a `Vec<&str>` in chelis-ir eval.rs select_symbolic_inputs).
+//! `SliceElementRegions/Checks.lean` evaluates the model on the inputs of the
+//! `native` test module below and compares with the native results.
+
+pub fn swap_ends<T>(xs: &mut [T]) {
+    let n = xs.len();
+    if n > 1 {
+        xs.swap(0, n - 1);
+    }
+}
+
+/// A generic call on an array of shared borrows (unsized to a slice)
+pub fn ends_after_swap(a: &u32, b: &u32, c: &u32) -> u32 {
+    let mut v = [a, b, c];
+    swap_ends(&mut v);
+    *v[0] * 100 + *v[1] * 10 + *v[2]
+}
+
+/// A call whose signature has the slice of shared borrows
+pub fn swap_refs(xs: &mut [&u32]) {
+    swap_ends(xs);
+}
+
+pub fn digits_after_swap_refs(a: &u32, b: &u32) -> u32 {
+    let mut v = [a, b];
+    swap_refs(&mut v);
+    *v[0] * 10 + *v[1]
+}
+
+/// Through `DerefMut` of a vector of shared borrows, twice (the shape of
+/// `dead_loads.sort_unstable(); dead_loads.dedup()`)
+pub fn vec_swapped_twice(a: &u32, b: &u32, c: &u32) -> u32 {
+    let mut v: Vec<&u32> = Vec::new();
+    v.push(a);
+    v.push(b);
+    v.push(c);
+    v.swap(0, 1);
+    swap_ends(&mut v);
+    *v[0] * 100 + *v[1] * 10 + *v[2]
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn swaps() {
+        assert_eq!(ends_after_swap(&1, &2, &3), 321);
+        assert_eq!(digits_after_swap_refs(&4, &7), 74);
+        assert_eq!(vec_swapped_twice(&1, &2, &3), 312);
+    }
+}
