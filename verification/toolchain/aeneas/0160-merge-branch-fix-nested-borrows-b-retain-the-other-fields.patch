diff --git a/tests/src/nested-borrows-carrier-fields.rs b/tests/src/nested-borrows-carrier-fields.rs
new file mode 100644
index 0000000..3afbfd1
--- /dev/null
+++ b/tests/src/nested-borrows-carrier-fields.rs
@@ -0,0 +1,255 @@
+//@ [!lean] skip
+//@ [lean] subdir=NestedBorrowsCarrierFields
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::option::{core::option::Option} --include core::ops::deref::{core::ops::deref::Deref} --include core::ops::deref::{core::ops::deref::DerefMut}
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Values given back to the inner region of a borrow of a structure (or of a
+//! closure state) whose other fields are written between the lending of the
+//! structure and the call which gives it back, by the callee through the
+//! outer borrow, and read by the caller afterwards.
+
+pub struct Native {
+    pub polls: u32,
+    pub total: u32,
+}
+
+pub struct Sink<'a> {
+    pub native: &'a mut Native,
+    pub errors: Vec<u32>,
+    pub n: u32,
+}
+
+impl<'a> Sink<'a> {
+    /// Writes the owned fields and the borrowed native
+    pub fn tick(&mut self, x: u32) -> bool {
+        self.n = self.n.wrapping_mul(3).wrapping_add(x);
+        self.errors.push(self.n);
+        self.native.polls = self.native.polls.wrapping_add(1);
+        x == 9
+    }
+
+    pub fn push(&mut self, e: u32) {
+        self.n = self.n.wrapping_add(100);
+        self.errors.push(e);
+        self.native.total = self.native.total.wrapping_add(e);
+    }
+}
+
+/// `tick` writes the owned fields of the sink between the loop entry and the
+/// call of `push`
+pub fn sink_loop(native: &mut Native, n: u32, stop: u32) -> (Vec<u32>, u32) {
+    let mut sink = Sink { native, errors: Vec::new(), n: 1 };
+    let mut i = 0;
+    while i < n {
+        let x = if i == stop { 9 } else { i + 1 };
+        if sink.tick(x) {
+            break;
+        }
+        sink.push(x * 10);
+        i += 1;
+    }
+    (sink.errors, sink.n)
+}
+
+/// `(errors, last error, sink.n, polls, total)`; the caller writes through
+/// the native after the call
+pub fn run_sink_loop(n: u32, stop: u32) -> (u32, u32, u32, u32, u32) {
+    let mut native = Native { polls: 5, total: 7 };
+    let (errors, k) = sink_loop(&mut native, n, stop);
+    native.total = native.total.wrapping_mul(2);
+    let len = errors.len() as u32;
+    let last = if errors.len() > 0 { errors[errors.len() - 1] } else { 0 };
+    (len, last, k, native.polls, native.total)
+}
+
+pub struct Frame<'a> {
+    pub ctx: &'a mut u32,
+    pub pos: u32,
+}
+
+impl<'a> Frame<'a> {
+    pub fn advance(&mut self) -> u32 {
+        self.pos = self.pos.wrapping_add(1);
+        *self.ctx = (*self.ctx).wrapping_add(self.pos);
+        self.pos
+    }
+}
+
+/// `Option::as_deref_mut` in a loop; the position of the frame is written
+/// through the reborrow before the call of `advance`
+pub fn frame_loop(mut execution: Option<&mut Frame<'_>>, n: u32) -> u32 {
+    let mut acc = 0u32;
+    let mut i = 0;
+    while i < n {
+        if let Some(f) = execution.as_deref_mut() {
+            f.pos = f.pos.wrapping_mul(2);
+            acc = acc.wrapping_add(f.advance());
+        }
+        i += 1;
+    }
+    acc
+}
+
+/// `(result, ctx, pos)`; the caller writes through the frame's context after
+/// the call
+pub fn run_frame_loop(some: bool, n: u32, ctx: u32, pos: u32, set: bool) -> (u32, u32, u32) {
+    let mut c = ctx;
+    let mut f = Frame { ctx: &mut c, pos };
+    let r = if some { frame_loop(Some(&mut f), n) } else { frame_loop(None, n) };
+    if set {
+        *f.ctx = (*f.ctx).wrapping_add(1000);
+    }
+    let pos = f.pos;
+    (r, c, pos)
+}
+
+pub struct Ctx {
+    pub count: u32,
+    pub trail: u32,
+}
+
+pub struct Walker<'a> {
+    pub ctx: &'a mut Ctx,
+    pub depth: u32,
+}
+
+/// Recursion through the walker from inside a loop: the depth is written
+/// before each recursive call
+pub fn walk(w: &mut Walker<'_>, n: u32) -> u32 {
+    w.ctx.count = w.ctx.count.wrapping_add(1);
+    if n == 0 {
+        return w.depth;
+    }
+    let mut total = 0u32;
+    let mut i = 0;
+    while i < 2 {
+        w.depth = w.depth.wrapping_add(i + 1);
+        w.ctx.trail = w.ctx.trail.wrapping_mul(3).wrapping_add(w.depth);
+        total = total.wrapping_add(walk(w, n - 1));
+        i += 1;
+    }
+    total
+}
+
+/// `(result, depth, count, trail)`; the caller writes through the walker's
+/// context after the call
+pub fn run_walk(n: u32) -> (u32, u32, u32, u32) {
+    let mut ctx = Ctx { count: 0, trail: 1 };
+    let mut w = Walker { ctx: &mut ctx, depth: 3 };
+    let r = walk(&mut w, n);
+    w.ctx.count = w.ctx.count.wrapping_add(100);
+    let d = w.depth;
+    (r, d, ctx.count, ctx.trail)
+}
+
+fn visit_all(xs: &Vec<u32>, mut visit: impl FnMut(&u32) -> Result<(), u32>) -> Result<(), u32> {
+    let mut i = 0;
+    while i < xs.len() {
+        visit(&xs[i])?;
+        i += 1;
+    }
+    Ok(())
+}
+
+/// A visitor closure moving an owned counter, written at each call, next to
+/// two mutable captures
+pub fn collect_move(xs: &Vec<u32>, out: &mut Vec<u32>, hits: &mut u32, limit: u32) -> Result<(), u32> {
+    let mut k = 1u32;
+    visit_all(xs, move |x| {
+        k = k.wrapping_mul(2);
+        if *x > limit {
+            return Err(*x + k);
+        }
+        out.push(x.wrapping_add(k));
+        *hits += 1;
+        Ok(())
+    })
+}
+
+/// The counter captured by a mutable borrow, read by the caller after the call
+pub fn collect_ref(xs: &Vec<u32>, out: &mut Vec<u32>, hits: &mut u32, limit: u32) -> (Result<(), u32>, u32) {
+    let mut k = 1u32;
+    let r = visit_all(xs, |x| {
+        k = k.wrapping_mul(2);
+        if *x > limit {
+            return Err(*x + k);
+        }
+        out.push(x.wrapping_add(k));
+        *hits += 1;
+        Ok(())
+    });
+    (r, k)
+}
+
+fn inputs(n: u32) -> Vec<u32> {
+    let mut xs = Vec::new();
+    let mut i = 0;
+    while i < n {
+        xs.push(i * 3 + 1);
+        i += 1;
+    }
+    xs
+}
+
+/// `(error or 0, out, last out, hits, k)`; the caller writes through the
+/// output after the call
+pub fn run_collect(by_ref: bool, n: u32, limit: u32) -> (u32, u32, u32, u32, u32) {
+    let xs = inputs(n);
+    let mut out = Vec::new();
+    out.push(50);
+    let mut hits = 10u32;
+    let (r, k) = if by_ref {
+        collect_ref(&xs, &mut out, &mut hits, limit)
+    } else {
+        (collect_move(&xs, &mut out, &mut hits, limit), 0)
+    };
+    out.push(hits);
+    let e = match r {
+        Ok(()) => 0,
+        Err(e) => e,
+    };
+    let last = out[out.len() - 1 - 1];
+    (e, out.len() as u32, last, hits, k)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn sink_loop_native() {
+        assert_eq!(run_sink_loop(0, 9), (0, 0, 1, 5, 14));
+        assert_eq!(run_sink_loop(1, 9), (2, 10, 104, 6, 34));
+        assert_eq!(run_sink_loop(3, 9), (6, 30, 1345, 8, 134));
+        assert_eq!(run_sink_loop(4, 2), (5, 1251, 1251, 8, 74));
+        assert_eq!(run_sink_loop(5, 0), (1, 12, 12, 6, 14));
+    }
+
+    #[test]
+    fn frame_loop_native() {
+        assert_eq!(run_frame_loop(true, 0, 10, 0, false), (0, 10, 0));
+        assert_eq!(run_frame_loop(true, 1, 10, 0, false), (1, 11, 1));
+        assert_eq!(run_frame_loop(true, 3, 10, 1, false), (25, 35, 15));
+        assert_eq!(run_frame_loop(false, 3, 10, 1, false), (0, 10, 1));
+        assert_eq!(run_frame_loop(true, 2, 10, 2, true), (16, 1026, 11));
+        assert_eq!(run_frame_loop(true, 4, u32::MAX, 5, true), (176, 1175, 95));
+    }
+
+    #[test]
+    fn walk_native() {
+        assert_eq!(run_walk(0), (3, 3, 101, 1));
+        assert_eq!(run_walk(1), (10, 6, 103, 27));
+        assert_eq!(run_walk(2), (34, 12, 107, 2418));
+        assert_eq!(run_walk(3), (120, 24, 115, 15667164));
+    }
+
+    #[test]
+    fn collect_native() {
+        assert_eq!(run_collect(false, 0, 100), (0, 2, 50, 10, 0));
+        assert_eq!(run_collect(false, 3, 100), (0, 5, 15, 13, 0));
+        assert_eq!(run_collect(false, 4, 5), (15, 4, 8, 12, 0));
+        assert_eq!(run_collect(true, 0, 100), (0, 2, 50, 10, 1));
+        assert_eq!(run_collect(true, 3, 100), (0, 5, 15, 13, 8));
+        assert_eq!(run_collect(true, 4, 5), (15, 4, 8, 12, 8));
+        assert_eq!(run_collect(true, 5, 1), (8, 3, 3, 11, 4));
+    }
+}
diff --git a/tests/src/nested-borrows-closure-shared-local.rs b/tests/src/nested-borrows-closure-shared-local.rs
new file mode 100644
index 0000000..dccd940
--- /dev/null
+++ b/tests/src/nested-borrows-closure-shared-local.rs
@@ -0,0 +1,100 @@
+//@ [!lean] skip
+//@ [lean] subdir=NestedBorrowsClosureSharedLocal
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::option::{core::option::Option} --include core::result::{core::result::Result} --include core::ops::deref::{core::ops::deref::Deref} --include core::ops::deref::{core::ops::deref::DerefMut}
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! A closure which captures a mutable borrow of a value holding mutable
+//! borrows and a shared borrow of a local of its caller, consumed by
+//! `Option::ok_or_else` (production: chelis_types deep_type `one_symbol`,
+//! `symbol_name(&children[0]).ok_or_else(|| self.malformed(errors,
+//! format!("..{tag}..")))`). The stage of the backward function of the inner
+//! region consumes the whole closure, whose field `&tag` borrows a local the
+//! caller dropped when it returned: its value is looked up in the context of
+//! the call ('The translation of a value refers to a shared borrow whose loan
+//! is not in the context anymore', SymbolicToPureValues).
+
+pub struct Sink<'s> {
+    pub errors: &'s mut Vec<u32>,
+}
+
+fn tag_of(tag: &&u32) -> u32 {
+    **tag
+}
+
+fn malformed(errors: &mut Sink<'_>, m: u32) -> u32 {
+    errors.errors.push(m);
+    m
+}
+
+pub fn one_symbol<'b>(errors: &mut Sink<'_>, tag: &u32, o: Option<&'b u32>) -> Result<&'b u32, u32> {
+    o.ok_or_else(|| malformed(errors, tag_of(&tag)))
+}
+
+pub struct Resolver {
+    pub n: u32,
+}
+
+impl Resolver {
+    fn malformed(&mut self, errors: &mut Sink<'_>, m: u32) -> u32 {
+        self.n += 1;
+        errors.errors.push(m + self.n);
+        m
+    }
+
+    /// The closure also captures `&mut self`
+    pub fn one_symbol<'b>(
+        &mut self,
+        errors: &mut Sink<'_>,
+        tag: &u32,
+        o: Option<&'b u32>,
+    ) -> Result<&'b u32, u32> {
+        o.ok_or_else(|| self.malformed(errors, tag_of(&tag)))
+    }
+}
+
+/// `(result, errors, last error)`; the caller writes through the sink after
+/// the call
+pub fn run(some: bool, x: u32, tag: u32) -> (Result<u32, u32>, u32, u32) {
+    let mut v = Vec::new();
+    v.push(1);
+    let r = {
+        let mut sink = Sink { errors: &mut v };
+        let o = if some { Some(&x) } else { None };
+        let r = one_symbol(&mut sink, &tag, o);
+        sink.errors.push(100);
+        r.map(|y| *y)
+    };
+    let len = v.len() as u32;
+    (r, len, v[v.len() - 1])
+}
+
+/// `(result, resolver.n, errors, last error)`
+pub fn run_resolver(some: bool, x: u32, tag: u32) -> (Result<u32, u32>, u32, u32, u32) {
+    let mut v = Vec::new();
+    let mut res = Resolver { n: 10 };
+    let r = {
+        let mut sink = Sink { errors: &mut v };
+        let o = if some { Some(&x) } else { None };
+        let r = res.one_symbol(&mut sink, &tag, o);
+        sink.errors.push(100 + res.n);
+        r.map(|y| *y)
+    };
+    let len = v.len() as u32;
+    (r, res.n, len, v[v.len() - 1])
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn run_native() {
+        assert_eq!(run(true, 5, 7), (Ok(5), 2, 100));
+        assert_eq!(run(false, 5, 7), (Err(7), 3, 100));
+    }
+
+    #[test]
+    fn run_resolver_native() {
+        assert_eq!(run_resolver(true, 5, 7), (Ok(5), 10, 1, 110));
+        assert_eq!(run_resolver(false, 5, 7), (Err(7), 11, 2, 111));
+    }
+}
diff --git a/tests/src/nested-borrows-join-closure-fields.rs b/tests/src/nested-borrows-join-closure-fields.rs
new file mode 100644
index 0000000..4962457
--- /dev/null
+++ b/tests/src/nested-borrows-join-closure-fields.rs
@@ -0,0 +1,119 @@
+//@ [!lean] skip
+//@ [lean] subdir=NestedBorrowsJoinClosureFields
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::option::{core::option::Option} --include core::ops::deref::{core::ops::deref::Deref} --include core::ops::deref::{core::ops::deref::DerefMut}
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! A closure which captures a shared borrow and a mutable borrow of a value
+//! holding mutable borrows, passed by value to `Option::and_then`, followed by
+//! a join (production: chelis_types infer declarations
+//! `callee_arg_is_borrowed`, `type_env.get(callee).and_then(|expr|
+//! type_from_deep_expr(expr, type_headers, errors))` in an `if let`). The
+//! stage of `and_then`'s backward function for the inner region receives the
+//! whole closure given back when the borrow of the sink ends, whose shared
+//! capture the join's continuation did not retain ('Internal error',
+//! SymbolicToPureValues).
+
+pub struct Sink<'a> {
+    pub errors: &'a mut Vec<u32>,
+    pub n: u32,
+}
+
+pub struct Env {
+    pub k: u32,
+}
+
+pub enum Ty {
+    Fn(u32),
+    Other,
+}
+
+fn from_expr(x: &u32, env: &Env, errors: &mut Sink<'_>) -> Option<Ty> {
+    errors.n += 1;
+    if *x > env.k {
+        errors.errors.push(*x);
+        None
+    } else if *x == env.k {
+        Some(Ty::Other)
+    } else {
+        Some(Ty::Fn(*x + env.k))
+    }
+}
+
+/// The production shape
+pub fn arg_is_ref(e: Option<&u32>, index: u32, env: &Env, errors: &mut Sink<'_>) -> bool {
+    if let Some(Ty::Fn(n)) = e.and_then(|x| from_expr(x, env, errors)) {
+        if n > index {
+            return true;
+        }
+    }
+    index == 0
+}
+
+/// A match on the result instead of an `if let`, and a write through the
+/// sink between the call and the join
+pub fn arg_count(e: Option<&u32>, env: &Env, errors: &mut Sink<'_>) -> u32 {
+    let r = match e.and_then(|x| from_expr(x, env, errors)) {
+        Some(Ty::Fn(n)) => n,
+        Some(Ty::Other) => {
+            errors.errors.push(50);
+            1
+        }
+        None => 0,
+    };
+    errors.n += 2;
+    r
+}
+
+/// `(result, errors, sink.n, last error)`; the caller writes through the sink
+/// after the call
+pub fn run_arg_is_ref(x: u32, some: bool, index: u32, k: u32) -> (bool, u32, u32, u32) {
+    let mut v = Vec::new();
+    v.push(7);
+    let env = Env { k };
+    let mut sink = Sink { errors: &mut v, n: 10 };
+    let e = if some { Some(&x) } else { None };
+    let r = arg_is_ref(e, index, &env, &mut sink);
+    sink.errors.push(100 + sink.n);
+    sink.n += 1;
+    let n = sink.n;
+    let len = v.len() as u32;
+    let last = v[v.len() - 1];
+    (r, len, n, last)
+}
+
+/// `(result, errors, sink.n, last error)`
+pub fn run_arg_count(x: u32, some: bool, k: u32) -> (u32, u32, u32, u32) {
+    let mut v = Vec::new();
+    let env = Env { k };
+    let mut sink = Sink { errors: &mut v, n: 0 };
+    let e = if some { Some(&x) } else { None };
+    let r = arg_count(e, &env, &mut sink);
+    sink.errors.push(200 + sink.n);
+    let n = sink.n;
+    let len = v.len() as u32;
+    let last = v[v.len() - 1];
+    (r, len, n, last)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn arg_is_ref_native() {
+        assert_eq!(run_arg_is_ref(3, true, 2, 5), (true, 2, 12, 111));
+        assert_eq!(run_arg_is_ref(3, true, 9, 5), (false, 2, 12, 111));
+        assert_eq!(run_arg_is_ref(3, true, 0, 5), (true, 2, 12, 111));
+        assert_eq!(run_arg_is_ref(9, true, 1, 5), (false, 3, 12, 111));
+        assert_eq!(run_arg_is_ref(5, true, 0, 5), (true, 2, 12, 111));
+        assert_eq!(run_arg_is_ref(3, false, 0, 5), (true, 2, 11, 110));
+        assert_eq!(run_arg_is_ref(3, false, 4, 5), (false, 2, 11, 110));
+    }
+
+    #[test]
+    fn arg_count_native() {
+        assert_eq!(run_arg_count(3, true, 5), (8, 1, 3, 203));
+        assert_eq!(run_arg_count(5, true, 5), (1, 2, 3, 203));
+        assert_eq!(run_arg_count(9, true, 5), (0, 2, 3, 203));
+        assert_eq!(run_arg_count(9, false, 5), (0, 1, 2, 202));
+    }
+}
