@@ -0,0 +1,63 @@
+import NestedBorrowsCarrierFields.NestedBorrowsCarrierFields
+
+/-! Evaluate the model of `tests/src/nested-borrows-carrier-fields.rs` on the
+    inputs of its `native` test module and compare with the native results:
+    the values given back to the inner regions (the native, the frame's and the
+    walker's contexts, the visitor's output and hit count) and the other fields
+    of the structures and closure states, which the callees write through the
+    outer borrows (the sink's errors and counter, the frame's position, the
+    walker's depth, the counter captured by the visitor), read by the callers
+    after the calls. -/
+
+namespace nested_borrows_carrier_fields.checks
+open Aeneas Aeneas.Std Result
+open nested_borrows_carrier_fields
+
+def u (x : Nat) : U32 := ⟨BitVec.ofNat _ x⟩
+
+def val5 (r : Result (U32 × U32 × U32 × U32 × U32)) : Option (Nat × Nat × Nat × Nat × Nat) :=
+  match r with
+  | ok (a, b, c, d, e) => some (a.val, b.val, c.val, d.val, e.val)
+  | _ => none
+
+def val4 (r : Result (U32 × U32 × U32 × U32)) : Option (Nat × Nat × Nat × Nat) :=
+  match r with
+  | ok (a, b, c, d) => some (a.val, b.val, c.val, d.val)
+  | _ => none
+
+def val3 (r : Result (U32 × U32 × U32)) : Option (Nat × Nat × Nat) :=
+  match r with
+  | ok (a, b, c) => some (a.val, b.val, c.val)
+  | _ => none
+
+-- sink_loop_native
+#guard val5 (run_sink_loop (u 0) (u 9)) == some (0, 0, 1, 5, 14)
+#guard val5 (run_sink_loop (u 1) (u 9)) == some (2, 10, 104, 6, 34)
+#guard val5 (run_sink_loop (u 3) (u 9)) == some (6, 30, 1345, 8, 134)
+#guard val5 (run_sink_loop (u 4) (u 2)) == some (5, 1251, 1251, 8, 74)
+#guard val5 (run_sink_loop (u 5) (u 0)) == some (1, 12, 12, 6, 14)
+
+-- frame_loop_native
+#guard val3 (run_frame_loop true (u 0) (u 10) (u 0) false) == some (0, 10, 0)
+#guard val3 (run_frame_loop true (u 1) (u 10) (u 0) false) == some (1, 11, 1)
+#guard val3 (run_frame_loop true (u 3) (u 10) (u 1) false) == some (25, 35, 15)
+#guard val3 (run_frame_loop false (u 3) (u 10) (u 1) false) == some (0, 10, 1)
+#guard val3 (run_frame_loop true (u 2) (u 10) (u 2) true) == some (16, 1026, 11)
+#guard val3 (run_frame_loop true (u 4) (u 4294967295) (u 5) true) == some (176, 1175, 95)
+
+-- walk_native
+#guard val4 (run_walk (u 0)) == some (3, 3, 101, 1)
+#guard val4 (run_walk (u 1)) == some (10, 6, 103, 27)
+#guard val4 (run_walk (u 2)) == some (34, 12, 107, 2418)
+#guard val4 (run_walk (u 3)) == some (120, 24, 115, 15667164)
+
+-- collect_native
+#guard val5 (run_collect false (u 0) (u 100)) == some (0, 2, 50, 10, 0)
+#guard val5 (run_collect false (u 3) (u 100)) == some (0, 5, 15, 13, 0)
+#guard val5 (run_collect false (u 4) (u 5)) == some (15, 4, 8, 12, 0)
+#guard val5 (run_collect true (u 0) (u 100)) == some (0, 2, 50, 10, 1)
+#guard val5 (run_collect true (u 3) (u 100)) == some (0, 5, 15, 13, 8)
+#guard val5 (run_collect true (u 4) (u 5)) == some (15, 4, 8, 12, 8)
+#guard val5 (run_collect true (u 5) (u 1)) == some (8, 3, 3, 11, 4)
+
+end nested_borrows_carrier_fields.checks
