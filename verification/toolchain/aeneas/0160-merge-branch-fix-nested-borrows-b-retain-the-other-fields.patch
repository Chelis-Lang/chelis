+  match r with
+  | .Ok y => .ok y.val
+  | .Err e => .error e.val
+
+/-- `(result, errors, last error)` -/
+def runOne (isSome : Bool) (x tag : Nat) : Option (Except Nat Nat × Nat × Nat) :=
+  match run isSome (u x) (u tag) with
+  | ok (r, len, last) => some (res r, len.val, last.val)
+  | _ => none
+
+/-- `(result, resolver.n, errors, last error)` -/
