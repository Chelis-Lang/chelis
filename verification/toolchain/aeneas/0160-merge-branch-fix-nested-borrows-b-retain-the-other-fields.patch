+
+(** Register the context of a function call for the shared loans of the shared
+    borrows held by one of its inputs (see [bs_ctx.shared_loan_ctxs]). *)
+let register_shared_loan_ctxs (ectx : C.eval_ctx) (ctx : bs_ctx)
+    (v : V.tvalue) : bs_ctx =
+  let ctxs = ref ctx.shared_loan_ctxs in
+  let visitor =
+    object
+      inherit [_] V.iter_tvalue as super
+
+      method! visit_VSharedBorrow env bid sid =
+        if
+          (not (V.BorrowId.Map.mem bid !ctxs))
+          && Option.is_some
+               (InterpBorrowsCore.lookup_shared_value_opt ctx.span ectx.env bid)
+        then ctxs := V.BorrowId.Map.add bid ectx !ctxs;
+        super#visit_VSharedBorrow env bid sid
+    end
+  in
+  visitor#visit_tvalue () v;
+  { ctx with shared_loan_ctxs = !ctxs }
