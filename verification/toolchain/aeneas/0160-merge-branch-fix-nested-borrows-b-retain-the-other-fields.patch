+#guard runOne true 5 7 == some (.ok 5, 2, 100)
+#guard runOne false 5 7 == some (.error 7, 3, 100)
+
+-- run_resolver_native
+#guard runResolver true 5 7 == some (.ok 5, 10, 1, 110)
+#guard runResolver false 5 7 == some (.error 7, 11, 2, 111)
+
