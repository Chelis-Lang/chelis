index d8a8bac..9bf75eb 100644
--- a/backends/lean/Aeneas/Std/Core/FmtWithSlice.lean
+++ b/backends/lean/Aeneas/Std/Core/FmtWithSlice.lean
@@ -42,6 +42,24 @@ def displayString (s : String) (fmt : Formatter) : Outcome :=
   let s := if fmt.options.bit 28 then String.ofList (s.toList.take fmt.options.precision) else s
   fmt.pad s
 
+/-- `impl Debug for char` (core/src/fmt/mod.rs, rustc 1.95): `'`, the `escape_debug_ext` of the
+    character with `escape_grapheme_extended` and `escape_single_quote` (not the double quote)
+    written with `Display for EscapeDebug` (a single write, no padding), then `'`. -/
+@[rust_fun "core::fmt::{core::fmt::Debug<char>}::fmt"]
+def DebugChar.fmt (c : Char) (fmt : Formatter) : Outcome :=
+  thenFormat (fmt.append "'") (fun fmt =>
+    thenFormat (fmt.append (escapeDebugChar c '\'')) (fun fmt => fmt.append "'"))
+@[reducible, rust_trait_impl "core::fmt::Debug<char>"]
+def DebugChar : Debug Char := ⟨DebugChar.fmt⟩
+
+/-- `impl Display for char` (core/src/fmt/mod.rs): `write_char` without width and precision,
+    else `pad` of its UTF-8 encoding (the precision truncates, the width pads). -/
+@[rust_fun "core::fmt::{core::fmt::Display<char>}::fmt"]
+def DisplayChar.fmt (c : Char) (fmt : Formatter) : Outcome :=
+  displayString (String.singleton c) fmt
+@[reducible, rust_trait_impl "core::fmt::Display<char>"]
+def DisplayChar : Display Char := ⟨DisplayChar.fmt⟩
+
 @[rust_fun "core::fmt::{core::fmt::Debug<str>}::fmt"]
 def DebugStr.fmt (s : Str) (fmt : Formatter) : Outcome := do debugString (← decode s.val) fmt
 @[reducible, rust_trait_impl "core::fmt::Debug<str>"]
