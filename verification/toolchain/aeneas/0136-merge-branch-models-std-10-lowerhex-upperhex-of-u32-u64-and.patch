+@[partial_fixpoint_monotone]
+theorem Formatter.debug_tuple_field3_finish.monotone {α : Type u} [Lean.Order.PartialOrder α]
+    (fmt : Formatter) (name : Str) (v₀ v₁ v₂ : α → DebugValue)
+    (h₀ : monotone (fun a => debugValue (v₀ a)))
+    (h₁ : monotone (fun a => debugValue (v₁ a)))
+    (h₂ : monotone (fun a => debugValue (v₂ a))) :
