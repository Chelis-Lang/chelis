+//@ [!lean] skip
+//@ [lean] subdir=NestedBorrowsLoopThen
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::option::{core::option::Option} --include core::ops::deref::{core::ops::deref::Deref} --include core::ops::deref::{core::ops::deref::DerefMut}
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! `Option<&'1 mut Frame<'2>>` reborrowed with `as_deref_mut` in a loop, then
+//! matched (and written through) after the loop. The loop abstraction of the
+//! frame's region is staged at level 1: the first stage of its continuation
+//! receives the values of its borrow projectors (over the option the function
+//! received) and gives back those of its loan projectors (over the loop state).
+//! The match after the loop expands the loan projector over the loop state
+//! into `Some(<projector>)` or `None`: the first stage still gives back that
+//! position (nothing in the `None` branch), as when its continuation was bound.
+
+pub struct Frame<'a> {
+    pub steps: &'a [u32],
+    pub ctx: &'a mut u32,
+    pub pos: usize,
+}
+
+impl<'a> Frame<'a> {
+    pub fn advance(&mut self) -> u32 {
+        let s = self.steps[self.pos];
+        self.pos += 1;
+        *self.ctx = (*self.ctx).wrapping_add(s);
+        s
+    }
+}
+
+pub fn advance_or(execution: Option<&mut Frame<'_>>, d: u32) -> u32 {
+    match execution {
+        Some(f) => f.advance(),
+        None => d,
+    }
+}
+
+/// The frame is written after the loop
+pub fn loop_then_write(mut execution: Option<&mut Frame<'_>>, n: u32) -> u32 {
+    let mut acc = 0u32;
+    let mut i = 0;
+    while i < n {
+        if let Some(f) = execution.as_deref_mut() {
+            acc = acc.wrapping_add(f.advance());
+        }
+        i += 1;
+    }
+    if let Some(f) = execution {
+        *f.ctx = (*f.ctx).wrapping_add(100);
+    }
+    acc
+}
+
+/// The frame is advanced after the loop (`expect` in the loop)
+pub fn loop_expect_then(mut execution: Option<&mut Frame<'_>>, n: u32) -> u32 {
+    let mut acc = 0u32;
+    let mut i = 0;
+    while i < n {
+        i += 1;
+        acc = acc.wrapping_add(execution.as_deref_mut().expect("frame").advance());
+    }
+    match execution {
+        Some(f) => acc.wrapping_add(f.advance()),
+        None => acc,
+    }
+}
+
+/// The reborrow is given to a call in the loop, the frame advanced after it
+pub fn loop_reborrow_then(mut execution: Option<&mut Frame<'_>>, n: u32) -> u32 {
+    let mut acc = 0u32;
+    let mut i = 0;
+    while i < n {
+        i += 1;
+        acc = acc.wrapping_add(advance_or(execution.as_deref_mut(), i));
+    }
+    match execution {
+        Some(f) => acc.wrapping_add(f.advance()),
+        None => acc,
+    }
+}
+
+pub fn run_loop_then_write(f: &mut Frame<'_>, some: bool, n: u32) -> u32 {
+    if some { loop_then_write(Some(f), n) } else { loop_then_write(None, n) }
+}
+
+pub fn run_loop_expect_then(f: &mut Frame<'_>, some: bool, n: u32) -> u32 {
+    if some { loop_expect_then(Some(f), n) } else { loop_expect_then(None, n) }
+}
+
+pub fn run_loop_reborrow_then(f: &mut Frame<'_>, some: bool, n: u32) -> u32 {
+    if some { loop_reborrow_then(Some(f), n) } else { loop_reborrow_then(None, n) }
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    /// `(result, ctx, pos)` after running `run` on a frame over `steps`, the
+    /// caller then setting the frame's `ctx` to `set` (if any)
+    fn on_frame<R>(
+        ctx: u32,
+        pos: usize,
+        set: Option<u32>,
+        run: impl FnOnce(&mut Frame<'_>) -> R,
+    ) -> (R, u32, usize) {
+        let steps = [3u32, 5, 7, 11];
+        let mut c = ctx;
+        let mut f = Frame { steps: &steps, ctx: &mut c, pos };
+        let r = run(&mut f);
+        if let Some(s) = set {
+            *f.ctx = s;
+        }
+        let pos = f.pos;
+        (r, c, pos)
+    }
+
+    #[test]
+    fn loop_then_write_native() {
+        let run = |some, n| move |f: &mut Frame<'_>| run_loop_then_write(f, some, n);
+        assert_eq!(on_frame(10, 0, None, run(true, 0)), (0, 110, 0));
+        assert_eq!(on_frame(10, 0, None, run(true, 1)), (3, 113, 1));
+        assert_eq!(on_frame(10, 0, None, run(true, 3)), (15, 125, 3));
+        assert_eq!(on_frame(10, 1, None, run(true, 3)), (23, 133, 4));
+        assert_eq!(on_frame(10, 1, None, run(false, 3)), (0, 10, 1));
+        assert_eq!(on_frame(10, 1, Some(99), run(true, 2)), (12, 99, 3));
+        assert_eq!(on_frame(u32::MAX, 0, None, run(true, 2)), (8, 107, 2));
+    }
+
+    #[test]
+    fn loop_expect_then_native() {
+        let run = |some, n| move |f: &mut Frame<'_>| run_loop_expect_then(f, some, n);
+        assert_eq!(on_frame(10, 0, None, run(true, 0)), (3, 13, 1));
+        assert_eq!(on_frame(10, 0, None, run(true, 2)), (15, 25, 3));
+        assert_eq!(on_frame(10, 1, None, run(true, 2)), (23, 33, 4));
+        assert_eq!(on_frame(10, 1, None, run(false, 0)), (0, 10, 1));
+        assert_eq!(on_frame(10, 0, Some(99), run(true, 1)), (8, 99, 2));
+        assert_eq!(on_frame(u32::MAX, 0, None, run(true, 1)), (8, 7, 2));
+    }
+
+    #[test]
+    #[should_panic(expected = "frame")]
+    fn loop_expect_then_none_panics() {
+        on_frame(10, 1, None, |f| run_loop_expect_then(f, false, 1));
+    }
+
+    #[test]
+    #[should_panic]
+    fn loop_expect_then_out_of_steps_panics() {
+        on_frame(10, 2, None, |f| run_loop_expect_then(f, true, 2));
+    }
+
+    #[test]
+    fn loop_reborrow_then_native() {
+        let run = |some, n| move |f: &mut Frame<'_>| run_loop_reborrow_then(f, some, n);
+        assert_eq!(on_frame(10, 0, None, run(true, 0)), (3, 13, 1));
+        assert_eq!(on_frame(10, 0, None, run(true, 2)), (15, 25, 3));
+        assert_eq!(on_frame(10, 1, None, run(false, 3)), (6, 10, 1));
+        assert_eq!(on_frame(10, 0, Some(99), run(true, 1)), (8, 99, 2));
+        assert_eq!(on_frame(u32::MAX, 1, None, run(true, 1)), (12, 11, 3));
+    }
+}
