@@ -0,0 +1,62 @@
+import NestedBorrowsLoopThen.NestedBorrowsLoopThen
+
+/-! Evaluate the model of `tests/src/nested-borrows-loop-then.rs` on
+    the inputs of its `native` test module and compare with the native results
+    `(result, ctx, pos)`: `pos` is the frame given back through the `&mut`
+    (the forward output), `ctx` the value of the frame's region given back by
+    the backward function of that region when the caller gives the frame
+    back. -/
+
+namespace nested_borrows_loop_then.checks
+open Aeneas Aeneas.Std Result
+
+def u (x : Nat) : U32 := ⟨BitVec.ofNat _ x⟩
+def us (x : Nat) : Usize := ⟨BitVec.ofNat _ x⟩
+
+def max := 4294967295
+
+def sl (xs : List Nat) (h : xs.length ≤ Usize.max := by scalar_tac) : Slice U32 :=
+  ⟨xs.map u, by simpa using h⟩
+
+def frame (ctx pos : Nat) : Frame := { steps := sl [3, 5, 7, 11], ctx := u ctx, pos := us pos }
+
+/-- `run (&mut frame)`; the caller then sets the frame's `ctx` to `set` (if
+    any) and gives the frame back -/
+def onFrame (run : Frame → Result (U32 × Frame × (Frame → Frame)))
+    (ctx pos : Nat) (set : Option Nat := none) : Option (Nat × Nat × Nat) :=
+  match run (frame ctx pos) with
+  | ok (r, f1, back) =>
+    let f1' := match set with
+      | some c => { f1 with ctx := u c }
+      | none => f1
+    some (r.val, (back f1').ctx.val, f1.pos.val)
+  | _ => none
+
+-- loop_then_write_native
+#guard onFrame (run_loop_then_write · true (u 0)) 10 0 == some (0, 110, 0)
+#guard onFrame (run_loop_then_write · true (u 1)) 10 0 == some (3, 113, 1)
+#guard onFrame (run_loop_then_write · true (u 3)) 10 0 == some (15, 125, 3)
+#guard onFrame (run_loop_then_write · true (u 3)) 10 1 == some (23, 133, 4)
+#guard onFrame (run_loop_then_write · false (u 3)) 10 1 == some (0, 10, 1)
+#guard onFrame (run_loop_then_write · true (u 2)) 10 1 (set := some 99) == some (12, 99, 3)
+#guard onFrame (run_loop_then_write · true (u 2)) max 0 == some (8, 107, 2)
+
+-- loop_expect_then_native
+#guard onFrame (run_loop_expect_then · true (u 0)) 10 0 == some (3, 13, 1)
+#guard onFrame (run_loop_expect_then · true (u 2)) 10 0 == some (15, 25, 3)
+#guard onFrame (run_loop_expect_then · true (u 2)) 10 1 == some (23, 33, 4)
+#guard onFrame (run_loop_expect_then · false (u 0)) 10 1 == some (0, 10, 1)
+#guard onFrame (run_loop_expect_then · true (u 1)) 10 0 (set := some 99) == some (8, 99, 2)
+#guard onFrame (run_loop_expect_then · true (u 1)) max 0 == some (8, 7, 2)
+-- loop_expect_then_none_panics, loop_expect_then_out_of_steps_panics
+#guard onFrame (run_loop_expect_then · false (u 1)) 10 1 == none
+#guard onFrame (run_loop_expect_then · true (u 2)) 10 2 == none
+
+-- loop_reborrow_then_native
+#guard onFrame (run_loop_reborrow_then · true (u 0)) 10 0 == some (3, 13, 1)
+#guard onFrame (run_loop_reborrow_then · true (u 2)) 10 0 == some (15, 25, 3)
+#guard onFrame (run_loop_reborrow_then · false (u 3)) 10 1 == some (6, 10, 1)
+#guard onFrame (run_loop_reborrow_then · true (u 1)) 10 0 (set := some 99) == some (8, 99, 2)
+#guard onFrame (run_loop_reborrow_then · true (u 1)) max 1 == some (12, 11, 3)
+
+end nested_borrows_loop_then.checks
