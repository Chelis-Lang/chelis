+/// A struct with the hand-written form of `#[derive(Deserialize)] #[serde(deny_unknown_fields)]`
+/// (serde_derive 1.0.228, the `visit_map` arm; the sequence form is as `Entry`'s).
+pub struct Settings {
+    pub id: u32,
+    pub limit: Option<u32>,
+}
+
+const SETTINGS_FIELDS: &[&str] = &["id", "limit"];
+
+enum SettingsField {
+    Id,
+    Limit,
+}
+
+struct SettingsFieldVisitor;
+
+impl<'de> Visitor<'de> for SettingsFieldVisitor {
+    type Value = SettingsField;
+
+    fn expecting(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        formatter.write_str("field identifier")
+    }
+
+    fn visit_str<E: de::Error>(self, value: &str) -> Result<SettingsField, E> {
+        match value {
+            "id" => Ok(SettingsField::Id),
+            "limit" => Ok(SettingsField::Limit),
+            _ => Err(E::unknown_field(value, SETTINGS_FIELDS)),
+        }
+    }
+
+    fn visit_bytes<E: de::Error>(self, value: &[u8]) -> Result<SettingsField, E> {
+        match value {
+            b"id" => Ok(SettingsField::Id),
+            b"limit" => Ok(SettingsField::Limit),
+            _ => {
+                let value = &serde::__private228::from_utf8_lossy(value);
+                Err(E::unknown_field(value, SETTINGS_FIELDS))
+            }
+        }
+    }
+}
+
+impl<'de> Deserialize<'de> for SettingsField {
+    fn deserialize<D: Deserializer<'de>>(deserializer: D) -> Result<SettingsField, D::Error> {
+        deserializer.deserialize_identifier(SettingsFieldVisitor)
+    }
+}
+
+struct SettingsVisitor;
+
+impl<'de> Visitor<'de> for SettingsVisitor {
+    type Value = Settings;
+
+    fn expecting(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        formatter.write_str("struct Settings")
+    }
+
+    fn visit_map<A: MapAccess<'de>>(self, mut map: A) -> Result<Settings, A::Error> {
+        let mut id: Option<u32> = None;
+        let mut limit: Option<Option<u32>> = None;
+        while let Some(key) = map.next_key::<SettingsField>()? {
+            match key {
+                SettingsField::Id => {
+                    if id.is_some() {
+                        return Err(de::Error::duplicate_field("id"));
+                    }
+                    id = Some(map.next_value::<u32>()?);
+                }
+                SettingsField::Limit => {
+                    if limit.is_some() {
+                        return Err(de::Error::duplicate_field("limit"));
+                    }
+                    limit = Some(map.next_value::<Option<u32>>()?);
+                }
+            }
+        }
+        let id = match id {
+            Some(id) => id,
+            None => serde::__private228::de::missing_field("id")?,
+        };
+        let limit = match limit {
+            Some(limit) => limit,
+            None => serde::__private228::de::missing_field("limit")?,
+        };
+        Ok(Settings { id, limit })
+    }
+}
+
+impl<'de> Deserialize<'de> for Settings {
+    fn deserialize<D: Deserializer<'de>>(deserializer: D) -> Result<Settings, D::Error> {
+        deserializer.deserialize_struct("Settings", SETTINGS_FIELDS, SettingsVisitor)
+    }
+}
