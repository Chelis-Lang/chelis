+/-- `str::ends_with` (core/src/str/mod.rs): `pat.is_suffix_of(self)`. `Pattern`'s
+    `is_suffix_of` is `matches!(self.into_searcher(haystack).next_back(), Match(_, j) if
+    haystack.len() == j)`; the overrides of `&str` (`haystack.as_bytes().ends_with(self)`) and
+    `char` (its UTF-8 encoding as a `&str`) decide the same: whether the first match of the
+    reverse searcher ends at the end of the haystack, as for `strip_suffix`. -/
+@[rust_fun "core::str::{str}::ends_with" (keepTraitClauses := [true, false])]
+def core.str.Str.ends_with {P : Type} (patInst : core.str.pattern.Pattern P)
+    (s : Str) (pat : P) : Result Bool :=
+  match patInst.reverse_matches with
+  | none => .fail .panic
+  | some search => do
+    match ← search pat s with
+    | (_, stop) :: _ => .ok (stop = s.val.length)
+    | [] => .ok false
+
+/-- `str::rfind` (core/src/str/mod.rs): `pat.into_searcher(self).next_match_back().map(|(i,
+    _)| i)`, the start of the first match of the reverse searcher (`Pattern.reverse_matches`),
+    a byte index of the haystack. -/
+@[rust_fun "core::str::{str}::rfind" (keepTraitClauses := [true, false])]
+def core.str.Str.rfind {P : Type} (patInst : core.str.pattern.Pattern P)
+    (s : Str) (pat : P) : Result (Option Usize) :=
+  match patInst.reverse_matches with
+  | none => .fail .panic
+  | some search => do
+    match ← search pat s with
+    | [] => .ok none
+    | (start, _) :: _ => .ok (some (← UScalar.tryMk .Usize start))
+
