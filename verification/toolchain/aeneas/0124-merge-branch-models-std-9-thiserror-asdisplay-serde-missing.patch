+/-- `TAG_CONT_U8`: `byte & 192 == 128`. -/
+def isCont (b : Nat) : Bool := b % 256 / 64 == 2
+
+/-- One `Utf8Chunks::next` (core str/lossy.rs, rustc 1.95) on a nonempty source: `(valid_up_to, i)`,
+    the length of the chunk's valid prefix and the number of bytes it inspects (its valid part and
+    its invalid part, a maximal prefix of an ill-formed sequence). Bytes past the end read as 0. -/
+def chunkSplit (src : Array Nat) : Nat × Nat :=
+  let get := fun i => src.getD i 0
+  let rec loop (i valid : Nat) : (fuel : Nat) → Nat × Nat
+    | 0 => (valid, i)
+    | fuel + 1 =>
+      if i < src.size then
+        let byte := get i
+        let i := i + 1
+        if byte < 128 then loop i i fuel
+        else if 0xC2 ≤ byte ∧ byte ≤ 0xDF then
+          if isCont (get i) then loop (i + 1) (i + 1) fuel else (valid, i)
+        else if 0xE0 ≤ byte ∧ byte ≤ 0xEF then
+          let b := get i
+          let second :=
+            (byte == 0xE0 && 0xA0 ≤ b && b ≤ 0xBF) || (0xE1 ≤ byte && byte ≤ 0xEC && 0x80 ≤ b && b ≤ 0xBF) ||
+            (byte == 0xED && 0x80 ≤ b && b ≤ 0x9F) || (0xEE ≤ byte && byte ≤ 0xEF && 0x80 ≤ b && b ≤ 0xBF)
+          if !second then (valid, i)
+          else if isCont (get (i + 1)) then loop (i + 2) (i + 2) fuel else (valid, i + 1)
+        else if 0xF0 ≤ byte ∧ byte ≤ 0xF4 then
+          let b := get i
+          let second :=
+            (byte == 0xF0 && 0x90 ≤ b && b ≤ 0xBF) || (0xF1 ≤ byte && byte ≤ 0xF3 && 0x80 ≤ b && b ≤ 0xBF) ||
+            (byte == 0xF4 && 0x80 ≤ b && b ≤ 0x8F)
+          if !second then (valid, i)
+          else if !isCont (get (i + 1)) then (valid, i + 1)
+          else if isCont (get (i + 2)) then loop (i + 3) (i + 3) fuel else (valid, i + 2)
+        else (valid, i)
+      else (valid, i)
+  loop 0 0 src.size
+
+/-- The chunks of `bytes` (`<[u8]>::utf8_chunks`): each chunk's valid part and whether its invalid
+    part is nonempty. -/
+def chunks (bytes : List Nat) : List (List Nat × Bool) :=
+  let rec go : (fuel : Nat) → List Nat → List (List Nat × Bool)
+    | 0, _ => []
+    | _, [] => []
+    | fuel + 1, src@(_ :: _) =>
+      let (valid, inspected) := chunkSplit src.toArray
+      (src.take valid, valid < inspected) :: go fuel (src.drop inspected)
+  go bytes.length bytes
+
+end alloc.string.lossy
+
+/-- `String::from_utf8_lossy` (alloc string.rs, rustc 1.95): `Cow::Borrowed` of the input when it
+    is valid UTF-8 (the first chunk has no invalid part; `""` for no chunk), otherwise
+    `Cow::Owned` of the valid parts with U+FFFD for each invalid part. -/
+@[rust_fun "alloc::string::{alloc::string::String}::from_utf8_lossy"]
+def alloc.string.String.from_utf8_lossy (v : Slice U8) :
+    Result (alloc.borrow.Cow Str String) := do
+  let bytes := v.val.map (·.val)
+  match alloc.string.lossy.chunks bytes with
+  | [] => .ok (.Borrowed v)
+  | (_, false) :: _ => .ok (.Borrowed v)
+  | cs =>
+    let decode (valid : List Nat) : Result String :=
+      match String.fromUTF8? ⟨(valid.map Nat.toUInt8).toArray⟩ with
+      | some s => .ok s
+      | none => .fail .undef
+    let mut res := ""
+    for (valid, invalid) in cs do
+      res := res ++ (← decode valid)
+      if invalid then res := res.push '\uFFFD'
+    .ok (.Owned res)
+
 end Aeneas.Std
