+/-- `OptionVisitor<T>` of `impl Deserialize for Option<T>` (de/impls.rs): `visit_unit` and
+    `visit_none` are `Ok(None)`, `visit_some` is `T::deserialize(deserializer).map(Some)`; the
+    other `visit_*` are the provided ones (`invalid_type`, expecting "option"). -/
+def OptionVisitor {T : Type} (i : serde_core.de.Deserialize T) :
+    serde_core.de.Visitor Unit (Option T) :=
+  { expecting := fun _ f => f.append "option"
+    visit_unit := fun _ _ => .ok (.Ok none)
+    visit_none := fun _ _ => .ok (.Ok none)
+    visit_some := fun inst _ deserializer => do
+      match ← i.deserialize inst deserializer with
+      | .Ok v => .ok (.Ok (some v))
+      | .Err e => .ok (.Err e) }
+
+/-- `impl<'de, T: Deserialize<'de>> Deserialize<'de> for Option<T>`:
+    `deserializer.deserialize_option(OptionVisitor { marker: PhantomData })`. -/
+@[rust_fun
