 /-- `bool::then` (core/src/bool.rs): `if self { Some(f()) } else { None }`. The closure
-    is called once when the condition holds, else dropped without being called. -/
+    is called once when the condition holds, else dropped without being called. The model
+    returns the closure's final state (the canonical state ABI of its input 1,
+    `ModelStateABI.modeled_fun_abi`): its state after the call, or the closure unchanged when
+    it is not called. A partial-monomorphization instance of `then` at a closure capturing
+    mutable borrows gives back to them the values in this state. -/
 @[rust_fun "core::bool::{bool}::then"]
 def core.bool.Bool.then {T F : Type} (fnInst : core.ops.function.FnOnce F Unit T)
-    (condition : Bool) (f : F) : Result (Option T) :=
+    (condition : Bool) (f : F) : Result (Option T × F) :=
   if condition then do
-    let (value, _) ← fnInst.call_once f ()
-    ok (some value)
-  else ok none
+    let (value, f) ← fnInst.call_once f ()
+    ok (some value, f)
+  else ok (none, f)
 
