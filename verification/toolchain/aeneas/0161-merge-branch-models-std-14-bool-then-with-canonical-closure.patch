index 0000000..04b002d
--- /dev/null
+++ b/tests/src/vec-as-mut-slice.rs
@@ -0,0 +1,80 @@
+//@ [!lean] skip
+//@ [lean] subdir=VecAsMutSlice
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! `Vec::as_mut_slice`, which chelis-deep (`identity.rs` assign, `annotations_transform.rs`
+//! try_inherit_extensions) matches the elements of a vector with: the whole vector as a mutable
+//! slice, whose writes the vector keeps. VecAsMutSlice/Checks.lean compares the model with the
+//! native results asserted in the native test module, including the vectors given back.
+
+pub struct List {
+    pub elements: Vec<u32>,
+}
+
+/// A write through an element of the slice (the second one, when there are exactly two).
+pub fn stamp_second(list: &mut List, value: u32) -> bool {
+    let slice = list.elements.as_mut_slice();
+    if slice.len() == 2 {
+        slice[1] = value;
+        true
+    } else {
+        false
+    }
+}
+
+/// A walk over every element of the slice.
+pub fn bump_all(v: &mut Vec<u32>) -> usize {
+    let slice = v.as_mut_slice();
+    for x in slice.iter_mut() {
+        *x += 1;
+    }
+    slice.len()
+}
+
+/// The slice given to a helper, then the vector used again.
+fn swap_ends(s: &mut [u32]) {
+    let n = s.len();
+    if n > 1 {
+        s.swap(0, n - 1);
+    }
+}
+
+pub fn swap_then_push(mut v: Vec<u32>, x: u32) -> Vec<u32> {
+    swap_ends(v.as_mut_slice());
+    v.push(x);
+    v
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn stamps() {
+        let mut list = List { elements: vec![1, 2] };
+        assert!(stamp_second(&mut list, 9));
+        assert_eq!(list.elements, vec![1, 9]);
+        let mut list = List { elements: vec![1, 2, 3] };
+        assert!(!stamp_second(&mut list, 9));
+        assert_eq!(list.elements, vec![1, 2, 3]);
+    }
+
+    #[test]
+    fn bumps() {
+        let mut v = vec![0, 5, 7];
+        assert_eq!(bump_all(&mut v), 3);
+        assert_eq!(v, vec![1, 6, 8]);
+        let mut e: Vec<u32> = vec![];
+        assert_eq!(bump_all(&mut e), 0);
+        assert_eq!(e, Vec::<u32>::new());
+        let mut o = vec![1, u32::MAX];
+        assert!(std::panic::catch_unwind(move || bump_all(&mut o)).is_err());
+    }
+
+    #[test]
+    fn swaps() {
+        assert_eq!(swap_then_push(vec![1, 2, 3], 4), vec![3, 2, 1, 4]);
+        assert_eq!(swap_then_push(vec![1], 4), vec![1, 4]);
+        assert_eq!(swap_then_push(vec![], 4), vec![4]);
+    }
+}
