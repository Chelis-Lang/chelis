+import OptionGetOrInsert.OptionGetOrInsert
+
+/-! Evaluate the model of `tests/src/option-get-or-insert.rs` on the inputs of its `native` test
+    module and compare with the native results, including the options given back. -/
+namespace option_get_or_insert.checks
+open Aeneas Aeneas.Std Result
+
+def slice {α : Type} (xs : List α) : Slice α :=
+  if h : xs.length ≤ Usize.max then ⟨xs, h⟩ else ⟨[], by simp⟩
+def u32 (n : Nat) : U32 := ⟨BitVec.ofNat _ n⟩
+def usize (n : Nat) : Usize := ⟨BitVec.ofNat _ n⟩
+def txt (x : Str) : Option String :=
+  match Str.toString x with | ok t => some t | _ => none
+
+/-- A reason as the text of its `Debug` form. -/
+def reasonR : Reason → String
+  | .Recursive => "Recursive"
+  | .HigherOrder => "HigherOrder"
+  | .Runtime n => s!"Runtime({n.val})"
+
+def visitOf (rs : List Reason) : Option (Option String × Nat) :=
+  match visit_all (slice rs) with
+  | ok (r, n) => some (r.map reasonR, n.val)
+  | _ => none
+
+#guard visitOf [] == some (none, 0)
+#guard visitOf [.HigherOrder, .Recursive, .Runtime (u32 3)] == some (some "HigherOrder", 3)
+#guard visitOf [.Runtime (u32 4), .Recursive] == some (some "Runtime(4)", 2)
+
+def fallbackOf (names : List Str) (want : Str) : Option (Option String) :=
+  match first_or_match (slice names) want with
+  | ok (some s) => (txt s).map some
+  | ok none => some none
+  | _ => none
+
+#guard fallbackOf [toStr "a", toStr "b", toStr "c"] (toStr "b") == some (some "b")
+#guard fallbackOf [toStr "a", toStr "b", toStr "c"] (toStr "z") == some (some "a")
+#guard fallbackOf [] (toStr "z") == some none
+
+def seedOf (parents : List (Option Nat)) (start : Nat) : Option (List (Option Nat)) :=
+  match seed (slice (parents.map fun p => ({ seed_parent := p.map usize } : Site))) (usize start) with
+  | ok sites => some (sites.val.map fun s => s.seed_parent.map (·.val))
+  | _ => none
+
+#guard seedOf [some 1, none, none] 7 == some [some 1, some 7, some 7]
+
+def bumpOf (slot : Option Nat) (value : Nat) : Option (Nat × Option Nat) :=
+  match bump (slot.map u32) (u32 value) with
+  | ok (r, slot) => some (r.val, slot.map (·.val))
+  | _ => none
+
+#guard bumpOf none 5 == some (6, some 6)
+#guard bumpOf (some 6) 50 == some (7, some 7)
+#guard bumpOf (some 4294967295) 0 == none
+
+end option_get_or_insert.checks
