+namespace vec_as_mut_slice.checks
+open Aeneas Aeneas.Std Result
+
+def vec (xs : _root_.List Nat) : alloc.vec.Vec U32 :=
+  let xs := xs.map fun n => (⟨BitVec.ofNat _ n⟩ : U32)
+  if h : xs.length ≤ Usize.max then ⟨xs, h⟩ else ⟨[], by simp⟩
+def nats (v : alloc.vec.Vec U32) : _root_.List Nat := v.val.map (·.val)
