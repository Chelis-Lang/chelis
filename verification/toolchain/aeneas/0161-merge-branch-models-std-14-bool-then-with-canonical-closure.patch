+#guard bumpOf [] == some (0, [])
+#guard bumpOf [1, 4294967295] == none
+
+def swapOf (xs : _root_.List Nat) (x : Nat) : Option (_root_.List Nat) :=
+  match swap_then_push (vec xs) (u32 x) with
+  | ok v => some (nats v)
+  | _ => none
+
+#guard swapOf [1, 2, 3] 4 == some [3, 2, 1, 4]
+#guard swapOf [1] 4 == some [1, 4]
+#guard swapOf [] 4 == some [4]
+
+end vec_as_mut_slice.checks
