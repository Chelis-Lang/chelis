+def stampOf (xs : _root_.List Nat) (value : Nat) : Option (Bool × _root_.List Nat) :=
+  match stamp_second { elements := vec xs } (u32 value) with
+  | ok (b, l) => some (b, nats l.elements)
+  | _ => none
+
+#guard stampOf [1, 2] 9 == some (true, [1, 9])
+#guard stampOf [1, 2, 3] 9 == some (false, [1, 2, 3])
