new file mode 100644
index 0000000..ec3052b
--- /dev/null
+++ b/tests/src/slice-array-eq.rs
@@ -0,0 +1,92 @@
+//@ [!lean] skip
+//@ [lean] subdir=SliceArrayEq
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Comparisons of a shared slice (`&[T]`) and of a `Vec<T>` with an array, as chelis-types
+//! (`builtin_discovery.rs`: `self.capability.domains == [Domain::Numeric]` on a `&'static [_]`)
+//! and chelis-ir (`verify.rs`: `lhs_matrix != [m, k]` on a subslice; `evaluation.rs`:
+//! `scopes != [ScopeId(0)]` on a `Vec`) use them: `&[T] == [U; N]` is `**self == *other` (the
+//! `[T]`/`[U; N]` comparison), `Vec<T> == [U; N]` is `self[..] == other[..]` (the slice
+//! comparison), false (resp. true for `!=`) when the lengths differ. SliceArrayEq/Checks.lean
+//! compares the model with the native results asserted in the native test module.
+
+#[derive(Clone, Copy, PartialEq, Debug)]
+pub enum Domain {
+    Numeric,
+    Boolean,
+    Text(u8),
+}
+
+pub struct Capability<'a> {
+    pub domains: &'a [Domain],
+}
+
+/// builtin_discovery.rs
+pub fn is_numeric(c: &Capability<'_>) -> bool {
+    c.domains == [Domain::Numeric]
+}
+
+pub fn is_mixed(c: &Capability<'_>) -> bool {
+    c.domains == [Domain::Numeric, Domain::Text(1)]
+}
+
+/// verify.rs: the last two dimensions of a vector compared with a pair.
+pub fn matrix_differs(dims: &Vec<u32>, m: u32, k: u32) -> bool {
+    let matrix = &dims[dims.len() - 2..];
+    matrix != [m, k]
+}
+
+/// evaluation.rs: a stack of scopes compared with the root scope.
+pub fn not_root(scopes: &Vec<u32>) -> bool {
+    *scopes != [0]
+}
+
+pub fn is_root(scopes: Vec<Domain>) -> bool {
+    scopes == [Domain::Boolean]
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn slices() {
+        let numeric = [Domain::Numeric];
+        let mixed = [Domain::Numeric, Domain::Text(1)];
+        let other = [Domain::Text(1), Domain::Numeric];
+        assert!(is_numeric(&Capability { domains: &numeric }));
+        assert!(!is_numeric(&Capability { domains: &mixed }));
+        assert!(!is_numeric(&Capability { domains: &[] }));
+        assert!(!is_numeric(&Capability { domains: &[Domain::Boolean] }));
+        assert!(is_mixed(&Capability { domains: &mixed }));
+        assert!(!is_mixed(&Capability { domains: &other }));
+        assert!(!is_mixed(&Capability { domains: &numeric }));
+        assert!(!is_mixed(&Capability { domains: &[] }));
+    }
+
+    #[test]
+    fn matrices() {
+        assert!(!matrix_differs(&vec![9, 2, 3], 2, 3));
+        assert!(matrix_differs(&vec![9, 2, 3], 3, 2));
+        assert!(!matrix_differs(&vec![4, 5], 4, 5));
+        assert!(matrix_differs(&vec![4, 5], 4, 6));
+    }
+
+    #[test]
+    #[should_panic]
+    fn matrix_too_short() {
+        matrix_differs(&vec![1], 1, 1);
+    }
+
+    #[test]
+    fn vecs() {
+        assert!(!not_root(&vec![0]));
+        assert!(not_root(&vec![0, 1]));
+        assert!(not_root(&vec![]));
+        assert!(not_root(&vec![1]));
+        assert!(is_root(vec![Domain::Boolean]));
+        assert!(!is_root(vec![Domain::Text(0)]));
+        assert!(!is_root(vec![Domain::Boolean, Domain::Boolean]));
+        assert!(!is_root(vec![]));
+    }
+}
