diff --git a/tests/src/bool-then-closure-state.rs b/tests/src/bool-then-closure-state.rs
new file mode 100644
index 0000000..71d3d49
--- /dev/null
+++ b/tests/src/bool-then-closure-state.rs
@@ -0,0 +1,161 @@
+//@ [!lean] skip
+//@ [lean] subdir=BoolThenClosureState
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::option::{core::option::Option}
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! `bool::then` with closures which capture mutable borrows, as chelis-types uses it
+//! (`deep_type.rs` resolve_type_var/resolve_dim_var/resolve_rank_var, `app_hostio.rs`,
+//! `program.rs`): the partial-monomorphization instance of `then` at such a closure returns the
+//! closure's final state, so the model returns it too (the closure is called once when the
+//! condition holds, and dropped unchanged otherwise). BoolThenClosureState/Checks.lean compares
+//! the model with the native results asserted in the native test module, including the values
+//! given back to the captured borrows.
+
+pub struct VarGen {
+    pub next_tvar: u32,
+}
+
+impl VarGen {
+    pub fn fresh_tvar(&mut self) -> u32 {
+        let v = self.next_tvar;
+        self.next_tvar += 1;
+        v
+    }
+}
+
+pub struct Resolver {
+    pub holes: bool,
+}
+
+impl Resolver {
+    fn allows_hole(&self) -> bool {
+        self.holes
+    }
+
+    fn unbound(&self, errors: &mut Vec<u32>, code: u32) -> u32 {
+        errors.push(code);
+        code
+    }
+
+    /// chelis-types `deep_type.rs` resolve_type_var: a hole takes a fresh variable when holes are
+    /// allowed, and reports an unbound name otherwise.
+    pub fn resolve(&mut self, vg: &mut VarGen, errors: &mut Vec<u32>, name: u32) -> Result<u32, u32> {
+        if name == 0 {
+            return self
+                .allows_hole()
+                .then(|| vg.fresh_tvar())
+                .ok_or_else(|| self.unbound(errors, 7));
+        }
+        Ok(name)
+    }
+}
+
+/// chelis-types `app_hostio.rs`: a diagnostic pushed only when the check fails.
+pub fn check(ok: bool, errors: &mut Vec<u32>, code: u32) -> Option<usize> {
+    (!ok).then(|| {
+        errors.push(code);
+        errors.len()
+    })
+}
+
+/// Two closures, each capturing two mutable borrows; exactly one of them is called.
+pub fn scoped(cyclic: bool, vg: &mut VarGen, log: &mut Vec<u32>) -> (Option<u32>, Option<u32>) {
+    let a = cyclic.then(|| {
+        let v = vg.fresh_tvar();
+        log.push(v);
+        v
+    });
+    let b = (!cyclic).then(|| {
+        let v = vg.fresh_tvar();
+        log.push(v + 100);
+        v
+    });
+    (a, b)
+}
+
+/// A closure which captures nothing mutable.
+pub fn plain(cond: bool, x: u32) -> Option<u32> {
+    cond.then(|| x + 1)
+}
+
+/// A generic closure (the dictionary of its bound), and a caller passing a closure which captures
+/// a mutable borrow.
+pub fn generic<F: FnOnce() -> u32>(cond: bool, f: F) -> Option<u32> {
+    cond.then(f)
+}
+
+pub fn twice(vg: &mut VarGen) -> (Option<u32>, Option<u32>, Option<u32>) {
+    let a = generic(true, || vg.fresh_tvar());
+    let b = generic(false, || vg.fresh_tvar());
+    let c = generic(true, || vg.fresh_tvar() * 10);
+    (a, b, c)
+}
+
+/// The closure's call fails (arithmetic overflow): the failure propagates.
+pub fn overflow(cond: bool, vg: &mut VarGen) -> Option<u32> {
+    cond.then(|| {
+        vg.next_tvar += u32::MAX;
+        vg.next_tvar
+    })
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn resolve() {
+        let mut r = Resolver { holes: true };
+        let mut vg = VarGen { next_tvar: 5 };
+        let mut errors = vec![1];
+        assert_eq!(r.resolve(&mut vg, &mut errors, 0), Ok(5));
+        assert_eq!(vg.next_tvar, 6);
+        assert_eq!(errors, vec![1]);
+        assert_eq!(r.resolve(&mut vg, &mut errors, 3), Ok(3));
+        assert_eq!(vg.next_tvar, 6);
+        let mut r = Resolver { holes: false };
+        assert_eq!(r.resolve(&mut vg, &mut errors, 0), Err(7));
+        assert_eq!(vg.next_tvar, 6);
+        assert_eq!(errors, vec![1, 7]);
+    }
+
+    #[test]
+    fn check_pushes() {
+        let mut errors = vec![4];
+        assert_eq!(check(true, &mut errors, 9), None);
+        assert_eq!(errors, vec![4]);
+        assert_eq!(check(false, &mut errors, 9), Some(2));
+        assert_eq!(errors, vec![4, 9]);
+    }
+
+    #[test]
+    fn scoped_calls_one() {
+        let mut vg = VarGen { next_tvar: 2 };
+        let mut log = vec![];
+        assert_eq!(scoped(true, &mut vg, &mut log), (Some(2), None));
+        assert_eq!(vg.next_tvar, 3);
+        assert_eq!(log, vec![2]);
+        assert_eq!(scoped(false, &mut vg, &mut log), (None, Some(3)));
+        assert_eq!(vg.next_tvar, 4);
+        assert_eq!(log, vec![2, 103]);
+    }
+
+    #[test]
+    fn plain_and_generic() {
+        assert_eq!(plain(true, 1), Some(2));
+        assert_eq!(plain(false, 1), None);
+        let mut vg = VarGen { next_tvar: 1 };
+        assert_eq!(twice(&mut vg), (Some(1), None, Some(20)));
+        assert_eq!(vg.next_tvar, 3);
+    }
+
+    #[test]
+    fn overflow_fails() {
+        let mut vg = VarGen { next_tvar: 1 };
+        assert_eq!(overflow(false, &mut vg), None);
+        assert_eq!(vg.next_tvar, 1);
+        let mut vg = VarGen { next_tvar: 0 };
+        assert_eq!(overflow(true, &mut vg), Some(u32::MAX));
+        let mut vg = VarGen { next_tvar: 1 };
+        assert!(std::panic::catch_unwind(move || overflow(true, &mut vg)).is_err());
+    }
+}
