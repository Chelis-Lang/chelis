+import BoolThenClosureState.BoolThenClosureState
+
+/-! Evaluate the model of `tests/src/bool-then-closure-state.rs` on the inputs of its `native` test
+    module and compare with the native results, including the values given back to the borrows
+    the closures capture. -/
+namespace bool_then_closure_state.checks
+open Aeneas Aeneas.Std Result
+
+def u32 (n : Nat) : U32 := ⟨BitVec.ofNat _ n⟩
+def vec (xs : List Nat) : alloc.vec.Vec U32 :=
+  let xs := xs.map u32
+  if h : xs.length ≤ Usize.max then ⟨xs, h⟩ else ⟨[], by simp⟩
+def nats (v : alloc.vec.Vec U32) : List Nat := v.val.map (·.val)
+def gen (n : Nat) : VarGen := { next_tvar := u32 n }
+/-- A `Result<u32, u32>` as the text of its `Debug` form. -/
+def res (r : core.result.Result U32 U32) : String :=
+  match r with | .Ok v => s!"Ok({v.val})" | .Err e => s!"Err({e.val})"
+
+/-- `resolve` on a resolver, a generator and the errors: the result, the generator's next variable
+    and the errors given back. -/
+def resolveOf (holes : Bool) (next : Nat) (errors : List Nat) (nm : Nat) :
+    Option (String × Nat × List Nat) :=
+  match Resolver.resolve { holes } (gen next) (vec errors) (u32 nm) with
+  | ok (r, _, vg, errors) => some (res r, vg.next_tvar.val, nats errors)
+  | _ => none
+
+#guard resolveOf true 5 [1] 0 == some ("Ok(5)", 6, [1])
+#guard resolveOf true 6 [1] 3 == some ("Ok(3)", 6, [1])
+#guard resolveOf false 6 [1] 0 == some ("Err(7)", 6, [1, 7])
+
+def checkOf (ok' : Bool) (errors : List Nat) (code : Nat) : Option (Option Nat × List Nat) :=
+  match check ok' (vec errors) (u32 code) with
+  | ok (r, errors) => some (r.map (·.val), nats errors)
+  | _ => none
+
+#guard checkOf true [4] 9 == some (none, [4])
+#guard checkOf false [4] 9 == some (some 2, [4, 9])
+
+def scopedOf (cyclic : Bool) (next : Nat) (log : List Nat) :
+    Option ((Option Nat × Option Nat) × Nat × List Nat) :=
+  match «scoped» cyclic (gen next) (vec log) with
+  | ok ((a, b), vg, log) => some ((a.map (·.val), b.map (·.val)), vg.next_tvar.val, nats log)
+  | _ => none
+
+#guard scopedOf true 2 [] == some ((some 2, none), 3, [2])
+#guard scopedOf false 3 [2] == some ((none, some 3), 4, [2, 103])
+
+def plainOf (cond : Bool) (x : Nat) : Option (Option Nat) :=
+  match plain cond (u32 x) with
+  | ok r => some (r.map (·.val))
+  | _ => none
+
+#guard plainOf true 1 == some (some 2)
+#guard plainOf false 1 == some none
+
+def twiceOf (next : Nat) : Option ((Option Nat × Option Nat × Option Nat) × Nat) :=
+  match twice (gen next) with
+  | ok ((a, b, c), vg) => some ((a.map (·.val), b.map (·.val), c.map (·.val)), vg.next_tvar.val)
+  | _ => none
+
+#guard twiceOf 1 == some ((some 1, none, some 20), 3)
+
+def overflowOf (cond : Bool) (next : Nat) : Option (Option Nat × Nat) :=
+  match overflow cond (gen next) with
+  | ok (r, vg) => some (r.map (·.val), vg.next_tvar.val)
+  | _ => none
+
+#guard overflowOf false 1 == some (none, 1)
+#guard overflowOf true 0 == some (some 4294967295, 4294967295)
+#guard overflowOf true 1 == none
+
+end bool_then_closure_state.checks
