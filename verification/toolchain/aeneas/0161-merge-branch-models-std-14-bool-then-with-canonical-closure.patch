diff --git a/tests/src/option-get-or-insert.rs b/tests/src/option-get-or-insert.rs
new file mode 100644
index 0000000..a787f99
--- /dev/null
+++ b/tests/src/option-get-or-insert.rs
@@ -0,0 +1,109 @@
+//@ [!lean] skip
+//@ [lean] subdir=OptionGetOrInsert
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::option::{core::option::Option}
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! `Option::get_or_insert` as chelis-types (`infer/common.rs`, a fallback kept from the first
+//! candidate of a loop) and chelis-ir (`lower/static_controls.rs`, the first reason recorded in a
+//! field of `&mut self`; `ownership/verify.rs`, a field of each element of a mutable slice) use it:
+//! it stores the value when the option is `None` (the value is dropped otherwise) and lends the
+//! contained value, whose writes the option keeps. OptionGetOrInsert/Checks.lean compares the
+//! model with the native results asserted in the native test module, including the options
+//! given back.
+
+#[derive(Clone, Copy, PartialEq, Debug)]
+pub enum Reason {
+    Recursive,
+    HigherOrder,
+    Runtime(u32),
+}
+
+pub struct Visitor {
+    pub reason: Option<Reason>,
+    pub visits: u32,
+}
+
+impl Visitor {
+    /// static_controls.rs: only the first reason is kept.
+    pub fn note(&mut self, reason: Reason) {
+        self.visits += 1;
+        self.reason.get_or_insert(reason);
+    }
+}
+
+pub fn visit_all(reasons: &[Reason]) -> (Option<Reason>, u32) {
+    let mut v = Visitor { reason: None, visits: 0 };
+    for r in reasons {
+        v.note(*r);
+    }
+    (v.reason, v.visits)
+}
+
+/// common.rs: the first candidate is the fallback when no candidate matches.
+pub fn first_or_match<'a>(names: &[&'a str], want: &str) -> Option<&'a str> {
+    let mut fallback = None;
+    for name in names {
+        fallback.get_or_insert(*name);
+        if *name == want {
+            return Some(*name);
+        }
+    }
+    fallback
+}
+
+pub struct Site {
+    pub seed_parent: Option<usize>,
+}
+
+/// verify.rs: the parent is set on the sites which have none.
+pub fn seed(sites: &mut [Site], start: usize) {
+    for child in sites.iter_mut() {
+        child.seed_parent.get_or_insert(start);
+    }
+}
+
+/// A write through the returned reference, then a read of the option.
+pub fn bump(slot: &mut Option<u32>, value: u32) -> u32 {
+    let r = slot.get_or_insert(value);
+    *r += 1;
+    *r
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn keeps_first_reason() {
+        assert_eq!(visit_all(&[]), (None, 0));
+        assert_eq!(
+            visit_all(&[Reason::HigherOrder, Reason::Recursive, Reason::Runtime(3)]),
+            (Some(Reason::HigherOrder), 3)
+        );
+        assert_eq!(visit_all(&[Reason::Runtime(4), Reason::Recursive]), (Some(Reason::Runtime(4)), 2));
+    }
+
+    #[test]
+    fn fallback() {
+        assert_eq!(first_or_match(&["a", "b", "c"], "b"), Some("b"));
+        assert_eq!(first_or_match(&["a", "b", "c"], "z"), Some("a"));
+        assert_eq!(first_or_match(&[], "z"), None);
+    }
+
+    #[test]
+    fn seeds() {
+        let mut sites = [Site { seed_parent: Some(1) }, Site { seed_parent: None }, Site { seed_parent: None }];
+        seed(&mut sites, 7);
+        assert_eq!(sites.iter().map(|s| s.seed_parent).collect::<Vec<_>>(), vec![Some(1), Some(7), Some(7)]);
+    }
+
+    #[test]
+    fn bumps() {
+        let mut slot = None;
+        assert_eq!(bump(&mut slot, 5), 6);
+        assert_eq!(slot, Some(6));
+        assert_eq!(bump(&mut slot, 50), 7);
+        assert_eq!(slot, Some(7));
+        let mut full = Some(u32::MAX);
+        assert!(std::panic::catch_unwind(move || bump(&mut full, 0)).is_err());
+    }
+}
