+/-! ### `IgnoredAny` (de/ignored_any.rs)
+
+`IgnoredAny` is a unit struct (its Lean type is `Unit`). `impl Visitor for IgnoredAny` accepts every
+value and drops it: the scalars, `visit_none` and `visit_unit` are `Ok(IgnoredAny)`,
+`visit_some` and `visit_newtype_struct` are `IgnoredAny::deserialize(deserializer)`, `visit_seq`
+reads the elements as `IgnoredAny` until the end, `visit_map` the entries, `visit_enum` the variant
+then its content as a newtype variant, each stopping at the first error. `impl Deserialize for
+IgnoredAny` is `deserializer.deserialize_ignored_any(IgnoredAny)`. The visitor deserializes nested
+values with itself, so its dictionaries are built level by level of the knot (`DeAt`): the visitor
+at level `n + 1` reads nested values with the dictionaries at level `n`, as `Visitor.wrap` projects
+a visitor of `Ω` (`proj n`). -/
+
+/-- `while let Some(IgnoredAny) = tri!(seq.next_element()) {}` then `Ok(IgnoredAny)`. -/
+def ignoredElements {X : serde_core.de.Fam} {A Error : Type}
+    (seq : serde_core.de.SeqAccessF X A Error) (d : X.Deserialize Unit) (access : A) :
+    Result (core.result.Result Unit Error) := do
+  let (r, access) ← seq.next_element d access
+  match r with
+  | .Err e => ok (.Err e)
+  | .Ok none => ok (.Ok ())
+  | .Ok (some ()) => ignoredElements seq d access
+partial_fixpoint
+
+/-- `while let Some((IgnoredAny, IgnoredAny)) = tri!(map.next_entry()) {}` then `Ok(IgnoredAny)`. -/
+def ignoredEntries {X : serde_core.de.Fam} {A Error : Type}
+    (map : serde_core.de.MapAccessF X A Error) (d : X.Deserialize Unit) (access : A) :
+    Result (core.result.Result Unit Error) := do
+  let (r, access) ← map.next_entry d d access
+  match r with
+  | .Err e => ok (.Err e)
+  | .Ok none => ok (.Ok ())
+  | .Ok (some ((), ())) => ignoredEntries map d access
+partial_fixpoint
+
+/-- `impl Visitor for IgnoredAny` one level above the dictionaries `d` (its `Deserialize`) and
+    `v` (its `Visitor`) of the knot family `X`. -/
+def ignoredAnyVisitorStep {X : serde_core.de.Fam} (d : X.Deserialize Unit)
+    (v : X.Visitor Unit Unit) : serde_core.de.VisitorStep X Unit Unit :=
+  { expecting := fun _ f => f.append "anything at all"
+    visit_bool := fun _ _ _ => ok (.Ok ())
+    visit_i64 := fun _ _ _ => ok (.Ok ())
+    visit_i128 := fun _ _ _ => ok (.Ok ())
+    visit_u64 := fun _ _ _ => ok (.Ok ())
+    visit_u128 := fun _ _ _ => ok (.Ok ())
+    visit_f64 := fun _ _ _ => ok (.Ok ())
+    visit_str := fun _ _ _ => ok (.Ok ())
+    visit_none := fun _ _ => ok (.Ok ())
+    visit_some := fun inst _ deserializer => inst.deserialize_ignored_any v deserializer ()
+    visit_newtype_struct := fun inst _ deserializer =>
+      inst.deserialize_ignored_any v deserializer ()
+    visit_unit := fun _ _ => ok (.Ok ())
+    visit_seq := fun seq _ access => ignoredElements seq d access
+    visit_map := fun map _ access => ignoredEntries map d access
+    visit_bytes := fun _ _ _ => ok (.Ok ())
+    visit_enum := fun data _ access => do
+      match ← data.variant d access with
+      | .Err e => ok (.Err e)
+      | .Ok ((), variant) => data.VariantAccessInst.newtype_variant d variant }
+
+/-- The dictionaries of `IgnoredAny` at level `n` of the knot: `impl Deserialize` and
+    `impl Visitor`. -/
+def ignoredAnyAt : (n : Nat) →
+    (serde_core.de.DeAt n).Deserialize Unit × (serde_core.de.DeAt n).Visitor Unit Unit
+  | 0 => (PUnit.unit, PUnit.unit)
+  | n + 1 =>
+    let below := ignoredAnyAt n
+    (⟨fun inst deserializer => inst.deserialize_ignored_any below.2 deserializer ()⟩,
+      ignoredAnyVisitorStep below.1 below.2)
+
+/-- `IgnoredAny` as the visitor of the Rust traits (`Ω`). -/
+def IgnoredAnyVisitor : serde_core.de.VisitorΩ Unit Unit := ⟨fun n => (ignoredAnyAt n).2⟩
+
+/-- `impl<'de> Deserialize<'de> for IgnoredAny`: `deserializer.deserialize_ignored_any(IgnoredAny)`. -/
+@[rust_fun
+  "serde_core::de::ignored_any::{serde_core::de::Deserialize<'de, serde_core::de::ignored_any::IgnoredAny>}::deserialize"]
+def DeserializeIgnoredAny.deserialize {D Error : Type} (inst : serde_core.de.Deserializer D Error)
+    (deserializer : D) : Result (core.result.Result Unit Error) :=
+  inst.deserialize_ignored_any IgnoredAnyVisitor deserializer ()
+
+@[reducible, rust_trait_impl
+  "serde_core::de::Deserialize<'de, serde_core::de::ignored_any::IgnoredAny>"]
+def DeserializeIgnoredAny : serde_core.de.Deserialize Unit :=
+  { deserialize := fun inst deserializer => DeserializeIgnoredAny.deserialize inst deserializer }
+
+/-- The knot is the level-wise construction: `Deserialize.wrap DeserializeIgnoredAny` is, at every
+    level, the level's `impl Deserialize for IgnoredAny`. -/
+theorem DeserializeIgnoredAny.wrap_level (n : Nat) :
+    (serde_core.de.Deserialize.wrap DeserializeIgnoredAny).level n = (ignoredAnyAt n).1 := by
+  cases n <;> rfl
+
 end serde_core.de.impls
 
 end Aeneas.Std
