+//! `serde::de::IgnoredAny` through the library model of `serde_core` (`Aeneas/Std/Serde`): the
+//! value `#[derive(Deserialize)]` without `deny_unknown_fields` reads the value of an unknown field
+//! as (chelis-deep's derived impls), and `IgnoredAny::deserialize` itself. `IgnoredAny` accepts any
+//! value: it deserializes the inner value of an option or a newtype, the elements of a sequence
+//! and the entries of a map again as `IgnoredAny`, until their end or the first error.
+//!
+//! `Tagged` has the hand-written form of `#[derive(Deserialize)]` (serde_derive 1.0.228, the
+//! `visit_map` arm): an unknown field name is `__Field::__ignore`, whose value goes through
+//! `MapAccess::next_value::<IgnoredAny>`.
+//!
+//! `SerdeIgnoredAny/Checks.lean` runs these implementations against the in-test format of the
+//! `native` test module (a value tree), encoded as a `FormatProgram`, and compares with the native
+//! results.
+
+use serde::de::{self, Deserialize, Deserializer, IgnoredAny, MapAccess, Visitor};
+use std::fmt;
+
+/// A struct with the hand-written form of `#[derive(Deserialize)]` (unknown fields are skipped).
+pub struct Tagged {
+    pub id: u32,
+}
+
+const TAGGED_FIELDS: &[&str] = &["id"];
+
+enum TaggedField {
+    Id,
+    Ignore,
+}
+
+struct TaggedFieldVisitor;
+
+impl<'de> Visitor<'de> for TaggedFieldVisitor {
+    type Value = TaggedField;
+
+    fn expecting(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        formatter.write_str("field identifier")
+    }
+
+    fn visit_u64<E: de::Error>(self, value: u64) -> Result<TaggedField, E> {
+        match value {
+            0 => Ok(TaggedField::Id),
+            _ => Ok(TaggedField::Ignore),
+        }
+    }
+
+    fn visit_str<E: de::Error>(self, value: &str) -> Result<TaggedField, E> {
+        match value {
+            "id" => Ok(TaggedField::Id),
+            _ => Ok(TaggedField::Ignore),
+        }
+    }
+}
+
+impl<'de> Deserialize<'de> for TaggedField {
+    fn deserialize<D: Deserializer<'de>>(deserializer: D) -> Result<TaggedField, D::Error> {
+        deserializer.deserialize_identifier(TaggedFieldVisitor)
+    }
+}
+
+struct TaggedVisitor;
+
+impl<'de> Visitor<'de> for TaggedVisitor {
+    type Value = Tagged;
+
+    fn expecting(&self, formatter: &mut fmt::Formatter<'_>) -> fmt::Result {
+        formatter.write_str("struct Tagged")
+    }
+
+    fn visit_map<A: MapAccess<'de>>(self, mut map: A) -> Result<Tagged, A::Error> {
+        let mut id: Option<u32> = None;
+        while let Some(key) = map.next_key::<TaggedField>()? {
+            match key {
+                TaggedField::Id => {
+                    if id.is_some() {
+                        return Err(de::Error::duplicate_field("id"));
+                    }
+                    id = Some(map.next_value::<u32>()?);
+                }
+                TaggedField::Ignore => {
+                    let _ = map.next_value::<IgnoredAny>()?;
+                }
+            }
+        }
+        let id = match id {
+            Some(id) => id,
+            None => serde::__private228::de::missing_field("id")?,
+        };
+        Ok(Tagged { id })
+    }
+}
+
+impl<'de> Deserialize<'de> for Tagged {
+    fn deserialize<D: Deserializer<'de>>(deserializer: D) -> Result<Tagged, D::Error> {
+        deserializer.deserialize_struct("Tagged", TAGGED_FIELDS, TaggedVisitor)
+    }
+}
+
+/// `IgnoredAny::deserialize`, then a constant: the value is consumed and dropped.
+pub fn skip<'de, D: Deserializer<'de>>(deserializer: D) -> Result<u32, D::Error> {
+    let IgnoredAny = IgnoredAny::deserialize(deserializer)?;
+    Ok(1)
+}
+
+#[cfg(test)]
+mod native {
+    //! The in-test format: an owned value tree, as serde's value deserializers.
+    use super::*;
+    use serde::de::{DeserializeSeed, SeqAccess};
+
+    #[derive(Clone, Debug, PartialEq)]
+    pub enum Value {
+        U32(u32),
+        Str(String),
+        Bool(bool),
+        Unit,
+        Opt(Option<Box<Value>>),
+        Newtype(Box<Value>),
+        Seq(Vec<Value>),
+        Map(Vec<(Value, Value)>),
+        Struct(&'static str, Vec<(&'static str, Value)>),
+        /// A value no visitor accepts: the format reports an error.
+        Bad,
+    }
+    use Value::*;
+
+    #[derive(Debug, PartialEq)]
+    pub struct TestError(pub String);
+
+    impl fmt::Display for TestError {
+        fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+            f.write_str(&self.0)
+        }
+    }
+
+    impl std::error::Error for TestError {}
+
+    impl de::Error for TestError {
+        fn custom<T: fmt::Display>(msg: T) -> Self {
+            TestError(msg.to_string())
+        }
+    }
+
+    pub struct ValueDe(pub Value);
+    pub struct SeqDe(std::vec::IntoIter<Value>);
+    pub struct MapDe {
+        entries: std::vec::IntoIter<(Value, Value)>,
+        value: Option<Value>,
+    }
+
+    impl<'de> Deserializer<'de> for ValueDe {
+        type Error = TestError;
+
+        fn deserialize_any<V: Visitor<'de>>(self, visitor: V) -> Result<V::Value, TestError> {
+            match self.0 {
+                U32(v) => visitor.visit_u32(v),
+                Str(s) => visitor.visit_str(&s),
+                Bool(b) => visitor.visit_bool(b),
+                Unit => visitor.visit_unit(),
+                Opt(None) => visitor.visit_none(),
+                Opt(Some(v)) => visitor.visit_some(ValueDe(*v)),
+                Newtype(v) => visitor.visit_newtype_struct(ValueDe(*v)),
+                Seq(items) => visitor.visit_seq(SeqDe(items.into_iter())),
+                Map(entries) => visitor.visit_map(MapDe { entries: entries.into_iter(), value: None }),
+                Struct(_, fields) => {
+                    let entries: Vec<(Value, Value)> =
+                        fields.into_iter().map(|(k, v)| (Str(k.to_string()), v)).collect();
+                    visitor.visit_map(MapDe { entries: entries.into_iter(), value: None })
+                }
+                Bad => Err(TestError("bad value".to_string())),
+            }
+        }
+
+        serde::forward_to_deserialize_any! {
+            bool i8 i16 i32 i64 i128 u8 u16 u32 u64 u128 f32 f64 char str string
+            bytes byte_buf option unit unit_struct newtype_struct seq tuple
+            tuple_struct map struct enum identifier ignored_any
+        }
+    }
+
+    impl<'de> SeqAccess<'de> for SeqDe {
+        type Error = TestError;
+        fn next_element_seed<T: DeserializeSeed<'de>>(
+            &mut self, seed: T,
+        ) -> Result<Option<T::Value>, TestError> {
+            match self.0.next() {
+                Some(v) => seed.deserialize(ValueDe(v)).map(Some),
+                None => Ok(None),
+            }
+        }
+    }
+
+    impl<'de> MapAccess<'de> for MapDe {
+        type Error = TestError;
+        fn next_key_seed<K: DeserializeSeed<'de>>(
+            &mut self, seed: K,
+        ) -> Result<Option<K::Value>, TestError> {
+            match self.entries.next() {
+                Some((k, v)) => {
+                    self.value = Some(v);
+                    seed.deserialize(ValueDe(k)).map(Some)
+                }
+                None => Ok(None),
+            }
+        }
+        fn next_value_seed<V: DeserializeSeed<'de>>(
+            &mut self, seed: V,
+        ) -> Result<V::Value, TestError> {
+            match self.value.take() {
+                Some(v) => seed.deserialize(ValueDe(v)),
+                None => Err(TestError("value missing".to_string())),
+            }
+        }
+    }
+
+    fn de_tagged(v: Value) -> Result<u32, TestError> {
+        Tagged::deserialize(ValueDe(v)).map(|t| t.id)
+    }
+
+    fn de_skip(v: Value) -> Result<u32, TestError> {
+        skip(ValueDe(v))
+    }
+
+    fn err(msg: &str) -> TestError {
+        TestError(msg.to_string())
+    }
+
+    fn nested() -> Value {
+        Map(vec![
+            (U32(1), Seq(vec![U32(2), Str("b".to_string()), Opt(Some(Box::new(Unit)))])),
+            (Str("k".to_string()), Newtype(Box::new(Seq(vec![Seq(vec![]), Map(vec![])])))),
+        ])
+    }
+
+    #[test]
+    fn skips_every_shape() {
+        for v in [
+            U32(3),
+            Str("x".to_string()),
+            Bool(true),
+            Unit,
+            Opt(None),
+            Opt(Some(Box::new(U32(4)))),
+            Newtype(Box::new(Str("y".to_string()))),
+            Seq(vec![]),
+            Seq(vec![U32(1), Bool(false)]),
+            Map(vec![]),
+            nested(),
+            Struct("S", vec![("a", U32(1)), ("b", nested())]),
+        ] {
+            assert_eq!(de_skip(v), Ok(1));
+        }
+    }
+
+    #[test]
+    fn skip_errors() {
+        assert_eq!(de_skip(Bad), Err(err("bad value")));
+        assert_eq!(de_skip(Seq(vec![U32(1), Bad, U32(2)])), Err(err("bad value")));
+        assert_eq!(de_skip(Map(vec![(U32(1), U32(2)), (Str("k".to_string()), Bad)])), Err(err("bad value")));
+        assert_eq!(de_skip(Map(vec![(Bad, U32(2))])), Err(err("bad value")));
+        assert_eq!(de_skip(Opt(Some(Box::new(Seq(vec![Bad]))))), Err(err("bad value")));
+        assert_eq!(de_skip(Newtype(Box::new(Bad))), Err(err("bad value")));
+    }
+
+    #[test]
+    fn unknown_fields_are_skipped() {
+        assert_eq!(de_tagged(Struct("Tagged", vec![("id", U32(3))])), Ok(3));
+        assert_eq!(
+            de_tagged(Struct("Tagged", vec![
+                ("x", Str("a".to_string())),
+                ("id", U32(3)),
+                ("nested", nested()),
+                ("flag", Bool(true)),
+                ("none", Opt(None)),
+            ])),
+            Ok(3)
+        );
+        assert_eq!(de_tagged(Map(vec![(U32(0), U32(9)), (U32(5), Unit)])), Ok(9));
+        assert_eq!(de_tagged(Struct("Tagged", vec![("x", U32(1))])), Err(err("missing field `id`")));
+        assert_eq!(
+            de_tagged(Struct("Tagged", vec![("id", U32(3)), ("x", Seq(vec![Bad]))])),
+            Err(err("bad value"))
+        );
+        assert_eq!(
+            de_tagged(Struct("Tagged", vec![("id", U32(3)), ("id", U32(4))])),
+            Err(err("duplicate field `id`"))
+        );
+    }
+}
