+import SerdeIgnoredAny.SerdeIgnoredAny
+
+/-! Run the extracted data-side implementations of `tests/src/serde-ignored-any` (`Tagged`, whose
+    unknown fields are read as `IgnoredAny`, and `skip`) with the model of `IgnoredAny` against the
+    in-test format of its `native` test module (a value tree, with `ValueDe`/`SeqDe`/`MapDe`),
+    encoded as a `FormatProgram`, and compare with the native results. -/
+
+namespace serde_ignored_any.checks
+open Aeneas Aeneas.Std Result
+
+/-- `native::Value` -/
+inductive TValue where
+  | u32 (n : Nat)
+  | str (s : String)
+  | bool (b : Bool)
+  | unit
+  | opt (v : Option TValue)
+  | newtype (v : TValue)
+  | seq (xs : List TValue)
+  | map (kvs : List (TValue × TValue))
+  | struct_ (typeName : String) (fields : List (String × TValue))
+  | bad
+deriving Inhabited
+
+/-! ## `native::TestError(String)` -/
+
+/-- `impl Display for TestError`: `f.write_str(&self.0)`. -/
+def errDisplay : core.fmt.Display String := ⟨fun s f => f.append s⟩
+
+/-- `#[derive(Debug)]`: `TestError("..")`. -/
+def errDebug : core.fmt.Debug String :=
+  ⟨fun s f => f.debugTuple "TestError" [⟨String, core.fmt.DebugString, s⟩]⟩
+
+/-- `ToString::to_string` (a `Display` returning an error panics). -/
+def toString' {T : Type} (d : core.fmt.Display T) (x : T) : Result String := do
+  let (status, f) ← d.fmt x {}
+  match status with
+  | .Ok () => ok f.output
+  | .Err _ => fail .panic
+
+/-- `impl de::Error for TestError`: `TestError(msg.to_string())`. -/
+def deErr : serde_core.de.Error String :=
+  { coreerrorErrorInst := ⟨errDebug, errDisplay⟩, custom := fun d msg => toString' d msg }
+
+/-! ## `ValueDe`, `SeqDe`, `MapDe`, as a format program -/
+
+open serde_core.de in
+def deTypes : FormatTypes where
+  ιD := Unit
+  D := fun _ => TValue
+  DError := fun _ => String
+  ιS := Unit
+  S := fun _ => List TValue
+  SError := fun _ => String
+  ιM := Unit
+  M := fun _ => List (TValue × TValue) × Option TValue
+  MError := fun _ => String
+  ιE := Empty
+  E := fun _ => Unit
+  EError := fun _ => String
+  EVariant := fun _ => Unit
+  ιV := Empty
+  V := fun _ => Unit
+  VError := fun _ => String
+
+def u32OfNat (n : Nat) : U32 := ⟨BitVec.ofNat _ n⟩
+
+open serde_core.de in
+/-- `ValueDe::deserialize_any`. -/
+def deserializeAny {X : Fam} (sub : deTypes.Dicts X) {V Value : Type} (vis : VisitorStep X V Value)
+    (d : TValue) (v : V) : Result (core.result.Result Value String) :=
+  match d with
+  | .u32 n => vis.visit_u32 deErr v (u32OfNat n)
+  | .str s => do
+    let s ← Str.ofString s
+    vis.visit_str deErr v s
+  | .bool b => vis.visit_bool deErr v b
+  | .unit => vis.visit_unit deErr v
+  | .opt none => vis.visit_none deErr v
