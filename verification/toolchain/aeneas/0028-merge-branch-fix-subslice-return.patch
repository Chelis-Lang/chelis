+/// Two rests and a promoted `&[]` shared by several branches (Charon
+/// duplicates the promoted body in each of them), as in
+/// `chelis_effects::children`.
+pub fn children(elements: &[Expr]) -> &[Expr] {
+    match elements {
+        [Expr::Atom(Atom::Tag(_), _), Expr::Map(_, _), children @ ..] => children,
+        [Expr::Atom(Atom::Tag(_), _), children @ ..] => children,
+        _ => &[],
+    }
+}
+
