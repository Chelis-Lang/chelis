+    borrows of the region group [gid].
+
+    In a region abstraction, a mutable borrow whose region does not belong to
+    the abstraction ("ignored" borrow) is tracked at two levels: the borrowed
+    value stays at the current level, while the value given back when the
+    borrow ends is one level deeper (and has the opposite polarity: a loan
+    becomes a borrow and conversely). An ADT is translated as a whole, as one
+    value at every level at which its fields contain mutable borrows of the
+    region group, which we compute by exploring its (instantiated) fields.
+
+    Levels are relative to the level of the value of type [ty]. *)
+and back_ty_levels (span : Meta.span option) (decls_ctx : C.decls_ctx)
+    (get_region_group : T.region -> T.region_group_id) (gid : T.region_group_id)
+    (ty : T.ty) : Collections.IntSet.t =
+  let module S = Collections.IntSet in
+  let type_infos = decls_ctx.type_ctx.type_infos in
+  let keep_region (r : T.region) =
+    match r with
+    | T.RVar (Free _) -> get_region_group r = gid
+    | _ -> false
+  in
+  let has_mut ty =
+    TypesUtils.ty_has_mut_borrow_for_region_in_pred type_infos keep_region ty
+  in
+  let union_map f l = List.fold_left (fun s x -> S.union s (f x)) S.empty l in
+  let rec levels (visited : T.ty list) (ty : T.ty) : S.t =
+    if not (has_mut ty) then S.empty
+    else
+      match ty with
+      | T.TRef (r, rty, RMut) ->
+          if keep_region r then S.singleton 0
+          else
+            let inner = levels visited rty in
+            S.union inner (S.map (fun l -> l + 1) inner)
+      | T.TRef (_, _, RShared) -> S.empty
+      | T.TAdt { id = TTuple | TBuiltin _; generics } ->
+          union_map (levels visited) generics.types
+      | T.TAdt { id = TAdtId adt_id; generics } ->
+          if List.mem ty visited then S.empty
+          else
+            let fields =
+              match
+                T.TypeDeclId.Map.find_opt adt_id decls_ctx.type_ctx.type_decls
