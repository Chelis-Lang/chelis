+//@ [!lean] skip
+//@ [lean] subdir=ClosureSharedContext
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::iter::adapters::map::Map
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Three levels of nested borrows whose innermost region is only used by
+//! shared borrows: a context which owns its state and borrows shared program
+//! facts, accessed through a mutable borrow which is itself mutably borrowed
+//! (`&'b mut W<'a, 'p>`), and a closure capturing `&mut self` of such a
+//! context (the closure's `call_mut` receives `&mut Closure<'1, 'p>`).
+//! `ClosureSharedContext/Checks.lean` evaluates the model on the inputs of the
+//! `native` test module below and compares with the native results.
+
+pub struct Runtime {
+    pub raised: u32,
+}
+
+pub struct Ctx<'p> {
+    pub facts: &'p [u32],
+    pub runtime: Runtime,
+    pub out: Vec<u32>,
+}
+
+impl<'p> Ctx<'p> {
+    fn step(&mut self, x: u32) -> u32 {
+        self.runtime.raised = self.runtime.raised.wrapping_add(1);
+        x.wrapping_add(self.runtime.raised)
+            .wrapping_add(self.facts.len() as u32)
+    }
+
+    pub fn run(&mut self, xs: &[u32]) -> Vec<u32> {
+        xs.iter().map(|x| self.step(*x)).collect()
+    }
+}
+
+pub fn drive(facts: &[u32], runtime: Runtime, xs: &[u32]) -> (Vec<u32>, Runtime) {
+    let mut ctx = Ctx { facts, runtime, out: Vec::new() };
+    let result = ctx.run(xs);
+    (result, ctx.runtime)
+}
+
+pub struct W<'a, 'p> {
+    pub c: &'a mut Ctx<'p>,
+}
+
+pub fn step_through<'b, 'a, 'p>(w: &'b mut W<'a, 'p>, x: u32) -> u32 {
+    w.c.step(x)
+}
+
+pub fn drive_through(facts: &[u32], x: u32) -> (u32, u32) {
+    let mut c = Ctx { facts, runtime: Runtime { raised: 0 }, out: Vec::new() };
+    let r = {
+        let mut w = W { c: &mut c };
+        let a = step_through(&mut w, x);
+        step_through(&mut w, a)
+    };
+    (r, c.runtime.raised)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn drive_closure() {
+        for (facts, raised, xs, out, raised_after) in [
+            (&[1u32, 2, 3][..], 0u32, &[10u32, 20, 30][..], &[14u32, 25, 36][..], 3u32),
+            (&[], 5, &[7], &[13], 6),
+            (&[9], u32::MAX, &[0, 1], &[1, 3], 1),
+            (&[4, 4], 3, &[], &[], 3),
+        ] {
+            let (v, rt) = drive(facts, Runtime { raised }, xs);
+            assert_eq!((v.as_slice(), rt.raised), (out, raised_after));
+        }
+    }
+
+    #[test]
+    fn drive_nested() {
+        for (facts, x, r, raised) in [
+            (&[1u32, 2, 3][..], 5u32, 14u32, 2u32),
+            (&[], 0, 3, 2),
+            (&[1], u32::MAX, 4, 2),
+        ] {
+            assert_eq!(drive_through(facts, x), (r, raised));
+        }
+    }
+}
