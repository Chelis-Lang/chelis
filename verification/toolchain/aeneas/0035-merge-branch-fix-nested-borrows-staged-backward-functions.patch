+import ClosureMutContext.ClosureMutContext
+
+/-! Evaluate the model of `tests/src/closure-mut-context.rs` on the inputs of
+    its `native` test module and compare with the native results. -/
+
+namespace closure_mut_context.checks
+open Aeneas Aeneas.Std Result
+
+def u (x : Nat) : U32 := ⟨BitVec.ofNat _ x⟩
+
+def sl (xs : List Nat) (h : xs.length ≤ Usize.max := by scalar_tac) : Slice U32 :=
+  ⟨xs.map u, by simpa using h⟩
+
+def nats (v : alloc.vec.Vec U32) : List Nat := v.val.map (·.val)
+
+def val {α} (f : α → β) : Result α → Option β
+  | ok x => some (f x)
+  | _ => none
+
+-- Two consecutive calls through the same outer borrows
+#guard val (·.val) (incr3_twice (u 0)) == some 2
+#guard val (·.val) (incr3_twice (u 41)) == some 43
+#guard val (·.val) (incr3_twice (u 4294967295)) == some 1
+
+-- A closure capturing `&mut self` of a context holding `&'p mut` fields,
+-- through `map`/`collect`
+def runAll (raised polls : Nat) (xs : List Nat)
+    (h : xs.length ≤ Usize.max := by scalar_tac) : Option (List Nat × Nat × Nat) :=
+  val (fun (v, r, p) => (nats v, r.val, p.val)) (drive_all (u raised) (u polls) (sl xs))
+
+#guard runAll 0 0 [1, 2, 3] == some ([4, 5, 6], 6, 3)
+#guard runAll 10 5 [] == some ([], 10, 5)
+#guard runAll 4294967295 4294967295 [2, 4294967295] == some ([5, 2], 0, 1)
+
+-- Two consecutive plain calls of the closure
+def runPair (raised polls a b : Nat) : Option (Nat × Nat × Nat × Nat) :=
+  val (fun (x, y, r, p) => (x.val, y.val, r.val, p.val))
+    (drive_pair (u raised) (u polls) (u a) (u b))
+
+#guard runPair 0 0 1 2 == some (4, 5, 3, 2)
+#guard runPair 10 5 7 9 == some (10, 12, 26, 7)
+#guard runPair 4294967295 4294967295 3 4 == some (6, 7, 6, 1)
+
+-- Both, through a child context reborrowing the fields of its parent
+def runChild (raised polls : Nat) (xs : List Nat) (a : Nat)
+    (h : xs.length ≤ Usize.max := by scalar_tac) :
+    Option (List Nat × Nat × Nat × Nat) :=
+  val (fun (v, x, r, p) => (nats v, x.val, r.val, p.val))
+    (drive_child (u raised) (u polls) (sl xs) (u a))
+
+#guard runChild 0 0 [1, 2] 5 == some ([5, 6], 9, 13, 4)
+#guard runChild 7 1 [] 0 == some ([], 4, 7, 3)
+#guard runChild 4294967295 0 [1] 4294967295 == some ([5], 3, 4294967294, 3)
+
+-- Two consecutive calls through the same wrapper `&'b mut W<'a, 'p>`
+def runThrough (raised x : Nat) : Option (Nat × Nat × Nat) :=
+  val (fun (r, a, p) => (r.val, a.val, p.val)) (drive_through (u raised) (u x))
+
+#guard runThrough 0 5 == some (7, 11, 2)
+#guard runThrough 100 0 == some (2, 101, 2)
+#guard runThrough 4294967295 4294967295 == some (1, 4294967294, 2)
+
+-- The borrow given back through the wrapper is put back into a new wrapper
+def runPutBack (raised x : Nat) : Option (Nat × Nat × Nat) :=
+  val (fun (r, a, p) => (r.val, a.val, p.val)) (drive_put_back (u raised) (u x))
+
+#guard runPutBack 0 5 == some (9, 12, 2)
+#guard runPutBack 100 0 == some (4, 102, 2)
+#guard runPutBack 4294967295 4294967295 == some (3, 4294967295, 2)
+
+end closure_mut_context.checks
