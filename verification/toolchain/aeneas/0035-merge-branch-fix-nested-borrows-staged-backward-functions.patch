+//@ [!lean] skip
+//@ [lean] subdir=ClosureMutContext
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::iter::adapters::map::Map
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Three levels of nested mutable borrows (staged backward functions): a
+//! region group nested under two ignored mutable borrows, e.g. `'c` in
+//! `&'a mut &'b mut &'c mut u32`, or `'p` in `&'b mut W<'a, 'p>` where
+//! `W<'a, 'p>` holds `&'a mut LowerCtx<'p>` and `LowerCtx<'p>` holds
+//! `&'p mut` fields, or in the `call_mut(&'4 mut Closure<'1, 'p>)` of a closure
+//! capturing `&mut self` of such a context. The callers need the values given
+//! back at the deepest level before they can give back the values of the
+//! intermediate level.
+//! `ClosureMutContext/Checks.lean` evaluates the model on the inputs of the
+//! `native` test module below and compares with the native results.
+
+pub fn incr3<'a, 'b, 'c>(x: &'a mut &'b mut &'c mut u32) {
+    ***x = (***x).wrapping_add(1);
+}
+
+/// Two consecutive calls through the same outer borrows.
+pub fn incr3_twice(v: u32) -> u32 {
+    let mut x = v;
+    let mut px = &mut x;
+    let mut ppx = &mut px;
+    incr3(&mut ppx);
+    incr3(&mut ppx);
+    x
+}
+
+pub struct Runtime {
+    pub raised: u32,
+}
+
+pub struct Native {
+    pub polls: u32,
+}
+
+/// The shape of the production lowering context: mutable borrows of state
+/// owned by the caller.
+pub struct LowerCtx<'p> {
+    pub runtime: &'p mut Runtime,
+    pub native: &'p mut Native,
+    pub depth: u32,
+}
+
+impl<'p> LowerCtx<'p> {
+    fn step(&mut self, x: u32) -> u32 {
+        self.runtime.raised = self.runtime.raised.wrapping_add(x);
+        self.native.polls = self.native.polls.wrapping_add(1);
+        x.wrapping_add(self.depth)
+    }
+
+    /// A child context reborrowing the fields of its parent.
+    fn child(&mut self) -> LowerCtx<'_> {
+        LowerCtx {
+            runtime: &mut *self.runtime,
+            native: &mut *self.native,
+            depth: self.depth.wrapping_add(1),
+        }
+    }
+
+    /// A closure capturing `&mut self`, through `map`/`collect`.
+    pub fn lower_all(&mut self, xs: &[u32]) -> Vec<u32> {
+        xs.iter().map(|x| self.step(*x)).collect()
+    }
+
+    /// Two consecutive plain calls of a closure capturing `&mut self`.
+    pub fn lower_pair(&mut self, a: u32, b: u32) -> (u32, u32) {
+        let mut f = |x: u32| self.step(x);
+        let ra = f(a);
+        let rb = f(b);
+        (ra, rb)
+    }
+
+    /// Both, through a child context.
+    pub fn lower_child(&mut self, xs: &[u32], a: u32) -> (Vec<u32>, u32) {
+        let mut c = self.child();
+        let v = c.lower_all(xs);
+        let (r, _) = c.lower_pair(a, a);
+        (v, r)
+    }
+}
+
+pub fn drive_all(raised: u32, polls: u32, xs: &[u32]) -> (Vec<u32>, u32, u32) {
+    let mut rt = Runtime { raised };
+    let mut nv = Native { polls };
+    let v = {
+        let mut cx = LowerCtx { runtime: &mut rt, native: &mut nv, depth: 3 };
+        cx.lower_all(xs)
+    };
+    (v, rt.raised, nv.polls)
+}
+
+pub fn drive_pair(raised: u32, polls: u32, a: u32, b: u32) -> (u32, u32, u32, u32) {
+    let mut rt = Runtime { raised };
+    let mut nv = Native { polls };
+    let (ra, rb) = {
+        let mut cx = LowerCtx { runtime: &mut rt, native: &mut nv, depth: 3 };
+        cx.lower_pair(a, b)
+    };
+    (ra, rb, rt.raised, nv.polls)
+}
+
+pub fn drive_child(raised: u32, polls: u32, xs: &[u32], a: u32) -> (Vec<u32>, u32, u32, u32) {
+    let mut rt = Runtime { raised };
+    let mut nv = Native { polls };
+    let (v, r) = {
+        let mut cx = LowerCtx { runtime: &mut rt, native: &mut nv, depth: 3 };
+        cx.lower_child(xs, a)
+    };
+    (v, r, rt.raised, nv.polls)
+}
+
+pub struct W<'a, 'p> {
+    pub c: &'a mut LowerCtx<'p>,
+}
+
+pub fn step_through<'b, 'a, 'p>(w: &'b mut W<'a, 'p>, x: u32) -> u32 {
+    w.c.step(x)
+}
+
+/// Two consecutive calls through the same wrapper.
+pub fn drive_through(raised: u32, x: u32) -> (u32, u32, u32) {
+    let mut rt = Runtime { raised };
+    let mut nv = Native { polls: 0 };
+    let r = {
+        let mut cx = LowerCtx { runtime: &mut rt, native: &mut nv, depth: 1 };
+        let mut w = W { c: &mut cx };
+        let a = step_through(&mut w, x);
+        step_through(&mut w, a)
+    };
+    (r, rt.raised, nv.polls)
+}
+
+/// The borrow given back through the wrapper after a call is put back into a
+/// new wrapper for the next call.
+pub fn drive_put_back(raised: u32, x: u32) -> (u32, u32, u32) {
+    let mut rt = Runtime { raised };
+    let mut nv = Native { polls: 0 };
+    let r = {
+        let mut cx = LowerCtx { runtime: &mut rt, native: &mut nv, depth: 2 };
+        let mut w = W { c: &mut cx };
+        let a = step_through(&mut w, x);
+        let W { c } = w;
+        let mut w2 = W { c };
+        step_through(&mut w2, a)
+    };
+    (r, rt.raised, nv.polls)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn incr3_twice_native() {
+        for (v, r) in [(0u32, 2u32), (41, 43), (u32::MAX, 1)] {
+            assert_eq!(incr3_twice(v), r);
+        }
+    }
+
+    #[test]
+    fn drive_all_native() {
+        for (raised, polls, xs, out, raised_after, polls_after) in [
+            (0u32, 0u32, &[1u32, 2, 3][..], &[4u32, 5, 6][..], 6u32, 3u32),
+            (10, 5, &[], &[], 10, 5),
+            (u32::MAX, u32::MAX, &[2, 4294967295], &[5, 2], 0, 1),
+        ] {
+            let (v, r, p) = drive_all(raised, polls, xs);
+            assert_eq!((v.as_slice(), r, p), (out, raised_after, polls_after));
+        }
+    }
+
+    #[test]
+    fn drive_pair_native() {
+        for (raised, polls, a, b, out) in [
+            (0u32, 0u32, 1u32, 2u32, (4u32, 5u32, 3u32, 2u32)),
+            (10, 5, 7, 9, (10, 12, 26, 7)),
+            (u32::MAX, u32::MAX, 3, 4, (6, 7, 6, 1)),
+        ] {
+            assert_eq!(drive_pair(raised, polls, a, b), out);
+        }
+    }
+
+    #[test]
+    fn drive_child_native() {
+        for (raised, polls, xs, a, out, r, raised_after, polls_after) in [
+            (0u32, 0u32, &[1u32, 2][..], 5u32, &[5u32, 6][..], 9u32, 13u32, 4u32),
+            (7, 1, &[], 0, &[], 4, 7, 3),
+            (u32::MAX, 0, &[1], 4294967295, &[5], 3, 4294967294, 3),
+        ] {
+            let (v, rr, ra, pa) = drive_child(raised, polls, xs, a);
+            assert_eq!((v.as_slice(), rr, ra, pa), (out, r, raised_after, polls_after));
+        }
+    }
+
+    #[test]
+    fn drive_through_native() {
+        for (raised, x, out) in [
+            (0u32, 5u32, (7u32, 11u32, 2u32)),
+            (100, 0, (2, 101, 2)),
+            (u32::MAX, u32::MAX, (1, 4294967294, 2)),
+        ] {
+            assert_eq!(drive_through(raised, x), out);
+        }
+    }
+
+    #[test]
+    fn drive_put_back_native() {
+        for (raised, x, out) in [
+            (0u32, 5u32, (9u32, 12u32, 2u32)),
+            (100, 0, (4, 102, 2)),
+            (u32::MAX, u32::MAX, (3, 4294967295, 2)),
+        ] {
+            assert_eq!(drive_put_back(raised, x), out);
+        }
+    }
+}
