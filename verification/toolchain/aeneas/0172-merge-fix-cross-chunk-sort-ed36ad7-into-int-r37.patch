+++ b/tests/separate-compilation/sort.sh
@@ -0,0 +1,285 @@
+#!/usr/bin/env bash
+# Derived orders across chunks (SortContracts, the sort_order evidence of
+# SeparateCompilation).
+#
+# Usage: sort.sh <charon> <aeneas> [<work directory>]
+# AENEAS_LEAN selects the built Aeneas Lean library (default: backends/lean of
+# this tree). The Lean checks need lake and git on PATH.
+#
+# The owner chunk emits Source, Canon, Parity and Holder with their Ord,
+# PartialOrd, PartialEq and Eq impls. It records derived-order evidence for the
+# derived impls in its manifest. The consumer chunk keeps these impls opaque,
+# as a later chunk of a workspace does.
+#
+# The consumer sorts Pred values. Pred derives its order from Canon, whose Ord
+# impl is in the LLBC of the consumer, and Canon from Source, whose Ord impl is
+# not. This is the shape of chelis_ir capacity_key.rs (ValidityDomain::new).
+# The consumer also compares two Source values, so that the PartialOrd impl of
+# Source is in its LLBC.
+#
+# - The native results equal the Lean results of the consumer (#guard), and a
+#   flipped guard fails.
+# - A Holder holds a Parity, whose order is hand-written. The owner records no
+#   evidence for it, and the consumer rejects the sort of Wrapped values.
+# - Changed manifests: the consumer rejects stale, missing, duplicate and
+#   mismatched evidence with E_UNSUPPORTED_SORT. It also rejects a malformed
+#   manifest, an incomplete manifest, and a stale type view.
+set -uo pipefail
+
+charon=$1
+aeneas=$2
+here=$(cd "$(dirname "$0")" && pwd)
+repo=$(cd "$here/../.." && pwd)
+work=${3:-$(mktemp -d)}
+mkdir -p "$work"
+work=$(cd "$work" && pwd)
+lib=${AENEAS_LEAN:-$repo/backends/lean}
+failures=0
+
+check() { # check <description> <command...>
+  local what=$1
+  shift
+  if "$@"; then
+    echo "ok: $what"
+  else
+    echo "FAILED: $what"
+    failures=$((failures + 1))
+  fi
+}
+
+owner_items=()
+consumer_opaque=()
+for t in Source Canon Parity Holder; do
+  for item in "sort::$t" "sort::{impl core::cmp::Ord for sort::$t}" \
+    "sort::{impl core::cmp::PartialOrd<sort::$t> for sort::$t}" \
+    "sort::{impl core::cmp::PartialEq<sort::$t> for sort::$t}" \
+    "sort::{impl core::cmp::Eq for sort::$t}"; do
+    owner_items+=(--start-from "$item")
+    case $item in
+      *"{impl"*) consumer_opaque+=(--opaque "$item") ;;
+    esac
+  done
+done
+
+llbc() { # llbc <name> <charon options...>
+  local name=$1
+  shift
+  RUSTC_WRAPPER= "$charon" rustc --preset=aeneas --mir=promoted \
+    --monomorphize-mut=except-types --remove-adt-clauses \
+    "--lift-associated-types=*" --error-on-warnings --abort-on-error "$@" \
+    --dest-file "$work/$name.llbc" -- "$here/sort.rs" --crate-name=sort \
+    --crate-type=rlib --edition=2021 >"$work/$name.charon.log" 2>&1
+}
+
+aeneas_run() { # aeneas_run <name> <module> <llbc> <aeneas options...>
+  local name=$1 module=$2 input=$3
+  shift 3
+  rm -rf "$work/$name"
+  mkdir -p "$work/$name"
+  "$aeneas" -backend lean -checks -abort-on-error -warnings-as-errors \
+    -strict-joins -sequential -no-progress-bar -canonical-names -split-files \
+    -subdir "$module" -dest "$work/$name/lean" \
+    -emit-manifest "$work/$name/manifest.json" "$@" "$work/$input.llbc" \
+    >"$work/$name/log" 2>&1
+}
+
+rejects() { # rejects <name> <message regex> <module> <llbc> <aeneas options...>
+  local name=$1 message=$2
+  shift 2
+  if aeneas_run "$name" "$@"; then
+    echo "  $name was admitted"
+    return 1
+  fi
+  grep -qE "$message" "$work/$name/log" || {
+    echo "  $name failed without /$message/:"
+    grep -A2 '^\[Error\]' "$work/$name/log" | head -6
+    return 1
+  }
+}
+
+check "Charon: the owner chunk" llbc owner "${owner_items[@]}"
+check "Charon: the consumer chunk" llbc consumer "${consumer_opaque[@]}" \
+  --start-from sort::sorted_codes --start-from sort::sorted_unstable_codes \
+  --start-from sort::source_orders
+check "Charon: the consumer of the hand-written order" llbc hand \
+  "${consumer_opaque[@]}" --start-from sort::sorted_wrapped
+
+check "Aeneas: the owner chunk" aeneas_run owner ChunkOwner owner
+owner=$work/owner/manifest.json
+check "Aeneas: the consumer chunk admits the sorts" \
+  aeneas_run consumer ChunkConsumer consumer -external "$owner"
+
+# The evidence of the owner: one entry per derived Ord and PartialOrd impl of
+# Source, Canon and Holder, and none for Parity.
+check "the owner records the evidence of the derived impls" python3 - "$owner" <<'PY'
+import json, sys
+entries = json.load(open(sys.argv[1]))["entries"]
+evidence = {e["key"]: e["sort_order"] for e in entries if "sort_order" in e}
+want = set()
+for t in ("Source", "Canon", "Holder"):
+    want.add(f"trait_impl sort::{{core::cmp::Ord for sort::{t}}}")
+    want.add(f"trait_impl sort::{{core::cmp::PartialOrd<sort::{t}> for sort::{t}}}")
+assert set(evidence) == want, sorted(evidence)
+for key, s in evidence.items():
+    if "Ord for" in key:
+        assert s["trait"] == "core::cmp::Ord", s
+        assert s["partial_ord_impl_key"] in want, s
+    else:
+        assert s["trait"] == "core::cmp::PartialOrd" and s["partial_ord_impl_key"] is None, s
+PY
+no_owner_defs() {
+  ! grep -rqE '^(noncomputable )?(def|instance|structure|inductive) sort\.(Source|Canon|Parity|Holder)\b' \
+    "$work/consumer/lean/ChunkConsumer"
+}
+check "the consumer does not emit the items of the owner" no_owner_defs
+
+# Native results
+native=$work/native
+toolchain=$("$charon" toolchain-path)
+check "native: rustc" "$toolchain/bin/rustc" --edition=2021 -A unused "$here/sort.rs" -o "$native"
+check "native: rustc --test" "$toolchain/bin/rustc" --edition=2021 --test -A unused "$here/sort.rs" -o "$native-test"
+check "native: the tests of sort.rs" "$native-test" -q
+results=()
+while IFS= read -r line; do results+=("$line"); done < <("$native")
+check "native: three result lines" test "${#results[@]}" -eq 3
+
+guards() { # guards <file> <first value delta>
+  local codes unstable orders
+  IFS=, read -r -a codes <<<"${results[0]}"
+  IFS=, read -r -a unstable <<<"${results[1]}"
+  IFS=, read -r -a orders <<<"${results[2]}"
+  codes[0]=$((codes[0] + $2))
+  cat >"$1" <<LEAN
+import ChunkOwner.Funs
+import ChunkConsumer.Funs
+
+open Aeneas Aeneas.Std Result
+
+#guard sort.sorted_codes == ok (${codes[0]}#u32, ${codes[1]}#u32, ${codes[2]}#u32, ${codes[3]}#u32, ${codes[4]}#u32, ${codes[5]}#u32)
+#guard sort.sorted_unstable_codes == ok (${unstable[0]}#u32, ${unstable[1]}#u32, ${unstable[2]}#u32, ${unstable[3]}#u32, ${unstable[4]}#u32, ${unstable[5]}#u32)
+#guard sort.source_orders == ok (${orders[0]}#u8, ${orders[1]}#u8, ${orders[2]}#u8)
+LEAN
+}
+
+# Compile the modules of both chunks, imports first, then the checks.
+olean=$work/olean
+rm -rf "$olean"
+mkdir -p "$olean"
+compile() { # compile <module>
+  local module=$1 path file root dep
+  path=${module//.//}
+  file=""
+  for root in "$work/owner/lean" "$work/consumer/lean"; do
+    if [ -f "$root/$path.lean" ]; then
+      file=$root/$path.lean
+      break
+    fi
+  done
+  # Lake builds the modules of the library. A chunk module must exist.
+  if [ -z "$file" ]; then
+    case $module in
+      Chunk*) echo "  no file for $module"; return 1 ;;
+      *) return 0 ;;
+    esac
+  fi
+  [ -f "$olean/$path.olean" ] && return 0
+  for dep in $(sed -n 's/^import \([A-Za-z0-9_.]*\).*/\1/p' "$file"); do
+    compile "$dep" || return 1
+  done
+  mkdir -p "$(dirname "$olean/$path.olean")"
+  (cd "$lib" && LEAN_PATH="$olean${LEAN_PATH:+:$LEAN_PATH}" lake env lean \
+    --root="$root" -o "$olean/$path.olean" "$file") >"$work/lean-$module.log" 2>&1 || {
+    tail -20 "$work/lean-$module.log"
+    return 1
+  }
+}
+check "Lean: the modules of both chunks compile" compile ChunkConsumer.Funs
+lean_checks() { # lean_checks <file>
+  (cd "$lib" && LEAN_PATH="$olean${LEAN_PATH:+:$LEAN_PATH}" lake env lean "$1") \
+    >"$1.log" 2>&1
+}
+guards "$work/Checks.lean" 0
+check "Lean: the guards equal the native results" lean_checks "$work/Checks.lean"
+guards "$work/Flipped.lean" 1
+flipped_fails() { ! lean_checks "$work/Flipped.lean"; }
+check "Lean: a flipped guard fails" flipped_fails
+
+# Rejections
+check "a hand-written order is rejected" rejects hand \
+  'E_UNSUPPORTED_SORT: the type sort::Parity has no Ord impl in the crate, and no manifest records derived-order evidence' \
+  ChunkHand hand -external "$owner"
+
+# change <name> <python statements>: write <name>.json, a copy of the owner
+# manifest after the statements. They see the entries as E (by key), the
+# Source keys as TY, ORD and PO, and copy() for a renamed entry.
+change() {
+  python3 - "$owner" "$work/$1.json" "$2" <<'PY'
+import copy as _copy, json, sys
+manifest = json.load(open(sys.argv[1]))
+E = {e["key"]: e for e in manifest["entries"]}
+TY = "type sort::Source"
+ORD = "trait_impl sort::{core::cmp::Ord for sort::Source}"
+PO = "trait_impl sort::{core::cmp::PartialOrd<sort::Source> for sort::Source}"
+def copy(key, new_key):
+    e = _copy.deepcopy(E[key])
+    e["key"] = new_key
+    e["names"] = [n + "Copy" for n in e["names"]]
+    manifest["entries"].append(e)
+    return e
+exec(sys.argv[3])
+json.dump(manifest, open(sys.argv[2], "w"))
+PY
+}
+consumer_rejects() { # consumer_rejects <name> <message regex>
+  rejects "$1" "$2" ChunkConsumer consumer -external "$work/$1.json"
+}
+
+change stale-evidence 'E[ORD]["sort_order"]["type_fingerprint"] = "0" * 32'
+check "stale evidence is rejected" consumer_rejects stale-evidence \
+  'the type sort::Source has stale derived-order evidence: the entry of \[trait_impl sort::\{core::cmp::Ord for sort::Source\}\] records the type fingerprint 0{32}'
+change stale-view '
+for e in manifest["entries"]:
+    if e["key"] == TY:
+        e["fingerprint"] = "0" * 32
+    if e.get("sort_order", {}).get("type_key") == TY:
+        e["sort_order"]["type_fingerprint"] = "0" * 32'
+check "a stale type view is rejected" consumer_rejects stale-view \
+  'the interface of \[type sort::Source\] in this chunk differs from the one emitted by its owner module'
+change missing-ord-evidence 'del E[ORD]["sort_order"]'
+check "missing Ord evidence is rejected" consumer_rejects missing-ord-evidence \
+  'the type sort::Source has no Ord impl in the crate, and no manifest records derived-order evidence'
+change missing-partial-entry 'manifest["entries"].remove(E[PO])'
+check "a missing PartialOrd entry is rejected" consumer_rejects missing-partial-entry \
+  'needs the PartialOrd impl \[trait_impl sort::\{core::cmp::PartialOrd<sort::Source> for sort::Source\}\], which the evidence of \[trait_impl sort::\{core::cmp::Ord for sort::Source\}\] names, but no manifest emits it'
+change missing-partial-evidence 'del E[PO]["sort_order"]'
+check "missing PartialOrd evidence is rejected" consumer_rejects missing-partial-evidence \
+  'needs derived-order evidence for the PartialOrd impl .* but its manifest entry has none'
+change duplicate-ord 'copy(ORD, ORD.replace("sort::{", "sort::other::{"))'
+check "duplicate Ord evidence is rejected" consumer_rejects duplicate-ord \
+  'the type sort::Source has several Ord impls with derived-order evidence'
+change duplicate-partial 'copy(PO, PO.replace("sort::{", "sort::other::{"))'
+check "PartialOrd evidence for another impl is rejected" consumer_rejects duplicate-partial \
+  'has PartialOrd evidence in \[trait_impl sort::other::.*\], but the Ord evidence of .* names'
+change mismatched-impl '
+other = PO.replace("sort::{", "sort::other::{")
+copy(PO, other)
+del E[PO]["sort_order"]
+E[ORD]["sort_order"]["partial_ord_impl_key"] = other'
+check "evidence for another impl than the one of the consumer is rejected" \
+  consumer_rejects mismatched-impl \
+  'the type sort::Source has the impl trait_impl sort::\{core::cmp::PartialOrd<sort::Source> for sort::Source\} in this chunk, which is not the external derived impl \[trait_impl sort::other::'
+change malformed 'E[ORD]["sort_order"]["type_key"] = "type sort::Canon"'
+check "evidence for another type is a malformed manifest" consumer_rejects malformed \
+  'malformed manifest .*: the derived-order evidence of \[trait_impl sort::\{core::cmp::Ord for sort::Source\}\] does not name an Ord or PartialOrd implementation of its type'
+change missing-type 'manifest["entries"].remove(E[TY])'
+check "evidence for a type which no manifest emits is rejected" consumer_rejects missing-type \
+  'the type sort::Source has no Ord impl in the crate, and no -external manifest emits it'
+change incomplete 'manifest["version"] = 2
+manifest["complete"] = False'
+check "an incomplete manifest is rejected" consumer_rejects incomplete 'is incomplete'
+
+if [ "$failures" -ne 0 ]; then
+  echo "sort.sh: $failures failure(s) (work directory $work)"
+  exit 1
+fi
+echo "sort.sh: all checks passed"
