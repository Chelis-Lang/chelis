+          Error
+            ("has stale derived-order evidence: the entry of [" ^ key
+           ^ "] records the type fingerprint " ^ s.type_fingerprint
+           ^ ", but the manifests emit [" ^ t.key ^ "] with the fingerprint "
+           ^ t.fingerprint ^ owner)
