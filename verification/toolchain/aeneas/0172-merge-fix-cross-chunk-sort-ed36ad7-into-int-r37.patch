index 0000000..c069a25
--- /dev/null
+++ b/tests/separate-compilation/sort.rs
@@ -0,0 +1,181 @@
+// Cross-chunk derived orders (see sort.sh). The owner chunk emits the types
+// and the Ord, PartialOrd, PartialEq and Eq impls of Source, Canon, Parity and
+// Holder. The consumer chunk keeps them opaque, as a later chunk of a
+// workspace does. The shapes follow chelis_ir::capacity_key, where
+// ValidityDomain::new sorts CapacityPredicate values.
+use std::cmp::Ordering;
+
+// The owner derives the order of Source (as CapacitySource).
+#[derive(Clone, Copy, Debug, Eq, PartialEq, Ord, PartialOrd)]
+pub enum Source {
+    Axis { scope: u32, axis: u32 },
+    Scalar { scope: u32 },
+}
+
+// The owner derives the order of Canon (as CanonicalCapacity). Its Ord impl is
+// in the LLBC of the consumer, but the impls of Source are not.
+#[derive(Clone, Copy, Debug, Eq, PartialEq, Ord, PartialOrd)]
+pub enum Canon {
+    Literal(u32),
+    Src(Source),
+}
+
+// The owner writes the order of Parity by hand: Equal holds between distinct
+// values.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct Parity(pub u32);
+
+impl PartialOrd for Parity {
+    fn partial_cmp(&self, other: &Self) -> Option<Ordering> {
+        Some(self.cmp(other))
+    }
+}
+
+impl Ord for Parity {
+    fn cmp(&self, other: &Self) -> Ordering {
+        (self.0 % 2).cmp(&(other.0 % 2))
+    }
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq, Ord, PartialOrd)]
+pub struct Holder {
+    pub parity: Parity,
+}
+
+// The consumer derives the order of Pred (as CapacityPredicate).
+#[derive(Clone, Copy, Debug, Eq, PartialEq, Ord, PartialOrd)]
+pub enum Pred {
+    NonZero(Canon),
+    Divides { dividend: Canon, divisor: Canon },
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq, Ord, PartialOrd)]
+pub struct Wrapped {
+    pub holder: Holder,
+    pub tag: u32,
+}
+
+fn source_code(s: &Source) -> u32 {
+    match s {
+        Source::Axis { scope, axis } => 100 + *scope * 10 + *axis,
+        Source::Scalar { scope } => 200 + *scope,
+    }
+}
+
+fn canon_code(c: &Canon) -> u32 {
+    match c {
+        Canon::Literal(n) => *n,
+        Canon::Src(s) => 1000 + source_code(s),
+    }
+}
+
+pub fn pred_code(p: &Pred) -> u32 {
+    match p {
+        Pred::NonZero(c) => canon_code(c),
+        Pred::Divides { dividend, divisor } => 100000 + canon_code(dividend) * 2000 + canon_code(divisor),
+    }
+}
+
+fn preds() -> Vec<Pred> {
+    vec![
+        Pred::Divides { dividend: Canon::Literal(2), divisor: Canon::Src(Source::Axis { scope: 1, axis: 0 }) },
+        Pred::NonZero(Canon::Src(Source::Scalar { scope: 0 })),
+        Pred::NonZero(Canon::Src(Source::Axis { scope: 2, axis: 1 })),
+        Pred::NonZero(Canon::Literal(7)),
+        Pred::NonZero(Canon::Src(Source::Axis { scope: 2, axis: 0 })),
+        Pred::Divides { dividend: Canon::Literal(2), divisor: Canon::Literal(9) },
+    ]
+}
+
+// The caller observes the write-back of the sorted vector.
+pub fn sort_preds(values: &mut Vec<Pred>) {
+    values.sort();
+}
+
+pub fn sort_preds_unstable(values: &mut Vec<Pred>) {
+    values.sort_unstable();
+}
+
+pub fn sorted_codes() -> (u32, u32, u32, u32, u32, u32) {
+    let mut values = preds();
+    sort_preds(&mut values);
+    (
+        pred_code(&values[0]),
+        pred_code(&values[1]),
+        pred_code(&values[2]),
+        pred_code(&values[3]),
+        pred_code(&values[4]),
+        pred_code(&values[5]),
+    )
+}
+
+pub fn sorted_unstable_codes() -> (u32, u32, u32, u32, u32, u32) {
+    let mut values = preds();
+    sort_preds_unstable(&mut values);
+    (
+        pred_code(&values[0]),
+        pred_code(&values[1]),
+        pred_code(&values[2]),
+        pred_code(&values[3]),
+        pred_code(&values[4]),
+        pred_code(&values[5]),
+    )
+}
+
+// A direct comparison puts the PartialOrd impl of Source (but not its Ord
+// impl) in the LLBC of the consumer.
+pub fn source_order(a: Source, b: Source) -> u8 {
+    match a.partial_cmp(&b) {
+        Some(Ordering::Less) => 0,
+        Some(Ordering::Equal) => 1,
+        Some(Ordering::Greater) => 2,
+        None => 3,
+    }
+}
+
+pub fn source_orders() -> (u8, u8, u8) {
+    (
+        source_order(Source::Axis { scope: 3, axis: 9 }, Source::Scalar { scope: 0 }),
+        source_order(Source::Axis { scope: 3, axis: 9 }, Source::Axis { scope: 3, axis: 9 }),
+        source_order(Source::Axis { scope: 4, axis: 0 }, Source::Axis { scope: 3, axis: 9 }),
+    )
+}
+
+// Rejected: Holder compares a Parity, whose hand-written Equal holds between
+// distinct values.
+pub fn sorted_wrapped() -> (u32, u32) {
+    let mut values = vec![
+        Wrapped { holder: Holder { parity: Parity(3) }, tag: 0 },
+        Wrapped { holder: Holder { parity: Parity(1) }, tag: 0 },
+    ];
+    values.sort();
+    (values[0].holder.parity.0, values[1].holder.parity.0)
+}
+
+pub fn main() {
+    let a = sorted_codes();
+    let b = sorted_unstable_codes();
+    let c = source_orders();
+    println!("{},{},{},{},{},{}", a.0, a.1, a.2, a.3, a.4, a.5);
+    println!("{},{},{},{},{},{}", b.0, b.1, b.2, b.3, b.4, b.5);
+    println!("{},{},{}", c.0, c.1, c.2);
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn derived_orders() {
+        let expected = (7, 1120, 1121, 1200, 104009, 105110);
+        assert_eq!(sorted_codes(), expected);
+        assert_eq!(sorted_unstable_codes(), expected);
+        assert_eq!(source_orders(), (0, 1, 2));
+    }
+
+    #[test]
+    fn hand_written_order() {
+        // Parity(3) and Parity(1) compare Equal: the stable sort keeps them.
+        assert_eq!(sorted_wrapped(), (3, 1));
+    }
+}
