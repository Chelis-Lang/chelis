+    these keys. [Translate] checks the view of the type in this chunk against
+    its entry (see [require_sort_order_view]). *)
+let external_derived_order (id : item_id) : (string * string, string) result =
+  match external_entry id with
+  | None ->
+      Error "has no Ord impl in the crate, and no -external manifest emits it"
+  | Some t when not (has_prefix "type " t.key) ->
+      Error ("has the external entry [" ^ t.key ^ "], which is not a type")
+  | Some t -> (
