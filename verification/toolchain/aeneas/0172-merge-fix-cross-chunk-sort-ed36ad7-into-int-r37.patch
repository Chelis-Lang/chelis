+          (fun (_, (s : sort_order_impl)) -> s.type_fingerprint <> t.fingerprint)
+          evidence
+      in
+      let partials = with_trait partial_ord_trait in
+      let owner = " (owner module " ^ t.lean_module ^ ")" in
+      match (stale, with_trait ord_trait) with
