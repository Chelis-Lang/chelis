+(** Separate compilation: the fields of an external trait declaration are the
+    ones the owner chunk kept (see [prune_unused_provided_fields]), for the
+    external declaration and for the implementations of this chunk. A method
+    call of this chunk through a pruned field fails closed. *)
+let apply_external_trait_fields (decls : trait_decl list)
+    (impls : trait_impl list) (funs : pure_fun_translation list) :
+    trait_decl list * trait_impl list =
+  let fields =
+    List.fold_left
+      (fun m (decl : trait_decl) ->
+        match SeparateCompilation.external_entry (IdTraitDecl decl.def_id) with
+        | Some { methods = Some methods; _ } ->
+            TraitDeclId.Map.add decl.def_id methods m
+        | Some e ->
+            [%craise] decl.item_meta.span
+              ("Separate compilation: the manifest entry of [" ^ e.key
+             ^ "] has no method list")
+        | None -> m)
+      TraitDeclId.Map.empty decls
+  in
+  if TraitDeclId.Map.is_empty fields then (decls, impls)
+  else
+    let keep id name =
+      match TraitDeclId.Map.find_opt id fields with
+      | None -> true
+      | Some methods -> List.mem name methods
+    in
+    let visitor =
+      object
+        inherit [_] iter_expr
+
+        method! visit_qualif span q =
+          match q.id with
+          | FunOrOp (Fun (FromLlbc (TraitMethod (tr, name, _), _)))
+            when not (keep tr.trait_decl_ref.trait_decl_id name) ->
+              [%craise] span
+                ("Separate compilation: the method " ^ name
+               ^ " is not a field of the external trait declaration (the owner \
+                  chunk pruned it as unused)")
+          | _ -> ()
+      end
+    in
+    List.iter
+      (fun (f : pure_fun_translation) ->
+        List.iter
+          (fun (d : fun_decl) ->
+            Option.iter
+              (fun (b : fun_body) ->
+                visitor#visit_texpr d.item_meta.span b.body)
+              d.body)
+          ((f.f :: f.loops) @ f.bodies))
+      funs;
+    let decls =
+      List.map
+        (fun (decl : trait_decl) ->
+          {
+            decl with
+            methods =
+              List.filter (fun (name, _) -> keep decl.def_id name) decl.methods;
+          })
+        decls
+    in
+    let impls =
+      List.map
+        (fun (impl : trait_impl) ->
+          {
+            impl with
+            methods =
+              List.filter
+                (fun (name, _) -> keep impl.impl_trait.trait_decl_id name)
+                impl.methods;
+          })
+        impls
+    in
+    (decls, impls)
+
