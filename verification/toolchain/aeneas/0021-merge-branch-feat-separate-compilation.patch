diff --git a/src/llbc/SeparateCompilation.ml b/src/llbc/SeparateCompilation.ml
new file mode 100644
index 0000000..7b12be7
--- /dev/null
+++ b/src/llbc/SeparateCompilation.ml
@@ -0,0 +1,420 @@
+(** Separate compilation of a workspace into chunks forming one Lean
+    environment.
+
+    Every item is identified across chunks by a {e key}: its kind and its
+    structural Rust name, printed without any LLBC item id (instantiated path
+    elements included), so that the key of an item is the same in every LLBC
+    which contains it. A chunk extracted with [-emit-manifest] records, for
+    every declaration it emits, its key, the Lean module which owns it, its Lean
+    names, a fingerprint of its translated interface, and the facts that the
+    translation of callers derives from its body. A later chunk given this
+    manifest with [-external] keeps the LLBC declarations of these items (to
+    translate the uses) but does not emit them: it checks that its own view of
+    their interfaces is the one of the owner and imports the owner modules.
+
+    Opaque functions which are not listed in a manifest remain unknown external
+    definitions, which fail closed exactly as without these options. *)
+
+open Types
+open LlbcAst
+
+let log = Logging.translate_log
+
+(** Facts about a function that the translation of its callers (and its own
+    signature) derives from its body. External functions may be opaque in a
+    later chunk: they use the owner's facts. *)
+type fun_facts = {
+  can_fail : bool;
+  stateful : bool;
+  can_diverge : bool;
+  is_rec : bool;
+  state_inputs : int list;
+      (** See [ModelStateInputs.for_decl] (input positions whose final state is
+          an output of the translated signature) *)
+  canonical_body : int list option;
+      (** See [ModelStateInputs.canonical_body_state_inputs] *)
+}
+
+type entry = {
+  key : string;
+  lean_module : string;  (** The Lean module which emits the declaration *)
+  lean_names : string list;
+      (** The top-level Lean names of the declaration, the main one first
+          (function declarations also emit their loops) *)
+  fingerprint : string;
+      (** Digest of the translated interface (see [Translate]) *)
+  facts : fun_facts option;
+      (** Functions and globals (facts of the initializer) *)
+  methods : string list option;
+      (** Trait declarations: the methods which are fields of the Lean structure
+      *)
+}
+
+let manifest_version = 1
+
+(** {1 Canonical names} *)
+
+let canonical_env : Charon.Print.fmt_env option ref = ref None
+
+let path_elem_to_string (env : Charon.Print.fmt_env) (e : path_elem) : string =
+  match e with
+  | PeInstantiated binder ->
+      (* Contrary to [Charon.Print.path_elem_to_string], also print the trait
+         references of the instantiation: they are part of its identity. *)
+      let env =
+        Charon.PrintUtils.fmt_env_push_generics_and_preds env
+          binder.binder_params
+      in
+      let params, trait_refs =
+        Charon.Print.generic_args_to_strings env binder.binder_value
+      in
+      "<" ^ String.concat ", " params ^ ">["
+      ^ String.concat ", " trait_refs
+      ^ "]"
+  | _ -> Charon.Print.path_elem_to_string env e
+
+let name_to_string_with (env : Charon.Print.fmt_env) (name : name) : string =
+  String.concat "::" (List.map (path_elem_to_string env) name)
+
+(** The structural Rust name of an item, independent of the LLBC ids. *)
+let canonical_name_to_string (name : name) : string =
+  match !canonical_env with
+  | Some env -> name_to_string_with env name
+  | None ->
+      [%craise_opt_span] None
+        "Internal error: the canonical naming environment is not initialized"
+
+let item_meta (crate : crate) (id : item_id) : item_meta option =
+  match id with
+  | IdType id ->
+      Option.map
+        (fun (d : type_decl) -> d.item_meta)
+        (TypeDeclId.Map.find_opt id crate.type_decls)
+  | IdFun id ->
+      Option.map
+        (fun (d : fun_decl) -> d.item_meta)
+        (FunDeclId.Map.find_opt id crate.fun_decls)
+  | IdGlobal id ->
+      Option.map
+        (fun (d : global_decl) -> d.item_meta)
+        (GlobalDeclId.Map.find_opt id crate.global_decls)
+  | IdTraitDecl id ->
+      Option.map
+        (fun (d : trait_decl) -> d.item_meta)
+        (TraitDeclId.Map.find_opt id crate.trait_decls)
+  | IdTraitImpl id ->
+      Option.map
+        (fun (d : trait_impl) -> d.item_meta)
+        (TraitImplId.Map.find_opt id crate.trait_impls)
+
+let kind_to_string (id : item_id) : string =
+  match id with
+  | IdType _ -> "type"
+  | IdFun _ -> "fun"
+  | IdGlobal _ -> "global"
+  | IdTraitDecl _ -> "trait_decl"
+  | IdTraitImpl _ -> "trait_impl"
+
+let item_key (crate : crate) (id : item_id) : string option =
+  Option.map
+    (fun (meta : item_meta) ->
+      kind_to_string id ^ " " ^ canonical_name_to_string meta.name)
+    (item_meta crate id)
+
+(** {1 State} *)
+
+(** Entries loaded from the [-external] manifests, by key *)
+let loaded : (string, entry) Hashtbl.t = Hashtbl.create 1024
+
+(** Keys of the loaded entries, by Lean name *)
+let loaded_names : (string, string) Hashtbl.t = Hashtbl.create 1024
+
+(** External items of the current crate *)
+let externals : (item_id, entry) Hashtbl.t = Hashtbl.create 1024
+
+(** Entries emitted by the current chunk, by key, in emission order *)
+let emitted : (string, entry) Hashtbl.t = Hashtbl.create 1024
+
+let emitted_order : string list ref = ref []
+
+(** The Lean module of the file currently being generated *)
+let current_module : string option ref = ref None
+
+let enabled () : bool = !Config.canonical_names
+let is_external (id : item_id) : bool = Hashtbl.mem externals id
+let external_entry (id : item_id) : entry option = Hashtbl.find_opt externals id
+
+let external_fun_facts (id : FunDeclId.id) : fun_facts option =
+  match Hashtbl.find_opt externals (IdFun id) with
+  | Some { facts = Some facts; _ } -> Some facts
+  | _ -> None
+
+(** {1 Manifests} *)
+
+(** Register an error. The run fails (and writes no manifest), but all the
+    inconsistencies are reported, even with [-abort-on-error]. *)
+let fail (msg : string) : unit = Errors.push_error __FILE__ __LINE__ None msg
+
+let facts_to_json (f : fun_facts) : Yojson.Basic.t =
+  `Assoc
+    [
+      ("can_fail", `Bool f.can_fail);
+      ("stateful", `Bool f.stateful);
+      ("can_diverge", `Bool f.can_diverge);
+      ("is_rec", `Bool f.is_rec);
+      ("state_inputs", `List (List.map (fun i -> `Int i) f.state_inputs));
+      ( "canonical_body",
+        match f.canonical_body with
+        | None -> `Null
+        | Some l -> `List (List.map (fun i -> `Int i) l) );
+    ]
+
+let entry_to_json (e : entry) : Yojson.Basic.t =
+  let strings l = `List (List.map (fun s -> `String s) l) in
+  `Assoc
+    ([
+       ("key", `String e.key);
+       ("module", `String e.lean_module);
+       ("names", strings e.lean_names);
+       ("fingerprint", `String e.fingerprint);
+     ]
+    @ (match e.facts with
+      | None -> []
+      | Some f -> [ ("facts", facts_to_json f) ])
+    @
+    match e.methods with
+    | None -> []
+    | Some l -> [ ("methods", strings l) ])
+
+exception Malformed of string
+
+let facts_of_json (js : Yojson.Basic.t) : fun_facts =
+  let open Yojson.Basic.Util in
+  let ints js = List.map to_int (to_list js) in
+  {
+    can_fail = to_bool (member "can_fail" js);
+    stateful = to_bool (member "stateful" js);
+    can_diverge = to_bool (member "can_diverge" js);
+    is_rec = to_bool (member "is_rec" js);
+    state_inputs = ints (member "state_inputs" js);
+    canonical_body =
+      (match member "canonical_body" js with
+      | `Null -> None
+      | l -> Some (ints l));
+  }
+
+let entry_of_json (js : Yojson.Basic.t) : entry =
+  let open Yojson.Basic.Util in
+  let strings js = List.map to_string (to_list js) in
+  let lean_names = strings (member "names" js) in
+  if lean_names = [] then raise (Malformed "an entry has no Lean name");
+  {
+    key = to_string (member "key" js);
+    lean_module = to_string (member "module" js);
+    lean_names;
+    fingerprint = to_string (member "fingerprint" js);
+    facts =
+      (match member "facts" js with
+      | `Null -> None
+      | f -> Some (facts_of_json f));
+    methods =
+      (match member "methods" js with
+      | `Null -> None
+      | l -> Some (strings l));
+  }
+
+let namespace_to_json () : Yojson.Basic.t =
+  match !Config.namespace with
+  | None -> `Null
+  | Some ns -> `String ns
+
+(** Register the entries of a manifest. The same key may be listed by several
+    manifests only if it has the same owner (e.g., a manifest including an
+    earlier one); two owners for one key, or one Lean name for two keys, is a
+    duplicate emission. *)
+let add_loaded (file : string) (e : entry) : unit =
+  (match Hashtbl.find_opt loaded e.key with
+  | Some prev when prev.lean_module <> e.lean_module ->
+      fail
+        ("Separate compilation: duplicate emission of [" ^ e.key
+       ^ "] by the Lean modules " ^ prev.lean_module ^ " and " ^ e.lean_module
+       ^ " (manifest " ^ file ^ ")")
+  | Some prev when prev <> e ->
+      fail
+        ("Separate compilation: inconsistent manifest entries for [" ^ e.key
+       ^ "] (manifest " ^ file ^ ")")
+  | _ -> Hashtbl.replace loaded e.key e);
+  List.iter
+    (fun n ->
+      match Hashtbl.find_opt loaded_names n with
+      | Some key when key <> e.key ->
+          fail
+            ("Separate compilation: duplicate emission of the Lean name " ^ n
+           ^ " for [" ^ key ^ "] and [" ^ e.key ^ "] (manifest " ^ file ^ ")")
+      | _ -> Hashtbl.replace loaded_names n e.key)
+    e.lean_names
+
+let load_manifest (file : string) : unit =
+  try
+    let js = Yojson.Basic.from_file file in
+    let open Yojson.Basic.Util in
+    if to_int (member "version" js) <> manifest_version then
+      raise (Malformed "unsupported version");
+    if member "namespace" js <> namespace_to_json () then
+      fail
+        ("Separate compilation: the manifest " ^ file
+       ^ " was generated for a different -namespace");
+    List.iter
+      (fun e -> add_loaded file (entry_of_json e))
+      (to_list (member "entries" js))
+  with
+  | Yojson.Json_error msg | Malformed msg ->
+      fail ("Separate compilation: malformed manifest " ^ file ^ ": " ^ msg)
+  | Yojson.Basic.Util.Type_error (msg, _) ->
+      fail ("Separate compilation: malformed manifest " ^ file ^ ": " ^ msg)
+  | Sys_error msg ->
+      fail
+        ("Separate compilation: cannot read the manifest " ^ file ^ ": " ^ msg)
+
+(** Initialize the canonical names, load the manifests and resolve the external
+    items of the crate. To be called on the crate loaded from the LLBC. *)
+let init (crate : crate) : unit =
+  if enabled () then (
+    canonical_env := Some (Charon.Print.crate_to_fmt_env crate);
+    List.iter load_manifest !Config.external_manifests;
+    if Hashtbl.length loaded > 0 then (
+      let resolve (id : item_id) : entry option =
+        match item_key crate id with
+        | Some key -> (
+            match Hashtbl.find_opt loaded key with
+            | Some e ->
+                Hashtbl.replace externals id e;
+                Some e
+            | None -> None)
+        | None -> None
+      in
+      TypeDeclId.Map.iter
+        (fun id _ -> ignore (resolve (IdType id)))
+        crate.type_decls;
+      FunDeclId.Map.iter
+        (fun id (d : fun_decl) ->
+          (* Globals initializers are emitted with (and resolved through) their
+             global *)
+          if Option.is_none d.is_global_initializer then
+            ignore (resolve (IdFun id)))
+        crate.fun_decls;
+      GlobalDeclId.Map.iter
+        (fun id (d : global_decl) ->
+          match resolve (IdGlobal id) with
+          | Some e -> Hashtbl.replace externals (IdFun d.init) e
+          | None -> ())
+        crate.global_decls;
+      TraitDeclId.Map.iter
+        (fun id _ -> ignore (resolve (IdTraitDecl id)))
+        crate.trait_decls;
+      TraitImplId.Map.iter
+        (fun id _ -> ignore (resolve (IdTraitImpl id)))
+        crate.trait_impls;
+      log#linfo
+        (lazy
+          ("Separate compilation: "
+          ^ string_of_int (Hashtbl.length externals)
+          ^ " external items")));
+    (* An external function carries the owner's facts *)
+    Hashtbl.iter
+      (fun id (e : entry) ->
+        match (id, e.facts) with
+        | IdFun _, None ->
+            fail
+              ("Separate compilation: the manifest entry of [" ^ e.key
+             ^ "] has no function facts")
+        | _ -> ())
+      externals)
+
+(** Only the owner chunk translates the body of an external function. *)
+let hide_external_bodies (crate : crate) : crate =
+  if Hashtbl.length externals = 0 then crate
+  else
+    let fun_decls =
+      FunDeclId.Map.map
+        (fun (f : fun_decl) ->
+          if is_external (IdFun f.def_id) then { f with body = OpaqueBody }
+          else f)
+        crate.fun_decls
+    in
+    { crate with fun_decls }
+
+(** The owner modules of the given external items, sorted *)
+let modules_of (ids : item_id list) : string list =
+  List.sort_uniq compare
+    (List.filter_map
+       (fun id -> Option.map (fun e -> e.lean_module) (external_entry id))
+       ids)
+
+(** {1 Emission} *)
+
+(** Record a declaration emitted by the current chunk. Function declarations are
+    recorded once per emitted Lean definition (loops included): the Lean names
+    accumulate. *)
+let record (e : entry) : unit =
+  match Hashtbl.find_opt emitted e.key with
+  | None ->
+      Hashtbl.replace emitted e.key e;
+      emitted_order := e.key :: !emitted_order
+  | Some prev ->
+      if prev.lean_module <> e.lean_module then
+        fail
+          ("Separate compilation: [" ^ e.key
+         ^ "] is emitted by the Lean modules " ^ prev.lean_module ^ " and "
+         ^ e.lean_module);
+      let names =
+        prev.lean_names
+        @ List.filter (fun n -> not (List.mem n prev.lean_names)) e.lean_names
+      in
+      Hashtbl.replace emitted e.key { prev with lean_names = names }
+
+(** Reject the declarations of this chunk which are already emitted by another
+    module. *)
+let check_emitted () : unit =
+  List.iter
+    (fun key ->
+      let e = Hashtbl.find emitted key in
+      (match Hashtbl.find_opt loaded key with
+      | Some prev ->
+          fail
+            ("Separate compilation: duplicate emission of [" ^ key
+           ^ "], already emitted by " ^ prev.lean_module)
+      | None -> ());
+      List.iter
+        (fun n ->
+          match Hashtbl.find_opt loaded_names n with
+          | Some other ->
+              let owner = (Hashtbl.find loaded other).lean_module in
+              fail
+                ("Separate compilation: duplicate emission of the Lean name "
+               ^ n ^ " for [" ^ key ^ "]: already emitted by " ^ owner
+               ^ " for [" ^ other ^ "]")
+          | None -> ())
+        e.lean_names)
+    (List.rev !emitted_order)
+
+let write_manifest (file : string) : unit =
+  let entries =
+    List.map
+      (fun key -> entry_to_json (Hashtbl.find emitted key))
+      (List.rev !emitted_order)
+  in
+  let js =
+    `Assoc
+      [
+        ("version", `Int manifest_version);
+        ("namespace", namespace_to_json ());
+        ("entries", `List entries);
+      ]
+  in
+  Yojson.Basic.to_file file js;
+  log#linfo
+    (lazy
+      ("Separate compilation: wrote the manifest " ^ file ^ " ("
+      ^ string_of_int (List.length entries)
+      ^ " declarations)"))
