+(** Separate compilation: the Lean modules imported by every generated file (the
+    owners of the external items) *)
+let sc_imports : string list ref = ref []
+
+(** Separate compilation: the Lean modules are named after their path relative
+    to the destination directory (the Lean source root). *)
+let sc_dest_dir : string ref = ref ""
+
+let sc_lean_module_of_file (filename : string) : string =
+  let dir = !sc_dest_dir in
+  let prefix = if String.ends_with ~suffix:"/" dir then dir else dir ^ "/" in
+  let rel =
+    if String.starts_with ~prefix filename then
+      String.sub filename (String.length prefix)
+        (String.length filename - String.length prefix)
+    else filename
+  in
+  let rel =
+    Option.value (Filename.chop_suffix_opt ~suffix:".lean" rel) ~default:rel
+  in
+  String.concat "." (List.filter (( <> ) "") (String.split_on_char '/' rel))
+
+(** Set the module which owns the declarations emitted from now on *)
+let sc_enter_file (filename : string) : unit =
+  if SC.enabled () then (
+    let m = sc_lean_module_of_file filename in
+    if List.mem m !sc_imports then
+      SC.fail
+        ("Separate compilation: the module " ^ m
+       ^ " is generated by this chunk but owns external items (a manifest of \
+          this chunk was given with -external)");
+    SC.current_module := Some m)
+
