+(** Separate compilation: canonical naming mode.
+
+    Every extracted name is derived from the full Rust path of the item (its
+    crate included), independently of the crate being extracted, and the
+    generated files are not wrapped in a crate-dependent namespace (only in the
+    one given with [-namespace], if any). Specialized (partially monomorphized)
+    items are disambiguated by a digest of their structural Rust name, which
+    does not depend on the LLBC item ids. Several chunks of one workspace
+    extracted in this mode form one coherent Lean environment. *)
+let canonical_names = ref false
+
+(** Separate compilation: manifests (written by [-emit-manifest] for earlier
+    chunks) listing the items which are already emitted by other Lean modules.
+    Their LLBC declarations are still used, but no declaration is emitted for
+    them: the generated files import their owner modules instead. *)
+let external_manifests : string list ref = ref []
+
+let add_external_manifest (s : string) : unit =
+  external_manifests := !external_manifests @ [ s ]
+
+(** Separate compilation: where to write the manifest of the items emitted by
+    this chunk. *)
+let emit_manifest : string option ref = ref None
+
+let set_emit_manifest (s : string) : unit = emit_manifest := Some s
+
