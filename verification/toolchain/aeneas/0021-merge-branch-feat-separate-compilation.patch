+(** {1 Separate compilation}
+
+    The interface of a declaration, as seen by the other chunks: a fingerprint
+    of its translation, printed with the (structural) Rust names of the items it
+    refers to. The fingerprint recorded by the owner chunk must be the one
+    computed from the external view in the other chunks, whose translation does
+    not see the bodies (see [SeparateCompilation.fun_facts]). *)
+
+let sc_env (ctx : gen_ctx) (generics : Pure.generic_params) : PrintPure.fmt_env
+    =
+  { (ExtractBase.extraction_ctx_to_fmt_env ctx) with generics = [ generics ] }
+
+let sc_fun_sig_fingerprint (ctx : gen_ctx) (sg : Pure.fun_sig) : string =
+  let env = sc_env ctx sg.generics in
+  String.concat "\n"
+    [
+      PrintPure.fun_sig_to_string env sg;
+      PrintPure.predicates_to_string env sg.preds;
+      Pure.show_explicit_info sg.explicit_info;
+      Pure.show_known_info sg.known_from_trait_refs;
+      Pure.show_fun_sig_info sg.fwd_info;
+      String.concat ";"
+        (List.map
+           (fun (id, info) ->
+             RegionGroupId.to_string id ^ ":" ^ Pure.show_fun_effect_info info)
+           (RegionGroupId.Map.bindings sg.back_effect_info));
+    ]
+
+let sc_type_fingerprint (ctx : gen_ctx) (d : Pure.type_decl) : string =
+  PrintPure.type_decl_to_string (sc_env ctx d.generics) d
+
+let sc_global_fingerprint (ctx : gen_ctx) (d : Pure.global_decl) : string =
+  let env = sc_env ctx d.generics in
+  String.concat "\n"
+    [
+      PrintPure.generic_params_to_string env d.generics;
+      PrintPure.predicates_to_string env d.preds;
+      Pure.show_explicit_info d.explicit_info;
+      PrintPure.ty_to_string env false d.ty;
+      string_of_bool d.can_fail;
+    ]
+
+let sc_trait_decl_fingerprint (ctx : gen_ctx) (d : Pure.trait_decl) : string =
+  let env = sc_env ctx d.generics in
+  let method_sig (name, (m : Pure.fun_decl_ref Pure.binder)) =
+    name ^ " : "
+    ^
+    match FunDeclId.Map.find_opt m.binder_value.fun_id ctx.trans_funs with
+    | Some trans -> sc_fun_sig_fingerprint ctx trans.f.signature
+    | None -> "<untranslated>"
+  in
+  String.concat "\n"
+    ([
+       PrintPure.generic_params_to_string env d.generics;
+       PrintPure.predicates_to_string env d.preds;
+       Pure.show_explicit_info d.explicit_info;
+     ]
+    @ List.map (PrintPure.trait_clause_to_string env) d.parent_clauses
+    @ List.map
+        (fun (name, ty) -> name ^ " : " ^ PrintPure.ty_to_string env false ty)
+        d.consts
+    @ d.types
+    @ List.map method_sig d.methods)
+
+let sc_trait_impl_fingerprint (ctx : gen_ctx) (d : Pure.trait_impl) : string =
+  let env = sc_env ctx d.generics in
+  String.concat "\n"
+    ([
+       PrintPure.trait_decl_ref_to_string env false d.impl_trait;
+       PrintPure.generic_params_to_string env d.generics;
+       PrintPure.predicates_to_string env d.preds;
+       Pure.show_explicit_info d.explicit_info;
+     ]
+    @ List.map (PrintPure.trait_ref_to_string env false) d.parent_trait_refs
+    @ List.map fst d.consts
+    @ List.map
