+//@ [!lean] skip
+//@ [lean] subdir=ShellBorrowingStates
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --opaque-hard=chelis_ir::lowering_runtime::scoped --opaque-hard=chelis_ir::lowering_runtime::grow_stack_if_needed --opaque-hard=chelis_ir::lowering_runtime::LoweringRuntime --opaque-hard=chelis_ir::lowering_runtime::{chelis_ir::lowering_runtime::LoweringRuntime}::catch_native_unwind
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! The native shell primitives of `chelis_ir::lowering_runtime` (models in
+//! `Aeneas/Std/ChelisNative.lean`; this crate is named `chelis_ir` so that the
+//! models apply) threading a state which holds mutable borrows: a context
+//! struct with `&mut` fields, as `chelis_ir::host::HostCx`, and tuples of
+//! `&mut`. Charon's `--monomorphize-mut` makes partial-monomorphization
+//! instances such as `scoped::<'_, HostCx<'_>, ..>`, whose ABI has a backward
+//! function for the inner region of the state. The models are parametric in
+//! the state, so the instances are the models at the state extended with this
+//! backward function, which the closure dictionaries compose call after call
+//! (see `ModelStateABI.threaded_fun_instance`).
+//! `ShellBorrowingStates/Checks.lean` evaluates the models on the inputs of the
+//! `native` test module below and compares with the native results.
+
+pub mod lowering_runtime {
+    use std::marker::PhantomData;
+
+    /// Primitive (hard-opaque). Model: `let t := enter s; let r := body s;
+    /// exit s t; r`.
+    pub(crate) fn scoped<S, T, R>(
+        state: &mut S,
+        enter: impl FnOnce(&mut S) -> T,
+        exit: impl FnOnce(&mut S, T),
+        body: impl FnOnce(&mut S) -> R,
+    ) -> R {
+        let token = enter(state);
+        let result = body(state);
+        exit(state, token);
+        result
+    }
+
+    /// Primitive (hard-opaque). Model: `f state`.
+    pub(crate) fn grow_stack_if_needed<S, R>(
+        state: &mut S,
+        red_zone: usize,
+        stack_size: usize,
+        f: impl FnOnce(&mut S) -> R,
+    ) -> R {
+        let _ = (red_zone, stack_size);
+        f(state)
+    }
+
+    /// The lowering runtime handle (hard-opaque).
+    pub struct LoweringRuntime {
+        thread_bound: PhantomData<*const ()>,
+    }
+
+    impl LoweringRuntime {
+        #[cfg(test)]
+        pub(crate) fn for_test() -> Self {
+            Self {
+                thread_bound: PhantomData,
+            }
+        }
+
+        /// Primitive (hard-opaque). Model: `f self state` with quiet output.
+        pub(crate) fn catch_native_unwind<S, T, D: Clone + 'static>(
+            &mut self,
+            state: &mut S,
+            f: impl FnOnce(&mut Self, &mut S) -> Result<T, D>,
+            marker: impl FnOnce() -> D,
+            message: impl FnOnce(Option<String>) -> D,
+        ) -> Result<T, D> {
+            let _ = (marker, message);
+            f(self, state)
+        }
+    }
+}
+
+use lowering_runtime::{LoweringRuntime, grow_stack_if_needed, scoped};
+
+/// A struct with an owned field and two `&mut` fields.
+pub struct Cx<'a> {
+    pub depth: u32,
+    pub a: &'a mut u32,
+    pub b: &'a mut u64,
+}
+
+fn with_bump<R>(cx: &mut Cx<'_>, body: impl FnOnce(&mut Cx<'_>) -> R) -> R {
+    scoped(
+        cx,
+        |cx| {
+            cx.depth += 1;
+            let old = *cx.a;
+            *cx.a = old.wrapping_add(1);
+            old
+        },
+        |cx, old| {
+            cx.depth -= 1;
+            *cx.b = cx.b.wrapping_add(old as u64);
+        },
+        body,
+    )
+}
+
+/// `scoped` and `grow_stack_if_needed` at a struct state.
+pub fn struct_state(a: &mut u32, b: &mut u64) -> u64 {
+    let mut cx = Cx { depth: 0, a, b };
+    let r = with_bump(&mut cx, |cx| {
+        let seen = grow_stack_if_needed(cx, 1, 2, |cx| {
+            *cx.b = cx.b.wrapping_mul(2);
+            cx.depth
+        });
+        *cx.a as u64 + *cx.b + seen as u64
+    });
+    r + cx.depth as u64
+}
+
+/// `scoped` and `grow_stack_if_needed` at tuple states.
+pub fn tuple_state(a: &mut u32, b: &mut u64) -> u32 {
+    scoped(
+        &mut (&mut *a, &mut *b),
+        |(a, _)| {
+            **a = a.wrapping_add(3);
+            **a
+        },
+        |(_, b), t| **b = b.wrapping_add(t as u64),
+        |(a, b)| {
+            grow_stack_if_needed(&mut (&mut **a, &mut **b), 1, 2, |(a, b)| {
+                **b = b.wrapping_mul(3);
+                **a = a.wrapping_mul(2);
+                **a
+            })
+        },
+    )
+}
+
+pub struct Session {
+    pub invocation: u32,
+    pub log: u64,
+}
+
+/// `chelis_ir::host::HostCx`: a shared and three mutable borrows.
+pub struct HostCx<'a> {
+    pub checked: &'a u32,
+    pub state: &'a mut Session,
+    pub runtime: &'a mut LoweringRuntime,
+    pub native: &'a mut u64,
+}
+
+impl HostCx<'_> {
+    /// `HostCx::catch_lowering`: the session and the native services are the
+    /// catch's explicit state (a tuple of `&mut`).
+    fn catch_invocation(&mut self) -> Result<u32, u32> {
+        let checked = *self.checked;
+        self.runtime.catch_native_unwind(
+            &mut (&mut *self.state, &mut *self.native),
+            move |_, (state, native)| {
+                **native = native.wrapping_add(state.invocation as u64);
+                if checked > 5 {
+                    Err(7)
+                } else {
+                    Ok(state.invocation)
+                }
+            },
+            || 1,
+            |_| 2,
+        )
+    }
+}
+
+/// `with_host_invocation`: a fresh invocation, restored on exit.
+fn with_invocation<R>(cx: &mut HostCx<'_>, body: impl FnOnce(&mut HostCx<'_>) -> R) -> R {
+    scoped(
+        cx,
+        |cx| std::mem::replace(&mut cx.state.invocation, 0),
+        |cx, previous| cx.state.invocation = previous,
+        body,
+    )
+}
+
+/// `with_mono_probe`: the log is rolled back on exit.
+fn with_probe<R>(cx: &mut HostCx<'_>, body: impl FnOnce(&mut HostCx<'_>) -> R) -> R {
+    scoped(cx, |cx| cx.state.log, |cx, snapshot| cx.state.log = snapshot, body)
+}
+
+/// The scopes and the catch of host lowering, nested.
+pub fn host_scenario(
+    checked: &u32,
+    state: &mut Session,
+    runtime: &mut LoweringRuntime,
+    native: &mut u64,
+) -> Result<u32, u32> {
+    let mut cx = HostCx {
+        checked,
+        state,
+        runtime,
+        native,
+    };
+    let r = with_invocation(&mut cx, |cx| {
+        cx.state.invocation = cx.state.invocation.wrapping_add(*cx.checked);
+        with_probe(cx, |cx| {
+            cx.state.log = cx.state.log.wrapping_mul(3);
+            *cx.native = cx.native.wrapping_add(1);
+            cx.catch_invocation()
+        })
+    });
+    cx.state.log = cx.state.log.wrapping_add(1);
+    r
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn struct_state_threads_both_borrows() {
+        let (mut a, mut b) = (4, 3);
+        assert_eq!(struct_state(&mut a, &mut b), 12);
+        assert_eq!((a, b), (5, 10));
+        let (mut a, mut b) = (u32::MAX, u64::MAX);
+        assert_eq!(struct_state(&mut a, &mut b), u64::MAX);
+        assert_eq!((a, b), (0, 4294967293));
+    }
+
+    #[test]
+    fn tuple_state_threads_both_borrows() {
+        let (mut a, mut b) = (4, 3);
+        assert_eq!(tuple_state(&mut a, &mut b), 14);
+        assert_eq!((a, b), (14, 16));
+        let (mut a, mut b) = (u32::MAX, 1);
+        assert_eq!(tuple_state(&mut a, &mut b), 4);
+        assert_eq!((a, b), (4, 5));
+    }
+
+    #[test]
+    fn host_scenario_restores_the_session() {
+        let mut runtime = LoweringRuntime::for_test();
+        let mut state = Session { invocation: 9, log: 4 };
+        let mut native = 10;
+        assert_eq!(host_scenario(&3, &mut state, &mut runtime, &mut native), Ok(3));
+        assert_eq!((state.invocation, state.log, native), (9, 5, 14));
+        let mut state = Session { invocation: 9, log: 4 };
+        let mut native = 10;
+        assert_eq!(host_scenario(&6, &mut state, &mut runtime, &mut native), Err(7));
+        assert_eq!((state.invocation, state.log, native), (9, 5, 17));
+    }
+}
