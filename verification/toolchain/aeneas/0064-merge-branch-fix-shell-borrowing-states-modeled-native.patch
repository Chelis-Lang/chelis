diff --git a/src/symbolic/ModelStateABI.ml b/src/symbolic/ModelStateABI.ml
index f366856..990e113 100644
--- a/src/symbolic/ModelStateABI.ml
+++ b/src/symbolic/ModelStateABI.ml
@@ -399,6 +399,399 @@ let fun_instance_is_compatible (crate : A.crate) (decl : A.fun_decl)
   && List.length params.types = List.length decl.generics.types
   && not !visible
 
+(** {1 Modeled functions at borrowing states}
+
+    A modeled function which threads a state [S] through closures, such as
+    [scoped<S, T, R>(state: &mut S, enter: impl FnOnce(&mut S) -> T, ..)], has
+    a model parametric in [S]. Its partial-monomorphization instance at a state
+    holding mutable borrows (e.g. [scoped::<'0, HostCx<'1>, ..>]) has one more
+    backward function per inner region (['1]): given the values the caller
+    gives back to the borrows of the returned state, the values of the borrows
+    of the lent state. The function lends the state to the closures one call
+    after the other, so this backward function is the composition of those of
+    the closure calls, the last call's first. The instance is translated to the
+    model at the state [S × K], where [K] holds these backward functions and
+    every closure dictionary composes the backward functions of its call with
+    [K] (the [thread] helpers of the Lean library, e.g.
+    [core.ops.function.FnOnceMutArg.thread]), starting from the identities.
+
+    This relies on the function reaching the state only by lending it to the
+    closures of its bounds, which parametricity guarantees for its model and
+    which is checked on the instance: the regions of the state type occur only
+    in the state input [&'r mut S] and in the borrowed arguments of the closure
+    bounds ([FnOnce] specializations of a model schema), the state type is the
+    instantiation of one type parameter, and the Lean layouts of the instance
+    and of the closure specializations are those of the model at [S × K] (see
+    [threaded_fun_body]). Every other instance stays an unknown external. *)
+
+(** The model schema of a closure bound which borrows the state [S]:
+    [FnOnce<(&mut S,)>] ([FnOnceMutArg]), [FnOnce<(&mut S, U)>]
+    ([FnOnceMutArgPair]) or [FnOnce<(&mut T, &mut S)>]
+    ([FnOnceMutArgMutArg]). *)
+type thread_kind = MutArg | MutArgPair | MutArgMutArgSnd
+
+(** The Lean helper which threads the backward functions of the inner regions
+    of the state through a closure dictionary of this schema. *)
+let thread_helper_name = function
+  | MutArg -> "_root_.Aeneas.Std.core.ops.function.FnOnceMutArg.thread"
+  | MutArgPair -> "_root_.Aeneas.Std.core.ops.function.FnOnceMutArgPair.thread"
+  | MutArgMutArgSnd ->
+      "_root_.Aeneas.Std.core.ops.function.FnOnceMutArgMutArg.threadSnd"
+
+type threaded_instance = {
+  model : string;  (** The model's Lean name *)
+  state : int;  (** The index of the state input [&'r mut S] *)
+  state_region : T.RegionId.id;  (** ['r] *)
+  inner : T.RegionId.Set.t;  (** The regions of [S] *)
+  dictionaries : (T.trait_clause_id * thread_kind) list;
+      (** The closure bounds which borrow the state (their [call_once] is
+          threaded) *)
+}
+
+(** Collects the free regions of a type or trait parameter (the regions bound
+    inside it are not free). *)
+let free_regions_visitor =
+  object
+    inherit [_] T.iter_ty
+
+    method! visit_region acc r =
+      match r with
+      | T.RVar (T.Free id) -> acc := T.RegionId.Set.add id !acc
+      | _ -> ()
+  end
+
+let ty_free_regions (ty : T.ty) =
+  let acc = ref T.RegionId.Set.empty in
+  free_regions_visitor#visit_ty acc ty;
+  !acc
+
+let trait_param_free_regions (c : T.trait_param) =
+  let acc = ref T.RegionId.Set.empty in
+  free_regions_visitor#visit_trait_param acc c;
+  !acc
+
+(** The model schema of a closure [FnOnce<Args>] specialization whose
+    arguments borrow the state [state] mutably, if there is one. *)
+let thread_kind inner state (args : T.ty) =
+  let outside ty = T.RegionId.Set.disjoint inner (ty_free_regions ty) in
+  match args with
+  | T.TAdt { id = T.TTuple; generics = { types; _ } } -> (
+      match types with
+      | [ T.TRef (_, t, T.RMut) ] when t = state -> Some MutArg
+      | [ T.TRef (_, t, T.RMut); u ] when t = state && outside u -> (
+          match u with
+          | T.TRef (_, _, T.RMut) -> None
+          | _ -> Some MutArgPair)
+      | [ T.TRef (_, a, T.RMut); T.TRef (_, t, T.RMut) ]
+        when t = state && outside a -> Some MutArgMutArgSnd
+      | _ -> None)
+  | _ -> None
+
+(** Whether a partial-monomorphization instance of a modeled function (see
+    [fun_instance_is_compatible]) threads a borrowing state through the model
+    (see [threaded_instance]). Only the instance's LLBC signature is checked
+    here; [threaded_fun_body] checks its Lean layout. *)
+let threaded_fun_instance (crate : A.crate) (decl : A.fun_decl)
+    (info : builtin_fun_info) (shape : T.generic_args T.binder) :
+    threaded_instance option =
+  let span = Some decl.item_meta.span in
+  let has_body =
+    match decl.body with
+    | A.StructuredBody _ -> true
+    | _ -> false
+  in
+  (* The shape's arguments in terms of the instance's parameters *)
+  let args =
+    Substitute.apply_args_to_binder
+      (Charon.TypesUtils.generic_args_of_params span decl.generics)
+      Substitute.generic_args_substitute shape
+  in
+  let borrowing =
+    List.filter
+      (fun ty -> not (T.RegionId.Set.is_empty (ty_free_regions ty)))
+      args.types
+  in
+  match borrowing with
+  | [ state ]
+    when (not has_body)
+         && Option.is_none (modeled_fun_abi crate decl info)
+         && List.length shape.binder_params.regions
+            = List.length decl.generics.regions
+         && List.length shape.binder_params.types
+            = List.length decl.generics.types -> (
+      let inner = ty_free_regions state in
+      let mentions ty =
+        not (T.RegionId.Set.disjoint inner (ty_free_regions ty))
+      in
+      let inputs =
+        List.filter
+          (fun (_, ty) -> mentions ty)
+          (List.mapi (fun i ty -> (i, ty)) decl.signature.inputs)
+      in
+      match inputs with
+      | [ (index, T.TRef (T.RVar (T.Free r), s, T.RMut)) ]
+        when s = state
+             && (not (T.RegionId.Set.mem r inner))
+             && not (mentions decl.signature.output) -> (
+          (* The closure bounds which borrow the state *)
+          let clause (c : T.trait_param) =
+            if T.RegionId.Set.disjoint inner (trait_param_free_regions c) then
+              Some None
+            else
+              let tr = c.trait.binder_value in
+              let tdecl = T.TraitDeclId.Map.find tr.id crate.trait_decls in
+              let name, args =
+                NameMatcher.instantiate_name_generics tdecl.item_meta.name
+                  tr.generics
+              in
+              let path =
+                List.map
+                  (function
+                    | T.PeIdent (id, _) -> Some id
+                    | _ -> None)
+                  name
+              in
+              match (path, List.rev tdecl.item_meta.name, args.types) with
+              | ( [ Some "core"; Some "ops"; Some "function"; Some "FnOnce" ],
+                  T.PeInstantiated _ :: _,
+                  [ self; call_args; output ] )
+                when (not (mentions self)) && not (mentions output) ->
+                  Option.map
+                    (fun kind -> Some (c.clause_id, kind))
+                    (thread_kind inner state call_args)
+              | _ -> None
+          in
+          let clauses = List.map clause decl.generics.trait_clauses in
+          if List.exists Option.is_none clauses then None
+          else
+            Some
+              {
+                model = info.extract_name;
+                state = index;
+                state_region = r;
+                inner;
+                dictionaries = List.filter_map Option.join clauses;
+              })
+      | _ -> None)
+  | _ -> None
+
+(** The partial-monomorphization instance of a modeled function at a borrowing
+    state that a declaration is, if it is one (and not an instance admitted with
+    the ABI of its model, see [fun_instance_is_compatible]). *)
+let threaded_instance_of_decl (crate : A.crate) (decl : A.fun_decl) =
+  if Config.backend () <> Config.Lean then None
+  else
+    match List.rev decl.item_meta.name with
+    | T.PeInstantiated shape :: _
+      when not
+             (A.FunDeclId.Set.mem decl.def_id
+                !ExtractBuiltin.admitted_fun_instances) -> (
+        match
+          ExtractBuiltin.find_generic_fun_info
+            (NameMatcher.ctx_from_crate crate)
+            decl.item_meta.name
+        with
+        | Some info -> threaded_fun_instance crate decl info shape
+        | None -> None)
+    | _ -> None
+
+(** The body of a partial-monomorphization instance of a modeled function at a
+    borrowing state (see [threaded_instance]): the model at the state [S × K],
+    where [K] holds the backward functions of the inner regions of the state,
+    starting from their identities. Its forward output ends with the state
+    given back at ['r] followed by these backward functions, so the model's
+    result at [S × K] is the instance's. Checks this layout (each backward
+    function of an inner region must be a total endomorphism of the values of
+    its borrows, and no other region may give back after ['r]), and that the
+    call of every threaded closure specialization has the layout of its model
+    schema at [S × K] (the same state [S] and backward functions [K], after
+    the other results). Raises otherwise: the instance then stays an unknown
+    external. *)
+let threaded_fun_body (span : Meta.span) (ctx : Contexts.decls_ctx)
+    (fresh : string option -> ty -> fvar) (decl : A.fun_decl)
+    (dsg : decomposed_fun_sig) (sg : fun_sig) (inst : threaded_instance) :
+    fun_body =
+  let fun_ty = dsg.fun_ty in
+  [%cassert] span
+    (fun_ty.state_outputs = []
+    && fun_ty.fwd_info.effect_info.can_fail
+    && (not fun_ty.fwd_info.ignore_output)
+    && List.length fun_ty.fwd_inputs = List.length decl.signature.inputs)
+    "Model at a borrowing state: unsupported forward signature";
+  let state_ty = List.nth fun_ty.fwd_inputs inst.state in
+  (* The region groups of the instance: those of the state's inner regions
+     come last, after the group of ['r] *)
+  let groups =
+    RegionsHierarchy.compute_regions_hierarchy_for_sig (Some span) ctx.crate
+      { item_binder_params = decl.generics; item_binder_value = decl.signature }
+  in
+  let is_inner gid =
+    let g = List.find (fun (g : T.region_var_group) -> g.id = gid) groups in
+    let regions = T.RegionId.Set.of_list g.regions in
+    if T.RegionId.Set.subset regions inst.inner then true
+    else if T.RegionId.Set.disjoint regions inst.inner then false
+    else
+      [%craise] span
+        "Model at a borrowing state: a region group mixes regions of the \
+         state with other regions"
+  in
+  let backs =
+    List.combine
+      (T.RegionGroupId.Map.bindings fun_ty.back_sg)
+      (compute_back_tys_with_info fun_ty)
+  in
+  let outer, inner =
+    List.partition (fun ((gid, _), _) -> not (is_inner gid)) backs
+  in
+  let ids = List.map (fun ((gid, _), _) -> gid) in
+  [%cassert] span
+    (inner <> [] && ids backs = ids (outer @ inner))
+    "Model at a borrowing state: the regions of the state do not come last";
+  let ks =
+    List.map
+      (fun ((_, (back : back_sg_info)), ty) ->
+        match ty with
+        | Some (_, (TArrow (v, v') as k)) when v = v' && back.early = [] ->
+            (v, k)
+        | _ ->
+            [%craise] span
+              "Model at a borrowing state: the backward function of an inner \
+               region of the state is not a total endomorphism of the values \
+               of its borrows")
+      inner
+  in
+  (match List.rev (List.filter (fun (_, ty) -> Option.is_some ty) outer) with
+  | ((gid, _), Some (_, ty)) :: _ ->
+      let g = List.find (fun (g : T.region_var_group) -> g.id = gid) groups in
+      [%cassert] span
+        (List.mem inst.state_region g.regions && ty = state_ty)
+        "Model at a borrowing state: the state is not the last value given \
+         back before the backward functions of its inner regions"
+  | _ ->
+      [%craise] span
+        "Model at a borrowing state: the state is not given back by the \
+         instance");
+  (* The closure specializations: the model's dictionary at [S × K] *)
+  let k_tys = List.map snd ks in
+  List.iter
+    (fun (clause_id, kind) ->
+      let c =
+        List.find
+          (fun (c : T.trait_param) -> c.clause_id = clause_id)
+          decl.generics.trait_clauses
+      in
+      let tdecl =
+        T.TraitDeclId.Map.find c.trait.binder_value.id ctx.crate.trait_decls
+      in
+      let method_id =
+        match
+          List.find_opt
+            (fun (m : A.trait_method T.binder) ->
+              m.binder_value.name = "call_once")
+            tdecl.methods
+        with
+        | Some m -> m.binder_value.item.id
+        | None ->
+            [%craise] span
+              "Model at a borrowing state: a closure bound has no call_once"
+      in
+      let tr : T.trait_ref =
+        { kind = T.Clause (T.Free clause_id); trait_decl_ref = c.trait }
+      in
+      let inputs, output =
+        translate_fn_item_sig (Some span) ctx
+          {
+            kind = T.TraitMethod (tr, "call_once", method_id);
+            generics = TypesUtils.empty_generic_args;
+          }
+      in
+      let returned =
+        match output with
+        | TAdt
+            (TBuiltin TResult, { types = [ TAdt (TTuple, { types; _ }) ]; _ })
+          -> Some types
+        | _ -> None
+      in
