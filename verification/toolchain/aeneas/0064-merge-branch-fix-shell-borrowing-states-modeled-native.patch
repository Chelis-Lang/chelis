diff --git a/backends/lean/Aeneas/Std/Core/Ops.lean b/backends/lean/Aeneas/Std/Core/Ops.lean
index 174b6de..a6bbc3a 100644
--- a/backends/lean/Aeneas/Std/Core/Ops.lean
+++ b/backends/lean/Aeneas/Std/Core/Ops.lean
@@ -79,6 +79,63 @@ structure core.ops.function.FnOnceMutArgMutArg (Self : Type u) (T : Type v) (U :
     (Output : Type x) where
   call_once : Self → (T × U) → Result (Output × T × U)
 
+/-! ### Closure specializations at borrowing states
+
+A partial-monomorphization instance of a modeled function which threads a state
+`S` through closures (e.g. `scoped::<HostCx<'a>, ..>`, whose state holds mutable
+borrows) receives closure specializations such as `FnOnce<(&'b mut HostCx<'a>,)>`
+whose call also returns `k : K`, the backward function of the inner borrows of
+the state: given the values the caller gives back to the borrows of the returned
+state, the values of the borrows of the lent state. A model is parametric in its
+state, so the instance runs it at the state `S × K`: `thread` turns such a
+closure into a dictionary of the model which composes the backward functions of
+successive calls (`BackCompose.comp k b` applies `b`, the backward function of
+the call, then `k`, that of the calls before). The instance starts from
+`BackCompose.id` and returns the final state and its backward function. -/
+
+/-- The backward functions of the inner borrows of a state: one function per
+    region, composed call after call. -/
+class BackCompose (K : Type u) where
+  id : K
+  comp : K → K → K
+
+instance BackCompose.fn {A : Type u} : BackCompose (A → A) where
+  id := fun a => a
+  comp k b := fun a => k (b a)
+
+instance BackCompose.prod {A B : Type u} [BackCompose A] [BackCompose B] :
+    BackCompose (A × B) where
+  id := (BackCompose.id, BackCompose.id)
+  comp k b := (BackCompose.comp k.1 b.1, BackCompose.comp k.2 b.2)
+
+/-- A closure `FnOnce<(&'a mut T,)>` at a borrowing state `T` as a dictionary of
+    the model at the state `T × K`. -/
+def core.ops.function.FnOnceMutArg.thread {Self : Type u} {T K : Type v} {Output : Type w}
+    [BackCompose K] (call : Self → T → Result (Output × T × K)) :
+    core.ops.function.FnOnceMutArg Self (T × K) Output where
+  call_once f s := do
+    let (o, t, b) ← call f s.1
+    .ok (o, t, BackCompose.comp s.2 b)
+
+/-- A closure `FnOnce<(&'a mut T, U)>` at a borrowing state `T` as a dictionary
+    of the model at the state `T × K`. -/
+def core.ops.function.FnOnceMutArgPair.thread {Self : Type u} {T K : Type v} {U : Type w}
+    {Output : Type x} [BackCompose K] (call : Self → (T × U) → Result (Output × T × K)) :
+    core.ops.function.FnOnceMutArgPair Self (T × K) U Output where
+  call_once f a := do
+    let (o, t, b) ← call f (a.1.1, a.2)
+    .ok (o, t, BackCompose.comp a.1.2 b)
+
+/-- A closure `FnOnce<(&'a mut T, &'b mut U)>` at a borrowing state `U` (the
+    second argument) as a dictionary of the model at the state `U × K`. -/
+def core.ops.function.FnOnceMutArgMutArg.threadSnd {Self : Type u} {T : Type v}
+    {U K : Type w} {Output : Type x} [BackCompose K]
+    (call : Self → (T × U) → Result (Output × T × U × K)) :
+    core.ops.function.FnOnceMutArgMutArg Self T (U × K) Output where
+  call_once f a := do
+    let (o, t, u, b) ← call f (a.1, a.2.1)
+    .ok (o, t, u, BackCompose.comp a.2.2 b)
+
 @[rust_trait "core::ops::function::FnMut" (parentClauses := ["FnOnceInst"])]
 structure core.ops.function.FnMut (Self : Type u) (Args : Type v) (Output : Type w) where
   FnOnceInst : core.ops.function.FnOnce Self Args Output
