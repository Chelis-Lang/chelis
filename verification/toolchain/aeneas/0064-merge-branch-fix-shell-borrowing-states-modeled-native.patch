+            Some (_ :: s' :: ks) ) -> s = state_ty && s' = s && ks = k_tys
+        | ( MutArgMutArgSnd,
+            [ _; TAdt (TTuple, { types = [ a; s ]; _ }) ],
+            Some (_ :: a' :: s' :: ks) ) ->
+            a' = a && s = state_ty && s' = s && ks = k_tys
+        | _ -> false
+      in
+      [%cassert] span expected
+        "Model at a borrowing state: a closure bound does not give back the \
+         state and the backward functions of its inner regions like the \
+         instance")
