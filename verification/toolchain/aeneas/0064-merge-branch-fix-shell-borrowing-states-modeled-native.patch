+import ShellBorrowingStates.ChelisIr
+
+/-! Evaluate the models of `tests/src/chelis_ir.rs` on the inputs of its
+    `native` test module and compare with the native results. -/
+
+namespace chelis_ir.checks
+open Aeneas Aeneas.Std Result
+
+def u (n : Nat) : U32 := ⟨BitVec.ofNat _ n⟩
+def w (n : Nat) : U64 := ⟨BitVec.ofNat _ n⟩
+
+/-- The result and the final values of both borrowed arguments. -/
+def res {α : Type} (f : α → Nat) (r : Result (α × U32 × U64)) : Option (Nat × Nat × Nat) :=
+  match r with
+  | ok (v, a, b) => some (f v, a.val, b.val)
+  | _ => none
+
+#guard res (·.val) (struct_state (u 4) (w 3)) == some (12, 5, 10)
+#guard res (·.val) (struct_state (u 4294967295) (w 18446744073709551615)) ==
+  some (18446744073709551615, 0, 4294967293)
+
+#guard res (·.val) (tuple_state (u 4) (w 3)) == some (14, 14, 16)
+#guard res (·.val) (tuple_state (u 4294967295) (w 1)) == some (4, 4, 5)
+
+/-- A lowering runtime in its initial state. -/
+def runtime : _root_.Aeneas.Std.chelis_ir.lowering_runtime.LoweringRuntime :=
+  { u := false, o := false, hook := [], builds := 0#u64, nextPreflightFrame := 0#u64,
+    hostVar := fun _ => 0#u32, hostVarsTaken := 0, profileEnv := fun _ => false,
+    profileEnvReads := 0, profileMarks := 0#usize }
+
+/-- The result (`true` for `Ok`), the final session, the quiet-output flag of the
+    runtime and the final native state. -/
+def host (checked invocation log native : Nat) :
+    Option ((Bool × Nat) × Nat × Nat × Bool × Nat) :=
+  match host_scenario (u checked) { invocation := u invocation, log := w log } runtime
+      (w native) with
+  | ok (r, s, rt, n) =>
+    let r := match r with
+      | .Ok v => (true, v.val)
+      | .Err e => (false, e.val)
+    some (r, s.invocation.val, s.log.val, rt.o, n.val)
+  | _ => none
+
+#guard host 3 9 4 10 == some ((true, 3), 9, 5, false, 14)
+#guard host 6 9 4 10 == some ((false, 7), 9, 5, false, 17)
+
+end chelis_ir.checks
