+  let inputs =
+    List.mapi
+      (fun i ty -> fresh (if i = inst.state then Some "state" else None) ty)
+      fun_ty.fwd_inputs
+  in
+  let identity (v, _) =
+    let x = fresh (Some "x") v in
+    mk_closed_lambdas span [ mk_tpat_from_fvar None x ] (mk_texpr_from_fvar x)
+  in
+  let initial =
+    mk_simpl_tuple_texpr span
+      [
+        mk_texpr_from_fvar (List.nth inputs inst.state);
+        mk_simpl_tuple_texpr span (List.map identity ks);
+      ]
+  in
+  let args =
+    List.mapi
+      (fun i x -> if i = inst.state then initial else mk_texpr_from_fvar x)
+      inputs
+  in
+  [%cassert] span
+    (List.for_all
+       (fun (id, _) ->
+         List.exists
+           (fun (c : trait_param) -> c.clause_id = id)
+           sg.generics.trait_clauses)
+       inst.dictionaries)
+    "Model at a borrowing state: a threaded closure bound is not a parameter";
+  let dictionaries =
+    List.map
+      (fun (c : trait_param) ->
+        Option.map
+          (fun kind -> (thread_helper_name kind, "call_once"))
+          (List.assoc_opt c.clause_id inst.dictionaries))
+      sg.generics.trait_clauses
+  in
+  let generics =
+    {
+      types = [];
+      const_generics = [];
+      trait_refs = (generic_args_of_params sg.generics).trait_refs;
+    }
+  in
+  let func =
+    {
+      e =
+        Qualif
+          {
+            id =
+              FunOrOp
+                (Fun
+                   (Pure (ThreadedModel { model = inst.model; dictionaries })));
+            generics;
+          };
+      ty = mk_arrows (List.map (fun (arg : texpr) -> arg.ty) args) sg.output;
+    }
+  in
+  let body = [%add_loc] mk_apps span func args in
+  mk_closed_fun_body span (List.map (mk_tpat_from_fvar None) inputs) body
