+namespace collect_user_iterator.checks
+open Aeneas Aeneas.Std Result
+def u (x : Nat) : U32 := ⟨BitVec.ofNat _ x⟩
+def vec {α} (xs : List α) (h : xs.length ≤ Usize.max := by scalar_tac) : alloc.vec.Vec α := ⟨xs, h⟩
+def sl {α} (xs : List α) (h : xs.length ≤ Usize.max := by scalar_tac) : Slice α := ⟨xs, h⟩
+def block (targets : List Nat) (fixed : Bool) (h : targets.length ≤ Usize.max := by scalar_tac) :
+    Block := ⟨⟨targets.map u, by simpa using h⟩, fixed⟩
+def nats (r : Result (alloc.vec.Vec U32)) : Option (List Nat) :=
+  match r with | ok v => some (v.val.map (·.val)) | _ => none
+#guard nats (successors_of (block [4, 5, 6] true)) == some [4, 5]
+#guard nats (successors_of (block [4, 5, 6] false)) == some [4, 5, 6]
+#guard nats (successors_of (block [] true)) == some []
