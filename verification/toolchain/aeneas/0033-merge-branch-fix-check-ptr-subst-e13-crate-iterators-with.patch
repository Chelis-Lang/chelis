+  == some [1, 2, 7, 8]
+#guard nats (all_successors (sl [])) == some []
+def arms : Slice (alloc.vec.Vec U32) := sl [vec [u 10, u 11], vec [], vec [u 12]]
+#guard nats (successor_arms (block [2, 0, 1] false) arms) == some [12, 10, 11]
+#guard nats (successor_arms (block [1, 2, 0] true) arms) == some [12]
