diff --git a/tests/src/collect-generic-closure.rs b/tests/src/collect-generic-closure.rs
new file mode 100644
index 0000000..7726121
--- /dev/null
+++ b/tests/src/collect-generic-closure.rs
@@ -0,0 +1,47 @@
+//@ [!lean] skip
+//@ [lean] subdir=CollectGenericClosure
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::iter::adapters::filter_map::FilterMap
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! A generic function collects through a closure that captures a value of its
+//! own type parameter. The `filter_map` call names the slice iterator's
+//! implementation, which binds no trait clauses, while its method arguments (the
+//! closure type) carry the caller's `T: Threshold` clause. CollectionContracts
+//! must instantiate the implementation before the method: substituting the
+//! implementation's parameters into the method arguments looked the caller's
+//! clause up among the implementation's (Not_found).
+//! CollectGenericClosure/Checks.lean compares the model with the native results
+//! asserted in the native test module.
+
+pub trait Threshold {
+    fn limit(&self) -> u32;
+}
+
+pub struct Fixed(pub u32);
+
+impl Threshold for Fixed {
+    fn limit(&self) -> u32 {
+        self.0
+    }
+}
+
+pub fn doubled_above<T: Threshold>(xs: &[u32], threshold: &T) -> Vec<u32> {
+    xs.iter()
+        .filter_map(|x| if *x > threshold.limit() { Some(*x * 2) } else { None })
+        .collect()
+}
+
+pub fn doubled_above_fixed(xs: &[u32], limit: u32) -> Vec<u32> {
+    doubled_above(xs, &Fixed(limit))
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn generic_closure_collect() {
+        assert_eq!(doubled_above_fixed(&[1, 5, 3, 7], 3), vec![10, 14]);
+        assert_eq!(doubled_above_fixed(&[1, 2], 9), Vec::<u32>::new());
+        assert_eq!(doubled_above_fixed(&[], 0), Vec::<u32>::new());
+    }
+}
