+//@ [!lean] skip
+//@ [lean] subdir=CollectUserIterator
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::iter::adapters::copied::Copied
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Collectors over a crate-local iterator that only defines `next`. Every
+//! other method, `size_hint` included, is the trait default, so every native
+//! consumer path is repeated `next` and `size_hint` is the total, pure
+//! `(0, None)`: CollectionContracts admits it directly, as the inner iterator
+//! of `flat_map`, and as its outer iterator.
+//! CollectUserIterator/Checks.lean compares the model with the native results
+//! asserted in the native test module.
+
+/// The successors of a block: at most two fixed targets, or every arm.
+pub enum Successors<E, A> {
+    Fixed { first: Option<E>, second: Option<E> },
+    Arms(A),
+}
+
+impl<E, A: Iterator<Item = E>> Iterator for Successors<E, A> {
+    type Item = E;
+
+    fn next(&mut self) -> Option<E> {
+        match self {
+            Successors::Fixed { first, second } => match first.take() {
+                Some(target) => Some(target),
+                None => second.take(),
+            },
+            Successors::Arms(arms) => arms.next(),
+        }
+    }
+}
+
+pub struct Block {
+    pub targets: Vec<u32>,
+    pub fixed: bool,
+}
+
+impl Block {
+    pub fn successors(&self) -> Successors<&u32, std::slice::Iter<'_, u32>> {
+        if self.fixed {
+            Successors::Fixed { first: self.targets.first(), second: self.targets.get(1) }
+        } else {
+            Successors::Arms(self.targets.iter())
+        }
+    }
+}
+
+pub fn successors_of(block: &Block) -> Vec<u32> {
+    block.successors().copied().collect()
+}
+
+pub fn all_successors(blocks: &[Block]) -> Vec<u32> {
+    blocks.iter().flat_map(|block| block.successors()).copied().collect()
+}
+
+pub fn successor_arms(block: &Block, arms: &[Vec<u32>]) -> Vec<u32> {
+    block.successors().flat_map(|target| &arms[*target as usize]).copied().collect()
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    fn block(targets: &[u32], fixed: bool) -> Block {
+        Block { targets: targets.to_vec(), fixed }
+    }
+
+    #[test]
+    fn user_iterator_collect() {
+        assert_eq!(successors_of(&block(&[4, 5, 6], true)), vec![4, 5]);
+        assert_eq!(successors_of(&block(&[4, 5, 6], false)), vec![4, 5, 6]);
+        assert_eq!(successors_of(&block(&[], true)), Vec::<u32>::new());
+        assert_eq!(
+            all_successors(&[block(&[1, 2, 3], true), block(&[], false), block(&[7, 8], false)]),
+            vec![1, 2, 7, 8]
+        );
+        assert_eq!(all_successors(&[]), Vec::<u32>::new());
+        let arms = vec![vec![10, 11], vec![], vec![12]];
+        assert_eq!(successor_arms(&block(&[2, 0, 1], false), &arms), vec![12, 10, 11]);
+        assert_eq!(successor_arms(&block(&[1, 2, 0], true), &arms), vec![12]);
+    }
+}
