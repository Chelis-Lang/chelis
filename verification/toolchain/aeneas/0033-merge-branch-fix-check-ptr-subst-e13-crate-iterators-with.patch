+//@ [lean] known-failure
+//@ [!lean] skip
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! A crate-local iterator that overrides `size_hint`, here with an inexact
+//! upper bound. The native collectors call it at capacity and specialization
+//! points, and CollectionContracts does not check its lawfulness, so it
+//! rejects the collection (E_UNSUPPORTED_COLLECTION) rather than admit the
+//! next-driven model.
+
+pub struct Countdown(pub u32);
+
+impl Iterator for Countdown {
+    type Item = u32;
+
+    fn next(&mut self) -> Option<u32> {
+        if self.0 == 0 {
+            None
+        } else {
+            self.0 -= 1;
+            Some(self.0)
+        }
+    }
+
+    /// Claims at most one remaining item.
+    fn size_hint(&self) -> (usize, Option<usize>) {
+        (0, Some(1))
+    }
+}
+
+pub fn countdowns(n: u32) -> Vec<u32> {
+    Countdown(n).flat_map(Countdown).collect()
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn inexact_hint() {
+        assert_eq!(Countdown(3).size_hint(), (0, Some(1)));
+        assert_eq!(Countdown(3).count(), 3);
+        assert_eq!(countdowns(3), vec![1, 0, 0]);
+    }
+}
