+(** Like [extract_file], but write the definitions to a chain of modules
+    [part 1], [part 2], ... each importing its predecessor (the first one
+    imports [fi]'s includes). A new module starts at a declaration-group
+    boundary once the current one holds more than [chunk_bytes] bytes, so no
+    group is split and every module only depends on earlier ones. Finally
+    [fi.filename] is written as a module that imports the last part, so the
+    importers of [fi.module_name] are unaffected. *)
+let extract_file_chunked (config : gen_config) (ctx : gen_ctx)
+    (fi : extract_file_info) ~(chunk_bytes : int)
+    ~(part : int -> string * string) : unit =
+  let current : out_channel option ref = ref None in
+  let current_info : extract_file_info option ref = ref None in
+  let written = ref 0 in
+  let index = ref 0 in
+  let output s pos len =
+    match !current with
+    | Some out ->
+        output_substring out s pos len;
+        written := !written + len
+    | None -> [%craise_opt_span] None "chunked extraction: no open module"
+  in
+  let flush () = Option.iter flush !current in
+  let fmt = Format.make_formatter output flush in
+  Format.pp_set_margin fmt 80;
+  (* Every part holds one top-level vertical box that is closed (by a flush)
+     at each declaration-group boundary and reopened afterwards. *)
+  let open_part () =
+    incr index;
+    let filename, module_name = part !index in
+    let custom_includes =
+      if !index = 1 then fi.custom_includes else [ snd (part (!index - 1)) ]
+    in
+    let info = { fi with filename; module_name; custom_includes } in
+    let out = open_out filename in
+    write_file_header out info;
+    current := Some out;
+    current_info := Some info;
+    written := 0
+  in
+  (* Requires the formatter to be flushed. *)
+  let finish_part () =
+    match (!current, !current_info) with
+    | Some out, Some info ->
+        write_file_footer out info;
+        log_generated info.filename;
+        close_out out;
+        current := None;
+        current_info := None
+    | _ -> [%craise_opt_span] None "chunked extraction: no open module"
+  in
+  open_part ();
+  Format.pp_open_vbox fmt 0;
+  let on_group_done () =
+    (* The pending formatter content belongs to the group just exported. *)
+    Format.pp_print_flush fmt ();
+    if !written > chunk_bytes then (
+      finish_part ();
+      open_part ());
+    Format.pp_open_vbox fmt 0
+  in
+  extract_definitions ~on_group_done fmt config ctx;
+  Format.pp_close_box fmt ();
+  Format.pp_print_newline fmt ();
+  Format.pp_print_flush fmt ();
+  finish_part ();
+  (* The entry module only re-exports the last part. *)
+  let out = open_out fi.filename in
+  write_file_header out
+    {
+      fi with
+      custom_includes = [ snd (part !index) ];
+      in_namespace = false;
+      open_namespace = false;
+      noncomputable = false;
+    };
+  log_generated fi.filename;
+  close_out out
+
