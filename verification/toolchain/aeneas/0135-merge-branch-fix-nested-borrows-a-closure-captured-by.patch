diff --git a/tests/src/nested-borrows-closure-shared-closure.rs b/tests/src/nested-borrows-closure-shared-closure.rs
new file mode 100644
index 0000000..a5a878c
--- /dev/null
+++ b/tests/src/nested-borrows-closure-shared-closure.rs
@@ -0,0 +1,219 @@
+//@ [!lean] skip
+//@ [lean] subdir=NestedBorrowsClosureSharedClosure
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::result::{core::result::Result}
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! The recursive visit of `Metadata::visit_expressions` (chelis_deep
+//! `annotations.rs`, called by chelis_ir `visit_semantic_expr_children` for
+//! `analyze_tensor_helper_preflight_scoped`) with a visiting closure which
+//! captures, by shared reference, another closure (`merge_child`) which
+//! captures a shared reference (`summaries`), besides mutable borrows of the
+//! caller.
+//!
+//! At the end of an iteration of the inner loop, after the recursive call, the
+//! abstraction of the region of the shared reference to `merge_child` holds the
+//! shared loan of the closure given back by the call, whose payload holds the
+//! shared borrow of `summaries`. Merged with the loop abstraction, whose
+//! borrows of that loan cancel out, the loan has no borrower left and its
+//! payload holds only shared borrows (dead): it cancels out with the pending
+//! loans of the reborrow of the visiting closure, like a payload without
+//! borrows, which releases the loan of `summaries` in turn (behind an ignored
+//! shared loan, which keeps its type in the merge). The loop abstraction then
+//! holds the reference to `merge_child` as a snapshot, which the body expanded
+//! (reference, then closure): after the loop, the closure is rebuilt from its
+//! field.
+//!
+//! `analyze` itself is not recursive: the Lean monotonicity proof of a
+//! `partial_fixpoint` recursive through the closure passed to
+//! `visit_expressions` is a separate issue.
+
+use std::convert::Infallible;
+
+pub enum Expr {
+    Atom(u32),
+    Map(Box<Metadata>),
+}
+
+pub enum Member {
+    Resource(Metadata),
+    Other,
+}
+
+pub enum MetadataValue {
+    Type(Expr),
+    Eff(Metadata, Vec<Member>),
+}
+
+pub struct Metadata {
+    pub values: Vec<MetadataValue>,
+}
+
+impl Metadata {
+    pub fn visit_expressions<'a>(&'a self, visit: &mut impl FnMut(&'a Expr, u8)) {
+        for value in self.values.iter() {
+            match value {
+                MetadataValue::Type(v) => visit(v, 0),
+                MetadataValue::Eff(m, members) => {
+                    m.visit_expressions(visit);
+                    for member in members.iter() {
+                        if let Member::Resource(v) = member {
+                            v.visit_expressions(visit);
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
+
+fn visit_children<E>(expr: &Expr, mut visit: impl FnMut(&Expr) -> Result<(), E>) -> Result<(), E> {
+    match expr {
+        Expr::Atom(_) => {}
+        Expr::Map(map) => {
+            let mut outcome = Ok(());
+            map.visit_expressions(&mut |value, _| {
+                if outcome.is_ok() {
+                    outcome = visit(value);
+                }
+            });
+            outcome?;
+        }
+    }
+    Ok(())
+}
+
+pub struct Out {
+    pub facts: Vec<bool>,
+    pub nodes: u32,
+}
+
+/// Whether `expr` is an atom in `summaries`
+fn leaf(expr: &Expr, summaries: &Vec<u32>) -> bool {
+    match expr {
+        Expr::Atom(n) => summaries.contains(n),
+        Expr::Map(_) => false,
+    }
+}
+
+/// Whether `expr` or one of its semantic children (`Metadata::visit_expressions`)
+/// is an atom in `summaries`; pushes the facts of every child to `out.facts`,
+/// then those of `expr`, and sums the node numbers into `out.nodes` (a child is
+/// numbered by the number of `expr` plus its index)
+pub fn analyze(expr: &Expr, node: usize, summaries: &Vec<u32>, out: &mut Out) -> bool {
+    let mut facts = leaf(expr, summaries);
+    let merge_child = |facts: &mut bool, child: &Expr, (parent, index): (usize, usize), out: &mut Out| {
+        let child_facts = leaf(child, summaries);
+        out.facts.push(child_facts);
+        out.nodes = out.nodes.wrapping_add((parent + index) as u32);
+        *facts |= child_facts;
+    };
+    let mut index = 0;
+    let Ok(()) = visit_children(expr, |child| -> Result<(), Infallible> {
+        merge_child(&mut facts, child, (node, index), out);
+        index += 1;
+        Ok(())
+    });
+    out.facts.push(facts);
+    out.nodes = out.nodes.wrapping_add(node as u32);
+    facts
+}
+
+fn atom(n: u32) -> Expr {
+    Expr::Atom(n)
+}
+
+fn map(m: Metadata) -> Expr {
+    Expr::Map(Box::new(m))
+}
+
+fn one(v: MetadataValue) -> Metadata {
+    let mut values = Vec::new();
+    values.push(v);
+    Metadata { values }
+}
+
+fn two(v: MetadataValue, w: MetadataValue) -> Metadata {
+    let mut values = Vec::new();
+    values.push(v);
+    values.push(w);
+    Metadata { values }
+}
+
+fn ty(e: Expr) -> MetadataValue {
+    MetadataValue::Type(e)
+}
+
+/// A tree over the atoms `a`, `b`, `c` of the given shape:
+/// - 0: `a`
+/// - 1: `{a, b}`
+/// - 2: `{eff {a} [resource {b}, other, resource {{c}}]}`
+/// - 3: `{{a}, eff {} [other], b, c}`
+fn tree(shape: u8, a: u32, b: u32, c: u32) -> Expr {
+    match shape {
+        0 => atom(a),
+        1 => map(two(ty(atom(a)), ty(atom(b)))),
+        2 => {
+            let mut members = Vec::new();
+            members.push(Member::Resource(one(ty(atom(b)))));
+            members.push(Member::Other);
+            members.push(Member::Resource(one(ty(map(one(ty(atom(c))))))));
+            map(one(MetadataValue::Eff(one(ty(atom(a))), members)))
+        }
+        _ => {
+            let mut members = Vec::new();
+            members.push(Member::Other);
+            let mut values = Vec::new();
+            values.push(ty(map(one(ty(atom(a))))));
+            values.push(MetadataValue::Eff(Metadata { values: Vec::new() }, members));
+            values.push(ty(atom(b)));
+            values.push(ty(atom(c)));
+            map(Metadata { values })
+        }
+    }
+}
+
+/// `(result, facts, mask, nodes)` of `analyze` on `tree(shape, a, b, c)` with
+/// the summaries `[s0, s1]`, from node `node`: `facts` is the number of facts
+/// pushed, `mask` their bits (the first one lowest), `nodes` the sum of the
+/// node numbers; the caller then pushes `true` through the borrow given back
+/// by the call (included in `facts` and `mask`)
+pub fn run_analyze(shape: u8, a: u32, b: u32, c: u32, s0: u32, s1: u32, node: usize) -> (bool, u32, u32, u32) {
+    let e = tree(shape, a, b, c);
+    let mut summaries = Vec::new();
+    summaries.push(s0);
+    summaries.push(s1);
+    let mut out = Out { facts: Vec::new(), nodes: 0 };
+    let r = {
+        let o = &mut out;
+        let r = analyze(&e, node, &summaries, o);
+        o.facts.push(true);
+        r
+    };
+    let mut mask = 0u32;
+    let mut bit = 1u32;
+    for f in out.facts.iter() {
+        if *f {
+            mask |= bit;
+        }
+        bit = bit.wrapping_mul(2);
+    }
+    (r, out.facts.len() as u32, mask, out.nodes)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn run_analyze_native() {
+        assert_eq!(run_analyze(0, 5, 0, 0, 5, 7, 3), (true, 2, 3, 3));
+        assert_eq!(run_analyze(0, 6, 0, 0, 5, 7, 3), (false, 2, 2, 3));
+        assert_eq!(run_analyze(1, 1, 2, 0, 2, 9, 0), (true, 4, 14, 1));
+        assert_eq!(run_analyze(1, 1, 2, 0, 8, 9, 4), (false, 4, 8, 13));
+        assert_eq!(run_analyze(2, 1, 2, 3, 3, 9, 0), (false, 5, 16, 3));
+        assert_eq!(run_analyze(2, 1, 2, 3, 2, 9, 10), (true, 5, 26, 43));
+        assert_eq!(run_analyze(2, 1, 2, 3, 7, 8, 1), (false, 5, 16, 7));
+        assert_eq!(run_analyze(3, 1, 2, 3, 1, 9, 0), (false, 5, 16, 3));
+        assert_eq!(run_analyze(3, 4, 5, 6, 6, 9, 2), (true, 5, 28, 11));
+        assert_eq!(run_analyze(3, 4, 5, 6, 7, 8, 5), (false, 5, 16, 23));
+    }
+}
