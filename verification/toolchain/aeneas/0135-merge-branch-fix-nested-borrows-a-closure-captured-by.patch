index 0000000..5892de6
--- /dev/null
+++ b/tests/src/nested-borrows-closure-visitor-calls.rs
@@ -0,0 +1,192 @@
+//@ [!lean] skip
+//@ [lean] subdir=NestedBorrowsClosureVisitorCalls
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::result::{core::result::Result}
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! The recursive visit of `Metadata::visit_expressions` (chelis_deep
+//! `annotations.rs`, called by chelis_ir `visit_semantic_expr_children` for
+//! `collect_dynamic_to_tensor_def_refs`), whose `Invariant` arm visits three
+//! metadata one after the other in an iteration of its loop, with the reborrows
+//! of the visiting closure (which captures a mutable borrow of the closure of
+//! the caller, which captures two mutable borrows of the caller).
+//!
+//! At the end of an iteration, the loop abstraction of the innermost regions
+//! has pending loans (the reborrow of the visiting closure ended, its inner
+//! borrows did not). Its continuation routes the value given back to the
+//! reborrow through the backward functions of the calls, from the last one,
+//! while its first stage routes the value given back to the parent borrows the
+//! other way: through the first stages of the loop abstraction of the next
+//! iteration and of the calls, from the first one.
+
+pub enum Expr {
+    Atom(u32),
+    Map(Box<Metadata>),
+}
+
+pub enum MetadataValue {
+    Type(Expr),
+    Pair(Metadata, Metadata),
+    Inv(Metadata, Metadata, Metadata, Expr),
+}
+
+pub struct Metadata {
+    pub values: Vec<MetadataValue>,
+}
+
+impl Metadata {
+    pub fn visit_expressions<'a>(&'a self, visit: &mut impl FnMut(&'a Expr, u8)) {
+        for value in self.values.iter() {
+            match value {
+                MetadataValue::Type(v) => visit(v, 0),
+                MetadataValue::Pair(m, p) => {
+                    m.visit_expressions(visit);
+                    p.visit_expressions(visit);
+                }
+                MetadataValue::Inv(m, p, b, body) => {
+                    m.visit_expressions(visit);
+                    p.visit_expressions(visit);
+                    b.visit_expressions(visit);
+                    visit(body, 1);
+                }
+            }
+        }
+    }
+}
+
+fn visit_children<E>(expr: &Expr, mut visit: impl FnMut(&Expr) -> Result<(), E>) -> Result<(), E> {
+    match expr {
+        Expr::Atom(_) => {}
+        Expr::Map(map) => {
+            let mut outcome = Ok(());
+            map.visit_expressions(&mut |value, _| {
+                if outcome.is_ok() {
+                    outcome = visit(value);
+                }
+            });
+            outcome?;
+        }
+    }
+    Ok(())
+}
+
+fn leaf(expr: &Expr) -> u32 {
+    match expr {
+        Expr::Atom(n) => *n,
+        Expr::Map(_) => 0,
+    }
+}
+
+/// Folds the atoms of the semantic children of `expr`, in the order of the
+/// visit, into `total` (`total * 3 + n`; a child which is not an atom counts
+/// as 0) and returns their number; stops at the first atom equal to `stop`
+/// (the error is the number of children folded before it)
+pub fn sum(expr: &Expr, stop: u32, total: &mut u32) -> Result<u32, u32> {
+    let mut count = 0u32;
+    visit_children(expr, |child| {
+        let n = leaf(child);
+        if n == stop {
+            return Err(count);
+        }
+        *total = total.wrapping_mul(3).wrapping_add(n);
+        count += 1;
+        Ok(())
+    })?;
+    Ok(count)
+}
+
+fn atom(n: u32) -> Expr {
+    Expr::Atom(n)
+}
+
+fn map(m: Metadata) -> Expr {
+    Expr::Map(Box::new(m))
+}
+
+fn none() -> Metadata {
+    Metadata { values: Vec::new() }
+}
+
+fn one(v: MetadataValue) -> Metadata {
+    let mut values = Vec::new();
+    values.push(v);
+    Metadata { values }
+}
+
+fn two(v: MetadataValue, w: MetadataValue) -> Metadata {
+    let mut values = Vec::new();
+    values.push(v);
+    values.push(w);
+    Metadata { values }
+}
+
+fn ty(e: Expr) -> MetadataValue {
+    MetadataValue::Type(e)
+}
+
+/// A tree over the atoms `a`, `b`, `c` of the given shape (children in the
+/// order of the visit):
+/// - 0: `a`
+/// - 1: `{pair {a} {b}, c}`
+/// - 2: `{inv {a} {pair {b} {}} {} c}`
+/// - 3: `{a, inv {b, {c}} {pair {c} {a}} {b} c, b}`
+fn tree(shape: u8, a: u32, b: u32, c: u32) -> Expr {
+    match shape {
+        0 => atom(a),
+        1 => map(two(MetadataValue::Pair(one(ty(atom(a))), one(ty(atom(b)))), ty(atom(c)))),
+        2 => map(one(MetadataValue::Inv(
+            one(ty(atom(a))),
+            one(MetadataValue::Pair(one(ty(atom(b))), none())),
+            none(),
+            atom(c),
+        ))),
+        _ => {
+            let mut values = Vec::new();
+            values.push(ty(atom(a)));
+            values.push(MetadataValue::Inv(
+                two(ty(atom(b)), ty(map(one(ty(atom(c)))))),
+                one(MetadataValue::Pair(one(ty(atom(c))), one(ty(atom(a))))),
+                one(ty(atom(b))),
+                atom(c),
+            ));
+            values.push(ty(atom(b)));
+            map(Metadata { values })
+        }
+    }
+}
+
+/// `(ok, count, total)` of `sum` on `tree(shape, a, b, c)` with `stop`, from
+/// `total0`: the caller then adds 1000 through the borrow given back by the
+/// call (included in `total`)
+pub fn run_sum(shape: u8, a: u32, b: u32, c: u32, stop: u32, total0: u32) -> (bool, u32, u32) {
+    let e = tree(shape, a, b, c);
+    let mut total = total0;
+    let r = {
+        let t = &mut total;
+        let r = sum(&e, stop, t);
+        *t = t.wrapping_add(1000);
+        r
+    };
+    match r {
+        Ok(n) => (true, n, total),
+        Err(n) => (false, n, total),
+    }
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn run_sum_native() {
+        assert_eq!(run_sum(0, 5, 6, 7, 0, 1), (true, 0, 1001));
+        assert_eq!(run_sum(1, 1, 2, 4, 0, 0), (true, 3, 1019));
+        assert_eq!(run_sum(1, 1, 2, 4, 2, 5), (false, 1, 1016));
+        assert_eq!(run_sum(2, 1, 2, 4, 0, 0), (true, 3, 1019));
+        assert_eq!(run_sum(2, 1, 2, 4, 4, 1), (false, 2, 1014));
+        assert_eq!(run_sum(2, 1, 2, 4, 1, 3), (false, 0, 1003));
+        assert_eq!(run_sum(3, 1, 2, 4, 9, 0), (true, 8, 5028));
+        assert_eq!(run_sum(3, 1, 2, 4, 4, 0), (false, 3, 1015));
+        assert_eq!(run_sum(3, 1, 2, 4, 0, 2), (false, 2, 1023));
+        assert_eq!(run_sum(3, 1, 2, 4, 2, 7), (false, 1, 1022));
+        assert_eq!(run_sum(3, 3, 1, 2, 7, 4294967295), (true, 8, 1988));
+    }
+}
