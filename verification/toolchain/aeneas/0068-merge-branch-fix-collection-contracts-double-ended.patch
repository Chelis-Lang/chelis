diff --git a/tests/src/collect-option.rs b/tests/src/collect-option.rs
new file mode 100644
index 0000000..0de7993
--- /dev/null
+++ b/tests/src/collect-option.rs
@@ -0,0 +1,95 @@
+//@ [!lean] skip
+//@ [lean] subdir=CollectOption
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::iter::adapters::map::Map --include core::option::{core::option::Option} --include core::iter::traits::iterator::Iterator::by_ref --include {core::iter::traits::iterator::Iterator}::by_ref
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! `FromIterator<Option<A>> for Option<V>` (core option.rs: `iter::try_process`
+//! over a GenericShunt): the inner collector stops at the first `None`, sees a
+//! size_hint with lower bound 0, and the source is left just after the `None`.
+//! CollectOption/Checks.lean compares the model with the native results
+//! asserted in the native test module.
+use std::collections::BTreeSet;
+
+pub fn doubled(xs: &[u32]) -> Option<Vec<u32>> {
+    xs.iter().map(|x| if *x < 100 { Some(*x * 2) } else { None }).collect()
+}
+
+/// chelis-ir lower.rs:6841: `elements.iter().map(|e| leaf(e)).collect::<Option<Vec<_>>>()`.
+pub fn leaves(elements: &[&u32]) -> Option<Vec<u32>> {
+    elements.iter().map(|e| leaf(e)).collect::<Option<Vec<u32>>>()
+}
+
+fn leaf(e: &u32) -> Option<u32> {
+    if *e % 2 == 0 { Some(*e / 2) } else { None }
+}
+
+/// The mapper runs exactly up to the first None.
+pub fn calls_until_none(xs: &[u32]) -> (Option<Vec<u32>>, usize) {
+    let mut calls = 0;
+    let collected = xs
+        .iter()
+        .map(|x| {
+            calls += 1;
+            if *x == 0 { None } else { Some(*x) }
+        })
+        .collect::<Option<Vec<u32>>>();
+    (collected, calls)
+}
+
+/// The source is left just after the first None.
+pub fn resume_after_none(xs: &[u32]) -> (Option<Vec<u32>>, Option<u32>) {
+    let mut iter = xs.iter();
+    let collected = iter
+        .by_ref()
+        .map(|x| if *x == 0 { None } else { Some(*x) })
+        .collect::<Option<Vec<u32>>>();
+    (collected, iter.next().copied())
+}
+
+pub fn option_set(xs: &[u32]) -> Option<BTreeSet<u32>> {
+    xs.iter().map(|x| if *x == 0 { None } else { Some(*x) }).collect()
+}
+
+/// A collector that records the size_hint it sees before and after each of
+/// two polls.
+pub struct Hints(pub Vec<(usize, Option<usize>)>);
+
+impl FromIterator<u32> for Hints {
+    fn from_iter<I: IntoIterator<Item = u32>>(iter: I) -> Self {
+        let mut iter = iter.into_iter();
+        let mut hints = vec![iter.size_hint()];
+        let _ = iter.next();
+        hints.push(iter.size_hint());
+        let _ = iter.next();
+        hints.push(iter.size_hint());
+        Hints(hints)
+    }
+}
+
+pub fn shunt_hints(xs: &[u32]) -> Option<Vec<(usize, Option<usize>)>> {
+    xs.iter()
+        .map(|x| if *x == 0 { None } else { Some(*x) })
+        .collect::<Option<Hints>>()
+        .map(|hints| hints.0)
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn collectors() {
+        assert_eq!(doubled(&[1, 2, 3]), Some(vec![2, 4, 6]));
+        assert_eq!(doubled(&[1, 200, 3]), None);
+        assert_eq!(doubled(&[]), Some(vec![]));
+        assert_eq!(leaves(&[&2, &4]), Some(vec![1, 2]));
+        assert_eq!(leaves(&[&2, &3, &4]), None);
+        assert_eq!(calls_until_none(&[1, 0, 2, 0]), (None, 2));
+        assert_eq!(calls_until_none(&[1, 2]), (Some(vec![1, 2]), 2));
+        assert_eq!(resume_after_none(&[1, 0, 2, 3]), (None, Some(2)));
+        assert_eq!(resume_after_none(&[1, 2]), (Some(vec![1, 2]), None));
+        assert_eq!(option_set(&[3, 1, 3]), Some([1, 3].into_iter().collect()));
+        assert_eq!(option_set(&[3, 0]), None);
+        assert_eq!(shunt_hints(&[1, 2]), Some(vec![(0, Some(2)), (0, Some(1)), (0, Some(0))]));
+        assert_eq!(shunt_hints(&[1, 0, 2]), None);
+    }
+}
diff --git a/tests/src/collect-range-inclusive.rs b/tests/src/collect-range-inclusive.rs
new file mode 100644
index 0000000..24101e2
--- /dev/null
+++ b/tests/src/collect-range-inclusive.rs
@@ -0,0 +1,52 @@
+//@ [!lean] skip
+//@ [lean] subdir=CollectRangeInclusive
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::iter::adapters::map::Map
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! Collectors over `RangeInclusive` (admitted by CollectionContracts): its
+//! exact size_hint and its fold override, which yields the final endpoint
+//! without stepping past it. CollectRangeInclusive/Checks.lean compares the
+//! model with the native results asserted in the native test module.
+
+/// chelis-types deep_type.rs edit_distance: `(0..=right.len()).collect()`.
+pub fn row(len: usize) -> Vec<usize> {
+    (0..=len).collect()
+}
+
+pub fn shifted(start: i32, end: i32) -> Vec<i32> {
+    (start..=end).map(|x| x * 2).collect()
+}
+
+/// The range ending at the maximum value yields it without overflowing.
+pub fn to_max(start: usize) -> Vec<usize> {
+    (start..=usize::MAX).collect()
+}
+
+pub fn extended(mut out: Vec<usize>, start: usize, end: usize) -> Vec<usize> {
+    out.extend(start..=end);
+    out
+}
+
+/// After one next, the rest of the range is collected.
+pub fn rest_after_next(start: usize, end: usize) -> (Option<usize>, Vec<usize>) {
+    let mut range = start..=end;
+    let first = range.next();
+    (first, range.collect())
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn collectors() {
+        assert_eq!(row(3), vec![0, 1, 2, 3]);
+        assert_eq!(row(0), vec![0]);
+        assert_eq!(shifted(-1, 2), vec![-2, 0, 2, 4]);
+        assert_eq!(shifted(3, 2), vec![]);
+        assert_eq!(to_max(usize::MAX - 1), vec![usize::MAX - 1, usize::MAX]);
+        assert_eq!(extended(vec![9], 2, 4), vec![9, 2, 3, 4]);
+        assert_eq!(extended(vec![9], 4, 2), vec![9]);
+        assert_eq!(rest_after_next(1, 3), (Some(1), vec![2, 3]));
+        assert_eq!(rest_after_next(5, 5), (Some(5), vec![]));
+    }
+}
diff --git a/tests/src/double-ended-adapters.rs b/tests/src/double-ended-adapters.rs
new file mode 100644
index 0000000..a827df4
--- /dev/null
+++ b/tests/src/double-ended-adapters.rs
@@ -0,0 +1,128 @@
+//@ [!lean] skip
+//@ [lean] subdir=DoubleEndedAdapters
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings --include core::iter::adapters::map::Map --include core::iter::adapters::filter::Filter --include core::iter::adapters::enumerate::Enumerate --include core::option::{core::option::Option}
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! DoubleEndedIterator of Enumerate, Skip, Map and Filter (and the
+//! ExactSizeIterator of Enumerate and Skip), and Index<&Q> for BTreeMap.
+//! DoubleEndedAdapters/Checks.lean compares the model with the native results
+//! asserted in the native test module.
+use std::collections::BTreeMap;
+
+/// chelis-ir ownership/last_use.rs: the last index after `start` whose item
+/// satisfies the predicate, plus one.
+pub fn last_matching(ops: &[u32], start: usize, owner: u32) -> Option<usize> {
+    ops.iter()
+        .enumerate()
+        .skip(start)
+        .filter(|(_, op)| **op == owner)
+        .map(|(index, _)| index + 1)
+        .next_back()
+}
+
+/// Enumerate indexes items taken from the back by the remaining length.
+pub fn enumerate_back(xs: &[u32]) -> (Option<(usize, u32)>, Option<(usize, u32)>, Option<(usize, u32)>) {
+    let mut iter = xs.iter().enumerate();
+    let first = iter.next().map(|(i, x)| (i, *x));
+    let last = iter.next_back().map(|(i, x)| (i, *x));
+    (first, last, iter.nth_back(1).map(|(i, x)| (i, *x)))
+}
+
+pub fn enumerate_rfold(xs: &[u32]) -> usize {
+    let mut iter = xs.iter().enumerate();
+    let _ = iter.next();
+    iter.rfold(0, |acc, (index, x)| acc * 10 + index + *x as usize)
+}
+
+pub fn enumerate_rposition(xs: &[u32], target: u32) -> Option<usize> {
+    xs.iter().enumerate().rfind(|(_, x)| **x == target).map(|(index, _)| index)
+}
+
+/// Skip yields from the back only the items that the front skip leaves.
+pub fn skip_back(xs: &[u32], n: usize) -> (Option<u32>, Option<u32>, usize) {
+    let mut iter = xs.iter().skip(n);
+    let last = iter.next_back().copied();
+    let before = iter.next_back().copied();
+    (last, before, iter.len())
+}
+
+pub fn skip_nth_back(xs: &[u32], n: usize, k: usize) -> (Option<u32>, Option<u32>) {
+    let mut iter = xs.iter().skip(n);
+    let item = iter.nth_back(k).copied();
+    (item, iter.next().copied())
+}
+
+pub fn skip_rfold(xs: &[u32], n: usize) -> u32 {
+    xs.iter().skip(n).rfold(0, |acc, x| acc * 10 + *x)
+}
+
+pub fn skip_rfind(xs: &[u32], n: usize, target: u32) -> (Option<u32>, Option<u32>) {
+    let mut iter = xs.iter().skip(n);
+    let found = iter.rfind(|x| **x <= target).copied();
+    (found, iter.next_back().copied())
+}
+
+pub fn skip_enumerate_back(xs: &[u32], n: usize) -> Vec<(usize, u32)> {
+    let mut out = Vec::new();
+    let mut iter = xs.iter().enumerate().skip(n);
+    while let Some((index, x)) = iter.next_back() {
+        out.push((index, *x));
+    }
+    out
+}
+
+pub fn filter_map_rfold(xs: &[u32]) -> u32 {
+    xs.iter().filter(|x| **x % 2 == 1).map(|x| *x * 10).rfold(0, |acc, x| acc * 100 + x)
+}
+
+pub fn map_rfind(xs: &[u32]) -> (Option<u32>, Option<u32>) {
+    let mut iter = xs.iter().map(|x| *x + 1);
+    let found = iter.rfind(|x| *x % 3 == 0);
+    (found, iter.next_back())
+}
+
+pub fn filter_nth_back(xs: &[u32], k: usize) -> (Option<u32>, Option<u32>) {
+    let mut iter = xs.iter().filter(|x| **x > 1);
+    let item = iter.nth_back(k).copied();
+    (item, iter.next().copied())
+}
+
+pub fn lookup(map: &BTreeMap<u32, u32>, key: u32) -> u32 {
+    map[&key]
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn adapters() {
+        assert_eq!(last_matching(&[7, 1, 7, 2, 7], 0, 7), Some(5));
+        assert_eq!(last_matching(&[7, 1, 7, 2, 1], 1, 7), Some(3));
+        assert_eq!(last_matching(&[7, 1, 7], 3, 7), None);
+        assert_eq!(last_matching(&[7, 1, 7], 9, 7), None);
+        assert_eq!(enumerate_back(&[5, 6, 7, 8]), (Some((0, 5)), Some((3, 8)), Some((1, 6))));
+        assert_eq!(enumerate_back(&[5]), (Some((0, 5)), None, None));
+        assert_eq!(enumerate_rfold(&[1, 2, 3]), (2 + 3) * 10 + 1 + 2);
+        assert_eq!(enumerate_rposition(&[4, 9, 4, 9], 4), Some(2));
+        assert_eq!(enumerate_rposition(&[4, 9], 3), None);
+        assert_eq!(skip_back(&[1, 2, 3, 4], 2), (Some(4), Some(3), 0));
+        assert_eq!(skip_back(&[1, 2, 3, 4], 3), (Some(4), None, 0));
+        assert_eq!(skip_back(&[1, 2, 3], 5), (None, None, 0));
+        assert_eq!(skip_nth_back(&[1, 2, 3, 4, 5], 1, 1), (Some(4), Some(2)));
+        assert_eq!(skip_nth_back(&[1, 2, 3, 4, 5], 1, 4), (None, None));
+        assert_eq!(skip_nth_back(&[1, 2, 3], 3, 0), (None, None));
+        assert_eq!(skip_rfold(&[1, 2, 3, 4], 1), 432);
+        assert_eq!(skip_rfold(&[1, 2], 2), 0);
+        assert_eq!(skip_rfind(&[1, 5, 2, 6], 1, 3), (Some(2), Some(5)));
+        assert_eq!(skip_rfind(&[1, 5, 2, 6], 1, 1), (None, None));
+        assert_eq!(skip_enumerate_back(&[10, 11, 12], 1), vec![(2, 12), (1, 11)]);
+        assert_eq!(filter_map_rfold(&[1, 2, 3, 5]), 503010);
+        assert_eq!(map_rfind(&[1, 2, 5, 7]), (Some(6), Some(3)));
+        assert_eq!(map_rfind(&[1, 3]), (None, None));
+        assert_eq!(filter_nth_back(&[1, 2, 3, 1, 4], 1), (Some(3), Some(2)));
+        assert_eq!(filter_nth_back(&[1, 2, 3], 2), (None, None));
+        let map: BTreeMap<u32, u32> = [(1, 10), (3, 30)].into_iter().collect();
+        assert_eq!(lookup(&map, 3), 30);
+        assert!(std::panic::catch_unwind(|| lookup(&map, 2)).is_err());
+    }
+}
diff --git a/tests/src/str-split.rs b/tests/src/str-split.rs
new file mode 100644
index 0000000..d463fd4
--- /dev/null
+++ b/tests/src/str-split.rs
@@ -0,0 +1,60 @@
+//@ [!lean] skip
+//@ [lean] subdir=StrSplit
+//@ charon-args=--mir=promoted --monomorphize-mut=except-types --remove-adt-clauses --lift-associated-types=* --error-on-warnings
+//@ [lean] aeneas-args=-strict-joins -warnings-as-errors
+//! `str::split` with a `&str` pattern and its `Split` iterator (collected by
+//! the admitted Vec collector): pieces between the leftmost non-overlapping
+//! matches, an empty needle matching at every char boundary, the default
+//! size_hint and the fused end. StrSplit/Checks.lean compares the model with
+//! the native results asserted in the native test module.
+
+/// chelis-types opacity.rs demangle_lowercase_binding.
+pub fn segments(stem: &str) -> Vec<&str> {
+    stem.split("__").collect::<Vec<_>>()
+}
+
+pub fn pieces<'a>(text: &'a str, pattern: &str) -> Vec<&'a str> {
+    text.split(pattern).collect()
+}
+
+pub fn first_two<'a>(text: &'a str, pattern: &str) -> (Option<&'a str>, Option<&'a str>) {
+    let mut iter = text.split(pattern);
+    let first = iter.next();
+    (first, iter.next())
+}
+
+/// The number of pieces, then two more calls after the end.
+pub fn fused<'a>(text: &'a str, pattern: &str) -> (usize, Option<&'a str>, Option<&'a str>) {
+    let mut iter = text.split(pattern);
+    let mut count = 0;
+    while iter.next().is_some() {
+        count += 1;
+    }
+    (count, iter.next(), iter.next())
+}
+
+pub fn hint(text: &str, pattern: &str) -> (usize, Option<usize>) {
+    text.split(pattern).size_hint()
+}
+
+#[cfg(test)]
+mod native {
+    use super::*;
+
+    #[test]
+    fn split() {
+        assert_eq!(segments("Pkg__Mod__name__x"), vec!["Pkg", "Mod", "name", "x"]);
+        assert_eq!(segments("__Entry__run"), vec!["", "Entry", "run"]);
+        assert_eq!(pieces("", "__"), vec![""]);
+        assert_eq!(pieces("", ""), vec!["", ""]);
+        assert_eq!(pieces("abc", ""), vec!["", "a", "b", "c", ""]);
+        assert_eq!(pieces("aé", ""), vec!["", "a", "é", ""]);
+        assert_eq!(pieces("aaa", "aa"), vec!["", "a"]);
+        assert_eq!(pieces("__a__b__", "__"), vec!["", "a", "b", ""]);
+        assert_eq!(pieces("héllo wörld", "ö"), vec!["héllo w", "rld"]);
+        assert_eq!(pieces("ab", "abc"), vec!["ab"]);
+        assert_eq!(first_two("a,b", ","), (Some("a"), Some("b")));
+        assert_eq!(fused("a,b,,c", ","), (4, None, None));
+        assert_eq!(hint("a__b", "__"), (0, None));
+    }
+}
