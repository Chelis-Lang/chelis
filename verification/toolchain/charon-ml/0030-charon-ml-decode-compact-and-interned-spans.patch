+(** A span is the array [[file; beg_line; beg_col; end_line; end_col]], followed
+    by the same numbers for [generated_from_span] when present. In deduplicated
+    files, the first occurrence of each span is prefixed with its id (ids are
+    consecutive from 0) and the later occurrences are the id alone. *)
+let span_numbers_of_json (ctx : of_json_ctx) (js : json) : (span, string) result
+    =
+  let span_data file beg_line beg_col end_line end_col :
+      (span_data, string) result =
+    match FileTbl.find_opt ctx.id_to_file_map (FileId.of_int file) with
+    | Some file ->
+        Ok
+          {
+            file;
+            beg_loc = { line = beg_line; col = beg_col };
+            end_loc = { line = end_line; col = end_col };
+          }
+    | None -> Error ("unknown file id " ^ string_of_int file)
+  in
+  let span (numbers : int list) : (span, string) result =
+    match numbers with
+    | [ f; bl; bc; el; ec ] ->
+        let* data = span_data f bl bc el ec in
+        Ok { data; generated_from_span = None }
+    | [ f; bl; bc; el; ec; gf; gbl; gbc; gel; gec ] ->
+        let* data = span_data f bl bc el ec in
+        let* generated = span_data gf gbl gbc gel gec in
+        Ok { data; generated_from_span = Some generated }
+    | _ -> Error "a span has 5 or 10 numbers"
+  in
+  combine_error_msgs js __FUNCTION__
+    (match js with
+    | `Int id -> (
+        match Hashtbl.find_opt ctx.span_table id with
+        | Some span -> Ok span
+        | None ->
+            Error
+              "Span id not found; there is a serialization mismatch between \
+               Rust and OCaml")
+    | `List numbers -> (
+        let* numbers = of_json_list int_of_json ctx numbers in
+        match numbers with
+        | id :: numbers when List.length numbers = 5 || List.length numbers = 10
+          ->
+            if id <> Hashtbl.length ctx.span_table then
+              Error
+                "Unexpected span id; there is a serialization mismatch between \
+                 Rust and OCaml"
+            else
+              let* span = span numbers in
+              Hashtbl.add ctx.span_table id span;
+              Ok span
+        | _ -> span numbers)
+    | _ -> Error "")
+
