-  object (self)
-    inherit [_] map_statement
-    method! visit_de_bruijn_id delta dbid = dbid + delta
+  object
+    inherit [_] map_statement as super
+
+    method! visit_binder visit_value (delta, depth) binder =
+      super#visit_binder visit_value (delta, depth + 1) binder
+
+    method! visit_region_binder visit_value (delta, depth) binder =
+      super#visit_region_binder visit_value (delta, depth + 1) binder
+
+    method! visit_de_bruijn_id (delta, depth) dbid =
+      if dbid >= depth then dbid + delta else dbid
   end
 
