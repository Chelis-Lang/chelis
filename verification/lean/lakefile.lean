import Lake
open Lake DSL

/-!
Proof bridge between the Aeneas-extracted production Rust model and the pinned
LaCaDiLE reference core (`LaCaDiLECore`).

Configuration (all optional, `lake -K key=value ...`):

* `aeneas`: the built patched Aeneas `backends/lean` library, required by path and never
  written here. Lake materializes a locked path dependency from `lake-manifest.json` /
  `.lake/package-overrides.json`, not from this declaration, so select a library with
  `prepare_bridge.py --aeneas-lean-dir <dir>` (writes the override) or
  `lake -K aeneas=<dir> update aeneas`.
* `model`: directory holding the generated model sources (default: the `model` symlink).
* `modelRoots`: comma-separated root module(s) of the generated model. The default
  `ChelisIr` is one combined extraction whose roots include the IR, `chelis_types` and
  `chelis_effects` entry points. A whole-core run (`verification/extract_whole.py`) lists every
  chunk module (`ChelisIr03.Types`, `ChelisIr03.FunsPart1`, ...) in its summary's `modules`.
* `scope`: `fragment` or `whole-core`. The default is `fragment`.
* `chain`: `default` or `lowering-trace`. The default is `default`.

Build the fragment with `lake build +ChelisBridge +ChelisBridge.Audit`.
Whole-core acceptance builds the full library and rejects missing caller proofs.

Configuring the package (every `lake -R ...`; the settings above take effect only on
reconfiguration) writes `.lake/model-root/ChelisModelRoot.lean`, which imports exactly
`modelRoots`. Bridge modules import the model only through it, so the same sources build
against either layout; `ChelisBridge/Model.lean` documents the naming both layouts share.

LaCaDiLE is pinned by URL and revision in `lake-manifest.json`. The repository is not
publicly clonable, so `prepare_bridge.py` seeds `.lake/packages/LaCaDiLE` from a local
clone at exactly the pinned revision. Mathlib is never built from source: its prebuilt
oleans come from `lake exe cache get`.
-/

def aeneasDir : System.FilePath :=
  (get_config? aeneas).getD "../../.work/aeneas-verification/aeneas/backends/lean"

def modelDir : System.FilePath := (get_config? model).getD "model"

def modelRoots : Array Lean.Name :=
  (((get_config? modelRoots).getD "ChelisIr").splitOn ",").toArray.map String.toName

def acceptanceChain : String := (get_config? chain).getD "default"

def acceptanceScope : String := (get_config? scope).getD "fragment"


/-- Source directory of the generated `ChelisModelRoot` module. -/
def modelRootDir : System.FilePath := ".lake" / "model-root"

#eval show IO Unit from do
  unless #["default", "lowering-trace"].contains acceptanceChain do
    throw <| IO.userError s!"unknown acceptance chain: {acceptanceChain}"

  unless #["fragment", "whole-core"].contains acceptanceScope do
    throw <| IO.userError s!"unknown acceptance scope: {acceptanceScope}"

  let text := "-- Generated by lakefile.lean from `modelRoots`; do not edit.\n" ++
    String.join (modelRoots.toList.map (s!"import {·}\n"))
  let dir := __dir__ / modelRootDir
  let file := dir / "ChelisModelRoot.lean"
  IO.FS.createDirAll dir
  let current ← if ← file.pathExists then IO.FS.readFile file else pure ""
  unless current == text do IO.FS.writeFile file text

  let chainFile := dir / "ChelisAcceptanceChain.lean"
  let chainText := s!"def chelisAcceptanceChain : String := \"{acceptanceChain}\"\n" ++
    s!"def chelisAcceptanceScope : String := \"{acceptanceScope}\"\n"
  let oldChain ← if ← chainFile.pathExists then IO.FS.readFile chainFile else pure ""
  unless oldChain == chainText do IO.FS.writeFile chainFile chainText

  let scopeFile := dir / "ChelisProofScope.lean"
  let scopeText := if acceptanceScope == "whole-core" then
    "import ChelisBridge.Runtime.ExtractedStack\n" ++
    "import ChelisBridge.Runtime.ExtractedCancellation\n"
    else "import Init\n"

  let oldScope ← if ← scopeFile.pathExists then IO.FS.readFile scopeFile else pure ""
  unless oldScope == scopeText do IO.FS.writeFile scopeFile scopeText



package chelis_bridge

require aeneas from aeneasDir

require LaCaDiLE from git
  "https://github.com/Chelis-Lang/LaCaDiLE" @ "11531c8b0e3e6fb6650ddbc404937e5c527b0785" / "lean"

/-- The generated production model, compiled from source by this package. -/
lean_lib ChelisModel where
  srcDir := modelDir
  roots := modelRoots

/-- The single import point of the generated model: imports every `modelRoots` module. -/
lean_lib ChelisModelRoot where
  srcDir := modelRootDir
  roots := #[`ChelisModelRoot, `ChelisAcceptanceChain, `ChelisProofScope]

@[default_target]
lean_lib ChelisBridge where
  roots := #[`ChelisBridge]
  -- Fragment builds select +ChelisBridge and its scope-specific Audit imports.
  -- Whole-core builds also check every package module.
  globs := #[.andSubmodules `ChelisBridge]
  leanOptions := #[⟨`autoImplicit, false⟩]
