import ChelisBridge.Model

/-!
# Derived `Clone` impls of the extracted model return their input

`with_mono_probe` snapshots the specialization state with `MonoSpecializationState::clone`
and restores the snapshot at exit, so the probe restores the entry state exactly when that
clone is the identity on every value. Every `Clone` in its closure is `#[derive(Clone)]`
(fieldwise clone, the identity of the value) or a library clone (`Vec`, `Option`, `Box`,
`BTreeMap`, `String`, floats, `BuiltinClone` of `Copy` types), and this module proves
`clone x = .ok x` for each of them, bottom-up (recursive type groups by structural recursion
over constructors).

The library lemmas come first; the per-type theorems after them are generated from the model
by `verification/lean/gen_clone_id.py`, one theorem per derived clone function reached from
`MonoSpecializationState::clone`. To regenerate them (from `verification/lean`):
`python3 gen_clone_id.py model/ChelisIr.lean chelis_ir ChelisBridge/Runtime/CloneId.lean
ChelisBridge.Runtime.CloneId host.MonoSpecializationState.Insts.CoreCloneClone.clone`.
-/

set_option linter.unusedSimpArgs false
set_option linter.unnecessarySeqFocus false
set_option linter.unusedTactic false
set_option linter.unreachableTactic false
set_option linter.unusedVariables false

open Aeneas.Std
open_chelis_model

namespace ChelisBridge.Runtime.CloneId
theorem vec {T : Type} (inst : core.clone.Clone T) (v : alloc.vec.Vec T)
    (h : ∀ x ∈ v.val, inst.clone x = .ok x) : alloc.vec.CloneVec.clone inst v = .ok v := by
  unfold alloc.vec.CloneVec.clone
  obtain ⟨s', hs', he⟩ := WP.spec_imp_exists (Slice.clone_spec (clone := inst.clone) (s := v) h)
  rw [hs', ← he]
  rfl

@[simp] theorem vec_all {T : Type} (inst : core.clone.Clone T) (v : alloc.vec.Vec T)
    (h : ∀ x, inst.clone x = .ok x) : alloc.vec.CloneVec.clone inst v = .ok v :=
  vec inst v (fun x _ => h x)

@[simp] theorem option {T : Type} (inst : core.clone.Clone T) (o : Option T)
    (h : ∀ x, inst.clone x = .ok x) : core.option.Option.Clone.clone inst o = .ok o := by
  cases o with
  | none => rfl
  | some x => simp [core.option.Option.Clone.clone, h x]; rfl

@[simp] theorem box {T : Type} (inst : core.clone.Clone T) (x : T)
    (h : ∀ x, inst.clone x = .ok x) : core.alloc.boxed.CloneBox.clone inst x = .ok x := h x

@[simp] theorem btreeMap {K V : Type} (ki : core.clone.Clone K) (vi : core.clone.Clone V)
    (m : alloc.collections.btree.map.BTreeMap K V)
    (hk : ∀ k, ki.clone k = .ok k) (hv : ∀ v, vi.clone v = .ok v) :
    alloc.collections.btree.map.BTreeMap.clone ki vi m = .ok m := by
  obtain ⟨entries⟩ := m
  unfold alloc.collections.btree.map.BTreeMap.clone
  have : entries.mapM (fun (kv : K × V) => do
      let key ← ki.clone kv.1
      .ok (key, ← vi.clone kv.2)) = .ok entries :=
    List.mapM_clone_eq (fun ⟨k, v⟩ _ => by simp [hk, hv])
  simp only at this ⊢
  rw [this]
  rfl

@[simp] theorem string (s : String) : alloc.string.CloneString.clone s = .ok s := rfl

