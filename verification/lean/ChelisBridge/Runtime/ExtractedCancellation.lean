    (tre : chelis_types.deep_type.TypeResolutionEnv)
    (bis : chelis_types.linearity.BindingIdSupply) (scope : chelis_types.linearity.LinearScope)
    (expr : chelis_deep.ast.Expr) (iter' : core.slice.iter.Iter chelis_deep.ast.Expr)
    (error : chelis_types.errors.CheckError) (errors : alloc.vec.Vec chelis_types.errors.CheckError)
    (hi : core.slice.iter.IteratorSliceIter.next iter = .ok (some expr, iter'))
    (hc : native.cancel native.cancelTaken = true)
    (he : chelis_types.cancel.cancellation_check_error = .ok error)
