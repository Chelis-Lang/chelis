abbrev Services := Aeneas.Std.chelis_types.native.NativeServices

/-- The actual sink poll reads the current oracle element. -/
theorem sink_poll_eq (s : Sink) :
    chelis_types.session.DiagnosticSink.cancellation_observed s =
      .ok (s.native.cancel s.native.cancelTaken,
        { s with native := { s.native with cancelTaken := s.native.cancelTaken + 1 } },
        fun s' => { s with errors := s'.errors, native := s'.native }) := rfl

/-- Each step calls the extracted sink poll, not a cached flag. -/
def extractedPollN : Sink → Nat → Result (List Bool × Sink)
  | s, 0 => .ok ([], s)
  | s, n + 1 => do
      let (b, s', _) ← chelis_types.session.DiagnosticSink.cancellation_observed s
      let (obs, s'') ← extractedPollN s' n
      .ok (b :: obs, s'')

/-- The extracted polls correspond to the native service model. -/
theorem extractedPollN_services (s : Sink) (n : Nat) :
    extractedPollN s n = (do
      let (obs, native) ← Cancellation.pollN s.native n
      .ok (obs, { s with native })) := by
  induction n generalizing s with
  | zero => rfl
  | succ n ih =>
    simp only [extractedPollN, Cancellation.pollN, sink_poll_eq,
      Aeneas.Std.chelis_types.native.NativeServices.cancellation_observed, bind_tc_ok, ih]

/-- A permitted native stream stays monotone through extracted polls. -/
theorem extracted_native_stream (written : Bool) (obs : List Bool)
    (s : Sink) (hp : Cancellation.Permitted written obs)
    (hm : Cancellation.cnPolls s.native obs.length = obs) :
    ∃ s', extractedPollN s obs.length = .ok (obs, s') ∧
      Cancellation.Mono obs ∧ s'.native.cancel = s.native.cancel := by
  refine ⟨{ s with native := { s.native with cancelTaken := s.native.cancelTaken + obs.length } },
    ?_, Cancellation.permitted_mono written obs hp, rfl⟩
  simp only [extractedPollN_services, Cancellation.pollN_eq, hm, bind_tc_ok]

/-- The cancellation branch stops cycle search before graph access. -/
theorem cycle_path_cancelled
    (graph : chelis_types.infer.declarations.TopLevelReferenceGraph)
    (adjacency : Slice (alloc.vec.Vec Usize)) (component : Slice Usize)
    (native : Services) (h : native.cancel native.cancelTaken = true) :
    chelis_types.infer.declarations.TopLevelReferenceGraph.cycle_path graph adjacency component native =
      .ok (none, { native with cancelTaken := native.cancelTaken + 1 }) := by
  simp only [chelis_types.infer.declarations.TopLevelReferenceGraph.cycle_path,
    Aeneas.Std.chelis_types.native.NativeServices.cancellation_observed, bind_tc_ok, h, if_true]

theorem initialization_analysis_cancelled
    (graph : chelis_types.infer.declarations.TopLevelReferenceGraph)
    (native : Services) (hc : graph.complete = true)
    (hp : native.cancel native.cancelTaken = true) :
    chelis_types.infer.declarations.TopLevelReferenceGraph.initialization_analysis graph native =
      .ok (none, { native with cancelTaken := native.cancelTaken + 1 }) := by
  simp only [chelis_types.infer.declarations.TopLevelReferenceGraph.initialization_analysis,
    hc, if_true, Aeneas.Std.chelis_types.native.NativeServices.cancellation_observed,
    bind_tc_ok, hp, if_true]

