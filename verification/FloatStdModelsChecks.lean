def u64 (n : Nat) : U64 := ⟨BitVec.ofNat 64 n⟩
def u32 (n : Nat) : U32 := ⟨BitVec.ofNat 32 n⟩
def nan64 (b : U64) : Nat := if (F64.ofBits b).isNaN then 2 ^ 64 - 1 else b.val
def nan32 (b : U32) : Nat := if (F32.ofBits b).isNaN then 2 ^ 32 - 1 else b.val

def fail (label : String) : IO Unit := throw (IO.userError label)

#eval show IO Unit from do
  for (x, y, mx, mn) in maxMin64 do
    match float_std_models.max_min64 (u64 x) (u64 y) with
    | .ok (a, b) => unless (a.val, b.val) == (mx, mn) do fail s!"max/min64 {x} {y}: {a.val} {b.val}"
    | _ => fail s!"max/min64 {x} {y} failed"
  for (x, y, mx, mn) in maxMin32 do
    match float_std_models.max_min32 (u32 x) (u32 y) with
    | .ok (a, b) => unless (a.val, b.val) == (mx, mn) do fail s!"max/min32 {x} {y}: {a.val} {b.val}"
    | _ => fail s!"max/min32 {x} {y} failed"
  for (x, c, e, s) in rounding64 do
    match float_std_models.rounding64 (u64 x) with
    | .ok (a, b, d) => unless (nan64 a, nan64 b, nan64 d) == (c, e, s) do fail s!"rounding64 {x}"
    | _ => fail s!"rounding64 {x} failed"
  for (x, c, e, s) in rounding32 do
    match float_std_models.rounding32 (u32 x) with
    | .ok (a, b, d) => unless (nan32 a, nan32 b, nan32 d) == (c, e, s) do fail s!"rounding32 {x}"
    | _ => fail s!"rounding32 {x} failed"
  for (x, a, b, r) in fma64 do
    match float_std_models.fma64 (u64 x) (u64 a) (u64 b) with
    | .ok v => unless nan64 v == r do fail s!"fma64 {x} {a} {b}: {v.val}"
    | _ => fail s!"fma64 {x} failed"
  for (x, a, b, r) in fma32 do
    match float_std_models.fma32 (u32 x) (u32 a) (u32 b) with
    | .ok v => unless nan32 v == r do fail s!"fma32 {x} {a} {b}: {v.val}"
    | _ => fail s!"fma32 {x} failed"

