+//@ no-default-options
+//@ charon-args=--preset=aeneas
+//@ no-check-output
+
+// The closure inherits IntoIterator's clause even though it captures no data.
+// Removing ADT clauses used to leave its Fn implementation metadata unbound.
+pub fn collect_bounds<'a>(bounds: impl IntoIterator<Item = &'a usize>) -> Vec<usize> {
+    bounds
+        .into_iter()
+        .filter_map(|bound| Some(*bound))
+        .collect()
+}
+
+// The generic bound is also required when calling a method on captured data.
+pub fn captured<T: Clone>(value: T) -> impl Fn() -> T {
+    move || value.clone()
+}
