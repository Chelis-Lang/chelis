+/// The region in which the allocation exists but its pointee is not initialized.
+/// We accept acyclic control flow ending at one whole-pointee assignment (possibly
+/// reached through several branches), or at an exit. Partial writes, aliases,
+/// moves and precise drops of the shallow box are rejected. A conditional drop
+/// is permitted only on an exit-only path: no pointee has been initialized, so
+/// it can only release allocation storage, which builtin Box abstracts away.
+struct Initialization<'a> {
+    body: &'a BodyContents,
+    box_place: &'a Place,
+    entry: BlockId,
+    active: HashSet<BlockId>,
+    // Whether this block can reach the initialization, rather than only an exit.
+    reaches_init: HashMap<BlockId, bool>,
+    assignment: Option<(BlockId, usize)>,
+}
+
+impl Initialization<'_> {
+    fn visit(&mut self, id: BlockId) -> Option<bool> {
+        if let Some(reaches_init) = self.reaches_init.get(&id) {
+            return Some(*reaches_init);
+        }
+        if !self.active.insert(id) {
+            return None; // No loops while the box is uninitialized.
+        }
+        let block = self.body.get(id)?;
+        let local = self.box_place.as_local()?;
+        let start = if id == self.entry { 2 } else { 0 };
+        for (index, statement) in block.statements.iter().enumerate().skip(start) {
+            if let StatementKind::Assign(place, value) = &statement.kind
+                && let Some((base, ProjectionElem::Deref)) = place.as_projection()
+                && base == self.box_place
+            {
+                if mentions_local(value, local) {
+                    return None;
+                }
+                let site = (id, index);
+                if self.assignment.is_some_and(|previous| previous != site) {
+                    return None;
+                }
+                self.assignment = Some(site);
+                self.active.remove(&id);
+                self.reaches_init.insert(id, true);
+                return Some(true);
+            }
+            if mentions_local(statement, local) {
+                return None;
+            }
+        }
+        let shallow_cleanup = matches!(
+            &block.terminator.kind,
+            TerminatorKind::Drop { kind: DropKind::Conditional, place, .. }
+                if place == self.box_place
+        );
+        if mentions_local(&block.terminator, local) && !shallow_cleanup {
+            return None;
+        }
+        let mut reaches_init = false;
+        for target in block.targets() {
+            reaches_init |= self.visit(target)?;
+        }
+        if shallow_cleanup && reaches_init {
+            return None;
+        }
+        self.active.remove(&id);
+        self.reaches_init.insert(id, reaches_init);
+        Some(reaches_init)
+    }
+
+    fn find(mut self, allocation: BlockId) -> Option<(BlockId, usize)> {
+        self.visit(self.entry)?;
+        let assignment = self.assignment?;
+        // No other entry may reach a rewritten assignment. This also excludes
+        // edges back from initialized code into the uninitialized region. Shared
+        // exit-only cleanup tails remain unchanged; their conditional drops also
+        // serve paths on which the box has been fully initialized.
+        for (source, block) in self.body.iter_enumerated() {
+            for target in block.targets() {
+                if self.reaches_init.get(&target) == Some(&true)
+                    && !(source == allocation && target == self.entry)
+                    && (self.reaches_init.get(&source) != Some(&true) || source == assignment.0)
+                {
+                    return None;
+                }
+            }
+        }
+        Some(assignment)
+    }
+}
