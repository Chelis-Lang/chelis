+//@ no-check-output
+
+// `vec!` lowers to exchange_malloc + ShallowInitBox, unlike an ordinary
+// Box::new call. Keep the computations inside the macro's element expressions.
+pub fn checked_index(input: &[u32], index: usize, choose_first: bool) -> Vec<u32> {
+    vec![
+        if choose_first { input[index] } else { input[0] },
+        input[index],
+    ]
+}
+
+pub fn moved_values(left: Vec<u32>, right: Vec<u32>, choose_left: bool) -> Vec<Vec<u32>> {
+    vec![if choose_left { left } else { right }]
+}
+
+fn advance(state: &mut u32) -> u32 {
+    *state += 1;
+    *state
+}
+
+// The old same-block rewrite could move the aggregate before its operands were
+// initialized. Calls/checks/branches must also remain in left-to-right order.
+pub fn evaluation_order(state: &mut u32, first: bool) -> Vec<u32> {
+    vec![
+        advance(state),
+        if first { advance(state) } else { 99 },
+        advance(state),
+    ]
+}
+
+// Splitting the first initialization moves the second allocation's terminator
+// into a new block. That continuation must still be processed.
+pub fn successive_allocations(value: u32) -> (Vec<u32>, Vec<u32>) {
+    (vec![value], vec![value, value])
+}
+
+fn main() {
+    assert_eq!(checked_index(&[7, 8], 1, true), vec![8, 8]);
+    assert_eq!(checked_index(&[7, 8], 1, false), vec![7, 8]);
+    assert_eq!(moved_values(vec![1], vec![2], true), vec![vec![1]]);
+    assert_eq!(moved_values(vec![1], vec![2], false), vec![vec![2]]);
+    let mut state = 0;
+    assert_eq!(evaluation_order(&mut state, true), vec![1, 2, 3]);
+    assert_eq!(state, 3);
+    assert_eq!(evaluation_order(&mut state, false), vec![4, 99, 5]);
+    assert_eq!(state, 5);
+    assert_eq!(successive_allocations(6), (vec![6], vec![6, 6]));
+}
