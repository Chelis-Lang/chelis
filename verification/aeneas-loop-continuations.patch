+        | TypeGroup g ->
+            List.map (fun id -> IdType id) (g_declaration_group_to_list g)
+        | FunGroup g ->
+            List.map (fun id -> IdFun id) (g_declaration_group_to_list g)
+        | GlobalGroup g ->
+            List.map (fun id -> IdGlobal id) (g_declaration_group_to_list g)
+        | TraitDeclGroup g ->
+            List.map (fun id -> IdTraitDecl id) (g_declaration_group_to_list g)
+        | TraitImplGroup g ->
+            List.map (fun id -> IdTraitImpl id) (g_declaration_group_to_list g)
+        | MixedGroup g -> g_declaration_group_to_list g
+      in
+      (* Charon can retain an implementation in its maps but omit its
+         declaration when every use was a concrete method call. Introducing a
+         dictionary makes that implementation, and its dictionary dependencies,
+         real declarations again. Restore them before computing order. *)
+      let present =
+        List.fold_left
+          (fun present group ->
+            List.fold_left
+              (fun present id -> AnyDeclIdMap.add id () present)
+              present (group_ids group))
+          AnyDeclIdMap.empty declarations
+      in
+      let dependency_graph = ref AnyDeclIdMap.empty in
+      let add_dependency owner dependency =
+        match owner with
+        | IdTraitDecl id when TraitDeclId.Map.mem id modeled_traits ->
+            (* Imported dictionaries do not depend on Rust method bodies. *)
+            ()
+        | _ when owner = dependency -> ()
+        | _ ->
+            dependency_graph :=
+              AnyDeclIdMap.update owner
+                (fun deps ->
+                  Some
+                    (AnyDeclIdSet.add dependency
+                       (Option.value deps ~default:AnyDeclIdSet.empty)))
+                !dependency_graph
+      in
+      let uses = Deps.compute_graph_of_uses crate in
+      AnyDeclIdMap.iter
+        (fun dependency users ->
+          Deps.ItemInfoSet.iter
+            (fun (user : Deps.item_info) ->
+              match (user.id, dependency) with
+              | IdTraitDecl _, IdFun _ -> ()
+              | IdFun fid, IdTraitImpl iid
+                when (match (FunDeclId.Map.find fid crate.fun_decls).src with
+                     | TraitImplItem (parent, _, _, _) -> parent.id = iid
+                     | _ -> false)
+                     && not
+                          (TraitImplId.Set.mem iid
+                             (Option.value
+                                (FunDeclId.Map.find_opt fid !new_dictionary_uses)
+                                ~default:TraitImplId.Set.empty)) ->
+                  (* A concrete method's parent is metadata unless its body
+                     actually uses the parent's dictionary. *)
+                  ()
+              | IdFun fid, IdGlobal gid
+                when (FunDeclId.Map.find fid crate.fun_decls)
+                       .is_global_initializer = Some gid -> ()
+              | _ -> add_dependency user.id dependency)
+            users)
+        uses.graph;
+      (* Trait declarations require method signatures, not method bodies. *)
+      let signature_visitor =
+        object
+          inherit [_] iter_crate
+          method! visit_type_decl_id owner id = add_dependency owner (IdType id)
+          method! visit_fun_decl_id owner id = add_dependency owner (IdFun id)
+
+          method! visit_global_decl_id owner id =
+            add_dependency owner (IdGlobal id)
+
+          method! visit_trait_decl_id owner id =
+            add_dependency owner (IdTraitDecl id)
+
+          method! visit_trait_impl_id owner id =
+            add_dependency owner (IdTraitImpl id)
+        end
+      in
+      TraitDeclId.Map.iter
+        (fun id (decl : trait_decl) ->
+          List.iter
+            (fun (m : trait_method binder) ->
+              let f =
+                FunDeclId.Map.find m.binder_value.item.id crate.fun_decls
+              in
+              signature_visitor#visit_generic_params (IdTraitDecl id) f.generics;
+              signature_visitor#visit_fun_sig (IdTraitDecl id) f.signature)
+            decl.methods)
+        crate.trait_decls;
+      let required = ref AnyDeclIdSet.empty in
+      let pending = ref [] in
+      let require id =
+        (* Existing groups already have Charon's dependency closure. Restore
+           only newly needed definitions retained in the maps, not metadata
+           references to definitions removed by earlier passes. *)
+        if
+          (not (AnyDeclIdMap.mem id present))
+          && (not (AnyDeclIdSet.mem id !required))
+          &&
+          match id with
+          | IdType id -> TypeDeclId.Map.mem id crate.type_decls
+          | IdFun id -> FunDeclId.Map.mem id crate.fun_decls
+          | IdGlobal id -> GlobalDeclId.Map.mem id crate.global_decls
+          | IdTraitDecl id -> TraitDeclId.Map.mem id crate.trait_decls
+          | IdTraitImpl id -> TraitImplId.Map.mem id crate.trait_impls
+        then (
+          required := AnyDeclIdSet.add id !required;
+          pending := id :: !pending)
+      in
+      FunDeclId.Map.iter
+        (fun owner ids ->
+          if AnyDeclIdMap.mem (IdFun owner) present then
+            TraitImplId.Set.iter (fun id -> require (IdTraitImpl id)) ids)
+        !new_dictionary_uses;
+      FunDeclId.Map.iter
+        (fun owner ids ->
+          if AnyDeclIdMap.mem (IdFun owner) present then
+            FunDeclId.Set.iter (fun id -> require (IdFun id)) ids)
+        !new_method_uses;
+      while !pending <> [] do
+        let id = List.hd !pending in
+        pending := List.tl !pending;
+        AnyDeclIdSet.iter require
+          (Option.value
+             (AnyDeclIdMap.find_opt id !dependency_graph)
+             ~default:AnyDeclIdSet.empty)
+      done;
+      let additional =
+        AnyDeclIdSet.elements !required
+        |> List.map (function
+             | IdType id -> TypeGroup (NonRecGroup id)
+             | IdFun id -> FunGroup (NonRecGroup id)
+             | IdGlobal id -> GlobalGroup (NonRecGroup id)
+             | IdTraitDecl id -> TraitDeclGroup (NonRecGroup id)
+             | IdTraitImpl id -> TraitImplGroup (NonRecGroup id))
+      in
+      let declarations = declarations @ additional in
+      let crate = { crate with declarations } in
+      let groups = Array.of_list declarations in
+      let owners =
+        Array.fold_left
+          (fun (index, owners) group ->
+            ( index + 1,
+              List.fold_left
+                (fun owners id -> AnyDeclIdMap.add id index owners)
+                owners (group_ids group) ))
+          (0, AnyDeclIdMap.empty) groups
+        |> snd
+      in
+      let module DepScc = SCC.Make (Collections.OrderedInt) in
+      let module IntSet = DepScc.S in
+      let dependencies = Array.make (Array.length groups) IntSet.empty in
+      AnyDeclIdMap.iter
+        (fun owner deps ->
+          match AnyDeclIdMap.find_opt owner owners with
+          | None -> ()
+          | Some owner ->
+              AnyDeclIdSet.iter
+                (fun dependency ->
+                  match AnyDeclIdMap.find_opt dependency owners with
+                  | Some dependency when owner <> dependency ->
+                      dependencies.(owner) <-
+                        IntSet.add dependency dependencies.(owner)
+                  | _ -> ())
+                deps)
+        !dependency_graph;
+      (* Condense genuine cycles instead of rejecting every back-edge. Preserve
+         existing recursive groups and let the backend handle each kind of SCC;
+         in particular, mixed dictionary/function recursion must not be silently
+         linearized as if it were a sequence of non-recursive declarations. *)
+      let sccs =
+        DepScc.compute
+          (Array.to_list (Array.mapi (fun i deps -> (i, deps)) dependencies))
+      in
+      let merge_groups indices =
+        match indices with
+        | [ index ] -> groups.(index)
+        | _ -> (
+            let ids =
+              List.concat_map (fun index -> group_ids groups.(index)) indices
+            in
+            let types, funs, globals, traits, impls =
+              List.fold_left
+                (fun (ts, fs, gs, tds, tis) -> function
+                  | IdType id -> (id :: ts, fs, gs, tds, tis)
+                  | IdFun id -> (ts, id :: fs, gs, tds, tis)
+                  | IdGlobal id -> (ts, fs, id :: gs, tds, tis)
+                  | IdTraitDecl id -> (ts, fs, gs, id :: tds, tis)
+                  | IdTraitImpl id -> (ts, fs, gs, tds, id :: tis))
+                ([], [], [], [], []) ids
+            in
+            match (types, funs, globals, traits, impls) with
+            | ids, [], [], [], [] -> TypeGroup (RecGroup (List.rev ids))
+            | [], ids, [], [], [] -> FunGroup (RecGroup (List.rev ids))
+            | [], [], ids, [], [] -> GlobalGroup (RecGroup (List.rev ids))
+            | [], [], [], ids, [] -> TraitDeclGroup (RecGroup (List.rev ids))
+            | [], [], [], [], ids -> TraitImplGroup (RecGroup (List.rev ids))
+            | _ -> MixedGroup (RecGroup ids))
+      in
+      let declarations =
+        List.map
+          (fun (_, indices) -> merge_groups indices)
+          (SCC.SccId.Map.bindings sccs.sccs)
+      in
+      { crate with declarations }
+
+(** Fold only ABI-compatible modeled specializations. Whole-state contracts can
+    reconstruct captured mutable state, but a generic borrowed-output record
+    cannot express additional backward continuations. In that case retain the
+    specialized trait, method signatures, and dictionary references together.
+    Normalize modeled implementation references too: their specialized records
+    contain only Charon's demanded methods, not the model's native overrides and
+    marker evidence. Instantiating the original implementation preserves both.
+    Structured methods may also reuse the original body when its actual owned
+    state outputs form the complete canonical ABI, without native mutable
+    backward results. This preserves delayed restoration across conversions
+    instead of translating an artificial independent-lifetime body. *)
+let normalize_modeled_trait_specializations (crate : crate) : crate =
+  if Config.backend () <> Config.Lean then crate
+  else
+    let mctx = NameMatcher.ctx_from_crate crate in
+    let modeled name = ExtractBuiltin.find_trait_decl_info mctx name in
+    let specialization (name : name) =
+      match List.rev name with
+      | PeInstantiated shape :: rest -> Some (List.rev rest, shape)
+      | _ -> None
+    in
+    let traits =
+      TraitDeclId.Map.filter_map
+        (fun _ (decl : trait_decl) ->
+          match specialization decl.item_meta.name with
+          | Some (name, shape) -> (
+              match modeled name with
+              | Some info
+                when ModelStateABI.trait_specialization_is_compatible info shape
+                ->
+                  let original =
+                    List.find
+                      (fun (d : trait_decl) -> d.item_meta.name = name)
+                      (TraitDeclId.Map.values crate.trait_decls)
+                  in
+                  Some (original.def_id, shape)
+              | _ -> None)
+          | _ -> None)
+        crate.trait_decls
+    in
+    (* A canonical subtrait cannot contain a specialized parent dictionary.
+       Remove such candidates to a fixed point, including transitive parents. *)
+    let rec retain_specialized_parents traits =
+      let compatible =
+        TraitDeclId.Map.filter
+          (fun id _ ->
+            let decl = TraitDeclId.Map.find id crate.trait_decls in
+            let compatible = ref true in
+            let visitor =
+              object
+                inherit [_] iter_crate
+
+                method! visit_trait_decl_id _ parent_id =
+                  let parent =
+                    TraitDeclId.Map.find parent_id crate.trait_decls
+                  in
+                  if
+                    ExtractBuiltin.is_trait_specialization parent.item_meta.name
+                    && not (TraitDeclId.Map.mem parent_id traits)
+                  then compatible := false
+              end
+            in
+            List.iter (visitor#visit_trait_param ()) decl.implied_clauses;
+            !compatible)
+          traits
+      in
+      if TraitDeclId.Map.cardinal compatible = TraitDeclId.Map.cardinal traits
+      then compatible
+      else retain_specialized_parents compatible
+    in
+    let traits = retain_specialized_parents traits in
+    let compatible_trait id =
+      let decl = TraitDeclId.Map.find id crate.trait_decls in
+      match specialization decl.item_meta.name with
+      | Some _ -> TraitDeclId.Map.mem id traits
+      | None -> Option.is_some (modeled decl.item_meta.name)
+    in
+    let methods =
+      FunDeclId.Map.filter_map
+        (fun _ (decl : fun_decl) ->
+          match (decl.src, specialization decl.item_meta.name) with
+          | ( ( TraitDeclItem (trait_ref, _, _)
+              | TraitImplItem (_, trait_ref, _, _) ),
+              Some (name, shape) )
+            when compatible_trait trait_ref.id -> (
+              match
+                List.find_opt
+                  (fun (f : fun_decl) -> f.item_meta.name = name)
+                  (FunDeclId.Map.values crate.fun_decls)
+              with
+              | Some original ->
+                  let compatible =
+                    match (decl.body, decl.src) with
+                    | ( OpaqueBody,
+                        (TraitDeclItem _ | TraitImplItem (_, _, _, true)) ) ->
+                        true
+                    | StructuredBody _, _ ->
+                        Option.is_some
+                          (ModelStateInputs.canonical_body_state_inputs crate
+                             original)
+                    | _ -> false
+                  in
+                  if compatible then Some (original.def_id, shape) else None
+              | None -> None)
+          | _ -> None)
+        crate.fun_decls
+    in
+    let original_impls = TraitImplId.Map.values crate.trait_impls in
+    let impls =
+      TraitImplId.Map.filter_map
+        (fun _ (impl : trait_impl) ->
+          match specialization impl.item_meta.name with
+          | Some (name, shape)
+            when compatible_trait impl.impl_trait.id
+                 && List.for_all
+                      (fun (_, (method_ref : fun_decl_ref binder)) ->
+                        let id = method_ref.binder_value.id in
+                        let decl = FunDeclId.Map.find id crate.fun_decls in
+                        match
+                          (decl.body, specialization decl.item_meta.name)
+                        with
+                        | StructuredBody _, Some _ ->
+                            FunDeclId.Map.mem id methods
+                        | _ -> true)
+                      impl.methods -> (
+              match
+                List.find_opt
+                  (fun (original : trait_impl) ->
+                    original.item_meta.name = name)
+                  original_impls
+              with
+              | None -> None
+              | Some original -> Some (original.def_id, shape))
+          | _ -> None)
+        crate.trait_impls
+    in
+    if
+      TraitDeclId.Map.is_empty traits
+      && FunDeclId.Map.is_empty methods
+      && TraitImplId.Map.is_empty impls
+    then crate
+    else
+      let instantiate args shape =
+        Substitute.apply_args_to_binder args Substitute.generic_args_substitute
+          shape
+      in
+      let visitor =
+        object (self)
+          inherit [_] map_crate as super
+
+          method! visit_item_meta env meta =
+            let meta = super#visit_item_meta env meta in
+            (* Names are opaque to the generated visitor, but specialization
+               binders remain live substitutions after dictionary folding. *)
+            let name =
+              List.map
+                (function
+                  | PeInstantiated shape ->
+                      PeInstantiated
+                        (self#visit_binder self#visit_generic_args env shape)
+                  | elem -> elem)
+                meta.name
+            in
+            { meta with name }
+
+          method! visit_trait_decl_ref env tr =
+            match TraitDeclId.Map.find_opt tr.id traits with
+            | None -> super#visit_trait_decl_ref env tr
+            | Some (id, shape) ->
+                self#visit_trait_decl_ref env
+                  { id; generics = instantiate tr.generics shape }
+
+          method! visit_trait_impl_ref env impl =
+            match TraitImplId.Map.find_opt impl.id impls with
+            | None -> super#visit_trait_impl_ref env impl
+            | Some (id, shape) ->
+                self#visit_trait_impl_ref env
+                  { id; generics = instantiate impl.generics shape }
+
+          method! visit_fun_decl_ref env f =
+            match FunDeclId.Map.find_opt f.id methods with
+            | None -> super#visit_fun_decl_ref env f
+            | Some (id, shape) ->
+                self#visit_fun_decl_ref env
+                  { id; generics = instantiate f.generics shape }
+
+          method! visit_fn_ptr env ptr =
+            match ptr.kind with
+            | FunId (FRegular fid) when FunDeclId.Map.mem fid methods ->
+                let id, shape = FunDeclId.Map.find fid methods in
+                super#visit_fn_ptr env
+                  {
+                    kind = FunId (FRegular id);
+                    generics = instantiate ptr.generics shape;
+                  }
+            | TraitMethod (tr, name, fid) ->
+                let fid =
+                  match FunDeclId.Map.find_opt fid methods with
+                  | Some (id, _) -> id
+                  | None -> fid
+                in
+                super#visit_fn_ptr env
+                  { ptr with kind = TraitMethod (tr, name, fid) }
+            | _ -> super#visit_fn_ptr env ptr
+        end
+      in
+      let seen_traits = ref TraitDeclId.Set.empty in
+      let seen_impls = ref TraitImplId.Set.empty in
+      let seen_methods = ref FunDeclId.Set.empty in
+      let groups =
+        object
+          inherit [_] filter_decl_id
+
+          method! visit_trait_decl_id _ id =
+            let id =
+              match TraitDeclId.Map.find_opt id traits with
+              | Some (id, _) -> id
+              | None -> id
+            in
+            if TraitDeclId.Set.mem id !seen_traits then None
+            else (
+              seen_traits := TraitDeclId.Set.add id !seen_traits;
+              Some id)
+
+          method! visit_trait_impl_id _ id =
+            let id =
+              match TraitImplId.Map.find_opt id impls with
+              | Some (id, _) -> id
+              | None -> id
+            in
+            if TraitImplId.Set.mem id !seen_impls then None
+            else (
+              seen_impls := TraitImplId.Set.add id !seen_impls;
+              Some id)
+
+          method! visit_fun_decl_id _ id =
+            let id =
+              match FunDeclId.Map.find_opt id methods with
+              | Some (id, _) -> id
+              | None -> id
+            in
+            if FunDeclId.Set.mem id !seen_methods then None
+            else (
+              seen_methods := FunDeclId.Set.add id !seen_methods;
+              Some id)
+        end
+      in
+      let crate =
+        {
+          crate with
+          trait_decls =
+            TraitDeclId.Map.filter
+              (fun id _ -> not (TraitDeclId.Map.mem id traits))
+              crate.trait_decls;
+          trait_impls =
+            TraitImplId.Map.filter
+              (fun id _ -> not (TraitImplId.Map.mem id impls))
+              crate.trait_impls;
+          fun_decls =
+            FunDeclId.Map.filter
+              (fun id _ -> not (FunDeclId.Map.mem id methods))
+              crate.fun_decls;
+          declarations = groups#visit_declaration_groups () crate.declarations;
+        }
+      in
+      visitor#visit_crate () crate
+
+(** Some provided methods cannot occur in the model record because their bounds
+    depend on that record (Iterator.collect / FromIterator). The model must
+    explicitly restrict them to inherited-default dictionaries. Check Rust
+    provenance for every canonical implementation before lowering any generic
+    projection; an absent method or an opaque body is not evidence.
+
+    Charon's [reuses_default] is also true for implementations of required
+    methods, so it proves inheritance only together with the declaration's
+    [has_default]. Concrete calls keep their normal implementation dispatch. *)
+let resolve_default_only_dispatch (crate : crate) : crate =
+  if Config.backend () <> Config.Lean then crate
+  else
+    let mctx = NameMatcher.ctx_from_crate crate in
+    let checked = ref [] in
+    let check (decl : trait_decl) method_name =
+      if not (List.mem (decl.def_id, method_name) !checked) then (
+        let method_decl =
+          match
+            List.find_opt
+              (fun (method_decl : trait_method binder) ->
+                method_decl.binder_value.name = method_name)
+              decl.methods
+          with
+          | Some method_decl ->
+              FunDeclId.Map.find method_decl.binder_value.item.id
+                crate.fun_decls
+          | None ->
+              [%craise] decl.item_meta.span
+                ("Default-only method lacks a Rust declaration: " ^ method_name)
+        in
+        [%cassert] method_decl.item_meta.span
+          (match method_decl.src with
+          | TraitDeclItem (tr, name, true) ->
+              tr.id = decl.def_id && name = method_name
+          | _ -> false)
+          ("Default-only dispatch requires a Rust provided method: "
+         ^ method_name);
+        [%cassert] method_decl.item_meta.span
+          (Option.is_some
+             (ExtractBuiltin.NameMatcherMap.find_opt mctx
+                method_decl.item_meta.name
+                (ExtractBuiltin.builtin_funs_map ())))
+          ("Default-only method lacks a standalone model: " ^ method_name);
+        TraitImplId.Map.iter
+          (fun _ (impl : trait_impl) ->
+            if impl.impl_trait.id = decl.def_id then
+              let name () =
+                Print.name_to_string
+                  (Print.crate_to_fmt_env crate)
+                  impl.item_meta.name
+              in
+              match List.assoc_opt method_name impl.methods with
+              | None ->
+                  [%craise] impl.item_meta.span
+                    ("Default-only dispatch for " ^ method_name
+                   ^ " lacks inherited-default evidence in " ^ name ())
+              | Some method_ref -> (
+                  let implementation =
+                    FunDeclId.Map.find method_ref.binder_value.id
+                      crate.fun_decls
+                  in
+                  match implementation.src with
+                  | TraitImplItem (owner, tr, name, true)
+                    when owner.id = impl.def_id && tr.id = decl.def_id
+                         && name = method_name -> ()
+                  | _ ->
+                      [%craise] implementation.item_meta.span
+                        ("Default-only dispatch for " ^ method_name
+                       ^ " conflicts with a native override or unproven method \
+                          in " ^ name ())))
+          crate.trait_impls;
+        checked := (decl.def_id, method_name) :: !checked)
+    in
+    let visitor =
+      object
+        inherit [_] map_crate as super
+
+        method! visit_fn_ptr env ptr =
+          let ptr = super#visit_fn_ptr env ptr in
+          match ptr.kind with
+          | TraitMethod ({ kind = TraitImpl _; _ }, _, _) -> ptr
+          | TraitMethod (tr, method_name, _) -> (
+              let decl =
+                TraitDeclId.Map.find tr.trait_decl_ref.binder_value.id
+                  crate.trait_decls
+              in
+              match
+                ExtractBuiltin.find_trait_decl_info mctx decl.item_meta.name
+              with
+              | Some info when List.mem method_name info.default_only_methods ->
+                  [%cassert] decl.item_meta.span
+                    (not (List.mem_assoc method_name info.methods))
+                    "A default-only method must not also be a dictionary field";
+                  check decl method_name;
+                  let method_ref =
+                    [%unwrap_with_span] decl.item_meta.span
+                      (Substitute.lookup_and_subst_trait_decl_method decl
+                         method_name tr ptr.generics)
+                      "Missing checked standalone default"
+                  in
+                  {
+                    kind = FunId (FRegular method_ref.id);
+                    generics = method_ref.generics;
+                  }
+              | _ -> ptr)
+          | _ -> ptr
+      end
+    in
+    visitor#visit_crate () crate
+
+(** Optimized upstream MIR may use [Copy] at a non-Copy value's last use
+    (including an unconstrained generic parameter). Recover the ownership
+    transfer before symbolic execution. A place must be locally owned, used only
+    once by the statement, and dead on every successor, including indirect uses
+    through live borrowers. Never turn a read through a reference or a global
+    into a move. *)
+let recover_last_use_moves (_crate : crate) (f : fun_decl) : fun_decl =
+  let rec owned_local (p : place) =
+    match p.kind with
+    | PlaceLocal id -> Some id
+    | PlaceProjection (p, Field _) -> owned_local p
+    | PlaceProjection _ | PlaceGlobal _ -> None
+  in
+  (* Direct variable liveness does not cover references already handed to
+     another local. Keep conservative provenance edges through reference-bearing
+     assignments and call results, including wrappers and generic values. *)
+  let rec may_store_borrow = function
+    | TRef _ | TVar _ | TTraitType _ | TDynTrait _ | TError _ -> true
+    | TAdt { generics; _ } ->
+        generics.regions <> [] || List.exists may_store_borrow generics.types
+    | TArray (ty, _) | TSlice ty -> may_store_borrow ty
+    | TLiteral _ | TNever | TRawPtr _ | TFnDef _ | TFnPtr _ | TPtrMetadata _ ->
+        false
+  in
+  let rec may_write_borrows = function
+    | TRef (_, ty, RMut) -> may_store_borrow ty
+    | TAdt { generics; _ } ->
+        generics.regions <> [] || List.exists may_write_borrows generics.types
+    | TArray (ty, _) | TSlice ty -> may_write_borrows ty
+    | TVar _ | TTraitType _ | TDynTrait _ | TError _ -> true
+    | TRef (_, _, RShared)
