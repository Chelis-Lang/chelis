+  | ( "_root_.Aeneas.Std.core.iter.traits.double_ended.DoubleEndedIterator",
+      ("next_back" | "nth_back" | "advance_back_by") ) -> Some [ 0 ]
+  | ( "_root_.Aeneas.Std.core.iter.traits.iterator.Iterator",
+      ("any" | "all" | "find" | "find_map" | "position") )
+  | ( "_root_.Aeneas.Std.core.iter.traits.double_ended.DoubleEndedIterator",
+      "rfind" ) -> Some [ 0; 1 ]
+  | "_root_.Aeneas.Std.core.iter.traits.iterator.Iterator", ("fold" | "try_fold")
+  | ( "_root_.Aeneas.Std.core.iter.traits.double_ended.DoubleEndedIterator",
