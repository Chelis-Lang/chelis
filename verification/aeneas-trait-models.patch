+  if Config.backend () <> Config.Lean then []
+  else
+    match (decl.src, decl.body) with
+    | TraitImplItem (_, tr, method_name, _), StructuredBody _ ->
+        let trait_decl = TraitDeclId.Map.find tr.id crate.trait_decls in
+        let name =
+          String.concat "."
+            ("_root_.Aeneas.Std"
+            :: List.filter_map
+                 (function
+                   | PeIdent (name, _) -> Some name
+                   | _ -> None)
+                 trait_decl.item_meta.name)
+        in
+        let indices = Option.value ~default:[] (for_method name method_name) in
+        let owned =
