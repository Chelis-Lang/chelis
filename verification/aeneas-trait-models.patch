+              let decl = TypeDeclId.Map.find id crate.type_decls in
+              match decl.kind with
+              | Struct _ ->
+                  Substitute.type_decl_get_instantiated_field_types decl None
+                    generics
+              | _ -> generics.types)
+          | _ -> generics.types
+        in
+        List.exists (has_hidden_state crate (ty :: seen)) fields
+    | TArray (ty, _) | TSlice ty -> has_hidden_state crate (ty :: seen) ty
+    | _ -> false
