+          match
+            marker_kind
+              (TraitDeclId.Map.find marker.impl_trait.trait_decl_id decls)
+          with
+          | None -> fields
+          | Some (provider, field) ->
+              List.fold_left
+                (fun fields (parent : trait_ref) ->
+                  match parent.trait_id with
+                  | TraitImpl (id, args)
+                    when model_name parent.trait_decl_ref.trait_decl_id
+                         = Some provider ->
+                      let target = TraitImplId.Map.find id impls in
+                      if Option.is_some target.builtin_info then fields
+                      else
+                        let identity = generic_args_of_params target.generics in
+                        [%cassert] marker.item_meta.span
+                          (args.types = identity.types
+                          && args.const_generics = identity.const_generics
+                          && List.length marker.generics.types
+                             = List.length target.generics.types
+                          && List.length marker.generics.const_generics
+                             = List.length target.generics.const_generics)
+                          "Type-specialized iterator markers require explicit \
+                           type evidence in the model dictionary";
+                        let conditions =
+                          List.concat_map
+                            (condition marker.item_meta.span target)
+                            marker.generics.trait_clauses
+                        in
+                        TraitImplId.Map.update id
+                          (fun current ->
+                            let current = Option.value ~default:[] current in
+                            let alternatives =
+                              Option.value ~default:[]
+                                (List.assoc_opt field current)
+                            in
+                            Some
+                              ((field, conditions :: alternatives)
+                              :: List.remove_assoc field current))
+                          fields
+                  | _ -> fields)
+                fields marker.parent_trait_refs)
+        impls TraitImplId.Map.empty
+    in
+    (* Normalization can redirect a marker's parent to the canonical impl while
+       retaining a structured specialization of that same iterator. Its marker
+       evidence is the original evidence instantiated with its dictionary
+       arguments, not evidence inferred from its concrete self type. *)
+    let originals = TraitImplId.Map.values impls in
+    let collected = ref TraitImplId.Map.empty in
+    let rec collect (target : trait_impl) =
+      match TraitImplId.Map.find_opt target.def_id !collected with
+      | Some fields -> fields
+      | None ->
+          let fields = collect_uncached target in
+          collected := TraitImplId.Map.add target.def_id fields !collected;
+          fields
+    and collect_uncached (target : trait_impl) =
+      let direct =
+        Option.value ~default:[] (TraitImplId.Map.find_opt target.def_id fields)
+      in
+      match List.rev target.item_meta.name with
+      | T.PeInstantiated shape :: rest
+        when Option.is_none target.builtin_info
+             && Option.is_some (model_name target.impl_trait.trait_decl_id) ->
+          let name = List.rev rest in
+          let original =
+            List.find_opt
+              (fun (impl : trait_impl) -> impl.item_meta.name = name)
+              originals
+          in
+          let inherited =
+            match original with
+            | None -> []
+            | Some original ->
+                let evidence = collect original in
+                if evidence = [] then []
+                else
+                  let span = Some target.item_meta.span in
+                  let args =
+                    Charon.TypesUtils.generic_args_of_params span
+                      target.llbc_generics
+                  in
+                  let args =
+                    Substitute.apply_args_to_binder args
+                      Substitute.generic_args_substitute shape
+                    |> translate_sgeneric_args span
+                  in
+                  let dictionaries =
+                    List.combine original.generics.trait_clauses args.trait_refs
+                  in
+                  let instantiate (clause_id, field) =
+                    let _, (dictionary : trait_ref) =
+                      List.find
+                        (fun ((clause : trait_param), _) ->
+                          clause.clause_id = clause_id)
+                        dictionaries
+                    in
+                    match dictionary.trait_id with
+                    | Clause (Free id)
+                      when List.exists
+                             (fun (clause : trait_param) ->
+                               clause.clause_id = id
+                               && clause.trait_id
+                                  = dictionary.trait_decl_ref.trait_decl_id
+                               && clause.generics
+                                  = dictionary.trait_decl_ref.decl_generics)
+                             target.generics.trait_clauses -> (id, field)
+                    | _ ->
+                        [%craise] target.item_meta.span
+                          ("Cannot preserve a specialized iterator marker \
+                            without its trait dictionary evidence: "
+                         ^ show_trait_ref dictionary ^ "; available clauses: "
+                          ^ show_generic_params target.generics)
+                  in
+                  List.map
+                    (fun (field, alternatives) ->
+                      (field, List.map (List.map instantiate) alternatives))
+                    evidence
+          in
+          let fields =
+            List.fold_left
+              (fun fields (field, alternatives) ->
+                let existing =
+                  Option.value ~default:[] (List.assoc_opt field fields)
+                in
+                (field, existing @ alternatives)
+                :: List.remove_assoc field fields)
+              direct inherited
+          in
+          fields
+      | _ -> direct
+    in
+    TraitImplId.Map.iter (fun _ impl -> ignore (collect impl)) impls;
+    !collected
+
+let is_callable_trait ctx id =
+  match trait_model_name ctx id with
+  | Some
+      ( "_root_.Aeneas.Std.core.ops.function.FnOnce"
+      | "_root_.Aeneas.Std.core.ops.function.FnMut"
+      | "_root_.Aeneas.Std.core.ops.function.Fn" ) -> true
+  | _ -> false
+
+let for_call (ctx : Contexts.decls_ctx) (fid : A.fn_ptr_kind) =
+  if Config.backend () <> Config.Lean then None
+  else
+    match fid with
+    | TraitMethod (tr, name, _) ->
+        Option.map
+          (fun contract -> Canonical contract)
+          (for_trait ctx tr.trait_decl_ref.binder_value.id name)
+    | FunId (FRegular id) -> (
+        let decl = A.FunDeclId.Map.find id ctx.fun_ctx.fun_decls in
+        (* A local body is a canonical boundary only if its real signature
+           returns every owned state and has no native mutable backward ABI. *)
+        match
+          TranslateCore.match_name_find_opt ctx decl.item_meta.name
+            (ExtractBuiltin.builtin_funs_map ())
+        with
+        | None ->
+            Option.map
+              (fun indices -> TranslatedCanonicalBody indices)
+              (ModelStateInputs.canonical_body_state_inputs ctx.crate decl)
+        | Some info
+          when info.extract_name
+               = "_root_.Aeneas.Std.core.slice.iter.IteratorIterMut.next" ->
+            Some (LendingState 0)
+        | Some info
+          when info.extract_name
+               = "_root_.Aeneas.Std.core.slice.iter.IntoIteratorMutSlice.into_iter"
+               || info.extract_name
+                  = "_root_.Aeneas.Std.alloc.vec.IntoIteratorMutVec.into_iter"
+          -> Some (BorrowedStorage 0)
+        | Some info
+          when info.extract_name
+               = "_root_.Aeneas.Std.alloc.slice.Slice.sort_by_key" ->
+            Some (Canonical (State [ 0; 1 ]))
+        | Some info
+          when info.extract_name = "_root_.Aeneas.Std.core.hint.must_use"
+               || info.extract_name
+                  = "_root_.Aeneas.Std.core.convert.FromSame.from_"
+               || info.extract_name
+                  = "_root_.Aeneas.Std.core.convert.FromBox.from_" ->
+            Some (Canonical Constructor)
+        | Some info
+          when info.extract_name = "_root_.Aeneas.Std.core.bool.then_some" ->
+            Some (Canonical (ConstructorWithState [ 1 ]))
+        | Some _ ->
+            let contract =
+              match decl.src with
+              | T.TraitImplItem (_, tr, name, _) -> for_trait ctx tr.id name
+              | T.TraitDeclItem (tr, name, _) -> for_trait ctx tr.id name
+              | _ -> None
+            in
+            Option.map (fun contract -> Canonical contract) contract)
+    | FunId (FBuiltin _) -> None
+
+let region_group (span : Meta.span) (sg : A.inst_fun_sig) =
+  let groups =
+    T.RegionId.Map.of_list
+      (List.concat_map
+         (fun (g : T.region_var_group) ->
+           List.map (fun r -> (r, g.id)) g.regions)
+         sg.regions_hierarchy)
+  in
+  function
+  | T.RVar (Free r) -> T.RegionId.Map.find r groups
+  | _ -> [%craise] span "Canonical model state requires instantiated regions"
+
+let tuple_fields span (e : texpr) tys =
+  match tys with
+  | [] -> []
+  | [ _ ] -> [ e ]
+  | _ -> List.mapi (fun i ty -> mk_adt_proj span e (T.FieldId.of_int i) ty) tys
+
+(** The backward translation filters tuple fields but keeps a struct's shape.
+    Never identify a source field merely by its erased Lean type. *)
+let rec project_back span ctx get_group gid level ty (e : texpr) =
+  match translate_back_ty_aux (Some span) ctx get_group gid level ty with
+  | None -> None
+  | Some target when target = e.ty -> Some e
+  | Some target ->
+      let value =
+        match ty with
+        | T.TRef (_, ty, _) -> project_back span ctx get_group gid level ty e
+        | T.TAdt { id = T.TBuiltin T.TBox; generics = { types = [ ty ]; _ } } ->
+            project_back span ctx get_group gid level ty e
+        | T.TAdt { id = T.TTuple; generics } ->
+            let fields =
+              tuple_fields span e
+                (List.map (translate_fwd_ty (Some span) ctx) generics.types)
+            in
+            Some
+              (mk_simpl_tuple_texpr span
+                 (List.filter_map
+                    (fun (ty, e) ->
+                      project_back span ctx get_group gid level ty e)
+                    (List.combine generics.types fields)))
+        | _ -> [%craise] span "Unsupported structural model-state projection"
+      in
+      Option.iter
+        (fun (e : texpr) -> [%sanity_check] span (e.ty = target))
+        value;
+      value
+
+let rec without_outer_ref = function
+  | T.TRef (_, ty, _) -> without_outer_ref ty
+  | ty -> ty
+
+(** Find an input carried by an adapter constructor. The actual LLBC body is
+    required: model field names and erased type equality are not evidence. *)
+let constructor_input span (ctx : Contexts.decls_ctx) input_ty output_ty output
+    =
+  let rec find seen ty e =
+    if ty = input_ty then [ e ]
+    else if List.mem ty seen then []
+    else
+      match ty with
+      | T.TRef (_, ty, _) -> find (ty :: seen) ty e
+      | T.TAdt { id = T.TBuiltin T.TBox; generics = { types = [ ty ]; _ } } ->
+          find seen ty e
+      | T.TAdt { id; generics } ->
+          let fields =
+            match id with
+            | T.TTuple -> generics.types
+            | T.TAdtId id -> (
+                let decl = T.TypeDeclId.Map.find id ctx.type_ctx.type_decls in
+                match decl.kind with
+                | T.Struct _ ->
+                    Substitute.type_decl_get_instantiated_field_types decl None
+                      generics
+                | _ -> [])
+            | _ -> []
+          in
+          List.concat
+            (List.mapi
+               (fun i field_ty ->
+                 let field =
+                   match (id, fields) with
+                   | T.TTuple, [ _ ] -> e
+                   | _ ->
+                       mk_adt_proj span e (T.FieldId.of_int i)
+                         (translate_fwd_ty (Some span) ctx field_ty)
+                 in
+                 find (ty :: seen) field_ty field)
+               fields)
+      | _ -> []
+  in
+  match find [] output_ty output with
+  | [ value ] -> value
+  | _ ->
+      [%craise] span
+        "Model constructor recovery requires one structurally identified \
+         source input"
+
+let check_callable_args span ctx (fid : A.fn_ptr_kind) (sg : A.inst_fun_sig) =
+  let callable =
+    match fid with
+    | TraitMethod (tr, name, _) ->
+        (name = "call_once" || name = "call_mut" || name = "call")
+        && is_callable_trait ctx tr.trait_decl_ref.binder_value.id
+    | FunId (FRegular id) -> (
+        let decl = A.FunDeclId.Map.find id ctx.Contexts.fun_ctx.fun_decls in
+        match decl.src with
+        | T.TraitImplItem (_, tr, name, _) ->
+            (name = "call_once" || name = "call_mut" || name = "call")
+            && is_callable_trait ctx tr.id
+        | _ -> false)
+    | _ -> false
+  in
+  if callable then
+    List.iter
+      (fun ty ->
+        [%cassert] span
+          (not
+             (TypesUtils.ty_has_mut_borrows ctx.Contexts.type_ctx.type_infos ty))
+          "Callable model ABI does not yet support consumed Args containing \
+           mutable borrows")
+      (List.tl sg.inputs)
+
+let check_generic_contracts span (ctx : Contexts.decls_ctx)
+    (generics : T.generic_args) =
+  let has_mut = TypesUtils.ty_has_mut_borrows ctx.type_ctx.type_infos in
+  let visitor =
+    object
+      inherit [_] T.iter_ty as super
+
+      method! visit_trait_ref env tr =
+        let decl = tr.T.trait_decl_ref.binder_value in
+        (match (trait_model_name ctx decl.id, decl.generics.types) with
+        | ( Some
+              ( "_root_.Aeneas.Std.core.ops.function.FnOnce"
+              | "_root_.Aeneas.Std.core.ops.function.FnMut"
+              | "_root_.Aeneas.Std.core.ops.function.Fn" ),
+            _self :: args :: _ ) ->
+            [%cassert] span
+              (not (has_mut args))
+              "Callable model ABI does not yet support consumed Args \
+               containing mutable borrows"
+        | ( Some "_root_.Aeneas.Std.core.iter.traits.collect.IntoIterator",
+            [ source; item; target ] ) ->
+            [%cassert] span
+              ((not (has_mut source)) || source = target || not (has_mut item))
+              "Consuming conversion cannot recover yielded mutable elements \
+               from residual iterator state"
+        | _ -> ());
+        super#visit_trait_ref env tr
+    end
+  in
+  visitor#visit_generic_args () generics
+
+(** Convert one canonical model call to the region-indexed symbolic ABI. [fresh]
+    allocates Pure variables in the caller's context. *)
+let adapt_canonical_call span ctx fresh fid contract ~translated_body
+    (sg : A.inst_fun_sig) (dsg : decomposed_fun_type)
+    (owned_outputs : owned_state_output list) (func : texpr) (args : texpr list)
+    =
+  check_callable_args span ctx fid sg;
+  [%cassert] span
+    (contract <> IntoIterator
+    || (not
+          (TypesUtils.ty_has_mut_borrows ctx.Contexts.type_ctx.type_infos
+             (List.hd sg.inputs)))
+    || List.hd sg.inputs = sg.output
+    ||
+    match fid with
+    | TraitMethod (tr, _, _) -> (
+        (* Mutable iterator captures remain in the carrier. Only yielded
+              mutable items can escape a residual-state restoration lens. *)
+        match tr.trait_decl_ref.binder_value.generics.types with
+        | [ _; item; _ ] ->
+            not (TypesUtils.ty_has_mut_borrows ctx.type_ctx.type_infos item)
+        | _ -> false)
+    | _ -> false)
+    "Consuming conversion cannot recover yielded mutable elements from \
+     residual iterator state";
+  let carries_input_state =
+    match contract with
+    | Constructor | ConstructorWithState _ | IntoIterator -> true
+    | State _ -> false
+  in
+  [%cassert] span
+    (carries_input_state
+    || not
+         (TypesUtils.ty_has_mut_borrows ctx.Contexts.type_ctx.type_infos
+            sg.output))
+    "Canonical model state does not yet support lending mutable output items";
+  let get_group = region_group span sg in
+  let input_tys = List.map (fun (arg : texpr) -> arg.ty) args in
+  let raw_tys =
+    match contract with
+    | State indices ->
+        dsg.fwd_output :: List.map (fun i -> (List.nth args i).ty) indices
+    | Constructor -> [ dsg.fwd_output ]
+    | ConstructorWithState indices ->
+        dsg.fwd_output
+        :: List.map
+             (fun index -> TArrow (dsg.fwd_output, (List.nth args index).ty))
+             indices
+    | IntoIterator ->
+        [ dsg.fwd_output; TArrow (dsg.fwd_output, (List.hd args).ty) ]
+  in
+  let vars = List.map (fresh (Some "model_state")) raw_tys in
+  let values = List.map mk_texpr_from_fvar vars in
+  let result = List.hd values in
+  let raw_ty = mk_simpl_tuple_ty raw_tys in
+  let can_fail = dsg.fwd_info.effect_info.can_fail in
+  let raw_output_ty = if can_fail then mk_result_ty raw_ty else raw_ty in
+  let raw_func_ty = mk_arrows input_tys raw_output_ty in
+  if translated_body then
+    [%cassert] span (func.ty = raw_func_ty)
+      "Translated canonical body has additional native results or an \
+       incompatible state contract";
+  let raw_call = [%add_loc] mk_apps span { func with ty = raw_func_ty } args in
+  let initial_states =
+    match contract with
+    | State indices -> List.combine indices (List.tl values)
+    | Constructor | ConstructorWithState _ | IntoIterator -> []
+  in
+  let constructor_restorers =
+    match contract with
+    | ConstructorWithState indices -> List.combine indices (List.tl values)
+    | State _ | Constructor | IntoIterator -> []
+  in
+  let owned_output request =
+    let index =
+      match request with
+      | CurrentState index | RestoreState index -> index
+    in
+    [%cassert] span
+      (index >= 0 && index < List.length args && index < List.length sg.inputs)
+      "Model owned-state recovery refers to an unavailable input";
+    let value =
+      match request with
+      | CurrentState _ -> (
+          match List.assoc_opt index initial_states with
+          | Some state -> state
+          | None ->
+              [%craise] span
+                "Model ABI did not return a required owned input state")
+      | RestoreState _ -> (
+          match contract with
+          | IntoIterator when index = 0 -> List.nth values 1
+          | ConstructorWithState _ -> (
+              match List.assoc_opt index constructor_restorers with
+              | Some restore -> restore
+              | None ->
+                  [%craise] span
+                    "Model constructor did not return recovery for a required \
+                     owned input")
+          | Constructor ->
+              let output = fresh (Some "final_output") dsg.fwd_output in
+              let state =
+                constructor_input span ctx (List.nth sg.inputs index) sg.output
+                  (mk_texpr_from_fvar output)
+              in
+              mk_closed_lambdas span [ mk_tpat_from_fvar None output ] state
+          | State _ | IntoIterator ->
+              [%craise] span
+                "Model ABI did not return an owned input restoration lens")
+    in
+    [%cassert] span
+      (value.ty = owned_state_output_ty request input_tys dsg.fwd_output)
+      "Model owned-state recovery has an incompatible type";
+    value
+  in
+  let declared_states =
+    List.map
+      (fun (index, ty) ->
+        let state = owned_output (CurrentState index) in
+        [%cassert] span (state.ty = ty)
+          "Model declared state output has an incompatible type";
+        state)
+      dsg.state_outputs
+  in
+  let owned_states = List.map owned_output owned_outputs in
+  let backs =
+    List.filter_map
+      (fun (gid, (back : back_sg_info)) ->
+        if
+          !Config.simplify_merged_fwd_backs
+          && back.inputs = [] && back.outputs = []
+        then None
+        else (
+          [%cassert] span
+            (List.for_all (fun (level, _) -> level = 0) back.outputs)
+            "Model state recovery does not support higher-level backward \
+             outputs";
+          let parameters =
+            List.map
+              (fun (_, tys) ->
+                fresh (Some "state_back") (mk_simpl_tuple_ty (List.map snd tys)))
+              back.inputs
+          in
+          let supplied =
+            List.concat
+              (List.map2
+                 (fun (level, tys) var ->
+                   let es =
+                     tuple_fields span (mk_texpr_from_fvar var)
+                       (List.map snd tys)
+                   in
+                   let inputs =
+                     List.mapi (fun i ty -> (Some i, ty, true)) sg.inputs
+                   in
+                   let sources =
+                     (if level = 0 then [] else inputs)
+                     @ if level = 0 then [ (None, sg.output, false) ] else []
+                   in
+                   let sources =
+                     List.filter_map
+                       (fun (i, ty, from_input) ->
+                         Option.map
+                           (fun _ -> i)
+                           (translate_back_input_ty (Some span) ctx get_group
+                              gid level ~from_input ty))
+                       sources
+                   in
+                   [%sanity_check] span (List.length sources = List.length es);
+                   List.combine sources es)
+                 back.inputs parameters)
+          in
+          let state i ty =
+            match List.assoc_opt (Some i) supplied with
+            | Some state -> state
+            | None -> (
+                match List.assoc_opt i initial_states with
+                | Some state -> state
+                | None -> (
+                    match (contract, List.assoc_opt None supplied) with
+                    | Constructor, Some output ->
+                        constructor_input span ctx ty sg.output output
+                    | ConstructorWithState _, Some output -> (
+                        match List.assoc_opt i constructor_restorers with
+                        | Some restore -> [%add_loc] mk_app span restore output
+                        | None ->
+                            [%craise] span
+                              "Model constructor did not return recovery for a \
+                               required input")
+                    | IntoIterator, Some output ->
+                        [%add_loc] mk_app span (List.nth values 1) output
+                    | _ ->
+                        [%craise] span
+                          "Model ABI did not return a required mutable input \
+                           state"))
+          in
+          let outputs =
+            List.filter_map
+              (fun (i, ty) ->
+                match
+                  translate_back_output_ty (Some span) ctx get_group gid 0
+                    ~from_input:true ty
+                with
+                | None -> None
+                | Some _ ->
+                    let state = state i ty in
+                    project_back span ctx get_group gid 0 ty state)
+              (List.mapi (fun i ty -> (i, ty)) sg.inputs)
+          in
+          let body = mk_simpl_tuple_texpr span outputs in
+          Some
+            (mk_closed_lambdas span
+               (List.map (mk_tpat_from_fvar None) parameters)
+               body)))
+      (T.RegionGroupId.Map.bindings dsg.back_sg)
+  in
+  let output =
+    mk_simpl_tuple_texpr span
+      ((if dsg.fwd_info.ignore_output then [] else [ result ])
+      @ declared_states @ owned_states @ backs)
+  in
+  mk_closed_let span can_fail
+    (mk_simpl_tuple_pat (List.map (mk_tpat_from_fvar None) vars))
+    raw_call
+    (if can_fail then mk_result_ok_texpr span output else output)
+
+let adapt_call span ctx fresh fid abi (sg : A.inst_fun_sig)
+    (dsg : decomposed_fun_type) (owned_outputs : owned_state_output list)
+    (func : texpr) (args : texpr list) =
+  match abi with
+  | Canonical contract ->
+      adapt_canonical_call span ctx fresh fid contract ~translated_body:false sg
+        dsg owned_outputs func args
+  | TranslatedCanonicalBody indices ->
+      [%cassert] span
+        (List.map fst dsg.state_outputs = indices)
+        "Translated canonical body is missing authoritative owned state";
+      adapt_canonical_call span ctx fresh fid (State indices)
+        ~translated_body:true sg dsg owned_outputs func args
+  | LendingState index ->
+      [%cassert] span
+        (owned_outputs = [] && dsg.state_outputs = [])
+        "Lending iterator ABI does not supply additional owned input state";
+      let state_ty = (List.nth args index).ty in
+      let lens_ty = mk_arrows [ state_ty; dsg.fwd_output ] state_ty in
+      let expected =
+        mk_result_ty (mk_simpl_tuple_ty [ dsg.fwd_output; state_ty; lens_ty ])
+      in
+      let call = [%add_loc] mk_apps span func args in
+      [%cassert] span (call.ty = expected)
+        "Lending iterator model does not implement the required nested region \
+         ABI";
+      (* Keep the real model lens and every region-indexed result unchanged. *)
+      call
+  | BorrowedStorage index ->
+      [%cassert] span
+        (owned_outputs = [] && dsg.state_outputs = [])
+        "Borrowed storage ABI does not supply additional owned input state";
+      [%cassert] span
+        (match List.nth sg.inputs index with
+        | T.TRef (_, _, T.RMut) -> true
+        | _ -> false)
+        "Borrowed storage model requires a mutable source view";
