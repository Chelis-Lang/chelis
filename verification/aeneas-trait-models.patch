+  | "_root_.Aeneas.Std.core.iter.traits.iterator.Iterator", ("collect" | "count")
+  | "_root_.Aeneas.Std.core.iter.traits.collect.FromIterator", "from_iter" ->
+      Some [ 0 ]
+  | "_root_.Aeneas.Std.core.iter.traits.collect.Extend", "extend" ->
+      Some [ 0; 1 ]
+  | _ -> None
