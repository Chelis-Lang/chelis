+      let trait_decl = TraitDeclId.Map.find tr.id crate.trait_decls in
+      let name =
+        String.concat "."
+          ("_root_.Aeneas.Std"
+          :: List.filter_map
+               (function
+                 | PeIdent (name, _) -> Some name
+                 | _ -> None)
+               trait_decl.item_meta.name)
