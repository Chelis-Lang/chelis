+/-- Rust Display is shortest fixed decimal; Debug uses one fractional digit in
+    fixed notation and scientific notation below 1e-4 or at/above 1e16. Explicit
+    precision uses correctly rounded fixed decimal for both traits. Half's own
+    traits delegate to f32, so their callers cast before entering this model. -/
+def floatFormat {f} (debug : Bool) (x : BinaryFloat f) (fmt : Formatter) : Outcome := do
+  let sign := if x.isNaN then "" else if x.sign then "-" else if fmt.options.bit 21 then "+" else ""
+  if x.isNaN then return ← fmt.padFloat sign [.copy "NaN"]
+  if x.isInfinite then return ← fmt.padFloat sign [.copy "inf"]
+  let (n, d) := x.ratio
+  let parts ← if fmt.options.bit 28 then
+      .ok (exactDecimalParts x n d fmt.options.precision)
+    else if x.isZero then .ok (zeroDecimalParts (if debug then 1 else 0))
+    else do
+      let (c, e) ← shortestDecimal x n d (decimalExponent n d) 17 1
+      let (c, e) := trimDecimal 17 c e
+      let lower := BinaryFloat.round f false 1 10000
+      let upper := BinaryFloat.round f false (10 ^ 16) 1
+      if debug && (BinaryFloat.lt x.abs lower || BinaryFloat.le upper x.abs) then
+        .ok (scientificDecimalParts c e)
+      else .ok (fixedDecimalParts (digits c) e (if debug then 1 else 0))
