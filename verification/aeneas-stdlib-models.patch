+namespace BinaryFormat
+
+def fractionBits : BinaryFormat → Nat
+  | .binary16 => 10 | .bfloat16 => 7 | .binary32 => 23 | .binary64 => 52
+
+def exponentBits : BinaryFormat → Nat
+  | .binary16 => 5 | .bfloat16 => 8 | .binary32 => 8 | .binary64 => 11
+
+def width (f : BinaryFormat) : Nat := 1 + f.exponentBits + f.fractionBits
+def bias (f : BinaryFormat) : Nat := 2 ^ (f.exponentBits - 1) - 1
+def maxExponent (f : BinaryFormat) : Nat := 2 ^ f.exponentBits - 1
+
+end BinaryFormat
