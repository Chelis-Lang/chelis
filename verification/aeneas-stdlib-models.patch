+    same definition to `toUnfold`; that duplicate traversal can exceed Lean's
+    recursion limit on large extracted bodies. Theorem, recursive-definition,
+    and simproc entries retain the ordinary simp attribute behavior. -/
+private def registerLoopBodySimpAttr : IO SimpExtension := do
+  let attrName := `rust_loop_body
+  let simprocAttrName := Simp.simpAttrNameToSimprocAttrName attrName
+  let ext ← mkSimpExt attrName
+  registerBuiltinAttribute {
+    ref := attrName
+    name := attrName
+    descr := "simplification and unfolding of extracted loop bodies"
+    applicationTime := .afterCompilation
+    add := fun declName stx attrKind => do
+      if (← Simp.isSimproc declName <||> Simp.isBuiltinSimproc declName) then
+        Attribute.add declName simprocAttrName stx attrKind
+      else
+        let go : MetaM Unit := do
+          let info ← getAsyncConstInfo declName
+          let post := if stx[1].isNone then true else stx[1][0].getKind == ``Lean.Parser.Tactic.simpPost
+          let inv := !stx[2].isNone
+          let prio ← getAttrParamOptPrio stx[3]
