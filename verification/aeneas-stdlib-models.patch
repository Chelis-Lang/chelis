+        .ok (status, { fmt with options := o })
+      else thenFormat (writeFill '0' padding fmt) (fun fmt =>
+        thenFormat (writeFloatParts parts fmt) (fun fmt =>
+          .ok (.Ok (), { fmt with options := o }))))
+  else fmt.padWith (o.width - sign.utf8ByteSize - length) true content
