+def Formatter.debug_struct_fields_finish (fmt : Formatter) (name : Str)
+    (names : Slice Str) (values : Slice DebugValue) : Outcome := do
+  if names.val.length != values.val.length then return ← .fail .panic
+  let names ← names.val.mapM (fun s => decode s.val)
+  fmt.debugStruct (← decode name.val) (names.zip values.val)
 
+def escapeDebugChar (c : Char) (quote : Char := '"') : String :=
+  if c == '\x00' then "\\0"
+  else if c == '\t' then "\\t"
+  else if c == '\r' then "\\r"
+  else if c == '\n' then "\\n"
+  else if c == '\\' then "\\\\"
+  else if c == quote then "\\" ++ String.singleton c
+  else if needsDebugEscape c then "\\u{" ++ digits c.toNat 16 ++ "}"
+  else String.singleton c
+
+def debugStringParts : List Char → String → Formatter → Outcome
+  | [], printable, fmt => fmt.append printable
+  | c :: rest, printable, fmt =>
+    let escaped := escapeDebugChar c
+    if escaped == String.singleton c then debugStringParts rest (printable.push c) fmt
+    else thenFormat (fmt.append printable) (fun fmt =>
+      thenFormat (fmt.append escaped) (debugStringParts rest ""))
+
+def debugString (s : String) (fmt : Formatter) : Outcome :=
+  thenFormat (fmt.append "\"") (fun fmt =>
+    thenFormat (debugStringParts s.toList "" fmt) (fun fmt => fmt.append "\""))
+
+def displayString (s : String) (fmt : Formatter) : Outcome :=
+  let s := if fmt.options.bit 28 then String.ofList (s.toList.take fmt.options.precision) else s
+  fmt.pad s
