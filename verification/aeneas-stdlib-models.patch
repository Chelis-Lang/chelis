+    if coefficient == 0 then zeroDecimalParts precision
+    else
+      let text := digits coefficient
+      let dropped := text.length - maxLength
+      fixedDecimalParts (if dropped == 0 then text else String.ofList (text.toList.take maxLength))
+        (scale + (dropped : Int)) precision
