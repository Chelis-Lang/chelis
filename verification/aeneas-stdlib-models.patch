+/-- Decimal exponent of a positive exact rational. Decimal lengths give an
+    estimate which is either exact or one too large. -/
+def decimalExponent (n d : Nat) : Int :=
+  let e : Int := (digits n).length - ((digits d).length : Int)
+  let below := if e ≥ 0 then n < d * 10 ^ e.toNat else n * 10 ^ (-e).toNat < d
+  if below then e - 1 else e
+
+def decimalRatio (coefficient : Nat) (exponent : Int) : Nat × Nat :=
+  if exponent ≥ 0 then (coefficient * 10 ^ exponent.toNat, 1)
+  else (coefficient, 10 ^ (-exponent).toNat)
+
+def roundDecimal (n d : Nat) (exponent : Int) : Nat :=
+  if exponent ≥ 0 then BinaryFloat.roundQuotient n (d * 10 ^ exponent.toNat)
+  else BinaryFloat.roundQuotient (n * 10 ^ (-exponent).toNat) d
+
+/-- Search increasing significant precision for the nearest decimal inside the
+    original IEEE rounding interval. All four carriers need at most 17 digits.
+    Exhausting the mathematically sufficient bound is an error, never fake text. -/
+def shortestDecimal {f} (x : BinaryFloat f) (n d : Nat) (e : Int) :
+    Nat → Nat → Result (Nat × Int)
+  | 0, _ => .fail .panic
+  | fuel + 1, precision =>
+    let scale := e - (precision : Int) + 1
+    -- Rust's shortest mode breaks exact decimal ties upward; its explicit
+    -- precision mode above instead rounds ties to even.
+    let (a, b) := if scale ≥ 0 then (n, d * 10 ^ scale.toNat)
+      else (n * 10 ^ (-scale).toNat, d)
+    let coefficient := a / b + if 2 * (a % b) ≥ b then 1 else 0
+    let candidates := [coefficient, coefficient - 1, coefficient + 1]
+    match candidates.find? (fun c =>
+        let (a, b) := decimalRatio c scale
+        (BinaryFloat.round f false a b).bits == x.abs.bits) with
+    | some c => .ok (c, scale)
+    | none => shortestDecimal x n d e fuel (precision + 1)
+
+def trimDecimal : Nat → Nat → Int → Nat × Int
+  | 0, c, e => (c, e)
+  | fuel + 1, c, e =>
+    if c != 0 && c % 10 == 0 then trimDecimal fuel (c / 10) (e + 1) else (c, e)
