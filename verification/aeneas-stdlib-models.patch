+structure alloc.collections.btree.map.entry.OccupiedEntry (K V : Type) where
+  before : List (K × V)
+  key : K
+  value : V
+  after : List (K × V)
+
+/-- `value = none` is an uninserted entry. The backward result of insert carries
+`some finalValue`, so ending the borrow installs the new entry exactly once. -/
+@[rust_type "alloc::collections::btree::map::entry::VacantEntry"
+  (keepParams := [true, true, false]) (mutRegions := #[0]) (body := .opaque)]
+structure alloc.collections.btree.map.entry.VacantEntry (K V : Type) where
+  before : List (K × V)
+  key : K
+  value : Option V
+  after : List (K × V)
+
+@[rust_type "alloc::collections::btree::map::entry::Entry"
+  (keepParams := [true, true, false]) (mutRegions := #[0])]
+inductive alloc.collections.btree.map.entry.Entry (K V : Type) where
+  | Vacant : alloc.collections.btree.map.entry.VacantEntry K V → Entry K V
+  | Occupied : alloc.collections.btree.map.entry.OccupiedEntry K V → Entry K V
