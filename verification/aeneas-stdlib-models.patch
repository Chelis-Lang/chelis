+          if count % 64 == 0 then .ok (.Ok (), fmt)
+          else fmt.append (repeatChar '0' (count % 64)))
+    thenFormat written (writeFloatParts rest)
+
+def Formatter.padFloat (fmt : Formatter) (sign : String) (parts : List FloatPart) : Outcome :=
