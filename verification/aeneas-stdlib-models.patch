+/- This is an ordered-sequence abstraction, not Rust's physical B-tree shape.
+Its refinement requires a total, deterministic, successful comparator consistent
+with Eq/PartialEq; Borrow must preserve that order. No such laws follow from the
+Ord/Borrow dictionaries themselves. All dictionary calls below remain effectful.
+For unlawful, failing, or state-sensitive dictionaries, this executable model
+makes no equivalence claim about Rust's tree-dependent comparison schedule.
+Allocator identity, allocation failure and destructor effects are outside the
+existing allocator-erased Aeneas collection abstraction. -/
+
+@[rust_type "alloc::collections::btree::map::BTreeMap"
+  (keepParams := [true, true, false]) (body := .opaque)]
+structure alloc.collections.btree.map.BTreeMap (K V : Type) where
+  entries : List (K × V)
+
+@[rust_type "alloc::collections::btree::map::Iter" (body := .opaque)]
+structure alloc.collections.btree.map.Iter (K V : Type) where
+  remaining : List (K × V)
+
+@[rust_type "alloc::collections::btree::map::IntoIter"
+  (keepParams := [true, true, false]) (body := .opaque)]
+structure alloc.collections.btree.map.IntoIter (K V : Type) where
+  remaining : List (K × V)
+
