+partial def elabDoSeqCore (elems : List DoElem) : ElabM Expr := do
+  let ctx ← read
+  let expectedType ← ElabM.mkMonadicType ctx.expectedAlpha
+  let run : TermElabM Expr := do
+    let root ← mkFreshExprMVar expectedType .syntheticOpaque
+    let mut pending := { elems, hole := root.mvarId! : PendingSeq }
+    repeat
+      let (value, next) ← pending.hole.withContext do
+        match pending.elems with
+        | [] => throwError "unexpected empty `do` block"
+        | elem :: rest => ((elabDoElem elem rest).run ctx).run none
+      pending.hole.assign value
+      match next with
+      | none => break
+      | some next => pending := next
+    instantiateMVars root
+  liftM run
 
 end
 
