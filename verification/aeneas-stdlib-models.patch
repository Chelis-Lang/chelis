+/-- The representation invariant, stated rather than forged for arbitrary Ord.
+Clients proving refinement must establish it for maps they construct directly. -/
+def BTreeMap.Ordered {K V : Type} (ord : core.cmp.Ord K) (map : BTreeMap K V) : Prop :=
+  map.entries.Pairwise (fun left right => ord.cmp left.1 right.1 = .ok .lt)
+
+@[rust_fun "alloc::collections::btree::map::{alloc::collections::btree::map::BTreeMap<@K, @V, alloc::alloc::Global>}::new"]
+def BTreeMap.new (K V : Type) : Result (BTreeMap K V) := .ok ⟨[]⟩
+
+def insertList {K V : Type} (ord : core.cmp.Ord K) (key : K) (value : V) :
+    List (K × V) → Result (Option V × List (K × V))
+  | [] => .ok (none, [(key, value)])
+  | (stored, old) :: rest => do
+    match ← ord.cmp key stored with
+    | .lt => .ok (none, (key, value) :: (stored, old) :: rest)
+    | .eq => .ok (some old, (stored, value) :: rest)
+    | .gt =>
+      let (previous, rest) ← insertList ord key value rest
+      .ok (previous, (stored, old) :: rest)
+
+@[rust_fun "alloc::collections::btree::map::{alloc::collections::btree::map::BTreeMap<@K, @V, @A>}::insert"
+  (keepParams := [true, true, false]) (keepTraitClauses := [false, true])]
+def BTreeMap.insert {K V : Type} (ord : core.cmp.Ord K)
+    (map : BTreeMap K V) (key : K) (value : V) : Result (Option V × BTreeMap K V) := do
+  let (old, entries) ← insertList ord key value map.entries
+  .ok (old, ⟨entries⟩)
+
+def getList {K V Q : Type} (borrow : core.borrow.Borrow K Q) (ord : core.cmp.Ord Q)
+    (query : Q) : List (K × V) → Result (Option V)
+  | [] => .ok none
+  | (key, value) :: rest => do
+    match ← ord.cmp query (← borrow.borrow key) with
+    | .lt => .ok none
+    | .eq => .ok (some value)
+    | .gt => getList borrow ord query rest
+
+@[rust_fun "alloc::collections::btree::map::{alloc::collections::btree::map::BTreeMap<@K, @V, @A>}::get"
+  (keepParams := [true, true, false, true]) (keepTraitClauses := [false, true, true, true])]
+def BTreeMap.get {K V Q : Type} (borrow : core.borrow.Borrow K Q)
+    (_keyOrd : core.cmp.Ord K) (ord : core.cmp.Ord Q) (map : BTreeMap K V)
+    (query : Q) : Result (Option V) := getList borrow ord query map.entries
+
+@[rust_fun "alloc::collections::btree::map::{alloc::collections::btree::map::BTreeMap<@K, @V, @A>}::contains_key"
+  (keepParams := [true, true, false, true]) (keepTraitClauses := [false, true, true, true])]
+def BTreeMap.contains_key {K V Q : Type} (borrow : core.borrow.Borrow K Q)
+    (keyOrd : core.cmp.Ord K) (ord : core.cmp.Ord Q) (map : BTreeMap K V)
+    (query : Q) : Result Bool := do
+  .ok (← BTreeMap.get borrow keyOrd ord map query).isSome
+
+def removeList {K V Q : Type} (borrow : core.borrow.Borrow K Q) (ord : core.cmp.Ord Q)
+    (query : Q) : List (K × V) → Result (Option V × List (K × V))
+  | [] => .ok (none, [])
+  | (key, value) :: rest => do
+    match ← ord.cmp query (← borrow.borrow key) with
+    | .lt => .ok (none, (key, value) :: rest)
+    | .eq => .ok (some value, rest)
+    | .gt =>
+      let (old, rest) ← removeList borrow ord query rest
+      .ok (old, (key, value) :: rest)
+
+@[rust_fun "alloc::collections::btree::map::{alloc::collections::btree::map::BTreeMap<@K, @V, @A>}::remove"
+  (keepParams := [true, true, false, true]) (keepTraitClauses := [false, true, true, true])]
+def BTreeMap.remove {K V Q : Type} (borrow : core.borrow.Borrow K Q)
+    (_keyOrd : core.cmp.Ord K) (ord : core.cmp.Ord Q) (map : BTreeMap K V)
+    (query : Q) : Result (Option V × BTreeMap K V) := do
+  let (old, entries) ← removeList borrow ord query map.entries
+  .ok (old, ⟨entries⟩)
+
+@[rust_fun "alloc::collections::btree::map::{alloc::collections::btree::map::BTreeMap<@K, @V, @A>}::is_empty"
