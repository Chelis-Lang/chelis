+/-- Fuel is the byte length, not an arbitrary execution bound: every opcode
+    consumes at least one byte. Embedded NULs belong to fields/literal payloads. -/
+def renderTemplate : Nat → List U8 → List rt.Argument → Nat → Formatter → Outcome
+  | 0, _, _, _, _ => .fail .panic
+  | fuel + 1, bytes, args, next, fmt => do
+    let (tag, bytes) ← readLE 1 bytes
+    if tag == 0 then return (.Ok (), fmt)
+    if tag ≤ 128 then
+      let (length, bytes) ← if tag == 128 then readLE 2 bytes else .ok (tag, bytes)
+      if length > bytes.length then return ← .fail .panic
+      let text ← decode (bytes.take length)
+      thenFormat (fmt.append text) (renderTemplate fuel (bytes.drop length) args next)
+    else if tag < 192 then .fail .panic
+    else
+      let bit := fun n => tag / 2 ^ n % 2 == 1
+      let (flags, bytes) ← readField (bit 0) 4 0x60000020 bytes
+      let (width, bytes) ← readField (bit 1) 2 0 bytes
+      let (precision, bytes) ← readField (bit 2) 2 0 bytes
+      let (index, bytes) ← readField (bit 3) 2 next bytes
+      let width ← if bit 4 then argumentCount args width else .ok width
+      let precision ← if bit 5 then argumentCount args precision else .ok precision
+      let (status, f) ← argumentFormat args index { fmt with options := ⟨flags, width, precision⟩ }
+      let f := { f with options := fmt.options }
+      thenFormat (.ok (status, f)) (renderTemplate fuel bytes args (index + 1))
 
