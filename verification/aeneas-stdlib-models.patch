+import Aeneas.Std.Slice
+import Aeneas.Std.Core.Cmp
+import Aeneas.Std.Core.Ops
+
+namespace Aeneas.Std
+
+open Result
+
+namespace alloc.slice
+
+/-- A stable merge: take the right item only when it is strictly less than
+ the left one. Every comparison threads its callback state and may fail. -/
+def stableMerge {T S : Type} (less : S → T → T → Result (Bool × S))
+    (left right : List T) (state : S) :
+    Result ({out : List T // out.length = left.length + right.length} × S) :=
+  match left, right with
+  | [], right => ok (⟨right, by simp⟩, state)
+  | left, [] => ok (⟨left, by simp⟩, state)
+  | x :: xs, y :: ys => do
+    let (before, state) ← less state y x
+    if before then
+      let (out, state) ← stableMerge less (x :: xs) ys state
+      return (⟨y :: out.val, by
+        have h := out.property
+        simp only [List.length_cons] at h ⊢
+        omega⟩, state)
+    else
+      let (out, state) ← stableMerge less xs (y :: ys) state
+      return (⟨x :: out.val, by
+        have h := out.property
+        simp only [List.length_cons] at h ⊢
+        omega⟩, state)
+termination_by left.length + right.length
+decreasing_by
+  all_goals simp_all only [List.length_cons]
+  all_goals omega
+
+/-- Stable merge sorting with a length-preserving result. This specifies a
+ comparison schedule, not an API guarantee about Rust callback call counts.
+ Keys are recomputed for each comparison, unlike `sort_by_cached_key`. -/
+def stableSort {T S : Type} (less : S → T → T → Result (Bool × S))
+    (input : List T) (state : S) :
+    Result ({out : List T // out.length = input.length} × S) :=
+  match input with
+  | [] => ok (⟨[], rfl⟩, state)
+  | [x] => ok (⟨[x], rfl⟩, state)
+  | x :: y :: xs => do
+    let input := x :: y :: xs
+    let middle := input.length / 2
+    let (left, state) ← stableSort less (input.take middle) state
+    let (right, state) ← stableSort less (input.drop middle) state
+    let (out, state) ← stableMerge less left.val right.val state
+    return (⟨out.val, by
+      change out.val.length = input.length
+      have hl := left.property
+      have hr := right.property
+      have ho := out.property
+      simp only [List.length_take, List.length_drop] at hl hr
+      omega⟩, state)
+termination_by input.length
+decreasing_by
+  all_goals simp_all only [List.length_take, List.length_drop, List.length_cons]
+  all_goals omega
+
+@[rust_fun "alloc::slice::{[@T]}::sort"]
+def Slice.sort {T : Type} (ordInst : core.cmp.Ord T) (self : Std.Slice T) :
+    Result (Std.Slice T) := do
+  -- Rust's entry point passes T::lt, rather than calling Ord::cmp.
+  let (out, _) ← stableSort
+    (fun (_ : Unit) x y => do return (← ordInst.partialOrdInst.lt x y, ())) self.val ()
+  return ⟨out.val, by rw [out.property]; exact self.property⟩
+
+@[rust_fun "alloc::slice::{[@T]}::sort_by_key"]
+def Slice.sort_by_key {T K F : Type}
+    (fnInst : core.ops.function.FnMut F T K) (ordInst : core.cmp.Ord K)
+    (self : Std.Slice T) (f : F) : Result (Unit × Std.Slice T × F) := do
+  let (out, f) ← stableSort (fun f x y => do
+    let (kx, f) ← fnInst.call_mut f x
+    let (ky, f) ← fnInst.call_mut f y
+    return (← ordInst.partialOrdInst.lt kx ky, f)) self.val f
+  return ((), ⟨out.val, by rw [out.property]; exact self.property⟩, f)
+
+end alloc.slice
+end Aeneas.Std
